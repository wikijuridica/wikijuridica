#!/usr/bin/env python3
"""check-derived-authorial-floor-selftest — prova as propriedades do EIXO 3
(unicidade) de `tools/check-derived-authorial-floor`, sobre dado REAL sempre que
possível, e reprova se alguma cair.

Read-only: não escreve nada. Importa o gate real via `SourceFileLoader` (ele não
tem extensão `.py`) e exercita as MESMAS funções que o gate usa — reimplementar a
lógica aqui provaria a cópia, não o detector.

POR QUE ESTAS PROPRIEDADES (ver docstring "EIXO 3" do gate para a medição
completa que as originou):

  A. CONTROLE NEGATIVO NÃO REPROVA. Duas páginas autorais genuínas e sem relação
     temática não podem colidir em 3-gramas. Sem esta prova, o eixo poderia estar
     medindo "toda prosa jurídica parece com toda prosa jurídica" em vez de
     "este molde específico se repete".

  B. CONTROLE POSITIVO CONTINUA REPROVANDO. O par mais parecido do shard
     `diarios-municipais` ANTES da correção (git show 82fa0488~1) tem que
     continuar >= LIMIAR_UNICIDADE. Esse par não existe mais no worktree — o
     gerador já foi corrigido —, e é exatamente por isso que ele tem que vir do
     histórico do git, não do estoque atual: sem ele, um limiar frouxo nasceria
     e ninguém perceberia, porque o defeito que ele existe para pegar já foi
     corrigido no que sobrou no disco.

  C. O LIMIAR NUNCA RELAXA ACIMA DO CONTRATO. 0,70 é o valor medido (ver EIXO 3);
     subir esse número afrouxaria o eixo sem nova medição.

  D. AS DUAS FAMÍLIAS JÁ CORRIGIDAS FICAM LIMPAS NO CORPUS REAL. Guarda de
     regressão: se `diarios-municipais` ou `noticias-oficiais` voltarem a
     reprovar, ou o molde recresceu ou a extração de corpo quebrou. O corpus
     inteiro entra junto, por TETO de pares reprovados — hoje zero, medido. Até
     2026-09-05 essa segunda parte era um piso (`reprovados > 0`, "as famílias
     em correção têm que continuar acusando"), o que fazia o selftest reprovar
     no dia em que a outra frente terminasse o serviço. Quem garante que o eixo
     não emburreceu é B, que vem do histórico do git e não do estoque vivo.

  E. ORDEM DO CORPO É opening → sections → todas as perguntas → todas as
     respostas — a mesma de `internal/v2bodyneardup.AssembleBody`. Cabeçalho de
     FAQ fora de ordem inflaria falso-positivo entre páginas de família
     diferente que só compartilham a pergunta-molde do FAQ.

  F. TOMBSTONE (skipped=true) NUNCA ENTRA NO CORPUS. Página sem corpo publicado
     não pode virar par candidato — ela nem tem texto para comparar.

Uso:
    tools/check-derived-authorial-floor-selftest
    tools/check-derived-authorial-floor-selftest --verboso
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GATE = ROOT / "tools/check-derived-authorial-floor"
COMMIT_PRE_CORRECAO = "82fa0488~1"
SHARD_PRE_CORRECAO = "data/editorial/v2_pages/diarios-municipais-01.jsonl"


def carrega_gate():
    """Importa o gate real. Sem extensão `.py`, o loader é explícito —
    `spec_from_file_location` sozinho devolve None para arquivo sem extensão
    conhecida. O guard `if __name__ == "__main__"` do gate impede rodar main()
    na importação."""
    if not GATE.is_file():
        raise SystemExit("gate ausente: %s" % GATE)
    loader = importlib.machinery.SourceFileLoader("derived_authorial_floor", str(GATE))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise SystemExit("não consegui importar %s" % GATE)
    modulo = importlib.util.module_from_spec(spec)
    loader.exec_module(modulo)
    return modulo


class Placar:
    def __init__(self, verboso: bool) -> None:
        self.falhas: list[str] = []
        self.passos = 0
        self.verboso = verboso

    def exige(self, condicao: bool, descricao: str, detalhe: str = "") -> None:
        self.passos += 1
        if condicao:
            if self.verboso:
                print("    ok   %s %s" % (descricao, detalhe))
            return
        self.falhas.append("%s %s" % (descricao, detalhe))
        print("    FALHA %s %s" % (descricao, detalhe))


def shingles(mod, texto: str):
    return mod.shingles_de_palavras(mod.tokeniza_unicidade(texto), mod.TAMANHO_SHINGLE_UNICIDADE)


def propriedade_a_controle_negativo(mod, placar: Placar) -> None:
    print("A. controle negativo: paginas autorais sem relacao nao colidem")
    # Duas páginas sintéticas, temas sem nenhuma sobreposição lexical de propósito
    # (mesmo estilo/registro jurídico, para não ser um teste "fácil demais").
    pagina_1 = {
        "opening": (
            "A prescrição intercorrente em execução fiscal se conta do despacho "
            "que determina a suspensão do processo por ausência de bens penhoráveis."
        ),
        "sections": [{"heading": "x", "text": (
            "O prazo de cinco anos corre a partir da intimação da Fazenda Pública "
            "sobre a não localização de bens do executado, conforme entendimento "
            "consolidado do Superior Tribunal de Justiça em recurso repetitivo."
        )}],
        "faq": [{"q": "Quando comeca a contar o prazo", "a": "A partir da intimacao da Fazenda."}],
    }
    pagina_2 = {
        "opening": (
            "O cancelamento de voo por overbooking gera direito a reacomodação, "
            "assistência material e indenização, independentemente de motivo de força maior."
        ),
        "sections": [{"heading": "y", "text": (
            "A companhia aérea responde objetivamente pelo dano ao passageiro "
            "preterido, cabendo pedido de reparação perante o Juizado Especial Cível."
        )}],
        "faq": [{"q": "Tenho direito a reembolso integral", "a": "Sim, alem da assistencia material."}],
    }
    s1 = shingles(mod, mod.corpo_v2(pagina_1))
    s2 = shingles(mod, mod.corpo_v2(pagina_2))
    score = mod.jaccard(s1, s2)
    placar.exige(score < 0.05, "jaccard de paginas autorais sem relacao fica perto de zero",
                 "medido=%.4f" % score)
    placar.exige(score < mod.LIMIAR_UNICIDADE, "controle negativo nao reprova",
                 "medido=%.4f limiar=%.2f" % (score, mod.LIMIAR_UNICIDADE))


def carrega_shard_pre_correcao() -> list[dict]:
    """Lê o shard de diarios-municipais de ANTES da correção via `git show` —
    esse par não existe mais no worktree (git show, nunca checkout/restore)."""
    resultado = subprocess.run(
        ["git", "show", "%s:%s" % (COMMIT_PRE_CORRECAO, SHARD_PRE_CORRECAO)],
        cwd=ROOT, capture_output=True, text=True,
    )
    if resultado.returncode != 0:
        raise SystemExit(
            "não consegui ler %s em %s (git show falhou): %s"
            % (SHARD_PRE_CORRECAO, COMMIT_PRE_CORRECAO, resultado.stderr.strip())
        )
    paginas = []
    for linha in resultado.stdout.splitlines():
        linha = linha.strip()
        if not linha:
            continue
        pagina = json.loads(linha)
        if pagina.get("skipped"):
            continue
        paginas.append(pagina)
    return paginas


def propriedade_b_controle_positivo(mod, placar: Placar) -> None:
    print("B. controle positivo: par pre-correcao dos diarios continua reprovando")
    paginas = carrega_shard_pre_correcao()
    placar.exige(len(paginas) >= 2, "shard pre-correcao tem paginas suficientes para comparar",
                 "paginas=%d" % len(paginas))
    perfis = [(p.get("intent_id"), shingles(mod, mod.corpo_v2(p))) for p in paginas]
    melhor = 0.0
    par = None
    for i in range(len(perfis)):
        for j in range(i + 1, len(perfis)):
            score = mod.jaccard(perfis[i][1], perfis[j][1])
            if score > melhor:
                melhor = score
                par = (perfis[i][0], perfis[j][0])
    placar.exige(melhor >= mod.LIMIAR_UNICIDADE,
                 "pior par do shard pre-correcao ainda reprova",
                 "medido=%.4f limiar=%.2f par=%s" % (melhor, mod.LIMIAR_UNICIDADE, par))
    # Faixa medida em 2026-08-27 (0,7652) — se isso deriva muito, a extração de
    # corpo ou a tokenizacao mudou de comportamento sem que ninguem tenha revisto.
    placar.exige(0.70 <= melhor <= 0.85, "score do controle positivo na faixa esperada",
                 "medido=%.4f faixa=[0.70,0.85]" % melhor)


def propriedade_c_limiar_nao_relaxa(mod, placar: Placar) -> None:
    print("C. limiar nunca sobe alem do valor medido")
    placar.exige(mod.LIMIAR_UNICIDADE <= 0.70, "LIMIAR_UNICIDADE <= 0.70 (contrato medido no EIXO 3)",
                 "atual=%.4f" % mod.LIMIAR_UNICIDADE)
    placar.exige(mod.TAMANHO_SHINGLE_UNICIDADE == 3,
                 "shingle de 3 palavras (5 nao sobrevive ao numero intercalado)",
                 "atual=%d" % mod.TAMANHO_SHINGLE_UNICIDADE)


def propriedade_d_familias_corrigidas_limpas(mod, placar: Placar) -> None:
    print("D. familias ja corrigidas ficam limpas no corpus real (guarda de regressao)")
    corpus, sem_corpo = mod.carrega_corpus_unicidade(sys.stderr)
    placar.exige(corpus is not None, "corpus real carregou sem erro de parse", "")
    if corpus is None:
        return
    placar.exige(sem_corpo == 0, "nenhuma pagina do escopo ficou sem corpo analisavel",
                 "sem_corpo=%d" % sem_corpo)
    for familia in ("diarios-municipais", "noticias-oficiais"):
        paginas = corpus.get(familia, [])
        placar.exige(len(paginas) > 0, "familia %s tem paginas no corpus" % familia,
                     "n=%d" % len(paginas))
        pior = 0.0
        for i in range(len(paginas)):
            for j in range(i + 1, len(paginas)):
                pior = max(pior, mod.jaccard(paginas[i][2], paginas[j][2]))
        placar.exige(pior < mod.LIMIAR_UNICIDADE,
                     "familia %s (ja corrigida) fica abaixo do limiar" % familia,
                     "pior=%.4f limiar=%.2f" % (pior, mod.LIMIAR_UNICIDADE))
    # TETO DE PARES REPROVADOS, e nao piso (2026-09-05).
    #
    # Ate hoje esta linha exigia `len(reprovados) > 0`, com a justificativa de
    # que "as tres familias ainda em correcao por outra frente TEM que continuar
    # acusando — se isso zerar sem o generator ter mudado, o eixo emburreceu".
    # A intencao era boa e a forma era um teto INVERTIDO: uma assercao que exige
    # que o defeito continue existindo fica vermelha no dia em que ele e
    # corrigido, e passa a cobrar dívida de quem a pagou.
    #
    # Foi o que aconteceu: medido em 2026-09-05, `reprovados=0`. E a hipotese do
    # "eixo emburreceu" ja esta descartada pela propriedade B, que e a guarda
    # certa e melhor — ela puxa o par pre-correcao do HISTORICO DO GIT
    # (82fa0488~1) e exige que ele continue acima do limiar, entao continua
    # valendo mesmo com o estoque inteiro limpo. B nao depende de haver defeito
    # vivo no disco; esta linha dependia.
    #
    # Vira teto: par novo reprova, e a descida do numero obriga a baixar a
    # constante — para o conhecido nunca virar licenca para o que ninguem mediu.
    PARES_REPROVADOS_CONHECIDOS = 0
    todos_pares, reprovados = mod.pares_quase_identicos(corpus, mod.LIMIAR_UNICIDADE)
    placar.exige(len(reprovados) <= PARES_REPROVADOS_CONHECIDOS,
                 "nenhum par novo acima do limiar (teto=%d)" % PARES_REPROVADOS_CONHECIDOS,
                 "reprovados=%d de %d pares" % (len(reprovados), len(todos_pares)))
    placar.exige(len(reprovados) == PARES_REPROVADOS_CONHECIDOS,
                 "o teto de pares reprovados ainda tem lastro — se caiu, baixe a constante",
                 "reprovados=%d teto=%d" % (len(reprovados), PARES_REPROVADOS_CONHECIDOS))


def propriedade_e_ordem_do_corpo(mod, placar: Placar) -> None:
    print("E. ordem do corpo: opening, sections, todas as perguntas, todas as respostas")
    pagina = {
        "opening": "ABERTURA",
        "sections": [{"heading": "h", "text": "SECAO"}],
        "faq": [{"q": "PERGUNTA1", "a": "RESPOSTA1"}, {"q": "PERGUNTA2", "a": "RESPOSTA2"}],
    }
    corpo = mod.corpo_v2(pagina)
    esperado = "ABERTURA\nSECAO\nPERGUNTA1\nPERGUNTA2\nRESPOSTA1\nRESPOSTA2"
    placar.exige(corpo == esperado, "corpo_v2 monta na ordem de AssembleBody",
                 "obtido=%r" % corpo)


def propriedade_f_tombstone_fora_do_corpus(mod, placar: Placar) -> None:
    print("F. tombstone (skipped=true) nunca entra no corpus de unicidade")
    corpus, _ = mod.carrega_corpus_unicidade(sys.stderr)
    placar.exige(corpus is not None, "corpus carregou para checar tombstone", "")
    if corpus is None:
        return
    # Vale sempre, com ou sem tombstone no acervo de hoje: identidade nunca duplica.
    total_ids = sum(len(v) for v in corpus.values())
    ids_no_corpus = {(shard, intent) for paginas in corpus.values() for shard, intent, _ in paginas}
    placar.exige(len(ids_no_corpus) == total_ids, "sem duplicata de identidade no corpus",
                 "total=%d unicos=%d" % (total_ids, len(ids_no_corpus)))

    import glob
    import os as _os
    achou_tombstone = False
    for padrao in mod.FAMILIAS_CANAIS_DERIVADOS.values():
        for shard in glob.glob(_os.path.join(mod.DIRETORIO_V2_PAGES, padrao)):
            with open(shard, encoding="utf-8") as fh:
                for linha in fh:
                    linha = linha.strip()
                    if not linha:
                        continue
                    if json.loads(linha).get("skipped"):
                        achou_tombstone = True
                        break
            if achou_tombstone:
                break
        if achou_tombstone:
            break
    if not achou_tombstone:
        print("    aviso: nenhum tombstone encontrado nos canais derivados hoje;"
              " exclusao do tombstone nao exercida (nao e falha)")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--verboso", action="store_true")
    args = parser.parse_args()

    mod = carrega_gate()
    placar = Placar(args.verboso)

    propriedade_a_controle_negativo(mod, placar)
    propriedade_b_controle_positivo(mod, placar)
    propriedade_c_limiar_nao_relaxa(mod, placar)
    propriedade_d_familias_corrigidas_limpas(mod, placar)
    propriedade_e_ordem_do_corpo(mod, placar)
    propriedade_f_tombstone_fora_do_corpus(mod, placar)

    print("\n%d verificação(ões), %d falha(s)" % (placar.passos, len(placar.falhas)))
    if placar.falhas:
        for falha in placar.falhas[:20]:
            print("  FALHA: %s" % falha)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
