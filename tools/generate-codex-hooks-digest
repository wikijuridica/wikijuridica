#!/usr/bin/env python3
"""generate-codex-hooks-digest — reancora o digest do bundle anti-loop.

O DEFEITO QUE ESTA FERRAMENTA EXISTE PARA NÃO DEIXAR VOLTAR (2026-09-05).
`.codex/hooks.json` embute, em três comandos (PreToolUse, PostToolUse, Stop),
um `--expected-bundle-digest sha256:...` que amarra o hook anti-loop aos 12
arquivos que implementam a sua trilha de recibo — `.codex/hooks/anti_loop.py`
mais 11 arquivos Go.

Esse digest era escrito À MÃO. Em 2026-08-30 o commit `62bd1d19` alterou
`internal/goalbaseline/baseline.go` (+70 linhas), que está no bundle, e ninguém
reescreveu o valor. Resultado medido em 2026-09-05: o digest vivo era
`sha256:1a0c09eb8389...` e o `hooks.json` ainda dizia `sha256:0993a028e8d5...`
— seis dias em que toda chamada real de ferramenta batia em
`transitive_bundle_digest_mismatch`.

Consertar o valor não conserta a CAUSA: enquanto o número for digitado, a
próxima edição em qualquer um dos 12 arquivos o quebra de novo, em silêncio,
até alguém rodar a suíte. Esta ferramenta calcula o digest pela mesma função que
o hook usa em tempo de execução (`anti_loop.integrity_bundle_digest`) — nunca
por uma segunda implementação, que divergiria — e o grava.

A substituição é TEXTUAL, sobre o valor do digest, e não reserializa o JSON: o
arquivo é lido por humanos e um `json.dump` reordenaria e reindentaria tudo,
enterrando a mudança real num diff de arquivo inteiro.

USO
    ./tools/generate-codex-hooks-digest            # grava se estiver defasado
    ./tools/generate-codex-hooks-digest --dry-run  # só relata (read-only)
"""
from __future__ import annotations

import argparse
import importlib.util
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
HOOKS_JSON = RAIZ / ".codex" / "hooks.json"
ANTI_LOOP = RAIZ / ".codex" / "hooks" / "anti_loop.py"

# O valor aparece uma vez por lane; menos que isso significa que alguém removeu
# a amarração de um dos gatilhos, e isso é defeito, não formatação.
OCORRENCIAS_ESPERADAS = 3
PADRAO = re.compile(r"(--expected-bundle-digest\s+)(sha256:[0-9a-f]{64})")


def digest_vivo(anti_loop: pathlib.Path = ANTI_LOOP) -> str:
    """O MESMO cálculo que o hook faz em runtime — importado, não reescrito."""
    spec = importlib.util.spec_from_file_location("anti_loop", str(anti_loop))
    if spec is None or spec.loader is None:
        raise RuntimeError(f"não consegui carregar {anti_loop}")
    modulo = importlib.util.module_from_spec(spec)
    # O módulo usa dataclasses, que exigem o nome registrado em sys.modules
    # para resolver anotações; sem isto o import estoura com AttributeError.
    sys.modules["anti_loop"] = modulo
    spec.loader.exec_module(modulo)
    return modulo.integrity_bundle_digest()


def digests_declarados(fonte: str) -> list[str]:
    return [achado.group(2) for achado in PADRAO.finditer(fonte)]


def reancora(fonte: str, digest: str) -> tuple[str, int]:
    """Troca só o valor, preservando o resto do arquivo byte a byte."""
    declarados = digests_declarados(fonte)
    if len(declarados) != OCORRENCIAS_ESPERADAS:
        raise ValueError(
            f"esperava {OCORRENCIAS_ESPERADAS} ocorrências de "
            f"--expected-bundle-digest, achei {len(declarados)}: uma lane "
            f"perdeu a amarração ao bundle")
    defasadas = sum(1 for d in declarados if d != digest)
    return PADRAO.sub(lambda m: m.group(1) + digest, fonte), defasadas


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="reancora o digest do bundle anti-loop em .codex/hooks.json")
    parser.add_argument("--dry-run", action="store_true",
                        help="relata sem escrever")
    args = parser.parse_args(argv)

    digest = digest_vivo()
    fonte = HOOKS_JSON.read_text(encoding="utf-8")
    novo, defasadas = reancora(fonte, digest)

    if not defasadas:
        print(f"generate-codex-hooks-digest: OK — as {OCORRENCIAS_ESPERADAS} "
              f"lanes já apontam para {digest[:19]}...")
        return 0

    print(f"generate-codex-hooks-digest: {defasadas} lane(s) defasada(s)")
    for declarado in sorted(set(digests_declarados(fonte))):
        if declarado != digest:
            print(f"  no arquivo: {declarado[:26]}...")
    print(f"  no bundle : {digest[:26]}...")
    if args.dry_run:
        print("  (--dry-run: nada foi escrito)")
        return 1
    HOOKS_JSON.write_text(novo, encoding="utf-8")
    print(f"  gravado: .codex/hooks.json")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
