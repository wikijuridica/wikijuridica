#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH

for arg in "$@"; do
	case "$arg" in
	--)
		echo "generate-official-source-url-live-metadata-attempts-release: -- is not allowed because release flags must remain parseable" >&2
		exit 2
		;;
	--live | --live=* | --metadata-only | --metadata-only=* | --no-content-copy | --no-content-copy=* | --max-concurrency | --max-concurrency=*)
		echo "generate-official-source-url-live-metadata-attempts-release: release invariant flag cannot be supplied by caller: $arg" >&2
		exit 2
		;;
	-h | --help)
		cat <<'EOF'
usage: generate-official-source-url-live-metadata-attempts-release [flags]

Runs the official-source live release pass in metadata-only, no-content-copy mode.
EOF
		exit 0
		;;
	esac
done

MAX_CONCURRENCY="${WIKI_OFFICIAL_SOURCE_LIVE_METADATA_RELEASE_MAX_CONCURRENCY:-4}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-official-source-url-live-metadata-attempts-release}"

# Parse release invariants before caller arguments. Invariant duplicates are
# rejected above, so a caller option missing its value cannot consume them.
exec "$ROOT/tools/generate-official-source-url-live-metadata-attempts" \
	--live \
	--metadata-only \
	--no-content-copy \
	--max-concurrency "$MAX_CONCURRENCY" \
	"$@"
