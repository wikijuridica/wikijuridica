#!/usr/bin/env python3
"""generate-v2-link-topics-enrich-20260812 — enriquece internal_link_topics com relação VERIFICADA.

O DEFEITO E O QUE ELE NÃO É. O backfill da malha (internal/v2publish/inlinkbackfill.go)
devolveu 16.415 arestas ociosas em 2026-08-12 e deixou uma cauda: 462 páginas com
466 slots vazios e 141 artigos que o Googlebot nunca pediu sem nenhuma entrada
nova. A hipótese de trabalho era falta de afinidade. A medição
(tools/check-v2-link-mesh-tail-20260812, que replica a cadeia inteira e bate
número a número com o ensaio real) REFUTOU essa hipótese:

  - 451 das 462 páginas com slot vazio têm MAIS de 24 candidatos afins
    (mediana 215, mínimo 3). Nenhuma tem zero.
  - a fila que o passe pré-ordena por origem tem profundidade fixa 24
    (backfillCandidatePool) e, nessas páginas, os 24 são todos recusados pelo
    teto de ganho por destino: 9.099 recusas por teto contra 1.291 por
    reciprocidade. O slot fica vazio por profundidade de fila, não por falta de
    assunto em comum.
  - subir a fila para 120 — sem tocar em UM critério de relevância — leva os
    slots ociosos de 466 para 19. O piso real de afinidade são 14 páginas.

Por isso este gerador NÃO tenta consertar as 449 páginas presas na fila: fazê-lo
exigiria inventar tópico para contornar uma constante, que é exatamente o link
manipulativo que a malha existe para não produzir. Ele trata os dois casos em que
tópico é a correção CERTA:

  (a) as páginas do piso real de afinidade, que ganham na PRÓPRIA lista o
      intent_id de uma página do acervo genuinamente vizinha;
  (b) os artigos nunca rastreados, que ganham uma entrada porque uma página
      FONTE genuinamente relacionada passa a declará-los.

VERDADE ANTES DE GRAFO. Todo par deste gerador foi lido por um revisor jurídico
contra o TEXTO real da página que recebe o tópico, com veredito de três valores
(verdadeiro/fraco/falso) e recorte verbatim que sustenta a relação. Só entra
`verdadeiro` com trecho literal conferido. O preflight reconfere: o trecho tem de
ser substring do registro VIVO, e o tópico tem de resolver para um intent_id
publicado — tópico que não resolve não vale +100 e seria só ruído no dado.

EFEITO COLATERAL CONHECIDO, medido e declarado: o acervo está com 99,97% da
capacidade de malha ocupada. Declarar um tópico não CRIA aresta nova, realoca —
o alvo declarado sobe para o topo da fila daquela fonte e desloca o candidato de
menor score. Nenhuma página cai abaixo do piso de entradas (o passe de piso
recompõe), e isso foi simulado antes de escrever.

CONTRATO DE ESCRITA (o mesmo de generate-v2-atribuicao-dispositivo-repair-20260812):
lease de época do estoque canônico, lock exclusivo próprio, CAS pelo sha256 da
LINHA viva, demais linhas preservadas byte a byte, forma de serialização da linha
preservada, escrita atômica com fsync, idempotente (tópico já presente => pula).
O texto anterior de toda linha tocada é preservado em .agents/runtime/ ANTES da
escrita. word_count NÃO é recalculado: internal_link_topics não entra na fórmula
de bodyWordCount (internal/v2ingest/validate.go) — mexer nele seria corromper o
número. NÃO commita e NÃO republica.

DEPOIS DE RODAR: o artefato da malha (content/internal_link_mesh_*) carimba o
fingerprint do estoque, e internal_link_topics entra nesse carimbo
(v2internallinkgraph.effectiveInputFingerprint). O artefato já está stale desde
que o estoque ganhou páginas em 2026-08-07; este gerador soma a isso. Regenerar o
artefato e republicar é do dono da frente de publicação.

Uso:
    tools/generate-v2-link-topics-enrich-20260812 --dry-run
    tools/generate-v2-link-topics-enrich-20260812
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease
from tools.v2_link_topics_writer import (
    Destinos,
    aplicar,
    escrever_evidencia,
    exclusive_lock,
    indexar_acervo,
    preflight,
)

# A MÁQUINA DE ESCRITA SAIU DAQUI EM 2026-08-29, sem mudar de comportamento.
# Ela nasceu neste arquivo e, quando a frente da malha precisou de um SEGUNDO
# gerador do mesmo tipo (pontes cross-área), copiá-la teria criado o segundo
# lugar para divergir num código cuja falha silenciosa é corromper o estoque
# canônico. Hoje ela vive em tools/v2_link_topics_writer.py, com teste próprio
# (tools/test_v2_link_topics_writer.py), e os dois geradores a importam.
DADOS = Path(__file__).with_suffix(".data.json")
DESTINOS = Destinos(
    root=ROOT,
    lock=ROOT / "data/editorial/.link-topics-enrich-20260812.lock",
    pages=ROOT / "data/editorial/v2_pages",
    backup=ROOT / ".agents/runtime/backup-link-topics-20260812",
    evidencia=ROOT / "data/editorial/v2_link_topics_enrich_evidence_20260812.jsonl",
    gerador=Path(__file__).name,
)


def carregar_dados() -> list[dict]:
    if not DADOS.is_file():
        raise SystemExit(f"arquivo de dados ausente: {DADOS}")
    dados = json.loads(DADOS.read_text(encoding="utf-8"))
    topicos = dados.get("topicos")
    if not isinstance(topicos, list) or not topicos:
        raise SystemExit(f"{DADOS.name}: 'topicos' vazio ou ausente")
    return topicos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    topicos = carregar_dados()
    onde, registros = indexar_acervo(DESTINOS)
    por_shard = preflight(topicos, onde, registros)

    total_alterados = 0
    total_ja = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(DESTINOS.lock):
                for shard in sorted(por_shard):
                    print(f"\n{shard}")
                    alterados, ja = aplicar(
                        DESTINOS, shard, por_shard[shard], args.dry_run)
                    total_alterados += alterados
                    total_ja += ja
                if not args.dry_run:
                    escrever_evidencia(DESTINOS, topicos, onde)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if args.dry_run:
        print(f"\n--dry-run: {total_alterados} página(s) alterável(is), "
              f"{total_ja} tópico(s) já presente(s). Nada escrito.")
        return 0
    print(f"\n{total_alterados} página(s) enriquecida(s), "
          f"{total_ja} tópico(s) já estava(m) presente(s).")
    if total_alterados:
        print("Remedir com tools/check-v2-link-mesh-tail-20260812; "
              "o artefato da malha precisa ser regenerado antes de republicar.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
