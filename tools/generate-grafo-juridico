            caminho_rel = "/".join(("data", "corpus", "jurisprudencia", "stj-espelhos", nome_arquivo))
            fontes.append({
                "caminho": caminho_rel,
                "linhas": _contar_linhas(os.path.join(root, caminho_rel)),
                "sha256": _sha256_arquivo(os.path.join(root, caminho_rel)),
            })
    if os.path.isfile(os.path.join(root, *EXTRACOES_REL.split("/"))):
