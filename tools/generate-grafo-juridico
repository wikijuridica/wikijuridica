        })

    t1 = time.monotonic()
    total_nos, total_arestas = escrever_sqlite(grafo, out_path)
    if args.timings:
        print(f"[timings] escrever_sqlite: {time.monotonic()-t1:.2f}s", file=sys.stderr)

    vizinhanca_path = os.path.join(root, "data", "ai", "grafo_vizinhanca.jsonl")
    t2 = time.monotonic()
    vizinhanca_linhas, vizinhanca_bytes = escrever_vizinhanca(grafo, vizinhanca_path)
    if args.timings:
        print(f"[timings] escrever_vizinhanca: {time.monotonic()-t2:.2f}s", file=sys.stderr)

    tempo_total = time.monotonic() - t0
    tamanho_bytes = os.path.getsize(out_path)
    manifesto = {
        "schema_version": "grafo_juridico_v1",
        "gerado_em": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "fontes": fontes,
        "nos_por_tipo": nos_por_tipo,
        "arestas_por_tipo": arestas_por_tipo,
        "extracoes_llm": grafo.get("extracoes", {}),
        "total_nos": total_nos,
        "total_arestas": total_arestas,
        "tempo_geracao_segundos": round(tempo_total, 3),
        "tamanho_sqlite_bytes": tamanho_bytes,
        "caminho_sqlite": os.path.relpath(out_path, root),
        "vizinhanca": {
            "caminho": os.path.relpath(vizinhanca_path, root),
            "sha256": _sha256_arquivo(vizinhanca_path),
            "tamanho_bytes": vizinhanca_bytes,
            "linhas": vizinhanca_linhas,
        },
    }
    manifesto_path = os.path.join(root, "data", "ai", "grafo_manifest.json")
    os.makedirs(os.path.dirname(manifesto_path), exist_ok=True)
    fd, tmp_manifesto = tempfile.mkstemp(prefix=".grafo_manifest-", suffix=".json.tmp", dir=os.path.dirname(manifesto_path))
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(manifesto, f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp_manifesto, manifesto_path)

    print(
        f"grafo-juridico: {total_nos} nos, {total_arestas} arestas, {tamanho_bytes} bytes, "
        f"vizinhanca {vizinhanca_linhas} linhas/{vizinhanca_bytes} bytes, {tempo_total:.2f}s -> {out_path}"
    )
    frente_d = grafo.get("frente_d") or {}
    if frente_d:
        print(
            "  frente-d (derivadas, suporte >= {minimo} acordaos): pagina->sumula {ps} "
            "(descartadas {psd} por suporte fraco) · dispositivo<->dispositivo {dd} "
            "(descartados {ddd} pares) · tema->dispositivo {td}".format(
                minimo=SUPORTE_MINIMO_ACORDAOS,
                ps=frente_d.get("pagina_sumula", 0),
                psd=frente_d.get("pares_pagina_sumula_descartados", 0),
                dd=frente_d.get("dispositivo_dispositivo", 0),
                ddd=frente_d.get("pares_dispositivo_descartados", 0),
                td=frente_d.get("tema_dispositivo", 0),
            )
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
