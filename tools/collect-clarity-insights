def parse_args(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--dias", type=int, default=3, choices=(1, 2, 3),
                        help="janela em dias (a API so aceita 1, 2 ou 3)")
    parser.add_argument("--dimensoes", default="OS",
                        help="ate 3 dimensoes separadas por virgula")
    parser.add_argument("--sem-url", action="store_true",
                        help="nao faz a segunda requisicao (dimensao URL)")
    return parser.parse_args(argv)


def main(argv=None, busca=busca_http) -> int:
    args = parse_args(argv)

    dimensoes = [d.strip() for d in args.dimensoes.split(",") if d.strip()]
    if len(dimensoes) > 3:
        print("REPROVADO: a API aceita no maximo 3 dimensoes por requisicao")
        return 1
    invalidas = [d for d in dimensoes if d not in DIMENSOES_VALIDAS]
    if invalidas:
        print(f"REPROVADO: dimensao(oes) fora do vocabulario da API: {invalidas}")
        print(f"           validas: {sorted(DIMENSOES_VALIDAS)}")
        return 1

    token = le_env()
    if not token:
        print("sem credencial de exportacao: nada foi coletado e nada foi gravado")
        print("  o token e emitido no painel do Clarity (Settings -> Data Export)")
        print(f"  e lido de {CHAVE}, no ambiente ou em .env.local")
        return 0

    hoje = dt.datetime.now(dt.timezone.utc).date().isoformat()
    cursor = carrega_cursor()
    if cursor.get("dia") != hoje:
        cursor["requisicoes_hoje"] = []
    gastas = cursor.get("requisicoes", 0) if cursor.get("dia") == hoje else 0

    # Plano: a chamada pedida, e a de URL quando fizer sentido. A ordem importa:
    # a pedida e a que a unit depende e a que o teto deve preservar.
    plano = [(dimensoes, TIMEOUT_PRIMARIA_S, True)]
    if not args.sem_url and DIMENSAO_URL not in dimensoes:
        plano.append(([DIMENSAO_URL], TIMEOUT_EXTRA_S, False))

    SERIE.parent.mkdir(parents=True, exist_ok=True)
    for dims, timeout, primaria in plano:
        if gastas >= TETO_COLETOR:
            print(f"teto do coletor atingido ({gastas}/{TETO_COLETOR} hoje, {hoje}; "
                  f"a API da {TETO_DIARIO}) — requisicao {dims} nao feita")
            continue

        status, bruto, erro = requisita(token, args.dias, dims, timeout, busca)
        agora = dt.datetime.now(dt.timezone.utc).isoformat()
        if status is not None:
            # Chegou na API: conta, com ou sem sucesso, e grava JA — o que vier
            # depois (derivacao, ledger) pode falhar, e requisicao feita que nao
            # foi contada e cota gasta duas vezes.
            gastas += 1
            cursor.setdefault("requisicoes_hoje", []).append(
                {"em": agora, "dimensoes": dims, "http_status": status})
            cursor.update({"dia": hoje, "requisicoes": gastas})
            if erro is not None:
                cursor["ultimo_erro"] = {"codigo": status, "em": agora, "dimensoes": dims}
            grava_cursor(cursor)
        if erro is not None:
            print(f"REPROVADO: {erro} (dimensoes={dims})")
            if primaria:
                # Contrato de sempre: a chamada pedida falhou, o exit diz isso.
                return 1
            # A extra falhou: fica registrado no cursor e no journal; o exit e o
            # que a primaria ganhou, porque a unit encadeia o Bing depois.
            continue

        linha = {
            "schema": SCHEMA,
            "coletado_em": agora,
            "project_id": project_id(),
            "janela_dias": args.dias,
            "dimensoes": dims,
            "http_status": status,
            "fuso": "UTC",
            "metricas": bruto,
        }
        resumo = None
        if DIMENSAO_URL in dims:
            # A derivacao nunca derruba a coleta: pages.json e reescrito pela
            # publicacao, e a unit roda enquanto outras frentes publicam. Se ele
            # estiver ausente ou ilegivel, a linha entra com as metricas cruas
            # e o erro NOMEADO em derivacao_urls — nao se esconde e nao vira
            # exit 1 (que pularia o Bing e acionaria o alerta).
            try:
                acervo = carrega_acervo()
                linha["top_urls"], resumo = deriva_top_urls(bruto, acervo)
                linha["derivacao_urls"] = dict(resumo, acervo_fonte=_rel(ACERVO))
            except (OSError, ValueError, KeyError, TypeError) as falha:
                mensagem = f"{type(falha).__name__}: {falha}"
                linha["derivacao_urls"] = {"erro": mensagem, "acervo_fonte": _rel(ACERVO)}
                print(f"REPROVADO: derivacao de top_urls falhou ({mensagem}); "
                      f"linha gravada so com as metricas cruas")

        anterior = ultima_linha_equivalente(hoje, dims)
        if linha_identica(anterior, linha):
            print(f"linha identica ja registrada hoje para {dims} "
                  f"(coletada em {anterior.get('coletado_em')}): nao regravada")
        else:
            acrescenta_linha(SERIE, json.dumps(linha, ensure_ascii=False) + "\n")
        cursor.update({"ultima_coleta": agora, "ultimas_dimensoes": dims})
        grava_cursor(cursor)

        nomes = [m.get("metricName") for m in bruto if isinstance(m, dict)] if isinstance(bruto, list) else []
        print(f"coletado: {len(nomes)} metrica(s) em {args.dias} dia(s), dimensoes={dims}")
        print(f"  metricas: {nomes}")
        print(f"  gravado em {_rel(SERIE)} ({gastas}/{TETO_COLETOR} requisicoes hoje; "
              f"teto da API {TETO_DIARIO})")
        if resumo is not None:
            print(f"  urls: {resumo['paths_distintos']} paths distintos, "
                  f"{resumo['fora_do_acervo']} fora do acervo, "
                  f"{resumo['linhas_sem_url']} linha(s) sem URL, "
                  f"truncado_1000={resumo['truncado_1000']}")
            for item in linha["top_urls"][:5]:
                print(f"    {item['sessoes']:>5} sessoes  {item['url']}"
                      f"{'' if item['no_acervo'] else '  (fora do acervo)'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
