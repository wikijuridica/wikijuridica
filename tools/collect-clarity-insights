def ultima_linha_equivalente(dia, dimensoes):
    """Ultima linha do ledger do MESMO dia UTC com as MESMAS dimensoes, ou None.

    Le de tras para frente e PARA na primeira linha de um dia anterior: o ledger
    e append-only e cronologico, entao tudo antes dela e mais velho ainda. Sem
    essa parada, a primeira execucao de cada dia (que nunca acha par) faria o
    parse de TODO o historico — a linha de URL tem ~223 KB, e um ano dela sao
    ~80 MB de JSON por execucao."""
    try:
        linhas = SERIE.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    for texto in reversed(linhas):
        texto = texto.strip()
        if not texto:
            continue
        try:
            registro = json.loads(texto)
        except ValueError:
            continue
        dia_da_linha = str(registro.get("coletado_em", ""))[:10]
        if dia_da_linha < dia:
            return None
        if dia_da_linha == dia and registro.get("dimensoes") == list(dimensoes):
            return registro
    return None


def linha_identica(anterior, nova):
    """Identica no que a API devolveu — janela e metricas — e nao no relogio.
    `coletado_em` muda a cada execucao; se entrasse na comparacao nada seria
    identico nunca. O CONTEUDO de `top_urls` tambem fica de fora: e derivado
    das metricas, e um pages.json que mudou no meio do dia nao e coleta nova.
    Mas a PRESENCA dele conta: linha cuja derivacao falhou (crua, com
    `derivacao_urls.erro`) nao e identica a uma que derivou — senao a primeira
    falha do dia impediria a execucao seguinte de completar o dado."""
    if anterior is None:
        return False
    return (anterior.get("janela_dias") == nova.get("janela_dias")
            and anterior.get("metricas") == nova.get("metricas")
            and ("top_urls" in anterior) == ("top_urls" in nova))


