import datetime as dt
import json
import os
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

RAIZ = pathlib.Path(__file__).resolve().parent.parent
ENV_LOCAL = RAIZ / ".env.local"
SERIE = RAIZ / "data" / "ops" / "clarity_insights_daily.jsonl"
CURSOR = RAIZ / "data" / "ops" / "clarity_insights_state.json"
FONTE_ID = RAIZ / "internal" / "webanalytics" / "webanalytics.go"
ACERVO = RAIZ / "content" / "pages.json"

ENDPOINT = "https://www.clarity.ms/export-data/api/v1/project-live-insights"
CHAVE = "WIKI_CLARITY_API_TOKEN"

# AO SAIR PARA A REDE, O PORTAL E O WikijuridicaBot (CLAUDE.md secao 11, ordem
# do dono de 2026-09-05). Ate 2026-09-10 este coletor saia como
# `Python-urllib/3.x` para www.clarity.ms, e o gate `check-identidade-de-saida`
# nao via porque so avaliava arquivo que DEFINE um User-Agent — ausencia
