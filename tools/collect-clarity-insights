def monta_url(dias, dimensoes):
    params = {"numOfDays": str(dias)}
    for i, dim in enumerate(dimensoes, start=1):
        params[f"dimension{i}"] = dim
    return ENDPOINT + "?" + urllib.parse.urlencode(params)


def busca_http(url, cabecalhos, timeout):
    """Unico ponto que sai para a rede. Devolve (status, corpo_json); levanta
    urllib.error.HTTPError, urllib.error.URLError ou ValueError como a urllib.
    Os testes injetam um substituto com a mesma assinatura."""
    requisicao = urllib.request.Request(url, headers=cabecalhos)
    with urllib.request.urlopen(requisicao, timeout=timeout) as resposta:
        return resposta.status, json.loads(resposta.read().decode("utf-8"))


def requisita(token, dias, dimensoes, timeout, busca):
    """Faz UMA requisicao. Devolve (status, bruto, erro): em sucesso erro e None;
    em 4xx/5xx status e o codigo e bruto e None; em falha de rede/parse status e
    None. A distincao importa para o cursor: resposta HTTP — mesmo de recusa —
    e uma requisicao contada pela API; falha antes de chegar la, nao."""
    url = monta_url(dias, dimensoes)
    cabecalhos = {"Authorization": "Bearer " + token,
                  "Content-Type": "application/json",
                  "User-Agent": USER_AGENT}
    try:
        status, bruto = busca(url, cabecalhos, timeout)
        return status, bruto, None
    except urllib.error.HTTPError as erro:
        detalhe = {401: "token ausente, invalido ou expirado",
                   403: "token sem autorizacao para esta operacao",
                   400: "parametros invalidos",
                   429: "teto diario de requisicoes excedido"}.get(erro.code, "")
        return erro.code, None, f"a API respondeu {erro.code} {detalhe}".rstrip()
    except (urllib.error.URLError, ValueError) as erro:
        return None, None, f"falha de rede ou resposta ilegivel: {erro}"


# ---------------------------------------------------------------------------
# Derivacao das URLs
# ---------------------------------------------------------------------------

def normaliza_path(url):
    """Reduz a URL que o Clarity devolve ao path servido: sem esquema, sem host,
    sem query, sem fragmento, percent-decoding desfeito. Devolve None quando nao
    ha URL (o Clarity devolve `Url: null` para sessoes sem pagina atribuida).

    Nao muda caixa nem barra final: o path e a chave do acervo e o nginx e
    sensivel a ambos. A equivalencia `/x` ~ `/x/` (a Cloudflare redireciona a
    primeira para a segunda) e resolvida em `no_acervo`, nao aqui."""
    if url is None:
        return None
    texto = str(url).strip()
    if not texto:
        return None
    partes = urllib.parse.urlsplit(texto)
    path = partes.path
    if not partes.scheme and not partes.netloc and not texto.startswith("/"):
        # "wikijuridica.com.br/x/" sem esquema: urlsplit poe o host no path.
        # Medido em 2026-08-29, 29/29 URLs vieram absolutas; este ramo so
        # protege contra a grafia relativa, e trabalha sobre partes.path para a
        # query nunca vazar para dentro do caminho.
        path = "/" + path.split("/", 1)[1] if "/" in path else "/"
    path = urllib.parse.unquote(path)
    if not path:
        path = "/"
    if not path.startswith("/"):
        path = "/" + path
    return path


def carrega_acervo(caminho=None):
    """Conjunto de `path` de content/pages.json (lista de paginas, cada uma com
    `path`). Todo status entra — `noindex` e `needs_review` tambem sao paginas do
    acervo; o que se quer separar e URL que o portal nao gera (404, sonda,
    endpoint de maquina). Levanta em arquivo ausente ou ilegivel: acervo vazio
    marcaria todo path como fora e o campo mentiria."""
    caminho = ACERVO if caminho is None else caminho
    paginas = json.loads(pathlib.Path(caminho).read_text(encoding="utf-8"))
    if not isinstance(paginas, list):
        raise ValueError(f"{caminho}: esperava lista de paginas")
    return {p["path"] for p in paginas if isinstance(p, dict) and p.get("path")}


def no_acervo(path, acervo):
    if path in acervo:
        return True
    if not path.endswith("/") and path + "/" in acervo:
        return True
    return False


def _num(valor):
    """A doc oficial mostra numeros como string ("9554"); a resposta real traz
    int. Aceita os dois; None e texto ilegivel viram 0."""
    if valor is None:
        return 0
    if isinstance(valor, bool):
        return int(valor)
    if isinstance(valor, (int, float)):
        return valor
    try:
        texto = str(valor).strip()
        return int(texto) if texto.lstrip("-").isdigit() else float(texto)
    except ValueError:
        return 0


def _url_da_linha(linha):
    """A dimensao se chama `URL` no pedido e `Url` na resposta. Caso-insensivel
    para nao depender de qual das duas grafias a Microsoft usa amanha."""
    for chave, valor in linha.items():
        if chave.lower() == "url":
            return valor
    return None


def _por_metrica(bruto):
    saida = {}
    if not isinstance(bruto, list):
        return saida
    for bloco in bruto:
        if isinstance(bloco, dict) and isinstance(bloco.get("information"), list):
            saida[bloco.get("metricName")] = bloco["information"]
    return saida


def deriva_top_urls(bruto, acervo, teto=TETO_TOP_URLS):
    """Agrega a resposta por path normalizado e devolve (top_urls, resumo).

    `sessoes` e `totalSessionCount` (inclui bot; `sessoes_bot` fica ao lado).
    `usuarios` e a SOMA de `distinctUserCount` das variantes (fragmento, query)
    que colapsam no mesmo path — e um teto, nao uma contagem distinta, e por
    isso se chama assim e nao "usuarios distintos". `paginas_por_sessao` e a
    razao que a API devolve, ponderada por sessao; a API NAO da pageviews por
    URL (o `pagesViews` das metricas de clique e o das sessoes com aquele
    defeito), e nenhum campo aqui finge que da.

    Ordem: sessoes desc, usuarios desc, path asc — deterministica, para que a
    mesma resposta produza a mesma linha e o ledger nao se regrave a toa."""
    metricas = _por_metrica(bruto)
    agregado = {}
    linhas_sem_url = 0
    sessoes_sem_url = 0

    def entrada(path):
        if path not in agregado:
            agregado[path] = {
                "url": path, "sessoes": 0, "sessoes_bot": 0, "usuarios": 0,
                "variantes": set(), "_ppsx": 0.0,
                "tempo_total_s": 0, "tempo_ativo_s": 0,
                "_scrollx": 0.0, "_scrollw": 0,
                "dead_clicks": 0, "rage_clicks": 0, "quickbacks": 0,
                "erros_script": 0, "error_clicks": 0, "scroll_excessivo": 0,
            }
        return agregado[path]

    sessoes_por_url = {}
    for linha in metricas.get("Traffic", []):
        url = _url_da_linha(linha)
        path = normaliza_path(url)
        sessoes = _num(linha.get("totalSessionCount"))
        if path is None:
            linhas_sem_url += 1
            sessoes_sem_url += sessoes
            continue
        sessoes_por_url[str(url)] = sessoes
        e = entrada(path)
        e["variantes"].add(str(url))
        e["sessoes"] += sessoes
        e["sessoes_bot"] += _num(linha.get("totalBotSessionCount"))
        e["usuarios"] += _num(linha.get("distinctUserCount"))
        e["_ppsx"] += _num(linha.get("pagesPerSessionPercentage")) * sessoes

    for linha in metricas.get("EngagementTime", []):
        path = normaliza_path(_url_da_linha(linha))
        if path is None:
            continue
        e = entrada(path)
        e["tempo_total_s"] += _num(linha.get("totalTime"))
        e["tempo_ativo_s"] += _num(linha.get("activeTime"))

    for linha in metricas.get("ScrollDepth", []):
        url = _url_da_linha(linha)
        path = normaliza_path(url)
        if path is None:
            continue
        e = entrada(path)
        peso = sessoes_por_url.get(str(url), 0) or 1
        e["_scrollx"] += _num(linha.get("averageScrollDepth")) * peso
        e["_scrollw"] += peso

    cliques = {"DeadClickCount": "dead_clicks", "RageClickCount": "rage_clicks",
               "QuickbackClick": "quickbacks", "ScriptErrorCount": "erros_script",
               "ErrorClickCount": "error_clicks", "ExcessiveScroll": "scroll_excessivo"}
    for nome, campo in cliques.items():
        for linha in metricas.get(nome, []):
            path = normaliza_path(_url_da_linha(linha))
            if path is None:
                continue
            entrada(path)[campo] += _num(linha.get("subTotal"))

    saida = []
    for e in agregado.values():
        item = {
            "url": e["url"],
            "sessoes": e["sessoes"],
            "sessoes_bot": e["sessoes_bot"],
            "usuarios": e["usuarios"],
            "paginas_por_sessao": round(e["_ppsx"] / e["sessoes"], 4) if e["sessoes"] else None,
            "tempo_total_s": e["tempo_total_s"],
            "tempo_ativo_s": e["tempo_ativo_s"],
            "scroll_medio": round(e["_scrollx"] / e["_scrollw"], 2) if e["_scrollw"] else None,
            "dead_clicks": e["dead_clicks"],
            "rage_clicks": e["rage_clicks"],
            "quickbacks": e["quickbacks"],
            "erros_script": e["erros_script"],
            "error_clicks": e["error_clicks"],
            "scroll_excessivo": e["scroll_excessivo"],
            "variantes": len(e["variantes"]),
            "no_acervo": no_acervo(e["url"], acervo),
        }
        saida.append(item)
    saida.sort(key=lambda i: (-i["sessoes"], -i["usuarios"], i["url"]))

    linhas_max = max((len(v) for v in metricas.values()), default=0)
    resumo = {
        "paths_distintos": len(saida),
        "linhas_sem_url": linhas_sem_url,
        "sessoes_sem_url": sessoes_sem_url,
        "linhas_max_por_metrica": linhas_max,
        "truncado_1000": linhas_max >= TETO_LINHAS_API,
        "acervo_paths": len(acervo),
        "fora_do_acervo": sum(1 for i in saida if not i["no_acervo"]),
    }
    return saida[:teto], resumo


