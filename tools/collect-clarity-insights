# oficial nem submissao de URL. A forma abaixo e' exatamente a que
# `internal/wikijuridicabot.UserAgentComProposito` produziria.
USER_AGENT = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
              "+https://wikijuridica.com.br/bot/; medicao-de-audiencia)")
TETO_DIARIO = 10          # o da API, por projeto e por dia
TETO_COLETOR = 8          # o desta ferramenta: deixa 2 para uso manual
TETO_LINHAS_API = 1000    # a API corta a resposta aqui, sem paginar
TETO_TOP_URLS = 100
SCHEMA = "clarity_insights_v1"
DIMENSAO_URL = "URL"

# Orcamento de tempo: a unit embrulha o coletor em `timeout 120`. Primeira
# requisicao 60 s (como sempre foi), segunda 40 s, carga do acervo ~2 s — o pior
# caso fica abaixo dos 120 s e o coletor do Bing, que vem depois, ainda roda.
TIMEOUT_PRIMARIA_S = 60
TIMEOUT_EXTRA_S = 40

# Dimensoes aceitas pela API. Lista fechada porque um nome errado devolve 400 e
# consome uma das dez requisicoes do dia.
DIMENSOES_VALIDAS = {"Browser", "Device", "Country/Region", "OS", "Source",
                     "Medium", "Campaign", "Channel", DIMENSAO_URL}


def le_env():
    """Variavel de ambiente tem precedencia sobre .env.local, como no resto do
    projeto (ver internal/contactchannel e tools/purge-edge-cache)."""
    if os.environ.get(CHAVE):
        return os.environ[CHAVE].strip()
    try:
        for linha in ENV_LOCAL.read_text(encoding="utf-8").splitlines():
            linha = linha.strip()
            if not linha or linha.startswith("#") or "=" not in linha:
                continue
            nome, valor = linha.split("=", 1)
            if nome.strip() == CHAVE:
                return valor.strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


def project_id():
    """Le o ClarityProjectID da fonte Go. Digitar o valor aqui criaria a segunda
    copia que o proprio comentario daquele arquivo existe para impedir."""
    import re
    achado = re.search(r'^\tClarityProjectID\s*=\s*"([^"]*)"',
                       FONTE_ID.read_text(encoding="utf-8"), re.M)
    if not achado:
        raise SystemExit(f"ClarityProjectID nao encontrado em {FONTE_ID}")
    return achado.group(1)


def carrega_cursor():
    try:
        return json.loads(CURSOR.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def acrescenta_linha(caminho, texto):
    """Acrescenta UMA linha ao ledger, com fsync.

    Append direto, e nao escrita-em-tmp-e-replace: replace sobre um JSONL
    append-only exigiria reescrever o arquivo inteiro a cada coleta, e uma queda
    no meio perderia o historico em vez de perder a linha nova. O fsync garante
    que a linha esteja no disco antes de o cursor ser atualizado — nessa ordem, o
    pior caso e recontar uma requisicao, nunca gravar dado sem contar."""
    with open(caminho, "a", encoding="utf-8") as saida:
        saida.write(texto)
        saida.flush()
        os.fsync(saida.fileno())


def grava_atomico(caminho, texto):
    """Substitui o arquivo inteiro por escrita em tmp + replace atomico. Vale para
    o CURSOR, que e um documento pequeno reescrito por completo — arquivo de
    estado truncado por queda de energia e pior que ausente, porque parece dado."""
    tmp = caminho.with_suffix(caminho.suffix + ".tmp")
    with open(tmp, "w", encoding="utf-8") as saida:
        saida.write(texto)
        saida.flush()
        os.fsync(saida.fileno())
    os.replace(tmp, caminho)


def grava_cursor(cursor):
    grava_atomico(CURSOR, json.dumps(cursor, ensure_ascii=False, indent=2) + "\n")


def _rel(caminho):
    """Caminho relativo a raiz do repo para o journal e para o ledger; absoluto
    quando esta fora dela (a bancada aponta os arquivos para um diretorio
    temporario)."""
    try:
        return str(pathlib.Path(caminho).relative_to(RAIZ))
    except ValueError:
        return str(caminho)


