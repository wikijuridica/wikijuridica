#!/usr/bin/env bash
# generate-legal-corpus-article-index — recompila internal/legalcorpusindex/
# artigos_generated.go a partir de data/legal-corpus/*.json.
#
# ESCREVE (prefixo generate-, por contrato do CLAUDE.md). Rode-o sempre que um
# diploma entrar, sair ou for corrigido no corpus; TestIndiceBateComOCorpusReal
# falha se o gerado divergir da fonte.
#
# Envelopado em run-heavy-throttled + run-go-cmd-cached desde 2026-09-04: o
# `go-modern run` direto burlava budget, stop_condition, cache e artifact_claim,
# e este era o unico wrapper material de generate-* nessa condicao
# (TestMaterialGenerateWrappersDoNotCallGoRunDirectly, vermelho desde c1ceb74d).
#
# Os numeros abaixo sao MEDIDOS, nao estimados. Duas execucoes com o envelope
# completo: duration_ms=2740 e 2767, exit_code=0, sha256 do artefato inalterado
# nas duas (idempotente). 17 diplomas resolvidos, 7.770 artigos indexados ->
# ~2.800 registros/s. A primeira tentativa declarou expected_duration_ms=500,
# medido so no `go-modern run` cru: o supervisor abortou com exit 125 e
# idle_stall_risk, porque no modo supervisor o relogio inclui a COMPILACAO.
# Se voltar a estourar, a causa e o tempo de build, nao o gerador.
#
# WIKI_HEAVY_ARTIFACT_CLAIM_PATH aponta para `data/legal-corpus` — o artefato
# COMPARTILHADO que a operacao envolve, e o que run-heavy-throttled exige em
# `shared_artifact_claim_path` (data/, content/, public/, .agents/,
# .release-staging/). O arquivo que o comando de fato reescreve fica declarado
# no fingerprint esperado e no lock_scope, que e onde duas sessoes colidiriam.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_TIMING_MODE="${WIKI_HEAVY_TIMING_MODE:-supervisor_wall_clock_v1}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:legal-corpus-article-index:artifact:internal/legalcorpusindex/artigos_generated.go}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-30000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-4000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=2800}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/legal-corpus}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-legal-corpus-article-index}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:internal/legalcorpusindex/artigos_generated.go}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-legal-corpus-article-index "$@"
