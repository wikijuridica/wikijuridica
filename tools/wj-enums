#!/usr/bin/env bash
# tools/wj-enums — portão da fonte única de enums (TASKLIST F0.O2): confere os 4
# alvos de wj/lex/enums/out/ (JSON Schema, SQL, Go, CDDL) contra
# wj/lex/enums/enums.yaml, byte a byte.
#
# PORQUE: um enum escrito em quatro lugares diverge em silêncio (banco, schema
# JSON, Go e CBOR discordam). A fonte é o YAML; os alvos são gerados, e alvo
# editado à mão reprova aqui e no tools/wj-ci.
#
# Uso: tools/wj-enums            (= --check: só compara; nada é gravado)
#      tools/wj-enums --apply    (regrava os 4 alvos a partir do YAML)
#      tools/wj-enums --check -dir wj/lex/enums
#
# SAIDA: no --check, uma linha DIVERGE por alvo que não bate, a linha de lacuna
# da prosa e "N enums, M valores, T alvos conferem, D divergências".
# Exit 0 = os 4 alvos conferem (ou --apply gravou); 2 = divergência, enums.yaml
# inválido, erro de E/S ou de uso, ou o gerador não compilou.
#
# POR QUE COMPILA EM VEZ DE `go run`: medido em 2026-09-24 com go1.26.6, `go run`
# de um main que sai 2 imprime "exit status 2" e sai 1 (achado do O4 no
# barramento). O binário vai para .cache/ (no .gitignore), num diretório próprio
# por execução, e sai no fim. -tags devcmds EXPLICITO: o main é dev-main
# (//go:build devcmds) e o tools/go-modern só injeta a tag em run e test.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Egresso zero em build (S4): nenhum download de toolchain; o go.mod pina o toolchain.
export GOTOOLCHAIN=local

mkdir -p "$ROOT/.cache/wj-enums"
BIN_DIR="$(mktemp -d "$ROOT/.cache/wj-enums/bin.XXXXXX")"
trap 'rm -rf "$BIN_DIR"' EXIT

if ! ./tools/go-modern build -tags devcmds -o "$BIN_DIR/wj-enums" ./wj/cmd/wj-enums; then
	echo "wj-enums: o gerador não compilou" >&2
	exit 2
fi

if [ "$#" -eq 0 ]; then
	set -- --check
fi
"$BIN_DIR/wj-enums" "$@"
