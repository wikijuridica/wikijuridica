#!/usr/bin/env python3
"""check-bot-traffic — trafego das ROTAS DINAMICAS, e so delas.

ESCOPO, declarado primeiro porque a leitura errada dele leva a decisao errada:
este comando le data/ops/access/*.jsonl, gravado por
internal/httpserver/access_log.go — o log do processo Go. Desde o cutover de
2026-08-06 o nginx serve as 9.631 paginas do acervo direto do disco, e o Go so
ve o que cai no fallback: /buscar/, /contato/advogado/ e os hubs antes de eles
serem materializados.

ELE NAO MEDE O TRAFEGO DO ACERVO. Medido em 2026-08-07, no mesmo dia: este
comando reportava 420 requisicoes e "busca/usuario valioso: 1,7%", enquanto a
borda registrava ClaudeBot com 43.087 e GPTBot com 16.460 requisicoes
estimadas. Quem tomasse decisao de SEO por este numero concluiria que quase
ninguem rastreia o portal.

PARA TRAFEGO DE BOT DE VERDADE, use:
  tools/generate-bot-agents-daily   — serie por User-Agent EXATO na borda
  tools/generate-bot-traffic-origin — log do nginx, com IP real verificado
  tools/check-access-log-bots       — gate sobre o log real do nginx

O que ESTE comando serve: ver o que o processo Go esta atendendo — util para
diagnosticar a rota de busca e o fallback, nao para medir descoberta.

TRAFEGO REAL vs RUIDO: aquecimento interno (X-Warming-Request) e simulacao de
crawler para teste (X-Bot-Simulation) sao EXCLUIDOS por padrao. Somar o proprio
aquecimento como visita e fraude de metrica; ver a secao anti-fraude do
CLAUDE.md. Use --incluir-sinteticos para ver tudo.

...E O QUE NAO SE DECLAROU SINTETICO E MESMO ASSIM ERA: ate 2026-08-12 esses dois
campos eram o unico filtro, e por isso nao apanhavam a requisicao sintetica que
esquecia de se declarar. O harness de smoke do cmd/check varreu o
published_manifest inteiro com dois User-Agents de Googlebot sem mandar o header,
e este comando passou a reportar "Googlebot: 19.259" num dia em que a borda viu
Googlebot real na ordem de dezenas — o filtro sendo derrotado exatamente pelo
caso que ele existia para barrar. Essas linhas nao podem ser apagadas (o ledger e
append-only), entao ficam onde estao e sao neutralizadas por hash de conteudo em
data/ops/access_ledger_quarantine.jsonl. A leitura sai por tools/accessledger.py,
que e o dono do criterio: a quarentena vale SEMPRE, inclusive sob
--incluir-sinteticos, porque linha forjada nao e "tipo de trafego" que o operador
possa querer inspecionar.

Read-only.

Uso:
    tools/check-bot-traffic
    tools/check-bot-traffic --dias 7
    tools/check-bot-traffic --bots            # so requisicoes de robo
    tools/check-bot-traffic --incluir-sinteticos
"""
import argparse
import collections
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import accessledger  # noqa: E402  (tools/ nao e pacote; o caminho entra acima)

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))


def load(days, include_synthetic):
    """Delega para tools/accessledger.py — o dono do criterio de saneamento.

    Reusar, e nao repetir o filtro aqui, e o que impede a divergencia que criou o
    defeito: um leitor com o proprio criterio volta a somar a varredura.
    """
    return accessledger.linhas_saneadas(
        ROOT, dias=days, incluir_sinteticos=include_synthetic)


def percentile(values, fraction):
    if not values:
        return 0
    ordered = sorted(values)
    return ordered[min(int(len(ordered) * fraction), len(ordered) - 1)]


# Teto de silêncio do ledger do Go — ver a mesma constante em
# tools/generate-serie-404-bots. Fonte parada não é "nenhum bot veio": em
# 01-02/09/2026 o processo ficou 17 h em `failed` e este relatório teria dito
# que o portal não recebeu visita nenhuma.
IDADE_MAXIMA_LEDGER_GO_HORAS = 2.0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dias", type=int, default=0, help="janela em dias (0 = tudo)")
    parser.add_argument("--bots", action="store_true", help="so requisicoes classificadas como robo")
    parser.add_argument("--incluir-sinteticos", action="store_true",
                        help="inclui aquecimento e simulacao (fora da metrica real)")
    parser.add_argument("--top", type=int, default=15)
    args = parser.parse_args()

    idade_go = accessledger.idade_do_ledger_go(ROOT)
    if idade_go is not None and idade_go > IDADE_MAXIMA_LEDGER_GO_HORAS:
        print("check-bot-traffic: INCONCLUSIVO — o ledger do processo Go não recebe linha há "
              "%.1f h (teto %.1f). Fonte parada não é ausência de bot; use o ledger do nginx "
              "(data/ops/access/nginx-*.jsonl) para a origem completa." % (idade_go, IDADE_MAXIMA_LEDGER_GO_HORAS),
              file=sys.stderr)
        return 2

    rows, saneamento = load(args.dias, args.incluir_sinteticos)

    # Exclusao em silencio e a mesma classe de problema que numero inflado: quem
    # le o relatorio precisa ver que houve corte e por que. Vai antes do
    # cabecalho para que nenhum numero abaixo seja lido sem essa ressalva.
    if saneamento["quarantine_problems"]:
        print("check-bot-traffic: a quarentena de linhas forjadas esta inconsistente "
              "e NAO foi aplicada — os numeros abaixo podem estar inflados:",
              file=sys.stderr)
        for problema in saneamento["quarantine_problems"]:
            print("  - %s" % problema, file=sys.stderr)
    if saneamento["quarantined_excluded"]:
        print("AVISO: %d linha(s) fora da conta por estarem em quarentena "
              "(requisicao que o proprio projeto gerou e gravou como trafego real)."
              % saneamento["quarantined_excluded"])
        print("       motivo por lote em data/ops/access_ledger_quarantine.jsonl")
        print("       auditoria: tools/check-access-ledger-contamination")
        print()

    if not rows:
        print("nenhuma requisicao registrada ainda em data/ops/access/.")
        print("o log so passa a existir depois que o servidor com access_log.go sobe.")
        return 0

    if args.bots:
        rows = [r for r in rows if r.get("bot_class") not in ("", "unknown_or_standard_user_agent")]
        if not rows:
            print("nenhuma requisicao de robo na janela.")
            return 0

    print("=== TRAFEGO DAS ROTAS DINAMICAS (fallback Go) ===")
    print("    NAO e o trafego do acervo: as 9.631 paginas saem do disco pelo nginx")
    print("    e nao passam por este log. Para bot de verdade:")
    print("      tools/generate-bot-agents-daily / tools/generate-bot-traffic-origin")
    print("requisicoes            : %d" % len(rows))
    days = sorted({r["ts"][:10] for r in rows})
    print("periodo                : %s" % (days[0] if len(days) == 1 else "%s a %s" % (days[0], days[-1])))

    by_class = collections.Counter(r.get("bot_class") or "?" for r in rows)
    print("\n--- por classe de agente ---")
    for name, count in by_class.most_common():
        label = {
            "valuable_search_or_user_bot": "busca/usuario valioso (Google, Bing, OAI)",
            "training_bot": "treinamento de IA",
            "ads_validation_bot": "validacao de anuncio",
            "product_use_control": "uso de produto",
            "unknown_or_standard_user_agent": "navegador ou UA nao catalogado",
            # So aparece sob --incluir-sinteticos: desde 2026-09-01 a sonda do
            # internal/checks (X-Bot-Simulation) sai com classe propria em vez
            # de vestir a do UA — antes eram 89.188 linhas/dia como "navegador"
            # e 40.452 como Googlebot (access-2026-08-30.jsonl). Sem este rotulo
            # o relatorio imprimiria a chave crua.
            "self_simulation_probe": "sonda do proprio repo (X-Bot-Simulation)",
        }.get(name, name)
        print("  %-46s %6d  (%4.1f%%)" % (label, count, 100.0 * count / len(rows)))

    status = collections.Counter(r.get("status") for r in rows)
    print("\n--- respostas ---")
    for code, count in sorted(status.items()):
        flag = "" if code < 400 else "   <-- ERRO"
        print("  %-6s %6d%s" % (code, count, flag))

    print("\n--- paginas mais pedidas ---")
    for path, count in collections.Counter(r.get("path") for r in rows).most_common(args.top):
        print("  %6d  %s" % (count, path))

    bot_rows = [r for r in rows if r.get("bot_class") not in ("", "unknown_or_standard_user_agent")]
    if bot_rows and not args.bots:
        print("\n--- o que os ROBOS pedem ---")
        for path, count in collections.Counter(r.get("path") for r in bot_rows).most_common(args.top):
            print("  %6d  %s" % (count, path))
        print("\n--- robos identificados ---")
        for rule, count in collections.Counter(
                r.get("bot_rule") or "(sem regra)" for r in bot_rows).most_common(12):
            print("  %6d  %s" % (count, rule))

    durations = [r.get("duration_ms", 0) for r in rows]
    sizes = [r.get("bytes", 0) for r in rows]
    print("\n--- desempenho ---")
    print("  duracao  mediana %dms | p95 %dms | max %dms"
          % (percentile(durations, 0.5), percentile(durations, 0.95), max(durations)))
    print("  tamanho  mediana %.1fKB | p95 %.1fKB | max %.1fKB"
          % (percentile(sizes, 0.5) / 1024, percentile(sizes, 0.95) / 1024, max(sizes) / 1024))
    heavy = [r for r in rows if r.get("bytes", 0) > 51200]
    if heavy:
        print("  ACIMA DE 50KB (contrato de indexacao): %d requisicoes" % len(heavy))

    errors = [r for r in rows if r.get("status", 200) >= 400]
    if errors:
        print("\n--- rotas com erro ---")
        for path, count in collections.Counter(r.get("path") for r in errors).most_common(args.top):
            print("  %6d  %s" % (count, path))
    return 0


if __name__ == "__main__":
    sys.exit(main())
