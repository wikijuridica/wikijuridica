#!/usr/bin/env python3
"""check-bot-allowlist-derivada — quem tem pista ilimitada no nginx precisa estar na política.

READ-ONLY. Sai != 0 quando o allowlist `$wj_bot_allow` do nginx e a classe
`valuable_search_or_user_bot` de `content/crawl_policy.json` discordam, nos dois
sentidos.

O QUE ESTE GATE GUARDA, e não é cosmético.

`$wj_bot_allow` não é uma etiqueta: quem entra nele recebe **chave de rate limit
vazia**, e chave vazia é pista sem limite —

    map $wj_bot_allow $wj_generic_key {
        default $wj_client_key;
        1       "";
    }

O próprio vhost declara, no comentário da linha 44, que essa lista É
`crawl.RequiredValuableBots()`. Ela não é: é uma cópia manual, e cópia manual
diverge.

MEDIDO EM 2026-08-26, e o resultado contraria o que se esperava encontrar:

    registry, classe valuable_search_or_user_bot : 20
    allowlist do nginx                           : 25
    valiosos ausentes do allowlist               :  0
    com pista ilimitada e SEM autorização        :  5

Os cinco: `google-inspectiontool`, `googleother`, `storebot-google` e `yandexbot`
— que **não existem no registry** — e `oai-adsbot`, que existe e está classificado
como `ads_validation_bot`, com tier próprio, não ilimitado.

POR QUE O GATE NÃO MANDA SIMPLESMENTE REMOVER OS CINCO. Três deles fazem tráfego
real e útil: o YandexBot cobre 99,28% do acervo, o `google-inspectiontool` é o
diagnóstico do Search Console (com rDNS bidirecional confirmado) e o `googleother`
é crawler do próprio Google. Cortar a pista deles seria trocar um defeito de
governança por um defeito de rastreio. A saída correta é **classificá-los no
registry**, que é a fonte, e deixar o nginx derivar — e é isso que a mensagem de
reprovação orienta.

O SENTIDO INVERSO TAMBÉM REPROVA, e é o que protege contra a regressão mais cara:
bot valioso que entre no registry e não chegue ao nginx perde o tratamento
diferenciado em silêncio, sem erro e sem alarme.

E FICA REGISTRADO O QUE ESTE GATE DERRUBOU: o plano da sessão mandava "corrigir o
allowlist: falta `amazonbot`". Não falta. `Amazonbot` está no registry como
`training_bot`, `rate_tier: training_tier_standard`, 60 rpm, `unlimited: false` —
acrescentá-lo ao allowlist daria pista ILIMITADA a um bot que a própria política
limita, invertendo a regra em vez de cumpri-la.
"""

import argparse
import json
import os
import re
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
POLITICA = os.path.join(RAIZ, "content", "crawl_policy.json")
CLASSE_VALIOSA = "valuable_search_or_user_bot"

# Os dois arquivos de nginx que declaram o map. O vivo é a fonte; o dedicado é
# gerado dele. Divergência entre os dois é assunto de `check-nginx-standalone-parity`,
# mas se um deles conceder pista que a política não autoriza, este gate acusa.
VHOSTS = (
    os.path.join(RAIZ, "ops", "nginx", "wikijuridica.conf"),
    os.path.join(RAIZ, "ops", "nginx", "standalone", "nginx.conf"),
)


def allowlist(caminho: str) -> tuple[set[str], str]:
    """Devolve (tokens com pista ilimitada, valor do `default`).

    O PARSING É FAIL-CLOSED, e a razão é um bypass real: a primeira versão deste
    gate casava só `~*token 1;` e IGNORAVA a linha `default`. Trocar `default 0;`
    por `default 1;` daria pista ilimitada a TODO agente do mundo — e o gate
    continuaria verde, porque os 25 tokens explícitos permaneceriam os mesmos.

    É a mesma família de defeito que este repositório já pagou com os dois
    parsers de robots que discordavam sobre o mesmo arquivo: quem julga uma
    configuração com um parser mais estreito que o do consumidor real deixa
    passar exatamente o que o consumidor aceita.

    Por isso: toda linha não vazia e não comentada do bloco tem de ser
    reconhecida. Linha que este parser não entenda REPROVA — nunca é ignorada em
    silêncio, que era o mecanismo do bypass.
    """
    with open(caminho, encoding="utf-8") as f:
        conteudo = f.read()
    bloco = re.search(r"map \$http_user_agent \$wj_bot_allow \{(.*?)\n\}", conteudo, re.S)
    if not bloco:
        raise SystemExit(f"map $wj_bot_allow ausente em {caminho} — o allowlist mudou de forma "
                         "e este gate precisa ser revisto antes de valer alguma coisa")

    # Formas que o nginx aceita numa entrada de map, todas cobertas de propósito:
    # com ou sem `~*`/`~`, com ou sem aspas no padrão e no valor, e em qualquer
    # caixa. Estreitar qualquer uma delas reabre o bypass.
    entrada = re.compile(
        r"""^\s*(?P<padrao>"[^"]+"|'[^']+'|[^\s;]+)\s+(?P<valor>"[^"]*"|'[^']*'|[^\s;]+)\s*;\s*$""")

    concedidos: set[str] = set()
    default = None
    naoreconhecidas: list[str] = []
    for linha in bloco.group(1).split("\n"):
        limpa = linha.strip()
        if not limpa or limpa.startswith("#"):
            continue
        casado = entrada.match(limpa)
        if not casado:
            naoreconhecidas.append(limpa)
            continue
        padrao = casado.group("padrao").strip("\"'")
        valor = casado.group("valor").strip("\"'")
        if padrao == "default":
            default = valor
            continue
        if valor == "1":
            concedidos.add(padrao.lstrip("~*").lower().rstrip("/"))

    if naoreconhecidas:
        raise SystemExit(
            f"{caminho}: {len(naoreconhecidas)} linha(s) do map que este gate NAO SABE LER.\n"
            "  Ignora-las seria reabrir o bypass que este parser existe para fechar:\n    "
            + "\n    ".join(naoreconhecidas[:5]))

    return concedidos, (default if default is not None else "AUSENTE")

def main() -> int:
    argparse.ArgumentParser().parse_args()

    with open(POLITICA, encoding="utf-8") as f:
        politica = json.load(f)
    registro = politica["bot_registry"]
    por_token = {b["user_agent"].lower(): b for b in registro}
    valiosos = {t for t, b in por_token.items() if b.get("class") == CLASSE_VALIOSA}

    falhou = False
    for vhost in VHOSTS:
        if not os.path.isfile(vhost):
            continue
        concedidos, default = allowlist(vhost)
        rel = os.path.relpath(vhost, RAIZ)
        # O `default` decide o que acontece com QUEM NAO ESTA NA LISTA, e é o
        # ponto onde um bypass custaria mais barato: uma linha trocada libera
        # todo agente do mundo sem mexer em nenhum token.
        if default != "0":
            falhou = True
            print(f"  - default do map e {default!r}, nao \"0\": todo agente NAO listado")
            print("    recebe pista ilimitada. E a forma mais barata de furar esta politica.")
        sem_autorizacao = sorted(concedidos - valiosos)
        sem_pista = sorted(valiosos - concedidos)
        print(f"{rel}: {len(concedidos)} com pista ilimitada | "
              f"registry classe {CLASSE_VALIOSA}: {len(valiosos)}")

        if sem_autorizacao:
            falhou = True
            print(f"  - {len(sem_autorizacao)} agente(s) com pista ILIMITADA que a política não")
            print("    autoriza. Pista ilimitada é chave de rate limit vazia, não etiqueta:")
            for token in sem_autorizacao:
                entrada = por_token.get(token)
                if entrada is None:
                    print(f"      {token:26s} NAO EXISTE no registry")
                else:
                    print(f"      {token:26s} registry: class={entrada.get('class')} "
                          f"tier={entrada.get('rate_tier')}")
            print("    Resolva CLASSIFICANDO no registry, não removendo do nginx sem medir:")
            print("    parte deles faz tráfego real e útil, e cortar a pista trocaria um defeito")
            print("    de governança por um defeito de rastreio.")
        if sem_pista:
            falhou = True
            print(f"  - {len(sem_pista)} bot(s) valioso(s) no registry SEM pista no nginx —")
            print("    perdem o tratamento diferenciado em silêncio, sem erro e sem alarme:")
            for token in sem_pista:
                print(f"      {token}")

    if falhou:
        print("check-bot-allowlist-derivada: FAIL")
        return 1
    print("check-bot-allowlist-derivada: OK (allowlist e política dizem a mesma coisa)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
