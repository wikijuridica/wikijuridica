#!/usr/bin/env python3
"""check-baseline-testes-vermelhos — o baseline de vermelhos não pode apodrecer.

READ-ONLY. Recebe o log de uma execução de `go test` e o compara com
`data/ops/testes_vermelhos_conhecidos.json`:

  * falha que NÃO está no baseline  -> REGRESSÃO, exit 1 (é o que o pre-commit cobra);
  * teste do baseline que PASSOU    -> baseline inflado, exit 1 com o comando de
                                       conserto (dívida que foi paga tem de sair
                                       da lista, senão a lista vira anistia geral);
  * o resto                          -> exit 0, imprimindo o que ficou tolerado.

Sem o segundo veredito, um baseline gerado uma vez cobriria para sempre qualquer
teste que já tenha falhado um dia — e aí o gate deixaria de valer. Ele só é
avaliado para os pacotes REALMENTE executados no log, porque um pacote que não
rodou não prova nada sobre os seus vermelhos.

Uso:
    ./tools/check-baseline-testes-vermelhos <log-do-go-test>
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
BASELINE = RAIZ / "data/ops/testes_vermelhos_conhecidos.json"
FALHA = re.compile(r"^--- FAIL: (\S+)")
SUMARIO = re.compile(r"^(ok|FAIL)\s+(\S+)\s+")
PANICO = re.compile(r"^panic: test timed out")


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("uso: check-baseline-testes-vermelhos <log-do-go-test>", file=sys.stderr)
        return 2
    log = Path(argv[0])
    if not log.exists():
        print(f"REPROVADO: log {log} nao existe", file=sys.stderr)
        return 1
    texto = log.read_text(encoding="utf-8", errors="replace")

    if PANICO.search(texto) or "test timed out after" in texto:
        print("REPROVADO: a suite estourou o tempo — o veredito nao e conclusivo", file=sys.stderr)
        return 1

    documento = json.loads(BASELINE.read_text(encoding="utf-8")) if BASELINE.exists() else {}
    conhecidos = documento.get("por_pacote", {})

    pendentes: list[str] = []
    falhas_por_pacote: dict[str, set[str]] = {}
    pacotes_executados: list[str] = []
    for linha in texto.splitlines():
        crua = linha.strip()
        casa = FALHA.match(crua)
        if casa:
            if "/" not in casa.group(1):
                pendentes.append(casa.group(1))
            continue
        casa = SUMARIO.match(crua)
        if casa:
            pacote = casa.group(2)
            pacotes_executados.append(pacote)
            if pendentes:
                falhas_por_pacote.setdefault(pacote, set()).update(pendentes)
                pendentes = []

    regressoes: list[str] = []
    curados: list[str] = []
    tolerados: list[str] = []
    for pacote in pacotes_executados:
        baseline = set(conhecidos.get(pacote, {}).get("testes", []))
        agora = falhas_por_pacote.get(pacote, set())
        for teste in sorted(agora - baseline):
            regressoes.append(f"{pacote}\t{teste}")
        for teste in sorted(baseline - agora):
            curados.append(f"{pacote}\t{teste}")
        for teste in sorted(agora & baseline):
            tolerados.append(f"{pacote}\t{teste}")

    if regressoes:
        print(f"REPROVADO: {len(regressoes)} teste(s) falharam e NAO estao no baseline de vermelhos conhecidos:",
              file=sys.stderr)
        for item in regressoes:
            print(f"    {item}", file=sys.stderr)
        print("\n  Isto e regressao deste commit. Corrija o teste — nao o baseline.", file=sys.stderr)
        return 1

    if curados:
        print(f"REPROVADO: {len(curados)} teste(s) do baseline PASSARAM: a divida foi paga e a lista ficou inflada:",
              file=sys.stderr)
        for item in curados:
            print(f"    {item}", file=sys.stderr)
        print("\n  Remedio, uma linha:", file=sys.stderr)
        print("      ./tools/generate-baseline-testes-vermelhos " +
              " ".join("./" + p.split("portaljuridico/", 1)[-1] + "/" for p in sorted(set(pacotes_executados))),
              file=sys.stderr)
        return 1

    if tolerados:
        print(f"{len(tolerados)} vermelho(s) conhecido(s) tolerado(s) — divida nomeada, nao regressao:")
        for item in tolerados:
            print(f"    {item}")
    else:
        print("nenhum vermelho: nem novo, nem conhecido")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
