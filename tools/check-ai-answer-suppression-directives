#!/usr/bin/env python3
"""check-ai-answer-suppression-directives — READ-ONLY.

Reprova quando o portal emite `noarchive` ou `nocache` — as duas diretivas que
tiram o conteúdo das RESPOSTAS de IA do Bing/Copilot sem tocar no ranking
orgânico, e que por isso passam despercebidas em toda auditoria de SEO.

FONTE OFICIAL PRIMÁRIA (Bing Webmaster Blog, 2023-09-22,
https://blogs.bing.com/webmaster/september-2023/Announcing-new-options-for-webmasters-to-control-u,
lido em 2026-08-26):

  NOARCHIVE — "Content tagged NOARCHIVE will not be included in Bing Chat
              answers, not be linked to in the answers."
  NOCACHE   — "Content with the NOCACHE tag may be included in Bing Chat
              answers. We will only display URL/Snippet/Title in the answer."
  E O QUE AS TORNA INVISÍVEIS PARA UM GATE DE SEO — "content with the NOCACHE
  tag or NOARCHIVE tag will still appear in our search results."

  Referência complementar, mesma fonte:
  https://www.bing.com/webmasters/help/robots-meta-tags-and-attributes-that-bing-supports-5198d240

É esse "still appear in our search results" que faz este gate existir. Uma
regressão aqui não derruba impressão, não derruba clique e não derruba posição:
ela apaga o portal da resposta do Copilot, em silêncio, por tempo indeterminado.
Nenhum outro gate deste repositório olha para essas duas palavras — medido em
2026-08-26: zero ocorrências em internal/, cmd/, content/ e ops/.

RESULTADO NEGATIVO REGISTRADO NA CRIAÇÃO (medição própria, 2026-08-26):

    grep -rl 'noarchive' public/     -> 0
    grep -rl 'nocache'   public/     -> 0
    grep -rl 'nosnippet' public/     -> 0
    grep -rl 'noimageindex' public/  -> 0
    find public -name '*.html' | wc  -> 10298
    X-Robots-Tag ao vivo em /, /familia/, /familia/pagina/2/,
      /previdenciario/135-ou-agencia/, /buscar/, /llms.txt, /robots.txt
      (nginx 127.0.0.1:8088, UA próprio) -> ausente em todas

O acervo está limpo. Este gate não corrige nada hoje: ele impede que a limpeza
se perca sem ninguém notar — que é a única forma pela qual esse defeito aparece.

O QUE ELE OLHA, e por que são três superfícies e não uma:

  1. public/**/*.html — a diretiva materializada, que é o que o bot lê.
  2. Go de PRODUÇÃO — o emissor de X-Robots-Tag; um literal aqui alcança rota
     que não tem arquivo em disco (as 28 rotas /{área}/pagina/ e todo o
     fallback), e não seria visto pela varredura de public/.

     `*_test.go` FICA DE FORA, e a exclusão não é preguiça: é a correção de um
     falso positivo MEDIDO na primeira execução deste gate, em 2026-08-26.
     `internal/sourcefetch/sourcefetch_test.go:294` faz
     `header.Set("X-Robots-Tag", "noarchive")` dentro de um `roundTripFunc` que
     SIMULA a resposta de um site oficial EXTERNO, do qual o portal só lê
     metadado por HEAD. É o servidor de fora dizendo "noarchive", não o portal
     — o oposto exato do que este gate persegue. Reprovar ali ensinaria a
     apagar a simulação de um cenário real, que é a classe de "correção" que
     este repositório trata como fraude.
  3. nginx (ops/nginx/*.conf) — a camada que serve 99% das URLs do disco e que
     pode acrescentar header sem passar por Go nenhum. Lido, nunca escrito.

`nosnippet` e `noimageindex` entram como AVISO, não como reprovação: eles
degradam a aparência na busca, mas não são a lâmina silenciosa que este gate
persegue, e o portal pode ter razão legítima para usá-los numa rota específica.

COMO PROVAR QUE ELE REPROVA (o gate que não pode reprovar é pior que gate
nenhum — regra do próprio repositório):

    mkdir -p /tmp/fx/public/x
    printf '<meta name="robots" content="index,follow,noarchive">' \\
      > /tmp/fx/public/x/index.html
    tools/check-ai-answer-suppression-directives --root /tmp/fx; echo $?

Saída esperada: a linha do achado e exit 1.
"""

from __future__ import annotations

import argparse
import os
import re
import sys

# As duas que REPROVAM. Ambas cortam a resposta de IA sem sinal no orgânico.
DIRETIVAS_BLOQUEANTES = ("noarchive", "nocache")
# As duas que só AVISAM: degradam aparência, não apagam da resposta.
DIRETIVAS_DE_AVISO = ("nosnippet", "noimageindex")

# Só o <head> importa para meta robots, e ler 16 KB por arquivo em vez do
# arquivo inteiro é o que mantém a varredura de 10.298 páginas em segundos.
# A maior página do acervo tem 36.937 bytes e o <head> dela cabe muito antes
# disso; ainda assim, o corpo é varrido pelo caminho de X-Robots-Tag literal
# abaixo, então nada escapa por estar depois do corte.
BYTES_DE_CABECA = 16384

META_ROBOTS = re.compile(
    rb"""<meta\s+[^>]*name\s*=\s*["']?(robots|googlebot|bingbot|msnbot|google|openai|"""
    rb"""oai-searchbot|chatgpt-user|perplexitybot|claudebot|anthropic-ai)["']?[^>]*>""",
    re.IGNORECASE,
)
X_ROBOTS_TAG = re.compile(rb"""x-robots-tag""", re.IGNORECASE)


def linha_de(conteudo: bytes, deslocamento: int) -> int:
    return conteudo.count(b"\n", 0, deslocamento) + 1


def varre_html(raiz_public: str, achados: list[str], avisos: list[str]) -> int:
    total = 0
    for pasta, _, arquivos in os.walk(raiz_public):
        for nome in arquivos:
            if not nome.endswith(".html"):
                continue
            caminho = os.path.join(pasta, nome)
            total += 1
            try:
                with open(caminho, "rb") as fh:
                    cabeca = fh.read(BYTES_DE_CABECA)
            except OSError as erro:
                achados.append(f"{caminho}: ilegivel ({erro})")
                continue
            for casamento in META_ROBOTS.finditer(cabeca):
                tag = casamento.group(0).lower()
                for diretiva in DIRETIVAS_BLOQUEANTES:
                    if diretiva.encode() in tag:
                        achados.append(
                            f"{caminho}:{linha_de(cabeca, casamento.start())}: "
                            f"meta robots com '{diretiva}' -> corta este conteudo das "
                            f"respostas do Bing/Copilot sem afetar o ranking organico"
                        )
                for diretiva in DIRETIVAS_DE_AVISO:
                    if diretiva.encode() in tag:
                        avisos.append(
                            f"{caminho}:{linha_de(cabeca, casamento.start())}: "
                            f"meta robots com '{diretiva}'"
                        )
    return total


def varre_fonte(raiz: str, subdirs: tuple[str, ...], sufixos: tuple[str, ...],
                achados: list[str], rotulo: str) -> int:
    total = 0
    for sub in subdirs:
        base = os.path.join(raiz, sub)
        if not os.path.isdir(base):
            continue
        for pasta, dirs, arquivos in os.walk(base):
            dirs[:] = [d for d in dirs if d not in (".git", "testdata", "node_modules")]
            for nome in arquivos:
                if not nome.endswith(sufixos):
                    continue
                # Ver o cabeçalho: teste simula servidor EXTERNO, não emite.
                if nome.endswith("_test.go"):
                    continue
                caminho = os.path.join(pasta, nome)
                total += 1
                try:
                    with open(caminho, "rb") as fh:
                        conteudo = fh.read()
                except OSError:
                    continue
                if not X_ROBOTS_TAG.search(conteudo):
                    continue
                # Só interessa a linha que EMITE o header junto de uma das
                # diretivas: citar "noarchive" numa prosa de comentário não é
                # regressão, e reprovar por isso ensinaria a ninguém escrever
                # sobre o assunto — inclusive este arquivo.
                for numero, linha in enumerate(conteudo.split(b"\n"), start=1):
                    baixa = linha.lower()
                    if not X_ROBOTS_TAG.search(baixa):
                        continue
                    if baixa.lstrip().startswith((b"//", b"#", b"*")):
                        continue
                    for diretiva in DIRETIVAS_BLOQUEANTES:
                        if diretiva.encode() in baixa:
                            achados.append(
                                f"{caminho}:{numero}: {rotulo} emite X-Robots-Tag com "
                                f"'{diretiva}' -> corta a rota das respostas de IA do Bing"
                            )
    return total


def main() -> int:
    parser = argparse.ArgumentParser(
        description="reprova noarchive/nocache no acervo publicado, no Go de producao e no nginx"
    )
    parser.add_argument("--root", default=None,
                        help="raiz do repositorio (padrao: a raiz deduzida deste script); "
                             "aponte para uma arvore de fixture para provar que o gate reprova")
    args = parser.parse_args()

    raiz = args.root or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    raiz = os.path.abspath(raiz)

    achados: list[str] = []
    avisos: list[str] = []

    raiz_public = os.path.join(raiz, "public")
    htmls = varre_html(raiz_public, achados, avisos) if os.path.isdir(raiz_public) else 0
    gos = varre_fonte(raiz, ("internal", "cmd"), (".go",), achados, "Go")
    confs = varre_fonte(raiz, ("ops",), (".conf",), achados, "nginx")

    print(f"check-ai-answer-suppression-directives: "
          f"html={htmls} go={gos} conf={confs} "
          f"bloqueantes={'|'.join(DIRETIVAS_BLOQUEANTES)}")
    for aviso in avisos:
        print(f"AVISO: {aviso}")
    if not achados:
        print("OK: nenhuma diretiva de supressao de resposta de IA no portal.")
        return 0
    for achado in achados:
        print(f"FALHA: {achado}", file=sys.stderr)
    print(f"check-ai-answer-suppression-directives: {len(achados)} achado(s) bloqueante(s)",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
