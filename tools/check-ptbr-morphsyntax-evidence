#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
BOOTSTRAP_CMD="./tools/generate-ptbr-morphsyntax-evidence --release-lote 1"
REQ_FILE="$ROOT/tools/requirements-ptbr-morphsyntax-oracle.txt"
REQ_HASH="$(sha256sum "$REQ_FILE" | awk '{print $1}')"
STANZA_RESOURCES_VERSION="${WIKI_STANZA_RESOURCES_VERSION:-1.13.0}"

# venv_ready checks both existence AND completeness (the pinned-requirements
# marker written by tools/generate-ptbr-morphsyntax-evidence), so a half
# -built venv is treated the same as an absent one instead of silently
# handing python3-with-missing-deps to the oracle script.
venv_ready() {
	local dir="$1"
	[[ -x "$dir/bin/python" && -f "$dir/.requirements-ptbr-morphsyntax-$REQ_HASH.ok" ]]
}
stanza_ready() {
	local dir="$1"
	[[ -f "$dir/.pt-morphsyntax-tokenize-mwt-pos-lemma-depparse-resources-$STANZA_RESOURCES_VERSION-$REQ_HASH.ok" ]]
}

# Persistent repo-local default (.cache/, survives reboot/GC) is checked
# first; the legacy /tmp default is kept as a fallback so venvs already
# bootstrapped there by earlier prewarm runs keep working without the env
# vars re-exported in this shell. Explicit WIKI_PTBR_MORPHSYNTAX_PYTHON /
# WIKI_PTBR_MORPHSYNTAX_VENV / WIKI_STANZA_RESOURCES_DIR always win.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/ptbr-morphsyntax-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-ptbr-morphsyntax-venv"
STANZA_PERSISTENT_DEFAULT="$ROOT/.cache/ptbr-morphsyntax-stanza-resources"
STANZA_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-stanza-resources"

if [[ -n "${WIKI_PTBR_MORPHSYNTAX_PYTHON:-}" ]]; then
	: # explicit interpreter override — trust it as-is, unchanged behavior
elif [[ -n "${WIKI_PTBR_MORPHSYNTAX_VENV:-}" ]] && venv_ready "$WIKI_PTBR_MORPHSYNTAX_VENV"; then
	export WIKI_PTBR_MORPHSYNTAX_PYTHON="$WIKI_PTBR_MORPHSYNTAX_VENV/bin/python"
elif venv_ready "$VENV_LEGACY_DEFAULT"; then
	export WIKI_PTBR_MORPHSYNTAX_PYTHON="$VENV_LEGACY_DEFAULT/bin/python"
elif venv_ready "$VENV_PERSISTENT_DEFAULT"; then
	export WIKI_PTBR_MORPHSYNTAX_PYTHON="$VENV_PERSISTENT_DEFAULT/bin/python"
else
	cat >&2 <<EOF
check-ptbr-morphsyntax-evidence: venv pinado (spacy/stanza/torch) ausente ou incompleto (requirements hash $REQ_HASH)
  checado: $VENV_PERSISTENT_DEFAULT
  checado: $VENV_LEGACY_DEFAULT
  bootstrap: $BOOTSTRAP_CMD
  (ou exporte WIKI_PTBR_MORPHSYNTAX_PYTHON apontando para um interpretador pronto)
Este check NUNCA cai para o python3 do sistema — ele não tem os pacotes/modelos pinados.
EOF
	exit 1
fi

if [[ -n "${WIKI_STANZA_RESOURCES_DIR:-}" ]]; then
	: # explicit override — unchanged behavior
elif stanza_ready "$STANZA_LEGACY_DEFAULT"; then
	export WIKI_STANZA_RESOURCES_DIR="$STANZA_LEGACY_DEFAULT"
elif stanza_ready "$STANZA_PERSISTENT_DEFAULT"; then
	export WIKI_STANZA_RESOURCES_DIR="$STANZA_PERSISTENT_DEFAULT"
else
	# Neither default has a complete Stanza resource marker; keep the legacy
	# default so the oracle script's own OracleError (stanza model files
	# missing) fires with its usual message instead of a wrapper hard-fail
	# (Stanza dir readiness is orthogonal to venv readiness, checked above).
	export WIKI_STANZA_RESOURCES_DIR="$STANZA_LEGACY_DEFAULT"
fi
export PYTHONDONTWRITEBYTECODE=1

# Read-only: run-check dispatches scripts/ptbr_morphsyntax_oracle.py --mode check
# against data/ops/ptbr_morphsyntax_evidence.jsonl and fails when real models
# or Python dependencies are absent.
exec "$ROOT/tools/run-check" ptbr-morphsyntax-evidence --timings "$@"
