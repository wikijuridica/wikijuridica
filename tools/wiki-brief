#!/usr/bin/env bash
# wiki-brief — briefing de ENTRADA do /opt/wiki para agente de IA (read-only).
#
# PARA QUE SERVE
#   Ao entrar no repo, o agente precisa saber: onde esta o git, quais frentes existem,
#   o que roda agora, se ha lock travando, e qual o estoque v2. Fazer isso "na mao"
#   custa 299.497 B de contexto, remedidos em 2026-07-28 07:52 (git status=86.788 |
#   ls -la v2_pages=109.971 | ps aux=66.169 | frontboard=35.710 | git log -5=611 |
#   p0-next=248) — repetido por TODO agente em TODA sessao.
#   Este script entrega a MESMA decisao em 1.476 B: 203x menos, -99,5% dos bytes,
#   ~74,5 mil tokens poupados por agente por entrada (a 4 B/token).
#
# CUSTO MEDIDO (2026-07-28, 8 cores sob load 4,0, repo com 1.139 sujos e 680 shards v2):
#   ./tools/wiki-brief             REAL=0,45-0,81 s  saida=1.378-1.402 B
#   ./tools/wiki-brief --no-next   REAL=0,36 s       saida=1.191 B
#   A saida varia poucas dezenas de bytes com o texto das tasks do frontboard; os
#   truncamentos (front 66-72 ch, NEXT head -4 + cut 118 ch, top-5 areas) existem
#   para que NENHUM estado do repo consiga estourar o teto de 2 KB.
#   (a faixa de tempo e a variacao pela load da maquina: 0,45 s sob load 4,0;
#    0,73-0,81 s sob load 4,9 de 8 cores. Teto de projeto: 2 s / 2 KB.)
#   Sondas: git status --porcelain 0,205 s (74.925 B lidos, 0 impressos) |
#   frontboard 0,003 s | v2_pages cat+awk 0,065 s | p0-next sob timeout 3 s.
#   READ-ONLY provado: 0 arquivo com mtime alterado em data/ content/ .agents/ tools/
#   e 0 arquivo criado em /tmp (diff de mtimes antes/depois).
#   Sobre .git/index, o que foi MEDIDO e so isto: mtime sem alteracao nas execucoes
#   deste brief. NAO e prova de causa — com ~30 processos git concorrentes no repo
#   nao da para isolar atribuicao, e o teste em repo descartavel foi inconclusivo
#   (git so reescreve o index quando o refresh e material). O flag continua correto
#   por ser o mecanismo DOCUMENTADO do git para nao refrescar/reescrever o index,
#   e o custo de adota-lo e zero.
#
# POR QUE ALGUMAS ESCOLHAS SAO CONTRA-INTUITIVAS (revisao adversarial 2026-07-28 07:5x)
#   - `git --no-optional-locks`: o brief e rodado por TODO agente; sem o flag ele
#     refresca/reescreve o index e disputa .git/index.lock com quem commita.
#   - area com profundidade 3 sob data/: `a[1]/a[2]` cru dava "data/editorial=1110",
#     numero que nao muda decisao, e imprimia ARQUIVO como area em caminho de 2
#     componentes. Ver comentario no bloco awk.
#   - `go=N commit=LEVE|PESADO`: pre-commit so builda com Go/go.mod/go.sum staged
#     (DEC-002). E o unico numero que diz se o proximo commit custa 1 s ou 5 min.
#   - a recomendacao final do p0-next NAO e repassada (esta errada hoje) — o brief
#     acusa a divergencia em vez de propagar. Ver comentario no bloco p0-next.
#
# CONTRATO
#   - READ-ONLY: nao escreve nada (nem em /tmp; nao precisa de cache — tudo < 0,5 s).
#   - Sem ANSI, sem banner, sem enfeite: cada linha muda uma decisao.
#   - Nunca imprime LISTA de arquivos do git (era exatamente a fonte dos 86 KB):
#     so contagem por status e por area de diretorio.
#   - Falha de qualquer sonda degrada para "?" e NUNCA derruba a saida.
#
# USO: ./tools/wiki-brief          (opcional: --no-next pula a sonda p0-next, -0,45 s)

set -uo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1
WANT_NEXT=1
[ "${1:-}" = "--no-next" ] && WANT_NEXT=0

# ---------- HEAD ----------
BR="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
HD="$(git log -1 --format='%h %s' 2>/dev/null | cut -c1-62 || echo '?')"
printf '# wiki-brief %s | %s | branch=%s\n' "$(date +%H:%M)" "$ROOT" "$BR"
printf 'HEAD  %s\n' "$HD"

# ---------- GIT agregado (nunca a lista) ----------
# --no-optional-locks: `git status` normal REFRESCA o index e o reescreve (tomando
# .git/index.lock). Um brief que TODO agente roda ao entrar viraria fonte de
# contencao com quem esta commitando. Com o flag, git responde sem lock opcional
# — e a promessa READ-ONLY do cabecalho passa a valer tambem para .git/.
git --no-optional-locks status --porcelain 2>/dev/null | awk '
{
  x=substr($0,1,1); y=substr($0,2,1); p=substr($0,4)
  if (p ~ / -> /) sub(/^.* -> /,"",p)
  if (x=="?") { unt++ } else {
    if (x!=" ") st[x]++
    if (y!=" ") wt[y]++
  }
  # Area = DIRETORIO, nunca arquivo. `a[1]"/"a[2]` cru tinha 2 defeitos medidos:
  # (1) para caminho de 2 componentes imprimia o ARQUIVO como area
  #     (tools/wiki-brief=1, tools/go-modern=1) e esses unitarios empurravam area
  #     real para fora do top-5; (2) colapsava TODO o estoque em data/editorial=1110,
  #     numero que nao muda decisao nenhuma. Com profundidade 3 sob data/ o mesmo
  #     git vira: v2_claims=659 v2_pages_quarantine=182 v2_pages=178 portfolio_v2=60
  #     — ai sim da para ver QUAL frente do estoque esta suja.
  gsub(/^"|"$/,"",p)
  n=split(p,a,"/"); d=n-1
  if (d<1) area="(raiz)"
  else {
    lim=(a[1]=="data")?3:2; if (d<lim) lim=d
    area=a[1]; for (q=2;q<=lim;q++) area=area"/"a[q]
  }
  ar[area]++
  # Go sujo decide o CUSTO do proximo commit: o pre-commit (regime leve DEC-002) so
  # builda quando o commit toca Go/go.mod/go.sum — ai custa ~5 min e tem de ser
  # serializado (1 pesado por vez). Zero Go sujo = commit LEVE, pode ser frequente e
  # concorrente. Sem este numero o agente entrante nao sabe em qual regime esta.
  if (p ~ /\.go$/ || p=="go.mod" || p=="go.sum") go++
  tot++
}
END{
  s=""; for (k in st) s=s sprintf("%s=%d ",k,st[k])
  w=""; for (k in wt) w=w sprintf("%s=%d ",k,wt[k])
  printf "GIT   %d sujos | staged: %s| worktree: %s| untracked=%d | go=%d commit=%s\n", tot, (s?s:"- "), (w?w:"- "), unt+0, go+0, (go+0 ? "PESADO ~5min build, serializar" : "LEVE")
  # top 5 areas
  n=0; line=""
  for (k in ar) { arr[++n]=ar[k]"\t"k }
  for (i=1;i<=n;i++) for (j=i+1;j<=n;j++) { split(arr[i],A,"\t"); split(arr[j],B,"\t"); if (B[1]+0>A[1]+0) { t=arr[i]; arr[i]=arr[j]; arr[j]=t } }
  m=(n<5?n:5); rest=0
  for (i=1;i<=m;i++) { split(arr[i],A,"\t"); line=line A[2]"="A[1]" " }
  for (i=m+1;i<=n;i++) { split(arr[i],A,"\t"); rest+=A[1] }
  printf "GIT   areas: %s%s\n", line, (rest? "+"rest" em outras" : "")
}' 2>/dev/null || echo "GIT   ?"

# ---------- FRONTBOARD ----------
# LER PELO MODULO CANONICO. Ate 2026-08-26 este bloco ordenava direto por
# `priority`, campo que o board grava ora como int (0-3) ora como texto
# ('alta'/'critica'/...). Medido no board de 144 linhas: int em 24 tarefas livres
# e str em 11. O sort estourava `TypeError: '<' not supported between instances
# of 'str' and 'int'`, o `2>/dev/null` engolia o traceback, e o brief imprimia
# um "BOARD ?" mudo — as linhas ATIVA e LIVRE, que sao a razao deste bloco
# existir, nunca apareciam. A ordenacao (livres antes de near_done) esta
# preservada dentro de frontboard.livres(), com o mesmo motivo.
python3 - <<'PY' 2>/dev/null || echo "BOARD ?"
import sys
sys.path.insert(0,'tools')
import frontboard
rows=frontboard.carrega()
st=frontboard.contagem(rows)
print('BOARD %d tasks | %s' % (len(rows), ' '.join('%s=%d'%(k,v) for k,v in st.items())))
erros=rows[0].get('_erros_de_parse',0) if rows else 0
if erros: print('BOARD ALERTA %d linha(s) nao parsearam' % erros)
desc=frontboard.por_status(rows,'desconhecida')
if desc: print('BOARD ALERTA %d status fora do mapa (ex: %r) -> tools/frontboard.py' % (len(desc), desc[0].get('status')))
for r in frontboard.por_status(rows,'em_voo')[:2]:
    print('BOARD ATIVA p%s %s: %s' % (r['_prioridade'], r.get('id','?'), (r.get('front','') or '').replace('\n',' ')[:72]))
free=frontboard.livres(rows)
if not free:
    print('BOARD sem task livre -> CRIE task ou assuma uma em_voo sem dono')
for r in free[:3]:
    print('BOARD LIVRE p%s %s [%s]: %s' % (r['_prioridade'], r.get('id','?'), r['_status'], (r.get('front','') or '').replace('\n',' ')[:66]))
PY

# ---------- p0-next (estado vivo) ----------
# So a linha ESTADO VIVO e aproveitada, por economia de contexto — a lista de
# tarefas ja vem das linhas BOARD acima.
#
# HISTORICO (corrigido em 2026-08-26): a recomendacao final do p0-next era
# MENTIRA e este comentario pedia, por escrito, que alguem a consertasse. Ele
# filtrava status available/running/blocked, vocabulario que o frontboard nao
# usava mais, e imprimia "Nada AVAILABLE" com 58 tarefas livres — exatamente
# abaixo das linhas BOARD LIVRE que provavam o contrario. Repassar isso faria o
# agente entrante PARAR. Hoje os dois leem tools/frontboard.py e concordam por
# construcao; o ALERTA abaixo virou GUARDA DE REGRESSAO — se algum dia voltarem
# a divergir, ele acusa em vez de deixar passar em silencio.
#
# GIT_OPTIONAL_LOCKS=0 porque p0-next roda `git commit --dry-run` internamente —
# sem o env, um brief de rotina mexe no index de um repo com commits concorrentes.
if [ "$WANT_NEXT" = 1 ] && [ -x ./tools/p0-next ]; then
	pn="$(GIT_OPTIONAL_LOCKS=0 timeout 3 ./tools/p0-next 2>/dev/null)"
	printf '%s\n' "$pn" | grep -E '^== ESTADO' | sed -e 's/^== //' -e 's/  */ /g' |
		cut -c1-118 | sed 's/^/NEXT  /'
	# `": *"` (e nao ": ") para o ALERTA nao sumir em silencio se o frontboard um dia
	# for regravado em JSON compacto, sem espaco depois dos dois-pontos.
	freeq=$(grep -c '"status": *"\(queued\|available\|open\)"' .agents/runtime/p0_frontboard.jsonl 2>/dev/null)
	case "$pn" in
	*"Nada AVAILABLE"* | *"Nada LIVRE"*)
		[ "${freeq:-0}" -gt 0 ] && printf 'NEXT  ALERTA p0-next cego (diz que nada esta livre com %s tarefas livres no board): divergencia de leitura voltou, conserte tools/frontboard.py\n' "$freeq"
		;;
	esac
fi

# ---------- LOCKS ----------
NOW=$(date +%s)
lockline=""
chk() { # nome caminho — ATIVO so se RECENTE: .bus.lock e um marcador 0-byte que fica
	# no disco por semanas; reporta-lo como "ATIVO" seria alarme falso permanente.
	if [ -e "$2" ]; then
		m=$(stat -c %Y "$2" 2>/dev/null || echo "$NOW")
		a=$((NOW - m))
		if [ "$a" -lt 600 ]; then
			lockline="$lockline$1=ATIVO/${a}s "
		else lockline="$lockline$1=frio/$((a / 3600))h "; fi
	else
		lockline="$lockline$1=livre "
	fi
}
chk heavy /tmp/opt-wiki-agent-heavy.lock
chk bus .agents/runtime/coordination/.bus.lock
chk gitix .git/index.lock
printf 'RUN   locks: %s\n' "$lockline"
if [ -e .git/index.lock ]; then
	m=$(stat -c %Y .git/index.lock 2>/dev/null || echo "$NOW")
	if [ $((NOW - m)) -gt 60 ] && ! pgrep -x git >/dev/null 2>&1; then
		echo 'RUN   ALERTA index.lock ORFAO (>60s, zero git vivo) -> ./tools/clear-orphan-git-lock'
	fi
fi

# ---------- PROCESSOS / CARGA ----------
# pgrep -c imprime "0" E sai 1 quando nao acha: `|| echo 0` duplicaria a saida ("0\n0").
# Por isso o fallback e via ${x:-0} sobre a captura, nunca via `||`.
c() {
	local n
	n="$(pgrep -fc "$1" 2>/dev/null)"
	echo "${n:-0}"
}
GO=$(c '[g]o-modern|[g]o build|[c]ompile -o')
PY=$(c '[p]ython3')
CL=$(c '[c]laude')
NO=$(c '[n]ode')
TM=$(tmux ls 2>/dev/null | wc -l)
read -r LOAD _ </proc/loadavg 2>/dev/null
NP=$(nproc 2>/dev/null)
read -r MEM SW < <(free -m 2>/dev/null | awk '/^Mem:/{m=int(100*($2-$7)/$2)} /^Swap:/{s=$3} END{print m"%", s"M"}')
printf 'RUN   proc: go=%s python3=%s node=%s claude=%s tmux=%s | load=%s/%s mem=%s swap=%s\n' \
	"$GO" "$PY" "$NO" "$CL" "$TM" "${LOAD:-?}" "${NP:-?}" "${MEM:-?}" "${SW:-?}"

# ---------- ESTOQUE V2 ----------
{
	# *.partial.jsonl e shard de onda EM VOO (ruido efemero classificado no .gitignore).
	# Contar junto inflaria o estoque justo quando uma onda roda — que e quando o numero
	# mais importa. Fica de FORA do total e vira sinal proprio ("nao mexa em v2 agora").
	# Glob em vez de `ls | grep`: o shell ja separa por arquivo, e nome com
	# espaco nao vira duas entradas.
	V2F=()
	PART=0
	for arquivo in data/editorial/v2_pages/*.jsonl; do
		[ -f "$arquivo" ] || continue
		case "$arquivo" in
		*.partial.jsonl) PART=$((PART + 1)) ;;
		*) V2F+=("$arquivo") ;;
		esac
	done
	SH=${#V2F[@]}
	if [ "$SH" -gt 0 ]; then
		read -r REG TOMB < <(cat "${V2F[@]}" 2>/dev/null |
			awk '{n++} /"skipped"/{t++} END{print n+0, t+0}')
		printf 'V2    shards=%s registros=%s ativos=%s tombstone=%s%s (metodo: linha JSONL bruta; tombstone="skipped")\n' \
			"$SH" "$REG" "$((REG - TOMB))" "$TOMB" \
			"$([ "$PART" -gt 0 ] && printf ' | +%s partial EM VOO (onda rodando: nao mexa em v2_pages)' "$PART")"
	else
		echo 'V2    shards=0'
	fi
} 2>/dev/null || echo 'V2    ?'
