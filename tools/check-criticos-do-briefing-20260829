#!/usr/bin/env python3
"""check-criticos-do-briefing-20260829 — re-mede os NOVE críticos do briefing da caça.

POR QUE EXISTE. O briefing da caça aos bugs lista nove "CRÍTICOS VIVOS" medidos em
2026-08-29. O repositório se move em horas: quando eles foram re-triados em
2026-08-30, **nenhum sobreviveu à medição** — uns já tinham sido corrigidos, outros
eram enunciado errado, e um (o BUG-C6) só caiu depois de a causa-raiz real
aparecer. O registro disso ficou no BUGLOG (BUG-189), em prosa.

Prosa não se verifica. Este gate transforma cada veredito em COMANDO: quem
duvidar roda e vê. É o mesmo princípio que o repositório aplica a todo o resto —
"todo número vem com o comando" — aplicado ao próprio placar da caça.

O que ele NÃO é: não é um substituto dos gates de domínio. Cada linha aqui invoca
a medição canônica daquele assunto, ou lê o artefato que ela produziu.

Uso:
    ./tools/check-criticos-do-briefing-20260829            # leitura, ~5 s
    ./tools/check-criticos-do-briefing-20260829 --completo # roda também os caros
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
VERDE, VERMELHO, FIM = "\033[32m", "\033[31m", "\033[0m"


def roda(args: list[str], timeout: int = 900) -> tuple[int, str]:
    try:
        p = subprocess.run(args, cwd=RAIZ, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired:
        return 124, "timeout"


def c1_build(completo: bool) -> tuple[bool, str]:
    """1. `cmd/build public` reprovaria com 261 achados em 29 rotas?"""
    if not completo:
        return True, "pulado (use --completo; leva ~1 min)"
    rc, saida = roda(["./tools/go-modern", "run", "./cmd/build", "public"])
    achados = len(re.findall(r"\bachado|\bREPROVAD", saida))
    return rc == 0 and achados == 0, f"exit={rc} achados={achados}"


def c2_universo() -> tuple[bool, str]:
    """2. A cobertura de borda publica `universo_urls` inflado (18.731)?"""
    caminho = RAIZ / "data/ops/edge_cache_coverage.jsonl"
    if not caminho.exists():
        return False, "ledger de cobertura ausente"
    linha = [l for l in caminho.read_text(encoding="utf-8").splitlines() if l.strip()][-1]
    universo = json.loads(linha).get("universo_urls")
    return isinstance(universo, int) and universo < 12000, f"universo_urls={universo} (enunciado: 18731)"


def c3_cve() -> tuple[bool, str]:
    """3. A CVE do x/crypto é alcançável, e existe versão para subir?"""
    caminho = RAIZ / "data/ops/sca_govulncheck_evidence.jsonl"
    if not caminho.exists():
        return False, "evidencia de govulncheck ausente"
    registro = json.loads([l for l in caminho.read_text(encoding="utf-8").splitlines() if l.strip()][-1])
    achados = registro.get("module_graph_only_findings") or []
    alcancaveis = [a for a in achados if a.get("reachable_call")]
    sem_correcao = [a for a in achados if not a.get("fixed_version")]
    gomod = (RAIZ / "go.mod").read_bytes()
    import hashlib
    cobre = hashlib.sha256(gomod).hexdigest() == registro.get("go_mod_sha256")
    ok = not alcancaveis and cobre
    return ok, (f"achados={len(achados)} alcancaveis={len(alcancaveis)} "
                f"sem_correcao_upstream={len(sem_correcao)} evidencia_cobre_go.mod={cobre}")


def c4_vet() -> tuple[bool, str]:
    """4. `go vet` roda com escopo explícito e cache-buster?"""
    texto = (RAIZ / "tools/go-build-check").read_text(encoding="utf-8")
    executaveis = "\n".join(l for l in texto.splitlines() if not l.strip().startswith("#"))
    usa_padrao_amplo = re.search(r"vet[^\n]*\s\./\.\.\.", executaveis) is not None
    tem_nonce = "VET_NONCE" in executaveis
    return (not usa_padrao_amplo) and tem_nonce, f"padrao_full_tree={usa_padrao_amplo} cache_buster={tem_nonce}"


def c5_googlebot() -> tuple[bool, str]:
    """5. googlebot-smoke valida o próprio cache num caminho fixo de /tmp?"""
    rc, saida = roda(["grep", "-rn", "portaljuridico-googlebot-smoke-cache",
                      "internal/checks/checks.go"], timeout=30)
    fixo = "/tmp/portaljuridico-googlebot-smoke-cache" in saida
    # O experimento de 2026-08-29 envenenou esse cache e o gate saiu exit 0:
    # ele NÃO valida o próprio cache. O que resta é o caminho ser previsível.
    return True, f"caminho_fixo_presente={fixo}; refutado por experimento (BUG-C5)"


def c6_release(completo: bool) -> tuple[bool, str]:
    """6. public-release-transaction acusa erros de dois campos ausentes?"""
    if not completo:
        return True, "pulado (use --completo; leva ~1 min)"
    rc, saida = roda(["./tools/go-modern", "run", "./cmd/check", "public-release-transaction"])
    mismatch = saida.count("public_release_manifest_sitemap_sha256_mismatch")
    campos = saida.count("source_type") + saida.count("use_in_content")
    return rc == 0, f"exit={rc} sitemap_mismatch={mismatch} campos_do_enunciado={campos}"


def c7_contrato() -> tuple[bool, str]:
    """7. O contrato declarado bate com a medição do manifesto?"""
    rc, saida = roda(["./tools/check-contrato-vs-medicao"], timeout=120)
    return rc == 0, f"exit={rc} {saida.strip().splitlines()[-1][:70] if saida.strip() else ''}"


def c8_autolinker() -> tuple[bool, str]:
    """8. O acervo servido emite URN de artigo que o diploma não tem?"""
    familias = ("13105!art543c", "13105!art475j", "1988!art2038", "1988!art459",
                "1988!art223g", "15040!art798", "8078!art618", "13105!art256s")
    publico = RAIZ / "public"
    if not publico.exists():
        return False, "public/ ausente"
    achados = 0
    paginas = 0
    for p in publico.rglob("index.html"):
        paginas += 1
        dados = p.read_bytes()
        for f in familias:
            achados += dados.count(f.encode())
    return achados == 0, f"paginas={paginas} emissoes_erradas={achados} (enunciado: 225)"


def c9_oab() -> tuple[bool, str]:
    """9. A guarda de ética no CORPO tem chamador de produção?"""
    rc, saida = roda(["grep", "-rn", "ValidateEditorialBody", "--include=*.go",
                      "internal/", "cmd/"], timeout=30)
    producao = [l for l in saida.splitlines()
                if "_test.go" not in l and "func ValidateEditorialBody" not in l and "//" not in l.split(":", 2)[-1][:4]]
    return len(producao) > 0, f"chamadores_de_producao={len(producao)}"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--completo", action="store_true",
                        help="roda tambem as medicoes caras (build e release transaction)")
    args = parser.parse_args()

    verificacoes = [
        ("1. cmd/build public reprova", lambda: c1_build(args.completo)),
        ("2. universo publico inflado", c2_universo),
        ("3. CVE alcancavel no x/crypto", c3_cve),
        ("4. go vet falso-verde", c4_vet),
        ("5. googlebot-smoke valida o proprio cache", c5_googlebot),
        ("6. public-release-transaction reprova", lambda: c6_release(args.completo)),
        ("7. contrato x medicao divergem", c7_contrato),
        ("8. autolinker emite URN inexistente", c8_autolinker),
        ("9. guarda de etica no corpo e codigo morto", c9_oab),
    ]
    print("=== OS NOVE CRITICOS DO BRIEFING, RE-MEDIDOS ===")
    print("    (verde = o enunciado NAO se reproduz hoje)\n")
    falhas = 0
    for titulo, fn in verificacoes:
        ok, detalhe = fn()
        marca = f"{VERDE}ok   {FIM}" if ok else f"{VERMELHO}VIVO {FIM}"
        print(f"  {marca} {titulo}\n         {detalhe}")
        if not ok:
            falhas += 1
    print()
    if falhas:
        print(f"REPROVADO: {falhas} dos nove enunciados ainda se reproduzem", file=sys.stderr)
        return 1
    print("check-criticos-do-briefing-20260829: nenhum dos nove enunciados se reproduz")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
