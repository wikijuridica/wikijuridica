#!/usr/bin/env python3
"""Corrige o nome da Resolucao do Senado que sai SEM ACENTO em 12 paginas no ar.

O DEFEITO, medido em 2026-09-10 por `./tools/measure-ortografia-publicada`
sobre os 11.287 HTML de public/ republicados hoje.

    Resolucao do Senado Federal nº 9, de 1992      12 paginas

Sai no bloco de Proveniencia, como texto do link e como `name` do CreativeWork
no JSON-LD — visivel ao leitor e legivel por maquina nas duas camadas. O §8 do
contrato exige portugues acentuado em tudo que o visitante le, e o nome correto
do ato e "Resolução do Senado Federal nº 9, de 1992".

NAO E TRANSCRICAO DE FONTE, e essa distincao decide se se corrige ou nao. O que
o Senado publica e "Resolução nº 9, de 1992"; a forma sem acento e ROTULO NOSSO,
escrito por um gerador que ASCII-izou o titulo. Corrigir o nosso rotulo nao toca
o texto do ato — que e a mesma regra pela qual o "reconher" do `temas.csv` do
STJ ficou literal na transcricao e so o titulo nosso mudou.

O `anchor_claim` do mesmo registro carrega a mesma frase e mais tres palavras
ASCII-izadas — `aliquota maxima`, `Doacao`, `paragrafo`. Ele NAO chega ao HTML
(conferido: zero ocorrencia de "aliquota maxima do ITCMD" em public/), entao
nao e defeito P0 de conteudo visivel; entra porque e a mesma frase, do mesmo
campo de proveniencia, escrita por nos, e deixa-la meio corrigida seria criar
divergencia entre o rotulo e a alegacao que o justifica.

ESCOPO POR CAMPO, e o gerador CONTA o que ficou de fora. So `official_sources` e
tocado. Se a mesma cadeia de caracteres existir em `sections`, `faq` ou
`title` — onde poderia ser citacao literal de terceiro —, ela e preservada e
contada no relatorio, nunca trocada em silencio.

Escrita atomica (temp no mesmo diretorio + fsync + rename) e idempotente: rodar
duas vezes nao muda nada na segunda.

Uso:
    tools/generate-v2-ortografia-senado-20260910 --dry-run
    tools/generate-v2-ortografia-senado-20260910
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
CAMPOS = ("official_sources",)
# (texto antigo, texto novo) — aplicados em ordem, so dentro de CAMPOS.
TROCAS = (
    ("Resolucao do Senado Federal", "Resolução do Senado Federal"),
    ("aliquota maxima do ITCMD", "alíquota máxima do ITCMD"),
    ("Causa Mortis e Doacao", "Causa Mortis e Doação"),
    ("nos termos do art. 155, paragrafo 1, IV", "nos termos do art. 155, parágrafo 1, IV"),
)
SHARDS = (
    "data/editorial/v2_pages/sucessoes-w3-01.jsonl",
    "data/editorial/v2_pages/sucessoes-w3-02.jsonl",
    "data/editorial/v2_pages/tributario-w3-02.jsonl",
)


def troca_em(valor, antigo: str, novo: str):
    """Aplica a troca recursivamente em str/list/dict, contando as ocorrencias."""
    if isinstance(valor, str):
        return valor.replace(antigo, novo), valor.count(antigo)
    if isinstance(valor, list):
        saida, total = [], 0
        for item in valor:
            trocado, n = troca_em(item, antigo, novo)
            saida.append(trocado)
            total += n
        return saida, total
    if isinstance(valor, dict):
        saida, total = {}, 0
        for chave, item in valor.items():
            trocado, n = troca_em(item, antigo, novo)
            saida[chave] = trocado
            total += n
        return saida, total
    return valor, 0


def conta_fora_do_escopo(registro: dict, antigo: str) -> int:
    fora = 0
    for chave, valor in registro.items():
        if chave in CAMPOS:
            continue
        _, n = troca_em(valor, antigo, antigo)
        fora += n
    return fora


def corrige(shard_rel: str, dry_run: bool) -> tuple[int, int, int]:
    shard = RAIZ / shard_rel
    if not shard.exists():
        print(f"shard ausente: {shard}", file=sys.stderr)
        return 2, 0, 0

    saida: list[str] = []
    trocadas = 0
    preservadas = 0
    paginas = 0
    for linha in shard.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        antes = trocadas
        for antigo, novo in TROCAS:
            preservadas += conta_fora_do_escopo(registro, antigo)
            for campo in CAMPOS:
                if campo not in registro:
                    continue
                trocado, n = troca_em(registro[campo], antigo, novo)
                registro[campo] = trocado
                trocadas += n
        if trocadas > antes:
            paginas += 1
        saida.append(json.dumps(registro, ensure_ascii=False))

    nome = shard.name
    if trocadas == 0:
        print(f"{nome}: nada a fazer (idempotente)")
        return 0, 0, preservadas

    print(f"{nome}: {trocadas} troca(s) em {paginas} pagina(s)")
    if not dry_run:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=shard.parent,
                                         prefix=".tmp-", delete=False) as temporario:
            temporario.write("\n".join(saida) + "\n")
            temporario.flush()
            os.fsync(temporario.fileno())
            caminho = temporario.name
        os.replace(caminho, shard)
        print(f"  gravado: {shard.relative_to(RAIZ)}")
    return 0, paginas, preservadas


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    pior, paginas, preservadas = 0, 0, 0
    for shard_rel in SHARDS:
        codigo, n, fora = corrige(shard_rel, argumentos.dry_run)
        pior = max(pior, codigo)
        paginas += n
        preservadas += fora
    print(f"\ntotal: {paginas} pagina(s) corrigida(s)")
    print(f"PRESERVADO fora do escopo {CAMPOS}: {preservadas} ocorrencia(s)")
    if argumentos.dry_run:
        print("--dry-run: nada gravado")
    return pior


if __name__ == "__main__":
    sys.exit(main())
