#!/bin/bash
# Teste FIEL ao relato do dono: TUI interativo em tmux, deixa a stack MCP subir,
# entao encerra do jeito que ele faz e conta orfaos de MCP.
set -u
# NAO HA MAIS `SCRATCH` AQUI. Ate 2026-09-11 esta linha era
# `SCRATCH=/tmp/claude-1000/-opt-wiki/5bad14ee-.../scratchpad`, o scratchpad de
# OUTRA sessao do Claude Code, e nenhuma das 90 linhas deste arquivo a lia.
# Caminho morto com dono errado e pior que caminho ausente: o proximo a editar
# escreveria num diretorio que some no reboot e pertence a outra sessao.
# A medicao deste script sai por stdout de proposito — quem quiser serie
# redireciona, e nao ha artefato intermediario a guardar.
SESS="mcpleak-$$"
MODE="${1:-CLOSE}"

pause() { command sleep "$1"; }

descendants() {
	ps -eo pid,ppid --no-headers | awk -v r="$1" '
    {p[$1]=$2} END{ n=1; q[1]=r; seen[r]=1
      for(i=1;i<=n;i++){ for(k in p){ if(p[k]==q[i] && !(k in seen)){ seen[k]=1; q[++n]=k } } }
      for(i=2;i<=n;i++) print q[i] }'
}

DOCK0=$(docker ps -q --filter ancestor=hashicorp/terraform-mcp-server:0.4.0 | wc -l)

tmux new-session -d -s "$SESS" -x 200 -y 50 "cd /opt/wiki && claude --permission-mode bypassPermissions"
pause 4
PANEPID=$(tmux list-panes -t "$SESS" -F '#{pane_pid}' 2>/dev/null | head -1)
echo "[launch] tmux=$SESS pane_pid=$PANEPID modo=$MODE docker_baseline=$DOCK0"
[ -z "$PANEPID" ] && {
	echo "FALHA: pane nao subiu"
	exit 1
}

# Estabilizacao: a contagem parar de crescer POR VARIAS LEITURAS e o sinal de que a stack
# subiu inteira. O piso e 2 (o proprio claude + ao menos um filho) e nao 8: um limiar alto
# calibrado para stack cheia faz a medicao esperar o timeout inteiro depois de um corte,
# justamente quando ha menos processos para contar.
PREV=-1
STABLE=0
for i in $(seq 1 90); do
	pause 1
	N=$(descendants "$PANEPID" | wc -l)
	if [ "$N" -eq "$PREV" ] && [ "$N" -ge 2 ]; then STABLE=$((STABLE + 1)); else STABLE=0; fi
	PREV=$N
	[ "$STABLE" -ge 6 ] && break
done

mapfile -t TREE < <(descendants "$PANEPID")
RSS=0
for p in "${TREE[@]}"; do
	r=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)
	RSS=$((RSS + ${r:-0}))
done
DOCK1=$(docker ps -q --filter ancestor=hashicorp/terraform-mcp-server:0.4.0 | wc -l)
echo "[estabilizou] ${i}s  arvore=${#TREE[@]} processos  RSS=$((RSS / 1024)) MB  docker=$DOCK1 (+$((DOCK1 - DOCK0)))"
for p in "${TREE[@]}"; do
	c=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | cut -c1-62)
	r=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)
	case "$c" in *mcp* | *desktop-commander* | *playwright* | *browser-use* | *convex* | *aikido* | *docker\ run* | *lumen*)
		printf "    %7s %6sMB  %s\n" "$p" "$((${r:-0} / 1024))" "$c"
		;;
	esac
done

case "$MODE" in
EXIT)
	tmux send-keys -t "$SESS" Escape
	pause 1
	tmux send-keys -t "$SESS" "/exit" Enter
	pause 5
	;;
CLOSE) tmux kill-session -t "$SESS" ;;
ESC)
	tmux send-keys -t "$SESS" Escape Escape
	pause 5
	tmux kill-session -t "$SESS"
	;;
esac
echo "[encerrado] modo=$MODE"
pause 20

SURV=0
for p in "${TREE[@]}"; do
	[ -d "/proc/$p" ] || continue
	c=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | cut -c1-75)
	case "$c" in *mcp* | *desktop-commander* | *playwright* | *browser-use* | *convex* | *aikido* | *docker\ run* | *lumen*)
		SURV=$((SURV + 1))
		echo "    ORFAO pid=$p ppid=$(awk '/^PPid:/{print $2}' "/proc/$p/status" 2>/dev/null) rss=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)kB :: $c"
		;;
	esac
done
DOCK2=$(docker ps -q --filter ancestor=hashicorp/terraform-mcp-server:0.4.0 | wc -l)
echo "[RESULTADO $MODE] arvore=${#TREE[@]} ORFAOS_MCP=$SURV | docker antes=$DOCK0 durante=$DOCK1 depois=$DOCK2"
tmux kill-session -t "$SESS" 2>/dev/null
exit 0
