#!/usr/bin/env python3
"""check-invalidated-layer-recovery — camada invalidada que nunca voltou.

Quando `tools/bootstrap-chain --from N` reinicia a cadeia, ele chama
`tools/bootstrap-step-receipts reset --invalidate-declared-outputs`, que NÃO
apaga nada: move cada output declarado para um vizinho
`<arquivo>.stale-resume-<passo>-<origem>-<token>` por `renameat2`, preservando
os bytes (ver move_to_recoverable_stale em tools/bootstrap-step-receipts:529).

O desenho é correto — o problema é o que acontece quando a cadeia NÃO chega ao
fim. Os passos executados regeneram seus outputs; os passos que não rodaram
deixam a camada invalidada e ausente do disco. O repositório fica com um buraco
silencioso: o arquivo existe no HEAD, some da worktree, e a única pista é um
`missing_layer_file` genérico no contrato de storage — que não diz onde está o
conteúdo nem que ele é recuperável.

Foi exatamente o que ocorreu em 2026-08-04: 10 camadas (21 MB, entre elas
semantic_cluster_index.jsonl com 1.771 registros e refined_public_prose.jsonl
com 590) estavam fora do disco desde um reset, com os bytes intactos ao lado o
tempo todo. Ninguém tinha perdido nada e ninguém sabia disso.

Este check é READ-ONLY, SEM EXCEÇÃO E SEM FLAG, e REPROVA (exit 1) quando
encontra camada invalidada sem regeneração — o caso em que produto está fora do
lugar. Também lista os pares já regenerados, cujo vizinho stale é backup
legítimo: é ruído a classificar, NUNCA a apagar.

A RESTAURAÇÃO SAIU DAQUI EM 2026-08-29, e este é o ponto do arquivo:
`CLAUDE.md` declara que `tools/check-*` é read-only e `tools/generate-*`
escreve, e até aquele dia este check aceitava `--recover` — medido na varredura
dos 453 `tools/check-*`, o ÚNICO deles que mexia na ÁRVORE DE TRABALHO
versionada (os demais que escrevem gravam série em `data/ops/`). Um gate que
move arquivo versionado não é gate; quem o rodava para diagnosticar podia sair
tendo alterado o que pretendia auditar. A ação inteira, com o mesmo critério de
segurança (só devolve se os bytes conferem com o HEAD), vive agora em
`tools/repair-invalidated-layer`. Nada de comportamento foi perdido: mudou o
arquivo que carrega o poder de escrever.

`WIKI_ROOT` existe para o selftest: o irmão `check-brotli-static-fresco` já lê a
raiz do ambiente, e sem isso não há como PROVAR num sandbox que este arquivo não
escreve — a prova é `tools/check-invalidated-layer-recovery-selftest`.

Uso:
    ./tools/check-invalidated-layer-recovery
    ./tools/check-invalidated-layer-recovery --json
    ./tools/repair-invalidated-layer          # o lado que escreve
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys

ROOT = pathlib.Path(os.environ.get(
    "WIKI_ROOT", pathlib.Path(__file__).resolve().parent.parent)).resolve()
MARCADOR = ".stale-resume-"
# Varre a árvore de dados inteira, não uma lista fixa de diretórios. A primeira
# versão deste check olhava só data/editorial e data/ops e por isso não viu 4
# camadas movidas em data/source-registry — o mesmo tipo de buraco que ele
# existe para impedir. O reset invalida os outputs DECLARADOS pelos passos da
# cadeia, e esses passos escrevem em qualquer subdiretório de data/.
RAIZES = ("data", "content")
# A quarentena de shards tem seu próprio ciclo de vida (renameat2 para
# v2_pages_quarantine, com recibo e spec) e não participa do reset da cadeia.
IGNORAR = ("data/editorial/v2_pages_quarantine",)


def original_de(stale: pathlib.Path) -> pathlib.Path:
    """Devolve o caminho do arquivo que deu origem ao vizinho stale."""
    return stale.with_name(stale.name.split(MARCADOR, 1)[0])


def coletar() -> tuple[list[dict], list[dict]]:
    """Separa os vizinhos stale em ausentes (buraco) e regenerados (backup)."""
    ausentes: list[dict] = []
    regenerados: list[dict] = []
    for raiz in RAIZES:
        base = ROOT / raiz
        if not base.is_dir():
            continue
        for stale in sorted(base.rglob("*" + MARCADOR + "*")):
            if MARCADOR not in stale.name or not stale.is_file():
                continue
            relativo_stale = stale.relative_to(ROOT).as_posix()
            if any(relativo_stale.startswith(ignorado) for ignorado in IGNORAR):
                continue
            original = original_de(stale)
            relativo = original.relative_to(ROOT).as_posix()
            registro = {
                "camada": relativo,
                "preservado_em": stale.relative_to(ROOT).as_posix(),
                "bytes": stale.stat().st_size,
            }
            if original.exists():
                regenerados.append(registro)
            else:
                ausentes.append(registro)
    return ausentes, regenerados


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="saída estruturada")
    args = parser.parse_args()

    ausentes, regenerados = coletar()

    resultado = {
        "camadas_invalidadas_sem_regeneracao": ausentes,
        "backups_de_camada_regenerada": len(regenerados),
    }

    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=1))
    else:
        print(f"check-invalidated-layer-recovery: backups de camada já regenerada: "
              f"{len(regenerados)} (ruído a classificar, nunca a apagar)")

    if ausentes:
        print(f"\nREPROVADO: {len(ausentes)} camada(s) foram invalidadas por um reset da cadeia "
              f"e nunca regeneradas — o conteúdo está preservado ao lado, fora do lugar:",
              file=sys.stderr)
        for item in ausentes:
            print(f"  {item['camada']} — preservado em {item['preservado_em']} "
                  f"({item['bytes']} bytes)", file=sys.stderr)
        print("\nPara recuperar: ./tools/repair-invalidated-layer",
              file=sys.stderr)
        return 1

    print("check-invalidated-layer-recovery: OK — nenhuma camada invalidada fora do lugar")
    return 0


if __name__ == "__main__":
    sys.exit(main())
