#!/usr/bin/env python3
"""check-anchor-claim-sustenta-dispositivo — o claim carrega mesmo o dispositivo que promete?

read-only. NAO escreve em data/.

O QUE ELE ACUSA. `official_sources[].anchor_claim` e metadado de proveniencia: e
o que permite conferir que a fonte sustenta a afirmacao da pagina. Ele mente em
duas formas, e as duas sao detectaveis sem opiniao:

  preenchimento_generico — o campo traz rotulo de preenchimento no lugar do
      dispositivo ("texto oficial vigente da norma no Planalto"). Promete
      conferencia e entrega nada.
  claim_nao_toca_o_dispositivo — a fonte declara um artigo no `name`
      ("CDC, art. 51"), o artigo existe em data/legal-corpus, e o claim NAO
      compartilha nenhum termo de conteudo com o texto oficial daquele artigo.

ESCOPO, e por que ele e estreito de proposito. So entram fontes cuja URL resolve
para um diploma do corpus. Fonte institucional (SCON do STJ, pagina da SUSEP,
noticia de tribunal) descreve uma PAGINA, nao um artigo: cobra-la contra texto de
lei acusaria o acervo inteiro por um defeito que nao existe.

FALSO POSITIVO, o risco real deste detector. Claim legitimo costuma ser
DESCRITIVO ("Permite ao juiz inverter o onus da prova quando a alegacao for
verossimil"), nao copia literal. Por isso o criterio e "nenhum termo em comum",
nao "pouca sobreposicao": exige-se divergencia total para acusar. O teste
embutido (--autoteste) roda sobre amostras REAIS do acervo e falha se qualquer
claim descritivo legitimo for acusado.

Uso:
    tools/check-anchor-claim-sustenta-dispositivo
    tools/check-anchor-claim-sustenta-dispositivo --autoteste
    tools/check-anchor-claim-sustenta-dispositivo --limite 40
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path(os.path.dirname(os.path.abspath(os.path.dirname(__file__))))
CORPUS = ROOT / "data/legal-corpus"
PAGES = ROOT / "data/editorial/v2_pages"

PREENCHIMENTOS = (
    "texto oficial vigente da norma no Planalto",
    "texto oficial vigente da norma",
)

PALAVRA_RE = re.compile(r"[0-9a-zà-öø-ÿ]{4,}", re.IGNORECASE)
# Palavras que qualquer texto juridico carrega: nao provam relacao com o artigo.
VAZIAS = {
    "para", "pela", "pelo", "pelos", "pelas", "como", "quando", "que", "com",
    "dos", "das", "seus", "suas", "este", "esta", "esse", "essa", "sobre",
    "entre", "ainda", "artigo", "art", "lei", "leis", "codigo", "código",
    "caso", "casos", "outros", "outras", "mesmo", "mesma", "sera", "será",
    "texto", "oficial", "vigente", "norma", "planalto", "compilado", "federal",
    "nacional", "brasileiro", "brasileira", "disposto", "previsto", "prevista",
    "termos", "forma", "sendo", "podera", "poderá", "devera", "deverá",
}

# O numero pode trazer separador de milhar ("art. 1.694"): captura-lo pela
# metade produzia identidade errada de artigo ("codigo_civil art. 1") e
# acusacao sobre o dispositivo errado.
ARTIGO_NO_NOME = re.compile(
    r"art(?:igo|\.)\s*(\d[\d.]*[ºo°]?(?:\s*-\s*[A-Za-z])?)", re.IGNORECASE)
# Reconhece tambem o PLURAL ("arts. 3º, 442-B e 818"), que e a forma tipica do
# claim referencial. Escrever so `art(?:igo|\.)` deixava 106 fontes sadias
# acusadas — o proprio autoteste apanhou a falha.
CLAIM_REFERENCIAL = re.compile(r"\barts?\.?\s*\d", re.IGNORECASE)


def normalizar_url(url: str) -> str:
    url = (url or "").strip().lower().split("#", 1)[0].split("?", 1)[0]
    url = re.sub(r"^https?://(www\.)?", "", url)
    arquivo = url.rsplit("/", 1)[-1]
    arquivo = re.sub(r"\.html?$", "", arquivo)
    return re.sub(r"(compilado|compilada|compilado2|consol|cons)$", "", arquivo)


def termos(texto: str) -> set:
    """Radicais, nao palavras inteiras.

    Sem isso, "direito" no claim e "direitos" no caput contam como termos
    diferentes, e o detector acusa fonte sadia por flexao de numero — foi o que
    aconteceu com 208 fontes na primeira medicao. Truncar em 6 caracteres e
    grosseiro, mas e reproduzivel e nao depende de dicionario externo.
    """
    cheios = {p.lower() for p in PALAVRA_RE.findall(texto or "")} - VAZIAS
    return {p[:6] for p in cheios}


def carregar_corpus():
    diplomas, por_url = {}, {}
    for caminho in sorted(CORPUS.glob("*.json")):
        dados = json.loads(caminho.read_text(encoding="utf-8"))
        slug = dados.get("slug") or caminho.stem
        diplomas[slug] = dados
        for campo in ("source_url", "conference_url", "citation_url", "declared_url"):
            if dados.get(campo):
                por_url[normalizar_url(dados[campo])] = slug
    return diplomas, por_url


def texto_do_artigo(dados: dict, artigo: str):
    chave = re.sub(r"[ºo°\s.]", "", artigo or "").upper()
    artigos = dados.get("articles") or {}
    for candidato in (chave, chave.replace("-", "-")):
        if candidato in artigos:
            return " ".join(artigos[candidato].split())
    return None


def avaliar(fonte: dict, diplomas: dict, por_url: dict):
    """Devolve (codigo, detalhe) ou None quando a fonte esta sa."""
    claim = (fonte.get("anchor_claim") or "").strip()
    if not claim:
        return ("claim_ausente", "campo vazio")
    for preenchimento in PREENCHIMENTOS:
        if preenchimento in claim:
            return ("preenchimento_generico", preenchimento)

    diploma = por_url.get(normalizar_url(fonte.get("url") or ""))
    if not diploma:
        return None  # fonte institucional: fora do escopo, de proposito
    marca = ARTIGO_NO_NOME.search(fonte.get("name") or "")
    if not marca:
        return None  # a fonte nao promete artigo especifico
    oficial = texto_do_artigo(diplomas[diploma], marca.group(1))
    if not oficial:
        return None  # artigo fora do corpus: nao se acusa o que nao se pode conferir

    # Claim REFERENCIAL — o que ele proprio enumera dispositivos ("arts. 3º,
    # 442-B e 818, II, orientam o exame do vinculo") — descreve a funcao de um
    # conjunto de artigos, nao reproduz um caput. Cobrar dele termo do texto
    # oficial acusa 1.101 fontes sadias do acervo. Fora do alcance deste teste.
    if CLAIM_REFERENCIAL.search(claim):
        return None

    if not (termos(claim) & termos(oficial)):
        return ("claim_nao_toca_o_dispositivo",
                f"{diploma} art. {marca.group(1)}")
    return None


def varrer(diplomas, por_url):
    achados = []
    for shard in sorted(PAGES.glob("*.jsonl")):
        for numero, linha in enumerate(open(shard, encoding="utf-8"), 1):
            linha = linha.strip()
            if not linha:
                continue
            reg = json.loads(linha)
            for indice, fonte in enumerate(reg.get("official_sources") or []):
                veredito = avaliar(fonte, diplomas, por_url)
                if veredito:
                    achados.append({
                        "shard": shard.name, "linha": numero,
                        "intent_id": reg.get("intent_id"), "source_index": indice,
                        "source_name": fonte.get("name"),
                        "codigo": veredito[0], "detalhe": veredito[1],
                    })
    return achados


def autoteste(diplomas, por_url) -> int:
    """Falso positivo sobre amostra REAL — o detector nasce com ele.

    NEGATIVOS sao claims descritivos legitimos, copiados do acervo vivo: o
    detector NAO pode acusar nenhum deles. POSITIVOS sao os defeitos que ele
    existe para pegar.
    """
    negativos = [
        # descritivos legitimos, colhidos de data/editorial/v2_pages
        {"name": "CDC, art. 6º", "url": "https://www.planalto.gov.br/ccivil_03/leis/l8078.htm",
         "anchor_claim": "Permite ao juiz inverter o ônus da prova quando a alegação "
                         "for verossímil ou o consumidor for hipossuficiente."},
        {"name": "CDC, art. 51", "url": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
         "anchor_claim": "Considera nulas as cláusulas que coloquem o consumidor em "
                         "desvantagem exagerada ou sejam incompatíveis com a boa-fé."},
        {"name": "Código Penal (Decreto-Lei 2.848/1940), art. 113",
         "url": "https://www.planalto.gov.br/ccivil_03/decreto-lei/del2848compilado.htm",
         "anchor_claim": "No caso de evadir-se o condenado ou de revogar-se o livramento "
                         "condicional, a prescrição é regulada pelo tempo que resta da pena."},
        # fonte institucional: descreve pagina, nao artigo — fora do escopo
        {"name": "Sistema de Consulta à Jurisprudência do STJ (SCON)",
         "url": "https://processo.stj.jus.br/SCON/",
         "anchor_claim": "página oficial do sistema de consulta à jurisprudência do "
                         "Superior Tribunal de Justiça"},
        {"name": "SUSEP — Seguro Viagem",
         "url": "https://www.gov.br/susep/pt-br/assuntos/seguros/seguro-viagem",
         "anchor_claim": "página oficial da SUSEP sobre o seguro viagem"},
        # artigo fora do corpus: nao se acusa o que nao se pode conferir
        {"name": "Lei de Execução Penal (Lei nº 7.210/1984), art. 50",
         "url": "https://www.planalto.gov.br/ccivil_03/leis/l7210.htm",
         "anchor_claim": "texto do art. 50 da Lei de Execução Penal"},
        # REFERENCIAL, colhido de autonomos-04.jsonl: descreve a funcao de tres
        # artigos e nao compartilha termo nenhum com o caput do art. 3º da CLT.
        # Foi o falso positivo que obrigou a estreitar a regra.
        {"name": "CLT (art. 3º, vínculo de emprego)",
         "url": "https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452.htm",
         "anchor_claim": "arts. 3º, 442-B e 818, II, orientam o exame do vínculo "
                         "e o ônus de provar o fato impeditivo alegado na defesa"},
    ]
    positivos = [
        {"name": "Lei nº 9503, de 1997",
         "url": "https://www.planalto.gov.br/ccivil_03/leis/l9503compilado.htm",
         "anchor_claim": "texto oficial vigente da norma no Planalto"},
        {"name": "CDC, art. 51",
         "url": "https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm",
         "anchor_claim": "quorum de instalação da assembleia geral de acionistas "
                         "em primeira convocação"},
    ]

    falhas = []
    for fonte in negativos:
        veredito = avaliar(fonte, diplomas, por_url)
        if veredito:
            falhas.append(f"FALSO POSITIVO em {fonte['name']!r}: {veredito}")
    for fonte in positivos:
        if not avaliar(fonte, diplomas, por_url):
            falhas.append(f"FALSO NEGATIVO em {fonte['name']!r}")

    for falha in falhas:
        print("  " + falha, file=sys.stderr)
    print(f"autoteste: {len(negativos)} negativos, {len(positivos)} positivos, "
          f"{len(falhas)} falha(s)")
    return 1 if falhas else 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--autoteste", action="store_true")
    parser.add_argument("--estrito", action="store_true",
                        help="reprova tambem pelo indicio ainda em triagem")
    parser.add_argument("--limite", type=int, default=15)
    args = parser.parse_args()

    diplomas, por_url = carregar_corpus()
    if args.autoteste:
        return autoteste(diplomas, por_url)

    achados = varrer(diplomas, por_url)
    porcodigo = {}
    for achado in achados:
        porcodigo.setdefault(achado["codigo"], []).append(achado)
    for codigo, itens in sorted(porcodigo.items()):
        print(f"{codigo}: {len(itens)}")
        for item in itens[:args.limite]:
            print(f"    {item['shard']}:{item['linha']} {item['intent_id']} "
                  f"[{item['source_index']}] {item['detalhe']}")
        if len(itens) > args.limite:
            print(f"    ... e mais {len(itens) - args.limite}")
    if not achados:
        print("nenhum anchor_claim divergente do dispositivo que promete")

    # SEVERIDADE. `preenchimento_generico` e `claim_ausente` sao PROVADOS: a
    # string esta la, ou o campo esta vazio; nao ha juizo no meio. Ja
    # `claim_nao_toca_o_dispositivo` e INDICIO — mede vocabulario compartilhado,
    # e claim legitimo costuma ser descritivo. Saiu de 1.101 para 79 com duas
    # correcoes do proprio detector (plural referencial e separador de milhar) e
    # a radicalizacao; enquanto os 79 nao passarem por triagem lida, ele informa
    # e nao reprova. Reprovar por medida nao conferida seria o mesmo defeito que
    # este trabalho corrige.
    provados = [a for a in achados
                if a["codigo"] in ("preenchimento_generico", "claim_ausente")]
    indicios = [a for a in achados if a["codigo"] == "claim_nao_toca_o_dispositivo"]
    print(f"\nprovados (reprovam): {len(provados)} | "
          f"indicios em triagem (informam): {len(indicios)}")
    return 1 if (provados or (args.estrito and indicios)) else 0


if __name__ == "__main__":
    raise SystemExit(main())
