#!/usr/bin/env bash
# check-moderacao-transparencia-serie — a série diária da moderação está viva,
# agregada e sem identificador? READ-ONLY: não escreve em data/, content/ nem
# public/, e não gera linha faltante.
#
# ★ O QUE ELE MEDE, e por que cada coisa:
#
#   • PISO DE AGREGAÇÃO CUMPRIDO NO DADO. A regra de suprimir célula pequena
#     mora em internal/moderacaotransparencia, mas regra no código não prova
#     nada sobre o arquivo publicado. Este gate percorre cada célula da linha e
#     reprova contagem exata entre 1 e 4 — a proteção conferida onde ela importa,
#     que é no artefato que sai para o público.
#   • AUSÊNCIA DE IDENTIFICADOR. Campo proibido (conta_id, conteudo_ref,
#     revisor_id, numero_processo…), sha256 em hexadecimal e caminho de post
#     individual. A série é agregada; um recorte individual aqui desfaz por fora
#     o que o pseudônimo de internal/moderacao protege por dentro.
#   • SÉRIE VIVA. Linha mais recente com mais de 2 dias significa gerador parado
#     — e série parada alimenta o relatório de transparência com dado velho como
#     se fosse de hoje.
#   • FALHA FECHADA. `coletas > 0` sem banco presente, `coletas: 0` declarado
#     "coletada", estado fora do enum, dia repetido, e banco que sumiu depois de
#     ter existido (isso é incidente, não estado esperado).
#
# ★ VERDE AQUI NÃO É PROVA DE QUE O RELATÓRIO ESTÁ CERTO. Ele confere forma,
# piso e vivacidade; não confere se o revisor decidiu bem. As ressalvas do que a
# série não consegue medir viajam na própria linha, no campo `ressalvas`.
#
# O motor é internal/checks e é o MESMO que o gate "moderacao-transparencia-serie"
# executa pelo runner.
#
#   tools/check-moderacao-transparencia-serie
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e não `go-modern run ./cmd/check` direto: é por ele que passam o
# cache do binário, o teto de tempo e a política de argumentos.
exec "$ROOT/tools/run-check" moderacao-transparencia-serie --timings "$@"
