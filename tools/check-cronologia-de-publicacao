#!/usr/bin/env bash
# check-cronologia-de-publicacao — prova, READ-ONLY, que nenhuma página servida
# em public/ afirma ter estreado DEPOIS da última vez que mudou.
#
# POR QUE ELE EXISTE (P1b, 2026-09-16). A regra já estava escrita em
# `cmd/publish-v2-direct/main.go:485-492`, com o número medido ao lado, e
# nenhum instrumento a verificava sobre o artefato SERVIDO. Medido sobre a
# população inteira em 2026-09-16: 942 páginas no ar com `dateModified`
# anterior a `datePublished` no JSON-LD — /jurisprudencia/ 875, /leis/ 38,
# /sumulas/ 29. A borda confirmava por via independente: a mesma rota devolvia
# `last-modified` de 05/09 e JSON-LD dizendo publicado em 15/09.
#
# A causa é a do P1b: `data/editorial/first_published_at.json` congelado faz o
# publicador cair na flag `-published-at "$HOJE"`, e a data de estreia anda um
# dia a cada onda.
#
# O que ele confere:
#   1. todo nó de JSON-LD com as DUAS datas tem modificação >= publicação (por
#      DIA, porque o acervo emite `2026-09-10` e `2026-09-13T15:25:13Z`);
#   2. data presente e ilegível é achado próprio, nunca silêncio;
#   3. piso de volume: toda rota do published_manifest tem página servida com
#      nó datado — sem piso, public/ podado deixaria o gate verde.
#
# É o MESMO motor do gate nomeado:
#   ./tools/go-modern run ./cmd/check cronologia-de-publicacao
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e nao `go-modern run ./cmd/check` direto: e por ele que passam o
# cache do binario, o teto de tempo, o orcamento e a politica de argumentos.
exec "$ROOT/tools/run-check" cronologia-de-publicacao --timings "$@"
