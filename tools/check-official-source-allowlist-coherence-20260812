#!/usr/bin/env python3
"""check-official-source-allowlist-coherence-20260812 — as listas de fonte oficial dizem a mesma coisa?

READ-ONLY: lê código e acervo, não escreve nada.

POR QUE EXISTE: "fonte oficial" é decidido em SEIS lugares independentes deste
repo — quatro em Go e dois em Python — cada um com sua própria cópia da lista.
Enquanto elas divergem, a mesma URL é oficial para um gate e não-oficial para
outro, e a página vive ou morre conforme a ordem em que os gates rodam. Foi
exatamente isso que produziu as 19 lápides de `cidadania-04.jsonl`, cujo motivo
declarado é "normattiva.it e tribunali.it fora do allowlist
gov.br/jus.br/leg.br/mp.br" — descarte feito sob uma lista que o commit 49aaf3ec
depois ampliou, sem que o descarte fosse revisto.

O que este check reprova (saída 1):
  * host exato presente numa lista e ausente de outra;
  * sufixo aceito por uma lista e não por outra;
  * ocorrência do acervo que uma lista aceita e outra recusa.

O que ele NÃO faz: não propõe ampliar nada sozinho. Ampliar allowlist de fonte é
decisão editorial com custo — cada host novo é um órgão nomeado, com a lei que o
institui. O check só impede que a decisão já tomada valha em metade do código.
"""
from __future__ import annotations

import collections
import glob
import json
import os
import re
import sys
from urllib.parse import urlparse

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))

FONTES = [
    ("internal/v2ingest/validate.go", r"allowedSourceExactHosts", r"allowedSourceHostSuffixes"),
    ("internal/v2sourceprovenance/inventory.go", r"officialExactHosts", r"officialHostSuffixes"),
    ("internal/v2writingsemantic/material.go", r"exactOfficialHosts", r"gov\.br"),
    ("internal/quality/quality.go", r"officialSourceHosts", r"officialSourceSuffixes"),
    ("tools/generate_v2_review_queue.py", r"_WRITING_SOURCE_EXACT_HOSTS", r"_OFFICIAL_SOURCE_SUFFIXES"),
]


def bloco(texto: str, nome: str) -> str:
    achado = re.search(nome + r"\s*=?\s*(?:map\[string\](?:struct\{\}|string)|\[\]string|frozenset\(|\()\{?(.*?)\n\s*[\}\)]",
                       texto, re.S)
    return achado.group(1) if achado else ""


def hosts_de(caminho: str, nome_exatos: str) -> set:
    try:
        with open(os.path.join(ROOT, caminho), encoding="utf-8") as arquivo:
            texto = arquivo.read()
    except OSError:
        return set()
    corpo = bloco(texto, nome_exatos)
    return {h for h in re.findall(r'"([^"\s]+\.[^"\s]+)"', corpo) if "/" not in h and " " not in h}


def sufixos_de(caminho: str) -> set:
    try:
        with open(os.path.join(ROOT, caminho), encoding="utf-8") as arquivo:
            texto = arquivo.read()
    except OSError:
        return set()
    achados = set()
    for grupo in re.findall(r'\{\s*("\.?(?:gov|jus|leg|mp|def)\.br"[^}]*)\}', texto):
        achados |= {s.lstrip(".") for s in re.findall(r'"\.?([a-z]+\.br)"', grupo)}
    for grupo in re.findall(r'\(\s*("(?:gov|jus|leg|mp|def)\.br"[^)]*)\)', texto):
        achados |= {s.lstrip(".") for s in re.findall(r'"\.?([a-z]+\.br)"', grupo)}
    return achados


def oficial(host: str, exatos: set, sufixos: set) -> bool:
    host = host.lower()
    if host in exatos:
        return True
    return any(host == s or host.endswith("." + s) for s in sufixos)


def ocorrencias_do_acervo() -> collections.Counter:
    contagem: collections.Counter = collections.Counter()
    for caminho in sorted(glob.glob(os.path.join(ROOT, "data/editorial/v2_pages/*.jsonl"))):
        with open(caminho, encoding="utf-8") as arquivo:
            for linha in arquivo:
                try:
                    registro = json.loads(linha)
                except ValueError:
                    continue
                for fonte in registro.get("official_sources") or []:
                    url = fonte.get("url") or ""
                    host = (urlparse(url).hostname or "").lower()
                    if host:
                        contagem[host] += 1
    return contagem


def main() -> int:
    listas = {}
    for caminho, nome_exatos, _ in FONTES:
        listas[caminho] = (hosts_de(caminho, nome_exatos), sufixos_de(caminho))

    print("lista de fonte oficial, por arquivo:")
    for caminho, (exatos, sufixos) in listas.items():
        print("  %-46s hosts exatos: %2d | sufixos: %s"
              % (caminho, len(exatos), ",".join(sorted(sufixos)) or "-"))

    referencia = "internal/v2ingest/validate.go"
    exatos_ref, sufixos_ref = listas[referencia]
    divergencias = 0
    print("\ndivergência contra %s:" % referencia)
    for caminho, (exatos, sufixos) in listas.items():
        if caminho == referencia:
            continue
        falta = exatos_ref - exatos
        sobra = exatos - exatos_ref
        dif_sufixo = sufixos ^ sufixos_ref
        if falta or sobra or dif_sufixo:
            divergencias += 1
            print("  %s" % caminho)
            if falta:
                print("     não tem: %s" % ", ".join(sorted(falta)))
            if sobra:
                print("     só ele tem: %s" % ", ".join(sorted(sobra)))
            if dif_sufixo:
                print("     sufixos divergentes: %s" % ", ".join(sorted(dif_sufixo)))
        else:
            print("  %s — idêntica" % caminho)

    contagem = ocorrencias_do_acervo()
    print("\nefeito no acervo vivo (%d hosts distintos, %d ocorrências):"
          % (len(contagem), sum(contagem.values())))
    conflitos = []
    for host, quantas in contagem.items():
        vereditos = {c: oficial(host, e, s) for c, (e, s) in listas.items()}
        if len(set(vereditos.values())) > 1:
            conflitos.append((quantas, host, vereditos))
    conflitos.sort(reverse=True)
    if not conflitos:
        print("  nenhum host do acervo recebe veredito conflitante.")
    for quantas, host, vereditos in conflitos:
        aceitam = [os.path.basename(c) for c, v in vereditos.items() if v]
        recusam = [os.path.basename(c) for c, v in vereditos.items() if not v]
        print("  %4d ocorrências  %-34s aceitam: %s | recusam: %s"
              % (quantas, host, ",".join(aceitam) or "-", ",".join(recusam) or "-"))

    total_conflitante = sum(q for q, _, _ in conflitos)
    print("\nhosts com veredito conflitante: %d (%d ocorrências)"
          % (len(conflitos), total_conflitante))
    if divergencias or conflitos:
        print("REPROVA: a mesma URL é oficial para um gate e não para outro.")
        return 1
    print("OK: todas as listas concordam.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
