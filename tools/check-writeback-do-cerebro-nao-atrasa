#!/usr/bin/env python3
"""check-writeback-do-cerebro-nao-atrasa — READ-ONLY.

O cerebro extrai dispositivos de acordao e grava em
`data/ai/extracoes_dispositivos.jsonl`. Quem transforma isso em insumo e
`cmd/generate-writeback-extracoes`, que escreve `data/ai/dispositivos_promovidos.jsonl`
— e e ESSE arquivo que `internal/stjacordaos.CarregaSobreposicao` expoe a
`generate-lei-artigo-pages:461`, `generate-acordao-pages:413` e `cmd/cerebro:676`.

POR QUE ESTE GATE NASCEU (2026-09-10). O writeback era PRODUTOR ORFAO: existia
desde 09-09 e `grep -rn generate-writeback-extracoes tools/ ops/ .githooks/`
devolvia vazio. Ele rodou uma vez, as 06:11, e congelou em 214 promocoes. As
19:41 do mesmo dia havia **981 extracoes sem promocao, 882 com pelo menos uma
URN** — 1.355 vinculos de sumula e 283 de norma/artigo parados no disco, invisiveis
para os tres consumidores.

E o custo nao para no vinculo perdido: `cmd/cerebro extrair --so-sem` filtra por
`dispositivos_citados_urn` vazio, exatamente o campo que a promocao preenche. Sem
writeback o cerebro REAPRESENTA como candidato o que ja resolveu e paga de novo
75-100 s por item numa CPU sem folga. Trabalho pago duas vezes, resultado zero.

O QUE ELE MEDE, e por que nao e uma contagem. Backlog grande nao e defeito: o
cerebro trabalha 24/7 e a onda promove uma vez por dia, entao ter centenas de
extracoes recentes por promover e o REGIME NORMAL. O que e defeito e o writeback
ter PARADO — e isso se mede pela IDADE do pendente mais antigo, nao pelo tamanho
da fila. Uma extracao com URN esperando ha mais de `--idade-maxima-horas` (26 por
padrao: um ciclo de onda mais margem) so acontece se ninguem rodou o produtor.

CARDINALIDADE ANTES DA AMOSTRA. A primeira linha traz extraidas, promovidas,
pendentes e a idade do pendente mais antigo, ANTES de qualquer chave.

Uso:
    tools/check-writeback-do-cerebro-nao-atrasa
    tools/check-writeback-do-cerebro-nao-atrasa --raiz /caminho --idade-maxima-horas 6
"""
from __future__ import annotations

import argparse
import datetime
import json
import sys
from pathlib import Path

EXTRACOES = "data/ai/extracoes_dispositivos.jsonl"
PROMOVIDOS = "data/ai/dispositivos_promovidos.jsonl"
IDADE_MAXIMA_HORAS_PADRAO = 26.0
TETO_DE_LISTA = 20


def le_jsonl(caminho: Path) -> list[dict]:
    if not caminho.exists():
        return []
    registros = []
    for numero, linha in enumerate(caminho.read_text(encoding="utf-8").splitlines(), 1):
        linha = linha.strip()
        if not linha:
            continue
        try:
            registros.append(json.loads(linha))
        except json.JSONDecodeError as erro:
            raise SystemExit("check-writeback-do-cerebro-nao-atrasa: %s linha %d: %s"
                             % (caminho, numero, erro))
    return registros


def instante(texto: str) -> datetime.datetime | None:
    """RFC3339 em UTC, como o cerebro grava (`...Z`)."""
    texto = (texto or "").strip()
    if not texto:
        return None
    try:
        return datetime.datetime.fromisoformat(texto.replace("Z", "+00:00"))
    except ValueError:
        return None


def tem_urn(registro: dict) -> bool:
    for item in registro.get("dispositivos") or []:
        if str(item.get("urn", "")).strip():
            return True
    return False


def main(argv: list[str]) -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--raiz", default=None)
    analisador.add_argument("--idade-maxima-horas", type=float,
                            default=IDADE_MAXIMA_HORAS_PADRAO)
    argumentos = analisador.parse_args(argv)

    raiz = Path(argumentos.raiz).resolve() if argumentos.raiz \
        else Path(__file__).resolve().parent.parent

    extracoes = le_jsonl(raiz / EXTRACOES)
    promovidos = le_jsonl(raiz / PROMOVIDOS)
    ja_promovido = {str(r.get("id_fonte", "")).strip() for r in promovidos}

    # A ULTIMA LINHA POR CHAVE E A VERDADE, e esta lista quase nasceu errada.
    # O arquivo e append-only e o cerebro REPROCESSA quando o prompt muda:
    # `cmd/generate-writeback-extracoes:106` guarda a ultima ocorrencia por
    # `chave`, e o gate tem de julgar o MESMO recorte. Medido em 2026-09-10, a
    # primeira versao deste gate somava TODAS as linhas e acusou 21 pendentes;
    # 12 delas eram acordaos que a revisao `norma_atestada_v1` reprocessou as
    # 09:11 e esvaziou de proposito (`descartados_norma_nao_atestada`), com o
    # mesmo `texto_sha256` e outro `prompt_sha256`. URN retirada por revisao mais
    # estrita nao e trabalho pendente — e trabalho DESFEITO por decisao. Cobrar a
    # promocao dela seria mandar reintroduzir o que o cerebro acabou de recusar.
    ultima = {}
    for registro in extracoes:
        chave = str(registro.get("chave", "")).strip() or str(registro.get("id_fonte", "")).strip()
        if chave:
            ultima[chave] = registro

    # Uma extracao SEM urn nao tem o que promover: o item e quase sempre um
    # precedente ("AgInt no REsp 1.705.426/MA"), e precedente nao vira aresta de
    # norma. Conta-la como pendente faria o gate cobrar trabalho impossivel.
    pendentes = []
    for registro in ultima.values():
        chave = str(registro.get("id_fonte", "")).strip()
        if not chave or chave in ja_promovido or not tem_urn(registro):
            continue
        pendentes.append((chave, instante(registro.get("gerado_em", ""))))

    agora = datetime.datetime.now(datetime.timezone.utc)
    com_data = [(c, d) for c, d in pendentes if d is not None]
    mais_antigo = min(com_data, key=lambda p: p[1]) if com_data else None
    idade = (agora - mais_antigo[1]).total_seconds() / 3600.0 if mais_antigo else 0.0

    print("linhas de extracao: %d | acordaos distintos: %d | promovidos: %d | "
          "pendentes com URN: %d | pendente mais antigo: %.1f h"
          % (len(extracoes), len(ultima), len(promovidos), len(pendentes), idade))

    if not mais_antigo or idade <= argumentos.idade_maxima_horas:
        if pendentes:
            print("  fila normal: o cerebro trabalha 24/7 e a onda promove 1x/dia")
        return 0

    atrasados = sorted((p for p in com_data
                        if (agora - p[1]).total_seconds() / 3600.0
                        > argumentos.idade_maxima_horas),
                       key=lambda p: p[1])
    print("REPROVADO: o writeback do cerebro parou — %d extracao(oes) com URN "
          "esperando ha mais de %.1f h." % (len(atrasados), argumentos.idade_maxima_horas))
    print("  Enquanto elas nao sobem, `cmd/cerebro extrair --so-sem` reapresenta o "
          "que ja foi resolvido e paga 75-100 s por item outra vez.")
    print("  Rode o produtor (a onda o chama na etapa 1.5/9):")
    print("    ./tools/go-modern run ./cmd/generate-writeback-extracoes -raiz .")
    for chave, quando in atrasados[:TETO_DE_LISTA]:
        print("    %s  (extraido em %s)" % (chave, quando.isoformat()))
    if len(atrasados) > TETO_DE_LISTA:
        print("    ... e mais %d (total ja declarado acima)" % (len(atrasados) - TETO_DE_LISTA))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
