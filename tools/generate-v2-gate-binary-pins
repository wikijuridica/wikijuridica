#!/bin/sh
set -eu

# Regenerates tools/v2-gate-binary-pins.json: the authenticated sha256
# registry that tools/run-v2-index-product-gates uses to skip a cold Go
# toolchain extraction + compile when a previously-built gate binary with a
# matching hash is already sitting in the reuse cache.
#
# This tool rebuilds BOTH gate binaries from scratch (same recipe as a cold
# commit gate run, via --emit-pins) and writes their real sha256 into the
# registry. It never trusts anything already in the cache or in the current
# pin file -- the numbers always come from a fresh, verified build.
#
# Usage: tools/generate-v2-gate-binary-pins [COMMIT]
#   COMMIT defaults to HEAD. The resulting tools/v2-gate-binary-pins.json is
#   a normal worktree file: review the diff and commit it like any other
#   source change. The FIRST commit that introduces a new pin value still
#   cold-builds once (the trust root is the PARENT commit), and every commit
#   after that reuses the pinned binary until the gate source changes again.

PATH=/usr/bin:/bin
export PATH

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
GIT_BIN=/usr/bin/git
PYTHON_BIN=/usr/bin/python3.11

OLD="${1:-}"
if [ -z "$OLD" ]; then
	OLD="$("$GIT_BIN" -C "$ROOT" rev-parse --verify HEAD)"
fi

LAUNCHER="$ROOT/tools/run-v2-index-product-gates"
[ -x "$LAUNCHER" ] || {
	echo "generate-v2-gate-binary-pins: launcher ausente/não executável: $LAUNCHER" >&2
	exit 1
}

echo "generate-v2-gate-binary-pins: rebuild frio a partir de $OLD (pode levar minutos)..." >&2
PINS_RAW="$("$LAUNCHER" --root "$ROOT" --old "$OLD" --emit-pins)"

OUT="$ROOT/tools/v2-gate-binary-pins.json"
"$PYTHON_BIN" -I - "$OUT" "$PINS_RAW" <<'PY'
import pathlib
import re
import sys

raw = sys.argv[2]
fields = {}
for line in raw.splitlines():
    line = line.strip()
    if not line or "=" not in line:
        continue
    key, _, value = line.partition("=")
    fields[key] = value

hex64 = re.compile(r"^[0-9a-f]{64}$")
required = ("go_archive_sha256", "supersession", "writing")
missing = [name for name in required if name not in fields]
if missing:
    raise SystemExit("generate-v2-gate-binary-pins: campos ausentes na saída do launcher: " + ",".join(missing))
for name in required:
    if not hex64.match(fields[name]):
        raise SystemExit("generate-v2-gate-binary-pins: hash inválido para " + name)

document = (
    "{\n"
    "  \"schema_version\": 1,\n"
    "  \"go_archive_sha256\": \"" + fields["go_archive_sha256"] + "\",\n"
    "  \"gates\": {\n"
    "    \"supersession\": \"" + fields["supersession"] + "\",\n"
    "    \"writing\": \"" + fields["writing"] + "\"\n"
    "  }\n"
    "}\n"
)
pathlib.Path(sys.argv[1]).write_text(document)
print("generate-v2-gate-binary-pins: escreveu " + sys.argv[1], file=sys.stderr)
PY
