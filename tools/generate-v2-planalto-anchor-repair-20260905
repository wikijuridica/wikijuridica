#!/usr/bin/env python3
"""generate-v2-planalto-anchor-repair-20260905 — a citação promete o artigo e entrega a lei inteira.

O DEFEITO. Oito referências do acervo apontam para
`https://www.planalto.gov.br/ccivil_03/decreto-lei/del3689compilado.htm` SEM
fragmento, com o nome anunciando um artigo específico do Código de Processo
Penal. O leitor que clica em "CPP, art. 38" cai no topo de um código inteiro.

MEDIDO NA FONTE OFICIAL em 2026-09-05, com o User-Agent do
`internal/wikijuridicabot`, baixando os dois documentos uma vez:

    del3689.htm            1.357.237 bytes   3.669 âncoras
    del3689compilado.htm     908.608 bytes   1.954 âncoras

    art     nua   compilado
     38     SIM         não
     30     SIM         não
    268     SIM         não
    271     SIM         não
    269     SIM         não
     28     SIM         não
     44     SIM         não
     51     SIM         não

O arquivo com sufixo `compilado` traz o texto consolidado mas perdeu esses
marcadores `<a name="artN">`. Por isso a correção NÃO é acrescentar o fragmento
à URL atual — isso prometeria uma âncora que o documento não tem, e o navegador
cairia no topo do mesmo jeito. É trocar para a grafia que tem a âncora medida.

TRÊS CASOS QUE PARECIAM DEFEITO E NÃO SÃO, verificados no mesmo download:
`#art24`, `#art598` e `#art18` já apontam para `compilado` e a âncora existe lá
(1.954 âncoras não é zero — só as oito acima faltam). Ficam como estão.

POR QUE O ENDEREÇAMENTO É POR POSIÇÃO E NOME, e não por URL. Em
`crim-assistente-de-acusacao` as três URLs a corrigir são BYTE-IDÊNTICAS entre
si (a mesma `del3689compilado.htm` nua, three vezes), e cada uma anuncia um
artigo diferente no `name` — 268, 271 e 269, nessa ordem no arquivo, que não é a
numérica. Um mapa por URL, como o do gerador irmão de 2026-08-12, casaria as
três com a mesma correção e escreveria o artigo errado em duas. O alvo aqui é
`(shard, intent_id, índice em official_sources, name)`, e o `name` é conferido
antes de tocar.

SEGURANÇA. Lease de época do estoque canônico, lock exclusivo próprio, CAS por
linha (o registro tem de estar exatamente como o plano viu) e escrita atômica.
Dry-run é o padrão: `--aplicar` é explícito.

USO
    ./tools/generate-v2-planalto-anchor-repair-20260905
    ./tools/generate-v2-planalto-anchor-repair-20260905 --aplicar
"""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

PAGES = ROOT / "data/editorial/v2_pages"
LOCK = ROOT / "data/editorial/.planalto-anchor-repair-20260905.lock"
DADOS = pathlib.Path(__file__).with_suffix(".data.json")
EVIDENCIA = ROOT / "data/ops/planalto_anchor_repair_20260905.jsonl"


@contextlib.contextmanager
def exclusive_lock(path: pathlib.Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: pathlib.Path, payload: bytes) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    with open(temporary, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


def carrega_plano() -> list[dict]:
    plano = json.loads(DADOS.read_text(encoding="utf-8"))
    correcoes = plano["correcoes"]
    if not correcoes:
        raise ValueError("plano vazio: nada a reparar")
    return correcoes


def aplica(correcoes: list[dict], aplicar: bool) -> tuple[int, list[dict]]:
    por_shard: dict[str, list[dict]] = {}
    for item in correcoes:
        por_shard.setdefault(item["shard"], []).append(item)

    tocados, evidencia = 0, []
    for shard, itens in sorted(por_shard.items()):
        caminho = PAGES / f"{shard}.jsonl"
        if not caminho.exists():
            raise FileNotFoundError(f"shard ausente: {caminho}")
        linhas = caminho.read_text(encoding="utf-8").splitlines()
        alterou = False
        for item in itens:
            achou = False
            for numero, linha in enumerate(linhas):
                if not linha.strip():
                    continue
                registro = json.loads(linha)
                if registro.get("intent_id") != item["intent_id"]:
                    continue
                achou = True
                fontes = registro.get("official_sources") or []
                indice = item["indice"]
                if indice >= len(fontes):
                    raise ValueError(
                        f"{shard}/{item['intent_id']}: official_sources tem "
                        f"{len(fontes)} entradas, plano pede a de índice {indice}")
                fonte = fontes[indice]
                # CAS de identidade: o registro tem de estar exatamente como o
                # plano o viu. `name` é o que distingue as três URLs idênticas.
                if fonte.get("name") != item["name"]:
                    raise ValueError(
                        f"CAS FALHOU em {shard}/{item['intent_id']}[{indice}]: "
                        f"name é {fonte.get('name')!r}, plano viu {item['name']!r}")
                if fonte.get("url") == item["url_nova"]:
                    continue  # já reparado numa passada anterior
                if fonte.get("url") != item["url_antiga"]:
                    raise ValueError(
                        f"CAS FALHOU em {shard}/{item['intent_id']}[{indice}]: "
                        f"url é {fonte.get('url')!r}, plano viu {item['url_antiga']!r}")
                antes = hashlib.sha256(linha.encode("utf-8")).hexdigest()
                # SUBSTITUIÇÃO TEXTUAL POSICIONAL, NUNCA RESERIALIZAÇÃO.
                #
                # `json.dumps` do registro devolveria outra linha: medido em
                # `crim-assistente-de-acusacao`, 6.534 bytes viram 6.449 — 85
                # bytes de diferença em espaçamento e ordem de chaves. O diff do
                # commit mostraria o registro inteiro reescrito e a mudança real
                # (uma URL) ficaria enterrada; pior, o CAS de linha de qualquer
                # outra ferramenta sobre este shard passaria a falhar sem que
                # nada de substantivo tivesse mudado.
                #
                # Como as URLs a corrigir são byte-idênticas entre si, a
                # ocorrência certa se acha contando quantas entradas ANTERIORES
                # de `official_sources` têm a mesma URL: a k-ésima entrada com
                # aquela URL é a k-ésima ocorrência textual dela na linha, porque
                # o JSON serializado preserva a ordem do array. Medido no caso
                # das três: índices 0/1/3 → 0/1/2 anteriores, 3 ocorrências
                # textuais.
                anteriores = sum(
                    1 for j in range(indice)
                    if (fontes[j] or {}).get("url") == item["url_antiga"])
                agulha = '"' + item["url_antiga"] + '"'
                total_textual = linha.count(agulha)
                if total_textual <= anteriores:
                    raise ValueError(
                        f"{shard}/{item['intent_id']}[{indice}]: a linha tem "
                        f"{total_textual} ocorrência(s) textuais da URL, o plano "
                        f"pede a de ordem {anteriores + 1}")
                corte = -1
                for _ in range(anteriores + 1):
                    corte = linha.index(agulha, corte + 1)
                nova_linha = (linha[:corte] + '"' + item["url_nova"] + '"'
                              + linha[corte + len(agulha):])
                linhas[numero] = nova_linha
                alterou = True
                tocados += 1
                evidencia.append({
                    "shard": shard,
                    "intent_id": item["intent_id"],
                    "indice": indice,
                    "name": item["name"],
                    "url_antiga": item["url_antiga"],
                    "url_nova": item["url_nova"],
                    "linha_sha256_antes": antes,
                    "linha_sha256_depois": hashlib.sha256(
                        nova_linha.encode("utf-8")).hexdigest(),
                    "medido_em": "2026-09-05",
                })
                break
            if not achou:
                raise ValueError(
                    f"intent {item['intent_id']} não existe em {shard}")
        if alterou and aplicar:
            atomic_write(caminho, ("\n".join(linhas) + "\n").encode("utf-8"))
    return tocados, evidencia


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="reancora oito citações do CPP na grafia que tem a âncora")
    parser.add_argument("--aplicar", action="store_true",
                        help="escreve; sem isto é dry-run")
    args = parser.parse_args(argv)

    correcoes = carrega_plano()
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                tocados, evidencia = aplica(correcoes, args.aplicar)
                if args.aplicar and evidencia:
                    EVIDENCIA.parent.mkdir(parents=True, exist_ok=True)
                    atomic_write(EVIDENCIA, "".join(
                        json.dumps(e, ensure_ascii=False, sort_keys=True) + "\n"
                        for e in evidencia).encode("utf-8"))
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    print(f"correções no plano: {len(correcoes)} · registros tocados: {tocados}")
    for item in evidencia:
        print(f"  {item['shard']}/{item['intent_id']}[{item['indice']}] "
              f"→ {item['url_nova'].rsplit('/', 1)[-1]}")
    if not args.aplicar:
        print("  (dry-run: nada foi escrito; use --aplicar)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
