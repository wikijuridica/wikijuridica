def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    por_shard: dict[str, list[tuple[str, list[tuple[str, str]]]]] = {}
    for (intent, shard_rel), trocas in CORRECOES.items():
        por_shard.setdefault(shard_rel, []).append((intent, trocas))

    evidencia: list[dict] = []
    total = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for shard_rel, itens in sorted(por_shard.items()):
                    shard = ROOT / shard_rel
                    if not shard.is_file():
                        raise SystemExit(f"shard ausente: {shard_rel}")
                    tocadas = aplicar(shard, itens, args.dry_run, evidencia)
                    if tocadas:
                        print(f"{shard_rel}: {tocadas} página(s) corrigida(s)")
                    total += tocadas
                if not args.dry_run and evidencia:
                    escrever_evidencia(evidencia)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    rotulo = "--dry-run: " if args.dry_run else ""
    print(f"\n{rotulo}{total} página(s) corrigida(s) de {len(CORRECOES)} planejada(s).")
    if args.dry_run:
        print("Nada escrito.")
    elif total:
        print("Reingerir o estoque e republicar para o espelho refletir a correção.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
