CHAVE_VERIFICADO = re.compile(r'("verified_at"\s*:\s*)"[^"]*"')
CHAVE_STATUS = re.compile(r'("http_status"\s*:\s*)\d+')


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go / generate_v2_review_queue.py."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def preservar(shard: Path) -> None:
    destino = ROOT / BACKUP / shard.name
    if destino.exists():
        return
    destino.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(shard, destino)


def aplicar(shard: Path, itens: list[tuple[str, list[tuple[str, str]]]],
            dry_run: bool, evidencia: list[dict]) -> int:
    rel = os.path.relpath(shard, ROOT)
    bruto = shard.read_bytes().decode("utf-8")
    linhas = bruto.split("\n")
    fim_com_newline = bool(linhas) and linhas[-1] == ""
    if fim_com_newline:
        linhas = linhas[:-1]

    por_intent = {intent: trocas for intent, trocas in itens}
    tocadas = 0
    for numero, raw in enumerate(linhas, 1):
        if not raw.strip():
            raise SystemExit(f"{rel}: linha em branco {numero}")
        registro = json.loads(raw)
        intent = registro.get("intent_id") or ""
        trocas = por_intent.get(intent)
        if not trocas:
            continue

        wc_antes = word_count(registro)
        digest_antes = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()

        nova = raw
        for antiga, corrigida in trocas:
            ocorrencias = nova.count(antiga)
            if ocorrencias != 1:
                raise SystemExit(
                    f"{rel}:{numero} ({intent}): substring esperada 1x, "
                    f"encontrada {ocorrencias}x — {antiga[:80]!r}")
            nova = nova.replace(antiga, corrigida, 1)

        registro_novo = json.loads(nova)
        if registro_novo.get("intent_id") != intent:
            raise SystemExit(f"{rel}:{numero}: intent_id mudou — abortado")
        wc_depois = word_count(registro_novo)
        if wc_depois != wc_antes:
            raise SystemExit(
                f"{rel}:{numero} ({intent}): a correção mudou a contagem de "
                f"palavras ({wc_antes} -> {wc_depois}) — tocou corpo além do "
                f"previsto. Abortado.")

        # CAS: relê a linha viva do disco agora e compara com o hash lido no
        # início desta função (protege contra escrita concorrente).
        atual = hashlib.sha256(
            shard.read_bytes().decode("utf-8").split("\n")[numero - 1]
            .strip().encode("utf-8")).hexdigest()
        if atual != digest_antes:
            raise SystemExit(
                f"CAS DE LINHA FALHOU em {rel}:{numero} ({intent}): outra "
                f"frente tocou este registro durante a execução.")

        # Também aplica verified_at/http_status atualizados na fonte tocada
        # (a substring da URL já trocou o endereço; agora atualiza a data de
        # verificação e o status dentro do MESMO objeto de fonte).
        nova = _atualizar_verificacao(nova, URL_NOVA)
        esperado = _reaplicar_verificacao(json.loads(nova))
        if json.loads(nova) != esperado:
            raise SystemExit(
                f"{rel}:{numero} ({intent}): verified_at/http_status da fonte "
                f"nova não reproduzem o esperado após a atualização")

        linhas[numero - 1] = nova
        tocadas += 1
        evidencia.append({
            "intent_id": intent, "shard": rel,
            "trocas": len(trocas),
            "norma_antiga": "Resolucao BCB 96/2021",
            "norma_nova": "Resolucao BCB 103/2021",
            "url_nova": URL_NOVA,
        })

    if tocadas and not dry_run:
        preservar(shard)
        payload = "\n".join(linhas) + ("\n" if fim_com_newline else "")
        atomic_write(shard, payload.encode("utf-8"))
    return tocadas


def _fatia_da_fonte(linha: str, token_url: str) -> tuple[int, int]:
    posicao = linha.find(token_url)
    if posicao < 0:
        raise SystemExit(f"token {token_url} ausente na linha")
    inicio = linha.rfind("{", 0, posicao)
    if inicio < 0:
        raise SystemExit("objeto de fonte não delimitado")
    profundidade = 0
    dentro_de_texto = False
    escapado = False
    for i in range(inicio, len(linha)):
        caractere = linha[i]
        if dentro_de_texto:
            if escapado:
                escapado = False
            elif caractere == "\\":
                escapado = True
            elif caractere == '"':
                dentro_de_texto = False
            continue
        if caractere == '"':
            dentro_de_texto = True
        elif caractere == "{":
            profundidade += 1
        elif caractere == "}":
            profundidade -= 1
            if profundidade == 0:
                return inicio, i + 1
    raise SystemExit("objeto de fonte sem fechamento")


def _atualizar_verificacao(linha: str, url_nova: str) -> str:
    token = json.dumps(url_nova, ensure_ascii=False)
    if token not in linha:
        return linha
    inicio, fim = _fatia_da_fonte(linha, token)
    fatia = linha[inicio:fim]
    fatia = CHAVE_VERIFICADO.sub(lambda m: m.group(1) + '"%s"' % HOJE, fatia, count=1)
    fatia = CHAVE_STATUS.sub(lambda m: m.group(1) + "200", fatia, count=1)
    return linha[:inicio] + fatia + linha[fim:]


def _reaplicar_verificacao(registro: dict) -> dict:
    for fonte in registro.get("official_sources") or []:
        if fonte.get("url") == URL_NOVA:
            fonte["verified_at"] = HOJE
            fonte["http_status"] = 200
    return registro


