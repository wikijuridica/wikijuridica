#!/usr/bin/env python3
"""generate-catalog-freetext-quarantine — expulsa chave texto-livre do catálogo SEM perder o valor.

O DEFEITO (medido 2026-07-29 09:33): generate-planalto-source-hints resolveu
hints coletados dos portfolios e gravou as entradas sob a CHAVE ORIGINAL —
inclusive 1.890 chaves texto-livre ("CC Lei 10.406/2002 art. 1.147") que
reprovam producer._SOURCE_HINT_ID. Consequência: TODA chamada de
derive/verify_writing_source_resolution morre com "catálogo contém source_hint
inválido" — paralisia global de fila, preflight e escrita.

O QUE FAZ: move (nunca deleta) cada entrada de chave não-slug do catálogo para
data/research/source_hint_curation/planalto_freetext_resolved_<data>.jsonl —
as URLs foram verificadas por HEAD 200 e são trabalho real; elas voltam ao
catálogo sob chave canônica quando o normalizador de portfolio (lane2) mapear
o texto-livre para slug. O catálogo volta ao schema fechado.

ESCRITA: CAS por preimagem (mesmo contrato de generate-curated-source-hints).
Relatório em data/ops/. Idempotente: sem chave não-slug, não escreve nada.

Uso:
  tools/generate-catalog-freetext-quarantine --dry-run
  tools/generate-catalog-freetext-quarantine --apply
"""
import argparse
import datetime
import hashlib
import json
import os
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)
from tools import generate_v2_review_queue as producer  # noqa: E402

CATALOG = os.path.join(ROOT, "data/editorial/v2_source_hint_catalog.json")
QUARANTINE_DIR = os.path.join(ROOT, "data/research/source_hint_curation")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if args.apply == bool(args.dry_run):
        parser.error("use exatamente um de --apply / --dry-run")

    with open(CATALOG, "rb") as handle:
        catalog_bytes = handle.read()
    preimage = hashlib.sha256(catalog_bytes).hexdigest()
    catalog = json.loads(catalog_bytes)
    hints = catalog["source_hints"]

    freetext = {
        key: value for key, value in hints.items()
        if not isinstance(key, str) or
        producer._SOURCE_HINT_ID.fullmatch(key) is None}
    print(f"entradas={len(hints)} chaves_texto_livre={len(freetext)}")
    if not freetext:
        print("catalogo ja esta com schema fechado — nada a fazer")
        return 0

    hoje = datetime.date.today().strftime("%Y%m%d")
    out_path = os.path.join(
        QUARANTINE_DIR, f"planalto_freetext_resolved_{hoje}.jsonl")
    if not args.apply:
        print(f"dry-run: moveria {len(freetext)} entradas para "
              f"{os.path.relpath(out_path, ROOT)}")
        return 0

    os.makedirs(QUARANTINE_DIR, exist_ok=True)
    # Append-safe: execucoes repetidas no mesmo dia acumulam sem sobrescrever;
    # o consumidor (lane2/curadoria) dedupe por freetext_key.
    with open(out_path, "a", encoding="utf-8") as handle:
        for key in sorted(freetext):
            row = dict(freetext[key])
            row["freetext_key"] = key
            row["quarantined_from"] = "v2_source_hint_catalog"
            handle.write(json.dumps(row, ensure_ascii=False, sort_keys=True))
            handle.write("\n")

    for key in freetext:
        del hints[key]

    with open(CATALOG, "rb") as handle:
        recheck = hashlib.sha256(handle.read()).hexdigest()
    if recheck != preimage:
        print("generate-catalog-freetext-quarantine: catalogo mudou durante a "
              "execucao — NADA foi gravado no catalogo (a quarentena em "
              "research e append-only e permanece valida). Re-rode.",
              file=sys.stderr)
        return 3
    fd, tmp = tempfile.mkstemp(
        dir=os.path.dirname(CATALOG), prefix=".freetext-q-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(catalog, handle, ensure_ascii=False, indent=2,
                      sort_keys=True)
            handle.write("\n")
        os.replace(tmp, CATALOG)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    print(f"catalogo: {len(hints) + len(freetext)} -> {len(hints)} entradas; "
          f"{len(freetext)} preservadas em {os.path.relpath(out_path, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
