#!/usr/bin/env python3
"""Inventaria o residuo do repositorio e o CLASSIFICA — nunca apaga sozinho.

POR QUE ESTE INVENTARIO EXISTE (2026-09-01)
-------------------------------------------
O dono viu o disco enchendo e perguntou se eram os builds acumulados. Fui medir:
`/opt/wiki` inteiro tem 42 GB de 527 GB usados (8%), e as 10.363 paginas de
`public/` ocupam 474 MB. O grosso do disco esta FORA daqui. Mas dentro daqui ha
~20 GB de residuo real, e o maior item isolado — `.agents/runtime/tmp_rescue`,
8,6 GB em 124.513 arquivos — nao e lixo obvio: e o RESGATE de /tmp que o contrato
deste repositorio manda fazer ("Produto nunca mora em /tmp — some no reboot").

A intencao do resgate esta certa. O que falta e a outra metade: DISTINGUIR
produto de regeneravel. Medido nos MANIFESTOs do proprio resgate, 134.610 linhas:

    portaljuridico-googlebot-smoke-cache   49.805 arquivos   1,22 GB
    portaljuridico-check-<n>               16.825            0,46 GB
    wiki-v2-index-gates.<sufixo>           13.049            0,26 GB  (inclui a
                                                     distribuicao do Go e gomodcache)
    temporario de teste Go (/tmp/Test*)     6.158            0,63 GB
    opt-wiki-*-venv (virtualenvs)           7.395            0,14 GB

Nada disso e trabalho pago pelo dono: e cache de smoke, workspace de gate,
virtualenv e temporario de teste — tudo recriado pelo proprio comando que o usa.
Resgatar isso nao preserva nada e custa gigabytes.

★ E POR QUE ESTA FERRAMENTA NAO APAGA. O contrato e explicito: "Pagina escrita
NUNCA e descartada" e "nada se apaga sem inspecao previa". Um resgate chamado
`tmp_rescue` pode conter texto redigido que custou tokens. Entao aqui se
CLASSIFICA e se MEDE; apagar e um segundo passo, deliberado, e so sobre o que
esta na classe REGENERAVEL — que e definida por regra de nome, nao por palpite.

READ-ONLY por construcao: este arquivo nao contem nenhuma chamada de remocao.
"""

from __future__ import annotations

import argparse
import collections
import json
import os
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent

# REGENERAVEL: recriado pelo proprio comando que o consome. A regra e por NOME de
# origem, nunca por extensao ou tamanho — nome e evidencia, tamanho e palpite.
REGENERAVEL = [
    (re.compile(r"^/tmp/Test[A-Za-z0-9_]+\d+/"), "temporario de teste Go"),
    (re.compile(r"^/tmp/go-build\d+/"), "cache de build Go"),
    (re.compile(r"^/tmp/portaljuridico-[a-z-]*smoke-cache"), "cache de smoke HTTP"),
    (re.compile(r"^/tmp/portaljuridico-check-\d+/"), "cache de gate"),
    (re.compile(r"^/tmp/wiki-v2-index-gates\."), "workspace de gate v2"),
    (re.compile(r"^/tmp/opt-wiki-[a-z-]+-venv/"), "virtualenv Python"),
    (re.compile(r"^/tmp/wiki-go-index-closure"), "workspace do pre-commit"),
    (re.compile(r"^/tmp/opt-wiki-go-cache/"), "cache de build Go"),
]

# PRESERVAR: pode ser produto pago pelo dono. Nunca entra em proposta de remocao.
PRESERVAR = [
    (re.compile(r"/scratchpad/"), "scratchpad de sessao (pode conter produto)"),
    (re.compile(r"\.(jsonl|md)$"), "dado ou documento (pode conter produto)"),
    (re.compile(r"/data/editorial/"), "estoque editorial"),
]

# FORA DE ESCOPO: pertence a outro projeto. Nao e nosso para apagar nem guardar.
FORA_DE_ESCOPO = re.compile(r"/claude-1000/-opt-(?!wiki)")


def classifica(origem: str) -> tuple[str, str]:
    if FORA_DE_ESCOPO.search(origem):
        return "FORA_DE_ESCOPO", "scratchpad de outro projeto"
    for regex, motivo in REGENERAVEL:
        if regex.search(origem):
            return "REGENERAVEL", motivo
    for regex, motivo in PRESERVAR:
        if regex.search(origem):
            return "PRESERVAR", motivo
    return "INDEFINIDO", "sem regra — exige inspecao humana"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="saida em JSON, para o gate consumir")
    ap.add_argument("--listar", default="", metavar="CLASSE",
                    help="lista os caminhos de uma classe (REGENERAVEL/PRESERVAR/INDEFINIDO)")
    args = ap.parse_args()

    resgate = RAIZ / ".agents/runtime/tmp_rescue"
    manifestos = sorted(resgate.glob("*/MANIFESTO.jsonl"))
    if not manifestos:
        print("inventario-residuo-repo: nenhum MANIFESTO em .agents/runtime/tmp_rescue")
        return 0

    contagem: dict[str, int] = collections.Counter()
    bytes_por: dict[str, int] = collections.Counter()
    motivos: dict[str, collections.Counter] = collections.defaultdict(collections.Counter)
    destinos: dict[str, list[str]] = collections.defaultdict(list)
    linhas = 0

    for manifesto in manifestos:
        for linha in manifesto.read_text(encoding="utf-8", errors="replace").splitlines():
            linha = linha.strip()
            if not linha:
                continue
            try:
                obj = json.loads(linha)
            except json.JSONDecodeError:
                continue
            linhas += 1
            classe, motivo = classifica(obj.get("origem", ""))
            contagem[classe] += 1
            bytes_por[classe] += int(obj.get("bytes", 0) or 0)
            motivos[classe][motivo] += 1
            if args.listar == classe and len(destinos[classe]) < 4000:
                destino = obj.get("destino")
                if destino:
                    destinos[classe].append(destino)

    if args.listar:
        for caminho in destinos.get(args.listar, []):
            print(caminho)
        return 0

    relatorio = {
        "schema_version": "inventario_residuo_repo_v1",
        "manifestos": len(manifestos),
        "linhas": linhas,
        "por_classe": {c: {"arquivos": contagem[c], "bytes": bytes_por[c],
                           "motivos": dict(motivos[c])} for c in contagem},
    }
    if args.json:
        print(json.dumps(relatorio, ensure_ascii=False, sort_keys=True))
        return 0

    print(f"inventario de residuo — {linhas} linhas em {len(manifestos)} manifesto(s)")
    ordem = ["REGENERAVEL", "FORA_DE_ESCOPO", "INDEFINIDO", "PRESERVAR"]
    for classe in ordem:
        if classe not in contagem:
            continue
        print(f"\n  {classe}: {contagem[classe]} arquivo(s), {bytes_por[classe] / 1e9:.2f} GB")
        for motivo, quantas in motivos[classe].most_common(8):
            print(f"      {quantas:7d}  {motivo}")

    regeneravel = bytes_por.get("REGENERAVEL", 0)
    print(f"\n  Seguro remover pela regra de nome: {regeneravel / 1e9:.2f} GB")
    print("  PRESERVAR e INDEFINIDO NAO entram em proposta de remocao — o contrato")
    print("  proibe descartar trabalho, e INDEFINIDO significa que falta regra, nao")
    print("  que o arquivo e descartavel. Para ver os caminhos de uma classe:")
    print("      tools/inventario-residuo-repo --listar REGENERAVEL")
    return 0


if __name__ == "__main__":
    sys.exit(main())
