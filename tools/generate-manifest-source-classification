#!/bin/sh
# Preenche source_type e use_in_content por FONTE no published_manifest, por
# derivação auditável (internal/sourceprovenanceclass) — nunca por constante.
# Sem argumento é ENSAIO: mede e imprime a distribuição sem tocar no disco.
# Use --gravar para regravar o manifesto (cópia datada em .agents/runtime antes).
#
# 2026-08-29: passa a rodar SUPERVISIONADO. Este wrapper nasceu em cafae171
# (2026-08-29) ja invocando o toolchain direto, forma que passa ao largo de
# budget, stop_condition, cache e artifact_claim — e ele reescreve
# data/editorial/published_manifest.jsonl
# (cmd/generate-manifest-source-classification/main.go:50), o artefato que
# publishedmanifest.Validate exige no boot do servidor. O claim e EXPLICITO
# porque o stem "manifest_source_classification" nao resolve nenhum candidato
# material em data/* (medido: 0 candidatos), e run-generate-supervised recusa
# wrapper sem claim.
# Custo medido em 2026-08-29: 2,023 s no ensaio (carrega o acervo inteiro),
# folgado no budget default de 120 s do supervisor.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/editorial/published_manifest.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-manifest-source-classification}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate-manifest-source-classification "$@"
