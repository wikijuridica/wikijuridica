def confere_ordem():
    """Recusa rodar se PASSOS divergir da ordem canônica.

    Defesa em profundidade: a guarda que vale é `internal/deployordem`, que
    compara as duas listas deste arquivo com a terceira cópia, no Go. Aqui a
    conferência serve para que uma inversão jamais chegue a EXECUTAR.
    """
    declarada = tuple(p.ident for p in PASSOS)
    if declarada != ORDEM_CANONICA:
        raise Falha("a ordem dos passos foi alterada: %s. A ordem do contrato é %s — "
                    "purgar a borda antes de invalidar e aquecer a origem repopula o Tiered "
                    "Cache com o conteúdo VELHO."
                    % (" -> ".join(declarada), " -> ".join(ORDEM_CANONICA)))



def _remove_lock_de_deploy(caminho):
    """Remove o lock sem deixar a falha da remocao derrubar o deploy.

    O lock existe para CALAR o vigia; nao conseguir apaga-lo mantem o vigia
    calado ate os 30 min de carencia que ele mesmo aplica, o que e degradacao
    aceitavel. Derrubar um deploy bem-sucedido por causa disso, nao.
    """
    try:
        os.remove(caminho)
    except FileNotFoundError:
        pass
    except OSError as erro:
        print("deploy-binario-go: nao removi %s: %s (o vigia o ignora apos 30 min)"
              % (caminho, erro), file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--seco", action="store_true",
                    help="mostra o plano inteiro sem compilar, trocar, reiniciar ou purgar")
    ap.add_argument("--sem-build", action="store_true",
                    help="usa bin/wikijuridica-server.next já compilado")
    ap.add_argument("--rota", action="append", default=[],
                    help="restringe as rotas de origem/borda (repetível); sem isto, derivam do acervo")
    ap.add_argument("--json", action="store_true", help="resumo em JSON no fim")
    args = ap.parse_args()

    os.chdir(RAIZ)
    try:
        confere_ordem()
    except Falha as erro:
        print("deploy-binario-go ABORTADO: %s" % erro, file=sys.stderr)
        return 2

    # O LOCK DE DEPLOY, e ele faltava aqui — assimetria medida em 2026-09-05.
    #
    # Tres instrumentos LEEM data/ops/.deploy-em-curso.lock para calar durante um
    # deploy — tools/check-portal-health, tools/check-http-smoke e
    # internal/checks/http_smoke_redesocial.go — e ate hoje um SO o escrevia:
    # tools/deploy-publico. Consequencia: todo deploy de binario que caisse na
    # janela de um timer de vigia mandava alarme ao dono dizendo que o portal
    # caiu, quando o que houve foi a troca que este proprio script conduz.
    # Alarme falso e pior que alarme nenhum: ensina o operador a ignorar o
    # alarme verdadeiro.
    #
    # O trap equivalente e o try/finally la embaixo; o vigia ignora o lock
    # depois de 30 min, para que um deploy interrompido nao desligue a
    # vigilancia para sempre.
    lock_de_deploy = os.path.join(RAIZ, "data", "ops", ".deploy-em-curso.lock")
    if not args.seco:
        os.makedirs(os.path.dirname(lock_de_deploy), exist_ok=True)
        with open(lock_de_deploy, "w"):
            pass
        # atexit e nao try/finally: o main tem cinco pontos de retorno e pode
        # sair por excecao. O equivalente em deploy-publico e o `trap ... EXIT
        # INT TERM`, e a cobertura tem de ser a mesma -- lock que sobrevive a um
        # caminho de saida desliga o vigia ate os 30 min de carencia.
        atexit.register(_remove_lock_de_deploy, lock_de_deploy)

    ctx = Contexto(args)
    ctx.rotas = rotas_dinamicas(args)
    if not ctx.rotas:
        print("deploy-binario-go ABORTADO: nenhuma rota dinâmica derivada do acervo. "
              "Sem elas os passos 6-8 não têm alvo e o deploy deixaria origem e borda "
              "servindo a render anterior.", file=sys.stderr)
        return 2

    print("deploy-binario-go %s%s" % (ctx.carimbo, "  [SECO — nada será alterado]" if ctx.seco else ""))
    print("rotas dinâmicas derivadas do acervo: %d%s"
          % (len(ctx.rotas), " (restritas por --rota)" if ctx.rotas_restritas else ""))
    for amostra in ctx.rotas[:3]:
        print("  ex.: %s" % amostra)

    inicio = time.monotonic()
    for passo in PASSOS:
        print("\n%s — %s" % (passo.ident, passo.titulo))
        print("  porquê: %s" % passo.motivo)
        try:
            passo.executar(ctx, passo)
        except Falha as erro:
            print("\nABORTADO no passo %s: %s" % (passo.ident, erro), file=sys.stderr)
            registra(ctx, "abortado", passo.ident, time.monotonic() - inicio)
            return 1
    duracao = time.monotonic() - inicio
    registra(ctx, "concluido", "", duracao)

    # A FRASE FINAL NÃO PODE MENTIR NO ENSAIO. Em modo seco nada foi invalidado,
    # aquecido nem purgado; anunciar o contrário é o tipo de saída que faz alguém
    # acreditar num deploy que não aconteceu.
    if ctx.seco:
        print("\nplano conferido em %.1fs — NADA foi alterado. Em execução real seriam %d rota(s) "
              "invalidadas na origem, aquecidas e então purgadas na borda, nesta ordem."
              % (duracao, len(ctx.rotas)))
    else:
        print("\nconcluído em %.1fs — %d rota(s) invalidadas na origem, aquecidas e purgadas na borda"
              % (duracao, len(ctx.rotas)))
    if args.json:
        print(json.dumps({
            "schema_version": "deploy_binario_go_v1",
            "seco": ctx.seco,
            "carimbo": ctx.carimbo,
            "rotas": len(ctx.rotas),
            "ordem": list(ORDEM_CANONICA),
            "passos": ctx.registros,
            "duracao_s": round(duracao, 1),
        }, ensure_ascii=False, indent=2))
    return 0


def registra(ctx, desfecho, passo_que_abortou, duracao):
    """Evidência do que ESTA execução fez. Em --seco não se grava nada: ledger
    de deploy que registra ensaio como deploy é dado falso."""
    if ctx.seco:
        return
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "schema_version": "deploy_binario_go_v1",
            "executado_em": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "desfecho": desfecho,
            "passo_que_abortou": passo_que_abortou,
            "ordem": list(ORDEM_CANONICA),
            "rotas": len(ctx.rotas),
            "rotas_restritas": ctx.rotas_restritas,
            "passos": ctx.registros,
            "duracao_s": round(duracao, 1),
        }, ensure_ascii=False, sort_keys=True) + "\n")


if __name__ == "__main__":
    sys.exit(main())
