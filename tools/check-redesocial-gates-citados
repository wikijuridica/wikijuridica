#!/usr/bin/env bash
# check-redesocial-gates-citados — executa os gates que as entregas ENTREGUES citam.
#
# POR QUE ELE EXISTE. A condicao de encerramento do goal da rede social tem tres
# clausulas, e a terceira e "todo gate citado por entrega `entregue` executado e
# VERDE". O guardiao (internal/redesocialcompletude) confere que o gate EXISTE --
# nome em checks.Names e `case` no dispatcher, por leitura de texto --, nunca que
# ele PASSA. E a diferenca entre "o instrumento existe" e "o instrumento aprova",
# e a melhoria 5 da §7 do plano de execucao previa fecha-la na onda 8.
#
# Ate 2026-09-06 essa clausula NAO TINHA EXECUTOR: eu a rodei a mao, num script
# de scratchpad que some com a sessao, e o placar (18 verdes, 4 vermelhos naquele
# dia) existia so no relatorio. Este arquivo e aquele script com endereco fixo --
# ele NAO muda regua nenhuma, so torna reproduzivel o que ja era feito a mao.
#
# O QUE ELE NAO FAZ, e e' deliberado: nao entra no pre-commit nem na suite
# diaria. Rodar 22 gates leva minutos e alguns sao pesados; gate caro que roda a
# cada commit e gate que alguem desliga. Rode-o ao declarar pronto, junto de
# check-redesocial-entrega-final.
#
# Saida: uma linha por gate, VERDE ou VERMELHO com as primeiras linhas do motivo,
# e o placar no fim. Sai 1 se algum estiver vermelho.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# A carga vem antes: 22 gates em serie competem com build e deploy de outra
# frente, e derrubar o host no meio custa mais que esperar.
if [ -x "$ROOT/tools/check-load-headroom" ]; then
	"$ROOT/tools/check-load-headroom" --max 12 || {
		echo "check-redesocial-gates-citados: carga alta demais; rode quando o host estiver folgado" >&2
		exit 2
	}
fi

MANIFESTO="$ROOT/content/redesocial_entregas.json"
[ -f "$MANIFESTO" ] || {
	echo "manifesto ausente: $MANIFESTO" >&2
	exit 2
}

# Os gates saem do MANIFESTO, nunca de uma lista escrita a mao: lista paralela
# diverge da fonte em uma semana, e foi por isso que a tasklist do goal e
# derivada em vez de redigida.
mapfile -t GATES < <(
	python3 - "$MANIFESTO" <<'PY'
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
vistos = []
for e in m["entregas"]:
    if e.get("estado") != "entregue":
        continue
    for g in (e.get("prova") or {}).get("gates") or []:
        if g not in vistos:
            vistos.append(g)
print("\n".join(sorted(vistos)))
PY
)

[ "${#GATES[@]}" -gt 0 ] || {
	echo "nenhum gate citado por entrega entregue: o manifesto mudou de forma?" >&2
	exit 2
}

verdes=0
vermelhos=0
nomes_vermelhos=()

for gate in "${GATES[@]}"; do
	if saida="$(timeout 600 "$ROOT/tools/run-check" "$gate" 2>&1)"; then
		printf 'VERDE     %s\n' "$gate"
		verdes=$((verdes + 1))
	else
		rc=$?
		printf 'VERMELHO  %s (rc=%s)\n' "$gate" "$rc"
		# O LIMITE VAI DENTRO DO awk, NUNCA num `head` no fim do cano. Com
		# `set -o pipefail`, `head -N` fecha o pipe cedo, o produtor morre de
		# SIGPIPE e o script inteiro aborta com rc=141 -- e a saida some sem
		# explicacao. Este script nasceu com esse defeito e a primeira execucao
		# real o revelou: ele parou no primeiro gate vermelho e nao mediu os
		# outros 21. E' o mesmo defeito que check-ancora-redesocial teve.
		printf '%s\n' "$saida" | tr '|' '\n' | awk 'NR<=4 { sub(/^ +/, ""); print "            " $0 }'
		vermelhos=$((vermelhos + 1))
		nomes_vermelhos+=("$gate")
	fi
done

echo
echo "placar: ${verdes} verde(s), ${vermelhos} vermelho(s) de ${#GATES[@]} gate(s) citados por entrega entregue"

if [ "$vermelhos" -gt 0 ]; then
	echo "vermelhos: ${nomes_vermelhos[*]}"
	echo
	echo "A terceira clausula da condicao de encerramento do goal exige TODOS verdes."
	echo "Gate vermelho aqui e' de uma destas naturezas, e a distincao decide o que fazer:"
	echo "  - fato do mundo (o gate mede algo que ainda nao aconteceu): nada a codificar;"
	echo "  - divida registrada em baseline: decisao de politica, nao de execucao;"
	echo "  - defeito: corrija a CAUSA, jamais o gate."
	exit 1
fi
