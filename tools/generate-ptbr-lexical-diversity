#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_LEXICAL_RICHNESS_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/lexicalrichness-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-lexicalrichness-venv"
if [[ -n "${WIKI_LEXICAL_RICHNESS_VENV:-}" ]]; then
	VENV="$WIKI_LEXICAL_RICHNESS_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-lexicalrichness.txt" | awk '{print $1}')"

emit_artifact_claim() {
	local path="$1"
	local output="$2"
	printf 'generate-ptbr-lexical-diversity: artifact_claim path=%s producer=tools/generate-ptbr-lexical-diversity input_fingerprint=sha256:%s output_fingerprint_expected=%s lock_scope=artifact:%s budget_ms=300000 stop_condition=lexicalrichness_python_environment_ready\n' \
		"$path" "$REQ_HASH" "$output" "$path"
}

# A preparacao do ambiente Python acontece ANTES de run-heavy-throttled, ou seja,
# fora do WIKI_HEAVY_TIMEOUT_SECONDS. Em sandbox frio/offline, `python3 -m venv` e
# `pip install` ficariam pendurados sem prazo. Prazo explicito + mensagem
# acionavel fazem o primeiro uso falhar rapido e orientado.
SETUP_TIMEOUT_SECONDS="${WIKI_LEXICAL_RICHNESS_SETUP_TIMEOUT_SECONDS:-300}"

run_setup_step() {
	local step="$1"
	shift
	local status=0
	timeout "$SETUP_TIMEOUT_SECONDS" "$@" || status=$?
	if [[ "$status" -eq 0 ]]; then
		return 0
	fi
	if [[ "$status" -eq 124 ]]; then
		printf 'generate-ptbr-lexical-diversity: %s excedeu %ss — provavelmente ambiente frio/sem rede para o indice de pacotes. Materialize o venv uma vez e reaproveite com WIKI_LEXICAL_RICHNESS_VENV=<caminho> (python3 -m venv <caminho> && <caminho>/bin/python -m pip install -r tools/requirements-lexicalrichness.txt), ou eleve WIKI_LEXICAL_RICHNESS_SETUP_TIMEOUT_SECONDS se a rede so estiver lenta.\n' "$step" "$SETUP_TIMEOUT_SECONDS" >&2
	else
		printf 'generate-ptbr-lexical-diversity: %s falhou (status=%s). Confirme python3 -m venv e o acesso ao indice de pacotes, ou aponte WIKI_LEXICAL_RICHNESS_VENV para um venv ja materializado com tools/requirements-lexicalrichness.txt.\n' "$step" "$status" >&2
	fi
	exit "$status"
}

if [[ ! -x "$PY" ]]; then
	emit_artifact_claim "$VENV" "created_or_reused:$VENV"
	run_setup_step "criacao do venv" python3 -m venv "$VENV"
fi
MARKER="$VENV/.requirements-lexicalrichness-$REQ_HASH.ok"
if [[ ! -f "$MARKER" ]]; then
	emit_artifact_claim "$MARKER" "sha256:$REQ_HASH"
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 run_setup_step "pip install -r tools/requirements-lexicalrichness.txt" "$PY" -m pip install --disable-pip-version-check --prefer-binary -r "$ROOT/tools/requirements-lexicalrichness.txt" >/dev/null
	rm -f "$VENV"/.requirements-lexicalrichness-*.ok
	touch "$MARKER"
fi
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:ptbr-lexical-diversity:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=80}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_ptbr_lexical_diversity_evidence}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/ptbr_lexical_diversity_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-ptbr-lexical-diversity}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/ptbr_lexical_diversity_evidence.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-180}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
WIKI_LEXICAL_RICHNESS_PYTHON="$PY" exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-ptbr-lexical-diversity --timings "$@"
