#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"

# AQUI EXISTIU UMA GUARDA DE JANELA 00-03Z, E ELA SAIU PORQUE A CAUSA MORREU
# (2026-08-30, DEC-040). O texto dela era exato: "o recibo grava
# validation_as_of em UTC enquanto o estoque data legal_as_of em BRT (UTC-3),
# entao um ingest rodado de madrugada nasce com data de amanha e e recusado
# pelos gates do dia — recibo natimorto". O que ela nao dizia e que a mesma
# divergencia derrubava tambem os recibos JA existentes: as 21:00 BRT o dia UTC
# virava e `check-v2-stock-epoch` passava a acusar
# `v2_stock_freshness_validation_as_of_stale` num ingest de sete horas antes.
# Eram 180 minutos por dia sem publicacao possivel, medidos por
# internal/v2ingest.TestNenhumMinutoDoDiaTemCalendarioDivergente.
#
# `NormalizeValidationAsOf` passou a truncar no dia civil brasileiro, os dois
# calendarios do recibo viram juntos a meia-noite de Brasilia, e a faixa deixou
# de existir. Manter a guarda depois disso seria manter uma trava sem defeito
# atras dela — e um `exit 2` que ninguem consegue explicar e a pior especie de
# bloqueio. A variavel WIKI_INGEST_ALLOW_UTC_NIGHT_WINDOW deixou de ter efeito.

exec run-go-cmd-cached ./cmd/ingest-v2-stock --timings "$@"
