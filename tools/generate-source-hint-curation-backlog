#!/usr/bin/env python3
"""generate-source-hint-curation-backlog — o que falta ao catálogo de fontes, com o custo de cada lacuna.

O QUE ISTO RESOLVE, medido em 2026-09-05: `ops/relaunch-writing.sh` classifica
**359 lotes** de escrita como bloqueados, todos com o mesmo motivo — *"intent
declara pesquisa concluída sem resolução exata"*. A mensagem nomeia o intent,
não o que falta. Para saber o que falta era preciso cruzar três artefatos à mão,
e é o tipo de investigação que cada sessão refazia do zero.

O BLOQUEIO NÃO É REDAÇÃO E NÃO É GATE QUEBRADO: é PROVENIÊNCIA. O intent diz que
a pesquisa acabou, mas o `source_hint` que ele cita não tem resolução exata no
`v2_source_hint_catalog.json` — e sem URL oficial, data e hash não se escreve
linha nenhuma (R9, e a regra de ouro da publicação).

E A AUTOMAÇÃO DISPONÍVEL JÁ ESTÁ ESGOTADA, o que foi medido antes de escrever
esta ferramenta e é a razão de ela existir:

  - `generate_source_hint_catalog_normas_legbr.py` (API pública LexML/Senado)
    em dry-run: `pending_before_run=0 unresolved_hints=0 already_in_catalog=1336`.
    Ele resolve norma federal por slug canônico, e **nenhum** dos hints ausentes
    tem essa forma.
  - Normalização de alias contra o catálogo atual (tirando a espécie e a
    pontuação) resolve **2 de 361**.

Sobram 359 que exigem CURADORIA — julgamento sobre qual é a fonte oficial de
"anatel", de "Código de Ética Médica (Res. CFM 2.217/2018)" ou de uma tese de
tribunal. Isso não se automatiza sem inventar proveniência, que é o que o
contrato proíbe.

O QUE ESTA FERRAMENTA ENTREGA: o backlog ordenado por DANO — quantos intents e
quais lotes cada hint ausente bloqueia —, com a classe de cada um, para a
curadoria ser sistemática em vez de hint a hint. Os 20 primeiros liberam mais
lotes que os 200 últimos.

Uso:
    tools/generate-source-hint-curation-backlog            # grava o backlog
    tools/generate-source-hint-curation-backlog --listar   # imprime o resumo, não grava
"""
from __future__ import annotations

import argparse
import collections
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
CATALOGO = RAIZ / "data/editorial/v2_source_hint_catalog.json"
PORTFOLIO = RAIZ / "data/editorial/portfolio_v2"
SAIDA = RAIZ / "data/ops/source_hint_curation_backlog.jsonl"

# O manifesto de defeitos é emitido por ops/relaunch-writing.sh, que é a
# AUTORIDADE sobre slice e pins. Ler o veredito dele em vez de reclassificar por
# conta própria é o que impede esta ferramenta de discordar da fila real.
DEFEITOS = RAIZ / "data/ops/relaunch_writing_defects_20260830.jsonl"

SEM_RESOLUCAO = re.compile(r"resolu[cç][aã]o exata: ([a-z0-9-]+)")
NORMA_FEDERAL = re.compile(r"^(lei|lc|dec|decreto|mp|ec)-\d{2,6}-(19|20)\d{2}", re.I)
TRIBUNAL = re.compile(r"^(stf|stj|tst|tse|stm|trf\d?)-", re.I)
AGENCIA = re.compile(
    r"^(anatel|anac|ans|aneel|anvisa|bcb|cvm|cfm|cnj|cade|inpi|pgfn|receita)", re.I)


def normaliza(hint: str) -> str:
    """Chave de comparação frouxa: sem espécie e sem pontuação.

    `Lei 8.245/1991 art. 43 II` e `lei-8-245-1991-art-43-ii` colidem aqui de
    propósito — é assim que se descobre alias que o catálogo já tem sob outro
    nome. Resolveu 2 dos 361 na medição de 2026-09-05: pouco, e por isso a
    conclusão é curadoria, não normalizador.
    """
    sem_especie = re.sub(r"\b(lei|lc|decreto|dec)\b[-_]?", "", hint.lower())
    return re.sub(r"[^a-z0-9]+", "", sem_especie)


def classifica(hint: str, alias: str | None) -> str:
    if alias:
        return "alias_no_catalogo"
    if NORMA_FEDERAL.match(hint):
        return "norma_federal_canonica"
    if TRIBUNAL.match(hint):
        return "tese_ou_sumula_de_tribunal"
    if AGENCIA.match(hint) or "." in hint:
        return "agencia_reguladora_ou_host"
    if re.search(r"\d{3,}", hint):
        return "norma_forma_nao_canonica"
    return "texto_livre_curadoria"


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--listar", action="store_true", help="imprime o resumo sem gravar")
    args = p.parse_args()

    for caminho in (CATALOGO, DEFEITOS):
        if not caminho.is_file():
            print("generate-source-hint-curation-backlog: NAO RODOU: %s ausente" % caminho,
                  file=sys.stderr)
            return 2

    catalogo = json.loads(CATALOGO.read_text(encoding="utf-8"))["source_hints"]
    indice = collections.defaultdict(list)
    for chave in catalogo:
        indice[normaliza(chave)].append(chave)

    lote_do_intent: dict[str, str] = {}
    for linha in DEFEITOS.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        achado = SEM_RESOLUCAO.search(registro.get("detalhe", ""))
        if achado:
            lote_do_intent[achado.group(1)] = registro.get("lote", "")
    if not lote_do_intent:
        # Fila limpa é resultado legítimo, não falha: grava vazio e diz.
        print("generate-source-hint-curation-backlog: 0 intent(s) bloqueado(s) por fonte")
        if not args.listar:
            SAIDA.write_text("", encoding="utf-8")
        return 0

    por_hint: dict[str, dict] = collections.defaultdict(
        lambda: {"intents": set(), "lotes": set(), "areas": set()})
    for arquivo in sorted(PORTFOLIO.glob("*.jsonl")):
        for linha in arquivo.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            registro = json.loads(linha)
            intent = registro.get("intent_id")
            if intent not in lote_do_intent:
                continue
            for hint in registro.get("source_hints", []) or []:
                if hint in catalogo:
                    continue
                por_hint[hint]["intents"].add(intent)
                if lote_do_intent[intent]:
                    por_hint[hint]["lotes"].add(lote_do_intent[intent])
                por_hint[hint]["areas"].add(arquivo.stem)

    # ORDENADO POR DANO, não alfabeticamente: quem cura de cima para baixo
    # destrava mais lote por hora. Os 20 primeiros valem mais que os 200 últimos.
    registros = []
    for hint, dados in sorted(por_hint.items(),
                              key=lambda kv: (-len(kv[1]["intents"]), kv[0])):
        alias = (indice.get(normaliza(hint)) or [None])[0]
        registros.append({
            "source_hint": hint,
            "classe": classifica(hint, alias),
            "alias_candidato": alias,
            "intents_bloqueados": len(dados["intents"]),
            "lotes_bloqueados": sorted(dados["lotes"]),
            "areas": sorted(dados["areas"]),
            "intents_amostra": sorted(dados["intents"])[:5],
        })

    contagem = collections.Counter(r["classe"] for r in registros)
    print("generate-source-hint-curation-backlog: %d hint(s) ausente(s) do catalogo, "
          "bloqueando %d intent(s)" % (len(registros), len(lote_do_intent)))
    for classe, quantos in contagem.most_common():
        print("  %-30s %4d" % (classe, quantos))

    if args.listar:
        for r in registros[:20]:
            print("  %-40s %2d intent(s)  %s" % (
                r["source_hint"][:40], r["intents_bloqueados"], r["classe"]))
        return 0

    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    with SAIDA.open("w", encoding="utf-8") as saida:
        for registro in registros:
            saida.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")
    print("  gravado: %s" % SAIDA.relative_to(RAIZ))
    return 0


if __name__ == "__main__":
    sys.exit(main())
