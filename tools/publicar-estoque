TETO_TENTATIVAS_PADRAO = 3


class NaoMedido(Exception):
    """Falta de dado para medir. Nunca vira 'nada pendente'."""


def caminho(*partes: str) -> str:
    return os.path.join(RAIZ, *partes)


def produtores_do_gatilho(gatilho: str = "", todos: bool = False) -> list[dict]:
    """Linhas do registro. Ilegivel NAO vira mapa parcial."""
    seletor = ["--todos"] if todos else ["--gatilho", gatilho]
    saida = subprocess.run(
        [sys.executable, os.path.join(FERRAMENTAS, "listar-produtores-de-pagina"),
         *seletor, "--json", "--raiz", RAIZ],
        cwd=RAIZ, check=False, capture_output=True, text=True, timeout=120)
    if saida.returncode != 0:
        raise NaoMedido(
            f"listar-produtores-de-pagina --gatilho {gatilho} saiu {saida.returncode}: "
            f"{(saida.stderr or '').strip()}")
    try:
        produtores = json.loads(saida.stdout)
    except json.JSONDecodeError as erro:
        raise NaoMedido(f"saida de listar-produtores-de-pagina ilegivel: {erro}") from erro
    return produtores


def produtor_do_canal(produtores: list[dict], canal: str, gatilho: str) -> dict:
    for entrada in produtores:
        if entrada.get("canal") == canal:
            return entrada
    conhecidos = ", ".join(sorted(str(e.get("canal")) for e in produtores)) or "(nenhum)"
    raise NaoMedido(
        f"canal {canal!r} nao existe no gatilho {gatilho!r} de {REGISTRO}. "
        f"Canais deste gatilho: {conhecidos}")


def shards_do_canal(produtor: dict) -> list[str]:
    """O shard declarado E os irmaos da rotacao (-01, -02, ...).

    A REGRA E' A MESMA de `alvos_do_registro` em `tools/run-daily-content`
    (`${base%-[0-9][0-9].jsonl}` + glob `-[0-9][0-9].jsonl`): o registro declara
    o PRIMEIRO ordinal, e o gerador abre `-02` quando o `-01` enche. Medir so o
    ordinal declarado deixaria de ver o estoque a partir da primeira rotacao —
    e a pendencia sumiria sem ninguem ter publicado nada.
    """
    base = produtor["shard"]
    # `[0-9]{2}` E NAO `\d\d`: `\d` casa digito UNICODE (medido: `٠١` casa e
    # `int("٠١")` vale 1), e o glob `-[0-9][0-9].jsonl` de `alvos_do_registro`
    # nao casa. Duas reguas para o mesmo conjunto e' divergencia, e neste
    # repositorio divergencia se fecha por paridade.
    casado = re.search(r"-([0-9]{2})\.jsonl$", base)
    if not casado:
        raise NaoMedido(
            f"{REGISTRO}: shard {base!r} do canal {produtor.get('canal')!r} nao termina em "
            f"-NN.jsonl; a rotacao de shard nao teria como ser derivada")
    prefixo = os.path.basename(base[: casado.start()])
    relativo = os.path.dirname(base)
    diretorio = caminho(relativo)
    achados = []
    if os.path.isdir(diretorio):
        for nome in sorted(os.listdir(diretorio)):
            if re.fullmatch(re.escape(prefixo) + r"-[0-9]{2}\.jsonl", nome):
                achados.append(os.path.join(relativo, nome))
    return achados


def textos_de(valor) -> list[str]:
    """Toda string DECODIFICADA de um registro, em qualquer profundidade.

    ★ POR QUE NAO SE COMPARA CONTRA O JSON SERIALIZADO

    A pendencia de enriquecimento pergunta "esta prosa ja esta no estoque?" e a
    resposta tem de ser sobre o TEXTO, nao sobre a serializacao dele. Um
    comentario com aspas -- e prosa juridica cita ementa e tese entre aspas o
    tempo todo -- aparece como `\"` dentro do JSON e NUNCA casaria com a prosa
    crua do ledger do cerebro. A peca ficaria pendente para sempre, esgotaria o
    teto de tentativas e seria PARADA sem nunca ter tido defeito nenhum.

    Recursivo e nao por lista de campos (`opening`, `sections[*].text`, `faq`):
    o dia em que o gerador puser o comentario num campo novo, a medicao continua
    certa. Campo declarado a mao e' a lista que envelhece sozinha.
    """
    if isinstance(valor, str):
        return [valor]
    if isinstance(valor, dict):
        return [t for v in valor.values() for t in textos_de(v)]
    if isinstance(valor, list):
        return [t for v in valor for t in textos_de(v)]
    return []


def corpo_do_estoque(shards: list[str]) -> tuple[str, set[str]]:
    """Devolve (texto DECODIFICADO do estoque, conjunto de intent_id)."""
    pedacos: list[str] = []
    intents: set[str] = set()
    for rel in shards:
        absoluto = caminho(rel)
        if not os.path.exists(absoluto):
            continue
        with open(absoluto, encoding="utf-8") as arquivo:
            for numero, bruto in enumerate(arquivo, start=1):
                linha = bruto.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except json.JSONDecodeError as erro:
                    raise NaoMedido(f"{rel}:{numero}: JSON invalido ({erro})")
                identificador = (registro.get("intent_id") or "").strip()
                if identificador:
                    intents.add(identificador)
                pedacos.extend(textos_de(registro))
    return "\n".join(pedacos), intents


def intents_publicados() -> set[str]:
    absoluto = caminho(MANIFESTO)
    if not os.path.exists(absoluto):
        raise NaoMedido(f"{MANIFESTO} ausente: sem ele nao da para dizer o que ja esta no ar")
    publicados: set[str] = set()
    with open(absoluto, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            linha = bruto.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError as erro:
                raise NaoMedido(f"{MANIFESTO}:{numero}: JSON invalido ({erro})")
            # A chave e' `unique_intent_id`. `intent_id` NAO EXISTE aqui:
            # procura-lo devolve vazio e faz toda pagina publicada parecer
            # pendente (.claude/rules/manifesto-publicado.md).
            identificador = (registro.get("unique_intent_id") or "").strip()
            if identificador:
                publicados.add(identificador)
    return publicados


def comentarios_aprovados(canal: str) -> dict[str, str]:
    """link -> comentario APROVADO mais recente. Arquivo ausente = {} (o cerebro
    ainda nao redigiu nada; isso nao e' falha de medicao)."""
    rel = LEDGER_DE_TEXTO.get(canal)
    if rel is None:
        return {}
    absoluto = caminho(rel)
    if not os.path.exists(absoluto):
        return {}
    # LINHA MAIS NOVA VENCE — o arquivo e' append-only e a ultima ocorrencia de
    # um link e' a redacao mais recente, exatamente como o consumidor de
    # producao a le (cmd/generate-noticia-pages/comentario_do_cerebro.go).
    por_link: dict[str, str] = {}
    with open(absoluto, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            linha = bruto.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError as erro:
                raise NaoMedido(f"{rel}:{numero}: JSON invalido ({erro})")
            link = (registro.get("link") or "").strip()
            comentario = (registro.get("comentario") or "").strip()
            if not link:
                continue
            if registro.get("aprovada") is True and comentario:
                por_link[link] = comentario
            else:
                # Reprovada TAMBEM e' informacao: ela desfaz uma aprovacao
                # anterior do mesmo link, e tratar "sem comentario" como
                # pendencia eterna seria fila que nada drena.
                por_link.pop(link, None)
    return por_link


def pendencias(canal: str, produtor: dict) -> dict[str, list[dict]]:
    shards = shards_do_canal(produtor)
    estoque, intents = corpo_do_estoque(shards)
    publicados = intents_publicados()

    # ★ DUAS CAUSAS DIFERENTES ESTAVAM SOB UM ROTULO SO (2026-09-16, medido).
    #
    # Ate as 18:05 todo comentario aprovado fora do estoque era `enriquecimento`,
    # e a reconciliacao cobrava tentativa de todos. Medido sobre os 21
    # comentarios aprovados do dia: 13 entraram, e dos 8 restantes
    #
    #   4 tem PAGINA no estoque citando a noticia -> a pagina existe e o
    #     comentario nao foi embutido: defeito real do caminho de enriquecimento,
    #     acionavel, e cobrar tentativa e' correto (no teto vira pauta humana);
    #   4 NAO tem pagina nenhuma citando a noticia -> nao existe onde pousar. O
    #     gerador monta pagina por (orgao x dia) e recusa grupo com menos de 4
    #     itens: o proprio log diz "grupos abaixo de 4 itens: 81". Nenhuma
    #     retentativa cria essa pagina, e as tres pecas que chegaram a PARADO as
    #     18:02 estavam sendo culpadas por isso.
    #
    # O discriminador e' o ARTEFATO, e nao uma copia da regra do gerador: se o
    # link da noticia nao aparece em lugar nenhum do estoque, nao ha pagina que a
    # cite. Replicar `not-<orgao>-<AAAAMMDD>` aqui seria a terceira copia de uma
    # regra de produtor -- exatamente o defeito que este repositorio ja pagou.
    enriquecimento = []
    sem_pagina = []
    for link, comentario in sorted(comentarios_aprovados(canal).items()):
        # CONTENCAO LITERAL DO TEXTO GERADO, e nao heuristica: o gerador embute
        # o comentario inteiro no corpo da secao ("Sobre “<titulo>”: <comentario>"),
        # entao a prosa gerada ou esta no shard, byte a byte, ou nao esta.
        if comentario in estoque:
            continue
        if link in estoque:
            enriquecimento.append(
                {"tipo": "enriquecimento", "chave": link,
                 "detalhe": "a pagina que cita esta noticia ESTA no estoque e o comentario "
                            "aprovado do cerebro nao foi embutido nela"})
        else:
            sem_pagina.append(
                {"tipo": "sem_pagina", "chave": link,
                 "detalhe": "nenhuma pagina do estoque cita esta noticia: o gerador monta "
                            "pagina por (orgao x dia) e recusa grupo pequeno, entao nao existe "
                            "onde o comentario pousar e nenhuma retentativa cria a pagina"})
    rota_nova = [
        {"tipo": "rota_nova", "chave": identificador,
         "detalhe": "pagina montada no estoque e ainda ausente do published_manifest"}
        for identificador in sorted(intents - publicados)
    ]
    return {"enriquecimento": enriquecimento, "rota_nova": rota_nova,
            "sem_pagina": sem_pagina,
            "shards": shards, "intents_no_estoque": sorted(intents)}


def portfolios_aguardando_commit(produtores: list[dict]) -> list[str]:
    """Caminhos de portfolio, de TODOS os produtores do gatilho, com intencao
    NOVA ainda so na worktree.

    ★ POR QUE ESTA MEDICAO GOVERNA SE A CADEIA RODA (2026-09-16)

    Sob o contrato de poderes do dono a passada nao escreve historico, e o gate
    de pareamento le o portfolio do commit PAI por desenho declarado. Logo,
    intencao nova na worktree NAO VIRA PAGINA PUBLICADA nesta passada — ela
    espera o Claude Code commitar.

    Rodar a cadeia assim mesmo nao seria inofensivo: o gerador montaria MAIS um
    lote a cada volta do timer, e o estoque nao publicado cresceria sem teto
    enquanto nada vai ao ar. Por isso a presenca de intencao nao commitada e'
    BLOQUEIO de producao nova, e nao so um aviso.

    A medicao e' de tempo presente, e nao replay de ledger: no instante em que o
    commit acontece, `git diff` fica limpo e o bloqueio some sozinho — sem
    ninguem precisar apagar registro nenhum (e apagar registro e' vedado).

    ★ O CONJUNTO E' O DE TODOS OS PRODUTORES, DE TODOS OS GATILHOS

    Corrigido em 2026-09-16 por MEDICAO, e a primeira versao errava: ela olhava
    so o gatilho da passada. Rodando a cadeia de verdade, o gate 6/9 reprovou
    com "ORDEM DE COMMIT PENDENTE: 7539 intencao(oes) existem no disco mas NAO
    no commit pai" -- e as 7.539 eram de ACORDAOS, gatilho `publicador-cerebro`,
    enquanto a passada era de NOTICIAS, gatilho `onda-diaria`.

    A razao e' que `check-v2-portfolio-pairing` le o diretorio INTEIRO
    (`18688 intents ATIVOS em data/editorial/v2_pages` contra `11481 ja
    COMMITADOS`): ele nao conhece gatilho. Um instrumento com escopo menor que o
    do gate que ele antecipa manda a cadeia rodar para morrer no 6/9 -- e a
    reconciliacao cobraria tentativa da peca por um arquivo que nao e' dela.

    Dois instrumentos medindo conjuntos diferentes sobre o mesmo fato e'
    DIVERGENCIA, e neste repositorio divergencia se fecha por paridade de regua.

    `git diff`/`git ls-files` sao LEITURA: continuam funcionando sob o
    `ReadOnlyPaths=/opt/wiki/.git` da unit, que so barra escrita.
    """
    alvos = []
    for produtor in produtores:
        base = produtor["portfolio"]
        casado = re.search(r"-([0-9]{2})\.jsonl$", base)  # mesma regua do glob do bash
        if not casado:
            raise NaoMedido(
                f"{REGISTRO}: portfolio {base!r} do canal {produtor.get('canal')!r} nao termina "
                f"em -NN.jsonl")
        prefixo = os.path.basename(base[: casado.start()])
        relativo = os.path.dirname(base)
        diretorio = caminho(relativo)
        if os.path.isdir(diretorio):
            for nome in sorted(os.listdir(diretorio)):
                if re.fullmatch(re.escape(prefixo) + r"-[0-9]{2}\.jsonl", nome):
                    alvos.append(os.path.join(relativo, nome))
    alvos = sorted(set(alvos))
    if not alvos:
        return []
    # UMA leitura, e ela NAO escreve o indice — nem deixa de ver o ESTAGIADO.
    #
    # A versao anterior perguntava por `git diff --quiet` (worktree contra
    # indice) mais `git ls-files --others`. Esse par tem dois defeitos medidos:
    #
    # 1. `git diff` do worktree reescreve `.git/index` mesmo com
    #    GIT_OPTIONAL_LOCKS=0 (medido em git 2.39.5) — e o indice deste
    #    repositorio e' compartilhado com as outras sessoes.
    # 2. Portfolio que outra sessao ESTAGIOU e nao commitou fica invisivel aos
    #    dois comandos: `diff` compara worktree contra indice (iguais) e
    #    `ls-files --others` so ve o nao rastreado. Ou seja, exatamente o estado
    #    "aguardando commit" que esta funcao existe para ver. A passada seguia,
    #    e so o 6/9 — que le o diretorio inteiro — reprovava, em retomada.
    #
    # `git status --porcelain` sob GIT_OPTIONAL_LOCKS=0 nao escreve o indice
    # (medido) e enxerga os tres estados: ` M` worktree, `M `/`A ` estagiado,
    # `??` nao rastreado.
    ambiente = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    estado = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all", "--"] + alvos,
                            cwd=RAIZ, check=False, capture_output=True, text=True, env=ambiente)
    if estado.returncode != 0:
        raise NaoMedido(
            f"git status sobre o portfolio saiu {estado.returncode}: "
            f"{(estado.stderr or '').strip()}")
    if (estado.stdout or "").strip():
        return alvos
    return []


def passada_completou(rotulo: str) -> bool:
    """A ultima linha de `daily_content_runs.jsonl` para este rotulo diz
    `escopo: completa`?

    ★ TENTATIVA SO SE CONTA CONTRA PASSADA QUE CHEGOU AO FIM

    A cadeia pode terminar sem publicar por motivo que nada tem a ver com a peca
    -- quarentena por intencao nova, aborto de flag, flock ocupado. Se cada uma
    dessas voltas contasse uma tentativa, o comentario do cerebro chegaria ao
    teto e seria PARADO por culpa alheia, que e' o oposto do que o teto existe
    para fazer. O campo `escopo` nasceu nesta mesma data em
    `tools/run-daily-content` exatamente para permitir essa distincao.

    Linha ausente e' tratada como NAO completou: na duvida, nao se cobra da
    peca.
    """
    absoluto = caminho("data", "ops", "daily_content_runs.jsonl")
    if not os.path.exists(absoluto):
        return False
    ultima = None
    with open(absoluto, encoding="utf-8") as arquivo:
        for bruto in arquivo:
            linha = bruto.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                # Linha ilegivel aqui nao e' NaoMedido: este ledger e' de OUTRO
                # produtor e uma linha velha corrompida nao pode impedir a
                # reconciliacao. Ela so nao conta como "completou".
                continue
            if registro.get("rotulo") == rotulo:
                ultima = registro
    if not ultima:
        return False
    # ★ O CRITERIO E' `gerou`, E NAO "a cadeia chegou ao fim" (2026-09-16, 17:52).
    #
    # Medido: a cadeia parou na 4/9 por `derived-body-repetition` (1.425
    # ocorrencias, TODAS em shard de acordao, conteudo de outra frente) e mesmo
    # assim a etapa 2/9 tinha concluido -- `noticias ok gravado: ... (63
    # paginas)`. As pecas de noticia FORAM tentadas pelo proprio gerador delas e
    # nao entraram: a tentativa e' legitima.
    #
    # Cobrar por "chegou ao fim" seria errado nos DOIS sentidos: enquanto um gate
    # global parasse a cadeia, nenhuma peca chegaria ao teto (laco silencioso), e
    # a peca que o gerador tentou e nao entregou nunca seria parada para o
    # refino humano. Cobrar por `gerou` mede a chance que a peca teve.
    #
    # `escopo == completa` fica como FALLBACK para linha anterior a este campo:
    # ausencia nao apaga a contagem ja feita, e nao inventa contagem nova.
    if "gerou" in ultima:
        return bool(ultima.get("gerou"))
    return ultima.get("escopo") == "completa"


def veredito(*, parada: str, exit_da_cadeia: int, no_teto: int, em_quarentena: int,
             teto: int) -> tuple[int, str]:
    """A regua de saida da passada, isolada para poder ser MEDIDA (2026-09-16).

    A decisao vive aqui, e nao no fim do `main`, porque ela e' o que a unit le
    para decidir se acorda o dono — e o que nao se mede por chamada direta so se
    prova rodando a cadeia inteira, que ninguem roda numa bancada.

        no_teto > 0                  -> 1  peca desistiu; ha o que refinar
        cadeia parou em etapa        -> 1  o acervo esta bloqueado; e' investigacao
        exit da cadeia != 0          -> ele mesmo (>= 2 e' defeito de processo)
        em_quarentena > 0            -> 3  desfecho parcial PREVISTO; retoma sozinho
        nada disso                   -> 0

    A ordem importa: o teto vence a quarentena, porque uma peca que desistiu no
    meio de outras que ainda tentam continua sendo assunto do dono.
    """
    if no_teto > 0:
        return 1, (f"{no_teto} peca(s) no teto de {teto} tentativa(s) — o dono precisa "
                   f"decidir o refino")
    if parada:
        return 1, f"a cadeia PAROU em {parada} — nada publicado, e o acervo segue bloqueado"
    if exit_da_cadeia != 0:
        return exit_da_cadeia, f"a cadeia saiu {exit_da_cadeia} e o veredito dela vale"
    if em_quarentena > 0:
        return SAIDA_PARCIAL, (f"{em_quarentena} peca(s) em quarentena abaixo do teto de "
                               f"{teto} — desfecho parcial previsto, e o sistema retoma "
                               f"sozinho na proxima passada")
    return 0, "tudo o que estava pendente entrou"


def parada_da_cadeia(rotulo: str) -> str:
    """Onde a cadeia parou, se parou. Vazio quando ela chegou ao fim."""
    absoluto = caminho("data", "ops", "daily_content_runs.jsonl")
    if not os.path.exists(absoluto):
        return ""
    ultima = None
    with open(absoluto, encoding="utf-8") as arquivo:
        for bruto in arquivo:
            linha = bruto.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            if registro.get("rotulo") == rotulo:
                ultima = registro
    if not ultima or ultima.get("escopo") == "completa":
        return ""
    etapa = str(ultima.get("parou_em") or "").strip()
    falhas = ultima.get("falhas") or []
    rotulos = ", ".join(str(f) for f in falhas if f)
    if etapa and rotulos:
        return f"{etapa} ({rotulos})"
    return etapa or rotulos or str(ultima.get("escopo") or "")


def teto_de_tentativas() -> int:
    absoluto = caminho(CONFIG_CEREBRO)
    if not os.path.exists(absoluto):
        raise NaoMedido(f"{CONFIG_CEREBRO} ausente: publicacao autonoma sem teto declarado nao roda")
    with open(absoluto, encoding="utf-8") as arquivo:
        cfg = json.load(arquivo)
    teto = cfg.get("teto_de_tentativas_por_peca", TETO_TENTATIVAS_PADRAO)
    if not isinstance(teto, int) or teto <= 0:
        raise NaoMedido(
            f"{CONFIG_CEREBRO}: teto_de_tentativas_por_peca tem de ser inteiro positivo, "
            f"veio {teto!r} — e' o freio que impede uma peca que nunca entra no estoque de "
            f"disparar a cadeia inteira para sempre")
    return teto


def tentativas_anteriores(canal: str) -> dict[str, int]:
    """Replay do ledger append-only: chave -> quantas tentativas ja falharam.

    Nada e' apagado nem reescrito; o estado se deriva da leitura, que e' o unico
    desenho compativel com 'delecao de qualquer especie' vedada.
    """
    absoluto = caminho(LEDGER)
    contagem: dict[str, int] = {}
    if not os.path.exists(absoluto):
        return contagem
    with open(absoluto, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            linha = bruto.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError as erro:
                raise NaoMedido(f"{LEDGER}:{numero}: JSON invalido ({erro})")
            if registro.get("canal") != canal:
                continue
            for item in registro.get("nao_entrou", []) or []:
                chave = item.get("chave")
                if chave:
                    contagem[chave] = contagem.get(chave, 0) + 1
            for item in registro.get("entrou", []) or []:
                # Peca que entrou zera a contagem: tentativa que deu certo nao
                # pode deixar divida para a proxima vez que a mesma chave voltar.
                contagem.pop(item.get("chave"), None)
    return contagem


def avisa_dono(chave: str, severidade: str, titulo: str, mensagem: str,
               resolvido: bool = False) -> None:
    """Alerta pelo canal unico do repositorio. Falha de notificacao NUNCA
    derruba a publicacao: o veredito ja esta no ledger, e um `notify-owner` que
    nao alcanca a rede nao pode desfazer pagina que foi ao ar."""
    comando = [sys.executable, os.path.join(FERRAMENTAS, "notify-owner"),
               "--chave", chave, "--severidade", severidade,
               "--titulo", titulo, "--mensagem", mensagem,
               "--evidencia", LEDGER, "--origem", "tools/publicar-estoque"]
    if resolvido:
        comando.append("--resolvido")
    try:
        subprocess.run(comando, cwd=RAIZ, check=False, capture_output=True,
                       text=True, timeout=120)
    except subprocess.SubprocessError as erro:
        print(f"  ATENCAO: notify-owner falhou ({erro}); o veredito esta em {LEDGER}",
              file=sys.stderr)


def grava_ledger(registro: dict) -> None:
    absoluto = caminho(LEDGER)
    os.makedirs(os.path.dirname(absoluto), exist_ok=True)
    with open(absoluto, "a", encoding="utf-8") as saida:
        saida.write(json.dumps(registro, ensure_ascii=False) + "\n")


def resumo(rotulo: str, itens: list[dict]) -> None:
    print(f"  {rotulo}: {len(itens)}")
    for item in itens[:5]:
        print(f"    {item['tipo']:<15} {item['chave'][:88]}")
    if len(itens) > 5:
        print(f"    ... e mais {len(itens) - 5}")


def main() -> int:
    global RAIZ  # noqa: PLW0603 -- ver o comentario da constante
    analisador = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    analisador.add_argument("--canal", required=True,
                            help="canal de ops/produtores-de-pagina.jsonl")
    analisador.add_argument("--gatilho", default="onda-diaria",
                            help="gatilho do registro (default: onda-diaria)")
    analisador.add_argument("--rotulo", default="",
                            help="identidade da passada no ledger, no alerta e no commit")
    analisador.add_argument("--unit", default="",
                            help="%%N da unit que invoca (para a chave unit-falhou-*)")
    analisador.add_argument("--mesmo-sem-pendencia", action="store_true",
                            help="roda a cadeia mesmo com pendencia zero (drenagem: "
                                 "o gerador e' o produtor, e o teto e' o -limite do registro)")
    analisador.add_argument("--seco", action="store_true",
                            help="mede a pendencia e NAO roda a cadeia")
    analisador.add_argument("--raiz", default=RAIZ,
                            help="raiz do repositorio (default: a deste arquivo)")
    argumentos = analisador.parse_args()
    RAIZ = os.path.abspath(argumentos.raiz)

    rotulo = argumentos.rotulo or f"publicador-cerebro-{argumentos.canal}"
    inicio = datetime.datetime.now(datetime.timezone.utc)

    try:
        produtores = produtores_do_gatilho(argumentos.gatilho)
        produtor = produtor_do_canal(produtores, argumentos.canal, argumentos.gatilho)
        teto = teto_de_tentativas()
        antes = pendencias(argumentos.canal, produtor)
        ja_falharam = tentativas_anteriores(argumentos.canal)
        # TODOS os produtores, e nao os do gatilho: ver o cabecalho da funcao.
        aguardando_commit = portfolios_aguardando_commit(produtores_do_gatilho(todos=True))
    except NaoMedido as erro:
        # EXIT 2 E' "NAO MEDI", NUNCA "NADA PENDENTE". Indisponibilidade de dado
        # lida como ausencia de trabalho e' como uma fila para de drenar em
        # silencio.
        print(f"publicar-estoque: NAO MEDIDO — {erro}", file=sys.stderr)
        return 2

    pendentes = antes["enriquecimento"] + antes["rota_nova"]
    parados = [p for p in pendentes if ja_falharam.get(p["chave"], 0) >= teto]
    acionaveis = [p for p in pendentes if ja_falharam.get(p["chave"], 0) < teto]

    print(f"publicar-estoque: canal {argumentos.canal} (gatilho {argumentos.gatilho}), "
          f"rotulo {rotulo}")
    print(f"  shards do canal: {', '.join(antes['shards']) or '(nenhum)'}")
    resumo("pendentes acionaveis", acionaveis)
    if parados:
        resumo(f"PARADOS (>= {teto} tentativas, viram pauta do Claude Code)", parados)
    # ★ `sem_pagina` NAO E' PENDENCIA ACIONAVEL, E NAO COBRA TENTATIVA.
    #
    # Ver `pendencias()`: sem pagina que cite a noticia, nao existe onde o
    # comentario pousar, e nenhuma retentativa cria a pagina. Cobrar tentativa
    # aqui levaria a peca a PARADO por uma causa que nao e' dela — foi o que
    # aconteceu as 18:02 com tres pecas. Ela e' REPORTADA, uma vez, com a causa
    # medida, e o destinatario e' quem pode mexer no gerador.
    sem_pagina = antes.get("sem_pagina") or []
    if sem_pagina:
        resumo("SEM PAGINA PARA POUSAR (nao cobra tentativa; pauta do gerador)", sem_pagina)
        if not argumentos.seco:
            avisa_dono(
                f"{rotulo}-sem-pagina", "media",
                f"Publicacao do cerebro: {len(sem_pagina)} comentario(s) sem pagina para pousar",
                "Comentario autoral APROVADO cuja noticia nao tem pagina nenhuma no estoque. "
                "O gerador de noticias monta pagina por (orgao x dia) e recusa grupo pequeno "
                "(o log da ultima passada diz 'grupos abaixo de 4 itens'), entao a retentativa "
                "nunca cria a pagina e a peca NAO esta em quarentena por defeito proprio. "
                "Nada foi apagado: o texto esta em "
                f"{LEDGER_DE_TEXTO.get(argumentos.canal, 'no ledger do canal')}. "
                "Primeiros: " + "; ".join(p["chave"][-60:] for p in sem_pagina[:3]))

    if aguardando_commit:
        # NAO E' FALHA, E' ESPERA COM MOTIVO REGISTRADO. O estoque esta no
        # disco, o ledger diz qual e' o ato que destrava, e no instante em que o
        # commit acontecer este bloqueio some sozinho — nenhuma linha precisa
        # ser apagada para isso, que e' a propriedade que o contrato exige.
        print("  BLOQUEADO: intencao nova ainda so na worktree — a cadeia nao roda")
        for alvo in aguardando_commit:
            print(f"    {alvo}")
        print("    destrava: o Claude Code commita portfolio e estoque "
              "(portfolio PRIMEIRO, por desenho do gate de pareamento)")
        if argumentos.seco:
            return 0
        grava_ledger({
            "schema_version": SCHEMA, "quando": inicio.isoformat(), "canal": argumentos.canal,
            "rotulo": rotulo, "acao": "aguardando_commit", "teto_de_tentativas": teto,
            "pendentes_antes": len(acionaveis), "parados": [p["chave"] for p in parados],
            "caminhos": aguardando_commit, "entrou": [], "nao_entrou": [],
            "destrava": "git add/commit do portfolio e do estoque, portfolio primeiro",
        })
        return 0

    if not acionaveis and not argumentos.mesmo_sem_pendencia:
        # ★ ZERO PENDENCIA TERMINA EM SUCESSO, E ISSO E' DELIBERADO.
        # A unit nao declara SuccessExitStatus (exit 1 e' falha de verdade), e o
        # OnFailure acorda o dono. Uma passada sem trabalho que saisse != 0
        # abriria alerta por nada a cada volta do timer — e alarme que toca toda
        # hora pela mesma causa deixa de ser lido.
        print("  nada a publicar nesta execucao; a cadeia nao roda.")
        if argumentos.seco:
            return 0
        grava_ledger({
            "schema_version": SCHEMA, "quando": inicio.isoformat(), "canal": argumentos.canal,
            "rotulo": rotulo, "acao": "sem_pendencia", "teto_de_tentativas": teto,
            "pendentes_antes": 0, "parados": [p["chave"] for p in parados],
            "entrou": [], "nao_entrou": [],
        })
        return 0

    # O COMANDO E' MONTADO ANTES DO `--seco`, e o ensaio imprime ELE, nao uma
    # descricao dele. Frase que descreve o que o comando faria e' a segunda
    # versao da verdade: ela continua verde no dia em que a lista muda.
    comando = [
        os.path.join(FERRAMENTAS, "run-daily-content"),
        f"--gatilho={argumentos.gatilho}",
        f"--somente={argumentos.canal}",
        "--sem-coleta",
        # A PORTA RESTRITA, e nao a ausencia de commit. Ate a manha de
        # 2026-09-16 esta linha era `--sem-git`, e a passada quarentenava tudo o
        # que exigisse historico -- o que deixava rota nova (acordao) em
        # quarentena permanente. A politica mudou: o cerebro commita, pela porta
        # unica, com allowlist e classificacao de falha por causa.
        "--commit-restrito",
        f"--rotulo={rotulo}",
        # O piso de rota nova nao se aplica a uma passada cujo produto e' o
        # corpo de uma rota existente mudando; quem cobra o resultado e' a
        # reconciliacao abaixo, que nomeia peca por peca. Ver o comentario da
        # etapa 8.6/9 em tools/run-daily-content.
        "--minimo-novas=0",
    ]
    if argumentos.unit:
        comando.append(f"--unit={argumentos.unit}")
    if argumentos.seco:
        # ENSAIO NAO ESCREVE NADA, nem a copia de preservacao: um `--seco` que
        # deixa arquivo no disco deixa de ser ensaio.
        print(f"  --seco: rodaria {' '.join(comando)}")
        return 0

    # ★ PRESERVAR O ESTOQUE ANTES DE A CADEIA TOCAR NELE. A cadeia tambem
    # preserva (etapa 6/9 sob --sem-git), e a duplicidade e' de proposito: esta
    # copia e' do estado ANTERIOR a geracao, a de la e' do estado que vai ao ar.
    # Nenhuma das duas apaga coisa alguma.
    preservado = caminho(".agents", "runtime", "publicar-estoque",
                         inicio.strftime("%Y%m%d-%H%M%S") + "-" + argumentos.canal)
    os.makedirs(preservado, exist_ok=True)
    for rel in antes["shards"]:
        origem = caminho(rel)
        if os.path.exists(origem):
            with open(origem, "rb") as entrada, \
                    open(os.path.join(preservado, os.path.basename(rel)), "wb") as saida:
                saida.write(entrada.read())

    print(f"  rodando: {' '.join(comando)}")
    # SEM TIMEOUT PROPRIO AQUI. `run-daily-content` ja tem teto POR ETAPA e a
    # unit tem TimeoutStartSec; um `timeout` externo sobre um comando
    # transacional deixa journal aberto e trava o resto — precedente medido
    # neste repositorio.
    execucao = subprocess.run(comando, cwd=RAIZ, check=False)

    try:
        depois = pendencias(argumentos.canal, produtor)
    except NaoMedido as erro:
        print(f"publicar-estoque: a cadeia rodou (exit {execucao.returncode}) e a "
              f"reconciliacao NAO foi medida — {erro}", file=sys.stderr)
        return 2

    restantes = {p["chave"] for p in depois["enriquecimento"] + depois["rota_nova"]}
    entrou = [p for p in acionaveis if p["chave"] not in restantes]
    faltando = [p for p in acionaveis if p["chave"] in restantes]
    completou = passada_completou(rotulo)
    # `nao_entrou` cobra tentativa; `nao_avaliados` NAO. Ver passada_completou.
    nao_entrou = faltando if completou else []
    nao_avaliados = [] if completou else faltando

    # ★ A LINHA DIZ ONDE A CADEIA PAROU, e nao so se o gerador rodou. Ate as
    # 17:52 ela imprimia "cadeia completou: sim" para uma cadeia parada na 4/9 —
    # e quem leu o journal concluiu que o alerta era falso quando ele era
    # verdadeiro. Rotulo que mente sobre a cadeia manda consertar o lugar errado.
    parada = parada_da_cadeia(rotulo)
    if parada:
        situacao = f"a cadeia PAROU em {parada}"
        if completou:
            situacao += "; o gerador do canal concluiu antes disso, entao a tentativa e' cobrada"
        else:
            situacao += "; o gerador nao concluiu, entao NENHUMA tentativa e' cobrada"
    else:
        situacao = "a cadeia chegou ao fim"
    print(f"  reconciliacao: {len(entrou)} entrou(entraram), {len(faltando)} nao entrou(entraram)"
          f" | {situacao}")
    ordinal = re.match(r"\s*([0-9]+(?:\.[0-9]+)?)/9", parada) if parada else None
    if ordinal and float(ordinal.group(1)) < 5:
        print("    (o que o gerador escreveu esta no shard EM DISCO e NAO commitado: "
              "a cadeia parou antes da etapa 5/9, que e' a que commita)")
    for item in nao_entrou:
        tentativa = ja_falharam.get(item["chave"], 0) + 1
        estado = "PARADO" if tentativa >= teto else "quarentena"
        # O DETALHE ENTRA NA LINHA: `tipo` e' a especie da pendencia
        # (enriquecimento, rota_nova), nunca a causa. Sem o detalhe, quem le o
        # journal toma "enriquecimento" por diagnostico — aconteceu hoje.
        print(f"    {estado}: {item['tipo']} {item['chave'][:80]} "
              f"(tentativa {tentativa}/{teto}) — {item.get('detalhe', '')[:120]}")
    for item in nao_avaliados:
        print(f"    espera (sem cobrar tentativa): {item['tipo']} {item['chave'][:80]}")

    # ★ D — PECA PARADA TEM DESTINATARIO. Sem esta chamada `parados` morreria no
    # stdout de um oneshot e no ledger que ninguem le: e' a fila que tem produtor
    # e nao tem leitor, defeito que este repositorio ja mediu em
    # `v2_rewrite_queue.jsonl` (3.101 paginas vivas esperando, zero reescritores).
    virando_parado = [p for p in nao_entrou
                      if ja_falharam.get(p["chave"], 0) + 1 >= teto]
    chave_parado = f"{rotulo}-parado"
    if virando_parado or parados:
        avisa_dono(chave_parado, "alta",
                   f"Publicacao do cerebro: {len(virando_parado) + len(parados)} peca(s) paradas",
                   "Peca redigida que nao entra no estoque depois de "
                   f"{teto} tentativa(s). Ela NAO foi apagada: esta em "
                   f"{LEDGER_DE_TEXTO.get(argumentos.canal, 'no estoque do canal')} e listada em "
                   f"{LEDGER}. Primeiras: "
                   + "; ".join(p["chave"][:70] for p in (virando_parado + parados)[:3]))
    else:
        avisa_dono(chave_parado, "media", "Publicacao do cerebro sem peca parada",
                   "Nenhuma peca acima do teto de tentativas nesta execucao.",
                   resolvido=True)

    grava_ledger({
        "schema_version": SCHEMA, "quando": inicio.isoformat(), "canal": argumentos.canal,
        "rotulo": rotulo, "acao": "cadeia", "teto_de_tentativas": teto,
        "exit_da_cadeia": execucao.returncode,
        "pendentes_antes": len(acionaveis),
        "parados": [p["chave"] for p in parados],
        "cadeia_completou": completou,
        "entrou": [{"tipo": p["tipo"], "chave": p["chave"]} for p in entrou],
        "nao_entrou": [{"tipo": p["tipo"], "chave": p["chave"], "detalhe": p["detalhe"],
                        "tentativa": ja_falharam.get(p["chave"], 0) + 1} for p in nao_entrou],
        "nao_avaliados": [{"tipo": p["tipo"], "chave": p["chave"], "detalhe": p["detalhe"]}
                          for p in nao_avaliados],
        "preservado_em": os.path.relpath(preservado, RAIZ),
    })

    # ★ DESFECHO PARCIAL PREVISTO TEM CODIGO PROPRIO (2026-09-16).
    #
    # O ORDEM: exit 3 = "a cadeia chegou ao fim e sobrou peca em quarentena
    # ABAIXO do teto" — o sistema ainda vai tentar sozinho, e acordar o dono a
    # cada meia hora por isso transformaria o OnFailure em ruido que se aprende a
    # ignorar. E' o mesmo desenho que `wikijuridica-djen-coleta.service` ja usa
    # (exit 3 = incompleto com ponto de retomada, `SuccessExitStatus=3`).
    #
    # O QUE O 3 NAO MASCARA, e por isso ele nao e' afrouxamento:
    #   - peca que bateu o teto -> 1 (e o alerta `-parado` ja foi aberto acima);
    #   - cadeia que NAO chegou ao fim -> 1, sempre. Uma parada em gate e' o
    #     acervo inteiro bloqueado, e isso e' investigacao, nao espera;
    #   - erro de processo, allowlist, travessia -> 2, como antes.
    #
    # Medido: as passadas de 17:45 e 17:52 pararam na 4/9 por
    # `derived-body-repetition` e caem em 1 — o alerta delas estava CERTO.
    bateu_o_teto = [p for p in nao_entrou if ja_falharam.get(p["chave"], 0) + 1 >= teto]
    codigo, motivo = veredito(
        parada=parada, exit_da_cadeia=execucao.returncode,
        no_teto=len(bateu_o_teto) + len(parados), em_quarentena=len(nao_entrou), teto=teto)
    if codigo != 0:
        print(f"publicar-estoque: {motivo} (exit {codigo}). Nada foi apagado: o estoque esta "
              f"no disco e a copia em {os.path.relpath(preservado, RAIZ)}", file=sys.stderr)
    return codigo


