#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_OSS_INSTALL_MATRIX_NO_INSTALL=1
cd "$ROOT"
exec "$ROOT/tools/oss-install-matrix-env" "$ROOT/tools/run-check" oss-useful-agent-adapters --timings "$@"
