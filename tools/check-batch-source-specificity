#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

# run-check não conhece -h/--help: repassar a flag faz ele RECOMPILAR o binário
# de check e rodar o gate pesado inteiro para depois falhar sem orientar. O
# bloco cedo é o mesmo de 9 irmãos da família (ex.:
# check-authorial-mass-global-similarity-audit).
for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: check-batch-source-specificity [flags]

Roda o gate batch-source-specificity pelo runner cacheado (run-check), com
--timings sempre ligado. Flags extras vão para o run-check.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
# --timings e "$@" seguem o padrão dos demais wrappers check-* (ex.:
# check-source-freshness): sem o forwarding, qualquer flag do operador
# (--budget-ms, --max-duration) era descartada em silêncio e o check pesado
# rodava inteiro sem telemetria de tempo.
exec "$ROOT/tools/run-check" batch-source-specificity --timings "$@"
