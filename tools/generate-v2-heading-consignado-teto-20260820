#!/usr/bin/env python3
"""Corrige um subtítulo que afirma percentual que o próprio corpo se recusa a afirmar.

O DEFEITO, e por que ele é da classe mais séria deste repositório.

A página `banc-consignado-clt-como-funciona` traz a seção:

    heading: "O limite de 40% da remuneração disponível"
    texto  : "O artigo 2º, §2º, da Lei 10.820/2003 fixa o teto dos descontos
              consignados sobre a remuneração disponível do trabalhador; esse
              percentual já passou por diversas alterações legislativas ao longo
              dos anos, e o valor atualizado em vigor consta no texto compilado…"

O corpo está CERTO e é deliberadamente prudente: o teto do consignado mudou mais
de uma vez (35%, 40%, e margens adicionais para cartão), e o texto se recusa a
cravar um número que pode estar desatualizado. O SUBTÍTULO faz exatamente o que o
corpo evita — crava 40%.

Isso é citação legal mal atribuída: a classe que o CLAUDE.md registra como P1
permanente, presente em ~8% das páginas auditadas por humano, e a única com risco
real sob a OAB. Um leitor que só passe os olhos nos subtítulos sai com um número
que a página não sustenta.

Foi o veredito REPROVADA:5 (erro de citação legal) do auditor de lote 14 que
apontou isto, com a nota literal "O limite de 40% da remuneração disponível" — e
a página estava fora do ar desde então por `veredito_conflitante`, porque outro
agente a havia aprovado.

A CORREÇÃO: o subtítulo passa a descrever o que o corpo de fato diz. Não se
acrescenta número nenhum — silêncio honesto, a mesma regra que corrigiu o
checked_at nesta data.

Escrita atômica (temp + rename) e idempotente: rodar duas vezes não muda nada na
segunda.

Uso:
    tools/generate-v2-heading-consignado-teto-20260820 --dry-run
    tools/generate-v2-heading-consignado-teto-20260820
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
SHARD = RAIZ / "data/editorial/v2_pages/bancario-05.jsonl"
INTENT = "banc-consignado-clt-como-funciona"
ANTIGO = "O limite de 40% da remuneração disponível"
NOVO = "O teto de desconto sobre a remuneração disponível"


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    if not SHARD.exists():
        print(f"shard ausente: {SHARD}", file=sys.stderr)
        return 2

    linhas = SHARD.read_text(encoding="utf-8").splitlines()
    saida: list[str] = []
    trocados = 0
    encontrado = False
    for linha in linhas:
        if not linha.strip():
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") != INTENT:
            saida.append(json.dumps(registro, ensure_ascii=False))
            continue
        encontrado = True
        for secao in registro.get("sections", []):
            if secao.get("heading") == ANTIGO:
                secao["heading"] = NOVO
                trocados += 1
        saida.append(json.dumps(registro, ensure_ascii=False))

    if not encontrado:
        print(f"intent {INTENT} nao esta em {SHARD.name}", file=sys.stderr)
        return 1
    if trocados == 0:
        print("nada a fazer: o subtitulo ja esta corrigido (idempotente)")
        return 0

    print(f"subtitulo trocado em {trocados} secao(oes):")
    print(f"  de : {ANTIGO!r}")
    print(f"  para: {NOVO!r}")
    if argumentos.dry_run:
        print("\n--dry-run: nada gravado")
        return 0

    # Escrita atomica: temp no MESMO diretorio (rename so e atomico dentro do
    # mesmo sistema de arquivos) + fsync antes do rename.
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=SHARD.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write("\n".join(saida) + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        caminho = temporario.name
    os.replace(caminho, SHARD)
    print(f"gravado: {SHARD.relative_to(RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
