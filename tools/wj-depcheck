#!/usr/bin/env bash
# tools/wj-depcheck — confere wj/deps.yml contra o grafo de imports real de
# ./wj/... e contra a varredura de literais da árvore (TASKLIST §2, F0.O7).
#
# PORQUE: a TASKLIST fixa DEP-1…DEP-10 e os literais de fonte única como portão
# de merge, "cobrindo transitivas" — um grep de import deixaria passar
# wj/nego/core -> ponte -> wj/nego/llm. O verificador (wj/internal/depcheck) lê
# o fecho de `go list -deps` e o texto de todo arquivo sob wj/.
#
# SAIDA: uma linha por violação e "N pacotes verificados, M violações".
# Exit 0 = nenhuma violação; 1 = violação; 2 = deps.yml que não parseia, go list
# que falha ou verificador que não compila.
#
# POR QUE COMPILA EM VEZ DE `go run`: medido em 2026-09-24 com go1.26.6, `go run`
# de um main que sai 2 imprime "exit status 2" e sai 1 — o 2 do erro de parse
# viraria o 1 de violação. O binário vai para .cache/ (no .gitignore), num
# diretório próprio por execução, e sai no fim.
#
# -tags devcmds EXPLICITO: o main é dev-main (//go:build devcmds). O
# tools/go-modern injeta a tag em run e test, não em build.
#
# Uso: tools/wj-depcheck [-deps wj/deps.yml]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Egresso zero em build (S4): nenhum download de toolchain; o go.mod pina go1.26.6.
export GOTOOLCHAIN=local

if ! GOROOT_DO_REPO="$(./tools/go-modern env GOROOT)" || [ -z "$GOROOT_DO_REPO" ]; then
	echo "wj-depcheck: tools/go-modern não resolveu o GOROOT" >&2
	exit 2
fi

mkdir -p "$ROOT/.cache/wj-depcheck"
BIN_DIR="$(mktemp -d "$ROOT/.cache/wj-depcheck/bin.XXXXXX")"
trap 'rm -rf "$BIN_DIR"' EXIT

if ! ./tools/go-modern build -tags devcmds -o "$BIN_DIR/wj-depcheck" ./wj/cmd/wj-depcheck; then
	echo "wj-depcheck: o verificador não compilou" >&2
	exit 2
fi

"$BIN_DIR/wj-depcheck" -repo . -go "$GOROOT_DO_REPO/bin/go" "$@"
