def _hashes_de_conteudo(urls, base):
    """content_sha256 por URL, pelo MESMO criterio do incremental: registro de
    revisao quando existe, hash do HTML servido quando a rota e derivada."""
    revisao = {}
    if os.path.isfile(REVISAO_CONTEUDO):
        with open(REVISAO_CONTEUDO, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                    revisao[registro["path"]] = registro["content_sha256"]
                except Exception:
                    continue
    saida = {}
    for url in urls:
        rota = url[len(base):] if url.startswith(base) else ""
        if not rota:
            continue
        if rota in revisao:
            saida[url] = (revisao[rota], "page_content_revision")
            continue
        alvo = os.path.join(ROOT, "public", rota.strip("/"), "index.html")
        if rota == "/":
            alvo = os.path.join(ROOT, "public", "index.html")
        if not os.path.isfile(alvo):
            continue
        with open(alvo, "rb") as handle:
            saida[url] = (hashlib.sha256(handle.read()).hexdigest(), "public_html")
    return saida


def registrar_no_estado_compartilhado(urls_aceitas, base, agora, status):
    """Marca no estado do incremental as URLs que ESTA ferramenta submeteu e
    tiveram lote aceito. Falha aqui NAO derruba a submissao: o anuncio ja
    aconteceu, e perder o registro causa no maximo um reenvio -- enquanto
    abortar por causa dele perderia a submissao inteira."""
    if not urls_aceitas:
        return 0
    try:
        estado = {}
        if os.path.isfile(ESTADO_COMPARTILHADO):
            with open(ESTADO_COMPARTILHADO, encoding="utf-8") as handle:
                estado = json.load(handle)
        estado.setdefault("schema_version", "indexnow_submission_state_v1")
        registros = estado.setdefault("urls", {})
        hashes = _hashes_de_conteudo(urls_aceitas, base)
        marcadas = 0
        for url in urls_aceitas:
            par = hashes.get(url)
            if not par:
                continue
            registros[url] = {
                "content_sha256": par[0],
                "hash_source": par[1],
                "submitted_at": agora,
                "http_status": status,
                "submitted_by": "generate-indexnow-direct-submit",
            }
            marcadas += 1
        estado["last_run_at"] = agora
        tmp = ESTADO_COMPARTILHADO + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(estado, handle, ensure_ascii=False)
            handle.write("\n")
        os.replace(tmp, ESTADO_COMPARTILHADO)
        return marcadas
    except Exception as erro:
        print("  aviso: nao consegui atualizar %s (%s) — o incremental pode resubmeter"
              % (os.path.relpath(ESTADO_COMPARTILHADO, ROOT), erro), file=sys.stderr)
        return 0


def registrar_ledger_url_state(urls, indice_lote, endpoint, status, agora, kinds=None):
    """Acrescenta UMA linha por URL do lote a LEDGER_URL_STATE — aceito OU
    recusado, sempre: um 403 e uma resposta real, e apaga-la do historico
    seria o mesmo apagamento que ESTADO_COMPARTILHADO ja faz por design (e
    que este ledger existe para nao repetir).

    UNICO PONTO DE ESCRITA para os dois caminhos de submissao (incremental e
    direto): generate-indexnow-incremental-submit NUNCA fala com a API por
    conta propria — ele sempre delega o POST real a este script via
    `--de-arquivo` (subprocess). Cobrir aqui cobre os dois por construcao,
    sem duplicar a escrita em dois lugares que poderiam divergir.

    Mesma postura de registrar_no_estado_compartilhado: nao aborta a
    submissao se a escrita falhar (o anuncio ao IndexNow ja aconteceu) e
    IMPRIME o erro — nunca engole em silencio.
    """
    if not urls:
        return 0
    try:
        os.makedirs(os.path.dirname(LEDGER_URL_STATE), exist_ok=True)
        with open(LEDGER_URL_STATE, "a", encoding="utf-8") as handle:
            for url in urls:
                linha = {
                    "schema_version": "indexnow_url_state_v1",
                    "url": url,
                    "lote": indice_lote,
                    "url_count": len(urls),
                    "endpoint": endpoint,
                    "http_status": status,
                    "submitted_at": agora,
                    # Campo aditivo (2026-09-16). Leitor antigo ignora chave
                    # desconhecida, entao o schema_version nao muda. E o que
                    # permite cruzar anuncio com retorno de rastreio na borda
                    # por `(url, submitted_at, kind)` e responder, daqui a um
                    # mes, se a rotacao ajudou — em vez de discutir por opiniao.
                    "kind": (kinds or {}).get(url, KIND_PADRAO),
                }
                handle.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
        return len(urls)
    except Exception as erro:
        print("  aviso: nao consegui gravar %s (%s) — o historico por URL deste lote fica incompleto"
              % (os.path.relpath(LEDGER_URL_STATE, ROOT), erro), file=sys.stderr)
        return 0


