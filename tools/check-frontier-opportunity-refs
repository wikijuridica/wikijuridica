#!/usr/bin/env python3
"""check-frontier-opportunity-refs — mede referências órfãs entre as frontiers
do codex2 e o estoque real de oportunidades.

POR QUE (2026-09-05)

`TestCodex2SourceAuditQueueMaterializesOfficialSourceTasksWithoutPublishing`
reprova com `codex2_source_audit_queue_missing_opportunity` e nomeia UM id — a
fila retorna no primeiro órfão que encontra (`queue.go:136`). Um id parece um
acidente; medindo os dois lados inteiros, são MILHARES.

Medido hoje: 2.407 de 4.800 referências da coverage frontier (50,1%) e 2.389 de
4.800 da source frontier apontam para `opportunity_id` que não existe em
`data/research/demand_expansion_opportunities.jsonl`. Os ids têm a forma
`<tema>-<situacao>-<persona>` — a permutação cartesiana que a DEC-004 declarou
morta. O estoque encolheu de 16.200 para 10.083 oportunidades e as frontiers
ficaram apontando para o que sumiu.

E NÃO SAI POR REGENERAÇÃO. `codex2coveragefrontier.Generate` reusa os records
existentes quando eles passam e são >= MinimumFrontierRecords (frontier.go:131),
e `refreshExistingRecord` atualiza os CONTADORES sem revisar os
`opportunity_ids`. Medido: regenerar corrigiu `backlog_opportunity_count`
(16.200 -> 10.083) e manteve os 2.407 órfãos, byte a byte. O artefato é
auto-perpetuante nessa dimensão.

Filtrar não basta: 2 dos 120 records ficariam com ZERO ids vivos e a contagem
cairia abaixo do mínimo de 120. A correção é fazer o reuso NÃO aceitar record
com id morto, forçando a recomposição pelo caminho completo — o que reescreve os
120 records e precisa de ensaio próprio, como o canal `--normas-fulltext` teve.

A FAMÍLIA É MAIOR QUE AS DUAS FRONTIERS (medido 2026-09-05, censo de todos os
`data/research/*.jsonl` com campo de `opportunity_id`):

    codex2_coverage_frontier.jsonl          4.800 refs   2.407 órfãs
    codex2_mass_scale_plan.jsonl            4.800 refs   2.306 órfãs   gate VERDE
    codex2_external_collection_wave.jsonl   4.800 refs   2.226 órfãs   gate VERDE
    codex2_source_frontier.jsonl            4.800 refs       0 órfãs
    codex2_source_audit_queue.jsonl         4.800 refs       0 órfãs

Os gates `codex2-mass-scale-plan` e `codex2-external-collection-wave` passavam
VERDES carregando 2.306 e 2.226 referências mortas: nenhum gate desta família
confrontava plano contra estoque. Por isso este gate cobre os QUATRO artefatos
de PLANEJAMENTO, e não só as duas frontiers.

O QUE NÃO ENTRA, E POR QUÊ. `demand_signal_observations.jsonl` (2.049) e
`demand_confirmation_state.jsonl` (2.148) também referenciam oportunidade
extinta, e isso NÃO é defeito: são LEDGERS HISTÓRICOS. A observação de uma
oportunidade que depois saiu do estoque é fato medido, não referência pendente,
e apagá-la destruiria medição. O que o defeito proíbe é essa observação valer
como COBERTURA do estoque vivo — corrigido em
`codex2coveragefrontier.liveObservedOpportunityCount`.

FORA DO ESCOPO DESTE GATE, POR FALTA DE REMÉDIO MEDIDO:
`commercial_legal_portfolio.jsonl` (10.000 refs, 1.794 órfãs) e
`commercial_legal_portfolio_coverage_frontier.jsonl` (10.000 refs, 1.794
órfãs). São a mesma classe, de outra linhagem; nenhum ensaio mediu ainda a
recomposição deles. Gate que reprova sem saber nomear o comando que conserta é
o que fez "um id parecer acidente" — cada artefato aqui traz o seu remédio.

READ-ONLY. Exit 1 se houver órfão, 0 se não houver.

Uso:
    ./tools/check-frontier-opportunity-refs
    ./tools/check-frontier-opportunity-refs --json
    ./tools/check-frontier-opportunity-refs --root var/ensaio/<dir>
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

RAIZ_PADRAO = pathlib.Path(__file__).resolve().parent.parent
OPORTUNIDADES_REL = "data/research/demand_expansion_opportunities.jsonl"

# Cada artefato de PLANEJAMENTO traz o campo que referencia oportunidade e o
# comando exato que o recompõe. A raiz é POSICIONAL nos três geradores
# (os.Args[1]); passar `--root` a eles faz o comando ler PRODUÇÃO em silêncio.
PLANEJAMENTO = (
    {
        "arquivo": "data/research/codex2_coverage_frontier.jsonl",
        "campo": "opportunity_ids",
        "remedio": "./tools/go-modern run ./cmd/generate-codex2-coverage-frontier <raiz>",
    },
    {
        "arquivo": "data/research/codex2_source_frontier.jsonl",
        "campo": "opportunity_ids",
        "remedio": "./tools/go-modern run ./cmd/generate-codex2-source-frontier --root <raiz>",
    },
    {
        "arquivo": "data/research/codex2_mass_scale_plan.jsonl",
        "campo": "selected_opportunity_ids",
        "remedio": "./tools/go-modern run ./cmd/generate-codex2-mass-scale-plan <raiz>",
    },
    {
        "arquivo": "data/research/codex2_external_collection_wave.jsonl",
        "campo": "selected_opportunity_ids",
        "remedio": "./tools/go-modern run ./cmd/generate-codex2-external-collection-wave <raiz>",
    },
)

# Ledgers históricos: medidos e impressos como contexto, NUNCA como órfãos.
LEDGERS_HISTORICOS = (
    {"arquivo": "data/research/demand_signal_observations.jsonl", "campo": "opportunity_id"},
    {"arquivo": "data/research/demand_confirmation_state.jsonl", "campo": "opportunity_id"},
)


def ids_de(caminho: pathlib.Path, campo: str) -> set[str]:
    achados: set[str] = set()
    if not caminho.is_file():
        return achados
    with caminho.open(encoding="utf-8") as arquivo:
        for linha in arquivo:
            if not linha.strip():
                continue
            try:
                registro = json.loads(linha)
            except ValueError:
                continue
            valor = registro.get(campo)
            if isinstance(valor, str):
                achados.add(valor)
    return achados


def mede(caminho: pathlib.Path, campo: str, vivas: set[str]) -> dict:
    """Conta referencias e orfas de UM artefato, sem carregar o arquivo inteiro
    na memoria: demand_confirmation_state.jsonl tem 28 MB."""
    referenciados: set[str] = set()
    orfaos: set[str] = set()
    zerados = 0
    with caminho.open(encoding="utf-8") as arquivo:
        for linha in arquivo:
            if not linha.strip():
                continue
            try:
                registro = json.loads(linha)
            except ValueError:
                continue
            valor = registro.get(campo)
            if isinstance(valor, str):
                ids = [valor]
            elif isinstance(valor, list):
                ids = [i for i in valor if isinstance(i, str)]
            else:
                continue
            referenciados.update(ids)
            mortos = [i for i in ids if i not in vivas]
            orfaos.update(mortos)
            if ids and len(mortos) == len(ids):
                zerados += 1
    return {
        "arquivo": caminho.name,
        "referenciados": len(referenciados),
        "orfaos": len(orfaos),
        "records_sem_nenhum_id_vivo": zerados,
        "amostra": sorted(orfaos)[:5],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--root", default=str(RAIZ_PADRAO),
                        help="raiz a medir; use uma copia de ensaio para validar correcao antes de producao")
    args = parser.parse_args()

    raiz = pathlib.Path(args.root).resolve()
    oportunidades = raiz / OPORTUNIDADES_REL
    if not oportunidades.is_file():
        print(f"NAO RODOU: {oportunidades} ausente", file=sys.stderr)
        return 2
    vivas = ids_de(oportunidades, "opportunity_id")

    relatorio = {
        "raiz": str(raiz),
        "oportunidades_vivas": len(vivas),
        "planejamento": [],
        "ledgers_historicos": [],
    }
    total_orfaos = 0
    for alvo in PLANEJAMENTO:
        caminho = raiz / alvo["arquivo"]
        if not caminho.is_file():
            continue
        medida = mede(caminho, alvo["campo"], vivas)
        total_orfaos += medida["orfaos"]
        medida["remedio"] = alvo["remedio"]
        relatorio["planejamento"].append(medida)
    for alvo in LEDGERS_HISTORICOS:
        caminho = raiz / alvo["arquivo"]
        if not caminho.is_file():
            continue
        relatorio["ledgers_historicos"].append(mede(caminho, alvo["campo"], vivas))

    if args.json:
        json.dump(relatorio, sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 1 if total_orfaos else 0

    print(f"raiz: {relatorio['raiz']}")
    print(f"oportunidades vivas: {relatorio['oportunidades_vivas']}")
    print("planejamento (referencia pendente = tarefa que nenhuma onda executa):")
    for f in relatorio["planejamento"]:
        pct = 100.0 * f["orfaos"] / f["referenciados"] if f["referenciados"] else 0.0
        print(f"  {f['arquivo']}: {f['referenciados']} referenciados | "
              f"{f['orfaos']} ORFAOS ({pct:.1f}%) | "
              f"{f['records_sem_nenhum_id_vivo']} record(s) sem nenhum id vivo")
        for a in f["amostra"]:
            print(f"      - {a}")
        if f["orfaos"]:
            print(f"      remedio: {f['remedio']}")
    print("ledgers historicos (fato medido, NAO e orfao — nao entra na reprovacao):")
    for f in relatorio["ledgers_historicos"]:
        print(f"  {f['arquivo']}: {f['referenciados']} referenciados | "
              f"{f['orfaos']} de oportunidade ja extinta")
    if total_orfaos:
        print("check-frontier-opportunity-refs: FAIL")
        print("  Cada linha de planejamento acima traz o comando que a recompoe.")
        print("  Raiz medida em 2026-09-05: o reuso do proprio artefato em")
        print("  codex2coveragefrontier.GenerateWithLineage so recalculava contadores e")
        print("  nunca revisitava opportunity_ids — regenerar reescrevia o arquivo byte a")
        print("  byte identico. Com a guarda de referencia morta, o gerador cai sozinho no")
        print("  caminho completo e imprime origem=recomposta_do_estoque_vivo.")
        return 1
    print("check-frontier-opportunity-refs: pass")
    return 0


if __name__ == "__main__":
    sys.exit(main())
