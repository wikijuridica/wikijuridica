#!/usr/bin/env python3
"""check-bot-telemetry-liveness — a série de bot não pode morrer em silêncio.

POR QUE EXISTE: esta sessão construiu coleta por User-Agent exato, cursor
incremental e verificação de autenticidade por faixa de IP — e nada reprovava se
tudo isso simplesmente parasse. Seria o mesmo defeito que já foi corrigido no
`check-edge-traffic`, que imprimia "indisponivel" e saía com código 0: falha que
não reprova é falha que ninguém vê.

O risco é concreto e tem prazo. As duas fontes perdem dado sozinhas:

  - BORDA: `httpRequestsAdaptiveGroups` tem retenção de 8 dias. Timer quebrado
    por mais que isso e o buraco é permanente — não há de onde recuperar.
  - ORIGEM: logrotate horário com 14 rotações, 13 h 33 min de janela medidos. O
    prejuízo já foi observado: a borda registrou 9.662 requisições do GPTBot num
    dia em que a origem guardava 2.

Sem este check, um timer desabilitado num reboot, uma credencial expirada ou um
log que virou ilegível apagariam a série sem aviso — e a próxima leitura de
"o Googlebot está vindo mais?" seria feita sobre um vazio interpretado como
queda de tráfego.

A TERCEIRA SÉRIE, e por que ela entrou aqui em 2026-08-12: a cobertura de crawl
(`crawl_coverage_daily.jsonl`) é o INDICADOR PRINCIPAL do projeto — quanto do
acervo o crawler já pediu — e não era vigiada por nada. Ela depende do mesmo
dataset de 8 dias de retenção e do mesmo timer; parar em silêncio custaria o
mesmo buraco irrecuperável das outras duas.

E A IDENTIDADE, não só a idade: uma série pode estar sendo escrita em dia e
ainda assim medir a coisa errada. Até 2026-08-12 a cobertura contava crawler
pela STRING do User-Agent, o que somava as sondas de auditoria deste próprio
repositório (o cabeçalho `X-Bot-Simulation` só é visível ao nginx, nunca à borda
da Cloudflare). O produtor corrigido gravou `crawl_coverage_daily_v2`, com a
identidade autenticada por `verifiedBotCategory`. Em 2026-09-02 ele ganhou uma
segunda lane, por faixa de IP oficial, para o operador que a Cloudflare não
autentica mas publica a própria faixa (medido no PerplexityBot: ~1.200 req/dia,
100% dos IPs em faixa oficial, categoria sempre vazia — sem a segunda lane, a
cobertura dele era ZERO por construção). O produtor corrigido grava
`crawl_coverage_daily_v3`. Este check exige esse schema na linha mais recente:
é assim que se sabe que o produtor CORRIGIDO rodou, e não apenas que algum
produtor rodou. Mesma técnica do `check-bot-telemetry-honesty` para as séries
de bot.

READ-ONLY. Exit 1 quando qualquer série está velha demais ou quando a linha mais
recente da cobertura ainda vem do produtor não corrigido.

Uso:
    tools/check-bot-telemetry-liveness
    tools/check-bot-telemetry-liveness --horas 6
    tools/check-bot-telemetry-liveness --json
"""
import argparse
import datetime
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))

# O timer roda a cada 30 minutos. 6 horas é doze execuções perdidas: folga larga
# para reboot, máquina ocupada ou API instável, e ainda assim muito abaixo da
# retenção de 8 dias da borda — dá tempo de consertar antes de perder dado.
HORAS_PADRAO = 6

# (rótulo, caminho, schema exigido na linha mais recente ou None)
#
# O rótulo da borda mudou junto com o produtor: ela não é mais "por User-Agent
# exato", é por bot que a Cloudflare autenticou. Rótulo que descreve errado o
# que a série mede é o começo da próxima leitura errada.
# CADA SERIE TEM A JANELA DA PROPRIA CADENCIA, e nao uma regua unica.
#
# O DEFEITO, medido em 2026-08-28: HORAS_PADRAO valia 6 para as tres, justificado
# por "o timer roda a cada 30 minutos". Isso e verdade para as duas primeiras,
# produzidas por `wikijuridica-bot-telemetry.timer`. A terceira, porem, sai de
# `wikijuridica-crawl-coverage.timer`, que roda UMA VEZ POR DIA (OnCalendar
# 04:10 UTC). Cobrar 6 horas dela deixava o gate vermelho ~18 horas por dia POR
# CONSTRUCAO -- e vermelho permanente e indistinguivel de vermelho que importa:
# ensina a ignorar o canal, que e o mesmo defeito do alerta que se auto-resolve.
#
# O quarto campo e a janela em horas; o quinto, a unit que de fato produz a
# serie -- porque a mensagem mandava reiniciar `wikijuridica-bot-telemetry`, que
# nao e o produtor da cobertura, e seguir essa instrucao nao consertaria nada.
SERIES = [
    ("borda (Cloudflare, bot verificado)", "data/ops/edge_bot_agents_daily.jsonl", None,
     6, "wikijuridica-bot-telemetry.service"),
    ("origem (log do nginx, com IP verificado)", "data/ops/origin_bot_traffic_daily.jsonl", None,
     6, "wikijuridica-bot-telemetry.service"),
    # O schema é exigido AQUI porque nenhum outro check vigia esta série; as
    # duas de cima já têm essa exigência em check-bot-telemetry-honesty, e
    # repeti-la produziria a mesma reprovação em dois lugares.
    #
    # 30 horas, e nao 6: um dia de cadencia mais seis de folga para reboot,
    # maquina ocupada ou API instavel -- a mesma folga que as outras tem, na
    # escala certa.
    # v3 (2026-09-02): tools/measure-crawl-coverage ganhou a segunda lane de
    # verificação por faixa de IP oficial (para o operador que a Cloudflare
    # não autentica por verifiedBotCategory mas publica a própria faixa —
    # medido no PerplexityBot). v2 vira SOB RESSALVA abaixo, mesma técnica de
    # quando v1 foi superada.
    ("cobertura de crawl (indicador principal)", "data/ops/crawl_coverage_daily.jsonl",
     "crawl_coverage_daily_v3", 30, "wikijuridica-crawl-coverage.service"),
]

# Séries anteriores à correção de identidade de 2026-08-12 (v1) ou à segunda
# lane por faixa de IP de 2026-09-02 (v2). Ficam no arquivo (append-only,
# correção só para frente) e são lidas SOB RESSALVA: a contagem delas soma
# sonda de auditoria (v1) ou não enxerga operador verificado só por faixa de
# IP (v1 e v2). Enumeradas em data/ops/bot_identity_caveat.jsonl.
SCHEMAS_SOB_RESSALVA = {
    "crawl_coverage_daily_v1": "contagem por string de User-Agent, sem verificacao de identidade",
    "crawl_coverage_daily_v2": "sem a segunda lane de verificacao por faixa de IP oficial "
                               "(perde cobertura do operador que a Cloudflare nao autentica)",
    "edge_bot_agents_daily_v1": "contagem por string de User-Agent, sem verificacao de identidade",
    "edge_bot_agents_daily_v2": "contagem por string de User-Agent + heuristico de pais",
}


def ultimo_schema(caminho):
    """schema_version da ÚLTIMA linha legível do ledger.

    Lê o arquivo inteiro de propósito, em vez de fazer `seek` para o fim: são
    ledgers de milhares de linhas, não de milhões, e um `seek` que caia no meio
    de uma linha devolveria JSON quebrado — que este check leria como "sem
    schema" e reprovaria por engano.
    """
    versao = None
    try:
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    versao = json.loads(linha).get("schema_version")
                except json.JSONDecodeError:
                    continue
    except OSError:
        return None
    return versao


def idade_horas(caminho):
    """Idade da série pelo mtime do arquivo, não pelo campo `date`.

    O campo diria o DIA coberto; o mtime diz quando a coleta rodou pela última
    vez, que é exatamente o que este check vigia. Uma coleta que roda e não
    encontra bot novo continua tocando o arquivo — e é assim que se distingue
    "nenhum bot veio" de "ninguém está coletando", duas coisas que a série sem
    este check confundiria.
    """
    if not os.path.isfile(caminho):
        return None
    mtime = datetime.datetime.fromtimestamp(os.path.getmtime(caminho), datetime.timezone.utc)
    agora = datetime.datetime.now(datetime.timezone.utc)
    return (agora - mtime).total_seconds() / 3600.0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--horas", type=float, default=HORAS_PADRAO,
                        help="idade máxima aceita para cada série (padrão: %(default)s)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    problemas = []
    relatorio = []
    for rotulo, rel, schema_exigido, horas_da_serie, unit_produtora in SERIES:
        # A janela vem da SERIE, nao de uma regua unica. `--horas` explicito
        # continua vencendo, para quem esta depurando uma serie especifica.
        limite = args.horas if args.horas != HORAS_PADRAO else horas_da_serie
        caminho = os.path.join(ROOT, rel)
        idade = idade_horas(caminho)
        if idade is None:
            problemas.append((rotulo, rel, "arquivo ausente"))
            relatorio.append({"serie": rel, "status": "ausente"})
            print("  AUSENTE  %-42s %s" % (rotulo, rel))
            continue
        linhas = sum(1 for _ in open(caminho, encoding="utf-8"))
        estado = "ok" if idade <= limite else "velha"
        if estado == "velha":
            problemas.append((rotulo, rel,
                              "%.1f h sem coleta (limite %.0f h; produtor: %s)"
                              % (idade, limite, unit_produtora)))
        schema = ultimo_schema(caminho)
        if schema_exigido and schema != schema_exigido:
            ressalva = SCHEMAS_SOB_RESSALVA.get(schema)
            problemas.append((rotulo, rel,
                              "produtor nao corrigido: ultima linha schema=%r, esperado %r%s"
                              % (schema, schema_exigido,
                                 " (%s)" % ressalva if ressalva else "")))
            estado = "identidade"
        relatorio.append({"serie": rel, "status": estado,
                          "age_hours": round(idade, 2), "lines": linhas,
                          "last_schema": schema,
                          "expected_schema": schema_exigido})
        print("  %-11s %-42s %6.1f h  %d linha(s)  schema=%s"
              % (estado.upper(), rotulo, idade, linhas, schema))

    # O timer é a causa mais provável de a série parar — reportar o estado dele
    # junto poupa o próximo diagnóstico.
    timer = os.popen("systemctl is-active wikijuridica-bot-telemetry.timer 2>/dev/null").read().strip()
    print("  timer wikijuridica-bot-telemetry: %s" % (timer or "desconhecido"))
    if timer and timer != "active":
        problemas.append(("timer", "wikijuridica-bot-telemetry.timer", timer))

    if args.json:
        print(json.dumps({"series": relatorio, "timer": timer,
                          "max_age_hours": args.horas}, ensure_ascii=False, indent=2))

    if problemas:
        print("\nREPROVADO: a serie de bot parou de ser coletada.", file=sys.stderr)
        for rotulo, rel, motivo in problemas:
            print("  %s (%s): %s" % (rotulo, rel, motivo), file=sys.stderr)
        print("\n  A borda retem 8 dias e a origem ~13 h. Dado nao coletado nessa janela"
              "\n  nao volta — nao ha de onde recuperar.", file=sys.stderr)
        print("  Conserto: systemctl start wikijuridica-bot-telemetry.service e ver o journal.",
              file=sys.stderr)
        return 1

    print("\ncheck-bot-telemetry-liveness: OK — as %d series estao sendo coletadas, "
          "e a cobertura vem do produtor de identidade verificada." % len(SERIES))
    return 0


if __name__ == "__main__":
    sys.exit(main())
