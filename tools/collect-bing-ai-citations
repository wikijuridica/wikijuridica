#!/usr/bin/env bash
# collect-bing-ai-citations — le o relatorio de DESEMPENHO DE IA do Bing
# Webmaster Tools (quantas vezes o portal foi CITADO numa resposta gerada, por
# pagina e por dia) e o grava no ledger do Bing.
#
# POR QUE NAO E' UMA FUNCAO EM tools/collect-bing-webmaster. Aquele coletor e'
# `urllib` puro, roda sob `timeout 120` na unit de medicao externa, tem teto de
# 400 requisicoes/dia e cursor proprio em data/ops/bing_webmaster_state.json.
# Ele funciona e nao se quebra. Este aqui dirige um NAVEGADOR com a sessao da
# conta Microsoft do titular, porque a API publica nao expoe esse dado: a
# interface IWebmasterApi lista 62 metodos e nenhum de citacao por IA (28
# candidatos testados, 28 x 404), e a Microsoft declarou em 2026-02-11 que o
# dado ainda nao sai pela API. Sao duas maquinas com ciclos de falha diferentes.
#
# QUANDO A MICROSOFT TIRAR DO BACKLOG, isto vira uma funcao de dez linhas
# naquele coletor e esta ferramenta sai de cena. Ate la, o caminho de leitura e'
# problema de engenharia a resolver — nao razao para nao medir.
#
# USO
#   ./tools/collect-bing-ai-citations --login    UMA VEZ, o TITULAR autentica
#   ./tools/collect-bing-ai-citations            a rotina diaria
#   ./tools/collect-bing-ai-citations --forcar   ignora o teto de 1 execucao/dia
#
# SAIDA
#   0  mediu (ou o dia ja estava feito)
#   1  mediu e o resultado e' degradado — veredito, nao defeito de processo
#   2  NAO mediu: sessao ausente, token nao colhido, rota nao observada, teto
#      estourado, erro de I/O. "Nao rodou" nunca e' "esta tudo certo".
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$RAIZ/tools/coletor-bing-ia"

if [ ! -f "$APP/coletar.mjs" ]; then
	echo "ERRO: $APP/coletar.mjs nao encontrado — a arvore do repo esta incompleta." >&2
	exit 2
fi

command -v node >/dev/null 2>&1 || {
	echo "ERRO: node nao esta no PATH." >&2
	exit 2
}

# DISPLAY VIRTUAL OBRIGATORIO. O navegador do agente NUNCA roda em :0 — a tela
# do dono tem uma VM anexada por `virt-viewer --attach` com PJe/e-SAJ e o token
# de assinatura dele, e virt-viewer encaminha teclado e mouse para dentro do
# guest. Em :99 isso fica inalcancavel POR CONSTRUCAO: sao servidores X
# distintos, com sockets distintos (/tmp/.X11-unix/X0 e X99). Ver
# docs/adr/2026-08-27-xvfb-display-virtual-para-agente.md
#
# EXCECAO UNICA: --login, onde o TITULAR digita credencial e precisa ver a tela.
DISPLAY_AGENTE=":99"
if [ "${1:-}" != "--login" ]; then
	if ! pgrep -x Xvfb >/dev/null 2>&1; then
		command -v Xvfb >/dev/null 2>&1 || {
			echo "ERRO: Xvfb ausente. sudo apt install xvfb" >&2
			exit 2
		}
		echo "subindo display virtual $DISPLAY_AGENTE ..." >&2
		setsid Xvfb "$DISPLAY_AGENTE" -screen 0 1440x1000x24 -nolisten tcp </dev/null >/tmp/xvfb99.log 2>&1 &
		# ESPERA PELO SOCKET, nao por tempo fixo: `sleep 2` e' palpite que fica
		# curto quando a maquina esta carregada, e o que se espera aqui e' um
		# arquivo aparecer — isso se TESTA. A pausa entre as tentativas, porem,
		# tem de ser pausa de verdade: a primeira versao usava
		# `read -r -t 0.2 </dev/null`, que bate em EOF na hora, e as 50 voltas
		# passavam em microssegundos. Laco sem pausa e' busy-wait disfarcado de
		# espera, que e' pior que nao esperar, porque PARECE que espera.
		#
		# EM PRODUCAO NADA DISTO RODA: a unit declara
		# `Requires=wikijuridica-xvfb99.service` e o display ja esta de pe. Este
		# ramo e' para a execucao a mao.
		for _ in $(seq 1 50); do
			[ -S "/tmp/.X11-unix/X99" ] && break
			sleep 0.2
		done
		[ -S "/tmp/.X11-unix/X99" ] || {
			echo "ERRO: Xvfb $DISPLAY_AGENTE nao subiu; veja /tmp/xvfb99.log" >&2
			exit 2
		}
	fi
	export DISPLAY="$DISPLAY_AGENTE"
fi

# A dependencia se instala sozinha na primeira vez: pedir ao dono que rode
# `npm install` antes e' terceirizar um passo que o script sabe fazer.
if [ ! -d "$APP/node_modules/playwright-core" ]; then
	echo "instalando a dependencia (playwright-core, sem baixar navegador)..." >&2
	(cd "$APP" && npm install --no-audit --no-fund --silent) || {
		echo "ERRO: falhou instalar playwright-core em $APP" >&2
		exit 2
	}
fi

exec node "$APP/coletar.mjs" "$@"
