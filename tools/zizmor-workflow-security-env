#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_ZIZMOR_WORKFLOW_SECURITY_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/zizmor-workflow-security-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-zizmor-workflow-security-venv"
if [[ -n "${WIKI_ZIZMOR_WORKFLOW_SECURITY_VENV:-}" ]]; then
	VENV="$WIKI_ZIZMOR_WORKFLOW_SECURITY_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
REQ="$ROOT/tools/requirements-zizmor-workflow-security.txt"

if [[ ! -x "$PY" ]]; then
	python3 -m venv "$VENV"
fi

REQ_HASH="$(sha256sum "$REQ" | awk '{print $1}')"
PY_MARKER="$VENV/.requirements-zizmor-workflow-security-$REQ_HASH.ok"
if [[ ! -f "$PY_MARKER" ]]; then
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 "$PY" -m pip install --disable-pip-version-check --prefer-binary -r "$REQ"
	rm -f "$VENV"/.requirements-zizmor-workflow-security-*.ok
	touch "$PY_MARKER"
fi

export WIKI_ZIZMOR_WORKFLOW_SECURITY_PYTHON="$PY"
export WIKI_ZIZMOR_WORKFLOW_SECURITY_BIN="$VENV/bin/zizmor"
export PATH="$VENV/bin:$PATH"
exec "$@"
