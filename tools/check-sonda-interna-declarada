#!/usr/bin/env python3
"""check-sonda-interna-declarada — nenhuma sonda NOSSA entra na metrica do portal.

O FATO QUE ORIGINOU ESTE GATE, E A REFUTACAO QUE ELE CARREGA
------------------------------------------------------------
O plano de 2026-09-15 (§13.4d) registrou: *"22 dos 245 tool-calls internos saem
com `Mozilla/5.0 (compatible; WikijuridicaBot/1.0; ...)` — a identidade de SAIDA
aplicada contra a NOSSA propria superficie. Deveria ser
`wikijuridicabot.AplicaSondaInterna`, que escreve tambem `X-Warming-Request`.
Sem ele a sonda entra na metrica — e' o 'portal mede o proprio eco' em carne e
osso."*

A MEDICAO REFUTA A SEGUNDA METADE. Varrendo `data/ops/access/access-*.jsonl`
inteiro em 2026-09-16: **9.236 requisicoes com o User-Agent do WikijuridicaBot
contra a nossa propria origem, e 9.236 de 9.236 (100%) carregam
`X-Warming-Request`**. Zero entraram na metrica. Dos 22 `tools/call` que o plano
nomeia, os 22 tambem carregam. O portal NAO estava medindo o proprio eco.

O QUE E' REAL, ENTAO, E POR QUE ISTO VIROU GATE EM VEZ DE CORRECAO DE CODIGO
---------------------------------------------------------------------------
Os 22 nao vieram de arquivo nenhum do repositorio: vieram de uma sessao de
investigacao em PLAN MODE, que compos o cabecalho a mao — o proposito
`inventario-superficies` nao existe em `tools/`, `internal/` nem `cmd/` (grep
sem nenhuma ocorrencia), e esta declarado no proprio anexo daquela colheita. Nao
ha linha de codigo a corrigir, e inventar uma para "fechar o achado" seria
escrever correcao de um defeito que nao existe.

O que existe e' FRAGILIDADE: o invariante "sonda nossa nao conta" depende hoje de
cada agente LEMBRAR de mandar o cabecalho. Funcionou 9.236 vezes seguidas, e
nenhuma delas por construcao. Guarda e' exatamente o que transforma "lembrar" em
"impossivel passar despercebido".

O ZERO DE HOJE E' DECLARADO, e por isso o teste deste gate traz um CONTROLE
POSITIVO sintetico: um gate cujo unico resultado observado e' zero pode estar
certo ou pode estar quebrado, e os dois se parecem. A prova de que ele acusa e'
o caso sintetico, nao o silencio do corpus.

O QUE REPROVA (exit 1)
  requisicao ao NOSSO log de acesso com identidade NOSSA no User-Agent
  (`WikijuridicaBot` ou o prefixo `wikijuridica-`) e SEM `warming` nem
  `bot_simulation` — ou seja, sonda nossa contada como visita.

O QUE OBSERVA, SEM REPROVAR
  proposito de saida usado em sonda interna. `AplicaSondaInterna` escreve
  `sonda-interna`; qualquer outro proposito e' cabecalho composto a mao, que
  funciona mas nao e' o caminho unico — e e' de cabecalho composto a mao que
  nasce o dia em que alguem esquece o `X-Warming-Request`. Sai listado para ficar
  visivel, nao para ficar vermelho: gate que fica vermelho por higiene deixa de
  ser lido, e ai o vermelho que importa entra junto.

SAIDA
  exit 0 = nenhuma sonda nossa na metrica
  exit 1 = VEREDITO: ha sonda nossa contada como visita
  exit 2 = NAO MEDIU: nenhum arquivo de acesso, diretorio ilegivel

Uso:
    tools/check-sonda-interna-declarada
    tools/check-sonda-interna-declarada --raiz /caminho/de/teste --json
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import sys

RAIZ_PADRAO = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
ACCESS_GLOB = "data/ops/access/access-*.jsonl"

# As duas formas da identidade NOSSA que chegam ao nosso proprio log. A primeira
# e' a identidade de SAIDA (internal/wikijuridicabot); a segunda e' o prefixo das
# sondas de superficie que o contrato nomeia (`wikijuridica-superficie-probe`,
# `wikijuridica-agent-surface-probe`). Um terceiro que se chamasse "wikijuridica"
# seria usurpacao de identidade NOSSA e um problema diferente, com dono proprio.
MARCAS_PROPRIAS = ("wikijuridicabot", "wikijuridica-")

# O proposito que `wikijuridicabot.AplicaSondaInterna` escreve. Qualquer outro em
# sonda interna e' cabecalho composto a mao.
PROPOSITO_CORRETO = "sonda-interna"

# Teto de exemplos impressos. Lista completa vai no --json; despejar milhares de
# linhas no journal e' como um alerta deixa de ser lido.
EXEMPLOS = 10

# JANELA PADRAO, EM DIAS DE ARQUIVO. O diretorio de acesso tem 1,1 GB e cresce
# ~2 MB por dia; varre-lo inteiro a cada execucao de um gate DIARIO e' pagar o
# historico todo para responder sobre ontem. Sete arquivos cobrem com folga o
# intervalo entre duas execucoes e qualquer fim de semana perdido. `--todos`
# varre o corpus inteiro, e e' o que se usa para auditoria — a JANELA SAI
# IMPRESSA justamente para ninguem ler "VERDE" achando que ele olhou tudo.
JANELA_PADRAO = 7

# DIAS DE FLUXO. O ledger de acesso e' APPEND-ONLY: linha que ja entrou nao sai,
# e um gate que reprovasse pelo NIVEL da janela ficaria vermelho por dias depois
# de a causa estar corrigida — divida que nada drena, que e' como um gate deixa
# de ser lido. Entao o VEREDITO e' sobre o fluxo (os dias mais recentes, onde a
# sonda de hoje aparece) e o resto da janela sai como NIVEL, datado, sem
# reprovar. Dois dias porque o gate roda diariamente e um dia perdido nao pode
# abrir buraco.
DIAS_DE_FLUXO = 2


class NaoMediu(Exception):
    """O gate nao conseguiu executar. Vira exit 2, nunca veredito."""


def proposito_de(user_agent):
    """O proposito declarado no fim do User-Agent canonico, ou None."""
    if "wikijuridicabot" not in user_agent.lower():
        return None
    corpo = user_agent.rsplit(";", 1)[-1].strip()
    corpo = corpo.rstrip(")").strip()
    return corpo or None


def analisa(raiz, janela=JANELA_PADRAO, dias_de_fluxo=DIAS_DE_FLUXO):
    arquivos = sorted(glob.glob(os.path.join(raiz, ACCESS_GLOB)))
    if not arquivos:
        raise NaoMediu("nenhum arquivo em %s: sem log nao ha o que conferir, e "
                       "'nao conferi' nunca pode virar 'esta tudo certo'" % ACCESS_GLOB)
    disponiveis = len(arquivos)
    if janela:
        arquivos = arquivos[-janela:]

    total_proprias = 0
    na_metrica = []
    propositos = {}
    for caminho in arquivos:
        try:
            with open(caminho, encoding="utf-8", errors="replace") as arquivo:
                for numero, linha in enumerate(arquivo, 1):
                    linha = linha.strip()
                    if not linha:
                        continue
                    try:
                        registro = json.loads(linha)
                    except json.JSONDecodeError:
                        continue
                    agente = registro.get("user_agent") or ""
                    baixo = agente.lower()
                    if not any(marca in baixo for marca in MARCAS_PROPRIAS):
                        continue
                    total_proprias += 1
                    proposito = proposito_de(agente) or "(sonda de superficie)"
                    propositos[proposito] = propositos.get(proposito, 0) + 1
                    if registro.get("warming") or registro.get("bot_simulation"):
                        continue
                    na_metrica.append({
                        "arquivo": os.path.relpath(caminho, raiz),
                        "linha": numero,
                        "ts": registro.get("ts"),
                        "path": registro.get("path"),
                        "user_agent": agente,
                        "proposito": proposito,
                    })
        except OSError as erro:
            raise NaoMediu("nao consegui ler %s: %s" % (caminho, erro))

    # A FRONTEIRA ENTRE FLUXO E NIVEL e' derivada dos dias PRESENTES no log, nao
    # do relogio: um gate que perguntasse "hoje" numa maquina que ficou desligada
    # chamaria de historico exatamente o dia que precisava julgar.
    dias_vistos = sorted({(a["ts"] or "")[:10] for a in na_metrica if a.get("ts")})
    dias_do_log = sorted({os.path.basename(c)[len("access-"):-len(".jsonl")]
                          for c in arquivos})
    corte = dias_do_log[-dias_de_fluxo] if len(dias_do_log) >= dias_de_fluxo else (
        dias_do_log[0] if dias_do_log else "")
    fluxo = [a for a in na_metrica if (a["ts"] or "")[:10] >= corte]
    nivel = [a for a in na_metrica if (a["ts"] or "")[:10] < corte]

    compostos_a_mao = {
        nome: quantas for nome, quantas in propositos.items()
        if nome not in (PROPOSITO_CORRETO, "(sonda de superficie)")
    }
    return {
        "arquivos": len(arquivos),
        "arquivos_disponiveis": disponiveis,
        "janela_em_dias": janela or disponiveis,
        "primeiro_arquivo": os.path.basename(arquivos[0]),
        "ultimo_arquivo": os.path.basename(arquivos[-1]),
        "requisicoes_com_identidade_propria": total_proprias,
        "dias_de_fluxo": dias_de_fluxo,
        "corte_do_fluxo": corte,
        "na_metrica": na_metrica,
        "na_metrica_fluxo": fluxo,
        "na_metrica_nivel": nivel,
        "dias_com_ocorrencia": dias_vistos,
        "propositos": dict(sorted(propositos.items(), key=lambda par: -par[1])),
        "propositos_compostos_a_mao": dict(
            sorted(compostos_a_mao.items(), key=lambda par: -par[1])),
    }


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Reprova quando uma sonda do proprio portal entra na metrica "
                    "de audiencia (identidade nossa sem X-Warming-Request).")
    parser.add_argument("--raiz", default=RAIZ_PADRAO)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--dias", type=int, default=JANELA_PADRAO,
                        help="quantos arquivos diarios varrer (padrao: %(default)s)")
    parser.add_argument("--todos", action="store_true",
                        help="varre o corpus inteiro (auditoria; o padrao e' a janela)")
    parser.add_argument("--dias-de-fluxo", type=int, default=DIAS_DE_FLUXO,
                        help="quantos dias finais reprovam; o resto vira nivel "
                             "datado (padrao: %(default)s)")
    args = parser.parse_args(argv)

    try:
        relatorio = analisa(args.raiz, None if args.todos else max(1, args.dias),
                            max(1, args.dias_de_fluxo))
    except NaoMediu as erro:
        print("check-sonda-interna-declarada: NAO MEDIU — %s" % erro, file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(relatorio, ensure_ascii=False, indent=2, sort_keys=True))
        return 1 if relatorio["na_metrica_fluxo"] else 0

    print("=== SONDA INTERNA FORA DA METRICA ===")
    # A JANELA SAI IMPRESSA. "VERDE" sobre 7 dias e "VERDE" sobre o corpus
    # inteiro sao afirmacoes diferentes, e imprimir so' o veredito faria a
    # segunda parecer a primeira — guarda que esconde o que filtra.
    print("janela              : %d de %d arquivo(s) diario(s) — %s .. %s"
          % (relatorio["arquivos"], relatorio["arquivos_disponiveis"],
             relatorio["primeiro_arquivo"], relatorio["ultimo_arquivo"]))
    print("req. com identidade nossa: %d" % relatorio["requisicoes_com_identidade_propria"])
    print("na metrica (janela) : %d — fluxo %d (a partir de %s) · nivel historico %d"
          % (len(relatorio["na_metrica"]), len(relatorio["na_metrica_fluxo"]),
             relatorio["corte_do_fluxo"], len(relatorio["na_metrica_nivel"])))
    if relatorio["na_metrica_nivel"]:
        print("   o nivel historico NAO reprova: o ledger e' append-only e a linha que "
              "ja entrou nao sai. Dias com ocorrencia: %s"
              % ", ".join(relatorio["dias_com_ocorrencia"]))
    if relatorio["propositos_compostos_a_mao"]:
        total = sum(relatorio["propositos_compostos_a_mao"].values())
        print("propositos compostos a mao: %d req em %d proposito(s) — nenhum e' "
              "defeito enquanto o cabecalho estiver la, mas o caminho unico e' "
              "wikijuridicabot.AplicaSondaInterna:"
              % (total, len(relatorio["propositos_compostos_a_mao"])))
        for nome, quantas in list(relatorio["propositos_compostos_a_mao"].items())[:EXEMPLOS]:
            print("   %6d  %s" % (quantas, nome))
    if not relatorio["na_metrica_fluxo"]:
        print("veredito            : VERDE — nenhuma sonda nossa entrou na metrica "
              "nos %d dia(s) de fluxo" % relatorio["dias_de_fluxo"])
        return 0

    print("veredito            : VERMELHO — %d requisicao(oes) nossa(s) contada(s) "
          "como visita no fluxo" % len(relatorio["na_metrica_fluxo"]))
    print()
    for achado in relatorio["na_metrica_fluxo"][:EXEMPLOS]:
        print("%s:%d  %s  %s" % (achado["arquivo"], achado["linha"],
                                 achado["ts"], achado["path"]))
        print("    User-Agent: %s" % achado["user_agent"])
    if len(relatorio["na_metrica_fluxo"]) > EXEMPLOS:
        print("... e mais %d (use --json para a lista inteira)"
              % (len(relatorio["na_metrica_fluxo"]) - EXEMPLOS))
    print()
    print("A correcao e' no PONTO DE SAIDA, nunca no filtro: sonda do proprio portal")
    print("usa wikijuridicabot.AplicaSondaInterna (Go) ou manda")
    print("`-A 'wikijuridica-superficie-probe/1.0' -H 'X-Warming-Request: true'`.")
    print("Excluir a linha depois seria maquiar a metrica em vez de consertar a sonda.")
    return 1


if __name__ == "__main__":
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
    from saida_de_medidor import main_protegido

    main_protegido(main)
