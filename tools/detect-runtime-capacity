#!/usr/bin/env python3
"""Detect live CPU worker capacity without imposing an arbitrary ceiling.

The default interface prints one positive integer to stdout only when live
evidence is complete, plus a versioned JSON evidence record to stderr.
Unavailable evidence returns non-zero with no integer.  ``--format json``
prints only the evidence record, which is useful to schedulers and tests.  The
probe is read-only and one-shot: it never sleeps or polls.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import stat
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable


SCHEMA_VERSION = 1
DEFAULT_PROC_ROOT = Path("/proc")
DEFAULT_SYS_ROOT = Path("/sys")
DEFAULT_CGROUP_ROOT = Path("/sys/fs/cgroup")
MAX_OBSERVATION_BYTES = 4 * 1024 * 1024
READ_CHUNK_BYTES = 64 * 1024


class ConfigurationError(ValueError):
    """Raised for an invalid operator-controlled setting."""


@dataclass(frozen=True)
class CgroupMount:
    filesystem: str
    root: str
    mountpoint: Path
    controllers: frozenset[str]


@dataclass(frozen=True)
class CPUIntervals:
    """A normalized, non-expanding representation of a Linux CPU list."""

    ranges: tuple[tuple[int, int], ...]

    @classmethod
    def from_values(cls, values: Iterable[int]) -> "CPUIntervals":
        return cls.from_ranges((value, value) for value in values)

    @classmethod
    def from_ranges(
        cls,
        values: Iterable[tuple[int, int]],
    ) -> "CPUIntervals":
        ordered = sorted(values)
        merged: list[tuple[int, int]] = []
        for start, end in ordered:
            if start < 0 or end < start:
                raise ValueError("invalid CPU interval")
            if not merged or start > merged[-1][1] + 1:
                merged.append((start, end))
                continue
            previous_start, previous_end = merged[-1]
            merged[-1] = (previous_start, max(previous_end, end))
        return cls(tuple(merged))

    @property
    def count(self) -> int:
        return sum(end - start + 1 for start, end in self.ranges)

    def intersection(self, other: "CPUIntervals") -> "CPUIntervals":
        left_index = 0
        right_index = 0
        result: list[tuple[int, int]] = []
        while left_index < len(self.ranges) and right_index < len(other.ranges):
            left_start, left_end = self.ranges[left_index]
            right_start, right_end = other.ranges[right_index]
            start = max(left_start, right_start)
            end = min(left_end, right_end)
            if start <= end:
                result.append((start, end))
            if left_end < right_end:
                left_index += 1
            else:
                right_index += 1
        return CPUIntervals(tuple(result))

    def __bool__(self) -> bool:
        return bool(self.ranges)


def parse_cpu_list(raw: str) -> CPUIntervals:
    """Parse Linux CPU-list syntax such as ``0-3,8,10-12``."""

    raw = raw.strip()
    if not raw:
        return CPUIntervals(())
    ranges: list[tuple[int, int]] = []
    for item in raw.split(","):
        item = item.strip()
        if not item:
            raise ValueError("empty CPU-list component")
        if "-" in item:
            if item.count("-") != 1:
                raise ValueError(f"invalid CPU range {item!r}")
            start_raw, end_raw = item.split("-", 1)
            if not re.fullmatch(r"[0-9]+", start_raw) or not re.fullmatch(
                r"[0-9]+", end_raw
            ):
                raise ValueError(f"invalid CPU range {item!r}")
            try:
                start, end = int(start_raw), int(end_raw)
            except ValueError as exc:
                raise ValueError(f"invalid CPU range {item!r}") from exc
            if end < start:
                raise ValueError(f"descending CPU range {item!r}")
            ranges.append((start, end))
            continue
        if not re.fullmatch(r"[0-9]+", item):
            raise ValueError(f"invalid CPU identifier {item!r}")
        try:
            value = int(item)
        except ValueError as exc:
            raise ValueError(f"invalid CPU identifier {item!r}") from exc
        ranges.append((value, value))
    return CPUIntervals.from_ranges(ranges)


def _path_parts_beneath(root: Path, path: Path) -> tuple[str, ...]:
    root_abs = Path(os.path.abspath(root))
    path_abs = Path(os.path.abspath(path))
    try:
        relative = path_abs.relative_to(root_abs)
    except ValueError as exc:
        raise OSError("observation path is outside its trusted root") from exc
    if any(part in {"", ".", ".."} for part in relative.parts):
        raise OSError("observation path contains an unsafe component")
    return relative.parts


def _open_directory_beneath(root: Path, directory: Path) -> int:
    parts = _path_parts_beneath(root, directory)
    directory_flags = (
        os.O_RDONLY
        | os.O_CLOEXEC
        | os.O_DIRECTORY
        | os.O_NOFOLLOW
        | os.O_NONBLOCK
    )
    descriptor = os.open(os.path.abspath(root), directory_flags)
    try:
        for part in parts:
            child = os.open(part, directory_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _read_text(
    path: Path,
    *,
    root: Path,
    errors: list[str],
    code: str,
    missing_ok: bool = False,
) -> str | None:
    directory_descriptor = -1
    descriptor = -1
    try:
        directory_descriptor = _open_directory_beneath(root, path.parent)
        descriptor = os.open(
            path.name,
            os.O_RDONLY
            | os.O_CLOEXEC
            | os.O_NOFOLLOW
            | os.O_NONBLOCK,
            dir_fd=directory_descriptor,
        )
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            _record_error(errors, f"{code}_not_regular")
            return None
        if metadata.st_size > MAX_OBSERVATION_BYTES:
            _record_error(errors, f"{code}_too_large")
            return None
        chunks: list[bytes] = []
        size = 0
        while True:
            chunk = os.read(
                descriptor,
                min(READ_CHUNK_BYTES, MAX_OBSERVATION_BYTES + 1 - size),
            )
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > MAX_OBSERVATION_BYTES:
                _record_error(errors, f"{code}_too_large")
                return None
        try:
            return b"".join(chunks).decode("utf-8", errors="strict").strip()
        except UnicodeError:
            _record_error(errors, f"{code}_invalid_utf8")
            return None
    except FileNotFoundError:
        if not missing_ok:
            _record_error(errors, f"{code}_missing")
        return None
    except OSError:
        _record_error(errors, f"{code}_unreadable")
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if directory_descriptor >= 0:
            os.close(directory_descriptor)


def _is_directory_beneath(
    path: Path,
    *,
    root: Path,
    errors: list[str],
    code: str,
) -> bool:
    descriptor = -1
    try:
        descriptor = _open_directory_beneath(root, path)
        return stat.S_ISDIR(os.fstat(descriptor).st_mode)
    except OSError:
        _record_error(errors, code)
        return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _record_error(errors: list[str], code: str) -> None:
    if code not in errors:
        errors.append(code)


def _parse_cpu_file(
    path: Path,
    *,
    root: Path,
    errors: list[str],
    code: str,
) -> CPUIntervals | None:
    raw = _read_text(path, root=root, errors=errors, code=code)
    if raw is None or raw == "":
        return None
    try:
        return parse_cpu_list(raw)
    except ValueError:
        _record_error(errors, f"{code}_invalid")
        return None


def _proc_self_root(proc_root: Path) -> Path:
    # Avoid following the magic /proc/self symlink.  Test fixtures use a real
    # `self` directory, while the live procfs path can address this PID exactly.
    if proc_root == DEFAULT_PROC_ROOT:
        return proc_root / str(os.getpid())
    return proc_root / "self"


def detect_online_cpus(
    sys_root: Path,
    proc_root: Path,
    errors: list[str],
) -> CPUIntervals | None:
    online = _parse_cpu_file(
        sys_root / "devices/system/cpu/online",
        root=sys_root,
        errors=errors,
        code="online_cpu_list",
    )
    if online:
        return online

    raw_stat = _read_text(
        proc_root / "stat",
        root=proc_root,
        errors=errors,
        code="proc_stat",
    )
    if raw_stat:
        found = CPUIntervals.from_values(
            int(match.group(1))
            for line in raw_stat.splitlines()
            if (match := re.match(r"^cpu([0-9]+)\s", line))
        )
        if found:
            return found

    if proc_root == DEFAULT_PROC_ROOT and sys_root == DEFAULT_SYS_ROOT:
        try:
            count = int(os.sysconf("SC_NPROCESSORS_ONLN"))
        except (OSError, ValueError, TypeError):
            count = 0
        if count > 0:
            return CPUIntervals.from_ranges(((0, count - 1),))

    _record_error(errors, "online_cpu_count_unavailable")
    return None


def detect_affinity_cpus(
    proc_root: Path,
    errors: list[str],
) -> CPUIntervals | None:
    candidates: list[CPUIntervals] = []
    raw_status = _read_text(
        _proc_self_root(proc_root) / "status",
        root=proc_root,
        errors=errors,
        code="proc_self_status",
    )
    if raw_status:
        for line in raw_status.splitlines():
            if not line.startswith("Cpus_allowed_list:"):
                continue
            raw = line.split(":", 1)[1].strip()
            try:
                parsed = parse_cpu_list(raw)
            except ValueError:
                _record_error(errors, "affinity_cpu_list_invalid")
                break
            if parsed:
                candidates.append(parsed)
            break

    if proc_root == DEFAULT_PROC_ROOT and hasattr(os, "sched_getaffinity"):
        try:
            native = CPUIntervals.from_values(os.sched_getaffinity(0))
        except OSError:
            native = CPUIntervals(())
        if native:
            candidates.append(native)

    if not candidates:
        _record_error(errors, "affinity_cpu_list_unavailable")
        return None
    allowed = candidates[0]
    for candidate in candidates[1:]:
        allowed = allowed.intersection(candidate)
    if not allowed:
        _record_error(errors, "affinity_cpu_intersection_empty")
        return None
    return allowed


def _unescape_mountinfo(value: str) -> str:
    return re.sub(
        r"\\([0-7]{3})",
        lambda match: chr(int(match.group(1), 8)),
        value,
    )


def parse_mountinfo(proc_root: Path, errors: list[str]) -> list[CgroupMount]:
    raw = _read_text(
        _proc_self_root(proc_root) / "mountinfo",
        root=proc_root,
        errors=errors,
        code="proc_self_mountinfo",
        missing_ok=True,
    )
    if not raw:
        return []
    mounts: list[CgroupMount] = []
    for line in raw.splitlines():
        if " - " not in line:
            continue
        left_raw, right_raw = line.split(" - ", 1)
        left, right = left_raw.split(), right_raw.split()
        if len(left) < 6 or len(right) < 3:
            continue
        filesystem = right[0]
        if filesystem not in {"cgroup", "cgroup2"}:
            continue
        controllers: set[str] = set()
        if filesystem == "cgroup":
            for raw_options in (left[5], right[2]):
                controllers.update(
                    option
                    for option in raw_options.split(",")
                    if option in {"cpu", "cpuacct", "cpuset"}
                )
        mounts.append(
            CgroupMount(
                filesystem=filesystem,
                root=_unescape_mountinfo(left[3]),
                mountpoint=Path(_unescape_mountinfo(left[4])),
                controllers=frozenset(controllers),
            )
        )
    return mounts


def parse_cgroup_memberships(
    proc_root: Path,
    errors: list[str],
) -> tuple[str | None, dict[str, str]]:
    raw = _read_text(
        _proc_self_root(proc_root) / "cgroup",
        root=proc_root,
        errors=errors,
        code="proc_self_cgroup",
    )
    if not raw:
        _record_error(errors, "cgroup_membership_unavailable")
        return None, {}
    v2_path: str | None = None
    memberships: dict[str, str] = {}
    for line in raw.splitlines():
        fields = line.split(":", 2)
        if len(fields) != 3:
            _record_error(errors, "cgroup_membership_invalid")
            continue
        hierarchy, controllers_raw, membership = fields
        if hierarchy == "0" and controllers_raw == "":
            v2_path = membership
            continue
        for controller in controllers_raw.split(","):
            if controller:
                memberships[controller] = membership
    return v2_path, memberships


def _safe_cgroup_join(mount: CgroupMount, membership: str) -> Path | None:
    if not membership.startswith("/") or not mount.root.startswith("/"):
        return None
    if "\x00" in membership or "\x00" in mount.root:
        return None
    if not mount.mountpoint.is_absolute():
        return None
    if mount.root == "/":
        relative = membership.lstrip("/")
    elif membership == mount.root:
        relative = ""
    elif membership.startswith(mount.root.rstrip("/") + "/"):
        relative = membership[len(mount.root) :].lstrip("/")
    else:
        return None
    relative_parts = tuple(part for part in relative.split("/") if part not in {"", "."})
    if any(part == ".." for part in relative_parts):
        return None
    return mount.mountpoint.joinpath(*relative_parts)


def _ancestors(current: Path, stop: Path) -> Iterable[Path]:
    current_abs = Path(os.path.abspath(current))
    stop_abs = Path(os.path.abspath(stop))
    try:
        if os.path.commonpath((str(current_abs), str(stop_abs))) != str(stop_abs):
            return
    except ValueError:
        return
    cursor = current_abs
    while True:
        yield cursor
        if cursor == stop_abs:
            return
        parent = cursor.parent
        if parent == cursor:
            return
        cursor = parent


def _intersect_cpu_sets(
    values: Iterable[CPUIntervals],
) -> CPUIntervals | None:
    result: CPUIntervals | None = None
    for value in values:
        if not value:
            continue
        if result is None:
            result = value
        else:
            result = result.intersection(value)
    return result


def _read_cpuset_hierarchy(
    current: Path,
    mountpoint: Path,
    errors: list[str],
) -> CPUIntervals | None:
    effective: list[CPUIntervals] = []
    configured: list[CPUIntervals] = []
    for directory in _ancestors(current, mountpoint):
        for filename, destination in (
            ("cpuset.cpus.effective", effective),
            ("cpuset.effective_cpus", effective),
            ("cpuset.cpus", configured),
        ):
            path = directory / filename
            raw = _read_text(
                path,
                root=mountpoint,
                errors=errors,
                code="cgroup_cpuset",
                missing_ok=True,
            )
            if raw is None or raw == "":
                continue
            try:
                destination.append(parse_cpu_list(raw))
            except ValueError:
                _record_error(errors, "cgroup_cpuset_invalid")
    selected = _intersect_cpu_sets(effective or configured)
    if selected is not None and not selected:
        _record_error(errors, "cgroup_cpuset_intersection_empty")
        return None
    return selected


def _read_v2_quota(
    current: Path,
    mountpoint: Path,
    errors: list[str],
) -> float | None:
    limits: list[float] = []
    for directory in _ancestors(current, mountpoint):
        path = directory / "cpu.max"
        raw = _read_text(
            path,
            root=mountpoint,
            errors=errors,
            code="cgroup_v2_cpu_max",
            missing_ok=True,
        )
        if raw is None:
            continue
        if raw == "":
            _record_error(errors, "cgroup_v2_cpu_max_invalid")
            continue
        fields = raw.split()
        if len(fields) != 2:
            _record_error(errors, "cgroup_v2_cpu_max_invalid")
            continue
        try:
            period = positive_integer(fields[1], "cgroup v2 CPU period")
        except ConfigurationError:
            _record_error(errors, "cgroup_v2_cpu_max_invalid")
            continue
        if fields[0] == "max":
            continue
        try:
            quota = positive_integer(fields[0], "cgroup v2 CPU quota")
            capacity = quota / period
        except (ConfigurationError, OverflowError):
            _record_error(errors, "cgroup_v2_cpu_max_invalid")
            continue
        if not math.isfinite(capacity) or capacity <= 0:
            _record_error(errors, "cgroup_v2_cpu_max_invalid")
            continue
        limits.append(capacity)
    return min(limits) if limits else None


def _read_v1_quota(
    current: Path,
    mountpoint: Path,
    errors: list[str],
) -> float | None:
    limits: list[float] = []
    for directory in _ancestors(current, mountpoint):
        quota_raw = _read_text(
            directory / "cpu.cfs_quota_us",
            root=mountpoint,
            errors=errors,
            code="cgroup_v1_cpu_quota",
            missing_ok=True,
        )
        period_raw = _read_text(
            directory / "cpu.cfs_period_us",
            root=mountpoint,
            errors=errors,
            code="cgroup_v1_cpu_period",
            missing_ok=True,
        )
        if quota_raw is None and period_raw is None:
            continue
        quota_value = quota_raw or ""
        period_value = period_raw or ""
        if not re.fullmatch(r"-?[0-9]+", quota_value) or not re.fullmatch(
            r"[0-9]+", period_value
        ):
            _record_error(errors, "cgroup_v1_cpu_quota_invalid")
            continue
        try:
            quota = int(quota_value)
            period = int(period_value)
        except ValueError:
            _record_error(errors, "cgroup_v1_cpu_quota_invalid")
            continue
        if quota < 0:
            continue
        if quota == 0 or period <= 0:
            _record_error(errors, "cgroup_v1_cpu_quota_invalid")
            continue
        try:
            capacity = quota / period
        except OverflowError:
            _record_error(errors, "cgroup_v1_cpu_quota_invalid")
            continue
        if not math.isfinite(capacity) or capacity <= 0:
            _record_error(errors, "cgroup_v1_cpu_quota_invalid")
            continue
        limits.append(capacity)
    return min(limits) if limits else None


def detect_cgroup_constraints(
    proc_root: Path,
    cgroup_root: Path,
    errors: list[str],
) -> tuple[str, CPUIntervals | None, float | None, list[str]]:
    mounts = parse_mountinfo(proc_root, errors)
    v2_path, memberships = parse_cgroup_memberships(proc_root, errors)
    evidence_paths: list[str] = []

    if v2_path is not None:
        mount_and_current = next(
            (
                (item, current)
                for item in mounts
                if item.filesystem == "cgroup2"
                if (current := _safe_cgroup_join(item, v2_path)) is not None
            ),
            None,
        )
        if mount_and_current is None:
            controllers = _read_text(
                cgroup_root / "cgroup.controllers",
                root=cgroup_root,
                errors=errors,
                code="cgroup_v2_controllers",
                missing_ok=True,
            )
            if controllers is not None:
                mount = CgroupMount("cgroup2", "/", cgroup_root, frozenset())
                current = _safe_cgroup_join(mount, v2_path)
                mount_and_current = (
                    (mount, current) if current is not None else None
                )
        if mount_and_current is None:
            _record_error(errors, "cgroup_v2_mount_unavailable")
            return "v2", None, None, evidence_paths
        mount, current = mount_and_current
        if not _is_directory_beneath(
            current,
            root=mount.mountpoint,
            errors=errors,
            code="cgroup_v2_membership_path_unavailable",
        ):
            return "v2", None, None, evidence_paths
        evidence_paths.append(str(current))
        return (
            "v2",
            _read_cpuset_hierarchy(current, mount.mountpoint, errors),
            _read_v2_quota(current, mount.mountpoint, errors),
            evidence_paths,
        )

    cpu_membership = memberships.get("cpu")
    cpuset_membership = memberships.get("cpuset")
    cpu_mount_and_current = next(
        (
            (item, current)
            for item in mounts
            if item.filesystem == "cgroup" and "cpu" in item.controllers
            if cpu_membership is not None
            if (current := _safe_cgroup_join(item, cpu_membership)) is not None
        ),
        None,
    )
    cpuset_mount_and_current = next(
        (
            (item, current)
            for item in mounts
            if item.filesystem == "cgroup" and "cpuset" in item.controllers
            if cpuset_membership is not None
            if (current := _safe_cgroup_join(item, cpuset_membership)) is not None
        ),
        None,
    )
    if cpu_mount_and_current is None and cpu_membership is not None:
        candidate = CgroupMount("cgroup", "/", cgroup_root / "cpu", frozenset({"cpu"}))
        current = _safe_cgroup_join(candidate, cpu_membership)
        if current is not None and _is_directory_beneath(
            current,
            root=candidate.mountpoint,
            errors=[],
            code="ignored",
        ):
            cpu_mount_and_current = (candidate, current)
    if cpuset_mount_and_current is None and cpuset_membership is not None:
        candidate = CgroupMount(
            "cgroup", "/", cgroup_root / "cpuset", frozenset({"cpuset"})
        )
        current = _safe_cgroup_join(candidate, cpuset_membership)
        if current is not None and _is_directory_beneath(
            current,
            root=candidate.mountpoint,
            errors=[],
            code="ignored",
        ):
            cpuset_mount_and_current = (candidate, current)

    if "cpu" in memberships and cpu_mount_and_current is None:
        _record_error(errors, "cgroup_v1_cpu_mount_unavailable")
    if "cpuset" in memberships and cpuset_mount_and_current is None:
        _record_error(errors, "cgroup_v1_cpuset_mount_unavailable")
    if cpu_mount_and_current is None and cpuset_mount_and_current is None:
        version = "v1" if memberships else "none"
        return version, None, None, evidence_paths

    quota: float | None = None
    cpuset: CPUIntervals | None = None
    if cpu_mount_and_current is not None:
        cpu_mount, current = cpu_mount_and_current
        if not _is_directory_beneath(
            current,
            root=cpu_mount.mountpoint,
            errors=errors,
            code="cgroup_v1_cpu_membership_path_unavailable",
        ):
            return "v1", None, None, evidence_paths
        evidence_paths.append(str(current))
        quota = _read_v1_quota(current, cpu_mount.mountpoint, errors)
    if cpuset_mount_and_current is not None:
        cpuset_mount, current = cpuset_mount_and_current
        if not _is_directory_beneath(
            current,
            root=cpuset_mount.mountpoint,
            errors=errors,
            code="cgroup_v1_cpuset_membership_path_unavailable",
        ):
            return "v1", None, quota, evidence_paths
        evidence_paths.append(str(current))
        cpuset = _read_cpuset_hierarchy(current, cpuset_mount.mountpoint, errors)
    return "v1", cpuset, quota, evidence_paths


def detect_load1(proc_root: Path, errors: list[str]) -> float | None:
    raw = _read_text(
        proc_root / "loadavg",
        root=proc_root,
        errors=errors,
        code="proc_loadavg",
    )
    if not raw:
        _record_error(errors, "load1_unavailable")
        return None
    try:
        load1 = float(raw.split()[0])
    except (IndexError, ValueError):
        _record_error(errors, "load1_invalid")
        return None
    if not math.isfinite(load1) or load1 < 0:
        _record_error(errors, "load1_invalid")
        return None
    return load1


def positive_integer(raw: str, name: str) -> int:
    if not re.fullmatch(r"[1-9][0-9]*", raw):
        raise ConfigurationError(f"{name} must be a positive integer")
    try:
        return int(raw)
    except ValueError as exc:
        raise ConfigurationError(f"{name} must be a positive integer") from exc


def conservative_ratio(raw: str) -> float:
    try:
        value = float(raw)
    except ValueError as exc:
        raise ConfigurationError("conservative ratio must be numeric") from exc
    if not math.isfinite(value) or value <= 0 or value > 1:
        raise ConfigurationError("conservative ratio must be in (0, 1]")
    return value


def build_evidence(args: argparse.Namespace) -> dict[str, object]:
    errors: list[str] = []
    proc_root = Path(args.proc_root)
    sys_root = Path(args.sys_root)
    cgroup_root = Path(args.cgroup_root)

    online = detect_online_cpus(sys_root, proc_root, errors)
    affinity = detect_affinity_cpus(proc_root, errors)
    cgroup_version, cpuset, quota, cgroup_paths = detect_cgroup_constraints(
        proc_root, cgroup_root, errors
    )
    load1 = detect_load1(proc_root, errors)

    allowed_sets = [value for value in (online, affinity, cpuset) if value is not None]
    allowed = _intersect_cpu_sets(allowed_sets)
    if online is None or affinity is None:
        allowed = None
    if allowed is not None and not allowed:
        _record_error(errors, "effective_cpu_intersection_empty")
        allowed = None

    allowed_count = allowed.count if allowed is not None else None
    raw_capacity: float | None = float(allowed_count) if allowed_count else None
    if quota is not None:
        raw_capacity = quota if raw_capacity is None else min(raw_capacity, quota)
    if raw_capacity is not None and raw_capacity <= 0:
        _record_error(errors, "effective_cpu_capacity_invalid")
        raw_capacity = None

    capacity_workers = math.ceil(raw_capacity) if raw_capacity is not None else None
    normalized_load: float | None = None
    busy_workers: int | None = None
    headroom: float | None = None
    auto_workers: int | None = None
    # Any malformed or unreadable observation makes the automatic decision
    # untrustworthy.  Keep an explicit operator override available, but never
    # silently turn partial machine evidence into optimistic concurrency.
    critical = (
        raw_capacity is None
        or load1 is None
        or online is None
        or affinity is None
        or bool(errors)
    )
    if not critical and online:
        normalized_load = min(raw_capacity, load1 * raw_capacity / online.count)
        busy_workers = min(capacity_workers, math.ceil(normalized_load))
        headroom = max(0.0, raw_capacity - normalized_load)
        auto_workers = max(1, capacity_workers - busy_workers)

    mode = args.mode
    ratio = args.conservative_ratio
    if args.override is not None:
        selected = args.override
        selection_source = "explicit_override"
        status = "degraded_override" if critical else "ok_override"
    elif critical:
        selected = None
        selection_source = "unavailable_fail_closed"
        status = "unavailable_fail_closed"
    elif mode == "conservative":
        assert auto_workers is not None
        selected = max(1, math.ceil(auto_workers * ratio))
        selection_source = "live_headroom_conservative_proportional"
        status = "ok"
    else:
        assert auto_workers is not None
        selected = auto_workers
        selection_source = "live_headroom"
        status = "ok"

    return {
        "schema_version": SCHEMA_VERSION,
        "status": status,
        "selected_cpu_workers": selected,
        "selection_source": selection_source,
        "mode": mode,
        "conservative_ratio": ratio if mode == "conservative" else None,
        "explicit_override": args.override,
        "online_cpu_count": online.count if online is not None else None,
        "affinity_cpu_count": affinity.count if affinity is not None else None,
        "cpuset_cpu_count": cpuset.count if cpuset is not None else None,
        "allowed_cpu_count": allowed_count,
        "quota_cpu_capacity": quota,
        "effective_cpu_capacity": raw_capacity,
        "effective_worker_ceiling": capacity_workers,
        "load1": load1,
        "normalized_load_cpu": normalized_load,
        "busy_worker_estimate": busy_workers,
        "headroom_cpu": headroom,
        "headroom_saturated": bool(
            not critical and auto_workers == 1 and headroom == 0
        ),
        "cgroup_version": cgroup_version,
        "cgroup_paths": cgroup_paths,
        "errors": sorted(errors),
        "probe_policy": "one_shot_no_sleep_no_poll",
        "go_runtime_policy": "leave_GOMAXPROCS_unset_unless_explicit_override",
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="detect cgroup/cpuset/affinity-aware runtime CPU capacity"
    )
    parser.add_argument("--format", choices=("integer", "json"), default="integer")
    parser.add_argument("--mode", choices=("auto", "conservative"), default=None)
    parser.add_argument("--override", default=None)
    parser.add_argument("--conservative-ratio", default=None)
    parser.add_argument("--proc-root", default=str(DEFAULT_PROC_ROOT))
    parser.add_argument("--sys-root", default=str(DEFAULT_SYS_ROOT))
    parser.add_argument("--cgroup-root", default=str(DEFAULT_CGROUP_ROOT))
    args = parser.parse_args(argv)

    mode = args.mode or os.environ.get("WIKI_RUNTIME_CAPACITY_MODE", "auto")
    if mode == "normal":
        mode = "auto"
    if mode not in {"auto", "conservative"}:
        raise ConfigurationError("mode must be auto or conservative")
    args.mode = mode

    override_raw = args.override
    if override_raw is None:
        override_raw = os.environ.get("WIKI_RUNTIME_CAPACITY_OVERRIDE")
    args.override = (
        positive_integer(override_raw, "override") if override_raw is not None else None
    )

    ratio_raw = args.conservative_ratio
    if ratio_raw is None:
        ratio_raw = os.environ.get("WIKI_RUNTIME_CAPACITY_CONSERVATIVE_RATIO", "0.5")
    args.conservative_ratio = conservative_ratio(ratio_raw)
    return args


def _requested_json_format(argv: list[str]) -> bool:
    for index, argument in enumerate(argv):
        if argument == "--format" and index + 1 < len(argv):
            return argv[index + 1] == "json"
        if argument.startswith("--format="):
            return argument.split("=", 1)[1] == "json"
    return False


def _emit_evidence(evidence: dict[str, object], *, json_format: bool) -> int:
    encoded = json.dumps(
        evidence,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )
    selected = evidence.get("selected_cpu_workers")
    available = isinstance(selected, int) and not isinstance(selected, bool) and selected > 0
    if json_format:
        print(encoded)
    else:
        if available:
            print(selected)
        print(f"detect-runtime-capacity: evidence={encoded}", file=sys.stderr)
    return 0 if available else 1


def main(argv: list[str]) -> int:
    try:
        args = parse_args(argv)
    except ConfigurationError as exc:
        evidence: dict[str, object] = {
            "schema_version": SCHEMA_VERSION,
            "status": "configuration_error",
            "selected_cpu_workers": None,
            "selection_source": "unavailable_configuration_error",
            "errors": ["configuration_error"],
            "error_detail": str(exc),
            "probe_policy": "one_shot_no_sleep_no_poll",
            "go_runtime_policy": "leave_GOMAXPROCS_unset_unless_explicit_override",
        }
        _emit_evidence(evidence, json_format=_requested_json_format(argv))
        return 2

    try:
        evidence = build_evidence(args)
    except Exception as exc:  # Fail closed even on an unforeseen read/parse fault.
        evidence = {
            "schema_version": SCHEMA_VERSION,
            "status": (
                "degraded_override"
                if args.override is not None
                else "unavailable_fail_closed"
            ),
            "selected_cpu_workers": args.override,
            "selection_source": (
                "explicit_override"
                if args.override is not None
                else "unavailable_fail_closed"
            ),
            "mode": args.mode,
            "explicit_override": args.override,
            "errors": [f"unexpected_probe_error:{type(exc).__name__}"],
            "probe_policy": "one_shot_no_sleep_no_poll",
            "go_runtime_policy": "leave_GOMAXPROCS_unset_unless_explicit_override",
        }

    return _emit_evidence(evidence, json_format=args.format == "json")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
