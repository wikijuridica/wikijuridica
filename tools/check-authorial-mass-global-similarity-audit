#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: check-authorial-mass-global-similarity-audit [flags]

Runs the authorial-mass-global-similarity-audit check through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

cd "$(dirname "$0")/.."
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="check:authorial-mass-global-similarity-audit:gocache:$GOCACHE"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-90000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=112}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-check_pass_or_report_issues_with_timings}"
# Os dois `go-modern test` abaixo são contract tests caros: cada um recompila e
# relinga o pacote (~504 pacotes no módulo), e um agente roda este check dezenas
# de vezes por sessão de redação — 3 execuções serializadas por chamada. Eles
# passam a rodar apenas quando a ENTRADA REAL deles muda: as fontes Go dos
# pacotes sob teste + o próprio teste de contrato + os artefatos
# data/editorial/authorial_mass_*.jsonl que os testes carregam ao vivo
# (LoadRecords("."), audit_test.go:940/947 e o fixture do contrato:75-84).
# O gate propriamente dito (run-check, última linha) continua SEM cache em toda
# invocação — o cache só evita repetir o mesmo veredito sobre bytes idênticos,
# nunca troca o veredito. Falha de teste não grava o marcador (set -e aborta
# antes), então estado vermelho sempre re-executa. WIKI_CONTRACT_TESTS_FORCE=1
# ignora o cache; `go-modern test ./...`/lab-cycle seguem cobrindo tudo.
CONTRACT_CACHE_DIR="$ROOT/.cache/check-authorial-mass-global-similarity-audit"
CONTRACT_MARKER="$CONTRACT_CACHE_DIR/contract-tests.key"
CONTRACT_KEY="$(
	{
		stat -c '%n %s %y' data/editorial/authorial_mass_*.jsonl 2>/dev/null || true
		sha256sum internal/authorialmassglobalsimilarity/*.go \
			internal/authorialmassstock/*.go \
			internal/contract/authorial/authorial_mass_global_similarity_audit_test.go \
			go.mod go.sum 2>/dev/null || true
	} | sha256sum | awk '{print $1}'
)"
CONTRACT_CACHED_KEY="$(cat "$CONTRACT_MARKER" 2>/dev/null || true)"
if [[ "${WIKI_CONTRACT_TESTS_FORCE:-0}" == "1" || "$CONTRACT_CACHED_KEY" != "$CONTRACT_KEY" ]]; then
	./tools/run-heavy-throttled go-modern test -count=1 ./internal/authorialmassglobalsimilarity -run 'Test(BuildRecordRecords|ValidateRecords|CandidateFrontier)'
	./tools/run-heavy-throttled go-modern test -count=1 ./internal/contract/authorial -run 'TestAuthorialMassGlobalSimilarityAudit'
	mkdir -p "$CONTRACT_CACHE_DIR"
	printf '%s\n' "$CONTRACT_KEY" >"$CONTRACT_MARKER"
else
	echo "check-authorial-mass-global-similarity-audit: contract tests já verdes para este estado (fontes+data inalterados, key ${CONTRACT_KEY:0:12}); WIKI_CONTRACT_TESTS_FORCE=1 para re-executar" >&2
fi
exec ./tools/run-heavy-throttled "$ROOT/tools/run-check" authorial-mass-global-similarity-audit --timings "$@"
