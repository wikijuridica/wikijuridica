FORA_DE_LOCATION = "(fora de location)"

# Palavras que de fato abrem bloco no nginx. Serve de guarda para nao ler
# `${variavel}` nem `{16}` de regex como se fossem bloco de uma linha.
ABREM_BLOCO = {
    "http", "server", "location", "if", "map", "types", "events", "upstream",
    "limit_except", "geo", "split_clients", "stream",
}


def diretivas_por_escopo(raizes):
    """escopo -> nome -> conjunto de linhas normalizadas, mais a origem de cada.

    CONJUNTO GLOBAL NAO E PARIDADE (2026-09-05). A comparacao era um set de
    linhas do arquivo inteiro, sem nocao de bloco — e o incidente que originou
    `test_paridade_bidirecional.sh` e precisamente esse: a mesma linha
    `more_set_headers -s '200 304' 'Vary: Accept-Encoding'` aparece 5 vezes no
    vivo e 6 no dedicado, entao tirar (ou por) uma delas NUM location nao muda
    o conjunto, e o gate dizia `pass` com a resposta real ja divergente.
    Comparar por location e o que torna a diferenca visivel.

    O escopo e a cadeia de `location` aninhados. Diretiva de nivel http/server
    cai em FORA_DE_LOCATION — inclusive a que vem de um arquivo `include`, que
    e lido do inicio e nao herda a pilha de quem o incluiu. Nao e perda: o que
    distingue esses casos e a ORIGEM, devolvida junto, e e por ela que os
    cabecalhos exclusivos da superficie social sao reconhecidos.
    """
    escopos: dict[str, dict[str, set[str]]] = {}
    origens: dict[tuple[str, str], set[str]] = {}

    def anota(pilha: list[str], corpo: str, arquivo: str) -> None:
        corpo = corpo.strip().rstrip(";").strip()
        nome = corpo.split()[0] if corpo.split() else ""
        if nome not in DECIDEM_RESPOSTA:
            return
        # normaliza espaco interno para o diff nao acusar formatacao
        normal = re.sub(r"\s+", " ", corpo)
        escopo = " > ".join(p for p in pilha if p.startswith("location")) or FORA_DE_LOCATION
        escopos.setdefault(escopo, {}).setdefault(nome, set()).add(normal)
        origens.setdefault((escopo, normal), set()).add(arquivo)

    for caminho in arquivos_carregados(list(raizes)):
        pilha: list[str] = []
        for linha in caminho.read_text(encoding="utf-8", errors="replace").splitlines():
            limpa = linha.split("#", 1)[0].strip()
            if not limpa:
                continue
            # BLOCO DE UMA LINHA. `location = /metrics { return 404; }` e
            # `if ($wj_negocia) { return 418; }` existem nos dois arquivos e nao
            # terminam em `{` nem sao `}`: caiam como diretiva de nome
            # `location`/`if`, fora de DECIDEM_RESPOSTA, e o `return` de dentro
            # sumia dos dois lados. Cegueira simetrica nao falseia o veredito,
            # mas esconde justamente o tipo de linha que decide resposta.
            #
            # A guarda por palavra-chave de bloco NAO e enfeite: `{` e `}`
            # aparecem dentro de regex de location (`wj-[0-9a-f]{16}`,
            # `[a-z0-9-]{1,20}`) e de `${variavel}` no corpo de um `map`, e um
            # casamento ingenuo de "abre e fecha na mesma linha" leria
            # `default ", <https://.../${wj_gemea}` como um bloco chamado
            # `default ", <https://.../$`.
            uma_linha = re.match(r"^(?P<rotulo>[^{}]+?)\s*\{(?P<corpo>[^{}]*)\}$", limpa)
            if uma_linha and uma_linha.group("rotulo").split()[0] in ABREM_BLOCO:
                rotulo = re.sub(r"\s+", " ", uma_linha.group("rotulo").strip())
                for pedaco in uma_linha.group("corpo").split(";"):
                    anota(pilha + [rotulo], pedaco, caminho.name)
                continue
            if limpa.endswith("{"):
                pilha.append(re.sub(r"\s+", " ", limpa[:-1].strip()))
                continue
            if limpa == "}":
                if pilha:
                    pilha.pop()
                continue
            anota(pilha, limpa, caminho.name)
    return escopos, origens


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--mostrar-extras", action="store_true", help="lista tambem o que so existe no dedicado")
    args = ap.parse_args()

    faltando_arquivos = [str(p) for p in DEDICADO if not p.is_file()]
    if faltando_arquivos:
        print("check-nginx-standalone-parity: FAIL")
        print(f"  - arquivos do nginx dedicado ausentes: {faltando_arquivos}")
        return 1

    vivo, _ = diretivas_por_escopo(VIVO)
    dedicado, origem_dedicado = diretivas_por_escopo(DEDICADO)

    # Location do vhost vivo que nao existe no dedicado: a mais grave das
    # divergencias, porque nem chega a haver linha para comparar.
    escopos_ausentes = sorted(set(vivo) - set(dedicado))
    comuns = sorted(set(vivo) & set(dedicado))

    divergencias = []
    extras_de_cabecalho = []
    autorizados_vistos = set()
    for escopo in comuns:
        for nome, linhas in sorted(vivo[escopo].items()):
            for linha in sorted(linhas - dedicado[escopo].get(nome, set())):
                divergencias.append((escopo, linha))
        # O SENTIDO QUE FALTAVA. Cabecalho que sobra so no dedicado muda a
        # resposta que o cliente recebe tanto quanto cabecalho que falta.
        for nome, linhas in sorted(dedicado[escopo].items()):
            if nome not in EMITEM_CABECALHO:
                continue
            for linha in sorted(linhas - vivo[escopo].get(nome, set())):
                if origem_dedicado.get((escopo, linha), set()) & EXCLUSIVOS_DO_DEDICADO:
                    continue
                if linha in EXTRAS_DE_CABECALHO_AUTORIZADOS:
                    autorizados_vistos.add(linha)
                    continue
                extras_de_cabecalho.append((escopo, linha))

    # Autorizacao de fantasma tambem e defeito: a linha sumiu do arquivo e a
    # declaracao ficou, pronta para absolver uma linha futura que ninguem mediu.
    autorizados_ausentes = sorted(set(EXTRAS_DE_CABECALHO_AUTORIZADOS) - autorizados_vistos)

    total_vivo = sum(len(v) for e in vivo.values() for v in e.values())
    total_ded = sum(len(v) for e in dedicado.values() for v in e.values())
    print(f"  diretivas que decidem resposta — vivo: {total_vivo} | dedicado: {total_ded}")
    print(f"  escopos comparados: {len(comuns)} comuns, {len(set(dedicado) - set(vivo))} so no dedicado")

    if args.mostrar_extras:
        print("  presentes SO no dedicado (esperado para instancia propria):")
        for escopo in sorted(dedicado):
            for nome, linhas in sorted(dedicado[escopo].items()):
                for linha in sorted(linhas - vivo.get(escopo, {}).get(nome, set())):
                    print(f"      + [{escopo[:38]}] {linha[:104]}")

    if escopos_ausentes:
        print("check-nginx-standalone-parity: FAIL")
        print(f"  - {len(escopos_ausentes)} location do vhost VIVO nao existe no nginx dedicado:")
        for escopo in escopos_ausentes:
            print(f"      - {escopo[:110]}")
        return 1

    if divergencias:
        print("check-nginx-standalone-parity: FAIL")
        print(f"  - {len(divergencias)} diretiva(s) do vhost VIVO ausentes no nginx dedicado:")
        for escopo, linha in divergencias:
            print(f"      - [{escopo[:38]}] {linha[:110]}")
        print("  Migrar assim regride o site. Derive o dedicado do vhost vivo, nao do arquivo de 06/08.")
        return 1

    if extras_de_cabecalho:
        print("check-nginx-standalone-parity: FAIL")
        print(
            f"  - {len(extras_de_cabecalho)} diretiva(s) de cabecalho SO no nginx dedicado:"
        )
        for escopo, linha in extras_de_cabecalho:
            arquivos = ", ".join(sorted(origem_dedicado.get((escopo, linha), {"?"})))
            print(f"      + [{escopo[:38]}] {linha[:104]}   [{arquivos}]")
        print("  A resposta do dedicado difere da do vhost vivo. Leve a linha para o vivo,")
        print("  ou declare o motivo em EXTRAS_DE_CABECALHO_AUTORIZADOS — nunca apague o gate.")
        return 1

    if autorizados_ausentes:
        print("check-nginx-standalone-parity: FAIL")
        print("  - declaracao sem lastro em EXTRAS_DE_CABECALHO_AUTORIZADOS:")
        for linha in autorizados_ausentes:
            print(f"      ? {linha[:110]}")
        print("  A linha nao existe mais no dedicado. Remova a autorizacao.")
        return 1

    # SEGUNDO CRITERIO: o gerador esta atras do que esta implantado. Cobre a
    # classe estrutural que vivo-vs-dedicado NAO alcanca — diretiva de contexto
    # main/http, que nunca aparece no vivo por ele ser um fragmento de vhost
    # (ver PERDA_CONHECIDA_NA_REGERACAO acima).
    perdidas_na_regeracao, erro_regeracao = linhas_perdidas_na_regeracao()
    if erro_regeracao:
        print("check-nginx-standalone-parity: FAIL")
        print(f"  - nao foi possivel regenerar para comparar: {erro_regeracao}")
        return 1

    novas_perdas = sorted(perdidas_na_regeracao - PERDA_CONHECIDA_NA_REGERACAO)
    baseline_sem_lastro = sorted(PERDA_CONHECIDA_NA_REGERACAO - perdidas_na_regeracao)

    if novas_perdas:
        print("check-nginx-standalone-parity: FAIL")
        print(f"  - {len(novas_perdas)} linha(s) que decidem resposta existem HOJE no dedicado")
        print("    e SUMIRIAM se o gerador rodasse agora (gerador atras do implantado):")
        for linha in novas_perdas:
            print(f"      - {linha[:118]}")
        print("  Porte a diretiva para o template do gerador (main/http) ou para o vhost vivo")
        print("  (contexto server), ou declare em PERDA_CONHECIDA_NA_REGERACAO com o motivo —")
        print("  nunca rode --forcar contra o destino real so para calar isto.")
        return 1

    if baseline_sem_lastro:
        print("check-nginx-standalone-parity: FAIL")
        print("  - declaracao sem lastro em PERDA_CONHECIDA_NA_REGERACAO:")
        for linha in baseline_sem_lastro:
            print(f"      ? {linha[:118]}")
        print("  A linha nao se perderia mais na regeracao. Remova a autorizacao.")
        return 1

    print("check-nginx-standalone-parity: pass")
    print("  toda diretiva de resposta do vhost vivo existe no nginx dedicado, no MESMO location")
    print("  e nenhum cabecalho sobra no dedicado sem declaracao")
    print(f"  regeracao: 0 linha(s) nova(s) perdida(s) ({len(PERDA_CONHECIDA_NA_REGERACAO)} na baseline conhecida)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
