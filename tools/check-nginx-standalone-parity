def _carrega_gerador():
    """Importa tools/generate-nginx-standalone como modulo (sem extensao .py,
    SourceFileLoader), para REUSAR `linhas_decisivas()` -- o mesmo criterio que
    ja existia dentro do gerador (GUARDA DE PERDA) -- em vez de manter dois
    criterios de "o que decide resposta" divergentes neste repositorio. Seguro
    de importar: todo o trabalho do gerador esta atras de
    `if __name__ == "__main__"`.
    """
    caminho = os.path.join(os.path.dirname(os.path.abspath(__file__)), "generate-nginx-standalone")
    loader = importlib.machinery.SourceFileLoader("generate_nginx_standalone_parity", caminho)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    modulo = importlib.util.module_from_spec(spec)
    loader.exec_module(modulo)
    return modulo, caminho


def linhas_perdidas_na_regeracao() -> tuple[set[str], str | None]:
    """O que existe HOJE no dedicado e SUMIRIA se alguem rodasse o gerador
    agora. Roda o gerador para um arquivo TEMPORARIO -- nunca `--saida` padrao,
    que e o destino real -- e reaproveita `linhas_decisivas()` dos dois lados.
    """
    modulo, caminho_gerador = _carrega_gerador()
    if not DEDICADO[0].is_file():
        return set(), None
    with tempfile.TemporaryDirectory(prefix="wj-nginx-parity-") as tmp:
        saida = pathlib.Path(tmp) / "gerado.conf"
        resultado = subprocess.run(
            [sys.executable, caminho_gerador, "--saida", str(saida)],
            capture_output=True,
            text=True,
        )
        if resultado.returncode != 0 or not saida.is_file():
            erro = resultado.stderr.strip() or resultado.stdout.strip()
            return set(), f"gerador falhou (exit {resultado.returncode}): {erro[:300]}"
        gerado_txt = saida.read_text(encoding="utf-8")
    dedicado_txt = DEDICADO[0].read_text(encoding="utf-8")
    perdidas = modulo.linhas_decisivas(dedicado_txt) - modulo.linhas_decisivas(gerado_txt)
    return perdidas, None


def arquivos_carregados(raizes: list[pathlib.Path]) -> list[pathlib.Path]:
    """Segue os `include` a partir das raizes, so dentro do repositorio.

    Lista fixa de arquivos e a origem dos dois falsos-verdes que este check ja
    teve. Derivar do proprio arquivo faz o gate acompanhar quem acrescenta um
    include sem lembrar de vir aqui.
    """
    vistos: list[pathlib.Path] = []
    fila = list(raizes)
    while fila:
        atual = fila.pop(0)
        try:
            resolvido = atual.resolve()
        except OSError:
            continue
        if resolvido in {p.resolve() for p in vistos} or not resolvido.is_file():
            continue
        vistos.append(resolvido)
        for linha in resolvido.read_text(encoding="utf-8", errors="replace").splitlines():
            limpa = linha.split("#", 1)[0].strip().rstrip(";").strip()
            if not limpa.startswith("include "):
                continue
            alvo = limpa.split(None, 1)[1].strip()
            if "*" in alvo:
                # glob de include nao e usado aqui; se passar a ser, o gate
                # precisa aprender a expandir em vez de ignorar em silencio.
                continue
            caminho = pathlib.Path(alvo)
            if not caminho.is_absolute():
                caminho = resolvido.parent / caminho
            try:
                caminho.resolve().relative_to(RAIZ)
            except (ValueError, OSError):
                continue  # fora do repositorio (mime.types do sistema)
            fila.append(caminho)
    return vistos

