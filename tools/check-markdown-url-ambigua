def autoteste() -> int:
    falhas = 0
    for nome, texto, captura in CASOS_QUE_DEVEM_REPROVAR:
        achados = urls_ambiguas(texto, ORIGEM_DE_TESTE)
        if len(achados) != 1:
            print(f"  FALHOU  deveria acusar 1 e acusou {len(achados)}: {nome}")
            falhas += 1
            continue
        if achados[0][2] != captura:
            print(f"  FALHOU  captura {achados[0][2]!r}, esperada {captura!r}: {nome}")
            falhas += 1
            continue
        print(f"  ok  acusa: {nome}")
    for nome, texto in CASOS_QUE_DEVEM_APROVAR:
        achados = urls_ambiguas(texto, ORIGEM_DE_TESTE)
        if achados:
            print(f"  FALSO POSITIVO  {nome}: {achados}")
            falhas += 1
            continue
        print(f"  ok  nao acusa: {nome}")
    for nome, texto, captura in ITENS_QUE_DEVEM_ACUSAR:
        achados = itens_de_lista_com_dois_pontos(texto, ORIGEM_DE_TESTE)
        if len(achados) != 1:
            print(f"  FALHOU  item deveria acusar 1 e acusou {len(achados)}: {nome}")
            falhas += 1
            continue
        if achados[0][2] != captura:
            print(f"  FALHOU  captura errada em {nome}: {achados[0][2]!r} != {captura!r}")
            falhas += 1
            continue
        print(f"  ok  acusa item: {nome}")
    for nome, texto in ITENS_QUE_NAO_ACUSAM:
        achados = itens_de_lista_com_dois_pontos(texto, ORIGEM_DE_TESTE)
        if achados:
            print(f"  FALSO POSITIVO  item {nome}: {achados}")
            falhas += 1
            continue
        print(f"  ok  nao acusa item: {nome}")
    if falhas:
        print(f"autoteste: {falhas} falhas — o criterio divergiu de internal/pagemarkdown")
        return 1
    print("autoteste: criterio conferido nos trechos medidos, sem falso positivo")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description="reprova endereco do portal colado em pontuacao no canal Markdown"
    )
    ap.add_argument(
        "alvos",
        nargs="*",
        help="arquivos a varrer; sem argumento, varre os documentos de texto de public/",
    )
    ap.add_argument(
        "--rotas-vivas",
        metavar="ORIGEM_HTTP",
        default="",
        help="alem do disco, varre as rotas Markdown servidas pelo Go (/auth.md, /api.md, "
        "/index.md), que nao existem como arquivo em public/. Exige o servidor no ar; "
        "indisponibilidade e reportada, nunca reprovada.",
    )
    ap.add_argument("--json", action="store_true", help="saida em JSON")
    ap.add_argument(
        "--autoteste",
        action="store_true",
        help="confere o detector contra os trechos medidos (positivos e falsos positivos) "
        "e sai; existe para apanhar divergencia entre esta implementacao e a de "
        "internal/pagemarkdown/enderecos.go",
    )
    args = ap.parse_args()

    if args.autoteste:
        return autoteste()

    origem = carrega_origem(RAIZ)
    arquivos = documentos(RAIZ, args.alvos)
    if not arquivos:
        print("check-markdown-url-ambigua: nenhum documento de texto em public/", file=sys.stderr)
        return 2

    ocorrencias: list[Ocorrencia] = []
    itens_canonicos = 0
    lidos = 0
    for caminho in arquivos:
        try:
            with open(caminho, encoding="utf-8") as fh:
                texto = fh.read()
        except (OSError, UnicodeDecodeError) as erro:
            print(f"check-markdown-url-ambigua: {caminho}: {erro}", file=sys.stderr)
            return 2
        lidos += 1
        relativo = os.path.relpath(caminho, RAIZ)
        legitimo = dois_pontos_e_legitimo(relativo)
        for inicio, url, captura in itens_de_lista_com_dois_pontos(texto, origem):
            if legitimo:
                itens_canonicos += 1
                continue
            linha = texto.count("\n", 0, inicio) + 1
            ini_ctx = max(0, inicio - 60)
            fim_ctx = min(len(texto), inicio + len(captura) + 20)
            ocorrencias.append(
                Ocorrencia(
                    arquivo=relativo,
                    linha=linha,
                    url=url,
                    captura_ingenua=captura,
                    motivo='item de lista llms.txt: o extrator leva "):" e o caminho vira 301',
                    trecho=texto[ini_ctx:fim_ctx].replace("\n", " "),
                )
            )
        for inicio, url, captura, motivo in urls_ambiguas(texto, origem):
            linha = texto.count("\n", 0, inicio) + 1
            ini_ctx = max(0, inicio - 60)
            fim_ctx = min(len(texto), inicio + len(captura) + 20)
            ocorrencias.append(
                Ocorrencia(
                    arquivo=relativo,
                    linha=linha,
                    url=url,
                    captura_ingenua=captura,
                    motivo=motivo,
                    trecho=texto[ini_ctx:fim_ctx].replace("\n", " "),
                )
            )

    vivas_indisponiveis = ""
    if args.rotas_vivas:
        import urllib.error
        import urllib.request

        for rota in ("/auth.md", "/api.md", "/index.md"):
            pedido = urllib.request.Request(
                args.rotas_vivas.rstrip("/") + rota,
                headers={
                    # UA proprio e marcacao de sonda: e proibido emitir
                    # requisicao com User-Agent de bot real.
                    "User-Agent": "wikijuridica-check-markdown-url-ambigua/1.0",
                    "X-Warming-Request": "true",
                },
            )
            try:
                with urllib.request.urlopen(pedido, timeout=10) as resposta:
                    texto = resposta.read().decode("utf-8")
            except (urllib.error.URLError, OSError, UnicodeDecodeError) as erro:
                vivas_indisponiveis = f"{rota}: {erro}"
                break
            lidos += 1
            for inicio, url, captura, motivo in urls_ambiguas(texto, origem):
                linha = texto.count("\n", 0, inicio) + 1
                ini_ctx = max(0, inicio - 60)
                fim_ctx = min(len(texto), inicio + len(captura) + 20)
                ocorrencias.append(
                    Ocorrencia(
                        arquivo=f"rota viva {rota}",
                        linha=linha,
                        url=url,
                        captura_ingenua=captura,
                        motivo=motivo,
                        trecho=texto[ini_ctx:fim_ctx].replace("\n", " "),
                    )
                )

    if args.json:
        print(
            json.dumps(
                {
                    "origem": origem,
                    "documentos_lidos": lidos,
                    "ocorrencias": [o.__dict__ for o in ocorrencias],
                    "itens_de_lista_canonicos_llmstxt": itens_canonicos,
                    "rotas_vivas_indisponiveis": vivas_indisponiveis,
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 1 if ocorrencias else 0

    print(f"check-markdown-url-ambigua: {lidos} documentos, origem {origem}")
    if vivas_indisponiveis:
        print(f"  aviso: rotas vivas nao varridas ({vivas_indisponiveis}) — varredura do disco fez o veredito")
    if itens_canonicos:
        print(
            f"  aviso: {itens_canonicos} itens no formato `- [nome](url): descricao` no "
            f"{DOCUMENTO_COM_DOIS_PONTOS_LEGITIMO}, o unico documento em que a forma e "
            "legitima — e o contrato de entrada que a especificacao do llms.txt define. "
            "Em qualquer outro documento a mesma forma reprova: ela responde por 9.418 "
            "requisicoes a `.../index.md):` no log de origem de 2026-08-26 a 29."
        )
    if not ocorrencias:
        print("  aprovado: nenhum endereco do portal colado em pontuacao")
        return 0

    por_motivo: dict[str, int] = {}
    for o in ocorrencias:
        por_motivo[o.motivo] = por_motivo.get(o.motivo, 0) + 1
    print(f"  REPROVADO: {len(ocorrencias)} enderecos que um extrator capturaria com pontuacao")
    for motivo, quantas in sorted(por_motivo.items(), key=lambda x: -x[1]):
        print(f"    {quantas:5d}  {motivo}")
    print()
    for o in ocorrencias[:40]:
        print(f"  {o.arquivo}:{o.linha}")
        # 404 OU 301 depende da regra T3.9 do nginx (`$wj_pontuacao_residual`),
        # que redireciona caminho terminado em ")" "]" "," ":" ou crase e deixa o
        # ponto final passar. Rotular tudo de "404" foi o que escondeu 9.418
        # requisicoes desperdicadas durante dois dias de medicao.
        desfecho = "301" if o.captura_ingenua[-1] in ")],:`" else "404"
        print(f"      o extrator pede, e leva {desfecho}: {o.captura_ingenua}")
        print(f"      trecho: …{o.trecho}…")
    if len(ocorrencias) > 40:
        print(f"  … e mais {len(ocorrencias) - 40} ocorrencias")
    print()
    print("  Correcao: emitir o endereco como autolink CommonMark <url> "
          "(pagemarkdown.URLInequivoca), ou encerrar a frase antes dele.")
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(2)
