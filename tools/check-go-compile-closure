#!/bin/sh
set -eu

# Não resolva utilitários pelo PATH herdado. O hook chama este checker em um
# ambiente fechado, mas o checker também precisa continuar seguro quando for
# executado diretamente por CI ou por um teste focal.
PATH=/usr/bin:/bin
export PATH

ENV_BIN=/usr/bin/env
ROOT="$(CDPATH='' cd -- "$(/usr/bin/dirname -- "$0")/.." && pwd -P)"
PINNED_GOROOT="$ROOT/.toolchains/go1.26.6"
GO_BIN="$PINNED_GOROOT/bin/go"
VERSION_FILE="$PINNED_GOROOT/VERSION"

# ENV_BIN PODE SER SYMLINK DE SISTEMA (2026-09-24). No Ubuntu 26.04 (a torre,
# produção desde o cutover daquele dia) o coreutils é o uutils: /usr/bin/env é
# symlink de root para /usr/lib/cargo/bin/coreutils/env, multicall com 116
# hardlinks. A recusa de `-L` aqui reprovava todo commit Go na torre. Este shell
# não lê dono de elo sem executar stat/readlink, que o wrapper não autentica, e
# nunca leu: a guarda de execução direta media só -f, -x e -L. Quem autentica a
# cadeia é tools/check-go-index-compile-closure (_resolve_system_binary: cada
# elo de root, diretório de cada elo sem escrita de grupo/outros, alvo final
# regular de root sem escrita de terceiros, bytes e identidade presos antes e
# conferidos depois da execução) e, no hook, o binario_confiavel do
# .githooks/pre-commit. Aqui fica o que o shell mede sozinho: o alvo resolvido
# pelo kernel é arquivo regular executável.
if [ ! -f "$ENV_BIN" ] || [ ! -x "$ENV_BIN" ]; then
	echo "go-compile-closure: trusted env binary is unavailable" >&2
	exit 1
fi
if [ ! -f "$GO_BIN" ] || [ ! -x "$GO_BIN" ] || [ -L "$GO_BIN" ]; then
	echo "go-compile-closure: pinned Go 1.26.6 binary is unavailable or unsafe" >&2
	exit 1
fi
if [ ! -d "$PINNED_GOROOT" ] || [ -L "$PINNED_GOROOT" ]; then
	echo "go-compile-closure: pinned GOROOT is unavailable or unsafe" >&2
	exit 1
fi
if [ ! -f "$VERSION_FILE" ] || [ -L "$VERSION_FILE" ]; then
	echo "go-compile-closure: pinned VERSION authority is unavailable or unsafe" >&2
	exit 1
fi
PINNED_VERSION=""
if ! IFS= read -r PINNED_VERSION <"$VERSION_FILE" || [ "$PINNED_VERSION" != "go1.26.6" ]; then
	echo "go-compile-closure: pinned Go VERSION is not go1.26.6" >&2
	exit 1
fi
OBSERVED_VERSION="$($ENV_BIN -i \
	PATH=/usr/bin:/bin HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent \
	LC_ALL=C TMPDIR=/tmp GOENV=off GOTOOLCHAIN=local GOWORK=off GOFLAGS= \
	GOROOT="$PINNED_GOROOT" "$GO_BIN" env GOVERSION)"
if [ "$OBSERVED_VERSION" != "go1.26.6" ]; then
	echo "go-compile-closure: pinned Go binary reports an unexpected version" >&2
	exit 1
fi

PROJECT_ROOT="$ROOT"
PARALLELISM=""
PACKAGES=""
while [ "$#" -gt 0 ]; do
	case "$1" in
	--root)
		[ "$#" -ge 2 ] || {
			echo "usage: tools/check-go-compile-closure [--root DIR] [--parallelism N] [--package IMPORT_PATH]" >&2
			exit 2
		}
		PROJECT_ROOT="$(CDPATH='' cd -- "$2" && pwd -P)"
		shift 2
		;;
	--parallelism)
		[ "$#" -ge 2 ] || {
			echo "usage: tools/check-go-compile-closure [--root DIR] [--parallelism N] [--package IMPORT_PATH]" >&2
			exit 2
		}
		PARALLELISM="$2"
		shift 2
		;;
	--package)
		[ "$#" -ge 2 ] || {
			echo "usage: tools/check-go-compile-closure [--root DIR] [--parallelism N] [--package IMPORT_PATH]" >&2
			exit 2
		}
		case "$2" in
		"" | -* | *[!A-Za-z0-9._~+/@:-]*)
			echo "go-compile-closure: --package must be a canonical Go import path" >&2
			exit 2
			;;
		esac
		PACKAGES="$PACKAGES $2"
		shift 2
		;;
	*)
		echo "usage: tools/check-go-compile-closure [--root DIR] [--parallelism N] [--package IMPORT_PATH]" >&2
		exit 2
		;;
	esac
done
case "$PARALLELISM" in
"") ;;
*[!0-9]* | 0)
	echo "go-compile-closure: --parallelism must be a positive integer" >&2
	exit 2
	;;
esac
cd "$PROJECT_ROOT"

TRUSTED_HOME="${HOME:-/nonexistent}"
case "$TRUSTED_HOME" in
/*) ;;
*)
	echo "go-compile-closure: HOME must be absolute" >&2
	exit 1
	;;
esac

# `go build ./...` compila cada pacote e depois relinka todo pacote main. Este
# gate pede ao próprio go command os export data atuais de toda a closure. A
# operação continua compilando e type-checking cada pacote não-teste nomeado
# por ./... e suas dependências (inclusive dependentes reversos, pois todos os
# pacotes do módulo são raízes), mas não produz executáveis.
#
# `devcmds` entra explicitamente e `-test` inclui as variantes de pacote com
# *_test.go sem linkeditar binários de teste. Assim, um erro de tipo num teste
# tagged não vira falso-verde; execução dos testes, vet e linkedição integral
# permanecem gates proporcionais/CI/release.

# `env -i` remove GOFLAGS, GOENV, GOWORK, GO_MODERN_BIN, GOPROXY overrides e
# GIT_INDEX_FILE herdado. O índice é usado pelo hook para selecionar a rota,
# mas não é uma entrada legítima do compilador nem de subprocessos git que o
# go command eventualmente abra. go.mod/go.sum ficam fail-closed por
# -mod=readonly; alteração desses arquivos deve seguir a rota full-build do
# chamador, além deste checker.
set -- list \
	-tags=devcmds \
	-deps \
	-test \
	-export \
	-mod=readonly \
	-buildvcs=false \
	-f '{{.ImportPath}} {{.Export}}'
if [ -n "$PARALLELISM" ]; then
	set -- "$@" "-p=$PARALLELISM"
fi
# ESCOPO PADRAO (corrigido em 2026-08-29, BUG-135 da caca): o padrao ./...
# NAO EXPANDE neste repositorio. var/nginx/{body,fastcgi,proxy,scgi,uwsgi}
# pertence a `nobody` com modo 0700 e o caminhador do go aborta o padrao
# INTEIRO com "open var/nginx/body: permission denied" — zero pacote listado,
# exit 1. Rodando sem PACKAGES (o caminho de invocacao manual), este detector
# reprovava por defeito PROPRIO, nao por defeito do codigo que ele deveria
# vigiar. E o segundo detector do repo cego pela mesma armadilha; o primeiro
# foi tools/go-build-check (BUG-057).
#
# Nao encolhe escopo: as pastas com fonte Go do modulo vivem todas em
# internal/ e cmd/ (medido: 481 pacotes sem tag, 760 com -tags devcmds).
# No caminho do pre-commit, PACKAGES vem preenchido pelo snapshot staged e
# este ramo nao e usado.
# ATUALIZACAO 2026-08-29 (DEC-039): o padrao ./... passou a EXPANDIR — o go.mod
# raiz ganhou a diretiva `ignore ./var`, que tira a subarvore do runtime do nginx
# do alcance dos padroes. O escopo explicito abaixo CONTINUA certo, por outro
# motivo: ./... virou comando full-tree pesado (488 pacotes), proibido pelo
# AGENTS.md e guardado pelo hook block-heavy-go.sh. O texto acima descreve o
# estado ate aquela data e fica como registro do que a armadilha custou.
if [ -z "$PACKAGES" ]; then
	# ★ O ESCOPO SE DERIVA DO ROOT, NAO SE ASSUME (2026-09-05).
	#
	# Ate aqui esta linha era `set -- "$@" ./internal/... ./cmd/...` fixo, e o
	# `--root` era honrado pelo `cd` da linha 94 mas ignorado aqui. Contra
	# qualquer root que nao tenha as DUAS pastas, o `go list` aborta o padrao
	# inteiro com "lstat ./internal/: no such file or directory" e o checker
	# reprova por defeito PROPRIO — a mesma classe de armadilha que o comentario
	# acima cataloga duas vezes (BUG-057 em tools/go-build-check, BUG-135 aqui),
	# agora pelo lado do root em vez do lado do padrao.
	#
	# Medido em 2026-09-05: as QUATRO falhas de
	# tools/test_check_go_compile_closure.py sao esta unica causa. O teste monta
	# um fixture com go.mod, lib/ e cmd/{app,devapp} — modulo Go legitimo, sem
	# internal/ — e roda o checker com --root apontado para ele. As quatro
	# reprovavam desde que o escopo explicito entrou, e o ledger da varredura
	# diaria as carregava como "defeito" havia dias.
	#
	# Derivar NAO encolhe escopo: no repositorio real as duas pastas existem e o
	# conjunto e' byte a byte o de antes (medido: 481 pacotes sem tag, 760 com
	# -tags devcmds). E root sem nenhuma das duas para aqui com FAIL explicito,
	# em vez de listar zero pacote e imprimir PASS — que e' exatamente o modo de
	# falha que os dois BUGs acima custaram para o projeto aprender.
	_escopo_encontrado=0
	for _dir in internal cmd; do
		if [ -d "$_dir" ]; then
			set -- "$@" "./$_dir/..."
			_escopo_encontrado=$((_escopo_encontrado + 1))
		fi
	done
	if [ "$_escopo_encontrado" -eq 0 ]; then
		echo "go-compile-closure: FAIL nenhuma pasta de fonte (internal/ ou cmd/) existe em $PROJECT_ROOT" >&2
		exit 1
	fi
else
	# Import paths Go não contêm whitespace/globs; `set -f` mantém a expansão
	# estritamente como lista de argumentos descoberta no snapshot staged.
	set -f
	# shellcheck disable=SC2086
	set -- "$@" $PACKAGES
fi

"$ENV_BIN" -i \
	PATH=/usr/bin:/bin HOME="$TRUSTED_HOME" XDG_CONFIG_HOME=/nonexistent \
	LC_ALL=C TMPDIR=/tmp GOENV=off GOTOOLCHAIN=local GOWORK=off GOFLAGS= \
	GOPATH="$TRUSTED_HOME/go" GOMODCACHE="$TRUSTED_HOME/go/pkg/mod" \
	GOCACHE="$TRUSTED_HOME/.cache/go-build" \
	GOROOT="$PINNED_GOROOT" \
	"$GO_BIN" "$@" >/dev/null

echo "go-compile-closure: PASS (production+devcmds packages and test variants compiled; no executables linked)"
