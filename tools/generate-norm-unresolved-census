#!/usr/bin/env python3
"""generate-norm-unresolved-census — o censo das normas que o acervo cita e que
a URN LexML nao alcanca, no formato que
`tools/generate-lexml-norm-registry-20260826 --censo` consome.

POR QUE EXISTE. O censo de 2026-08-26 e o do corpus do STJ de 2026-09-08 foram
montados a mao a partir da saida de `cmd/measure-graph-authority`, e o passo de
transformacao nunca virou ferramenta. Sem ele, refazer o censo depois de mexer
no extrator e um trabalho manual que ninguem repete — e censo velho e a forma
mais silenciosa de um gate medir o passado: em 2026-09-10 o censo de agosto
ainda era a unica entrada do gerador, quatorze dias e ~1.000 paginas depois.

O QUE ELE FAZ, E O QUE NAO FAZ. Le o relatorio JSON do medidor (que renderiza o
acervo OFFLINE, sem tocar em public/) e reescreve `normas_nao_normalizadas`
como `normas`, preservando `chave_fallback`, `exemplo_texto`, `ocorrencias` e
`paginas` byte a byte. NAO consulta rede, NAO decide data, NAO filtra por
especie: quem sabe o que a fonte oficial comprova e o gerador do registro, e
duas regras de filtragem em dois lugares e como a divergencia comeca.

O CAMPO `medicao` NAO E DECORACAO. Ele diz de qual populacao vieram os numeros,
e o gerador do registro guarda isso em `censo_origem`: o censo do acervo conta
PAGINAS, o do corpus do STJ conta ACORDAOS, e gravar acordao sob a chave
`paginas` seria a chave que engana a medicao.

Uso:
    tools/generate-norm-unresolved-census --relatorio <medicao.json>
    tools/generate-norm-unresolved-census --relatorio <medicao.json> --saida <censo.json>
    tools/generate-norm-unresolved-census --relatorio <medicao.json> --stdout
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
FERRAMENTA_DE_ORIGEM = "cmd/measure-graph-authority"
MEDICAO = ("render offline do acervo (content/pages.json) no HEAD, "
           "sem tocar em public/")

# Os campos que o gerador do registro le. Um relatorio sem eles nao e o
# relatorio deste medidor, e falhar aqui e melhor que gravar censo vazio.
CAMPOS_DA_NORMA = ("chave_fallback", "exemplo_texto", "ocorrencias", "paginas")


def grava_atomico(caminho: Path, conteudo: bytes) -> None:
    descritor, temporario = tempfile.mkstemp(prefix="." + caminho.name + ".",
                                             dir=caminho.parent)
    try:
        os.fchmod(descritor, 0o644)
        with os.fdopen(descritor, "wb") as arquivo:
            arquivo.write(conteudo)
            arquivo.flush()
            os.fsync(arquivo.fileno())
        os.replace(temporario, caminho)
    finally:
        if os.path.exists(temporario):
            os.unlink(temporario)


def monta_censo(relatorio: dict, gerado_em: str) -> dict:
    normas_brutas = relatorio.get("normas_nao_normalizadas")
    if normas_brutas is None:
        raise SystemExit("relatorio sem `normas_nao_normalizadas`: nao e a "
                         "saida de " + FERRAMENTA_DE_ORIGEM)
    normas = []
    for bruta in normas_brutas:
        faltando = [c for c in CAMPOS_DA_NORMA if c not in bruta]
        if faltando:
            raise SystemExit("norma sem os campos %s: %r"
                             % (", ".join(faltando), bruta))
        normas.append({campo: bruta[campo] for campo in CAMPOS_DA_NORMA})
    # A ORDEM E A DO MEDIDOR (paginas desc, chave asc) e fica como veio: o
    # censo e insumo de uma coleta com pausa de 1,1 s por norma, e quem
    # interromper no meio precisa que a proxima execucao comece pelas de maior
    # alcance.
    return {
        "ferramenta": FERRAMENTA_DE_ORIGEM,
        "gerado_em": gerado_em,
        "medicao": MEDICAO,
        "paginas_renderizadas": relatorio.get("paginas_renderizadas"),
        "artigos": relatorio.get("artigos"),
        "artigos_citam_lei_sem_no_legislation":
            relatorio.get("artigos_citam_lei_sem_no_legislation"),
        "normas_distintas_nao_normalizadas": len(normas),
        "ocorrencias_totais": sum(n["ocorrencias"] for n in normas),
        "normas": normas,
    }


def main() -> int:
    interpretador = argparse.ArgumentParser(description=__doc__)
    interpretador.add_argument("--relatorio", required=True,
                               help="JSON de " + FERRAMENTA_DE_ORIGEM)
    interpretador.add_argument("--saida", default="",
                               help="destino (padrao: "
                                    "data/source-audit/norm_citation_unresolved_census_AAAAMMDD.json)")
    interpretador.add_argument("--gerado-em", default="",
                               help="data do censo (padrao: hoje)")
    interpretador.add_argument("--stdout", action="store_true",
                               help="imprime em vez de gravar")
    argumentos = interpretador.parse_args()

    relatorio = json.loads(Path(argumentos.relatorio).read_text(encoding="utf-8"))
    gerado_em = argumentos.gerado_em or datetime.date.today().isoformat()
    censo = monta_censo(relatorio, gerado_em)

    corpo = json.dumps(censo, ensure_ascii=False, indent=2) + "\n"
    if argumentos.stdout:
        sys.stdout.write(corpo)
        return 0

    destino = Path(argumentos.saida) if argumentos.saida else (
        RAIZ / ("data/source-audit/norm_citation_unresolved_census_%s.json"
                % gerado_em.replace("-", "")))
    grava_atomico(destino, corpo.encode("utf-8"))
    print("censo: %s" % os.path.relpath(destino, RAIZ))
    print("  %d norma(s) distinta(s), %d ocorrencia(s), %s pagina(s) renderizada(s)"
          % (censo["normas_distintas_nao_normalizadas"],
             censo["ocorrencias_totais"], censo["paginas_renderizadas"]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
