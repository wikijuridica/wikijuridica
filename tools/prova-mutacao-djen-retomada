#!/usr/bin/env python3
"""tools/prova-mutacao-djen-retomada — LE e MUTA temporariamente, nao escreve produto.

Prova por mutacao da guarda que separa os cursores de retomada por REGIME de
coleta (internal/djen/retomada.go + os call sites em cmd/collect-djen/main.go).

O DEFEITO QUE ELA CORRIGE, medido e datado em 2026-09-16: uma coleta em
`--regime acervo` parou na pagina 41 do TJRJ em 2026-09-15 e gravou o ponto; a
unit diaria roda `--dias-atras 3` e aquele dia caia na janela dela. Com a chave
do cursor em (tribunal, dia), a execucao da manha seguinte -- em regime MONITOR
-- retomaria da pagina 41 (deixando 1..40 sem leitura naquele regime) e, ao
chegar a pagina vazia, APAGARIA o ponto, declarando completo um dia que o acervo
nunca cobriu.

A correcao e de IDENTIDADE: o regime entra na chave do ponto. Cada mutante aqui
desfaz uma parte dela e o teste correspondente TEM de ficar vermelho. Mutante
que continua verde denuncia um teste decorativo -- e o proprio maestro pediu
este cuidado com estas palavras: "Se apagar a conferencia de regime deixar o
teste verde, o teste e decorativo."

Mutante que NAO COMPILA nao conta como prova. A restauracao e conferida por
sha256: script de mutacao que nao devolve o arquivo byte a byte deixa o
repositorio pior do que o achou.

  ./tools/prova-mutacao-djen-retomada

Irmao deste instrumento: tools/prova-mutacao-djenacervo (as guardas de
publicidade do acervo servido).
"""
import hashlib
import pathlib
import subprocess
import sys

RAIZ = pathlib.Path("/opt/wiki")
RETOMADA = RAIZ / "internal/djen/retomada.go"
COLETOR = RAIZ / "cmd/collect-djen/main.go"

TESTE_REGIME = "TestCursorDeUmRegimeNaoEConsumidoNemApagadoPeloOutro"
TESTE_LEGADO = "TestPontoLegadoNaoEConsumidoNemDirigeVarredura"
PACOTE = "./cmd/collect-djen/"

# (nome, arquivo, trecho_original, trecho_mutante, teste, ocorrencias_esperadas)
MUTANTES = [
    (
        "IDENTIDADE: o regime sai da chave do ponto",
        RETOMADA,
        '\treturn NormalizaRegime(regime) + "\\x1f" + ChaveRetomada(tribunal, data)',
        "\treturn ChaveRetomada(tribunal, data)",
        TESTE_REGIME,
        1,
    ),
    (
        "CONSUMO: o call site de aplicaRetomada perde o regime",
        COLETOR,
        "consulta = aplicaRetomada(consulta, *regime, retomada, saida)",
        'consulta = aplicaRetomada(consulta, "", retomada, saida)',
        TESTE_REGIME,
        2,
    ),
    (
        "ESCRITA/APAGAMENTO: o call site de atualizaRetomada perde o regime",
        COLETOR,
        "if atualizaRetomada(retomada, consulta, *regime, resultado, saida) {",
        'if atualizaRetomada(retomada, consulta, "", resultado, saida) {',
        TESTE_REGIME,
        2,
    ),
    (
        "GRAVACAO: o ponto nasce sem regime (legado) em atualizaRetomada",
        COLETOR,
        "\tretomada.Marca(djen.PontoDeRetomada{\n\t\tRegime:         regime,",
        '\tretomada.Marca(djen.PontoDeRetomada{\n\t\tRegime:         "",',
        TESTE_REGIME,
        1,
    ),
    (
        "ORCAMENTO: marcaNaoVarridas grava ponto sem regime",
        COLETOR,
        "\t\tretomada.Marca(djen.PontoDeRetomada{\n\t\t\tRegime:         regime,",
        '\t\tretomada.Marca(djen.PontoDeRetomada{\n\t\t\tRegime:         "",',
        "TestOPontoDoOrcamentoEsgotadoNasceComRegime",
        1,
    ),
    (
        "LEGADO: o ponto de regime desconhecido volta a ser entregue a quem pedir",
        RETOMADA,
        "\tponto, existe := r.Pontos[ChaveDoPonto(regime, tribunal, data)]\n\treturn ponto, existe",
        "\tponto, existe := r.Pontos[ChaveDoPonto(regime, tribunal, data)]\n"
        "\tif !existe {\n\t\tponto, existe = r.Pontos[ChaveDoPonto(RegimeDesconhecido, tribunal, data)]\n\t}\n"
        "\treturn ponto, existe",
        TESTE_LEGADO,
        1,
    ),
    (
        "LEGADO: o ponto de regime desconhecido volta a dirigir varredura",
        COLETOR,
        "\t\tif djen.NormalizaRegime(ponto.Regime) != desteRegime {\n\t\t\tcontinue\n\t\t}",
        "\t\tif false && djen.NormalizaRegime(ponto.Regime) != desteRegime {\n\t\t\tcontinue\n\t\t}",
        "TestAcrescentaPendentesSoPegaOMesmoRegime",
        1,
    ),
    # ★ A PORTA NOMINAL (--retirar-legado), acrescentada em 2026-09-16
    #
    # Ela existe porque `relataPendentes` mandava aposentar o ponto legado "por
    # decisao nominal" e nenhum comando cumpria isso. Porta que apaga cursor
    # precisa de prova nos dois sentidos: apaga o que deve e recusa o resto.
    (
        "PORTA: a retirada ignora o veredito de RetiraLegado e engole o par inexistente",
        COLETOR,
        "\t\tif !retomada.RetiraLegado(tribunal, data) {",
        "\t\tif _ = retomada.RetiraLegado(tribunal, data); false {",
        "TestRetirarLegadoSoAlcancaOPontoDeRegimeDesconhecido",
        1,
    ),
    (
        "PORTA: a conferencia de formato some e TRIBUNAL sem data vira pedido valido",
        COLETOR,
        "\t\tif !temSeparador || tribunal == \"\" || data == \"\" {",
        "\t\tif false && (!temSeparador || tribunal == \"\" || data == \"\") {",
        "TestRetirarLegadoSoAlcancaOPontoDeRegimeDesconhecido",
        1,
    ),
]


def sha(caminho: pathlib.Path) -> str:
    return hashlib.sha256(caminho.read_bytes()).hexdigest()


def roda(teste: str) -> tuple[int, str]:
    processo = subprocess.run(
        ["./tools/go-modern", "test", "-count=1", "-run", teste, PACOTE],
        cwd=RAIZ, capture_output=True, text=True, timeout=300,
    )
    return processo.returncode, (processo.stdout + processo.stderr).strip()


def main() -> int:
    antes = {c: sha(c) for c in (RETOMADA, COLETOR)}

    codigo, saida = roda(f"{TESTE_REGIME}|{TESTE_LEGADO}")
    if codigo != 0:
        print("BASELINE VERMELHO — a bancada nao esta verde antes de mutar:")
        print(saida)
        return 1
    print("baseline: VERDE\n")

    falhas = []
    for nome, arquivo, original, mutante, teste, ocorrencias in MUTANTES:
        texto = arquivo.read_text(encoding="utf-8")
        if texto.count(original) != ocorrencias:
            print(f"[ ERRO  ] {nome}: o trecho original aparece {texto.count(original)}x "
                  f"em {arquivo.name}, esperadas {ocorrencias} — mutante nao aplicado")
            falhas.append(nome)
            continue
        arquivo.write_text(texto.replace(original, mutante), encoding="utf-8")
        try:
            codigo, saida = roda(teste)
            compilou = "build failed" not in saida and "cannot use" not in saida \
                and "undefined:" not in saida and "declared and not used" not in saida
            if not compilou:
                print(f"[ INVAL ] {nome}: o mutante NAO COMPILA — nao conta como prova")
                if saida:
                    print("          " + saida.splitlines()[0])
                falhas.append(nome)
            elif codigo == 0:
                print(f"[ VIVO  ] {nome}: {teste} continuou VERDE sem a guarda — FALSO-VERDE")
                falhas.append(nome)
            else:
                primeira = next((l for l in saida.splitlines()
                                 if l.strip().startswith(("---", "    "))), "")
                print(f"[ MORTO ] {nome}")
                print(f"          {teste}: {primeira.strip()[:150]}")
        finally:
            arquivo.write_text(texto, encoding="utf-8")
            if sha(arquivo) != antes[arquivo]:
                print(f"[ GRAVE ] {arquivo} NAO voltou byte a byte")
                return 2

    print()
    for caminho, digest in antes.items():
        estado = "OK" if sha(caminho) == digest else "DIVERGIU"
        print(f"restauracao {caminho.name}: {estado} sha256:{digest[:16]}")

    codigo, _ = roda(f"{TESTE_REGIME}|{TESTE_LEGADO}")
    print(f"\nbancada apos as mutacoes: {'VERDE' if codigo == 0 else 'VERMELHA'}")
    if falhas:
        print(f"\nMUTANTES NAO MORTOS ({len(falhas)}): " + "; ".join(falhas))
        return 1
    print(f"\n{len(MUTANTES)} de {len(MUTANTES)} mutantes MORTOS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
