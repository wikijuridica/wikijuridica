#!/usr/bin/env python3
"""generate-gabarito-atribuicao-20260916 — a régua com que a atribuição do
cérebro passa a ser medida, congelada com data, método e amostra dos dois lados.

POR QUE EXISTE. O P5 endureceu a atribuição (norma e artigo têm de estar no
próprio `texto_citado`). Endurecer sem régua é trocar um número por outro sem
saber se melhorou: régua feita DEPOIS do resultado não é régua. Este arquivo
sorteia 100 dispositivos — 50 que o filtro MANTEVE e 50 que ele REMOVEU —, junta
o texto oficial do artigo e deixa o julgamento humano gravado item a item. É
contra ele que o modelo novo da GPU será comparado.

AMOSTRA DOS DOIS LADOS, e é isso que "controle" significa aqui:
  - estrato MANTIDO  -> caça FALSO NEGATIVO do filtro (atribuição errada que passou)
  - estrato REMOVIDO -> caça FALSO POSITIVO do filtro (atribuição certa que caiu)
Sortear só entre os suspeitos mediria o enriquecimento, não a população — é
precedente escrito deste repositório.

OS DOIS ESTRATOS SAEM DO GO, NUNCA DE UMA REIMPLEMENTAÇÃO EM PYTHON: o estrato
removido é a lista nomeada que `generate-revisao-extracoes` imprime; o mantido é
lido do arquivo que a própria passada produziu. Este script não decide o que o
filtro faria — ele lê o que o filtro fez.

SORTEIO DETERMINÍSTICO: stride sobre a lista ordenada por (chave, urn), com
semente = sha256 do snapshot datado. Mesma entrada, mesma amostra, sempre.

TEXTO OFICIAL: vem de data/legal-corpus/*.json, que já carrega `citation_url`
(Planalto), `document_sha256` e `fetched_at` — proveniência que este gabarito
copia para dentro de cada linha. Artigo que o corpus local não tiver sai com
`texto_oficial: ""` e `veredito: "sem_texto_oficial_local"`, contado à parte:
falta de dado se declara, não se preenche.

Uso:
    tools/generate-gabarito-atribuicao-20260916 --snapshot ARQ --depois ARQ --removidas ARQ
"""

import argparse
import glob
import hashlib
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SAIDA = "data/ai/gabarito_atribuicao_20260916.jsonl"
POR_ESTRATO = 50

RE_URN_ART = re.compile(r";([0-9A-Za-z.-]+)!art([0-9A-Za-z_-]+)")
RE_NUM_LEI_URL = re.compile(r"/(?:l|del|lcp?)0*([0-9]+)(?:compilad|consolid|\.htm)", re.I)
RE_SAI = re.compile(r'^\s*sai: (\S+) \[(\w+)\] "(.*)" art\. "(.*)" -> (\S+)$')


def carrega_corpus():
    """diploma (número) -> {'articles':..., 'citation_url':..., 'sha256':..., 'fetched_at':...}"""
    saida = {}
    for caminho in sorted(glob.glob(os.path.join(RAIZ, "data", "legal-corpus", "*.json"))):
        with open(caminho, encoding="utf-8") as f:
            d = json.load(f)
        url = d.get("citation_url", "")
        numero = ""
        if "constituicao" in url:
            numero = "1988"
        else:
            m = RE_NUM_LEI_URL.search(url)
            if m:
                numero = m.group(1).lstrip("0")
        if not numero:
            continue
        saida[numero] = {
            "arquivo": os.path.relpath(caminho, RAIZ),
            "articles": d.get("articles", {}),
            "citation_url": url,
            "document_sha256": d.get("document_sha256", ""),
            "fetched_at": d.get("fetched_at", ""),
            "nome": d.get("nome", ""),
        }
    return saida


def texto_do_artigo(corpus, urn):
    m = RE_URN_ART.search(urn)
    if not m:
        return None
    numero = m.group(1).replace(".", "").lstrip("0")
    artigo = m.group(2).split("_")[0].replace("art", "").lstrip("0") or m.group(2)
    diploma = corpus.get(numero)
    if not diploma:
        return None
    texto = diploma["articles"].get(artigo) or diploma["articles"].get(artigo.upper())
    if not texto:
        return None
    return {
        "texto_oficial": " ".join(texto.split()),
        "texto_oficial_sha256": hashlib.sha256(" ".join(texto.split()).encode("utf-8")).hexdigest(),
        "fonte_oficial_url": diploma["citation_url"],
        "fonte_documento_sha256": diploma["document_sha256"],
        "fonte_coletada_em": diploma["fetched_at"],
        "fonte_local": diploma["arquivo"],
    }


def ultima_por_chave(caminho):
    saida = {}
    with open(caminho, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if linha:
                d = json.loads(linha)
                saida[d["chave"]] = d
    return saida


def sorteia(itens, semente, quantos):
    """Stride determinístico: passo derivado da semente, sobre a lista ordenada."""
    itens = sorted(itens, key=lambda i: (i["chave"], i["urn"], i["artigo"]))
    if len(itens) <= quantos:
        return itens
    passo = len(itens) / float(quantos)
    inicio = int(semente[:8], 16) % max(1, int(passo))
    return [itens[min(len(itens) - 1, int(inicio + k * passo))] for k in range(quantos)]


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--snapshot", required=True)
    p.add_argument("--depois", required=True)
    p.add_argument("--removidas", required=True)
    args = p.parse_args()

    with open(args.snapshot, "rb") as f:
        semente = hashlib.sha256(f.read()).hexdigest()

    antes = ultima_por_chave(args.snapshot)
    depois = ultima_por_chave(args.depois)
    corpus = carrega_corpus()

    # ESTRATO REMOVIDO: a lista nomeada que o Go imprimiu.
    removidos = []
    with open(args.removidas, encoding="utf-8") as f:
        for linha in f:
            m = RE_SAI.match(linha.rstrip("\n"))
            if not m:
                continue
            chave, _, norma, artigo, urn = m.groups()
            trecho = ""
            for it in antes.get(chave, {}).get("dispositivos", []):
                if it.get("urn") == urn and it.get("norma") == norma:
                    trecho = it.get("texto_citado", "")
                    break
            removidos.append({"estrato": "removido_pelo_filtro", "chave": chave, "norma": norma,
                              "artigo": artigo, "urn": urn, "texto_citado": trecho})

    # ESTRATO MANTIDO: itens com artigo e URN LexML que sobreviveram ao filtro.
    mantidos = []
    for chave, d in depois.items():
        if d.get("executor") not in ("modelo", ""):
            continue
        for it in d.get("dispositivos", []):
            if str(it.get("urn", "")).startswith("urn:lex") and "!art" in it["urn"] and it.get("artigo"):
                mantidos.append({"estrato": "mantido_pelo_filtro", "chave": chave, "norma": it.get("norma", ""),
                                 "artigo": it["artigo"], "urn": it["urn"],
                                 "texto_citado": it.get("texto_citado", "")})

    amostra = sorteia(mantidos, semente, POR_ESTRATO) + sorteia(removidos, semente, POR_ESTRATO)
    semTexto = 0
    linhas = [json.dumps({
        "_meta": ("Gabarito de ATRIBUICAO do cerebro, congelado em 2026-09-16. 50 dispositivos que o filtro do "
                  "P5 MANTEVE (caca falso negativo) e 50 que ele REMOVEU (caca falso positivo). Sorteio por "
                  "stride deterministico sobre a lista ordenada por (chave, urn, artigo), semente = sha256 do "
                  "snapshot. O veredito nasce 'pendente' e e preenchido por leitura do trecho contra o texto "
                  "oficial do artigo."),
        "snapshot": os.path.relpath(args.snapshot, RAIZ),
        "snapshot_sha256": semente,
        "depois": os.path.relpath(args.depois, RAIZ),
        "universo_mantidos": len(mantidos),
        "universo_removidos": len(removidos),
        "por_estrato": POR_ESTRATO,
        "metodo": ("julgamento por leitura do texto_citado contra o texto oficial do artigo "
                   "(data/legal-corpus, Planalto, com sha256 e data de coleta)"),
        "produzido_por": "tools/generate-gabarito-atribuicao-20260916",
    }, ensure_ascii=False)]
    for item in amostra:
        oficial = texto_do_artigo(corpus, item["urn"])
        linha = dict(item)
        linha["texto_citado"] = " ".join(item["texto_citado"].split())
        if oficial:
            linha.update(oficial)
            linha["veredito"] = "pendente"
        else:
            linha["texto_oficial"] = ""
            linha["veredito"] = "sem_texto_oficial_local"
            semTexto += 1
        linha["julgado_por"] = ""
        linha["julgado_em"] = ""
        linhas.append(json.dumps(linha, ensure_ascii=False))
    destino = os.path.join(RAIZ, SAIDA)
    with open(destino, "w", encoding="utf-8") as f:
        f.write("\n".join(linhas) + "\n")
    print(f"gabarito: {len(amostra)} dispositivos ({len(mantidos)} mantidos e {len(removidos)} removidos no universo)")
    print(f"  sem texto oficial no corpus local: {semTexto}")
    print(f"  saida: {SAIDA}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
