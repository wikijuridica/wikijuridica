#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"

CHECKED_AT="$(date -u +%F)"
if [[ "${1:-}" == --checked-at=* ]]; then
	CHECKED_AT="${1#--checked-at=}"
	shift
elif [[ "${1:-}" == "--checked-at" ]]; then
	CHECKED_AT="$2"
	shift 2
fi

OUT="data/ops/zizmor_workflow_security_evidence.jsonl"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-zizmor-workflow-security.txt" "$ROOT/tools/zizmor_workflow_security_audit.py" "$ROOT/.github/workflows/security.yml" "$ROOT/.github/dependabot.yml" 2>/dev/null | sha256sum | awk '{print $1}')"
printf 'generate-zizmor-workflow-security-evidence: artifact_claim path=%s producer=tools/generate-zizmor-workflow-security-evidence input_fingerprint=sha256:%s output_fingerprint_expected=updated_or_stable:%s lock_scope=artifact:%s budget_ms=120000 stop_condition=zizmor_workflow_security_evidence_ready\n' \
	"$OUT" "$REQ_HASH" "$OUT" "$OUT" >&2

export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:zizmor-workflow-security:$OUT}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-15000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=1}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-zizmor_workflow_security_evidence_ready}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-$OUT}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-zizmor-workflow-security-evidence}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:$OUT}"
export WIKI_GO_CMD_ENV_WRAPPER="${WIKI_GO_CMD_ENV_WRAPPER:-$ROOT/tools/zizmor-workflow-security-env}"

exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-zizmor-workflow-security-evidence --timings --root "$ROOT" --checked-at "$CHECKED_AT" "$@"
