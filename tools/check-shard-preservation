#!/usr/bin/env python3
"""check-shard-preservation — nenhum gerador apaga pagina redigida.

O CONTRATO QUE ISTO DEFENDE. "Pagina escrita nunca e descartada": texto que um
agente redigiu foi pago pelo dono, e reprovada se CONSERTA, nunca se descarta.
Vale para gate que acusou, para lote que reprovou e para "e mais simples
reescrever".

O QUE ACONTECEU EM 2026-08-20, e por que uma regra escrita nao bastou. Os
geradores de pagina derivada liam public/ e pulavam toda rota ja existente --
uma guarda de colisao correta enquanto eles nunca haviam publicado. Depois da
primeira publicacao, passaram a ver as PROPRIAS paginas como rota alheia:

    paginas montadas: 18 | ja publicadas (puladas): 106
    shard de sumulas: 80 registros -> 18

62 paginas redigidas sumiram do estoque numa unica execucao, sem erro nenhum. O
texto estava salvo no git e foi recuperado, mas a onda diaria roda essa mesma
geracao TODA MADRUGADA, sem ninguem olhando: em uma semana o estoque derretia.

A causa foi corrigida nos geradores (a fonte de verdade de quem e dono da rota
passou a ser o published_manifest, pelo unique_intent_id). Este check existe
porque a correcao vale para TRES geradores que existem hoje, e a regra precisa
valer para o proximo, que ninguem escreveu ainda.

A INVARIANTE: um shard de v2_pages nunca perde registro ATIVO em relacao ao que
esta commitado. Pode ganhar, pode ter texto alterado, pode ganhar tombstone --
mas registro ativo que existia e sumiu e trabalho apagado, e a onda para.

Read-only: le git e disco, nao escreve nada.

Uso:
    tools/check-shard-preservation
    tools/check-shard-preservation --json
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

# DOIS DIRETORIOS, e o segundo entrou em 2026-08-26 depois de uma perda medida.
#
# Ate entao esta guarda cobria SO v2_pages. O mesmo `os.WriteFile` do mesmo
# gerador que truncou o shard de paginas truncou tambem o shard de PORTFOLIO, e
# ninguem viu:
#
#     data/editorial/v2_pages/stf-informativo-derivado-01.jsonl        HEAD 50 -> disco 4
#     data/editorial/portfolio_v2/jurisprudencia-stf-derivada-01.jsonl HEAD 50 -> disco 4
#
# A prova estava impressa e ninguem leu: o proprio check-v2-portfolio-pairing
# imprimia "10402 ja COMMITADOS, 10367 no estado atual" -- a diferenca de 35 e
# -50 do STF mais 15 novas.
#
# POR QUE O PORTFOLIO IMPORTA TANTO QUANTO A PAGINA: ele e o primeiro elo da
# cadeia shard -> manifesto -> public -> sitemap. Perder o registro de demanda
# de uma pagina que esta NO AR quebra a cadeia pela raiz, e o gate de pareamento
# passa a recusar a pagina por falta de portfolio -- que foi como 50 paginas
# publicadas ficaram sem lastro editorial nenhum.
#
# O que se protege em cada um difere, e a funcao `ativos()` cobre os dois porque
# ambos carregam `intent_id`: em v2_pages e o CORPO redigido (tombstone com
# motivo e saida sancionada); em portfolio_v2 e o REGISTRO DE DEMANDA, que nao
# tem tombstone -- toda linha conta.
DIRETORIOS = ["data/editorial/v2_pages", "data/editorial/portfolio_v2"]


def git(argumentos: list[str]) -> bytes:
    resultado = subprocess.run(["git", "-C", str(RAIZ)] + argumentos,
                               capture_output=True)
    return resultado.stdout if resultado.returncode == 0 else b""


def tombstones_com_motivo(payload: bytes) -> set[str]:
    """intent_id dos registros que viraram TOMBSTONE COM motivo declarado.

    POR QUE ESTE CONJUNTO EXISTE. Retirar uma pagina do ar pelo caminho
    sancionado (tools/retirar-pagina-do-ar) converte o registro ativo em
    tombstone: skipped=true, skip_reason dizendo POR QUE, e o texto preservado
    em .agents/runtime/paginas-retiradas/. O censo deixa de aprova-la e ela sai
    do manifesto e do sitemap na proxima transacao.

    Para a versao anterior deste check isso era indistinguivel de trabalho
    apagado -- o registro ATIVO sumia, e ele reprovava. Reprovar a retirada
    sancionada seria pior que inutil: bloquearia justamente o freio que a
    publicacao diaria exige, e num momento em que alguem esta tirando do ar uma
    pagina com defeito juridico.

    A distincao e o MOTIVO. Tombstone com skip_reason e transicao declarada;
    registro que sumiu sem deixar nada e perda. Tombstone SEM motivo cai no
    segundo caso de proposito: apagar o corpo e escrever skipped=true nao pode
    virar a forma barata de burlar esta guarda.
    """
    encontrados = set()
    for linha in payload.decode("utf-8", errors="replace").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if registro.get("skipped") is not True:
            continue
        motivo = str(registro.get("skip_reason") or "").strip()
        intent = registro.get("intent_id")
        if isinstance(intent, str) and intent and motivo:
            encontrados.add(intent)
    return encontrados


def ativos(payload: bytes) -> set[str]:
    """intent_id dos registros COM corpo. Tombstone (skipped) fica de fora.

    Tombstone e registro sem corpo que guarda o motivo do descarte; ele nao e
    texto redigido, e converter pagina em tombstone e caminho sancionado de
    supersessao. O que este check protege e o CORPO.
    """
    encontrados = set()
    for linha in payload.decode("utf-8", errors="replace").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if registro.get("skipped") is True:
            continue
        intent = registro.get("intent_id")
        if isinstance(intent, str) and intent:
            encontrados.add(intent)
    return encontrados


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--json", action="store_true")
    argumentos = analisador.parse_args()

    committados = [c for c in git(["ls-tree", "-r", "--name-only", "HEAD", "--"] + DIRETORIOS)
                   .decode().split("\n") if c.strip()]
    perdas: list[dict] = []
    conferidos = 0
    for caminho in committados:
        antes = ativos(git(["show", f"HEAD:{caminho}"]))
        arquivo = RAIZ / caminho
        if not arquivo.exists():
            # Shard commitado que sumiu do disco: perda TOTAL, e a mais grave.
            if antes:
                perdas.append({"shard": caminho, "sumiram": sorted(antes),
                               "antes": len(antes), "agora": 0,
                               "motivo": "arquivo removido do disco"})
            continue
        bytes_atuais = arquivo.read_bytes()
        depois = ativos(bytes_atuais)
        conferidos += 1
        # Registro que virou tombstone COM motivo saiu pela porta da frente:
        # e retirada declarada, nao trabalho apagado.
        sumiram = antes - depois - tombstones_com_motivo(bytes_atuais)
        if sumiram:
            perdas.append({"shard": caminho, "sumiram": sorted(sumiram),
                           "antes": len(antes), "agora": len(depois),
                           "motivo": "registros ativos desapareceram"})

    if argumentos.json:
        print(json.dumps({"shards_conferidos": conferidos, "perdas": perdas},
                         ensure_ascii=False, indent=1))
    else:
        print(f"shards conferidos contra HEAD: {conferidos}")

    if not perdas:
        print("OK: nenhum registro ativo desapareceu de nenhum shard.")
        return 0

    total = sum(len(p["sumiram"]) for p in perdas)
    print(f"\nTRABALHO APAGADO: {total} pagina(s) ativa(s) sumiram de "
          f"{len(perdas)} shard(s).", file=sys.stderr)
    for perda in perdas:
        print(f"  {perda['shard']}: {perda['antes']} -> {perda['agora']} "
              f"({perda['motivo']})", file=sys.stderr)
        for intent in perda["sumiram"][:6]:
            print(f"     {intent}", file=sys.stderr)
        if len(perda["sumiram"]) > 6:
            print(f"     ... e mais {len(perda['sumiram']) - 6}", file=sys.stderr)
    print("\n  O texto NAO esta perdido: ele esta no commit HEAD, recuperavel por", file=sys.stderr)
    print("  git show HEAD:<shard>. Mas NAO commite este estado -- corrija o", file=sys.stderr)
    print("  gerador que apagou e regere, para o conserto chegar as paginas.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
