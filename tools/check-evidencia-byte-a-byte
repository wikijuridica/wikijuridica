#!/usr/bin/env python3
"""Reprova quando o blob do git diverge do disco em arquivo cujo BYTE e evidencia.

O DEFEITO, QUE MORDEU DUAS VEZES EM 2026-09-16
----------------------------------------------
`core.autocrlf=input` nesta maquina converte CRLF em LF ao adicionar. Para
codigo isso e correto e desejado. Para arquivo cujo sha256 e PROVA, e
destruicao silenciosa: o `git add` sai com exit 0, o arquivo continua certo na
worktree, e o blob guardado e outro.

  1. Censo do STJ (commit 22f36e15). colisao/-quinta-turma__20260131.json tem
     sha256 591363b3... no disco; o git guardou 3a955bd3... Esses dois arquivos
     so PROVAM o defeito da fonte -- dois datasets servindo conteudo identico --
     porque sao byte a byte iguais entre si e ao que a fonte serviu.
  2. Fixture da coleta (frente P1). O arquivo malformado de 599 bytes tem 23
     CRLF; sem atributo o git guardava 576. O teste ficaria vermelho em qualquer
     checkout novo, por um motivo que NADA no codigo explica.

Duas vezes independentes, no mesmo dia, por caminhos diferentes. Nao e
coincidencia: e o comportamento padrao da ferramenta encontrando uma classe de
arquivo para a qual ele esta errado.

A CORRECAO E `.gitattributes` ESCOPADO AO DIRETORIO, com `* -text`
------------------------------------------------------------------
Nunca no .gitattributes da raiz: o da raiz PROIBE `-text` por escrito, e essa
proibicao esta certa la -- ela protege os JSONL da fabrica, que sao gerados por
ferramenta e nao tem sha256 publicado como evidencia.

Depois de criar o atributo, `git add` sozinho NAO basta: ele reusa o cache de
stat e nao reconverte. Use `git add --renormalize <caminhos exatos>`.

READ-ONLY. Sai 0 se todo blob bate, 1 se algum diverge, 2 se nao conseguiu
medir (o que nunca e sucesso).
"""

from __future__ import annotations

import hashlib
import subprocess
import sys
from pathlib import Path

# Diretorios onde o BYTE e evidencia, nao conveniencia. Acrescentar aqui e
# barato; esquecer de acrescentar custou duas vezes num dia.
PADROES_DE_EVIDENCIA = (
    "*/testdata/*",
    "testdata/*",
    "*/fixtures/*",
    "*censo-*/*",
    "data/source-audit/*",
    "*/golden/*",
)


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(RAIZ), *args], capture_output=True, check=False)


RAIZ = Path(__file__).resolve().parent.parent


def alvos() -> tuple[list[str], set[str]]:
    """Arquivos de evidencia rastreados, e os que estao em EDICAO na worktree.

    CONTROLE NEGATIVO, aprendido na primeira execucao desta guarda: comparar o
    blob do indice com o disco acusa QUALQUER arquivo modificado e ainda nao
    adicionado -- que e trabalho em curso, nao corrupcao. A primeira versao
    reprovou data/source-audit/v2_source_provenance.jsonl, que estava ` M` com
    20.970 linhas legitimamente reescritas por outra frente, e ZERO CRLF nos dois
    lados. Guarda que acusa trabalho em curso vira guarda que se aprende a
    ignorar.
    """
    proc = git("ls-files", "-z", "--", *PADROES_DE_EVIDENCIA)
    if proc.returncode != 0:
        print(
            f"NAO MEDIDO: git ls-files falhou: {proc.stderr.decode(errors='replace').strip()}",
            file=sys.stderr,
        )
        sys.exit(2)
    rastreados = [p for p in proc.stdout.decode("utf-8", errors="replace").split("\0") if p]

    sujos = git("diff", "--name-only", "-z", "--", *PADROES_DE_EVIDENCIA)
    if sujos.returncode != 0:
        print("NAO MEDIDO: git diff --name-only falhou", file=sys.stderr)
        sys.exit(2)
    em_edicao = {p for p in sujos.stdout.decode("utf-8", errors="replace").split("\0") if p}
    return rastreados, em_edicao


def main() -> int:
    caminhos, em_edicao = alvos()
    if not caminhos:
        print(
            "NAO MEDIDO: nenhum arquivo casou os padroes de evidencia. "
            "Isto e suspeito -- o repo tem testdata/ e censo-*/.",
            file=sys.stderr,
        )
        return 2

    divergentes, conferidos, ilegiveis = [], 0, 0
    for rel in caminhos:
        if rel in em_edicao:
            continue  # em edicao: divergir do indice e o trabalho, nao o defeito
        disco = RAIZ / rel
        if not disco.is_file():
            continue  # rastreado e ausente na worktree nao e problema deste gate
        proc = git("cat-file", "-p", f":{rel}")
        if proc.returncode != 0:
            ilegiveis += 1
            continue
        conferidos += 1
        h_blob = hashlib.sha256(proc.stdout).hexdigest()
        h_disco = hashlib.sha256(disco.read_bytes()).hexdigest()
        if h_blob != h_disco:
            divergentes.append((rel, len(proc.stdout), disco.stat().st_size, h_disco, h_blob))

    print(
        f"check-evidencia-byte-a-byte: {conferidos} arquivos de evidencia conferidos"
        + (f", {len(em_edicao)} em edicao (pulados)" if em_edicao else "")
    )

    if divergentes:
        for rel, nb, nd, hd, hb in divergentes:
            print(
                f"{rel}: blob {nb} bytes (sha {hb[:16]}) != disco {nd} bytes (sha {hd[:16]})",
                file=sys.stderr,
            )
        print(
            f"\n{len(divergentes)} arquivo(s) com o blob diferente do disco.\n"
            "Causa quase certa: core.autocrlf converteu CRLF em LF no `git add`.\n"
            "Conserto: crie <diretorio>/.gitattributes com `* -text` e rode\n"
            "  git add --renormalize <caminhos exatos>\n"
            "-- `git add` sozinho reusa o cache de stat e NAO reconverte.\n"
            "Nunca ponha `-text` no .gitattributes da raiz: ele o proibe, e com razao.",
            file=sys.stderr,
        )
        return 1

    if ilegiveis:
        print(f"  ({ilegiveis} rastreado(s) sem blob no indice, ignorados)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception:
        import traceback

        traceback.print_exc()
        print("NAO MEDIDO: o instrumento caiu. Defeito do medidor, nao veredito.", file=sys.stderr)
        sys.exit(2)
