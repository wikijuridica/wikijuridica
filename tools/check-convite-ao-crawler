#!/usr/bin/env python3
"""check-convite-ao-crawler — mede o CONVITE, não a listagem. READ-ONLY.

A PERGUNTA QUE ELE RESPONDE, e por que ela é diferente da cobertura

O portal anuncia 10.336 URLs no sitemap e o Googlebot pediu 7.316 delas. A
leitura fácil é "faltam 3.020". A leitura útil é outra: das que faltam, quantas
estão ligadas a alguma página que ele DE FATO visita?

Rota que só recebe link de páginas que o próprio Googlebot nunca pediu está
fora do alcance dele por caminho de link — o sitemap a lista, mas nada a
convida. Rota ligada a uma página que ele visita toda semana está a um clique
de distância, e a ausência dela é fila, não invisibilidade. As duas exigem
correções OPOSTAS: a primeira precisa de aresta nova a partir de página viva; a
segunda precisa só de tempo, ou de prioridade no sinal de frescor.

Nenhum instrumento deste repositório separava as duas. `crawl_coverage` conta
cobertura; `check-orphan-pages` conta alcance a partir da home. Nenhum cruza
alcance com o que o crawler REALMENTE pediu.

POR QUE ISSO E O CONTRARIO DE PETRIFICAR

Servir 304 barateia a visita, mas não cria motivo para ela. O que traz o
crawler de volta é haver algo novo E esse algo estar ligado ao que ele já
visita. Este gate mede exatamente o segundo termo — e ele é acionável: aresta
interna nova é coisa que este projeto sabe criar em lote.

AS ARMADILHAS QUE ELE EVITA, todas já medidas neste repositório:

  1. Contar bot por string de User-Agent infla. Aqui a fonte é
     `crawl_coverage_state.json`, cujo `paths_first_seen` já vem de bot
     VERIFICADO por IP contra as faixas oficiais.
  2. Percentagem sobre denominador móvel mente — a cobertura já "caiu" de
     72,01% para 70,39% enquanto o numerador SUBIA 125 URLs. Todo número aqui
     sai em valor absoluto, com o denominador nomeado ao lado.
  3. Página publicada há poucas horas não é o mesmo defeito que página
     publicada há três semanas. As duas são separadas por idade de estreia.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from collections import defaultdict
from datetime import date, datetime

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
ESTADO = os.path.join(RAIZ, "data", "ops", "crawl_coverage_state.json")
ESTREIA = os.path.join(RAIZ, "data", "editorial", "first_published_at.json")
MANIFESTO = os.path.join(RAIZ, "data", "editorial", "published_manifest.jsonl")
PUBLICO = os.path.join(RAIZ, "public")

# href interno absoluto: /area/slug/ — o portal não emite href relativo no corpo.
HREF = re.compile(r'href="(/[^"#?]*/)"')

# Idade a partir da qual "ainda não foi pedida" deixa de ser fila e vira defeito
# de alcance. Sai da mediana medida de dias até o primeiro pedido do Googlebot
# (4 dias em 2026-08-28) com folga larga: o triplo do p90 observado, que era 4.
DIAS_PARA_COBRAR = 14


def rotas_pedidas(crawler: str) -> set[str]:
    with open(ESTADO, encoding="utf-8") as fonte:
        estado = json.load(fonte)
    dados = (estado.get("crawlers_verified") or {}).get(crawler) or {}
    pedidas = set(dados.get("paths_first_seen") or {})
    pedidas |= set(dados.get("paths_seen") or [])
    return pedidas


def rotas_publicas() -> set[str]:
    rotas = set()
    with open(MANIFESTO, encoding="utf-8") as fonte:
        for linha in fonte:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            caminho = registro.get("path") or registro.get("route")
            if caminho:
                rotas.add(caminho)
    return rotas


def estreia_por_rota() -> dict[str, str]:
    """Data de estreia por ROTA, atravessando a ponte intent -> rota."""
    if not os.path.exists(ESTREIA):
        return {}
    with open(ESTREIA, encoding="utf-8") as fonte:
        bruto = json.load(fonte)
    por_intent = bruto.get("first_published_at") or bruto
    if not isinstance(por_intent, dict):
        return {}
    ponte = {}
    with open(MANIFESTO, encoding="utf-8") as fonte:
        for linha in fonte:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            intent = registro.get("unique_intent_id")
            caminho = registro.get("path") or registro.get("route")
            if intent and caminho and intent in por_intent:
                ponte[caminho] = por_intent[intent]
    return ponte


def arestas() -> tuple[dict[str, set[str]], int]:
    """Mapa destino -> conjunto de origens, lido do HTML SERVIDO.

    A fonte é o HTML em public/, e não um ledger editorial, de propósito: o que
    o crawler segue é o que está no arquivo servido. Ledger que diverge do
    arquivo é ledger errado, e medir pelo ledger esconderia a divergência.
    """
    entrada: dict[str, set[str]] = defaultdict(set)
    paginas = 0
    for atual, _dirs, arquivos in os.walk(PUBLICO):
        if "index.html" not in arquivos:
            continue
        caminho = os.path.join(atual, "index.html")
        rota = "/" + os.path.relpath(atual, PUBLICO).replace(os.sep, "/").strip("/")
        rota = "/" if rota == "/." else (rota.rstrip("/") + "/")
        if rota == "/./":
            rota = "/"
        try:
            with open(caminho, encoding="utf-8") as fonte:
                html = fonte.read()
        except (OSError, UnicodeDecodeError):
            continue
        paginas += 1
        for destino in HREF.findall(html):
            if destino != rota:
                entrada[destino].add(rota)
    return entrada, paginas


def main() -> int:
    cli = argparse.ArgumentParser(description=__doc__,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    cli.add_argument("--crawler", default="googlebot")
    cli.add_argument("--dias", type=int, default=DIAS_PARA_COBRAR,
                     help="idade de estreia a partir da qual a ausencia deixa de ser fila")
    cli.add_argument("--json", action="store_true")
    cli.add_argument("--listar", type=int, default=0,
                     help="imprime ate N rotas sem convite vivo, para virar trabalho")
    argumentos = cli.parse_args()

    for arquivo in (ESTADO, MANIFESTO):
        if not os.path.exists(arquivo):
            print("NAO MEDIDO: %s ausente" % os.path.relpath(arquivo, RAIZ), file=sys.stderr)
            return 2

    try:
        pedidas = rotas_pedidas(argumentos.crawler)
        publicas = rotas_publicas()
        entrada, paginas_lidas = arestas()
    except (OSError, ValueError, json.JSONDecodeError) as erro:
        print("NAO MEDIDO: %s" % erro, file=sys.stderr)
        return 2

    if not pedidas:
        print("NAO MEDIDO: o estado de cobertura nao tem nenhuma rota para %r"
              % argumentos.crawler, file=sys.stderr)
        return 2
    if paginas_lidas == 0:
        print("NAO MEDIDO: nenhuma pagina lida em public/", file=sys.stderr)
        return 2

    estreias = estreia_por_rota()
    hoje = date.today()

    nunca = sorted(publicas - pedidas)
    sem_convite, so_convite_morto, com_convite_vivo, sem_convite_maduras = [], [], [], []
    for rota in nunca:
        origens = entrada.get(rota, set())
        vivas = origens & pedidas
        if vivas:
            com_convite_vivo.append(rota)
            continue
        if origens:
            so_convite_morto.append(rota)
        else:
            sem_convite.append(rota)
        # Maturidade: fila ou defeito de alcance?
        quando = estreias.get(rota)
        if quando:
            try:
                idade = (hoje - datetime.fromisoformat(quando[:10]).date()).days
            except ValueError:
                idade = None
            if idade is not None and idade >= argumentos.dias:
                sem_convite_maduras.append((rota, idade))

    registro = {
        "schema_version": "convite_ao_crawler_v1",
        "crawler": argumentos.crawler,
        "paginas_lidas_em_public": paginas_lidas,
        "rotas_publicas": len(publicas),
        "rotas_ja_pedidas": len(publicas & pedidas),
        "rotas_nunca_pedidas": len(nunca),
        "nunca_pedidas_com_convite_vivo": len(com_convite_vivo),
        "nunca_pedidas_so_com_convite_morto": len(so_convite_morto),
        "nunca_pedidas_sem_nenhuma_entrada": len(sem_convite),
        "sem_convite_vivo_e_maduras": len(sem_convite_maduras),
        "dias_para_cobrar": argumentos.dias,
        "counts_as_audience": False,
    }

    if argumentos.json:
        print(json.dumps(registro, ensure_ascii=False, sort_keys=True))
    else:
        print("convite ao %s — o que ele PODE alcancar por link, nao o que listamos"
              % argumentos.crawler)
        print("  paginas lidas em public/          : %d" % paginas_lidas)
        print("  rotas publicas                    : %d" % len(publicas))
        print("  ja pedidas por ele                : %d" % registro["rotas_ja_pedidas"])
        print("  nunca pedidas                     : %d" % len(nunca))
        print("    com CONVITE VIVO (link de pagina que ele visita) : %d" % len(com_convite_vivo))
        print("    so com convite MORTO (link so de pagina que ele nunca pediu): %d" % len(so_convite_morto))
        print("    sem NENHUMA entrada de link                      : %d" % len(sem_convite))
        print("  destas, ja maduras (>= %d dias de estreia)         : %d"
              % (argumentos.dias, len(sem_convite_maduras)))

    if argumentos.listar and (so_convite_morto or sem_convite):
        print("\n  rotas sem convite vivo (ate %d):" % argumentos.listar)
        for rota in (sem_convite + so_convite_morto)[:argumentos.listar]:
            print("    %s" % rota)

    # VEREDITO (exit 1): rota madura, publicada ha tempo suficiente, que nenhuma
    # pagina visitada pelo crawler aponta. Nao e fila — e alcance. Rota nova sem
    # convite ainda nao e defeito: ela acabou de nascer.
    if sem_convite_maduras:
        print("\nREPROVADO: %d rota(s) com %d+ dias de estreia nao recebem link de NENHUMA "
              "pagina que o %s visita — o sitemap as lista, nada as convida."
              % (len(sem_convite_maduras), argumentos.dias, argumentos.crawler), file=sys.stderr)
        for rota, idade in sem_convite_maduras[:5]:
            print("       %s (%d dias)" % (rota, idade), file=sys.stderr)
        return 1
    print("\ncheck-convite-ao-crawler: toda rota madura tem ao menos um convite vivo")
    return 0


if __name__ == "__main__":
    sys.exit(main())
