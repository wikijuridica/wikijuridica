#!/usr/bin/env bash
# check-public-sem-lixo: só artefato de publicação legítimo pode estar em public/.
#
# READ-ONLY. Não escreve nada. Roda no passo 8.7/9 da onda diária, depois da
# publicação, porque mede o RESULTADO — o que ficou no disco que o nginx serve
# com `root public/`.
#
# POR QUE ELE EXISTE. `public/` é servido byte a byte pelo nginx. Qualquer
# arquivo que caia ali vira URL pública: um `.zip` esquecido, um backup `.bak`,
# um `.env`. A allowlist é a lista fechada do que a publicação PRODUZ; tudo o
# mais é lixo ou vazamento.
#
# ========================= QUATRO CORREÇÕES DE 2026-09-04 =========================
#
# (1) A FOLHA DE ESTILO EXTERNA É CONTRATO, NÃO SOBRA. Em 2026-09-03 o CSS saiu
#     do `<style>` inline de todas as páginas para `/assets/wj-<hash>.css`
#     (CLAUDE.md, "HTML leve": 82.030.155 bytes de CSS inline eram 25,9% de todo
#     o HTML publicado; o acervo caiu de 30.493 para 22.628 bytes por página).
#     A allowlist estava congelada numa medição de 2026-08-27 e passou a acusar,
#     todo dia, o artefato que o próprio contrato manda existir — foi um dos três
#     gates que terminavam a onda diária em PARCIAL.
#
#     Mas `css` NÃO entra como extensão livre. A CSP recusou `'self'` em
#     `style-src` por este motivo exato: ele "autorizaria qualquer `.css` que
#     aparecesse em `public/`". Este gate é a contraparte disciplinada dessa
#     recusa — passa UM caminho, no mesmo padrão fechado que
#     `internal/render.StylesheetPathPattern` (`^/assets/wj-[0-9a-f]{16}\.css$`)
#     emite e que `ops/nginx/security-headers.conf` autoriza. Folha com outro
#     nome, ou em outro diretório, é CSS que a CSP bloquearia no navegador:
#     reprovar aqui é achar isso no disco em vez de na tela do visitante.
#
# (2) `.br` ERA CORINGA, e essa era a falha grave. O script calculava
#     `base="${file%.br}"` — a intenção declarada de julgar a gêmea comprimida
#     pela extensão de baixo — e depois extraía a extensão de `$file`, não de
#     `$base`. A variável era escrita e NUNCA lida. Com `br` na allowlist, o
#     sufixo virava passe livre: `instalador.exe.br` passava. E o nginx serve
#     `$uri.br` com `brotli_static on` sem comparar tipo nem frescor — ou seja,
#     era conteúdo servido ao público que nenhum gate enxergava.
#     Agora `br` saiu da allowlist e a gêmea é julgada pela extensão de baixo,
#     que é o que a intenção original dizia. É mais estrito, não mais frouxo.
#
# (3) GÊMEA `.br` ÓRFÃ REPROVA. `brotli_static on` entrega `$uri.br` sem exigir
#     que o fonte exista. Um `.br` sem original é uma URL pública cujo conteúdo
#     nenhuma etapa da publicação regenera — a versão comprimida de um arquivo
#     que já foi podado. Medido hoje sobre o acervo real: 10.479 gêmeas, zero
#     órfãs. O gate passa a manter esse zero.
#
# (4) A EXTENSÃO SE EXTRAI DO BASENAME. `${file##*.}` sobre o caminho inteiro
#     devolvia `2/LEIAME` para `public/v1.2/LEIAME`: o gate reprovava por
#     acidente, com uma mensagem que mandaria o operador procurar uma extensão
#     `.2/LEIAME` que não existe.
#
# O INVENTÁRIO CONGELADO SAIU. Havia aqui um `EXPECTED_INVENTORY` literal
# ("10331.html…") de 2026-08-27, que nenhuma linha do script lia e que já
# divergia do acervo (10.369 HTML hoje). Constante que ninguém lê e que mente
# sobre o disco é bug pelo R1. No lugar entra o inventário MEDIDO, impresso a
# cada execução: ele não pode envelhecer porque nasce da varredura.
#
# Prova: `tools/test_check_public_sem_lixo.py` (11 casos, descoberto pelo glob
# `tools/test_*.py` do `run-qualidade-diaria` — gate que ninguém roda é gate que
# não existe).
set -euo pipefail

# O que a publicação produz. `br` NÃO está aqui de propósito — ver (2).
ALLOWED_EXTS=(html png xml txt svg ico)

# Padrão fechado da folha única, espelho de internal/render.StylesheetPathPattern.
FOLHA_UNICA='^public/assets/wj-[0-9a-f]{16}\.css$'

# public/datasets/ É O CANAL DE DADOS ABERTOS, e ele produz três formas — nenhuma
# delas cabia na allowlist geral. Acrescentado em 2026-09-09, depois de este gate
# derrubar a onda diária inteira (`data/ops/daily_content_runs.jsonl`,
# resultado "parcial") acusando 16 arquivos que a produção serve com HTTP 200.
#
# NÃO É AFROUXAMENTO, E A PROVA É O VHOST: `ops/nginx/wikijuridica.conf:1154-1158`
# registra que `gz` entrou na allowlist de extensão do nginx em 2026-09-08
# exatamente para os dumps de public/datasets/, e `json` já estava lá. Quem
# estava atrasado era este gate — ele reprovava o artefato que o servidor
# publica, que é a forma mais cara de falso positivo: derruba a onda e não
# aponta defeito nenhum.
#
# O padrão é FECHADO, não uma extensão liberada em todo lugar: `.json` e
# `.jsonl.gz` continuam proibidos fora de public/datasets/, e dentro dele só
# passam o índice, o radar e o dump datado que tools/generate-datasets-publicos
# nomeia. Arquivo com outro nome ali continua reprovando.
DATASET_INDICE='^public/datasets/(datasets|radar-ia)\.json$'
DATASET_DUMP='^public/datasets/[a-z0-9-]+-[0-9]{8}\.jsonl\.gz$'

EXIT_CODE=0
declare -A INVENTARIO=()

while IFS= read -r file; do
	# A gêmea comprimida é julgada pela extensão de BAIXO, e exige o original.
	alvo="$file"
	if [[ "$file" == *.br ]]; then
		alvo="${file%.br}"
		if [[ ! -f "$alvo" ]]; then
			echo "check-public-sem-lixo: FAIL $file — gêmea .br sem o original '$alvo' (brotli_static serviria conteúdo que nenhuma etapa regenera)"
			EXIT_CODE=1
			continue
		fi
	fi

	# O canal de dados abertos é julgado pelo NOME INTEIRO, antes da regra de
	# extensão: `acervo-metadados-20260909.jsonl.gz` tem duas extensões e a de
	# baixo (`jsonl`) também não está na allowlist geral, de propósito.
	if [[ "$alvo" =~ $DATASET_INDICE ]] || [[ "$alvo" =~ $DATASET_DUMP ]]; then
		INVENTARIO[dataset]=$((${INVENTARIO[dataset]:-0} + 1))
		continue
	fi
	if [[ "$alvo" == public/datasets/* ]]; then
		echo "check-public-sem-lixo: FAIL $file — em public/datasets/ fora do nome fechado do canal de dados abertos (datasets.json, radar-ia.json ou <slug>-AAAAMMDD.jsonl.gz)"
		EXIT_CODE=1
		continue
	fi

	nome="${alvo##*/}"
	ext="${nome##*.}"
	if [ "$ext" = "$nome" ]; then
		echo "check-public-sem-lixo: FAIL $file — arquivo sem extensão (não é permitido)"
		EXIT_CODE=1
		continue
	fi

	# /assets/ SÓ TEM A FOLHA, e isso é o que a produção faz — verificado no
	# vhost, não presumido: `location ^~ /assets/` aninha
	# `~ "^/assets/wj-[0-9a-f]{16}\.css$"` e devolve `return 404` para todo o
	# resto do diretório. Arquivo depositado ali com outro nome não é servido
	# por ninguém: é peso morto em `public/` com um 404 esperando.
	if [[ "$alvo" == public/assets/* ]] && [[ ! "$alvo" =~ $FOLHA_UNICA ]]; then
		echo "check-public-sem-lixo: FAIL $file — em public/assets/ fora do nome fechado da folha única (wj-<16 hex>.css); o nginx devolve 404 para todo o resto do diretório"
		EXIT_CODE=1
		continue
	fi

	if [ "$ext" = "css" ]; then
		# Só a folha do padrão fechado. Qualquer outro .css é 404 no nginx (a
		# allowlist de extensão do vhost NÃO tem `css`) e seria bloqueado pela
		# CSP, que nomeia a URL exata em vez de usar 'self' — ver (1).
		if [[ ! "$alvo" =~ $FOLHA_UNICA ]]; then
			echo "check-public-sem-lixo: FAIL $file — CSS fora do caminho fechado da folha única (/assets/wj-<16 hex>.css); o nginx devolve 404 e a CSP não o autorizaria"
			EXIT_CODE=1
			continue
		fi
		INVENTARIO[css]=$((${INVENTARIO[css]:-0} + 1))
		continue
	fi

	if [[ ! " ${ALLOWED_EXTS[*]} " =~ [[:space:]]${ext}[[:space:]] ]]; then
		echo "check-public-sem-lixo: FAIL $file — extensão '.${ext}' não permitida"
		EXIT_CODE=1
		continue
	fi

	INVENTARIO[$ext]=$((${INVENTARIO[$ext]:-0} + 1))
done < <(find public -type f ! -name ".gitkeep" 2>/dev/null | sort)

# Inventário MEDIDO nesta execução (a gêmea .br conta na extensão de baixo).
echo "check-public-sem-lixo: inventário medido (gêmea .br contada na extensão de baixo)"
for ext in "${!INVENTARIO[@]}"; do
	echo "    ${INVENTARIO[$ext]} .${ext}"
done | sort -rn

if [ $EXIT_CODE -eq 0 ]; then
	echo "check-public-sem-lixo: pass — todas as extensões válidas"
fi

exit $EXIT_CODE
