#!/usr/bin/env python3
"""Reprova quando uma norma oficial que o acervo CITA foi alterada e ninguém
tomou ciência disso por escrito.

O QUE ELE MEDE, e o que não mede.

Ele lê a última linha de `data/ops/normative_freshness_daily.jsonl`, que
`tools/generate-normative-freshness` grava, e cruza os documentos classificados
como `alteracao_legislativa` com o ledger de ciência
`data/ops/normative_freshness_ciencia.jsonl`. Reprova quando sobra documento
alterado, com alcance no acervo, que ninguém registrou ter lido.

NÃO reprova por classe `marcacao` (o Planalto reeditou o HTML e o texto normativo
é o mesmo) nem por `indeterminado` (um dos lados não tinha impressão — quase
sempre acórdão do STJ servido por `GetInteiroTeorDoAcordao`, que monta HTML por
requisição). Reprovar por essas duas classes seria o gate que acusa a coisa ao
lado, e nesta casa isso já custou sete detectores num único dia.

E NÃO afirma que a alteração atinge o artigo que a página cita. Isso é leitura
jurídica; o gate entrega alcance e nome da norma alteradora, e a decisão
editorial é de quem lê.

O LEDGER DE CIÊNCIA é uma linha por documento:

    {"documento": "planalto.gov.br/ccivil_03/…/l13105.htm",
     "norma_alteradora": "Lei 15484/2026",
     "ciencia_em": "2026-09-10",
     "veredito": "revisado" | "sem_efeito_no_acervo" | "em_revisao",
     "por": "<quem leu>",
     "nota": "<o que foi conferido>"}

Tomar ciência NÃO é apagar o achado: a linha fica, com data e veredito, e se a
mesma norma voltar a mudar (`norma_alteradora` diferente) o gate reprova de novo.

FRESCOR DA PRÓPRIA SÉRIE: se a última linha tiver mais de `--dias-de-tolerancia`
dias, reprova por série velha. Gate que lê medição parada é gate desligado.

Uso:
    tools/check-normative-freshness
    tools/check-normative-freshness --json
"""
from __future__ import annotations

import argparse
import datetime
import json
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
SERIE = RAIZ / "data/ops/normative_freshness_daily.jsonl"
CIENCIA = RAIZ / "data/ops/normative_freshness_ciencia.jsonl"


def ultima_linha(caminho: Path) -> dict | None:
    if not caminho.exists():
        return None
    ultima = None
    for linha in caminho.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if linha:
            ultima = json.loads(linha)
    return ultima


def carrega_ciencia(caminho: Path) -> tuple[dict, list]:
    """Devolve (documento -> normas já lidas, pendências ainda em revisão).

    O LEDGER TEM MEMÓRIA E A SÉRIE NÃO, e é por isso que as duas coisas saem
    daqui juntas. A série de cada dia lista o que mudou DESDE a última linha de
    base; assim que o baseline é regravado, o documento deixa de aparecer nela —
    o CTN da rodada de 2026-09-10 não vai reaparecer amanhã, porque já entrou no
    baseline como estado atual. Se o gate lesse só a série, um `em_revisao`
    escrito hoje viraria verde amanhã com as 111 páginas ainda por revisar.

    Uma linha POSTERIOR para o mesmo (documento, norma_alteradora) com veredito
    `revisado` ou `sem_efeito_no_acervo` encerra a pendência. É assim que o
    trabalho se declara concluído: escrevendo, não deixando de escrever.
    """
    lido: dict[str, set[str]] = {}
    pendencias: dict[tuple, dict] = {}
    if not caminho.exists():
        return lido, []
    for numero, linha in enumerate(caminho.read_text(encoding="utf-8").splitlines(), 1):
        linha = linha.strip()
        if not linha:
            continue
        registro = json.loads(linha)
        documento = registro.get("documento")
        if not documento:
            raise ValueError("%s:%d: linha sem 'documento'" % (CIENCIA.name, numero))
        if not registro.get("ciencia_em") or not registro.get("veredito"):
            raise ValueError("%s:%d: ciencia_em e veredito sao obrigatorios"
                             % (CIENCIA.name, numero))
        # SO DOIS VEREDITOS LIBERAM, e o terceiro existe de proposito.
        #
        # `revisado`            alguem leu a alteracao e conferiu as paginas.
        # `sem_efeito_no_acervo` alguem leu e mediu que nenhuma pagina afirma o
        #                        que mudou.
        # `em_revisao`          o trabalho comecou e NAO terminou — nao libera.
        #
        # Sem essa distincao, escrever "em_revisao" calaria o gate no minuto em
        # que o achado aparece, que e exatamente a quitacao sem leitura que ele
        # existe para impedir. Veredito desconhecido tambem nao libera: quem
        # inventar um rotulo novo tem de decidir aqui o que ele significa.
        chave = (documento, registro.get("norma_alteradora") or "")
        if registro["veredito"] == "em_revisao":
            pendencias[chave] = registro
            continue
        if registro["veredito"] not in ("revisado", "sem_efeito_no_acervo"):
            continue
        # A ordem do arquivo é a ordem do tempo: uma conclusão posterior encerra
        # a pendência declarada antes.
        #
        # `"*"` numa CONCLUSÃO encerra toda pendência do documento, porque ele
        # significa "li todas as alteradoras desta rodada" — inclusive a que
        # abriu a pendência sob outro nome. O inverso não vale: pendência aberta
        # com `"*"` não se encerra citando uma alteradora só, que cobriria menos
        # do que se declarou em revisão.
        if chave[1] == "*":
            for aberta in [c for c in pendencias if c[0] == documento]:
                pendencias.pop(aberta)
        else:
            pendencias.pop(chave, None)
        lido.setdefault(documento, set()).add(chave[1])
    return lido, list(pendencias.values())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    parser.add_argument("--dias-de-tolerancia", type=int, default=8,
                        help="idade máxima da última linha da série (padrão 8)")
    argumentos = parser.parse_args()

    linha = ultima_linha(SERIE)
    if linha is None:
        print("check-normative-freshness: serie ausente em %s — rode "
              "tools/generate-normative-freshness" % SERIE.relative_to(RAIZ),
              file=sys.stderr)
        return 2

    try:
        ciencia, em_revisao = carrega_ciencia(CIENCIA)
    except ValueError as erro:
        print("check-normative-freshness: ledger de ciencia invalido: %s" % erro,
              file=sys.stderr)
        return 1

    hoje = datetime.date.today()
    data_da_serie = datetime.date.fromisoformat(linha["date"])
    idade = (hoje - data_da_serie).days

    pendentes = []
    for documento in linha.get("documentos") or []:
        if documento.get("classe") != "alteracao_legislativa":
            continue
        if documento.get("paginas_que_citam", 0) <= 0:
            continue
        normas = documento.get("normas_novas") or []
        if not normas:
            normas = ["ano_max=%s" % documento.get("ano_max_atual")]
        ja_lidas = ciencia.get(documento["documento"], set())
        # TODAS as normas alteradoras novas precisam de ciencia, nao a primeira.
        #
        # A primeira versao deste gate liberava por `normas_novas[0]`, e a lista
        # vem ORDENADA — em 2026-09-10 isso fez o CTN aparecer sob
        # "Lei Complementar 118/2005" enquanto a alteracao que importava era a
        # LC 236/2026, e uma linha de ciencia escrita para a segunda nao casava
        # com a primeira. Escolher um elemento de um conjunto por posicao e a
        # mesma falha de instrumento que este repositorio ja pagou sete vezes
        # num dia so.
        #
        # `"*"` na linha de ciencia significa "li TODAS as alteradoras desta
        # rodada para este documento" — e continua sem dar quitacao futura,
        # porque uma alteradora que apareca depois nao estara coberta por ele
        # se a linha for reescrita com o conjunto de entao.
        faltando = [n for n in normas if n not in ja_lidas]
        if "*" in ja_lidas or not faltando:
            continue
        pendentes.append({
            "documento": documento["documento"],
            "paginas_que_citam": documento["paginas_que_citam"],
            "norma_alteradora": ", ".join(faltando[:3]),
            "normas_sem_ciencia": faltando,
            "ano_max": "%s->%s" % (documento.get("ano_max_anterior"),
                                   documento.get("ano_max_atual")),
        })
    # As pendências do LEDGER entram mesmo quando a série de hoje não as traz.
    ja_listados = {d["documento"] for d in pendentes}
    for registro in em_revisao:
        if registro["documento"] in ja_listados:
            continue
        pendentes.append({
            "documento": registro["documento"],
            "paginas_que_citam": registro.get("paginas_que_citam", 0),
            "norma_alteradora": registro.get("norma_alteradora") or "",
            "origem": "ledger:em_revisao",
            "ciencia_em": registro.get("ciencia_em"),
        })
    pendentes.sort(key=lambda d: -d["paginas_que_citam"])
    alcance = sum(d["paginas_que_citam"] for d in pendentes)

    resultado = {
        "check": "normative-freshness",
        "date": linha["date"],
        "idade_da_serie_em_dias": idade,
        "comparado_com": linha.get("comparado_com"),
        "alteracao_legislativa": linha.get("alteracao_legislativa"),
        "marcacao": linha.get("marcacao"),
        "pendentes_sem_ciencia": len(pendentes),
        "pendentes_do_ledger_em_revisao": len(em_revisao),
        "paginas_alcancadas": alcance,
        "documentos": pendentes[:20],
        "counts_as_audience": False,
    }

    serie_velha = idade > argumentos.dias_de_tolerancia
    passou = not pendentes and not serie_velha
    resultado["passou"] = passou

    if argumentos.json:
        print(json.dumps(resultado, ensure_ascii=False))
    else:
        print("== frescor das normas citadas ==")
        print("  serie de %s (%d dia(s) atras), comparada com %s"
              % (linha["date"], idade, linha.get("comparado_com")))
        print("  alteracao legislativa %s · marcacao %s"
              % (linha.get("alteracao_legislativa"), linha.get("marcacao")))
        print("  sem ciencia registrada  %d documento(s), %d pagina(s) alcancada(s)"
              % (len(pendentes), alcance))
        for documento in pendentes[:20]:
            print("    %-52s %5d pagina(s)  %s"
                  % (documento["documento"][:52], documento["paginas_que_citam"],
                     documento["norma_alteradora"]))
        print()
        if serie_velha:
            print("  SERIE VELHA: %d dia(s), tolerancia %d. Gate que le medicao parada"
                  % (idade, argumentos.dias_de_tolerancia))
            print("  e gate desligado. Rode tools/generate-normative-freshness --rede.")
        if pendentes:
            print("  REPROVADO: norma alterada que o acervo cita, sem ciencia registrada.")
            print("  Leia a alteracao, decida o efeito e escreva a linha em")
            print("  data/ops/normative_freshness_ciencia.jsonl com veredito e data.")
            print("  Tomar ciencia NAO apaga o achado: a linha fica, e se a norma")
            print("  voltar a mudar o gate reprova de novo.")
        if passou:
            print("check-normative-freshness: OK")
    return 0 if passou else 1


if __name__ == "__main__":
    raise SystemExit(main())
