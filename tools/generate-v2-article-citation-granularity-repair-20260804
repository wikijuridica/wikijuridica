@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def word_count(record: dict) -> int:
    """Reproduz `bodyWordCount` de internal/v2ingest/validate.go:984."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def _periodize(digits: str) -> str:
    return digits[:-3] + "." + digits[-3:]


def apply_format_repairs_to_record(record: dict, digit_targets: list[str]) -> int:
    """Aplica separador de milhar aos digitos alvo nos campos publicos.

    Retorna quantas substituicoes efetivas ocorreram (0 se ja aplicado).
    """
    changed = 0
    for digits in digit_targets:
        pattern = re.compile(r"(?<!\d)" + re.escape(digits) + r"(?!\d)")
        replacement = _periodize(digits)

        for field in TEXT_FIELDS:
            value = record.get(field)
            if not value or not isinstance(value, str):
                continue
            new_value, count = pattern.subn(replacement, value)
            if count:
                record[field] = new_value
                changed += count

        for section in record.get("sections") or []:
            for field in ("heading", "text"):
                value = section.get(field)
                if not value or not isinstance(value, str):
                    continue
                new_value, count = pattern.subn(replacement, value)
                if count:
                    section[field] = new_value
                    changed += count
    return changed


def preflight() -> None:
    problems: list[str] = []
    for intent, (_shard, _digest, before, after) in sorted(PHRASE_REPAIRS.items()):
        lowered = after.lower()
        for term in FORBIDDEN:
            if term in lowered:
                problems.append(f"{intent}: texto novo reintroduz {term!r}")
        if before == after:
            problems.append(f"{intent}: texto novo identico ao atual")
        if len(after.split()) < 15:
            problems.append(f"{intent}: texto novo curto demais ({len(after.split())} palavras)")
    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(
        f"preflight ok: {len(FORMAT_REPAIRS)} pagina(s) formatacao, "
        f"{len(PHRASE_REPAIRS)} pagina(s) frase, sem vocabulario de promessa"
    )


def apply_shard(
    shard: str,
    format_intents: dict[str, list[str]],
    phrase_intents: dict[str, tuple[str, str, str]],
) -> int:
    path = ROOT / shard
    lines = path.read_bytes().decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    output: list[str] = []
    total_changed = 0
    seen: set[str] = set()

    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{shard}: linha em branco {number}")
        record = json.loads(raw)
        intent = record.get("intent_id")

        if intent in format_intents:
            seen.add(intent)
            digit_targets = format_intents[intent]
            changed = apply_format_repairs_to_record(record, digit_targets)

            meta_changed = False
            if intent in META_TRIM:
                before_meta, after_meta = META_TRIM[intent]
                meta = record.get("meta_description") or ""
                if before_meta in meta:
                    record["meta_description"] = meta.replace(before_meta, after_meta)
                    meta_changed = True
                elif after_meta not in meta:
                    raise SystemExit(
                        f"{shard} ({intent}): META_TRIM nao encontrou nem o trecho "
                        "antigo nem o novo na meta_description atual."
                    )

            expected_wc = word_count(record)
            if changed == 0 and not meta_changed and record.get("word_count") == expected_wc:
                output.append(raw)
                continue
            record["word_count"] = expected_wc
            output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
            if changed or meta_changed:
                total_changed += 1
                print(
                    f"  [formato] {intent}: {changed} ocorrencia(s) periodizada(s)"
                    + (" + meta_description ajustada" if meta_changed else "")
                )
            else:
                print(f"  [formato] {intent}: word_count corrigido -> {expected_wc}")
            continue

        if intent in phrase_intents:
            seen.add(intent)
            digest, before, after = phrase_intents[intent]
            full_body = json.dumps(
                [record.get("opening")] + (record.get("sections") or []),
                ensure_ascii=False,
            )
            if after in full_body:
                expected = word_count(record)
                if record.get("word_count") != expected:
                    record["word_count"] = expected
                    output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
                    total_changed += 1
                    print(f"  [frase] word_count corrigido: {intent} -> {expected}")
                    continue
                output.append(raw)
                continue

            current = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
            if current != digest:
                raise SystemExit(
                    f"CAS FALHOU em {shard}:{number} ({intent}): linha atual nao e a esperada.\n"
                    f"  esperado: {digest}\n  atual:    {current}\n"
                    "Outra frente tocou este registro. Reler o conteudo vivo antes de reaplicar."
                )

            # Procura o trecho no opening e em cada secao (heading/text nunca
            # e onde a frase alvo mora nestes 3 casos, mas cobrimos por
            # generalidade e seguranca).
            hit_fields: list[tuple[str, dict | None, str]] = []
            opening = record.get("opening") or ""
            if before in opening:
                hit_fields.append(("opening", None, opening))
            for section in record.get("sections") or []:
                text = section.get("text") or ""
                if before in text:
                    hit_fields.append(("section_text", section, text))
                heading = section.get("heading") or ""
                if before in heading:
                    hit_fields.append(("section_heading", section, heading))

            if len(hit_fields) != 1:
                raise SystemExit(
                    f"{shard}:{number} ({intent}): trecho esperado aparece "
                    f"{len(hit_fields)}x (deveria ser 1). Abortado sem escrever."
                )

            field_kind, section_ref, _value = hit_fields[0]
            if field_kind == "opening":
                record["opening"] = opening.replace(before, after)
            elif field_kind == "section_text":
                section_ref["text"] = section_ref["text"].replace(before, after)
            elif field_kind == "section_heading":
                section_ref["heading"] = section_ref["heading"].replace(before, after)

            record["word_count"] = word_count(record)
            output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
            total_changed += 1
            print(f"  [frase] {intent}: citacao integrada ({field_kind})")
            continue

        output.append(raw)

    missing = (set(format_intents) | set(phrase_intents)) - seen
    if missing:
        raise SystemExit(f"{shard}: intents nao encontrados: {sorted(missing)}")

    if total_changed:
        payload = "\n".join(output)
        if trailing_newline:
            payload += "\n"
        atomic_write(path, payload.encode("utf-8"))

    print(f"{shard}: reescritos={total_changed}")
    return total_changed


def main() -> int:
    preflight()

    by_shard_format: dict[str, dict[str, list[str]]] = {}
    for intent, (shard, digits) in FORMAT_REPAIRS.items():
        by_shard_format.setdefault(shard, {})[intent] = digits

    by_shard_phrase: dict[str, dict[str, tuple[str, str, str]]] = {}
    for intent, (shard, digest, before, after) in PHRASE_REPAIRS.items():
        by_shard_phrase.setdefault(shard, {})[intent] = (digest, before, after)

    shards = sorted(set(by_shard_format) | set(by_shard_phrase))

    total = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for shard in shards:
                    total += apply_shard(
                        shard,
                        by_shard_format.get(shard, {}),
                        by_shard_phrase.get(shard, {}),
                    )
    except StockEpochBusy as error:
        print(
            f"generate-v2-article-citation-granularity-repair-20260804: estoque ocupado: {error}",
            file=sys.stderr,
        )
        return 75

    if total:
        print("OK. Reingerir o estoque para o espelho refletir a correcao.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
