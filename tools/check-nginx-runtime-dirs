#!/usr/bin/env python3
"""check-nginx-runtime-dirs — os diretórios de runtime do nginx pertencem a quem os usa?

READ-ONLY (a escrita de teste é um arquivo vazio criado e apagado no próprio
diretório). Sai 1 quando algum diretório de `-p var/nginx/` (cache, proxy, body,
fastcgi, scgi, uwsgi) não pertence ao usuário da unit ou não aceita escrita;
sai 2 quando não consegue medir.

POR QUE EXISTE (2026-09-02, 11:19–11:32). `sudo nginx -t` rodado como root cria
os diretórios de temp/cache do prefixo e os RE-ATRIBUI ao usuário da diretiva
`user` — que não existia no conf, logo `nobody`. Os workers rodam como rafael
(User= da unit): EACCES em cada objeto do proxy_cache, gêmea Markdown, cards e
lote em 500 por 13 minutos, 404 truncado em 0 B virando 520 na borda, e o vigia
dizendo OK porque sondava o Go direto. `var/nginx/proxy` já estava assim desde
01/09 pelo mesmo caminho. A diretiva `user rafael rafael;` fecha a causa; este
gate apanha qualquer regressão antes do reload (deploy, passo 4) e na qualidade
diária.
"""
import os
import pwd
import subprocess
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
DIRS = ("cache", "proxy", "body", "fastcgi", "scgi", "uwsgi")
UNIT = "wikijuridica-nginx.service"


def usuario_da_unit():
    try:
        r = subprocess.run(["systemctl", "show", UNIT, "-p", "User", "--value"], capture_output=True, text=True, timeout=15)
        u = r.stdout.strip()
        return u or None
    except Exception:
        return None


def main():
    esperado = usuario_da_unit() or os.environ.get("WIKI_NGINX_USER") or "rafael"
    base = os.path.join(RAIZ, "var/nginx")
    if not os.path.isdir(base):
        print(f"INCONCLUSIVO: {base} não existe", file=sys.stderr)
        return 2
    problemas = []
    for nome in DIRS:
        d = os.path.join(base, nome)
        if not os.path.isdir(d):
            continue  # o nginx cria ao subir; ausente não é dono errado
        st = os.stat(d)
        dono = pwd.getpwuid(st.st_uid).pw_name
        if dono != esperado:
            problemas.append(f"{d}: dono {dono}, esperado {esperado} (User= da unit). "
                             f"Remédio: sudo chown -R {esperado}:{esperado} {d} && sudo systemctl reload wikijuridica-nginx")
            continue
        if os.geteuid() == st.st_uid:
            sonda = os.path.join(d, ".check-nginx-runtime-dirs")
            try:
                open(sonda, "w").close(); os.remove(sonda)
            except OSError as erro:
                problemas.append(f"{d}: dono certo mas sem escrita ({erro})")
    print(f"var/nginx: {len([n for n in DIRS if os.path.isdir(os.path.join(base, n))])} diretório(s), usuário esperado {esperado}")
    if problemas:
        print("\ncheck-nginx-runtime-dirs: FAIL")
        for p in problemas:
            print(f"  - {p}")
        print("\n  Com dono errado o proxy_cache dá EACCES e o canal de máquina responde 500 (medido 02/09/2026).")
        return 1
    print("\ncheck-nginx-runtime-dirs: OK (todos os diretórios de runtime pertencem ao usuário da unit e aceitam escrita)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
