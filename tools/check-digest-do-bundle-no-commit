#!/usr/bin/env python3
"""check-digest-do-bundle-no-commit — quem mexe no bundle anti-loop reancora o
digest NO MESMO COMMIT.

POR QUE EXISTE, e a medição é de três ocorrências da MESMA falha.

`.codex/hooks.json` embute, em três comandos (PreToolUse, PostToolUse, Stop), um
`--expected-bundle-digest sha256:...` que amarra o hook anti-loop aos 12 arquivos
que implementam a sua trilha de recibo. Quando qualquer um deles muda e o digest
não é reancorado, TODA chamada de ferramenta passa a bater em
`transitive_bundle_digest_mismatch` — e o modo de falha é mudo até alguém rodar a
suíte.

    2026-08-30  `62bd1d19` mudou internal/goalbaseline/baseline.go (+70 linhas).
                Seis dias de hook recusando tudo, descobertos em 2026-09-05.
    2026-09-05  `abb1a735` consertou o valor E criou
                `tools/generate-codex-hooks-digest`, para o número deixar de ser
                digitado à mão.
    2026-09-10  `4286c200` mudou internal/goalbaseline/baseline.go DE NOVO.
                Medido em 2026-09-11: arquivo `sha256:a0c551ea…`, bundre no disco
                `sha256:0f0c818e…`, e `tools/test_codex_anti_loop_hooks.py`
                vermelho na bancada de 2026-09-10 com duas falhas.

A ferramenta de conserto existe desde a segunda ocorrência e mesmo assim houve a
terceira: **nada a executa**. É a lição que o próprio `.githooks/pre-commit`
registra ao lado do gate de govulncheck — *"gate que existe e não roda é igual a
gate que não existe"*.

POR QUE ESTE GATE NÃO RECALCULA SOBRE O DISCO. Este repositório manda commitar
por pathspec (`git commit -F msg -- <caminhos>`), e o disco de um commit parcial
carrega trabalho de outras frentes. Reprovar o meu commit porque OUTRA sessão tem
`baseline.go` modificado e não commitado seria falso positivo caro — a família de
defeito que mais custou nesta casa. O gate lê SÓ o índice do commit e cobra a
disciplina que de fato falhou: se o commit muda arquivo do bundle, o `hooks.json`
reancorado entra no mesmo commit.

A LISTA DO BUNDLE NÃO É COPIADA. Ela vem de `anti_loop._integrity_bundle_files()`,
a mesma função que o hook usa em tempo de execução — uma segunda lista divergiria
na primeira edição, que é exatamente o defeito que este gate persegue.

Custo: ZERO quando o commit não toca o bundle; uma leitura de índice quando toca.

Uso:
    ./tools/check-digest-do-bundle-no-commit
    WIKI_BUNDLE_ARQUIVOS_DO_COMMIT=<arquivo com um caminho por linha> \
        ./tools/check-digest-do-bundle-no-commit
"""
from __future__ import annotations

import importlib.util
import os
import pathlib
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
HOOKS_JSON_REL = ".codex/hooks.json"


def carrega_anti_loop():
    caminho = RAIZ / ".codex" / "hooks" / "anti_loop.py"
    if not caminho.exists():
        return None
    spec = importlib.util.spec_from_file_location("anti_loop", str(caminho))
    if spec is None or spec.loader is None:
        return None
    modulo = importlib.util.module_from_spec(spec)
    # O nome tem de estar em sys.modules ANTES do exec: o módulo usa
    # `dataclasses` com KW_ONLY, e a resolução de anotação consulta
    # `sys.modules[cls.__module__]`. Sem esta linha o import estoura com
    # `AttributeError: 'NoneType' object has no attribute '__dict__'` — mesma
    # pegadinha que `tools/generate-codex-hooks-digest:55-57` já registra.
    sys.modules["anti_loop"] = modulo
    spec.loader.exec_module(modulo)
    return modulo


def arquivos_do_commit() -> list[str] | None:
    """Os caminhos que ESTE commit carrega. None = não há índice a ler."""
    substituto = os.environ.get("WIKI_BUNDLE_ARQUIVOS_DO_COMMIT")
    if substituto:
        caminho = pathlib.Path(substituto)
        if not caminho.is_file():
            print(f"check-digest-do-bundle-no-commit: {substituto} não existe", file=sys.stderr)
            return None
        return [linha.strip() for linha in caminho.read_text(encoding="utf-8").splitlines() if linha.strip()]
    try:
        saida = subprocess.run(
            ["git", "diff", "--cached", "--name-only"],
            cwd=RAIZ, capture_output=True, text=True, timeout=30, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    if saida.returncode != 0:
        return None
    return [linha.strip() for linha in saida.stdout.splitlines() if linha.strip()]


def main() -> int:
    modulo = carrega_anti_loop()
    if modulo is None:
        # Sem o hook não há bundle a guardar, e ausência não é reprovação:
        # instalação do repositório sem `.codex/` é caso legítimo.
        return 0

    do_commit = arquivos_do_commit()
    if do_commit is None:
        return 0
    no_commit = set(do_commit)

    bundle = {
        caminho.relative_to(RAIZ).as_posix()
        for caminho in modulo._integrity_bundle_files()  # noqa: SLF001 — fonte única, ver o cabeçalho
    }
    tocados = sorted(bundle & no_commit)
    if not tocados:
        return 0
    if HOOKS_JSON_REL in no_commit:
        return 0

    print("check-digest-do-bundle-no-commit: REPROVADO — o commit muda "
          f"{len(tocados)} arquivo(s) do bundle anti-loop sem reancorar o digest:", file=sys.stderr)
    for caminho in tocados:
        print(f"  {caminho}", file=sys.stderr)
    print(f"  conserto: ./tools/generate-codex-hooks-digest && git add {HOOKS_JSON_REL}", file=sys.stderr)
    print("  sem isso, TODA chamada de ferramenta do Codex passa a bater em "
          "transitive_bundle_digest_mismatch, em silêncio.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
