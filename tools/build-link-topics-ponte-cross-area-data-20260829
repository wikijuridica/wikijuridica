#!/usr/bin/env python3
"""build-link-topics-ponte-cross-area-data-20260829 — monta o .data.json do gerador de pontes.

Consolida os vereditos jurídico-editoriais de
`.agents/runtime/link-mesh-ponte-cross-area-20260829/vereditos/` no arquivo de
dados que `generate-v2-link-topics-ponte-cross-area-20260829` consome.

O QUE ELE RECONFERE, e por que reconferir importa. O revisor leu uma versão
BOUNDED do texto (o campo `corpo` de um JSON de apoio). Aqui a prova é
reconferida contra o REGISTRO VIVO do estoque, pela MESMA função que o preflight
do gerador usa (`v2_link_topics_writer.texto_visivel`) — não por uma
reimplementação local, que é como nasce o par que passa aqui e é recusado lá.

Três recusas próprias, todas mecânicas:
  - trecho que não é substring do texto vivo;
  - destino que não é intent_id de página do acervo;
  - destino da MESMA área da origem (a ponte não seria ponte).

Read-only sobre o estoque: escreve apenas o .data.json.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_link_topics_writer import texto_visivel  # noqa: E402

VEREDITOS = ROOT / ".agents/runtime/link-mesh-ponte-cross-area-20260829/vereditos"
DESTINO = ROOT / "tools/generate-v2-link-topics-ponte-cross-area-20260829.data.json"
PAGES = ROOT / "data/editorial/v2_pages"
MANIFESTO = ROOT / "data/editorial/published_manifest.jsonl"
TRECHO_MINIMO = 40


def area_da_rota(path: str) -> str:
    for parte in path.split("/"):
        if parte:
            return parte
    return ""


def main() -> int:
    publicado: dict[str, str] = {}
    for linha in MANIFESTO.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        publicado[registro["unique_intent_id"]] = registro.get("path", "")

    registros: dict[str, dict] = {}
    for shard in sorted(PAGES.glob("*.jsonl")):
        for linha in shard.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            registro = json.loads(linha)
            intent = registro.get("intent_id")
            if intent and intent not in registros:
                registros[intent] = registro

    topicos: list[dict] = []
    recusados: list[str] = []
    vistos: set[tuple[str, str]] = set()
    for arquivo in sorted(VEREDITOS.glob("lote*.json")):
        lote = json.loads(arquivo.read_text(encoding="utf-8"))
        for par in lote.get("pares") or []:
            origem = par.get("origem") or ""
            destino = par.get("destino") or ""
            rotulo = f"{arquivo.name}: {origem} += {destino}"
            if par.get("veredito") != "verdadeiro":
                recusados.append(f"{rotulo}: veredito {par.get('veredito')!r}")
                continue
            if origem not in registros:
                recusados.append(f"{rotulo}: origem fora do estoque vivo")
                continue
            if destino not in registros or destino not in publicado:
                recusados.append(f"{rotulo}: destino não é página publicada")
                continue
            if area_da_rota(publicado.get(origem, "")) == area_da_rota(publicado[destino]):
                recusados.append(f"{rotulo}: destino é da MESMA área — não é ponte")
                continue
            trecho = (par.get("trecho_verbatim") or "").strip()
            if len(trecho) < TRECHO_MINIMO:
                recusados.append(f"{rotulo}: trecho com {len(trecho)} caracteres")
                continue
            if trecho not in texto_visivel(registros[origem]):
                recusados.append(f"{rotulo}: trecho não confere com o texto vivo")
                continue
            chave = (origem, destino)
            if chave in vistos:
                recusados.append(f"{rotulo}: par repetido entre lotes")
                continue
            vistos.add(chave)
            topicos.append({
                "intent_id": origem,
                "topico": destino,
                "veredito": "verdadeiro",
                "motivo_da_cauda": "sem_ponte_cross_area",
                "porque": par.get("justificativa") or "",
                "trecho_justificativa": trecho,
                "campo_do_trecho": "corpo",
                "verificado_por": arquivo.stem,
            })

    for recusa in recusados:
        print(f"RECUSADO: {recusa}", file=sys.stderr)
    if not topicos:
        print("nenhum par sobreviveu à reconferência", file=sys.stderr)
        return 1

    topicos.sort(key=lambda item: (item["intent_id"], item["topico"]))
    payload = {
        "gerado_por": Path(__file__).name,
        "vereditos": os.path.relpath(VEREDITOS, ROOT),
        "topicos": topicos,
    }
    DESTINO.write_text(
        json.dumps(payload, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    origens = {t["intent_id"] for t in topicos}
    print(f"{len(topicos)} par(es) em {len(origens)} página(s) -> "
          f"{os.path.relpath(DESTINO, ROOT)} ({len(recusados)} recusado(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
