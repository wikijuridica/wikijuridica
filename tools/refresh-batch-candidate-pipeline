#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export GOCACHE="${GOCACHE:-/tmp/wiki-go-build-cache}"

exec "$ROOT/tools/run-go-cmd-cached" ./cmd/refresh-batch-candidate-pipeline "$@"
