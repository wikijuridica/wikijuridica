class CommitVerificationError(RuntimeError):
    """The candidate commit is not the exact authenticated closure."""


class CommitBusy(CommitVerificationError):
    """A concurrent Git transaction moved or locked the candidate epoch."""

    def __init__(
        self, message: str, *, cas_may_have_applied: bool = False,
    ) -> None:
        super().__init__(message)
        self.cas_may_have_applied = cas_may_have_applied


class SemanticRecutNoStagedDelta(CommitVerificationError):
    """The semantic closure has zero staged intersection with the index.

    This is the exact post-landing state (RCA D4.8 §4.4): every linked path of
    the semantic unit already matches HEAD.  The caller resolves it against the
    unit ledger — a landed unit replays as an idempotent no-op instead of the
    historical "porcelain esgotado" dead end; anything else re-raises with the
    sanctioned succession route in the message.
    """


@dataclasses.dataclass
class PreparedMainIndex:
    """One owned ``index.lock`` kept alive across the ref CAS.

    ``lock_identity`` is captured from the open descriptor.  Cleanup is allowed
    only while the pathname still names that inode; after the ref CAS, an
    unpromoted lock is deliberately retained so an ordinary Git commit cannot
    build a child from a stale shared index.
    """

    root: pathlib.Path
    index_path: pathlib.Path
    lock_path: pathlib.Path
    nonce_path: pathlib.Path
    sidecar_path: pathlib.Path
    descriptor: int
    lock_identity: tuple[int, int]
    fingerprint: str
    run_id: str
