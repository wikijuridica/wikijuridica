class CanonicalIDRepairTransaction:
    """Non-replayable mechanical authority for one canonical ID repair.

    Unlike writing/review authority, this transaction has no external results
    receipt.  Its entire authority is the immutable old blob in ``expected_head``
    plus one live regular-file inode whose bytes are the exact NFKD accent-fold
    transition.  Every revalidation closes HEAD, index and inode drift.
    """

    kind = "canonical-id-repair"

    def __init__(
        self, *, root: pathlib.Path, transition: CanonicalIDRepairTransition,
        target_payload: bytes, target_identity: tuple[int, ...],
        index_entry: tuple[str, str, str] | None, line_count: int,
    ) -> None:
        self.root = root
        self.transition = transition
        self.expected_head = transition.expected_head
        self.target_payload = target_payload
        self.target_identity = target_identity
        self.index_entry = index_entry
        self.report = {
            "audit_merit_verified": False,
            "files": [{
                "file": transition.target,
                "sha256": transition.new_sha256,
                "lines": line_count,
            }],
            "required_artifacts": [],
            "canonical_id_repair": {
                "old_intent": transition.old_intent,
                "new_intent": transition.new_intent,
                "line_number": transition.line_number,
                "old_blob_oid": transition.old_blob_oid,
                "new_blob_oid": transition.new_blob_oid,
            },
        }
        self.dependencies: dict[pathlib.Path, str] = {}
        self.live_targets = {
            root / transition.target: transition.new_sha256,
        }

    def revalidate(self) -> None:
        current_head, _, _, _ = _capture_symbolic_head(self.root)
        if current_head != self.expected_head:
            raise CommitBusy("HEAD mudou durante canonical-id-repair")
        target = self.root / self.transition.target
        payload, info = _safe_file_payload(target)
        if (_file_identity(info) != self.target_identity or
                payload != self.target_payload or
                hashlib.sha256(payload).hexdigest() !=
                self.transition.new_sha256):
            raise CommitVerificationError(
                "target/inode mudou durante canonical-id-repair")
        observed_index = _index_entries_for_paths(
            self.root, [self.transition.target]).get(self.transition.target)
        if observed_index != self.index_entry:
            raise CommitBusy("index mudou durante canonical-id-repair")
        old_entry = _head_entries(
            self.root, self.expected_head, [self.transition.target]).get(
                self.transition.target)
        if old_entry != (
                self.transition.old_mode, self.transition.old_blob_oid):
            raise CommitVerificationError(
                "blob antigo mudou durante canonical-id-repair")


class SemanticRecutCommitTransaction:
    """One exact staged semantic-recut closure.

    The Go recut transaction may legitimately leave worktree bytes moving while
    another editor continues forward.  Commit authority therefore belongs to
    stage-zero blobs, never to a later pathname read.  The fixed anchors derive
    every eligible portfolio/page dependency; argv cannot add a path.
    """

    kind = "semantic-recut"

    def __init__(
        self, *, root: pathlib.Path, expected_head: str,
        object_format: str, candidates: Mapping[str, Mapping[str, str]],
        payloads: Mapping[str, bytes], index_path: pathlib.Path,
        index_identity: tuple[int, ...], index_entries: Mapping[
            str, tuple[str, str, str] | None],
        staged_source_payloads: Mapping[str, bytes],
    ) -> None:
        self.root = root
        self.expected_head = expected_head
        self.staged_candidates = {
            path: dict(item) for path, item in candidates.items()}
        self.staged_payloads = dict(payloads)
        self.index_path = index_path
        self.index_identity = index_identity
        self.index_entries = dict(index_entries)
        self.staged_source_payloads = dict(staged_source_payloads)
        self.dependencies: dict[pathlib.Path, str] = {}
        self.live_targets: dict[pathlib.Path, str] = {}
        page_files = []
        for path, item in sorted(self.staged_candidates.items()):
            if TARGET_REL.fullmatch(path) is None:
                continue
            payload = self.staged_payloads[path]
            page_files.append({
                "file": path, "sha256": item["sha256"],
                "lines": len(payload.splitlines()),
            })
        if not page_files:
            raise CommitVerificationError(
                "semantic-recut exige ao menos um shard de página")
        self.report = {
            "audit_merit_verified": False,
            "files": page_files,
            "required_artifacts": [],
        }

    def revalidate(self) -> None:
        current_head, _, _, _ = _capture_symbolic_head(self.root)
        if current_head != self.expected_head:
            raise CommitBusy("HEAD mudou durante semantic-recut")
        # Concurrent agents may rewrite the shared index atomically while
        # preserving every target stage-zero tuple.  Binding this transaction
        # to the global index inode condemned otherwise valid long audits and
        # caused an expensive retry loop.  Authority is the exact target set,
        # its stage-zero mode/OID and the object bytes, not unrelated index
        # serialization details.
        observed = _index_entries_for_paths(
            self.root, list(self.index_entries))
        if observed != self.index_entries:
            raise CommitBusy("entrada-alvo do index mudou durante semantic-recut")
        object_format = _git_text(
            self.root, ["rev-parse", "--show-object-format"])
        for path, payload in self.staged_source_payloads.items():
            entry = self.index_entries.get(path)
            if entry is None:
                raise CommitBusy("source staged desapareceu: " + path)
            source_item = {
                "path": path, "mode": entry[0], "git_blob_oid": entry[1],
            }
            _validate_index_closure_blob(
                self.root, source_item, payload, object_format)


_LOADED_HELPER_BINDINGS: dict[pathlib.Path, str] = {}
_LOADED_AUDITOR: Any | None = None


def _canonical_json(value: Any) -> bytes:
    try:
        return (json.dumps(
            value, ensure_ascii=False, allow_nan=False, sort_keys=True,
            separators=(",", ":"),
        ) + "\n").encode("utf-8")
    except (TypeError, ValueError) as error:
        raise CommitVerificationError(
            "payload transacional não é JSON canônico") from error


def _write_exclusive(
    path: pathlib.Path, payload: bytes, mode: int = 0o600,
) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written < 1:
                raise CommitVerificationError(
                    f"escrita transacional não avançou: {path}")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


_ACTIVE_SINGLEFLIGHT: SingleFlightLease | None = None


def _proc_state_and_start_ticks(pid: int) -> tuple[str, int] | None:
    """Read Linux state/starttime without confusing PID reuse."""
    if not isinstance(pid, int) or pid <= 0:
        return None
    try:
        descriptor = os.open(
            f"/proc/{pid}/stat",
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            return None
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(descriptor, 4096)
            if not chunk:
                break
            total += len(chunk)
            if total > 16 * 1024:
                return None
            chunks.append(chunk)
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            return None
        payload = b"".join(chunks)
    except OSError:
        return None
    finally:
        os.close(descriptor)
    try:
        line = payload.decode("ascii", errors="strict")
        close = line.rfind(")")
        # Fields after comm begin with field 3 (state); starttime is field 22.
        fields = line[close + 2:].split()
        state = fields[0]
        value = int(fields[19])
    except (UnicodeDecodeError, ValueError, IndexError):
        return None
    if close <= 1 or value <= 0 or len(state) != 1:
        return None
    return state, value


def _proc_start_ticks(pid: int) -> int | None:
    """Read Linux starttime (field 22), including a zombie generation."""
    observed = _proc_state_and_start_ticks(pid)
    return observed[1] if observed is not None else None


def _pid_generation_alive(pid: int, start_ticks: int) -> bool:
    observed = _proc_state_and_start_ticks(pid)
    return (observed is not None and observed[1] == start_ticks and
            observed[0] not in {"Z", "X", "x"})


def _singleflight_directory(root: pathlib.Path) -> pathlib.Path:
    common = pathlib.Path(_git_text(
        root, ["rev-parse", "--path-format=absolute", "--git-common-dir"]))
    if not common.is_absolute():
        raise CommitVerificationError(
            "git-common-dir do singleflight não é absoluto")
    try:
        common_info = os.lstat(common)
        root_info = os.stat(root, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "fronteira Git do singleflight não está disponível") from error
    if (not stat.S_ISDIR(common_info.st_mode) or
            stat.S_ISLNK(common_info.st_mode) or
            not stat.S_ISDIR(root_info.st_mode) or
            common_info.st_uid != os.geteuid() or
            root_info.st_uid != os.geteuid()):
        raise CommitVerificationError(
            "UID/fronteira Git do singleflight perdeu autoridade")
    directory = common / SINGLEFLIGHT_DIRECTORY
    try:
        os.mkdir(directory, 0o700)
        _fsync_directory(common)
    except FileExistsError:
        pass
    except OSError as error:
        raise CommitVerificationError(
            "diretório singleflight não pôde ser criado") from error
    try:
        info = os.lstat(directory)
    except OSError as error:
        raise CommitVerificationError(
            "diretório singleflight não pôde ser autenticado") from error
    if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or
            info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700):
        raise CommitVerificationError(
            "diretório singleflight possui autoridade/modo inválido")
    return directory


def _read_control_payload(
    path: pathlib.Path, *, max_bytes: int,
) -> bytes | None:
    """Read a private control file without opening a FIFO or following links."""
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise CommitVerificationError(
            f"controle singleflight não pôde ser inspecionado: {path}") from error
    if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or
            info.st_nlink != 1 or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or
            info.st_size < 0 or info.st_size > max_bytes):
        raise CommitVerificationError(
            f"controle singleflight inseguro ou excedeu limite: {path}")
    payload, after = _safe_file_payload(path, max_bytes=max_bytes)
    if (_file_identity(after) != _file_identity(info) or
            stat.S_IMODE(after.st_mode) != 0o600 or
            after.st_uid != os.geteuid()):
        raise CommitVerificationError(
            f"controle singleflight mudou durante leitura: {path}")
    return payload


def _read_control_json(
    path: pathlib.Path, *, max_bytes: int,
) -> dict[str, Any] | None:
    payload = _read_control_payload(path, max_bytes=max_bytes)
    if payload is None:
        return None
    if not payload or not payload.endswith(b"\n"):
        raise CommitVerificationError(
            f"controle singleflight perdeu framing: {path}")
    return _decode_json_object(payload, os.fspath(path))


def _atomic_control_write(
    path: pathlib.Path, payload: bytes, *, max_bytes: int,
) -> None:
    if not payload or len(payload) > max_bytes or not payload.endswith(b"\n"):
        raise CommitVerificationError(
            f"controle singleflight excedeu limite: {path}")
    existing = _read_control_payload(path, max_bytes=max_bytes)
    del existing
    temporary = path.parent / (
        ".tmp-" + str(os.getpid()) + "-" + secrets.token_hex(16))
    try:
        _write_exclusive(temporary, payload, mode=0o600)
        temporary_info = os.lstat(temporary)
        if (not stat.S_ISREG(temporary_info.st_mode) or
                temporary_info.st_nlink != 1 or
                temporary_info.st_uid != os.geteuid() or
                stat.S_IMODE(temporary_info.st_mode) != 0o600):
            raise CommitVerificationError(
                "controle singleflight temporário perdeu autoridade")
        # Recheck a pre-existing destination immediately before replacement;
        # a symlink/hardlink/FIFO is evidence of control-plane adulteration.
        _read_control_payload(path, max_bytes=max_bytes)
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _unlink_control(path: pathlib.Path, *, max_bytes: int) -> None:
    if _read_control_payload(path, max_bytes=max_bytes) is None:
        return
    os.unlink(path)
    _fsync_directory(path.parent)


def _singleflight_lock_descriptor(directory: pathlib.Path) -> int:
    path = directory / "producer.lock"
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as error:
        raise CommitVerificationError(
            "producer.lock singleflight é inseguro") from error
    try:
        info = os.fstat(descriptor)
        path_info = os.lstat(path)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
                info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o600 or
                info.st_size < 0 or
                info.st_size > SINGLEFLIGHT_STATE_MAX_BYTES or
                (info.st_dev, info.st_ino) !=
                (path_info.st_dev, path_info.st_ino)):
            raise CommitVerificationError(
                "producer.lock singleflight perdeu identidade")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _validate_active_record(record: Mapping[str, Any]) -> dict[str, Any]:
    legacy_expected = {
        "schema", "state", "fingerprint", "run_id", "pid", "start_ticks",
        "owner_uid", "phase", "started_unix_ns", "heartbeat_unix_ns",
        "child_pid", "child_start_ticks",
    }
    name_expected = legacy_expected | {"prepared_nonce_name"}
    identity_expected = name_expected | {"prepared_nonce_identity"}
    if (frozenset(record) not in {
            frozenset(identity_expected), frozenset(name_expected),
            frozenset(legacy_expected)} or
            record.get("schema") != SINGLEFLIGHT_SCHEMA or
            record.get("state") != "active" or
            not isinstance(record.get("fingerprint"), str) or
            SHA256.fullmatch(record["fingerprint"]) is None or
            not isinstance(record.get("run_id"), str) or
            SINGLEFLIGHT_RUN_ID.fullmatch(record["run_id"]) is None or
            not isinstance(record.get("pid"), int) or record["pid"] <= 0 or
            not isinstance(record.get("start_ticks"), int) or
            record["start_ticks"] <= 0 or
            record.get("owner_uid") != os.geteuid() or
            record.get("phase") not in SINGLEFLIGHT_PHASES or
            not isinstance(record.get("started_unix_ns"), int) or
            record["started_unix_ns"] <= 0 or
            not isinstance(record.get("heartbeat_unix_ns"), int) or
            record["heartbeat_unix_ns"] < record["started_unix_ns"]):
        raise CommitVerificationError("state singleflight possui schema inválido")
    child_pid = record.get("child_pid")
    child_ticks = record.get("child_start_ticks")
    nonce_name = record.get("prepared_nonce_name")
    nonce_identity = record.get("prepared_nonce_identity")
    if ((child_pid is None) != (child_ticks is None) or
            (child_pid is not None and
             (not isinstance(child_pid, int) or child_pid <= 0 or
              not isinstance(child_ticks, int) or child_ticks <= 0)) or
            (nonce_name is not None and
             (not isinstance(nonce_name, str) or
              PREPARED_INDEX_NAME.fullmatch(nonce_name) is None or
              not nonce_name.startswith("index.prepared-" +
                                        record["run_id"] + "-"))) or
            (nonce_identity is not None and
             (nonce_name is None or not isinstance(nonce_identity, list) or
              len(nonce_identity) != 5 or
              any(not isinstance(value, int) for value in nonce_identity) or
              nonce_identity[0] < 0 or nonce_identity[1] <= 0 or
              nonce_identity[2] < 0 or
              nonce_identity[2] > MAX_INDEX_BYTES or
              nonce_identity[3] < 0 or nonce_identity[4] < 0))):
        raise CommitVerificationError("child singleflight possui schema inválido")
    return dict(record)


def _validate_terminal_record(
    record: Mapping[str, Any], *, fingerprint: str | None = None,
) -> dict[str, Any]:
    expected = {
        "schema", "state", "fingerprint", "run_id", "pid", "start_ticks",
        "started_unix_ns", "finished_unix_ns", "exit_code", "failure_kind",
        "cas_may_have_applied", "stdout", "stderr", "result_sha256",
    }
    state = record.get("state")
    if (set(record) != expected or record.get("schema") != SINGLEFLIGHT_SCHEMA or
            state not in {"success", "failure"} or
            not isinstance(record.get("fingerprint"), str) or
            SHA256.fullmatch(record["fingerprint"]) is None or
            (fingerprint is not None and record["fingerprint"] != fingerprint) or
            not isinstance(record.get("run_id"), str) or
            SINGLEFLIGHT_RUN_ID.fullmatch(record["run_id"]) is None or
            not isinstance(record.get("pid"), int) or record["pid"] <= 0 or
            not isinstance(record.get("start_ticks"), int) or
            record["start_ticks"] <= 0 or
            not isinstance(record.get("started_unix_ns"), int) or
            not isinstance(record.get("finished_unix_ns"), int) or
            record["finished_unix_ns"] < record["started_unix_ns"] or
            not isinstance(record.get("exit_code"), int) or
            record["exit_code"] not in {0, 1, 75} or
            record.get("failure_kind") not in {
                None, "CommitBusy", "CommitVerificationError", "Exception",
                "BaseException"} or
            not isinstance(record.get("cas_may_have_applied"), bool) or
            not isinstance(record.get("stdout"), str) or
            not isinstance(record.get("stderr"), str) or
            len(record["stdout"].encode("utf-8")) >
            SINGLEFLIGHT_STDOUT_MAX_BYTES or
            len(record["stderr"].encode("utf-8")) >
            SINGLEFLIGHT_STDERR_MAX_BYTES or
            not isinstance(record.get("result_sha256"), str) or
            SHA256.fullmatch(record["result_sha256"]) is None):
        raise CommitVerificationError(
            "terminal singleflight possui schema/limite inválido")
    if ((state == "success") != (record["exit_code"] == 0) or
            (state == "success") != (record["failure_kind"] is None)):
        raise CommitVerificationError("terminal singleflight contradiz estado")
    projection = dict(record)
    claimed = projection.pop("result_sha256")
    actual = hashlib.sha256(_canonical_json(projection)).hexdigest()
    if actual != claimed:
        raise CommitVerificationError("terminal singleflight perdeu SHA")
    return dict(record)


def _singleflight_terminal_path(
    directory: pathlib.Path, fingerprint: str,
) -> pathlib.Path:
    if SHA256.fullmatch(fingerprint) is None:
        raise CommitVerificationError("fingerprint singleflight inválida")
    return directory / (fingerprint + ".terminal.json")


def _read_singleflight_terminal(
    directory: pathlib.Path, fingerprint: str,
) -> dict[str, Any] | None:
    record = _read_control_json(
        _singleflight_terminal_path(directory, fingerprint),
        max_bytes=SINGLEFLIGHT_TERMINAL_MAX_BYTES)
    if record is None:
        return None
    return _validate_terminal_record(record, fingerprint=fingerprint)


def _unit_identity(epoch: CommitEpoch, kind: str) -> tuple[str, str, str]:
    """Content-addressed unit identity + family budget key (RCA D4.8 §4.1).

    Mirrors ``internal/factoryworkqueue`` (types.go:42-47, key.go): the same
    two-key discipline instead of a second divergent mechanism.

    ``unit_key`` (WorkUnitKey semantics) = sha256(kind + closure canônica +
    sorted(input_oids)).  DELIBERATELY WITHOUT code epoch, HEAD, timestamp or
    index pre-state: an identical rerun stays identical even after a code
    edit, so a landed unit replays as no-op and a failed unit cannot be
    laundered into a "new unit" by touching the tool (red-team 20260722 §1 —
    the 9-repair loop of 2026-07-21 edited code between every rerun).

    ``family_key`` (LineageKey semantics) = sha256(kind + target_path_set),
    also epoch-free: the anti-micro-adjustment budget survives byte tweaks to
    the same shards.  Only an authenticated green in the family (or an
    explicit motive-bearing reopen row) resets the budget, exactly like the
    factoryworkqueue rule "only authenticated positive ProductDelta resets".

    HEAD remains a CAS precondition enforced by ``update-ref``; it is not
    identity.  Returns ``(unit_key, family_key, input_oids_digest)``.
    """
    input_oids = sorted(item["git_blob_oid"] for item in epoch.closure)
    unit_recipe = {
        "domain": "portaljuridico.v2commit.work-unit.v1",
        "kind": kind,
        "closure": [
            {
                "path": item["path"], "mode": item["mode"],
                "sha256": item["sha256"], "role": item["role"],
                "git_blob_oid": item["git_blob_oid"],
            }
            for item in sorted(
                epoch.closure, key=lambda entry: entry["path"])
        ],
        "input_oids": input_oids,
    }
    product_paths = sorted(
        item["path"] for item in epoch.closure
        if TARGET_REL.fullmatch(item["path"]) is not None or
        PORTFOLIO_REL.fullmatch(item["path"]) is not None)
    if not product_paths:
        product_paths = sorted(item["path"] for item in epoch.closure)
    family_recipe = {
        "domain": "portaljuridico.v2commit.lineage.v1",
        "kind": kind,
        "target_paths": product_paths,
    }
    unit_key = hashlib.sha256(_canonical_json(unit_recipe)).hexdigest()
    family_key = hashlib.sha256(_canonical_json(family_recipe)).hexdigest()
    input_oids_digest = hashlib.sha256(
        _canonical_json(input_oids)).hexdigest()
    return unit_key, family_key, input_oids_digest


def _singleflight_fingerprint(epoch: CommitEpoch, message: str, kind: str) -> str:
    try:
        archive_info = os.lstat(GO_ARCHIVE)
        archive_authority = {
            "uid": archive_info.st_uid,
            "mode": stat.S_IMODE(archive_info.st_mode),
            "size": archive_info.st_size,
        }
    except OSError:
        archive_authority = {"uid": None, "mode": None, "size": None}
    # expected_head deliberately does NOT participate (plano Fase 1 §6): a
    # branch tip moved by an unrelated commit must not orphan this unit's
    # terminal/replay history.  Atomicity still comes from the update-ref CAS
    # against the captured epoch, byte-identical to before.
    recipe = {
        "schema": SINGLEFLIGHT_SCHEMA,
        "protocol": "target-stage-zero-cas-v2-prepared-sidecar",
        "kind": kind,
        "message": message,
        "unit_key": _unit_identity(epoch, kind)[0],
        "expected_ref": epoch.expected_ref,
        "object_format": epoch.object_format,
        "closure": [dict(item) for item in epoch.closure],
        "dependencies": [dict(item) for item in epoch.dependencies],
        "dependency_bindings": [
            {"path": os.fspath(path), "sha256": digest}
            for path, digest in sorted(
                epoch.dependency_bindings.items(),
                key=lambda item: os.fspath(item[0]))
        ],
        "target_index_entries": [
            {"path": path, "entry": list(entry) if entry is not None else None}
            for path, entry in sorted(epoch.main_index_targets_before.items())
        ],
        "hook_sha256": hashlib.sha256(epoch.hook_payload).hexdigest(),
        "go_toolchain_archive_sha256": GO_ARCHIVE_SHA256,
        "go_toolchain_archive_authority": archive_authority,
        "compiled_commands": [list(item) for item in COMPILED_COMMANDS],
        "package_atomic_index": _package_atomic_singleflight_state(epoch),
    }
    return hashlib.sha256(_canonical_json(recipe)).hexdigest()


def _package_atomic_singleflight_state(epoch: CommitEpoch) -> dict[str, Any]:
    """Bind replay authority to every staged/untracked Go peer package path."""
    changed_go = {
        item["path"] for item in epoch.closure
        if item["path"].endswith(".go") and
        (item["path"].startswith("cmd/") or
         item["path"].startswith("internal/"))
    }
    directories = sorted({
        pathlib.PurePosixPath(path).parent.as_posix()
        for path in changed_go
    })
    if not directories:
        return {"directories": [], "staged": [], "untracked": []}
    staged_paths = [
        path for path in _index_changed_paths(
            epoch.root, epoch.expected_head, None)
        if path.endswith(".go") and
        pathlib.PurePosixPath(path).parent.as_posix() in directories
    ]
    entries = _index_entries_for_paths(epoch.root, staged_paths)
    staged = [
        {"path": path, "entry": list(entries[path]) if entries[path] else None}
        for path in sorted(staged_paths)
    ]
    payload = _run_git(
        epoch.root,
        ["ls-files", "--others", "--exclude-standard", "-z", "--",
         *(":(literal)" + path for path in directories)],
    ).stdout
    try:
        untracked = sorted(
            item.decode("utf-8", errors="strict")
            for item in payload.split(b"\0")
            if item and item.endswith(b".go"))
    except UnicodeDecodeError as error:
        raise CommitVerificationError(
            "fingerprint package-atomic encontrou path não UTF-8") from error
    return {"directories": directories, "staged": staged, "untracked": untracked}


def _active_record(lease: SingleFlightLease) -> dict[str, Any]:
    return {
        "schema": SINGLEFLIGHT_SCHEMA,
        "state": "active",
        "fingerprint": lease.fingerprint,
        "run_id": lease.run_id,
        "pid": lease.pid,
        "start_ticks": lease.start_ticks,
        "owner_uid": os.geteuid(),
        "phase": lease.phase,
        "started_unix_ns": lease.started_unix_ns,
        "heartbeat_unix_ns": time.time_ns(),
        "child_pid": lease.child_pid,
        "child_start_ticks": lease.child_start_ticks,
        "prepared_nonce_name": (
            lease.prepared_nonce_path.name
            if lease.prepared_nonce_path is not None else None),
        "prepared_nonce_identity": (
            list(lease.prepared_nonce_identity)
            if lease.prepared_nonce_identity is not None else None),
    }


def _singleflight_phase(
    lease: SingleFlightLease, phase: str, *, child_pid: int | None = None,
) -> None:
    if lease.terminal or phase not in SINGLEFLIGHT_PHASES:
        raise CommitVerificationError("fase singleflight inválida/terminal")
    child_ticks = (
        _proc_start_ticks(child_pid) if child_pid is not None else None)
    # A very short child may exit between Popen and /proc authentication. Do
    # not publish an ambiguous PID in that case; long material children remain
    # bound to both PID and generation.
    next_child_pid = child_pid if child_ticks is not None else None
    candidate = dataclasses.replace(
        lease, phase=phase, child_pid=next_child_pid,
        child_start_ticks=child_ticks)
    payload = _canonical_json(_active_record(candidate))
    try:
        _atomic_control_write(
            lease.directory / "active.json", payload,
            max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    except BaseException:
        # replace(2) can have happened before a directory-fsync failure. Keep
        # memory aligned with the exact record visible on disk when it can be
        # authenticated; otherwise retain the last proven phase.
        try:
            visible = _read_control_payload(
                lease.directory / "active.json",
                max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        except CommitVerificationError:
            visible = None
        if visible == payload:
            lease.phase = phase
            lease.child_pid = next_child_pid
            lease.child_start_ticks = child_ticks
            lease.last_heartbeat_monotonic = time.monotonic()
        raise
    lease.phase = phase
    lease.child_pid = next_child_pid
    lease.child_start_ticks = child_ticks
    lease.last_heartbeat_monotonic = time.monotonic()


def _singleflight_bind_prepared_nonce(
    lease: SingleFlightLease, nonce_path: pathlib.Path,
) -> None:
    """Durably bind the exact random nonce name before O_EXCL creation."""
    match = PREPARED_INDEX_NAME.fullmatch(nonce_path.name)
    if (lease.terminal or match is None or match.group(1) != lease.run_id or
            nonce_path.parent != nonce_path.parent.resolve(strict=True)):
        raise CommitVerificationError(
            "nonce prepared não pode ser vinculado ao active singleflight")
    candidate = dataclasses.replace(lease, prepared_nonce_path=nonce_path)
    payload = _canonical_json(_active_record(candidate))
    try:
        _atomic_control_write(
            lease.directory / "active.json", payload,
            max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    except BaseException:
        try:
            visible = _read_control_payload(
                lease.directory / "active.json",
                max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        except CommitVerificationError:
            visible = None
        if visible == payload:
            lease.prepared_nonce_path = nonce_path
            lease.last_heartbeat_monotonic = time.monotonic()
        raise
    lease.prepared_nonce_path = nonce_path
    lease.last_heartbeat_monotonic = time.monotonic()


def _singleflight_bind_prepared_nonce_identity(
    lease: SingleFlightLease, descriptor: int,
) -> None:
    """Durably bind the O_EXCL inode before it can become GC authority."""
    nonce_path = lease.prepared_nonce_path
    if (lease.terminal or nonce_path is None or
            lease.prepared_nonce_identity is not None):
        raise CommitVerificationError(
            "inode nonce prepared não pode ser vinculado ao active")
    try:
        os.fsync(descriptor)
        info = os.fstat(descriptor)
        path_info = os.stat(nonce_path, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "inode nonce prepared não pôde ser autenticado") from error
    identity = _descriptor_content_identity(info)
    if (info.st_uid != os.geteuid() or info.st_nlink != 1 or
            stat.S_IMODE(info.st_mode) != 0o600 or
            _descriptor_content_identity(path_info) != identity or
            path_info.st_uid != os.geteuid() or path_info.st_nlink != 1 or
            stat.S_IMODE(path_info.st_mode) != 0o600):
        raise CommitVerificationError(
            "inode nonce prepared perdeu path/UID/modo privado")
    candidate = dataclasses.replace(
        lease, prepared_nonce_identity=identity)
    payload = _canonical_json(_active_record(candidate))
    try:
        _atomic_control_write(
            lease.directory / "active.json", payload,
            max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    except BaseException:
        try:
            visible = _read_control_payload(
                lease.directory / "active.json",
                max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        except CommitVerificationError:
            visible = None
        if visible == payload:
            lease.prepared_nonce_identity = identity
            lease.last_heartbeat_monotonic = time.monotonic()
        raise
    lease.prepared_nonce_identity = identity
    lease.last_heartbeat_monotonic = time.monotonic()


def _singleflight_heartbeat() -> None:
    lease = _ACTIVE_SINGLEFLIGHT
    if (lease is None or lease.terminal or
            time.monotonic() - lease.last_heartbeat_monotonic < 5.0):
        return
    _singleflight_phase(lease, lease.phase, child_pid=lease.child_pid)


def _terminal_record(
    *, fingerprint: str, run_id: str, pid: int, start_ticks: int,
    started_unix_ns: int, state: str, exit_code: int,
    failure_kind: str | None, cas_may_have_applied: bool,
    stdout: str, stderr: str,
) -> dict[str, Any]:
    if (len(stdout.encode("utf-8")) > SINGLEFLIGHT_STDOUT_MAX_BYTES or
            len(stderr.encode("utf-8")) > SINGLEFLIGHT_STDERR_MAX_BYTES):
        raise CommitVerificationError(
            "resultado singleflight excedeu stdout/stderr bounded")
    record: dict[str, Any] = {
        "schema": SINGLEFLIGHT_SCHEMA,
        "state": state,
        "fingerprint": fingerprint,
        "run_id": run_id,
        "pid": pid,
        "start_ticks": start_ticks,
        "started_unix_ns": started_unix_ns,
        "finished_unix_ns": time.time_ns(),
        "exit_code": exit_code,
        "failure_kind": failure_kind,
        "cas_may_have_applied": cas_may_have_applied,
        "stdout": stdout,
        "stderr": stderr,
    }
    record["result_sha256"] = hashlib.sha256(
        _canonical_json(record)).hexdigest()
    return _validate_terminal_record(record, fingerprint=fingerprint)


def _write_terminal(directory: pathlib.Path, record: Mapping[str, Any]) -> None:
    validated = _validate_terminal_record(
        record, fingerprint=str(record.get("fingerprint", "")))
    _atomic_control_write(
        _singleflight_terminal_path(directory, validated["fingerprint"]),
        _canonical_json(validated), max_bytes=SINGLEFLIGHT_TERMINAL_MAX_BYTES)


def _unit_ledger_path(root: pathlib.Path) -> pathlib.Path:
    return root / UNIT_LEDGER_REL


def _validate_unit_ledger_row(
    record: Mapping[str, Any], *, label: str,
) -> dict[str, Any]:
    schema = record.get("schema")
    if schema == UNIT_LEDGER_REOPEN_SCHEMA:
        expected = {
            "schema", "family_key", "kind", "reason", "ts_unix_ns",
            "row_sha256",
        }
        kind = record.get("kind")
        reason = record.get("reason")
        if (set(record) != expected or
                not isinstance(record.get("family_key"), str) or
                SHA256.fullmatch(record["family_key"]) is None or
                not (kind is None or
                     (isinstance(kind, str) and
                      re.fullmatch(r"[a-z0-9-]{1,64}", kind) is not None)) or
                not isinstance(reason, str) or
                not (UNIT_FAMILY_REOPEN_REASON_MIN_CHARS <= len(reason) <=
                     UNIT_FAMILY_REOPEN_REASON_MAX_CHARS) or
                reason.strip() != reason or
                not isinstance(record.get("ts_unix_ns"), int) or
                record["ts_unix_ns"] <= 0):
            raise CommitVerificationError(
                f"unit-ledger possui reopen adulterado/inválido: {label}")
    else:
        expected = {
            "schema", "unit_key", "family_key", "kind", "input_oids_digest",
            "fingerprint", "run_id", "state", "failure_kind", "exit_code",
            "cas_may_have_applied", "result_sha256", "commit_oid", "attempts",
            "ts_unix_ns", "row_sha256",
        }
        state = record.get("state")
        kind = record.get("kind")
        if (set(record) != expected or
                schema != UNIT_LEDGER_SCHEMA or
                state not in {"success", "failure"} or
                not (record.get("unit_key") is None or
                     (isinstance(record.get("unit_key"), str) and
                      SHA256.fullmatch(record["unit_key"]) is not None)) or
                not (record.get("family_key") is None or
                     (isinstance(record.get("family_key"), str) and
                      SHA256.fullmatch(record["family_key"]) is not None)) or
                not (kind is None or
                     (isinstance(kind, str) and
                      re.fullmatch(r"[a-z0-9-]{1,64}", kind) is not None)) or
                not (record.get("input_oids_digest") is None or
                     (isinstance(record.get("input_oids_digest"), str) and
                      SHA256.fullmatch(
                          record["input_oids_digest"]) is not None)) or
                not isinstance(record.get("fingerprint"), str) or
                SHA256.fullmatch(record["fingerprint"]) is None or
                not isinstance(record.get("run_id"), str) or
                SINGLEFLIGHT_RUN_ID.fullmatch(record["run_id"]) is None or
                record.get("failure_kind") not in {
                    None, "CommitBusy", "CommitVerificationError", "Exception",
                    "BaseException"} or
                record.get("exit_code") not in {0, 1, 75} or
                not isinstance(record.get("cas_may_have_applied"), bool) or
                not isinstance(record.get("result_sha256"), str) or
                SHA256.fullmatch(record["result_sha256"]) is None or
                not (record.get("commit_oid") is None or
                     (isinstance(record.get("commit_oid"), str) and
                      HEX_OBJECT.fullmatch(record["commit_oid"]) is not None)) or
                not isinstance(record.get("attempts"), int) or
                record["attempts"] < 0 or
                not isinstance(record.get("ts_unix_ns"), int) or
                record["ts_unix_ns"] <= 0):
            raise CommitVerificationError(
                f"unit-ledger possui linha adulterada/inválida: {label}" +
                UNIT_LEDGER_QUARANTINE_ROUTE)
        if ((state == "success") != (record["exit_code"] == 0) or
                (state == "success") != (record["failure_kind"] is None)):
            raise CommitVerificationError(
                f"unit-ledger contradiz estado terminal: {label}")
    projection = dict(record)
    claimed = projection.pop("row_sha256")
    actual = hashlib.sha256(_canonical_json(projection)).hexdigest()
    if claimed != actual:
        raise CommitVerificationError(
            f"unit-ledger perdeu SHA da linha (adulteração): {label}" +
            UNIT_LEDGER_QUARANTINE_ROUTE)
    return dict(record)


def _read_unit_ledger(root: pathlib.Path) -> list[dict[str, Any]]:
    """Read the append-only unit ledger, fail-closed against adulteration.

    An invalid or tampered row poisons the whole read: evidence integrity
    outranks convenience.  Recovery is explicit and carried in the exception
    text itself (``UNIT_LEDGER_QUARANTINE_ROUTE``): append-only quarantine of
    the corrupted line into ``<ledger>.quarantine.jsonl`` with motive and
    timestamp, preserving every other line — never truncating or regenerating
    the ledger.  Restoring the file from git history stays valid for a lost
    ledger; the per-fingerprint ``*.terminal.json`` files remain the local
    replay authority either way.
    """
    path = _unit_ledger_path(root)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return []
    except OSError as error:
        raise CommitVerificationError(
            f"unit-ledger não pôde ser inspecionado: {path}") from error
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise CommitVerificationError(
            f"unit-ledger não é arquivo regular: {path}")
    payload, _ = _safe_file_payload(path, max_bytes=UNIT_LEDGER_MAX_BYTES)
    if not payload:
        return []
    if not payload.endswith(b"\n"):
        raise CommitVerificationError(
            f"unit-ledger perdeu framing append-only (LF final): {path}")
    rows: list[dict[str, Any]] = []
    for line_number, raw in enumerate(payload.splitlines(), 1):
        if not raw or len(raw) > UNIT_LEDGER_ROW_MAX_BYTES:
            raise CommitVerificationError(
                f"unit-ledger possui linha vazia/excessiva: {path}:{line_number}")
        rows.append(_validate_unit_ledger_row(
            _decode_json_object(raw, f"{path}:{line_number}"),
            label=f"{path}:{line_number}"))
    return rows


def _append_unit_ledger_row(
    root: pathlib.Path, row: Mapping[str, Any],
) -> None:
    projection = dict(row)
    projection.pop("row_sha256", None)
    projection["row_sha256"] = hashlib.sha256(
        _canonical_json(projection)).hexdigest()
    validated = _validate_unit_ledger_row(
        projection, label="candidate-append")
    payload = _canonical_json(validated)
    if len(payload) > UNIT_LEDGER_ROW_MAX_BYTES:
        raise CommitVerificationError(
            "unit-ledger linha candidata excede limite bounded")
    path = _unit_ledger_path(root)
    os.makedirs(path.parent, mode=0o755, exist_ok=True)
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > UNIT_LEDGER_MAX_BYTES:
            raise CommitVerificationError(
                "unit-ledger destino não é regular/bounded para append")
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written < 1:
                raise CommitVerificationError(
                    "append do unit-ledger não avançou")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _terminal_commit_oid(record: Mapping[str, Any]) -> str | None:
    """Extract the landed commit OID from a success terminal's own report."""
    if record.get("state") != "success":
        return None
    try:
        report = json.loads(record.get("stdout", ""))
    except (TypeError, ValueError):
        return None
    if not isinstance(report, dict):
        return None
    commit = report.get("commit")
    if isinstance(commit, str) and HEX_OBJECT.fullmatch(commit) is not None:
        return commit
    return None


def _mirror_terminal_to_unit_ledger(
    root: pathlib.Path | None, record: Mapping[str, Any], *,
    unit_key: str | None, family_key: str | None, kind: str | None,
    input_oids_digest: str | None,
) -> None:
    """Append the terminal mirror row.  The terminal file is the durable
    authority; a mirror append failure is reported loudly and never rewrites
    an already-terminal outcome (same boundary as active.json cleanup)."""
    if root is None:
        return
    try:
        rows = _read_unit_ledger(root)
        attempts = 1 + sum(
            1 for row in rows
            if family_key is not None and
            row.get("schema") == UNIT_LEDGER_SCHEMA and
            row.get("family_key") == family_key)
        _append_unit_ledger_row(root, {
            "schema": UNIT_LEDGER_SCHEMA,
            "unit_key": unit_key,
            "family_key": family_key,
            "kind": kind,
            "input_oids_digest": input_oids_digest,
            "fingerprint": record["fingerprint"],
            "run_id": record["run_id"],
            "state": record["state"],
            "failure_kind": record["failure_kind"],
            "exit_code": record["exit_code"],
            "cas_may_have_applied": record["cas_may_have_applied"],
            "result_sha256": record["result_sha256"],
            "commit_oid": _terminal_commit_oid(record),
            "attempts": attempts if family_key is not None else 0,
            # Evidence clock: derived from the terminal receipt itself, never
            # from a fresh wall-clock read at append time (RCA D4.8 §4.1).
            "ts_unix_ns": record["finished_unix_ns"],
        })
    except (CommitVerificationError, OSError) as error:
        print(
            "commit-verified-v2-workflow-results: unit-ledger espelho falhou "
            f"(terminal continua autoridade durável): {error}",
            file=sys.stderr, flush=True)


def _dead_owner_terminal(
    directory: pathlib.Path, active: Mapping[str, Any], message: str,
    *, ledger_root: pathlib.Path | None = None,
) -> dict[str, Any]:
    record = _terminal_record(
        fingerprint=active["fingerprint"], run_id=active["run_id"],
        pid=active["pid"], start_ticks=active["start_ticks"],
        started_unix_ns=active["started_unix_ns"], state="failure",
        exit_code=75, failure_kind="CommitBusy",
        cas_may_have_applied=_singleflight_cas_phase(active["phase"]),
        stdout="", stderr=message)
    _write_terminal(directory, record)
    _mirror_terminal_to_unit_ledger(
        ledger_root, record,
        unit_key=None, family_key=None, kind=None, input_oids_digest=None)
    _unlink_control(
        directory / "active.json", max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    return record


def _raise_if_orphan_child_alive(active: Mapping[str, Any]) -> None:
    """Keep a dead producer's authenticated material child single-flight."""
    child_pid = active.get("child_pid")
    child_ticks = active.get("child_start_ticks")
    if (isinstance(child_pid, int) and isinstance(child_ticks, int) and
            _pid_generation_alive(child_pid, child_ticks)):
        raise CommitBusy(
            "BUSY_OTHER orphan child=" + str(child_pid) + "/" +
            str(child_ticks) + " fingerprint=" + active["fingerprint"] +
            " phase=" + active["phase"])


def _release_singleflight(lease: SingleFlightLease) -> None:
    global _ACTIVE_SINGLEFLIGHT
    if lease.descriptor < 0:
        return
    if _ACTIVE_SINGLEFLIGHT is lease:
        _ACTIVE_SINGLEFLIGHT = None
    try:
        fcntl.flock(lease.descriptor, fcntl.LOCK_UN)
    finally:
        os.close(lease.descriptor)
        lease.descriptor = -1


def _singleflight_cas_phase(phase: str) -> bool:
    """Whether an owner could have crossed durable update-ref in this phase."""
    if phase not in SINGLEFLIGHT_PHASES:
        return True
    return phase in {
        "cas", "cas_terminal", "terminalizing_success_cas",
        "terminalizing_failure_cas",
    }


def _singleflight_replay_and_close(
    descriptor: int, terminal: Mapping[str, Any],
) -> SingleFlightReplay:
    try:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)
    return SingleFlightReplay(dict(terminal))


def _begin_singleflight(
    epoch: CommitEpoch, message: str, kind: str,
    retry_failed: str | None,
) -> SingleFlightLease | SingleFlightReplay:
    fingerprint = _singleflight_fingerprint(epoch, message, kind)
    unit_key, family_key, input_oids_digest = _unit_identity(epoch, kind)
    if retry_failed is not None and SHA256.fullmatch(retry_failed) is None:
        raise CommitVerificationError("--retry-failed exige SHA-256 terminal")
    directory = _singleflight_directory(epoch.root)
    descriptor = _singleflight_lock_descriptor(directory)
    active_path = directory / "active.json"
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            owns = True
        except BlockingIOError:
            owns = False
        if not owns:
            active_raw = _read_control_json(
                active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
            if active_raw is None:
                raise CommitVerificationError(
                    "producer.lock ocupado sem state singleflight")
            active = _validate_active_record(active_raw)
            if active["fingerprint"] != fingerprint:
                raise CommitBusy(
                    "BUSY_OTHER fingerprint=" + active["fingerprint"] +
                    " owner=" + str(active["pid"]) + "/" +
                    str(active["start_ticks"]) + " phase=" + active["phase"])
            print(
                "commit-verified-v2-workflow-results: JOIN fingerprint=" +
                fingerprint + " run_id=" + active["run_id"] + " owner=" +
                str(active["pid"]) + "/" + str(active["start_ticks"]) +
                " phase=" + active["phase"], file=sys.stderr, flush=True)
            deadline = time.monotonic() + HEAVY_AUDIT_LOCK_WAIT_SECONDS
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError as error:
                    if time.monotonic() >= deadline:
                        raise CommitBusy(
                            "JOIN permaneceu ativo além do timeout; fingerprint=" +
                            fingerprint + " owner=" + str(active["pid"]) +
                            "/" + str(active["start_ticks"]) + " phase=" +
                            active["phase"]) from error
                    current_raw = _read_control_json(
                        active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
                    if current_raw is None:
                        raise CommitVerificationError(
                            "JOIN perdeu state antes do terminal")
                    current = _validate_active_record(current_raw)
                    if (current["fingerprint"] != fingerprint or
                            current["run_id"] != active["run_id"]):
                        raise CommitVerificationError(
                            "JOIN mudou de identidade durante espera")
                    active = current
                    time.sleep(HEAVY_AUDIT_LOCK_POLL_SECONDS)
            terminal = _read_singleflight_terminal(directory, fingerprint)
            if terminal is None:
                stale_raw = _read_control_json(
                    active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
                if stale_raw is None:
                    raise CommitVerificationError(
                        "JOIN terminou sem state nem terminal")
                stale = _validate_active_record(stale_raw)
                _raise_if_orphan_child_alive(stale)
                terminal = _dead_owner_terminal(
                    directory, stale,
                    "owner encerrou sem publicar terminal singleflight",
                    ledger_root=epoch.root)
            return _singleflight_replay_and_close(descriptor, terminal)

        terminal = _read_singleflight_terminal(directory, fingerprint)
        active_raw = _read_control_json(
            active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        if active_raw is not None:
            active = _validate_active_record(active_raw)
            if _pid_generation_alive(active["pid"], active["start_ticks"]):
                raise CommitVerificationError(
                    "producer.lock livre com owner singleflight ainda vivo")
            _raise_if_orphan_child_alive(active)
            # Reconcile the stale active generation against *its own*
            # fingerprint. Looking only at the caller's fingerprint can
            # overwrite a durable success from another run with a false
            # dead-owner failure.
            active_terminal = _read_singleflight_terminal(
                directory, active["fingerprint"])
            if (active_terminal is None or
                    active_terminal["run_id"] != active["run_id"]):
                stale_terminal = _dead_owner_terminal(
                    directory, active,
                    "owner morto ou PID reutilizado antes do terminal",
                    ledger_root=epoch.root)
                if active["fingerprint"] == fingerprint:
                    terminal = stale_terminal
            else:
                _unlink_control(
                    active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
                if active["fingerprint"] == fingerprint:
                    terminal = active_terminal
        if terminal is not None:
            if terminal["state"] == "success":
                if retry_failed is not None:
                    raise CommitVerificationError(
                        "resultado singleflight bem-sucedido não aceita retry")
                return _singleflight_replay_and_close(descriptor, terminal)
            if retry_failed is None:
                return _singleflight_replay_and_close(descriptor, terminal)
            if retry_failed != terminal["result_sha256"]:
                raise CommitVerificationError(
                    "--retry-failed diverge do SHA terminal atual")
            if terminal["cas_may_have_applied"]:
                raise CommitBusy(
                    "terminal failure possui CAS ambíguo; recupere/prove o ref "
                    "antes de qualquer retry",
                    cas_may_have_applied=True)
        elif retry_failed is not None:
            raise CommitVerificationError(
                "--retry-failed não possui terminal failure correspondente")

        start_ticks = _proc_start_ticks(os.getpid())
        if start_ticks is None:
            raise CommitVerificationError(
                "processo produtor não possui geração /proc autenticável")
        lease = SingleFlightLease(
            directory=directory, descriptor=descriptor,
            fingerprint=fingerprint, run_id=secrets.token_hex(16),
            pid=os.getpid(), start_ticks=start_ticks,
            started_unix_ns=time.time_ns(),
            unit_key=unit_key, family_key=family_key, unit_kind=kind,
            input_oids_digest=input_oids_digest, ledger_root=epoch.root)
        _singleflight_phase(lease, "claimed")
        print(
            "commit-verified-v2-workflow-results: START run_id=" + lease.run_id +
            " fingerprint=" + fingerprint + " phase=claimed pid=" +
            str(lease.pid) + "/" + str(lease.start_ticks),
            file=sys.stderr, flush=True)
        return lease
    except BaseException:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)
        raise


def _finish_singleflight_success(
    lease: SingleFlightLease, stdout: str,
) -> dict[str, Any]:
    _singleflight_phase(lease, "terminalizing_success_cas")
    record = _terminal_record(
        fingerprint=lease.fingerprint, run_id=lease.run_id, pid=lease.pid,
        start_ticks=lease.start_ticks, started_unix_ns=lease.started_unix_ns,
        state="success", exit_code=0, failure_kind=None,
        cas_may_have_applied=False, stdout=stdout, stderr="")
    _write_terminal(lease.directory, record)
    # The authenticated terminal rename is the durable state boundary.  Once
    # it succeeds, no signal or best-effort cleanup failure may downgrade this
    # execution to FAILURE.
    lease.terminal = True
    _mirror_terminal_to_unit_ledger(
        lease.ledger_root, record, unit_key=lease.unit_key,
        family_key=lease.family_key, kind=lease.unit_kind,
        input_oids_digest=lease.input_oids_digest)
    _unlink_control(
        lease.directory / "active.json", max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    _cleanup_promoted_prepared_index(lease, record)
    return record


def _finish_singleflight_failure(
    lease: SingleFlightLease, error: BaseException,
) -> dict[str, Any]:
    if lease.terminal:
        raise CommitVerificationError(
            "terminal single-flight já é durável; recusa sobrescrever SUCCESS")
    failure_phase = lease.phase
    failure_cas_ambiguous = (
        isinstance(error, CommitBusy) and error.cas_may_have_applied) or \
        _singleflight_cas_phase(failure_phase)
    try:
        _singleflight_phase(
            lease,
            ("terminalizing_failure_cas" if failure_cas_ambiguous else
             "terminalizing_failure_safe"),
        )
    except CommitVerificationError:
        # Preserve the original failure in the terminal even if an adversary
        # damaged active.json; the terminal write itself remains fail-closed.
        pass
    if isinstance(error, CommitBusy):
        failure_kind, exit_code = "CommitBusy", 75
        cas_may_have_applied = failure_cas_ambiguous
    elif isinstance(error, CommitVerificationError):
        failure_kind, exit_code = "CommitVerificationError", 1
        cas_may_have_applied = failure_cas_ambiguous
    elif isinstance(error, Exception):
        failure_kind, exit_code = "Exception", 1
        cas_may_have_applied = failure_cas_ambiguous
    else:
        failure_kind, exit_code = "BaseException", 1
        cas_may_have_applied = failure_cas_ambiguous
    detail = f"{type(error).__name__}: {error}"
    if len(detail.encode("utf-8")) > SINGLEFLIGHT_STDERR_MAX_BYTES:
        detail = detail.encode("utf-8")[:SINGLEFLIGHT_STDERR_MAX_BYTES].decode(
            "utf-8", errors="ignore")
    record = _terminal_record(
        fingerprint=lease.fingerprint, run_id=lease.run_id, pid=lease.pid,
        start_ticks=lease.start_ticks, started_unix_ns=lease.started_unix_ns,
        state="failure", exit_code=exit_code, failure_kind=failure_kind,
        cas_may_have_applied=cas_may_have_applied, stdout="", stderr=detail)
    _write_terminal(lease.directory, record)
    _mirror_terminal_to_unit_ledger(
        lease.ledger_root, record, unit_key=lease.unit_key,
        family_key=lease.family_key, kind=lease.unit_kind,
        input_oids_digest=lease.input_oids_digest)
    _unlink_control(
        lease.directory / "active.json", max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    lease.terminal = True
    return record


def _raise_singleflight_replay(record: Mapping[str, Any]) -> int:
    terminal = _validate_terminal_record(record)
    if terminal["state"] == "success":
        try:
            print(terminal["stdout"], end="", flush=True)
        except (BrokenPipeError, OSError):
            return 0
        return 0
    message = (
        "REPLAY failure result_sha256=" + terminal["result_sha256"] + ": " +
        terminal["stderr"])
    if terminal["failure_kind"] == "CommitBusy":
        raise CommitBusy(
            message,
            cas_may_have_applied=terminal["cas_may_have_applied"])
    raise CommitVerificationError(message)


def _acquire_heavy_audit_lock(
    lease: SingleFlightLease | None = None,
) -> int:
    """Own the heavy flock; a different execution is always BUSY_OTHER."""
    existing_flags = os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW
    create_flags = existing_flags | os.O_CREAT | os.O_EXCL
    descriptor = -1
    for _ in range(3):
        try:
            descriptor = os.open(HEAVY_AUDIT_LOCK, existing_flags)
            break
        except FileNotFoundError:
            try:
                descriptor = os.open(
                    HEAVY_AUDIT_LOCK, create_flags, 0o600)
                break
            except FileExistsError:
                continue
            except OSError as error:
                raise CommitVerificationError(
                    "lock pesado é inseguro: " + str(error)) from error
        except OSError as error:
            raise CommitVerificationError(
                "lock pesado é inseguro: " + str(error)) from error
    if descriptor < 0:
        raise CommitVerificationError(
            "lock pesado mudou repetidamente durante abertura")
    try:
        info = os.fstat(descriptor)
        path_info = os.stat(HEAVY_AUDIT_LOCK, follow_symlinks=False)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
                info.st_uid != os.geteuid() or
                info.st_size < 0 or
                info.st_size > SINGLEFLIGHT_STATE_MAX_BYTES or
                (info.st_dev, info.st_ino) !=
                (path_info.st_dev, path_info.st_ino)):
            raise CommitVerificationError(
                "lock pesado não é arquivo regular canônico único")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            owner = "unknown"
            phase = "legacy_heavy_lock"
            try:
                locked_info = os.fstat(descriptor)
                if 0 < locked_info.st_size <= SINGLEFLIGHT_STATE_MAX_BYTES:
                    raw = os.pread(
                        descriptor, locked_info.st_size, 0)
                    metadata = _decode_json_object(raw, "heavy lock metadata")
                    if (isinstance(metadata.get("run_id"), str) and
                            isinstance(metadata.get("fingerprint"), str) and
                            isinstance(metadata.get("pid"), int) and
                            isinstance(metadata.get("start_ticks"), int) and
                            isinstance(metadata.get("phase"), str)):
                        owner = (str(metadata["pid"]) + "/" +
                                 str(metadata["start_ticks"]) + " run_id=" +
                                 metadata["run_id"] + " fingerprint=" +
                                 metadata["fingerprint"])
                        phase = metadata["phase"]
            except (OSError, CommitVerificationError):
                pass
            raise CommitBusy(
                "BUSY_OTHER heavy_lock owner=" + owner + " phase=" + phase
            ) from error
        locked = os.fstat(descriptor)
        locked_path = os.stat(HEAVY_AUDIT_LOCK, follow_symlinks=False)
        if (not stat.S_ISREG(locked.st_mode) or locked.st_nlink != 1 or
                stat.S_IMODE(locked.st_mode) != 0o600 or
                (locked.st_dev, locked.st_ino) !=
                (locked_path.st_dev, locked_path.st_ino)):
            raise CommitVerificationError(
                "lock pesado perdeu identidade depois do flock")
        metadata = {
            "run_id": lease.run_id if lease is not None else "legacy",
            "fingerprint": (
                lease.fingerprint if lease is not None else "unknown"),
            "pid": os.getpid(),
            "start_ticks": _proc_start_ticks(os.getpid()) or 0,
            "phase": lease.phase if lease is not None else "heavy_audit",
        }
        payload = _canonical_json(metadata)
        os.ftruncate(descriptor, 0)
        view = memoryview(payload)
        offset = 0
        while view:
            written = os.pwrite(descriptor, view, offset)
            if written < 1:
                raise CommitVerificationError(
                    "metadata do lock pesado não avançou")
            view = view[written:]
            offset += written
        os.fsync(descriptor)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _release_heavy_audit_lock(descriptor: int) -> None:
    try:
        os.ftruncate(descriptor, 0)
        os.fsync(descriptor)
        fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)


def _safe_file_payload(
    path: pathlib.Path, *, max_bytes: int = MAX_FILE_BYTES,
) -> tuple[bytes, os.stat_result]:
    """Read one regular file without following any path component symlink."""
    if not path.is_absolute():
        raise CommitVerificationError(
            f"arquivo precisa de path absoluto: {path}")
    directory_flags = (
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    # O_NONBLOCK is inert for regular files and makes the initial open safe
    # against a FIFO substituted at the final path component. The fstat below
    # still rejects every non-regular inode before any read is attempted.
    file_flags = (
        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
    parent = os.open("/", directory_flags)
    try:
        parts = path.parts[1:]
        if not parts:
            raise CommitVerificationError(f"path não aponta arquivo: {path}")
        for component in parts[:-1]:
            child = os.open(component, directory_flags, dir_fd=parent)
            os.close(parent)
            parent = child
        descriptor = os.open(parts[-1], file_flags, dir_fd=parent)
    except OSError as error:
        os.close(parent)
        raise CommitVerificationError(
            f"arquivo ausente/inseguro: {path}") from error
    os.close(parent)
    try:
        before = os.fstat(descriptor)
        if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or
                before.st_size < 0 or before.st_size > max_bytes):
            raise CommitVerificationError(
                f"arquivo não é regular único ou excede limite: {path}")
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise CommitVerificationError(
                    f"arquivo truncou durante leitura: {path}")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise CommitVerificationError(
                f"arquivo cresceu durante leitura: {path}")
        after = os.fstat(descriptor)
        identity_before = (
            before.st_dev, before.st_ino, before.st_mode, before.st_uid,
            before.st_nlink, before.st_size, before.st_mtime_ns,
            before.st_ctime_ns,
        )
        identity_after = (
            after.st_dev, after.st_ino, after.st_mode, after.st_uid,
            after.st_nlink, after.st_size, after.st_mtime_ns,
            after.st_ctime_ns,
        )
        if identity_after != identity_before:
            raise CommitVerificationError(
                f"arquivo mudou durante leitura: {path}")
        return b"".join(chunks), before
    finally:
        os.close(descriptor)


def _file_identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
        info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns,
    )


def _decode_json_object(raw: bytes, label: str) -> dict[str, Any]:
    def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise CommitVerificationError(
                    f"chave JSON duplicada em {label}: {key}")
            result[key] = value
        return result

    try:
        value = json.loads(raw, object_pairs_hook=reject_duplicates)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise CommitVerificationError(f"JSON inválido em {label}") from error
    if not isinstance(value, dict):
        raise CommitVerificationError(f"registro não é objeto em {label}")
    return value


def _decode_unique_intent(raw: bytes, label: str) -> str:
    """Read only top-level intent identity without blessing unrelated fields.

    Historical stock can contain duplicate non-identity keys.  Those remain the
    private auditor's concern; global ID collision detection must neither adopt
    last-key-wins semantics nor let an unrelated defect hide the one mechanical
    repair.  ``tuple`` distinguishes JSON objects from top-level arrays.
    """
    try:
        pairs = json.loads(raw, object_pairs_hook=tuple)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise CommitVerificationError(f"JSON inválido em {label}") from error
    if (not isinstance(pairs, tuple) or
            any(not isinstance(pair, tuple) or len(pair) != 2 or
                not isinstance(pair[0], str) for pair in pairs)):
        raise CommitVerificationError(f"registro não é objeto em {label}")
    intents = [value for key, value in pairs if key == "intent_id"]
    if (len(intents) != 1 or not isinstance(intents[0], str) or
            not intents[0] or intents[0].strip() != intents[0]):
        raise CommitVerificationError(f"intent_id inválido em {label}")
    return intents[0]


def _canonical_intent_fold(value: str) -> str:
    return "".join(
        character for character in unicodedata.normalize("NFKD", value)
        if unicodedata.combining(character) == 0)


def _folded_intent_locations(
    locations: Mapping[str, list[tuple[str, int]]], canonical: str,
) -> list[tuple[str, str, int]]:
    """Return every stock identity that collapses to one canonical ID.

    Exact-string uniqueness is insufficient while repairing legacy Unicode:
    precomposed, decomposed and compatibility spellings can all normalize to
    the same ASCII identity.  Keep the original spelling in the projection so
    callers can require the one authorized legacy owner, not merely one exact
    occurrence of the proposed result.
    """
    return sorted(
        (intent, path, line_number)
        for intent, entries in locations.items()
        if _canonical_intent_fold(intent) == canonical
        for path, line_number in entries
    )


def _assert_public_state_closed(record: Mapping[str, Any], label: str) -> None:
    for flag in CLOSED_PUBLIC_REQUIRED_FALSE_FLAGS:
        if record.get(flag) is not False:
            raise CommitVerificationError(
                f"flag pública aberta em {label}: {flag}")
    for flag in CLOSED_PUBLIC_OPTIONAL_FALSE_FLAGS:
        if flag in record and record[flag] is not False:
            raise CommitVerificationError(
                f"flag pública opcional aberta em {label}: {flag}")
    if record.get("index_policy") != "noindex":
        raise CommitVerificationError(
            f"index_policy precisa permanecer noindex em {label}")
    if record.get("public_path") != "":
        raise CommitVerificationError(
            f"public_path precisa permanecer vazio em {label}")


def _jsonl_records(payload: bytes, label: str) -> list[dict[str, Any]]:
    if (not payload or not payload.endswith(b"\n") or b"\r" in payload or
            b"\0" in payload):
        raise CommitVerificationError(
            f"JSONL precisa ser não vazio, UTF-8 e terminar em LF: {label}")
    lines = payload.splitlines()
    if not lines or any(not line for line in lines):
        raise CommitVerificationError(f"JSONL possui linha vazia: {label}")
    return [
        _decode_json_object(raw, f"{label}:{line_number}")
        for line_number, raw in enumerate(lines, 1)
    ]


def _validate_canonical_id_repair_payloads(
    old_payload: bytes, new_payload: bytes, target: str,
) -> tuple[str, str, int, int]:
    old_records = _jsonl_records(old_payload, target + "@HEAD")
    new_records = _jsonl_records(new_payload, target + "@worktree")
    old_lines = old_payload.splitlines(keepends=True)
    new_lines = new_payload.splitlines(keepends=True)
    if len(old_lines) != len(new_lines) or len(old_records) != len(new_records):
        raise CommitVerificationError(
            "canonical-id-repair alterou quantidade de linhas")
    changed_lines = [
        index for index, (old, new) in enumerate(zip(old_lines, new_lines))
        if old != new
    ]
    if len(changed_lines) != 1:
        raise CommitVerificationError(
            "canonical-id-repair exige exatamente uma linha alterada")
    index = changed_lines[0]
    old_record = old_records[index]
    new_record = new_records[index]
    old_intent = old_record.get("intent_id")
    new_intent = new_record.get("intent_id")
    if (not isinstance(old_intent, str) or not isinstance(new_intent, str) or
            not old_intent or not new_intent or
            old_intent.strip() != old_intent or
            new_intent.strip() != new_intent):
        raise CommitVerificationError(
            "canonical-id-repair exige intent_id textual sem espaços externos")
    folded = _canonical_intent_fold(old_intent)
    if (old_intent == new_intent or
            CANONICAL_INTENT_ID.fullmatch(old_intent) is not None or
            new_intent != folded or
            CANONICAL_INTENT_ID.fullmatch(new_intent) is None):
        raise CommitVerificationError(
            "novo intent_id não é o NFKD exato sem marcas combinantes")
    old_token = (
        b'"intent_id":' +
        json.dumps(old_intent, ensure_ascii=False, separators=(",", ":")).encode(
            "utf-8"))
    new_token = (
        b'"intent_id":' +
        json.dumps(new_intent, ensure_ascii=False, separators=(",", ":")).encode(
            "utf-8"))
    old_line = old_lines[index]
    expected_line = old_line.replace(old_token, new_token, 1)
    if (old_line.count(old_token) != 1 or
            new_lines[index].count(new_token) != 1 or
            new_lines[index] != expected_line):
        raise CommitVerificationError(
            "bytes mudaram fora da substituição exata de intent_id")
    restored = dict(new_record)
    restored["intent_id"] = old_intent
    if restored != old_record:
        raise CommitVerificationError(
            "campo diferente de intent_id mudou no canonical-id-repair")
    for line_number, (old_record_item, new_record_item) in enumerate(
            zip(old_records, new_records), 1):
        _assert_public_state_closed(old_record_item, f"{target}:{line_number}:old")
        _assert_public_state_closed(new_record_item, f"{target}:{line_number}:new")
    return old_intent, new_intent, index + 1, len(old_records)


def _trusted_system_executable(path: pathlib.Path) -> None:
    try:
        info = path.stat(follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            f"executável de sistema ausente: {path}") from error
    if (not stat.S_ISREG(info.st_mode) or path.is_symlink() or
            not info.st_mode & stat.S_IXUSR or info.st_uid != 0 or
            stat.S_IMODE(info.st_mode) & 0o022):
        raise CommitVerificationError(
            f"executável de sistema não é confiável: {path}")


def _sanitize_python_import_boundary() -> None:
    """Close PYTHONPATH/user-site before any repository module is loaded."""
    if not sys.flags.isolated:
        raise CommitVerificationError(
            "wrapper deve ser executado diretamente pelo shebang Python -I")
    for variable in (
            "PYTHONPATH", "PYTHONHOME", "PYTHONUSERBASE", "PYTHONSTARTUP",
            "V2_DISTINCTNESS_STORE", "WIKI_VERIFY_V2_TEST_ROOT",
            "WIKI_VERIFY_V2_TEST_REVIEW_MERIT_REPORT",
            "WIKI_VERIFY_V2_TEST_BEFORE_RECHECK"):
        os.environ.pop(variable, None)
    os.environ["PYTHONNOUSERSITE"] = "1"
    os.environ["PYTHONSAFEPATH"] = "1"
    site.ENABLE_USER_SITE = False
    paths = sysconfig.get_paths()
    stdlib_candidates = [
        paths.get("stdlib"), paths.get("platstdlib"),
        os.path.join(paths.get("stdlib", ""), "lib-dynload"),
    ]
    canonical: list[str] = []
    for candidate in stdlib_candidates:
        if not candidate:
            continue
        absolute = os.path.realpath(candidate)
        if absolute not in canonical:
            canonical.append(absolute)
    sys.path[:] = canonical
    sys.path_importer_cache.clear()
    for name in list(sys.modules):
        if name == "tools" or name.startswith("tools."):
            del sys.modules[name]


def _assert_closed_repository_imports(payload: bytes, relative: str) -> None:
    """Reject repository imports outside the eagerly loaded exact allowlist."""
    allowed = {name for name, _ in PYTHON_HELPERS if name.startswith("tools.")}
    try:
        tree = ast.parse(payload, filename=relative)
    except (SyntaxError, ValueError) as error:
        raise CommitVerificationError(
            f"helper Python canônico não compila: {relative}") from error
    for node in ast.walk(tree):
        imported: list[str] = []
        if isinstance(node, ast.ImportFrom) and node.module == "tools":
            imported = ["tools." + alias.name for alias in node.names]
        elif isinstance(node, ast.Import):
            imported = [alias.name for alias in node.names
                        if alias.name == "tools" or
                        alias.name.startswith("tools.")]
        if any(name not in allowed for name in imported):
            raise CommitVerificationError(
                f"helper Python importa módulo repo fora da closure: {relative}")


def _rules_only_builtins(
    rules_path: pathlib.Path, rules_payload: bytes,
) -> dict[str, Any]:
    canonical_rules = os.fspath(rules_path)

    def closed_open(
        file: Any, mode: str = "r", buffering: int = -1,
        encoding: str | None = None, errors: str | None = None,
        newline: str | None = None, closefd: bool = True,
        opener: Any = None,
    ) -> io.StringIO:
        del buffering, errors, newline, closefd, opener
        try:
            candidate = os.path.abspath(os.fspath(file))
        except TypeError as error:
            raise CommitVerificationError(
                "helper tentou abrir path não canônico") from error
        if (candidate != canonical_rules or mode not in {"r", "rt"} or
                encoding not in {None, "utf-8"}):
            raise CommitVerificationError(
                "helper tentou leitura lazy fora da closure Python")
        return io.StringIO(rules_payload.decode("utf-8", errors="strict"))

    namespace = dict(builtins.__dict__)
    namespace["open"] = closed_open
    return namespace


def _load_exact_source_module(
    name: str, relative: str, *, module_builtins: Mapping[str, Any] | None = None,
) -> Any:
    path = INSTALL_ROOT / relative
    payload, _ = _safe_file_payload(path)
    _assert_closed_repository_imports(payload, relative)
    digest = hashlib.sha256(payload).hexdigest()
    try:
        code = compile(payload, os.fspath(path), "exec", dont_inherit=True)
    except (SyntaxError, ValueError) as error:
        raise CommitVerificationError(
            f"helper Python canônico não compila: {relative}") from error
    module = types.ModuleType(name)
    module.__file__ = os.fspath(path)
    module.__package__ = name.rpartition(".")[0]
    module.__loader__ = None
    if module_builtins is not None:
        module.__dict__["__builtins__"] = dict(module_builtins)
    sys.modules[name] = module
    try:
        exec(code, module.__dict__)
    except BaseException:
        sys.modules.pop(name, None)
        raise
    if pathlib.Path(module.__file__).resolve(strict=True) != path:
        raise CommitVerificationError(
            f"helper Python escapou do path canônico: {relative}")
    _LOADED_HELPER_BINDINGS[path] = digest
    return module


def _load_verifier() -> Any:
    global _LOADED_AUDITOR
    _trusted_system_executable(PYTHON_BIN)
    _sanitize_python_import_boundary()
    package = types.ModuleType("tools")
    package.__package__ = "tools"
    # Empty by design: every permitted repository module is executed from
    # authenticated bytes below; importlib cannot fall back to the worktree.
    package.__path__ = []
    package.__file__ = None
    sys.modules["tools"] = package
    rules_path = INSTALL_ROOT / IMOBILIARIO_RULES_REL
    rules_payload, _ = _safe_file_payload(rules_path)
    try:
        decoded_rules = json.loads(rules_payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise CommitVerificationError(
            "regras imobiliárias fechadas não são JSON") from error
    if not isinstance(decoded_rules, dict):
        raise CommitVerificationError(
            "regras imobiliárias fechadas não são objeto")
    _LOADED_HELPER_BINDINGS[rules_path] = hashlib.sha256(
        rules_payload).hexdigest()
    loaded: dict[str, Any] = {}
    for name, relative in PYTHON_HELPERS:
        module_builtins = None
        if name == "tools.imobiliario09_current_legal_facts":
            module_builtins = _rules_only_builtins(rules_path, rules_payload)
        loaded[name] = _load_exact_source_module(
            name, relative, module_builtins=module_builtins)
        if name.startswith("tools."):
            setattr(package, name.split(".", 1)[1], loaded[name])
    if any(os.path.realpath(path) == os.fspath(INSTALL_ROOT)
           for path in sys.path):
        raise CommitVerificationError(
            "helper reabriu INSTALL_ROOT para imports gerais")
    _LOADED_AUDITOR = loaded["tools.audit_v2_pages"]
    return loaded["v2_workflow_result_verifier_for_plumbing_commit"]


def _trusted_environment(
    *, index_file: str | None = None, commit_identity: bool = False,
    temporary_directory: pathlib.Path | None = None,
) -> dict[str, str]:
    temporary = (
        os.fspath(temporary_directory)
        if temporary_directory is not None else "/nonexistent")
    environment = {
        "PATH": "/usr/bin:/bin",
        "HOME": "/nonexistent",
        "XDG_CONFIG_HOME": "/nonexistent",
        "TMPDIR": temporary,
        "LC_ALL": "C",
        "LANG": "C",
        "TZ": "UTC",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_NO_LAZY_FETCH": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    }
    if index_file is not None:
        environment["GIT_INDEX_FILE"] = index_file
    if commit_identity:
        environment.update({
            "GIT_AUTHOR_NAME": AUTHOR_NAME,
            "GIT_AUTHOR_EMAIL": AUTHOR_EMAIL,
            "GIT_COMMITTER_NAME": AUTHOR_NAME,
            "GIT_COMMITTER_EMAIL": AUTHOR_EMAIL,
        })
    return environment


def _kill_process_group(process: subprocess.Popen[bytes]) -> None:
    """Kill and reap a subprocess plus every descendant in its private group."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        # The direct child can still be reaped below.  ``start_new_session`` is
        # mandatory at every call site, so another process group is never used.
        pass
    try:
        process.communicate(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            process.kill()
        except ProcessLookupError:
            pass
        process.communicate()


def _run_closed_process(
    command: list[str], *, cwd: pathlib.Path,
    environment: Mapping[str, str], input_payload: bytes | None = None,
    timeout: int,
) -> subprocess.CompletedProcess[bytes]:
    """Run a bounded child in a process group that cannot survive timeout."""
    return _run_closed_process_bounded(
        command, cwd=cwd, environment=environment, timeout=timeout,
        stdout_limit=MAX_GIT_OUTPUT_BYTES,
        stderr_limit=MAX_GIT_OUTPUT_BYTES, input_payload=input_payload)


def _run_closed_process_bounded(
    command: list[str], *, cwd: pathlib.Path,
    environment: Mapping[str, str], timeout: int,
    stdout_limit: int, stderr_limit: int,
    input_payload: bytes | None = None,
) -> subprocess.CompletedProcess[bytes]:
    """Capture a process incrementally with hard byte/time limits."""
    input_file: Any = None
    if input_payload is not None:
        if len(input_payload) > MAX_GIT_OUTPUT_BYTES:
            raise CommitVerificationError("stdin privado excedeu limite")
        input_file = tempfile.TemporaryFile(mode="w+b", dir="/tmp")
        view = memoryview(input_payload)
        while view:
            written = input_file.write(view)
            if written is None or written < 1:
                input_file.close()
                raise CommitVerificationError("stdin privado não avançou")
            view = view[written:]
        input_file.flush()
        input_file.seek(0)
    try:
        lease = _ACTIVE_SINGLEFLIGHT
        inherited_leases: tuple[int, ...] = ()
        if lease is not None:
            inherited_leases = tuple(
                descriptor for descriptor in (
                    lease.descriptor, lease.heavy_descriptor)
                if descriptor >= 0)
        process = subprocess.Popen(
            command, cwd=cwd, env=dict(environment), stdin=(
                input_file if input_file is not None else subprocess.DEVNULL),
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0,
            start_new_session=True, pass_fds=inherited_leases)
    finally:
        if input_file is not None:
            input_file.close()
    try:
        if lease is not None:
            _singleflight_phase(lease, lease.phase, child_pid=process.pid)
    except BaseException:
        _kill_process_group(process)
        raise
    assert process.stdout is not None
    assert process.stderr is not None
    stdout_buffer = bytearray()
    stderr_buffer = bytearray()
    streams = {
        process.stdout.fileno(): (
            process.stdout, stdout_buffer, stdout_limit, "stdout"),
        process.stderr.fileno(): (
            process.stderr, stderr_buffer, stderr_limit, "stderr"),
    }
    for descriptor in streams:
        os.set_blocking(descriptor, False)
    deadline = time.monotonic() + timeout
    try:
        while streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, timeout)
            ready, _, _ = select.select(
                list(streams), [], [], min(remaining, 1.0))
            if not ready:
                _singleflight_heartbeat()
                continue
            for descriptor in ready:
                stream, buffer, limit, label = streams[descriptor]
                try:
                    chunk = os.read(descriptor, 64 * 1024)
                except BlockingIOError:
                    continue
                if not chunk:
                    del streams[descriptor]
                    continue
                buffer.extend(chunk)
                if len(buffer) > limit:
                    raise CommitVerificationError(
                        f"processo privado excedeu limite de {label}")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(command, timeout)
        process.wait(timeout=remaining)
    except BaseException:
        for stream in (process.stdout, process.stderr):
            if not stream.closed:
                try:
                    os.set_blocking(stream.fileno(), True)
                except OSError:
                    pass
        _kill_process_group(process)
        raise
    process.stdout.close()
    process.stderr.close()
    if lease is not None and not lease.terminal:
        _singleflight_phase(lease, lease.phase)
    return subprocess.CompletedProcess(
        command, process.returncode, bytes(stdout_buffer),
        bytes(stderr_buffer))


def _run_git(
    root: pathlib.Path,
    arguments: list[str],
    *,
    index_file: str | None = None,
    input_payload: bytes | None = None,
    timeout: int = 120,
    check: bool = True,
    commit_identity: bool = False,
) -> subprocess.CompletedProcess[bytes]:
    _trusted_system_executable(GIT_BIN)
    command = [
        os.fspath(GIT_BIN), "-C", os.fspath(root), "--no-replace-objects",
        "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false",
        "-c", "core.hooksPath=/dev/null", "-c", "commit.gpgSign=false",
        "-c", "safe.directory=" + os.fspath(root),
        *arguments,
    ]
    try:
        completed = _run_closed_process(
            command, cwd=root,
            environment=_trusted_environment(
                index_file=index_file, commit_identity=commit_identity),
            input_payload=input_payload, timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CommitVerificationError(
            f"git não concluiu {arguments[0]}: {type(error).__name__}") from error
    if (len(completed.stdout) > MAX_GIT_OUTPUT_BYTES or
            len(completed.stderr) > MAX_GIT_OUTPUT_BYTES):
        raise CommitVerificationError(
            f"git {arguments[0]} excedeu limite de saída")
    if check and completed.returncode != 0:
        detail = " ".join(completed.stderr.decode(
            "utf-8", errors="replace").split())[:1000]
        raise CommitVerificationError(
            f"git {arguments[0]} falhou rc={completed.returncode}: {detail}")
    return completed


def _git_text(
    root: pathlib.Path, arguments: list[str], **kwargs: Any,
) -> str:
    payload = _run_git(root, arguments, **kwargs).stdout
    try:
        return payload.decode("utf-8", errors="strict").strip()
    except UnicodeDecodeError as error:
        raise CommitVerificationError(
            f"git {arguments[0]} não retornou UTF-8") from error


def _git_control_path(root: pathlib.Path, name: str) -> pathlib.Path:
    raw = _git_text(root, ["rev-parse", "--git-path", name])
    path = pathlib.Path(raw)
    if not path.is_absolute():
        path = root / path
    try:
        parent = path.parent.resolve(strict=True)
    except OSError as error:
        raise CommitVerificationError(
            f"git path indisponível: {name}") from error
    candidate = parent / path.name
    if candidate.is_symlink():
        raise CommitVerificationError(f"git path simbólico inseguro: {name}")
    return candidate


def _capture_symbolic_head(
    root: pathlib.Path,
) -> tuple[str, str, pathlib.Path, bytes]:
    symbolic = _run_git(
        root, ["symbolic-ref", "-q", "HEAD"], check=False)
    if symbolic.returncode == 1:
        raise CommitVerificationError(
            "HEAD detached não é aceito pela transação de commit")
    if symbolic.returncode != 0:
        detail = " ".join(symbolic.stderr.decode(
            "utf-8", errors="replace").split())[:800]
        raise CommitVerificationError(
            "git symbolic-ref falhou durante captura" +
            (": " + detail if detail else ""))
    try:
        expected_ref = symbolic.stdout.decode(
            "utf-8", errors="strict").strip()
    except UnicodeDecodeError as error:
        raise CommitVerificationError("symbolic HEAD não é UTF-8") from error
    if (not expected_ref.startswith("refs/heads/") or
            expected_ref != expected_ref.strip() or "\x00" in expected_ref or
            ".." in pathlib.PurePosixPath(expected_ref).parts):
        raise CommitVerificationError(
            f"symbolic HEAD não é branch canônica: {expected_ref!r}")
    expected_head = _git_text(
        root, ["rev-parse", "--verify", expected_ref + "^{commit}"])
    if _git_text(root, ["rev-parse", "--verify", "HEAD^{commit}"]) != expected_head:
        raise CommitVerificationError("HEAD e symbolic ref divergiram")
    second_ref = _git_text(root, ["symbolic-ref", "-q", "HEAD"])
    if second_ref != expected_ref:
        raise CommitBusy("HEAD foi retargetado durante captura")
    head_path = _git_control_path(root, "HEAD")
    head_payload, _ = _safe_file_payload(head_path, max_bytes=4096)
    if head_payload != ("ref: " + expected_ref + "\n").encode("utf-8"):
        raise CommitVerificationError(
            "arquivo HEAD diverge da symbolic ref capturada")
    return expected_head, expected_ref, head_path, head_payload


def _path_chunks(paths: set[str] | list[str], size: int = 256) -> list[list[str]]:
    ordered = sorted(set(paths))
    return [ordered[index:index + size]
            for index in range(0, len(ordered), size)]


def _head_entries(
    root: pathlib.Path, treeish: str, paths: set[str] | list[str],
) -> dict[str, tuple[str, str]]:
    entries: dict[str, tuple[str, str]] = {}
    requested = set(paths)
    for chunk in _path_chunks(paths):
        payload = _run_git(
            root,
            ["ls-tree", "-z", treeish, "--",
             *(":(literal)" + path for path in chunk)],
        ).stdout
        for raw in payload.split(b"\0"):
            if not raw:
                continue
            try:
                metadata, encoded_path = raw.split(b"\t", 1)
                mode, kind, oid = metadata.decode("ascii").split(" ")
                path = encoded_path.decode("utf-8", errors="strict")
            except (UnicodeDecodeError, ValueError) as error:
                raise CommitVerificationError(
                    "ls-tree retornou entrada inválida") from error
            if (path not in requested or kind != "blob" or
                    mode not in {"100644", "100755"} or
                    HEX_OBJECT.fullmatch(oid) is None or path in entries):
                raise CommitVerificationError(
                    f"árvore Git possui entrada não canônica: {path}")
            entries[path] = (mode, oid)
    return entries


def _index_entries_for_paths(
    root: pathlib.Path,
    paths: set[str] | list[str],
    *,
    index_file: str | None = None,
) -> dict[str, tuple[str, str, str] | None]:
    entries: dict[str, tuple[str, str, str] | None] = {
        path: None for path in set(paths)}
    for chunk in _path_chunks(paths):
        payload = _run_git(
            root,
            ["ls-files", "--stage", "-z", "--",
             *(":(literal)" + path for path in chunk)],
            index_file=index_file,
        ).stdout
        for raw in payload.split(b"\0"):
            if not raw:
                continue
            try:
                metadata, encoded_path = raw.split(b"\t", 1)
                mode, oid, stage = metadata.decode("ascii").split(" ")
                path = encoded_path.decode("utf-8", errors="strict")
            except (UnicodeDecodeError, ValueError) as error:
                raise CommitVerificationError(
                    "índice Git retornou entrada inválida") from error
            if (path not in entries or entries[path] is not None or
                    stage != "0" or mode not in {"100644", "100755"} or
                    HEX_OBJECT.fullmatch(oid) is None):
                raise CommitVerificationError(
                    f"índice Git possui conflito/entrada insegura: {path}")
            entries[path] = (mode, oid, stage)
    return entries


def _index_changed_paths(
    root: pathlib.Path, expected_head: str, index_file: str,
) -> list[str]:
    payload = _run_git(
        root,
        ["diff", "--cached", "--name-only", "-z", "--no-ext-diff",
         "--no-renames", expected_head, "--"],
        index_file=index_file,
    ).stdout
    try:
        changed = [item.decode("utf-8", errors="strict")
                   for item in payload.split(b"\0") if item]
    except UnicodeDecodeError as error:
        raise CommitVerificationError(
            "índice privado possui path não UTF-8") from error
    if len(changed) != len(set(changed)):
        raise CommitVerificationError("índice privado duplicou path")
    return changed


def _validate_index_closure_blob(
    root: pathlib.Path,
    item: Mapping[str, str],
    payload: bytes,
    object_format: str,
    *,
    index_file: str | None = None,
) -> None:
    """Bind a staged stage-0 entry to the authenticated closure bytes.

    Comparing only the index OID would silently delegate byte identity to the
    repository object format.  This boundary deliberately requires all three:
    the caller-checked mode/OID/stage tuple, the exact object bytes, and the
    recomputed Git object ID for those bytes.
    """
    blob = _run_git(
        root, ["cat-file", "blob", item["git_blob_oid"]],
        index_file=index_file,
    ).stdout
    if (blob != payload or
            _git_blob_oid(blob, object_format) != item["git_blob_oid"]):
        raise CommitVerificationError(
            "entrada staged diverge dos bytes autenticados: " + item["path"])


def _git_blob_oid(payload: bytes, object_format: str) -> str:
    if object_format not in {"sha1", "sha256"}:
        raise CommitVerificationError(
            f"object format Git não suportado: {object_format}")
    header = f"blob {len(payload)}\0".encode("ascii")
    return hashlib.new(object_format, header + payload).hexdigest()


def _canonical_relative(root: pathlib.Path, path: pathlib.Path) -> str:
    try:
        relative = path.relative_to(root).as_posix()
    except ValueError as error:
        raise CommitVerificationError(
            f"artefato escapou do repositório: {path}") from error
    pure = pathlib.PurePosixPath(relative)
    if (not relative or relative.startswith("/") or "\x00" in relative or
            any(part in {"", ".", ".."} for part in pure.parts)):
        raise CommitVerificationError(
            f"path de artefato não é canônico: {relative!r}")
    return relative


def _worktree_mode(info: os.stat_result) -> str:
    return "100755" if info.st_mode & 0o111 else "100644"


def _validate_message(message: str) -> str:
    if (not isinstance(message, str) or message != message.strip() or
            not 10 <= len(message) <= 200 or "\n" in message or
            "\r" in message or
            any(ord(character) < 32 for character in message)):
        raise CommitVerificationError(
            "mensagem deve ter 10-200 caracteres, uma linha e sem controles")
    return message


def _execution_bindings(root: pathlib.Path) -> dict[pathlib.Path, str]:
    paths = [root / ".githooks" / "pre-commit"]
    expected_loaded = {INSTALL_ROOT / relative
                       for _, relative in PYTHON_HELPERS}
    expected_loaded.add(INSTALL_ROOT / IMOBILIARIO_RULES_REL)
    if root == INSTALL_ROOT:
        if set(_LOADED_HELPER_BINDINGS) != expected_loaded:
            raise CommitVerificationError(
                "helpers Python não foram carregados pela fronteira exata")
        paths.append(TOOL_PATH)
    result = dict(_LOADED_HELPER_BINDINGS) if root == INSTALL_ROOT else {}
    for path in paths:
        payload, info = _safe_file_payload(path)
        if path == root / ".githooks" / "pre-commit" and not info.st_mode & 0o111:
            raise CommitVerificationError("snapshot pre-commit não é executável")
        digest = hashlib.sha256(payload).hexdigest()
        previous = result.get(path)
        if previous is not None and previous != digest:
            raise CommitVerificationError(
                f"helper mudou desde o carregamento: {path}")
        result[path] = digest
    return result


def _authenticated_candidates(
    transaction: Any, object_format: str,
) -> tuple[dict[str, dict[str, str]], dict[str, bytes]]:
    if transaction.kind == "semantic-recut":
        candidates = getattr(transaction, "staged_candidates", None)
        payloads = getattr(transaction, "staged_payloads", None)
        if (not isinstance(candidates, Mapping) or not candidates or
                not isinstance(payloads, Mapping) or
                set(candidates) != set(payloads)):
            raise CommitVerificationError(
                "semantic-recut perdeu closure staged fechada")
        for path, item in candidates.items():
            payload = payloads[path]
            expected_mode = SEMANTIC_BOOTSTRAP_RUNTIME_MODES.get(
                path, "100644")
            if (not isinstance(path, str) or not isinstance(item, Mapping) or
                    item.get("path") != path or
                    item.get("mode") != expected_mode or
                    item.get("sha256") != hashlib.sha256(payload).hexdigest() or
                    item.get("git_blob_oid") !=
                    _git_blob_oid(payload, object_format)):
                raise CommitVerificationError(
                    "semantic-recut divergiu no blob staged: " + str(path))
        return ({path: dict(item) for path, item in candidates.items()},
                dict(payloads))
    authenticated: dict[str, dict[str, str]] = {}
    for item in transaction.report.get("files", []):
        if (not isinstance(item, Mapping) or
                not isinstance(item.get("file"), str) or
                TARGET_REL.fullmatch(item["file"]) is None or
                not isinstance(item.get("sha256"), str) or
                SHA256.fullmatch(item["sha256"]) is None):
            raise CommitVerificationError(
                "report autenticado perdeu target fechado")
        if item["file"] in authenticated:
            raise CommitVerificationError(
                f"report duplicou target: {item['file']}")
        authenticated[item["file"]] = {
            "sha256": item["sha256"],
            "role": transaction.kind + "_verified_target",
        }
    for item in transaction.report.get("required_artifacts", []):
        if (not isinstance(item, Mapping) or set(item) !=
                {"file", "sha256", "role"} or
                not isinstance(item["file"], str) or
                not isinstance(item["sha256"], str) or
                SHA256.fullmatch(item["sha256"]) is None or
                item["role"] not in ALLOWED_ARTIFACT_ROLES or
                (item["role"] == "raw_recovery_preimage_evidence" and
                 RAW_RECOVERY_REL.fullmatch(item["file"]) is None) or
                (item["role"] == "source_provenance_evidence" and
                 PROVENANCE_REL.fullmatch(item["file"]) is None)):
            raise CommitVerificationError(
                "report autenticado perdeu artifact fechado")
        projected = {"sha256": item["sha256"], "role": item["role"]}
        previous = authenticated.get(item["file"])
        if previous is not None and previous != projected:
            raise CommitVerificationError(
                f"artefato contraditório na closure: {item['file']}")
        authenticated[item["file"]] = projected
    if not authenticated:
        raise CommitVerificationError("closure autenticada está vazia")

    candidates: dict[str, dict[str, str]] = {}
    payloads: dict[str, bytes] = {}
    for relative, bind in sorted(authenticated.items()):
        path = transaction.root / relative
        if _canonical_relative(transaction.root, path) != relative:
            raise CommitVerificationError(
                f"path autenticado não é canônico: {relative}")
        payload, info = _safe_file_payload(path)
        digest = hashlib.sha256(payload).hexdigest()
        if digest != bind["sha256"]:
            raise CommitVerificationError(
                f"artefato mudou antes da closure: {relative}")
        mode = _worktree_mode(info)
        if mode != "100644":
            raise CommitVerificationError(
                f"artefato editorial ganhou bit executável: {relative}")
        payloads[relative] = payload
        candidates[relative] = {
            "path": relative,
            "sha256": digest,
            "mode": mode,
            "role": bind["role"],
            "git_blob_oid": _git_blob_oid(payload, object_format),
        }
    return candidates, payloads


def _build_commit_epoch(transaction: Any, message: str) -> CommitEpoch:
    del message  # Validated by the caller; it is not a filesystem dependency.
    root = transaction.root
    (expected_head, expected_ref, head_path,
     head_payload) = _capture_symbolic_head(root)
    transaction_expected_head = getattr(transaction, "expected_head", None)
    if (transaction_expected_head is not None and
            transaction_expected_head != expected_head):
        raise CommitBusy(
            "HEAD mudou depois da autoridade canonical-id-repair")
    object_format = _git_text(root, ["rev-parse", "--show-object-format"])
    expected_length = 40 if object_format == "sha1" else 64
    if (len(expected_head) != expected_length or
            HEX_OBJECT.fullmatch(expected_head) is None):
        raise CommitVerificationError("HEAD não é commit canônico")
    candidates, authenticated_payloads = _authenticated_candidates(
        transaction, object_format)

    dependency_bindings: dict[pathlib.Path, str] = dict(
        transaction.dependencies)
    for path, digest in transaction.live_targets.items():
        previous = dependency_bindings.get(path)
        if previous is not None and previous != digest:
            raise CommitVerificationError(
                f"target possui hashes transacionais contraditórios: {path}")
        dependency_bindings[path] = digest
    for path, digest in _execution_bindings(root).items():
        previous = dependency_bindings.get(path)
        if previous is not None and previous != digest:
            raise CommitVerificationError(
                f"helper possui bind transacional contraditório: {path}")
        dependency_bindings[path] = digest

    dependency_snapshots: list[
        tuple[pathlib.Path, bytes, os.stat_result, str, str | None]
    ] = []
    head_paths = set(candidates)
    for path, expected_digest in sorted(
            dependency_bindings.items(), key=lambda item: os.fspath(item[0])):
        payload, info = _safe_file_payload(path)
        actual_digest = hashlib.sha256(payload).hexdigest()
        if actual_digest != expected_digest:
            raise CommitVerificationError(
                f"dependência mudou antes do commit: {path}")
        try:
            relative = _canonical_relative(root, path)
        except CommitVerificationError:
            relative = None
        if relative is not None:
            head_paths.add(relative)
        dependency_snapshots.append(
            (path, payload, info, actual_digest, relative))

    head_entries = _head_entries(root, expected_head, head_paths)
    closure = tuple(
        item for relative, item in sorted(candidates.items())
        if head_entries.get(relative) != (item["mode"], item["git_blob_oid"])
    )
    if not closure:
        raise CommitVerificationError(
            "todos os artefatos autenticados já pertencem a HEAD")
    closure_paths = {item["path"] for item in closure}

    dependencies: list[dict[str, str]] = []
    for path, payload, info, digest, relative in dependency_snapshots:
        if relative is None:
            dependencies.append({
                "path": os.fspath(path), "sha256": digest,
                "scope": "transient_locked",
            })
            continue
        dependencies.append({
            "path": relative, "sha256": digest, "scope": "repository",
        })
        if relative in closure_paths:
            if (relative not in authenticated_payloads or
                    hashlib.sha256(
                        authenticated_payloads[relative]).hexdigest() != digest):
                raise CommitVerificationError(
                    f"dependência na closure não possui bind único: {relative}")
            continue
        live_mode = _worktree_mode(info)
        live_oid = _git_blob_oid(payload, object_format)
        if head_entries.get(relative) != (live_mode, live_oid):
            raise CommitVerificationError(
                "dependência repo-bound está dirty fora da closure: " +
                relative)

    main_index_before = _index_entries_for_paths(root, closure_paths)
    head_closure = _head_entries(root, expected_head, closure_paths)
    for path in sorted(closure_paths):
        item = candidates[path]
        expected_index = (
            (*head_closure[path], "0") if path in head_closure else None)
        closure_index = (item["mode"], item["git_blob_oid"], "0")
        captured_index = main_index_before.get(path)
        if captured_index == expected_index:
            continue
        if captured_index != closure_index:
            semantic_source = (
                transaction.index_entries.get(path)
                if transaction.kind == "semantic-recut" else None)
            if captured_index != semantic_source:
                raise CommitVerificationError(
                    "índice compartilhado já diverge no alvo: " + path)
            continue
        _validate_index_closure_blob(
            root, item, authenticated_payloads[path], object_format)

    hook_path = root / ".githooks" / "pre-commit"
    hook_payload, _ = _safe_file_payload(hook_path)
    hook_digest = hashlib.sha256(hook_payload).hexdigest()
    if dependency_bindings.get(hook_path) != hook_digest:
        raise CommitVerificationError("snapshot pre-commit perdeu seu bind")
    try:
        hook_payload.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise CommitVerificationError("snapshot pre-commit não é UTF-8") from error

    transaction.revalidate()
    return CommitEpoch(
        root=root,
        expected_head=expected_head,
        expected_ref=expected_ref,
        head_path=head_path,
        head_payload=head_payload,
        object_format=object_format,
        closure=closure,
        closure_payloads={item["path"]: authenticated_payloads[item["path"]]
                          for item in closure},
        dependencies=tuple(dependencies),
        dependency_bindings=dict(dependency_bindings),
        main_index_targets_before=dict(main_index_before),
        hook_payload=hook_payload,
    )


def _write_private_index_entries(
    root: pathlib.Path,
    index_file: str,
    closure: tuple[dict[str, str], ...],
) -> None:
    payload = b"".join(
        (f"{item['mode']} {item['git_blob_oid']}\t".encode("ascii") +
         item["path"].encode("utf-8") + b"\0")
        for item in closure
    )
    _run_git(
        root, ["update-index", "-z", "--index-info"],
        index_file=index_file, input_payload=payload)


def _validate_private_index(epoch: CommitEpoch, index_file: str) -> None:
    expected_paths = {item["path"] for item in epoch.closure}
    changed = _index_changed_paths(
        epoch.root, epoch.expected_head, index_file)
    if set(changed) != expected_paths or len(changed) != len(expected_paths):
        raise CommitVerificationError(
            "índice privado não contém exatamente a closure")
    entries = _index_entries_for_paths(
        epoch.root, expected_paths, index_file=index_file)
    for item in epoch.closure:
        if entries.get(item["path"]) != (
                item["mode"], item["git_blob_oid"], "0"):
            raise CommitVerificationError(
                f"índice privado diverge no blob/mode: {item['path']}")
        blob = _run_git(
            epoch.root, ["cat-file", "blob", item["git_blob_oid"]],
            index_file=index_file).stdout
        if hashlib.sha256(blob).hexdigest() != item["sha256"]:
            raise CommitVerificationError(
                f"índice privado diverge no SHA-256: {item['path']}")


def _materialize_private_index(epoch: CommitEpoch, index_file: str) -> None:
    _run_git(
        epoch.root, ["read-tree", epoch.expected_head], index_file=index_file)
    for item in epoch.closure:
        payload = epoch.closure_payloads[item["path"]]
        oid = _git_text(
            epoch.root, ["hash-object", "-w", "--stdin"],
            input_payload=payload)
        if oid != item["git_blob_oid"]:
            raise CommitVerificationError(
                f"hash-object divergiu do blob autenticado: {item['path']}")
    _write_private_index_entries(epoch.root, index_file, epoch.closure)
    _validate_private_index(epoch, index_file)


def _tree_entries_under(
    root: pathlib.Path, treeish: str, roots: tuple[str, ...],
) -> list[dict[str, str]]:
    payload = _run_git(
        root,
        ["ls-tree", "-r", "-z", treeish, "--",
         *(":(literal)" + item for item in roots)],
    ).stdout
    entries: list[dict[str, str]] = []
    seen: set[str] = set()
    for raw in payload.split(b"\0"):
        if not raw:
            continue
        try:
            metadata, raw_path = raw.split(b"\t", 1)
            mode, kind, oid = metadata.decode("ascii").split(" ")
            relative = raw_path.decode("utf-8", errors="strict")
        except (UnicodeDecodeError, ValueError) as error:
            raise CommitVerificationError(
                "ls-tree recursivo retornou entrada inválida") from error
        pure = pathlib.PurePosixPath(relative)
        allowed = any(
            relative == allowed_root or
            relative.startswith(allowed_root.rstrip("/") + "/")
            for allowed_root in roots)
        if (not allowed or relative in seen or kind != "blob" or
                mode not in {"100644", "100755"} or
                HEX_OBJECT.fullmatch(oid) is None or
                any(part in {"", ".", ".."} for part in pure.parts)):
            raise CommitVerificationError(
                f"closure Git recursiva não é canônica: {relative!r}")
        seen.add(relative)
        entries.append({"path": relative, "mode": mode, "oid": oid})
    return sorted(entries, key=lambda item: item["path"])


def _git_blob_sizes(
    root: pathlib.Path, unique_oids: list[str],
) -> dict[str, int]:
    """Read bounded object metadata before allocating any batch payload."""
    sizes: dict[str, int] = {}
    for offset in range(0, len(unique_oids), GIT_BATCH_CHECK_MAX_OBJECTS):
        requested = unique_oids[offset:offset + GIT_BATCH_CHECK_MAX_OBJECTS]
        response = _run_git(
            root, ["cat-file", "--batch-check"],
            input_payload=b"".join(
                oid.encode("ascii") + b"\n" for oid in requested),
        ).stdout
        lines = response.splitlines()
        if len(lines) != len(requested):
            raise CommitVerificationError(
                "cat-file batch-check divergiu do inventário")
        for requested_oid, raw in zip(requested, lines):
            try:
                actual_oid, kind, raw_size = raw.decode("ascii").split(" ")
                size = int(raw_size)
            except (UnicodeDecodeError, ValueError) as error:
                raise CommitVerificationError(
                    "cat-file batch-check retornou metadata inválida") from error
            # A batch response also carries its header and delimiter. Keep one
            # bounded object strictly below the process-output ceiling.
            if (actual_oid != requested_oid or kind != "blob" or size < 0 or
                    size > min(MAX_FILE_BYTES,
                               MAX_GIT_OUTPUT_BYTES - 4096)):
                raise CommitVerificationError(
                    "cat-file batch-check encontrou objeto inválido")
            sizes[requested_oid] = size
    if set(sizes) != set(unique_oids):
        raise CommitVerificationError(
            "cat-file batch-check perdeu objeto solicitado")
    return sizes


def _git_blob_groups(
    unique_oids: list[str], sizes: Mapping[str, int],
) -> list[list[str]]:
    """Partition blobs so each Git response remains below the hard cap."""
    groups: list[list[str]] = []
    current: list[str] = []
    current_bytes = 0
    for oid in unique_oids:
        estimated = sizes[oid] + len(oid) + len(str(sizes[oid])) + 16
        if current and (
                len(current) >= GIT_BATCH_MAX_OBJECTS or
                current_bytes + estimated > GIT_BATCH_TARGET_BYTES):
            groups.append(current)
            current = []
            current_bytes = 0
        current.append(oid)
        current_bytes += estimated
    if current:
        groups.append(current)
    return groups


def _cat_file_batch(
    root: pathlib.Path, unique_oids: list[str], sizes: Mapping[str, int],
) -> dict[str, bytes]:
    """Read one already-sized blob group and authenticate every delimiter."""
    response = _run_git(
        root, ["cat-file", "--batch"],
        input_payload=b"".join(oid.encode("ascii") + b"\n"
                               for oid in unique_oids),
    ).stdout
    cursor = 0
    blobs: dict[str, bytes] = {}
    for requested_oid in unique_oids:
        newline = response.find(b"\n", cursor)
        if newline < 0:
            raise CommitVerificationError("cat-file batch truncou header")
        header = response[cursor:newline]
        cursor = newline + 1
        try:
            actual_oid, kind, raw_size = header.decode("ascii").split(" ")
            size = int(raw_size)
        except (UnicodeDecodeError, ValueError) as error:
            raise CommitVerificationError(
                "cat-file batch retornou header inválido") from error
        if (actual_oid != requested_oid or kind != "blob" or
                size != sizes.get(requested_oid) or
                cursor + size >= len(response)):
            raise CommitVerificationError(
                "cat-file batch divergiu da closure Git")
        blob = response[cursor:cursor + size]
        cursor += size
        if response[cursor:cursor + 1] != b"\n":
            raise CommitVerificationError(
                "cat-file batch perdeu delimitador")
        cursor += 1
        blobs[requested_oid] = blob
    if cursor != len(response):
        raise CommitVerificationError("cat-file batch devolveu bytes extras")
    return blobs


def _head_v2_intent_locations(
    root: pathlib.Path, expected_head: str,
) -> dict[str, list[tuple[str, int]]]:
    entries = _tree_entries_under(
        root, expected_head, ("data/editorial/v2_pages",))
    noncanonical = [
        item["path"] for item in entries
        if TARGET_REL.fullmatch(item["path"]) is None
    ]
    if noncanonical:
        raise CommitVerificationError(
            "inventário v2 possui path não canônico: " +
            ",".join(noncanonical[:8]))
    if not entries:
        raise CommitVerificationError("HEAD não possui shards v2 finalizados")
    if any(item["mode"] != "100644" for item in entries):
        raise CommitVerificationError("shard v2 em HEAD ganhou modo não canônico")
    entries_by_oid: dict[str, list[dict[str, str]]] = {}
    for item in entries:
        entries_by_oid.setdefault(item["oid"], []).append(item)
    unique_oids = list(entries_by_oid)
    sizes = _git_blob_sizes(root, unique_oids)
    locations: dict[str, list[tuple[str, int]]] = {}
    for group in _git_blob_groups(unique_oids, sizes):
        for oid, payload in _cat_file_batch(root, group, sizes).items():
            for item in entries_by_oid[oid]:
                if (not payload or not payload.endswith(b"\n") or
                        b"\r" in payload or b"\0" in payload):
                    raise CommitVerificationError(
                        "JSONL inválido no inventário HEAD: " + item["path"])
                lines = payload.splitlines()
                if not lines or any(not line for line in lines):
                    raise CommitVerificationError(
                        "linha vazia no inventário HEAD: " + item["path"])
                for line_number, raw in enumerate(lines, 1):
                    intent = _decode_unique_intent(
                        raw, f"{item['path']}@HEAD:{line_number}")
                    locations.setdefault(intent, []).append(
                        (item["path"], line_number))
    return locations


def _build_canonical_id_repair_transaction(
    root: pathlib.Path, target_argument: str,
) -> CanonicalIDRepairTransaction:
    root = root.resolve(strict=True)
    target = pathlib.PurePosixPath(target_argument).as_posix()
    if (target != target_argument or
            TARGET_REL.fullmatch(target) is None or
            any(part in {"", ".", ".."}
                for part in pathlib.PurePosixPath(target).parts)):
        raise CommitVerificationError(
            f"target canonical-id-repair não é canônico: {target_argument!r}")
    expected_head, _, _, _ = _capture_symbolic_head(root)
    object_format = _git_text(root, ["rev-parse", "--show-object-format"])
    old_entry = _head_entries(root, expected_head, [target]).get(target)
    if old_entry is None:
        raise CommitVerificationError(
            "canonical-id-repair não aceita target novo/ausente em HEAD")
    old_mode, old_blob_oid = old_entry
    if old_mode != "100644":
        raise CommitVerificationError(
            "target canonical-id-repair precisa ser blob 100644 em HEAD")
    old_payload = _run_git(
        root, ["cat-file", "blob", old_blob_oid]).stdout
    if _git_blob_oid(old_payload, object_format) != old_blob_oid:
        raise CommitVerificationError(
            "blob antigo divergiu do OID em canonical-id-repair")
    target_path = root.joinpath(*pathlib.PurePosixPath(target).parts)
    new_payload, target_info = _safe_file_payload(target_path)
    if stat.S_IMODE(target_info.st_mode) != 0o644:
        raise CommitVerificationError(
            "target canonical-id-repair precisa ser regular único mode 0644")
    old_intent, new_intent, line_number, line_count = (
        _validate_canonical_id_repair_payloads(
            old_payload, new_payload, target))
    locations = _head_v2_intent_locations(root, expected_head)
    if locations.get(old_intent) != [(target, line_number)]:
        raise CommitVerificationError(
            "intent_id antigo não é globalmente único no HEAD")
    if locations.get(new_intent):
        raise CommitVerificationError(
            "intent_id canônico novo já existe no inventário HEAD")
    folded_locations = _folded_intent_locations(locations, new_intent)
    if folded_locations != [(old_intent, target, line_number)]:
        raise CommitVerificationError(
            "intent_id possui alias NFKD global fora do reparo autorizado")
    new_blob_oid = _git_blob_oid(new_payload, object_format)
    index_entry = _index_entries_for_paths(root, [target]).get(target)
    allowed_index = {
        (old_mode, old_blob_oid, "0"),
        (old_mode, new_blob_oid, "0"),
    }
    if index_entry not in allowed_index:
        raise CommitVerificationError(
            "index do target não representa HEAD nem o reparo exato")
    transition = CanonicalIDRepairTransition(
        expected_head=expected_head,
        target=target,
        old_mode=old_mode,
        old_blob_oid=old_blob_oid,
        new_blob_oid=new_blob_oid,
        old_intent=old_intent,
        new_intent=new_intent,
        line_number=line_number,
        old_sha256=hashlib.sha256(old_payload).hexdigest(),
        new_sha256=hashlib.sha256(new_payload).hexdigest(),
    )
    transaction = CanonicalIDRepairTransaction(
        root=root,
        transition=transition,
        target_payload=new_payload,
        target_identity=_file_identity(target_info),
        index_entry=index_entry,
        line_count=line_count,
    )
    transaction.revalidate()
    return transaction


def _staged_blob(
    root: pathlib.Path, path: str, entry: tuple[str, str, str] | None,
    object_format: str, *, expected_mode: str = "100644",
) -> tuple[dict[str, str], bytes]:
    if entry is None or entry[2] != "0" or entry[0] != expected_mode:
        raise CommitVerificationError(
            "semantic-recut exige blob stage-zero " + expected_mode + ": " +
            path)
    payload = _run_git(root, ["cat-file", "blob", entry[1]]).stdout
    if _git_blob_oid(payload, object_format) != entry[1]:
        raise CommitVerificationError(
            "OID staged diverge dos bytes em semantic-recut: " + path)
    return ({
        "path": path, "sha256": hashlib.sha256(payload).hexdigest(),
        "mode": entry[0], "role": "semantic_recut_staged_closure",
        "git_blob_oid": entry[1],
    }, payload)


def _semantic_jsonl(payload: bytes, label: str) -> list[dict[str, Any]]:
    if (not payload or not payload.endswith(b"\n") or b"\r" in payload or
            b"\0" in payload):
        raise CommitVerificationError("JSONL semantic-recut inválido: " + label)
    return [_decode_json_object(raw, f"{label}:{line}")
            for line, raw in enumerate(payload.splitlines(), 1)]


def _minimal_semantic_portfolio_payload(
    path: str, parent_payload: bytes, staged_payload: bytes,
    requirements: list[Mapping[str, Any]],
) -> bytes:
    parent_lines = parent_payload.splitlines()
    staged_lines = staged_payload.splitlines()
    parent_intents = [_decode_unique_intent(
        raw, f"{path}@parent:{line}")
        for line, raw in enumerate(parent_lines, 1)]
    staged_by_intent: dict[str, bytes] = {}
    for line, raw in enumerate(staged_lines, 1):
        intent = _decode_unique_intent(raw, f"{path}@stage:{line}")
        if intent in staged_by_intent:
            raise CommitVerificationError(
                "portfolio staged duplicou intent: " + intent)
        staged_by_intent[intent] = raw
    replacements: dict[str, bytes] = {}
    for requirement in requirements:
        intent = requirement["intent_id"]
        raw = staged_by_intent.get(intent)
        expected_row_sha = requirement.get("portfolio_record_sha256")
        if (raw is None or not isinstance(expected_row_sha, str) or
                hashlib.sha256(raw).hexdigest() != expected_row_sha):
            raise CommitVerificationError(
                "portfolio staged diverge do row pin do sidecar: " + intent)
        if parent_intents.count(intent) != 1:
            raise CommitVerificationError(
                "portfolio parent não possui owner único: " + intent)
        replacements[intent] = raw
    return b"\n".join(
        replacements.get(intent, raw)
        for intent, raw in zip(parent_intents, parent_lines)) + b"\n"


def _validate_semantic_duplicate_normalization(
    path: str, old_payload: bytes, new_payload: bytes,
    authority: Mapping[str, Any],
) -> None:
    if (hashlib.sha256(old_payload).hexdigest() != authority["old_sha256"] or
            hashlib.sha256(new_payload).hexdigest() != authority["new_sha256"]):
        raise CommitVerificationError(
            "duplicate normalization divergiu do SHA pinado: " + path)
    old_lines, new_lines = old_payload.splitlines(), new_payload.splitlines()
    if (not old_payload.endswith(b"\n") or not new_payload.endswith(b"\n") or
            len(old_lines) != authority["rows"] or
            len(new_lines) != authority["rows"]):
        raise CommitVerificationError(
            "duplicate normalization divergiu na contagem: " + path)
    member = b',"page_type":"verbete"'
    for line, (old, new) in enumerate(zip(old_lines, new_lines), 1):
        try:
            pairs = json.loads(old, object_pairs_hook=lambda value: ("object", value))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise CommitVerificationError(
                f"duplicate normalization parent JSON inválido: {path}:{line}") from error
        if (not isinstance(pairs, tuple) or len(pairs) != 2 or
                pairs[0] != "object" or not isinstance(pairs[1], list)):
            raise CommitVerificationError(
                f"duplicate normalization parent não é objeto: {path}:{line}")
        keys = [pair[0] for pair in pairs[1]
                if isinstance(pair, tuple) and len(pair) == 2]
        page_types = [pair[1] for pair in pairs[1]
                      if isinstance(pair, tuple) and len(pair) == 2 and
                      pair[0] == "page_type"]
        if (len(keys) != len(pairs[1]) or page_types != ["verbete", "verbete"] or
                any(keys.count(key) != (2 if key == "page_type" else 1)
                    for key in set(keys)) or old.count(member) != 2 or
                new != old.replace(member, b"", 1)):
            raise CommitVerificationError(
                f"duplicate normalization alterou bytes extras: {path}:{line}")
        record = _decode_json_object(new, f"{path}:{line}:candidate")
        if record.get("page_type") != "verbete":
            raise CommitVerificationError(
                f"duplicate normalization perdeu page_type: {path}:{line}")
        for flag in ("publication_candidate", "public", "indexable",
                     "publication_allowed", "render_allowed",
                     "sitemap_allowed", "approval"):
            if record.get(flag) is not False:
                raise CommitVerificationError(
                    f"duplicate normalization abriu flag: {path}:{line}:{flag}")
        if record.get("index_policy") != "noindex" or record.get("public_path") != "":
            raise CommitVerificationError(
                f"duplicate normalization abriu index/path: {path}:{line}")


def _build_semantic_recut_transaction(
    root: pathlib.Path,
) -> SemanticRecutCommitTransaction:
    """Derive the complete closure from fixed staged authorities only."""
    root = root.resolve(strict=True)
    expected_head, _, _, _ = _capture_symbolic_head(root)
    object_format = _git_text(root, ["rev-parse", "--show-object-format"])
    staged_paths = _index_changed_paths(root, expected_head, None)
    staged_entries = _index_entries_for_paths(root, staged_paths)

    candidates: dict[str, dict[str, str]] = {}
    payloads: dict[str, bytes] = {}
    fixed_closure_entries = _index_entries_for_paths(
        root, sorted(SEMANTIC_FIXED_CLOSURE))
    for path in sorted(SEMANTIC_FIXED_CLOSURE):
        if path in staged_paths:
            item, payload = _staged_blob(
                root, path, staged_entries.get(path), object_format)
        else:
            # Anchor carried unchanged by a later generation: bind the exact
            # HEAD blob and require the index entry clean for the whole
            # transaction.  Content authority stays with the compiled
            # check-v2-writing-semantic-contract gate, which reconstructs the
            # evidence bytes against the exact contract requirements.  All
            # four anchors take this branch symmetrically; identity is the
            # content bind, never a hand-declared delta obligation.
            head_entry = _head_entries(
                root, expected_head, [path]).get(path)
            index_entry = fixed_closure_entries.get(path)
            if (head_entry is None or head_entry[0] != "100644" or
                    index_entry != (*head_entry, "0")):
                raise CommitVerificationError(
                    "âncora fixa semantic-recut HEAD/index ausente ou "
                    "divergente: " + path)
            payload = _run_git(
                root, ["cat-file", "blob", head_entry[1]]).stdout
            if _git_blob_oid(payload, object_format) != head_entry[1]:
                raise CommitVerificationError(
                    "âncora fixa semantic-recut HEAD perdeu bind: " + path)
            item = {
                "path": path, "sha256": hashlib.sha256(payload).hexdigest(),
                "mode": "100644", "role": "semantic_recut_head_authority",
                "git_blob_oid": head_entry[1],
            }
        candidates[path], payloads[path] = item, payload

    contract = _decode_json_object(
        payloads[SEMANTIC_CONTRACT_REL], SEMANTIC_CONTRACT_REL)
    if set(contract) != {
            "_meta", "requirements", "forward_candidates",
            "adopt_existing_targets", "resolutions"}:
        raise CommitVerificationError("sidecar semantic-recut possui schema aberto")
    meta = contract.get("_meta")
    if (not isinstance(meta, Mapping) or
            meta.get("schema_version") != "v2_writing_semantic_contract_v3" or
            meta.get("index_policy") != "noindex" or
            meta.get("render_allowed") is not False or
            meta.get("sitemap_allowed") is not False or
            meta.get("publication_allowed") is not False):
        raise CommitVerificationError("sidecar semantic-recut abriu estado público")
    requirements = contract.get("requirements")
    if not isinstance(requirements, list) or not requirements:
        raise CommitVerificationError("sidecar semantic-recut não possui requisitos")
    requirement_by_intent: dict[str, Mapping[str, Any]] = {}
    for requirement in requirements:
        if not isinstance(requirement, Mapping):
            raise CommitVerificationError("requisito semantic-recut inválido")
        intent = requirement.get("intent_id")
        if (not isinstance(intent, str) or intent in requirement_by_intent or
                CANONICAL_INTENT_ID.fullmatch(intent) is None):
            raise CommitVerificationError("intent de requisito semantic-recut inválido")
        requirement_by_intent[intent] = requirement
        for key in ("portfolio_rel_path", "target_rel_path",
                    "superseded_target_rel_path"):
            value = requirement.get(key)
            if not isinstance(value, str):
                raise CommitVerificationError(
                    "requisito semantic-recut perdeu path: " + key)

    receipt = _decode_json_object(
        payloads[SEMANTIC_RECEIPT_REL], SEMANTIC_RECEIPT_REL)
    if (receipt.get("schema_version") !=
            "v2_semantic_forward_candidates_receipt_v1" or
            receipt.get("transaction_id") !=
            "v2-semantic-forward-candidates-v3" or
            receipt.get("updated_contract_sha256") != hashlib.sha256(
                payloads[SEMANTIC_CONTRACT_REL]).hexdigest()):
        raise CommitVerificationError("recibo semantic-recut perdeu bind do sidecar")
    receipt_candidates = receipt.get("candidates")
    if not isinstance(receipt_candidates, list) or not receipt_candidates:
        raise CommitVerificationError("recibo semantic-recut não possui candidatos")
    receipt_by_intent: dict[str, Mapping[str, Any]] = {}
    linked: set[str] = set(SEMANTIC_FIXED_CLOSURE)
    linked.update(SEMANTIC_BOOTSTRAP_RUNTIME_MODES)
    linked.update(SEMANTIC_DUPLICATE_NORMALIZATIONS)
    linked.update(SEMANTIC_CANONICAL_ID_NORMALIZATIONS)
    linked.update(SEMANTIC_EXACT_FORWARD_NORMALIZATIONS)
    for requirement in requirements:
        linked.update({
            requirement["portfolio_rel_path"], requirement["target_rel_path"],
            requirement["superseded_target_rel_path"],
        })
    for claim in receipt_candidates:
        if not isinstance(claim, Mapping):
            raise CommitVerificationError("candidato semantic-recut inválido")
        intent = claim.get("intent_id")
        requirement = requirement_by_intent.get(intent)
        if (not isinstance(intent, str) or intent in receipt_by_intent or
                requirement is None or
                claim.get("requirement_sha256") !=
                hashlib.sha256(json.dumps(
                    dict(requirement), ensure_ascii=False, allow_nan=False,
                    sort_keys=True, separators=(",", ":")).encode(
                        "utf-8")).hexdigest()):
            raise CommitVerificationError(
                "candidato semantic-recut não liga requisito exato")
        receipt_by_intent[intent] = claim
        for key in ("current_source_rel_path", "target_rel_path"):
            value = claim.get(key)
            if not isinstance(value, str):
                raise CommitVerificationError(
                    "recibo semantic-recut perdeu path: " + key)
            linked.add(value)

    authority_rows = _semantic_jsonl(
        payloads[SEMANTIC_AUTHORITY_REL], SEMANTIC_AUTHORITY_REL)
    for row in authority_rows:
        for flag in ("approval", "publication_allowed", "render_allowed",
                     "sitemap_allowed", "publicly_indexable"):
            if row.get(flag) is not False:
                raise CommitVerificationError(
                    "autoridade semantic-recut abriu flag pública: " + flag)
        if row.get("index_policy") != "noindex" or row.get("public_path") != "":
            raise CommitVerificationError(
                "autoridade semantic-recut abriu index/path público")

    if not (set(staged_paths) & linked):
        # Zero staged intersection with the whole authenticated semantic
        # closure: the unit either already landed (idempotent no-op, resolved
        # by the caller against the unit ledger) or nothing was ever staged.
        raise SemanticRecutNoStagedDelta(
            "semantic-recut sem delta staged: nenhuma interseção entre o "
            "índice e a closure semântica derivada")

    # Only linked paths that actually differ from HEAD belong to this commit.
    # Other staged work remains untouched for concurrent agents.
    derived = set(SEMANTIC_FIXED_CLOSURE)
    derived.update(SEMANTIC_BOOTSTRAP_RUNTIME_MODES)
    for path in linked:
        if path in SEMANTIC_FIXED_CLOSURE or path in SEMANTIC_BOOTSTRAP_RUNTIME_MODES:
            continue
        if path not in staged_paths:
            continue
        if not (TARGET_REL.fullmatch(path) or PORTFOLIO_REL.fullmatch(path)):
            raise CommitVerificationError(
                "path derivado fora do domínio semantic-recut: " + path)
        derived.add(path)
    if not any(TARGET_REL.fullmatch(path) for path in derived):
        raise CommitVerificationError("semantic-recut não derivou shard de página")
    if not any(PORTFOLIO_REL.fullmatch(path) for path in derived):
        raise CommitVerificationError("semantic-recut não derivou portfolio candidato")
    staged_source_payloads: dict[str, bytes] = {
        path: payloads[path] for path in SEMANTIC_FIXED_CLOSURE}
    current_index_entries = _index_entries_for_paths(root, derived)
    for path, expected_mode in sorted(SEMANTIC_BOOTSTRAP_RUNTIME_MODES.items()):
        if path in staged_paths:
            item, payload = _staged_blob(
                root, path, current_index_entries.get(path), object_format,
                expected_mode=expected_mode)
        else:
            head_entry = _head_entries(root, expected_head, [path]).get(path)
            index_entry = current_index_entries.get(path)
            if (head_entry is None or head_entry[0] != expected_mode or
                    index_entry != (*head_entry, "0")):
                raise CommitVerificationError(
                    "semantic-recut runtime HEAD/index ausente ou divergente: " +
                    path)
            payload = _run_git(
                root, ["cat-file", "blob", head_entry[1]]).stdout
            if _git_blob_oid(payload, object_format) != head_entry[1]:
                raise CommitVerificationError(
                    "semantic-recut runtime HEAD perdeu bind: " + path)
            item = {
                "path": path, "sha256": hashlib.sha256(payload).hexdigest(),
                "mode": expected_mode, "role": "semantic_recut_head_runtime",
                "git_blob_oid": head_entry[1],
            }
        candidates[path], payloads[path] = item, payload
        staged_source_payloads[path] = payload
    for path in sorted(derived - SEMANTIC_FIXED_CLOSURE):
        if path in SEMANTIC_BOOTSTRAP_RUNTIME_MODES:
            continue
        item, payload = _staged_blob(
            root, path, staged_entries.get(path), object_format)
        candidates[path], payloads[path] = item, payload
        staged_source_payloads[path] = payload

    for path, authority in SEMANTIC_DUPLICATE_NORMALIZATIONS.items():
        parent_entry = _head_entries(root, expected_head, [path]).get(path)
        old_payload = _run_git(
            root, ["cat-file", "blob", authority["old_oid"]]).stdout
        if parent_entry == ("100644", authority["new_oid"]):
            # The pinned transition already landed at HEAD (aff5fd7e).  It
            # must not rejoin this commit, the index must stay clean and the
            # committed bytes must still be the exact authenticated
            # normalization.
            if path in staged_paths or path in derived:
                raise CommitVerificationError(
                    "duplicate normalization já pousada não aceita novo "
                    "delta: " + path)
            index_entry = _index_entries_for_paths(root, [path]).get(path)
            if index_entry != (*parent_entry, "0"):
                raise CommitVerificationError(
                    "duplicate normalization pousada perdeu index limpo: " +
                    path)
            landed_payload = _run_git(
                root, ["cat-file", "blob", authority["new_oid"]]).stdout
            _validate_semantic_duplicate_normalization(
                path, old_payload, landed_payload, authority)
            continue
        if path not in derived:
            raise CommitVerificationError(
                "semantic-recut omitiu duplicate normalization fixa: " + path)
        staged_entry = staged_entries.get(path)
        if (parent_entry != ("100644", authority["old_oid"]) or
                staged_entry != ("100644", authority["new_oid"], "0")):
            raise CommitVerificationError(
                "duplicate normalization perdeu parent/candidate OID: " + path)
        _validate_semantic_duplicate_normalization(
            path, old_payload, staged_source_payloads[path], authority)

    for path, authority in SEMANTIC_CANONICAL_ID_NORMALIZATIONS.items():
        parent_entry = _head_entries(root, expected_head, [path]).get(path)
        old_payload = _run_git(
            root, ["cat-file", "blob", authority["old_oid"]]).stdout
        if parent_entry == ("100644", authority["new_oid"]):
            if path in staged_paths or path in derived:
                raise CommitVerificationError(
                    "canonical normalization já pousada não aceita novo "
                    "delta: " + path)
            index_entry = _index_entries_for_paths(root, [path]).get(path)
            if index_entry != (*parent_entry, "0"):
                raise CommitVerificationError(
                    "canonical normalization pousada perdeu index limpo: " +
                    path)
            new_payload = _run_git(
                root, ["cat-file", "blob", authority["new_oid"]]).stdout
        else:
            if path not in derived:
                raise CommitVerificationError(
                    "semantic-recut omitiu canonical normalization fixa: " +
                    path)
            staged_entry = current_index_entries.get(path)
            if (parent_entry != ("100644", authority["old_oid"]) or
                    staged_entry != ("100644", authority["new_oid"], "0")):
                raise CommitVerificationError(
                    "canonical normalization perdeu parent/candidate OID: " +
                    path)
            new_payload = staged_source_payloads[path]
        if (hashlib.sha256(old_payload).hexdigest() != authority["old_sha256"] or
                hashlib.sha256(new_payload).hexdigest() != authority["new_sha256"]):
            raise CommitVerificationError(
                "canonical normalization perdeu SHA: " + path)
        _, _, changed_line, rows = _validate_canonical_id_repair_payloads(
            old_payload, new_payload, path)
        if changed_line != 1 or rows != authority["rows"]:
            raise CommitVerificationError(
                "canonical normalization perdeu linha/quantidade fixa: " + path)

    for path, authority in SEMANTIC_EXACT_FORWARD_NORMALIZATIONS.items():
        parent_entry = _head_entries(root, expected_head, [path]).get(path)
        old_payload = _run_git(
            root, ["cat-file", "blob", authority["old_oid"]]).stdout
        if parent_entry == ("100644", authority["new_oid"]):
            if path in staged_paths or path in derived:
                raise CommitVerificationError(
                    "normalização forward já pousada não aceita novo "
                    "delta: " + path)
            index_entry = _index_entries_for_paths(root, [path]).get(path)
            if index_entry != (*parent_entry, "0"):
                raise CommitVerificationError(
                    "normalização forward pousada perdeu index limpo: " +
                    path)
            new_payload = _run_git(
                root, ["cat-file", "blob", authority["new_oid"]]).stdout
        else:
            if path not in derived:
                raise CommitVerificationError(
                    "semantic-recut omitiu normalização forward fixa: " + path)
            staged_entry = current_index_entries.get(path)
            if (parent_entry != ("100644", authority["old_oid"]) or
                    staged_entry != ("100644", authority["new_oid"], "0")):
                raise CommitVerificationError(
                    "normalização forward perdeu parent/candidate OID: " + path)
            new_payload = staged_source_payloads[path]
        if (hashlib.sha256(old_payload).hexdigest() != authority["old_sha256"] or
                hashlib.sha256(new_payload).hexdigest() != authority["new_sha256"] or
                len(old_payload.splitlines()) != authority["old_rows"] or
                len(new_payload.splitlines()) != authority["new_rows"]):
            raise CommitVerificationError(
                "normalização forward perdeu bytes/quantidade fixa: " + path)

    # A staged portfolio can contain unrelated forward work.  Its source OID
    # is an immutable authority input, but the candidate blob is synthesized
    # from parent + only requirement rows whose exact SHA-256 is pinned by the
    # semantic sidecar.  Thus unrelated rows remain in the worktree after CAS.
    requirements_by_portfolio: dict[str, list[Mapping[str, Any]]] = {}
    for requirement in requirements:
        requirements_by_portfolio.setdefault(
            requirement["portfolio_rel_path"], []).append(requirement)
    for path, bound_requirements in sorted(requirements_by_portfolio.items()):
        if path not in derived:
            continue
        parent_entry = _head_entries(root, expected_head, [path]).get(path)
        if parent_entry is None or parent_entry[0] != "100644":
            raise CommitVerificationError("portfolio parent ausente: " + path)
        parent_payload = _run_git(
            root, ["cat-file", "blob", parent_entry[1]]).stdout
        staged_payload = staged_source_payloads[path]
        minimal_payload = _minimal_semantic_portfolio_payload(
            path, parent_payload, staged_payload, bound_requirements)
        minimal_item = {
            "path": path,
            "sha256": hashlib.sha256(minimal_payload).hexdigest(),
            "mode": "100644",
            "role": "semantic_recut_minimal_portfolio",
            "git_blob_oid": _git_blob_oid(minimal_payload, object_format),
        }
        candidates[path] = minimal_item
        payloads[path] = minimal_payload

    # Candidate-tree membership comes only from the exact staged portfolio
    # blobs when changed, otherwise from the immutable parent blob.
    portfolio_counts: dict[str, int] = {}
    for path in sorted(requirements_by_portfolio):
        if path in payloads:
            portfolio_payload = payloads[path]
        else:
            parent = _head_entries(root, expected_head, [path]).get(path)
            if parent is None or parent[0] != "100644":
                raise CommitVerificationError("portfolio parent ausente: " + path)
            portfolio_payload = _run_git(
                root, ["cat-file", "blob", parent[1]]).stdout
        for record in _semantic_jsonl(portfolio_payload, path):
            intent = record.get("intent_id")
            if isinstance(intent, str):
                portfolio_counts[intent] = portfolio_counts.get(intent, 0) + 1
    for intent in requirement_by_intent:
        if portfolio_counts.get(intent) != 1:
            raise CommitVerificationError(
                "portfolio candidato não possui membership mínima exata: " + intent)

    for path in sorted(item for item in derived if TARGET_REL.fullmatch(item)):
        for line, record in enumerate(_semantic_jsonl(payloads[path], path), 1):
            for flag in ("publication_allowed", "render_allowed",
                         "sitemap_allowed"):
                if flag in record and record[flag] is not False:
                    raise CommitVerificationError(
                        f"flag pública aberta em {path}:{line}: {flag}")
            for flag in ("public", "publication_candidate", "indexable",
                         "approval", "publicly_indexable", "manifest_allowed"):
                if flag in record and record[flag] is not False:
                    raise CommitVerificationError(
                        f"flag pública opcional aberta em {path}:{line}: {flag}")
            if (("index_policy" in record and
                 record["index_policy"] != "noindex") or
                    record.get("public_path", "") != ""):
                raise CommitVerificationError(
                    f"index/path público aberto em {path}:{line}")

    index_path = _main_index_path(root)
    index_info = os.stat(index_path, follow_symlinks=False)
    tracked = {path: current_index_entries.get(path) for path in derived}
    transaction = SemanticRecutCommitTransaction(
        root=root, expected_head=expected_head, object_format=object_format,
        candidates=candidates, payloads=payloads, index_path=index_path,
        index_identity=_file_identity(index_info), index_entries=tracked,
        staged_source_payloads=staged_source_payloads)
    transaction.revalidate()
    return transaction


def _persistent_audit_blob_store(
    repository_root: pathlib.Path,
) -> pathlib.Path | None:
    """Return an optional content-addressed reuse cache for audit-tree blobs.

    Unlike the persistent Go/build and distinctness stores this accelerator is
    *best-effort*: any boundary anomaly returns ``None`` so the audit falls back
    to a full materialize and never aborts a commit that would pass today.  It
    stores immutable Git blobs keyed by OID so the per-commit audit reuses bytes
    that were already materialized instead of decompressing and re-hashing the
    whole stock every commit.  It lives at mode 0o700 owned by the repository
    owner under the closed Git-common-dir boundary — the same trust class as
    ``.git/objects`` (already read by this audit through ``cat-file``) and the
    persistent distinctness store consumed inside ``_audit_candidate_tree``.
    """
    try:
        common_text = _git_text(
            repository_root,
            ["rev-parse", "--path-format=absolute", "--git-common-dir"])
        common = pathlib.Path(common_text)
        if not common.is_absolute():
            return None
        common_info = os.lstat(common)
        root_info = os.stat(repository_root, follow_symlinks=False)
        if (not stat.S_ISDIR(common_info.st_mode) or
                stat.S_ISLNK(common_info.st_mode) or
                common_info.st_uid != root_info.st_uid or
                common_info.st_uid != os.geteuid()):
            return None
        store = common / "codex-private-v2-audit-blobs"
        try:
            os.mkdir(store, 0o700)
            _fsync_directory(common)
        except FileExistsError:
            pass
        store_info = os.lstat(store)
        if (not stat.S_ISDIR(store_info.st_mode) or
                stat.S_ISLNK(store_info.st_mode) or
                store_info.st_uid != common_info.st_uid or
                stat.S_IMODE(store_info.st_mode) != 0o700):
            return None
        return store
    except OSError:
        return None


def _audit_blob_cache_lookup(
    store: pathlib.Path, oid: str,
) -> tuple[bytes, str] | None:
    """Return authenticated ``(content, sha256)`` for a cached Git blob.

    The store is content-addressed by Git blob OID, so the bytes named by an
    OID can only ever be that OID's immutable content: a validated hit lets the
    audit reuse it without decompressing the object or re-hashing it.  Every hit
    is revalidated fail-closed (regular file, owned by euid, mode 0o400, not a
    symlink, digest of canonical shape); any anomaly returns ``None`` so the
    caller re-materializes the blob from Git.
    """
    shard = store / oid[:2]
    content = shard / oid[2:]
    sidecar = shard / (oid[2:] + ".s256")
    try:
        content_payload, content_info = _safe_file_payload(content)
        sidecar_payload, sidecar_info = _safe_file_payload(
            sidecar, max_bytes=128)
    except CommitVerificationError:
        return None
    if (content_info.st_uid != os.geteuid() or
            sidecar_info.st_uid != os.geteuid() or
            stat.S_IMODE(content_info.st_mode) != 0o400 or
            stat.S_IMODE(sidecar_info.st_mode) != 0o400):
        return None
    try:
        digest = sidecar_payload.decode("ascii").strip()
    except UnicodeDecodeError:
        return None
    object_format = "sha1" if len(oid) == 40 else "sha256"
    if (SHA256.fullmatch(digest) is None or
            hashlib.sha256(content_payload).hexdigest() != digest or
            _git_blob_oid(content_payload, object_format) != oid):
        return None
    return content_payload, digest


def _audit_blob_cache_store(
    store: pathlib.Path, oid: str, blob: bytes, digest: str,
    fsync_dirs: set[pathlib.Path],
) -> None:
    """Persist an OID-verified blob and its digest under the closed boundary.

    Best-effort by contract: any failure leaves the audit untouched (the bytes
    were already written to the audit tree before this call) and is swallowed so
    a cache-write hiccup never turns a passing commit into a failure.
    """
    object_format = "sha1" if len(oid) == 40 else "sha256"
    if (hashlib.sha256(blob).hexdigest() != digest or
            _git_blob_oid(blob, object_format) != oid):
        return
    shard = store / oid[:2]
    try:
        os.mkdir(shard, 0o700)
    except FileExistsError:
        pass
    except OSError:
        return
    try:
        shard_info = os.lstat(shard)
    except OSError:
        return
    if (not stat.S_ISDIR(shard_info.st_mode) or
            stat.S_ISLNK(shard_info.st_mode) or
            shard_info.st_uid != os.geteuid() or
            stat.S_IMODE(shard_info.st_mode) != 0o700):
        return
    content = shard / oid[2:]
    sidecar = shard / (oid[2:] + ".s256")
    token = secrets.token_hex(8)
    tmp_content = shard / f".tmp-{oid[2:]}-{os.getpid()}-{token}"
    tmp_sidecar = shard / f".tmp-{oid[2:]}-{os.getpid()}-{token}.s256"
    try:
        if _audit_blob_cache_lookup(store, oid) == (blob, digest):
            return
        _write_exclusive(tmp_content, blob, 0o400)
        _write_exclusive(tmp_sidecar, digest.encode("ascii"), 0o400)
        # Cache entries are acceleration, never authority. Atomic replacement
        # safely self-heals stale bytes, modes, FIFOs, symlinks or hardlinks;
        # readers seeing the two-file transition only get a cache miss because
        # lookup revalidates both SHA-256 and Git blob OID.
        os.replace(tmp_content, content)
        os.replace(tmp_sidecar, sidecar)
        fsync_dirs.add(shard)
    except (OSError, CommitVerificationError):
        return
    finally:
        for temporary in (tmp_content, tmp_sidecar):
            try:
                os.unlink(temporary)
            except OSError:
                pass


def _materialize_git_tree_subset(
    root: pathlib.Path,
    treeish: str,
    roots: tuple[str, ...],
    destination: pathlib.Path,
    blob_store: pathlib.Path | None = None,
) -> tuple[list[dict[str, str]], dict[pathlib.Path, str]]:
    entries = _tree_entries_under(root, treeish, roots)
    if not entries:
        raise CommitVerificationError("closure Git materializada está vazia")
    entries_by_oid: dict[str, list[dict[str, str]]] = {}
    for entry in entries:
        entries_by_oid.setdefault(entry["oid"], []).append(entry)
    unique_oids = list(entries_by_oid)
    bindings: dict[pathlib.Path, str] = {}
    manifest: list[dict[str, str]] = []
    # Content-addressed reuse: immutable Git blobs already materialized under the
    # closed boundary are copied into unique per-audit files instead of being
    # decompressed from Git again.  A hard link is intentionally forbidden here:
    # the audit reader requires ``st_nlink == 1`` so a cache inode can never be
    # mutated through a second pathname while merit is being checked.
    linkable = False
    if blob_store is not None:
        try:
            linkable = (
                os.stat(blob_store).st_dev == os.stat(destination).st_dev)
        except OSError:
            linkable = False
    reused: set[str] = set()
    if linkable:
        for oid in unique_oids:
            group = entries_by_oid[oid]
            if any(item["mode"] != "100644" for item in group):
                continue
            hit = _audit_blob_cache_lookup(blob_store, oid)
            if hit is None:
                continue
            blob, digest = hit
            if (hashlib.sha256(blob).hexdigest() != digest or
                    _git_blob_oid(
                        blob, "sha1" if len(oid) == 40 else "sha256") != oid):
                continue
            placed_paths: list[pathlib.Path] = []
            ok = True
            for entry in group:
                path = destination.joinpath(
                    *pathlib.PurePosixPath(entry["path"]).parts)
                path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                try:
                    _write_exclusive(path, blob, mode=0o400)
                except (OSError, CommitVerificationError):
                    ok = False
                    break
                placed_paths.append(path)
            if not ok:
                for path in placed_paths:
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
                continue
            for entry, path in zip(group, placed_paths):
                bindings[path] = digest
                manifest.append({**entry, "sha256": digest})
            reused.add(oid)
    missing = [oid for oid in unique_oids if oid not in reused]
    if missing:
        sizes = _git_blob_sizes(root, missing)
        fsync_dirs: set[pathlib.Path] = set()
        for group_oids in _git_blob_groups(missing, sizes):
            blobs = _cat_file_batch(root, group_oids, sizes)
            for oid in group_oids:
                blob = blobs[oid]
                expected_oid = _git_blob_oid(
                    blob, "sha1" if len(oid) == 40 else "sha256")
                if expected_oid != oid:
                    raise CommitVerificationError(
                        "blob Git materializado divergiu do OID")
                digest = hashlib.sha256(blob).hexdigest()
                group_entries = entries_by_oid[oid]
                for entry in group_entries:
                    path = destination.joinpath(
                        *pathlib.PurePosixPath(entry["path"]).parts)
                    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                    _write_exclusive(
                        path, blob,
                        mode=0o500 if entry["mode"] == "100755" else 0o400)
                    bindings[path] = digest
                    manifest.append({**entry, "sha256": digest})
                if (linkable and
                        all(item["mode"] == "100644" for item in group_entries)):
                    _audit_blob_cache_store(
                        blob_store, oid, blob, digest, fsync_dirs)
        for directory in fsync_dirs:
            try:
                _fsync_directory(directory)
            except OSError:
                pass
    return sorted(manifest, key=lambda item: item["path"]), bindings


def _overlay_candidate_go_sources(
    epoch: CommitEpoch, destination: pathlib.Path,
    manifest: list[dict[str, str]], bindings: dict[pathlib.Path, str],
) -> list[dict[str, str]]:
    """Overlay authenticated candidate Go blobs on the immutable HEAD tree."""
    by_path = {item["path"]: dict(item) for item in manifest}
    for item in epoch.closure:
        relative = item["path"]
        if not any(
                relative == root or relative.startswith(root.rstrip("/") + "/")
                for root in GO_SOURCE_ROOTS):
            continue
        if item["mode"] not in {"100644", "100755"}:
            raise CommitVerificationError(
                "source Go candidato possui modo inválido: " + relative)
        payload = epoch.closure_payloads[relative]
        if (hashlib.sha256(payload).hexdigest() != item["sha256"] or
                _git_blob_oid(payload, epoch.object_format) !=
                item["git_blob_oid"]):
            raise CommitVerificationError(
                "source Go candidato perdeu bind: " + relative)
        path = destination.joinpath(*pathlib.PurePosixPath(relative).parts)
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if path.exists():
            if path.is_symlink() or not path.is_file():
                raise CommitVerificationError(
                    "source Go candidato colidiu com path inseguro: " + relative)
            path.unlink()
        _write_exclusive(
            path, payload,
            mode=0o500 if item["mode"] == "100755" else 0o400)
        bindings[path] = item["sha256"]
        by_path[relative] = {
            "path": relative, "mode": item["mode"],
            "oid": item["git_blob_oid"], "sha256": item["sha256"],
        }
    return [by_path[path] for path in sorted(by_path)]


def _preflight_uid_cache_and_package_atomic(epoch: CommitEpoch) -> None:
    """Reject authority/cache/package gaps before any compiler is started."""
    try:
        root_info = os.stat(epoch.root, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError("root do preflight desapareceu") from error
    if (not stat.S_ISDIR(root_info.st_mode) or
            root_info.st_uid != os.geteuid()):
        raise CommitVerificationError(
            "preflight UID exige euid proprietário do repositório")

    changed_go = {
        item["path"] for item in epoch.closure
        if item["path"].endswith(".go") and
        (item["path"].startswith("cmd/") or
         item["path"].startswith("internal/"))
    }
    if changed_go:
        package_directories = {
            pathlib.PurePosixPath(path).parent.as_posix()
            for path in changed_go}
        staged = set(_index_changed_paths(
            epoch.root, epoch.expected_head, None))
        omitted_staged = sorted(
            path for path in staged
            if path.endswith(".go") and
            pathlib.PurePosixPath(path).parent.as_posix() in
            package_directories and path not in changed_go)
        if omitted_staged:
            raise CommitVerificationError(
                "closure Go não é package-atomic; staged omitido: " +
                ",".join(omitted_staged))
        untracked_payload = _run_git(
            epoch.root,
            ["ls-files", "--others", "--exclude-standard", "-z", "--",
             *(":(literal)" + path for path in sorted(package_directories))],
        ).stdout
        try:
            untracked = sorted(
                item.decode("utf-8", errors="strict")
                for item in untracked_payload.split(b"\0")
                if item and item.endswith(b".go"))
        except UnicodeDecodeError as error:
            raise CommitVerificationError(
                "preflight package-atomic encontrou path não UTF-8") from error
        if untracked:
            raise CommitVerificationError(
                "closure Go não é package-atomic; source untracked: " +
                ",".join(untracked))
        for item in epoch.closure:
            if item["path"] in changed_go and item["mode"] != "100644":
                raise CommitVerificationError(
                    "closure Go package-atomic ganhou modo executável: " +
                    item["path"])

    # Only the canonical repository compiles Go. Fixtures intentionally use no
    # host toolchain/cache and therefore stop at the ownership/package checks.
    if epoch.root != INSTALL_ROOT:
        return
    try:
        proxy_info = os.lstat(MODULE_PROXY)
        archive_info = os.lstat(GO_ARCHIVE)
    except OSError as error:
        raise CommitVerificationError(
            "preflight cache/toolchain pinado não está disponível") from error
    if (not stat.S_ISDIR(proxy_info.st_mode) or
            stat.S_ISLNK(proxy_info.st_mode) or
            proxy_info.st_uid != os.geteuid() or
            stat.S_IMODE(proxy_info.st_mode) & 0o022):
        raise CommitVerificationError(
            "preflight cache Go possui UID/modo inseguro")
    if (not stat.S_ISREG(archive_info.st_mode) or
            stat.S_ISLNK(archive_info.st_mode) or archive_info.st_nlink != 1 or
            archive_info.st_uid != os.geteuid() or
            stat.S_IMODE(archive_info.st_mode) & 0o022 or
            archive_info.st_size <= 0 or
            archive_info.st_size > 128 * 1024 * 1024):
        raise CommitVerificationError(
            "preflight archive Go possui UID/modo/tamanho inseguro")


def _extract_pinned_go_toolchain(
    workspace: pathlib.Path,
) -> tuple[pathlib.Path, str, str]:
    """Extract the complete official Go distribution into private storage.

    The mutable pre-extracted ``.toolchains`` tree is never build authority.
    Authentication is the pinned official archive digest; extraction rejects
    links, special nodes, duplicate paths and traversal before materializing a
    normalized private GOROOT.
    """
    try:
        archive, archive_info = _safe_file_payload(
            GO_ARCHIVE, max_bytes=128 * 1024 * 1024)
    except CommitVerificationError as error:
        raise CommitVerificationError(
            "arquivo oficial go1.26.4 linux-amd64 ausente; instale em "
            ".toolchains/downloads/go1.26.4.linux-amd64.tar.gz com SHA256 "
            + GO_ARCHIVE_SHA256) from error
    if (not stat.S_ISREG(archive_info.st_mode) or archive_info.st_nlink != 1 or
            stat.S_IMODE(archive_info.st_mode) & 0o022):
        raise CommitVerificationError(
            "arquivo oficial do toolchain Go possui permissões inseguras")
    archive_digest = hashlib.sha256(archive).hexdigest()
    if archive_digest != GO_ARCHIVE_SHA256:
        raise CommitVerificationError(
            "arquivo oficial go1.26.4 linux-amd64 ausente ou diverge do "
            "SHA256 pinado; restaure .toolchains/downloads/"
            "go1.26.4.linux-amd64.tar.gz")

    extraction_root = workspace / "authenticated-go-distribution"
    extraction_root.mkdir(mode=0o700)
    seen: set[str] = set()
    total_size = 0
    try:
        with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as bundle:
            members = bundle.getmembers()
            if not members or len(members) > 30000:
                raise CommitVerificationError(
                    "arquivo oficial Go possui inventário inválido")
            for member in members:
                pure = pathlib.PurePosixPath(member.name)
                canonical = pure.as_posix()
                if (not canonical or canonical in seen or
                        pure.parts[0] != "go" or
                        any(part in {"", ".", ".."} for part in pure.parts) or
                        member.name.startswith("/") or
                        not (member.isdir() or member.isfile()) or
                        member.size < 0 or member.size > 512 * 1024 * 1024):
                    raise CommitVerificationError(
                        f"membro inseguro no arquivo oficial Go: {member.name}")
                seen.add(canonical)
                total_size += member.size
                if total_size > 2 * 1024 * 1024 * 1024:
                    raise CommitVerificationError(
                        "arquivo oficial Go excedeu limite descompactado")
                destination = extraction_root.joinpath(*pure.parts)
                if member.isdir():
                    destination.mkdir(parents=True, exist_ok=False, mode=0o700)
                    continue
                destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                source = bundle.extractfile(member)
                if source is None:
                    raise CommitVerificationError(
                        f"membro regular Go não abriu: {member.name}")
                payload = source.read(member.size + 1)
                if len(payload) != member.size:
                    raise CommitVerificationError(
                        f"membro Go truncado/crescido: {member.name}")
                mode = 0o500 if member.mode & 0o111 else 0o400
                descriptor = os.open(
                    destination,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                    os.O_CLOEXEC | os.O_NOFOLLOW,
                    mode,
                )
                try:
                    view = memoryview(payload)
                    while view:
                        written = os.write(descriptor, view)
                        if written < 1:
                            raise CommitVerificationError(
                                f"extração Go não avançou: {member.name}")
                        view = view[written:]
                finally:
                    os.close(descriptor)
    except (OSError, tarfile.TarError, EOFError) as error:
        raise CommitVerificationError(
            "arquivo oficial Go não pôde ser extraído com segurança") from error

    goroot = extraction_root / "go"
    go_binary = goroot / "bin" / "go"
    go_payload, go_info = _safe_file_payload(
        go_binary, max_bytes=32 * 1024 * 1024)
    if (not go_info.st_mode & stat.S_IXUSR or
            stat.S_IMODE(go_info.st_mode) & 0o022):
        raise CommitVerificationError(
            "arquivo oficial Go não produziu bin/go executável")
    version_payload, _ = _safe_file_payload(
        goroot / "VERSION", max_bytes=4096)
    if version_payload.splitlines()[:1] != [b"go1.26.4"]:
        raise CommitVerificationError(
            "arquivo oficial Go diverge da versão pinada")
    return go_binary, archive_digest, hashlib.sha256(go_payload).hexdigest()


def _minimal_go_environment(
    workspace: pathlib.Path, goroot: pathlib.Path,
    build_cache: pathlib.Path, module_cache: pathlib.Path,
) -> dict[str, str]:
    module_proxy = MODULE_PROXY
    if (not module_proxy.is_dir() or module_proxy.is_symlink() or
            module_proxy.resolve(strict=True) != module_proxy):
        raise CommitVerificationError(
            "proxy local de módulos esperado não está disponível")
    # ``build_cache`` (GOCACHE) and ``module_cache`` (GOMODCACHE) are
    # repository-owned persistent stores under the closed Git-common-dir
    # boundary (see ``_persistent_go_build_caches``): the compilation cache is
    # content-addressed and the module cache is populated only from GOSUM-
    # verified proxy zips, so persisting them across commits reuses byte-
    # identical work without ever becoming build authority.  Only the scratch
    # tmp/gopath stay ephemeral in the per-commit workspace.
    temporary = workspace / "go-tmp"
    gopath = workspace / "gopath"
    for directory in (temporary, gopath):
        directory.mkdir(mode=0o700)
    return {
        "PATH": "/usr/bin:/bin",
        "HOME": "/nonexistent",
        "XDG_CONFIG_HOME": "/nonexistent",
        "LC_ALL": "C",
        "LANG": "C",
        "GOENV": "off",
        "GOTOOLCHAIN": "local",
        "GOWORK": "off",
        "GOFLAGS": "-mod=readonly",
        # Populate a private cache from module zips. Go verifies those zips
        # against the exact expected-HEAD go.sum before compilation; mutable
        # extracted caches never become build authority and /root traversal is
        # not required when the wrapper runs as the repository owner.
        "GOPROXY": module_proxy.as_uri(),
        "GOSUMDB": "off",
        "CGO_ENABLED": "0",
        "GOMAXPROCS": "2",
        "GOROOT": os.fspath(goroot),
        "GOPATH": os.fspath(gopath),
        "GOMODCACHE": os.fspath(module_cache),
        "GOCACHE": os.fspath(build_cache),
        "TMPDIR": os.fspath(temporary),
    }


def _normalize_private_hook_runtime_tools(
    snapshot_root: pathlib.Path, bindings: dict[pathlib.Path, str],
) -> None:
    # Git mode 100755 is source authority, not the execution mode of the
    # private snapshot. Normalize only the authenticated snapshot helpers;
    # tracked source and the manifest keep their original Git mode.
    for helper_name in HOOK_RUNTIME_TOOLS:
        helper = snapshot_root / "tools" / helper_name
        payload, _ = _safe_file_payload(helper, max_bytes=4 * 1024 * 1024)
        digest = hashlib.sha256(payload).hexdigest()
        if bindings.get(helper) != digest:
            raise CommitVerificationError(
                "hook runtime helper perdeu binding antes do chmod: " +
                helper_name)
        os.chmod(helper, 0o500)
        rebound_payload, rebound_info = _safe_file_payload(
            helper, max_bytes=4 * 1024 * 1024)
        if (hashlib.sha256(rebound_payload).hexdigest() != digest or
                stat.S_IMODE(rebound_info.st_mode) != 0o500):
            raise CommitVerificationError(
                "hook runtime helper não fechou modo privado: " + helper_name)
        bindings[helper] = digest


def _compile_tracked_gate_binaries(
    epoch: CommitEpoch,
    snapshot_root: pathlib.Path,
    workspace: pathlib.Path,
) -> tuple[dict[pathlib.Path, str], dict[str, Any]]:
    manifest, bindings = _materialize_git_tree_subset(
        epoch.root, epoch.expected_head, GO_SOURCE_ROOTS, snapshot_root)
    manifest = _overlay_candidate_go_sources(
        epoch, snapshot_root, manifest, bindings)
    present = {item["path"] for item in manifest}
    required = {"go.mod", "go.sum"}
    required.update(
        package.removeprefix("./") + "/main.go"
        for _, package in COMPILED_COMMANDS)
    required.update("tools/" + name for name in HOOK_RUNTIME_TOOLS)
    missing = sorted(required - present)
    if missing:
        raise CommitVerificationError(
            "source closure de HEAD não contém gates: " + ",".join(missing))
    _normalize_private_hook_runtime_tools(snapshot_root, bindings)
    go_binary, archive_digest, go_digest = _extract_pinned_go_toolchain(
        workspace)
    bindings[GO_ARCHIVE] = archive_digest
    extracted_go_root = go_binary.parent.parent
    private_toolchains = snapshot_root / ".toolchains"
    private_go_root = private_toolchains / "go1.26.4"
    private_toolchains.mkdir(mode=0o700)
    try:
        os.rename(extracted_go_root, private_go_root)
    except OSError as error:
        raise CommitVerificationError(
            "GOROOT autenticado não pôde ser promovido ao gate privado") from error
    go_binary = private_go_root / "bin" / "go"
    gofmt_binary = private_go_root / "bin" / "gofmt"
    for target, expected_digest in (
            (go_binary, go_digest), (gofmt_binary, None)):
        payload, info = _safe_file_payload(
            target, max_bytes=128 * 1024 * 1024)
        digest = hashlib.sha256(payload).hexdigest()
        if (expected_digest is not None and digest != expected_digest) or \
                not info.st_mode & stat.S_IXUSR or \
                stat.S_IMODE(info.st_mode) & 0o022:
            raise CommitVerificationError(
                f"binário do GOROOT privado divergiu: {target.name}")
        bindings[target] = digest
    build_cache, module_cache = _persistent_go_build_caches(epoch.root)
    environment = _minimal_go_environment(
        workspace, private_go_root, build_cache, module_cache)
    tools_directory = snapshot_root / "tools"
    for binary_name, package in COMPILED_COMMANDS:
        output = tools_directory / binary_name
        command = [
            os.fspath(go_binary), "build", "-trimpath", "-buildvcs=false",
            # cmd/audit-v2-source-provenance e devcmds-gated desde 0204bb14
            # (fakes fora do binario de producao); o gate privado compila com a
            # tag para continuar exercendo o mesmo codigo do fluxo real.
            "-tags", "devcmds",
            "-o", os.fspath(output), package,
        ]
        try:
            completed = _run_closed_process(
                command, cwd=snapshot_root, environment=environment,
                timeout=HOOK_TIMEOUT_SECONDS)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise CommitVerificationError(
                f"build privado do gate não concluiu: {binary_name}") from error
        if (len(completed.stdout) > MAX_GIT_OUTPUT_BYTES or
                len(completed.stderr) > MAX_GIT_OUTPUT_BYTES or
                completed.returncode != 0):
            normalized = " ".join(completed.stderr.decode(
                "utf-8", errors="replace").split())
            if len(normalized) > 1200:
                normalized = normalized[:500] + " ...TAIL... " + normalized[-650:]
            detail = f"exit={completed.returncode} {normalized}"
            raise CommitVerificationError(
                f"build privado do gate reprovou: {binary_name}: {detail}")
        payload, info = _safe_file_payload(output, max_bytes=64 * 1024 * 1024)
        if not info.st_mode & stat.S_IXUSR:
            raise CommitVerificationError(
                f"build privado não produziu executável: {binary_name}")
        digest = hashlib.sha256(payload).hexdigest()
        os.chmod(output, 0o500)
        bindings[output] = digest
    source_manifest_sha256 = hashlib.sha256(
        _canonical_json(manifest)).hexdigest()
    return bindings, {
        "expected_head": epoch.expected_head,
        "source_files": len(manifest),
        "source_manifest_sha256": source_manifest_sha256,
        "toolchain_archive": os.fspath(GO_ARCHIVE),
        "toolchain_archive_sha256": archive_digest,
        "toolchain_path": os.fspath(go_binary),
        "toolchain_sha256": go_digest,
        "binaries": {
            name: bindings[snapshot_root / "tools" / name]
            for name, _ in COMPILED_COMMANDS
        },
        "hook_runtime_tools": {
            name: bindings[snapshot_root / "tools" / name]
            for name in HOOK_RUNTIME_TOOLS
        },
    }


def _assert_private_v2_gate_capability(snapshot_root: pathlib.Path) -> None:
    """Mirror the hook capability boundary with actionable diagnostics."""
    failures: list[str] = []
    for directory in (snapshot_root, snapshot_root / "tools"):
        try:
            info = os.lstat(directory)
        except OSError as error:
            failures.append(f"directory_missing:{directory.name}:{error.errno}")
            continue
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            failures.append(f"directory_not_private:{directory.name}")
        elif stat.S_IMODE(info.st_mode) & 0o077:
            failures.append(
                f"directory_mode:{directory.name}:"
                f"{stat.S_IMODE(info.st_mode):04o}")
    git_pointer = snapshot_root / ".git"
    try:
        _, pointer_info = _safe_file_payload(git_pointer, max_bytes=4096)
    except CommitVerificationError as error:
        failures.append(f"git_pointer:{error}")
    else:
        if stat.S_IMODE(pointer_info.st_mode) & 0o222:
            failures.append(
                f"git_pointer_mode:{stat.S_IMODE(pointer_info.st_mode):04o}")
    for binary_name, _ in GATE_COMMANDS:
        binary = snapshot_root / "tools" / binary_name
        try:
            payload, info = _safe_file_payload(
                binary, max_bytes=64 * 1024 * 1024)
        except CommitVerificationError as error:
            failures.append(f"checker:{binary_name}:{error}")
            continue
        mode = stat.S_IMODE(info.st_mode)
        if not mode & 0o100 or mode & 0o222:
            failures.append(f"checker_mode:{binary_name}:{mode:04o}")
        if payload[:4] != b"\x7fELF":
            failures.append(f"checker_not_elf:{binary_name}")
    for tool_name in HOOK_RUNTIME_TOOLS:
        tool = snapshot_root / "tools" / tool_name
        try:
            payload, info = _safe_file_payload(tool, max_bytes=4 * 1024 * 1024)
        except CommitVerificationError as error:
            failures.append(f"hook_tool:{tool_name}:{error}")
            continue
        mode = stat.S_IMODE(info.st_mode)
        if not mode & 0o100 or mode & 0o222:
            failures.append(f"hook_tool_mode:{tool_name}:{mode:04o}")
        if not payload.startswith(b"#!"):
            failures.append(f"hook_tool_shebang:{tool_name}")
    if failures:
        raise CommitVerificationError(
            "capability privada v2 inválida: " + ";".join(failures))


def _materialize_gate_snapshot_root(
    epoch: CommitEpoch, workspace: pathlib.Path,
) -> tuple[pathlib.Path, dict[pathlib.Path, str], dict[str, Any]]:
    """Compile exact HEAD sources into a private hook root."""
    snapshot_root = workspace / "gate-root"
    hook_directory = snapshot_root / ".githooks"
    tools_directory = snapshot_root / "tools"
    # ``Path.mkdir(parents=True, mode=...)`` applies ``mode`` only to the
    # leaf.  Creating ``.githooks`` first therefore left ``gate-root`` at the
    # process umask default (normally 0755), while the hook capability below
    # deliberately requires every private directory to reject group/other
    # access.  Create the security boundary explicitly before its children.
    snapshot_root.mkdir(mode=0o700)
    hook_directory.mkdir(mode=0o700)
    tools_directory.mkdir(mode=0o700)
    _write_exclusive(
        hook_directory / "pre-commit", epoch.hook_payload, mode=0o500)
    git_directory = pathlib.Path(_git_text(
        epoch.root, ["rev-parse", "--absolute-git-dir"]))
    if (not git_directory.is_absolute() or
            not git_directory.is_dir() or git_directory.is_symlink()):
        raise CommitVerificationError(
            "gitdir canônico não está disponível para o snapshot")
    _write_exclusive(
        snapshot_root / ".git",
        ("gitdir: " + os.fspath(git_directory) + "\n").encode("utf-8"),
        mode=0o400,
    )
    runtime_bindings: dict[pathlib.Path, str] = {}
    gate_attestation: dict[str, Any] = {"test_fixture": True}
    if epoch.root == INSTALL_ROOT:
        runtime_bindings, gate_attestation = _compile_tracked_gate_binaries(
            epoch, snapshot_root, workspace)
        _assert_private_v2_gate_capability(snapshot_root)
    return snapshot_root, runtime_bindings, gate_attestation


def _validate_private_source_provenance_stdout(
    payload: bytes, expected_relative: str, target_relative: str,
) -> None:
    if (not payload or len(payload) > 64 * 1024 or
            not payload.endswith(b"\n") or b"\r" in payload or
            payload.count(b"\n") != 1):
        raise CommitVerificationError(
            f"checker privado de proveniência perdeu forma: {target_relative}")
    try:
        line = payload[:-1].decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise CommitVerificationError(
            f"checker privado de proveniência não é UTF-8: {target_relative}"
        ) from error
    paths = re.findall(r"(?:^| )path=([^ ]+)(?: |$)", line)
    if (line != line.strip() or len(paths) != 1 or
            paths[0] != expected_relative or
            "check=current-selection-pass" not in line or
            "release_eligible=false" not in line or
            not line.endswith(" publication=false")):
        raise CommitVerificationError(
            f"checker privado de proveniência divergiu: {target_relative}")


def _persistent_private_distinctness_store(
    repository_root: pathlib.Path,
) -> pathlib.Path:
    """Return the repository-owned persistent cache under a closed boundary."""
    common_text = _git_text(
        repository_root,
        ["rev-parse", "--path-format=absolute", "--git-common-dir"])
    common = pathlib.Path(common_text)
    if not common.is_absolute():
        raise CommitVerificationError(
            "git-common-dir do cache distinctness não é absoluto")
    try:
        common_info = os.lstat(common)
        root_info = os.stat(repository_root, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "fronteira Git do cache distinctness não está disponível"
        ) from error
    if (not stat.S_ISDIR(common_info.st_mode) or
            stat.S_ISLNK(common_info.st_mode) or
            common_info.st_uid != root_info.st_uid or
            common_info.st_uid != os.geteuid()):
        raise CommitVerificationError(
            "git-common-dir do cache distinctness perdeu autoridade")
    cache = common / "codex-private-v2-distinctness"
    try:
        os.mkdir(cache, 0o700)
        _fsync_directory(common)
    except FileExistsError:
        pass
    except OSError as error:
        raise CommitVerificationError(
            "cache distinctness persistente não pôde ser criado") from error
    try:
        cache_info = os.lstat(cache)
    except OSError as error:
        raise CommitVerificationError(
            "cache distinctness persistente não pôde ser autenticado"
        ) from error
    if (not stat.S_ISDIR(cache_info.st_mode) or
            stat.S_ISLNK(cache_info.st_mode) or
            cache_info.st_uid != common_info.st_uid or
            stat.S_IMODE(cache_info.st_mode) != 0o700):
        raise CommitVerificationError(
            "cache distinctness persistente tem autoridade ou modo inválido")
    return cache / "store"


def _persistent_go_build_caches(
    repository_root: pathlib.Path,
) -> tuple[pathlib.Path, pathlib.Path]:
    """Return repository-owned persistent Go build and module caches.

    The Go build cache (GOCACHE) is content-addressed — every action is keyed
    by a hash of its source bytes, the pinned compiler identity and the build
    flags — so reusing it across commits only ever replays compilation of
    byte-identical source and never becomes build authority.  ``-trimpath``
    keeps those keys independent of the throwaway per-commit workspace path,
    which is what lets a stable cache hit between commits instead of a cold
    rebuild.  The module cache (GOMODCACHE) is populated exclusively from the
    local GOPROXY zips that Go verifies against the exact expected-HEAD
    ``go.sum`` before use.  Both live under the closed Git-common-dir boundary
    at mode 0o700 owned by the repository owner, so a poisoned world/group-
    writable cache can never be substituted for build authority.
    """
    common_text = _git_text(
        repository_root,
        ["rev-parse", "--path-format=absolute", "--git-common-dir"])
    common = pathlib.Path(common_text)
    if not common.is_absolute():
        raise CommitVerificationError(
            "git-common-dir do cache de build Go não é absoluto")
    try:
        common_info = os.lstat(common)
        root_info = os.stat(repository_root, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "fronteira Git do cache de build Go não está disponível"
        ) from error
    if (not stat.S_ISDIR(common_info.st_mode) or
            stat.S_ISLNK(common_info.st_mode) or
            common_info.st_uid != root_info.st_uid or
            common_info.st_uid != os.geteuid()):
        raise CommitVerificationError(
            "git-common-dir do cache de build Go perdeu autoridade")
    parent = common / "codex-private-go-cache"
    build_cache = parent / "build"
    module_cache = parent / "mod"
    for directory in (parent, build_cache, module_cache):
        try:
            os.mkdir(directory, 0o700)
            _fsync_directory(directory.parent)
        except FileExistsError:
            pass
        except OSError as error:
            raise CommitVerificationError(
                "cache de build Go persistente não pôde ser criado") from error
        try:
            directory_info = os.lstat(directory)
        except OSError as error:
            raise CommitVerificationError(
                "cache de build Go persistente não pôde ser autenticado"
            ) from error
        if (not stat.S_ISDIR(directory_info.st_mode) or
                stat.S_ISLNK(directory_info.st_mode) or
                directory_info.st_uid != common_info.st_uid or
                stat.S_IMODE(directory_info.st_mode) != 0o700):
            raise CommitVerificationError(
                "cache de build Go persistente tem autoridade ou modo inválido")
    return build_cache, module_cache


def _run_private_global_audit(
    audit_root: pathlib.Path,
    snapshot_root: pathlib.Path,
    workspace: pathlib.Path,
    repository_root: pathlib.Path,
) -> tuple[Mapping[str, Any], dict[str, Any], dict[pathlib.Path, str]]:
    """Build and consume one exact private distinctness generation."""
    if _LOADED_AUDITOR is None:
        raise CommitVerificationError("auditor privado não está carregado")
    checker = snapshot_root / "tools" / "check-v2-private-distinctness"
    checker_payload, checker_info = _safe_file_payload(
        checker, max_bytes=128 * 1024 * 1024)
    if not checker_info.st_mode & stat.S_IXUSR:
        raise CommitVerificationError(
            "checker distinctness privado não é executável")
    bindings = {checker: hashlib.sha256(checker_payload).hexdigest()}
    store = _persistent_private_distinctness_store(repository_root)
    environment = _trusted_environment(temporary_directory=workspace)
    batch_command = [
        os.fspath(checker),
        "--root", os.fspath(audit_root),
        "--distinctness-store", os.fspath(store),
    ]
    stdout_limit = int(getattr(
        _LOADED_AUDITOR, "FACTORY_GLOBAL_BATCH_STDOUT_MAX_BYTES",
        512 * 1024 * 1024))
    if not 1024 * 1024 <= stdout_limit <= 512 * 1024 * 1024:
        raise CommitVerificationError(
            "limite do batch distinctness privado é inválido")
    try:
        streamed = _run_closed_process_bounded(
            batch_command, cwd=audit_root, environment=environment,
            timeout=1800, stdout_limit=stdout_limit,
            stderr_limit=8 * 1024 * 1024)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CommitVerificationError(
            "batch distinctness privado não concluiu") from error
    if streamed.returncode != 0:
        detail = " ".join(streamed.stderr.decode(
            "utf-8", errors="replace").split())[:800]
        raise CommitVerificationError(
            "batch distinctness privado reprovou: " + detail)
    try:
        batch, batch_error = _LOADED_AUDITOR.parse_global_distinctness_batch(
            streamed.stdout)
    except Exception as error:
        raise CommitVerificationError(
            "parser fechado do batch distinctness falhou") from error
    if batch_error is not None or not isinstance(batch, Mapping):
        raise CommitVerificationError(
            "batch distinctness privado é inválido: " + str(batch_error))
    try:
        report = _LOADED_AUDITOR.audit_global_with_distinctness_batch(batch)
    except Exception as error:
        raise CommitVerificationError(
            "auditoria global privada falhou: " +
            type(error).__name__) from error
    if not isinstance(report, Mapping) or not isinstance(
            report.get("files"), Mapping):
        raise CommitVerificationError(
            "auditoria global privada não retornou estoque fechado")
    header, footer = batch["header"], batch["footer"]
    if (set(report["files"]) != set(batch["shards"]) or
            report.get("total_pages") != header["stock_pages"] or
            not footer["inventory_complete"] or
            not footer["inventory_stable"] or
            not footer["candidate_routing_complete"] or
            not footer["local_routing_complete"]):
        raise CommitVerificationError(
            "auditoria global privada divergiu do inventário exact")
    attestation = {
        "mode": header["mode"],
        "generation_root": header["generation_root"],
        "stock_root": header["stock_root"],
        "stock_shards": header["stock_shards"],
        "stock_pages": header["stock_pages"],
        "batch_stdout_sha256": hashlib.sha256(
            streamed.stdout).hexdigest(),
        "private_checker_sha256": bindings[checker],
        "inventory_complete": True,
        "inventory_stable": True,
        "candidate_routing_complete": True,
        "local_routing_complete": True,
        "publication_allowed": False,
        "index_policy": "noindex",
    }
    return report, attestation, bindings


def _audit_candidate_tree(
    transaction: Any,
    epoch: CommitEpoch,
    index_file: str,
    workspace: pathlib.Path,
    snapshot_root: pathlib.Path,
) -> tuple[dict[str, Any], dict[pathlib.Path, str]]:
    """Audit merit/provenance from the complete private candidate tree.

    Workflow's ``audit_ok`` remains an input-shape field only.  Authorization
    comes from this fresh pure-Python audit over exact candidate blobs and the
    complete private stock. Review additionally runs the expected-HEAD Go
    provenance checker against the same tree. No worktree checker, factory
    binary or mutable cache is reachable from this authority boundary; the only
    cross-commit reuse is the content-addressed blob store — immutable Git
    objects keyed by OID under the same euid-owned 0700 Git-common-dir boundary
    as ``.git/objects`` (already read here) and the persistent distinctness
    store — which is oid-verified at population and revalidated fail-closed on
    every hit, and never becomes audit authority.
    """
    if transaction.kind not in {
            "mass", "review", "canonical-id-repair", "semantic-recut"}:
        raise CommitVerificationError(
            f"kind sem auditoria privada: {transaction.kind!r}")
    if _LOADED_AUDITOR is None:
        raise CommitVerificationError(
            "auditor independente não foi carregado pela closure Python")
    candidate_tree = _git_text(
        epoch.root, ["write-tree"], index_file=index_file)
    audit_utc_date = time.strftime("%Y-%m-%d", time.gmtime())
    audit_root = workspace / "candidate-audit-root"
    audit_root.mkdir(mode=0o700)
    audit_roots = AUDIT_TREE_ROOTS + (IMOBILIARIO_RULES_REL,)
    manifest, bindings = _materialize_git_tree_subset(
        epoch.root, candidate_tree, audit_roots, audit_root,
        blob_store=_persistent_audit_blob_store(epoch.root))
    manifest_paths = {item["path"] for item in manifest}
    report_files = transaction.report.get("files")
    if not isinstance(report_files, list) or not report_files:
        raise CommitVerificationError(
            "report não possui targets para auditoria privada")
    provenance_checker = snapshot_root / "tools" / "audit-v2-source-provenance"
    if transaction.kind == "review":
        checker_payload, checker_info = _safe_file_payload(
            provenance_checker, max_bytes=64 * 1024 * 1024)
        if not checker_info.st_mode & stat.S_IXUSR:
            raise CommitVerificationError(
                "checker privado de proveniência não é executável")
        bindings[provenance_checker] = hashlib.sha256(
            checker_payload).hexdigest()
    global_report: Mapping[str, Any] | None = None
    distinctness_attestation: dict[str, Any] | None = None
    previous_root = getattr(_LOADED_AUDITOR, "ROOT", None)
    results: list[dict[str, Any]] = []
    try:
        _LOADED_AUDITOR.ROOT = os.fspath(audit_root)
        if epoch.root == INSTALL_ROOT:
            (global_report, distinctness_attestation,
             distinctness_bindings) = _run_private_global_audit(
                audit_root, snapshot_root, workspace, epoch.root)
            bindings.update(distinctness_bindings)
        for item in sorted(report_files, key=lambda value: value.get("file", "")):
            if (not isinstance(item, Mapping) or
                    not isinstance(item.get("file"), str) or
                    TARGET_REL.fullmatch(item["file"]) is None or
                    item["file"] not in manifest_paths or
                    type(item.get("lines")) is not int or
                    item["lines"] < 1):
                raise CommitVerificationError(
                    "target mass não possui escopo/contagem auditável")
            target = audit_root.joinpath(
                *pathlib.PurePosixPath(item["file"]).parts)
            payload, _ = _safe_file_payload(target)
            target_sha = hashlib.sha256(payload).hexdigest()
            if target_sha != item.get("sha256"):
                raise CommitVerificationError(
                    f"snapshot mass divergiu do target: {item['file']}")
            try:
                merit = (
                    global_report["files"].get(item["file"])
                    if global_report is not None else
                    _LOADED_AUDITOR.audit_against_stock_legacy(
                        os.fspath(target), expect_n=item["lines"])
                )
            except Exception as error:
                raise CommitVerificationError(
                    f"auditor independente falhou: {item['file']}: "
                    f"{type(error).__name__}") from error
            if not isinstance(merit, Mapping):
                raise CommitVerificationError(
                    f"auditor independente não retornou objeto: {item['file']}")
            # O contrato do auditor canonico e a autoridade: merit["ok"] ja
            # exclui o defeito informativo "skipped" ("tombstone honesto e
            # valido", audit_v2_pages.py:23860-23862) e a integridade de
            # contagem compara o TOTAL de linhas (defeito "contagem" via
            # expect_n). Re-julgar aqui com active_pages/defects truthy
            # reprovava shard com skip tombstone legitimo.
            total_pages = merit.get("pages")
            if (merit.get("ok") is not True or
                    total_pages != item["lines"]):
                defects_map = merit.get("defects")
                defect_codes = sorted(
                    key for key in defects_map.keys() if key != "skipped") \
                    if isinstance(defects_map, Mapping) else []
                raise CommitVerificationError(
                    f"auditor independente reprovou {item['file']}: " +
                    ",".join(defect_codes[:20] or ["contagem_ou_ok"]))
            results.append({
                "file": item["file"],
                "sha256": target_sha,
                "expected_pages": item["lines"],
                "merit_sha256": hashlib.sha256(
                    _canonical_json(dict(merit))).hexdigest(),
            })
            if transaction.kind == "review":
                evidence = item.get("source_provenance_evidence")
                if (not isinstance(evidence, Mapping) or
                        set(evidence) != {"file", "sha256"} or
                        not isinstance(evidence.get("file"), str) or
                        PROVENANCE_REL.fullmatch(evidence["file"]) is None or
                        not isinstance(evidence.get("sha256"), str) or
                        SHA256.fullmatch(evidence["sha256"]) is None or
                        evidence["file"] not in manifest_paths):
                    raise CommitVerificationError(
                        f"review perdeu sidecar fechado: {item['file']}")
                evidence_path = audit_root.joinpath(
                    *pathlib.PurePosixPath(evidence["file"]).parts)
                evidence_payload, _ = _safe_file_payload(
                    evidence_path, max_bytes=16 * 1024 * 1024)
                if hashlib.sha256(evidence_payload).hexdigest() != evidence[
                        "sha256"]:
                    raise CommitVerificationError(
                        f"sidecar privado divergiu: {item['file']}")
                try:
                    completed = _run_closed_process(
                        [
                            os.fspath(provenance_checker),
                            "--root", os.fspath(audit_root),
                            "--check", "--file", item["file"],
                        ],
                        cwd=audit_root,
                        environment=_trusted_environment(
                            temporary_directory=workspace),
                        timeout=300,
                    )
                except (OSError, subprocess.TimeoutExpired) as error:
                    raise CommitVerificationError(
                        "checker privado de proveniência não concluiu: "
                        f"{item['file']}") from error
                if (len(completed.stdout) > 64 * 1024 or
                        len(completed.stderr) > 64 * 1024 or
                        completed.returncode != 0):
                    detail = " ".join(completed.stderr.decode(
                        "utf-8", errors="replace").split())[:500]
                    raise CommitVerificationError(
                        "checker privado de proveniência reprovou "
                        f"{item['file']}: rc={completed.returncode} {detail}")
                _validate_private_source_provenance_stdout(
                    completed.stdout, evidence["file"], item["file"])
                results[-1]["source_provenance"] = {
                    "evidence_file": evidence["file"],
                    "evidence_sha256": evidence["sha256"],
                    "checker_stdout_sha256": hashlib.sha256(
                        completed.stdout).hexdigest(),
                    "verdict": "current-selection-pass",
                }
    finally:
        _LOADED_AUDITOR.ROOT = previous_root
    if time.strftime("%Y-%m-%d", time.gmtime()) != audit_utc_date:
        raise CommitVerificationError(
            "data UTC mudou durante auditoria privada; refaça a transação")
    helper_projection = [
        {"path": os.fspath(path), "sha256": digest}
        for path, digest in sorted(
            _LOADED_HELPER_BINDINGS.items(), key=lambda item: os.fspath(item[0]))
    ]
    attestation = {
        "schema": (
            "v2_" + transaction.kind.replace("-", "_") +
            "_private_candidate_audit_v1"),
        "candidate_tree": candidate_tree,
        "stock_manifest_sha256": hashlib.sha256(
            _canonical_json(manifest)).hexdigest(),
        "auditor_closure_sha256": hashlib.sha256(
            _canonical_json(helper_projection)).hexdigest(),
        "targets": results,
        "private_distinctness": distinctness_attestation,
        "source_provenance_utc_date": audit_utc_date,
        "audit_ok": True,
        "factory_cache_used": False,
        "publication_allowed": False,
        "index_policy": "noindex",
    }
    attestation["attestation_sha256"] = hashlib.sha256(
        _canonical_json(attestation)).hexdigest()
    return attestation, bindings


def _authenticated_owner_go_home(
    repository_root: pathlib.Path,
) -> pathlib.Path:
    """Return the authenticated repository owner's home for Go cache reuse.

    The private pre-commit snapshot deliberately builds its environment from
    scratch (never inheriting the caller's ``HOME``/env), which is what keeps a
    committer from substituting a Go toolchain wrapper, ``GOFLAGS`` or
    ``GOENV``.  But the compile-closure gate still needs a *writable* Go build
    cache and — to stay offline under the 120s gate timeout — a fully warmed,
    already-extracted module cache: a cold ``GOMODCACHE`` extracts every module
    zip and blows past the timeout, and ``HOME=/nonexistent`` makes even
    ``GOCACHE`` unwritable (``mkdir /nonexistent/.cache/go-build`` denied).

    The one Go cache tree on this host that is both complete and warm is the
    repository owner's own ``~/go/pkg/mod`` / ``~/.cache/go-build``; the module
    proxy (``MODULE_PROXY``) already trusts that same owner tree.  We resolve it
    by *authentication*, not inheritance: the owner is the uid that owns the
    authenticated repository root, it must equal the effective uid running the
    gate, and the home is read from the system passwd database (not ``$HOME``).
    ``env -i`` in the hook still strips GOFLAGS/GOENV/toolchain overrides, and
    ``trusted_git`` keeps forcing ``HOME=/`` for every Git call, so this only
    ever feeds the deterministic Go cache paths.
    """
    try:
        root_info = os.stat(repository_root, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "raiz do repositório do cache Go não está disponível") from error
    owner_uid = root_info.st_uid
    if (not stat.S_ISDIR(root_info.st_mode) or
            stat.S_ISLNK(root_info.st_mode) or
            owner_uid != os.geteuid() or owner_uid == 0):
        raise CommitVerificationError(
            "raiz do repositório perdeu autoridade do dono para cache Go")
    try:
        home = pathlib.Path(pwd.getpwuid(owner_uid).pw_dir)
    except (KeyError, OSError) as error:
        raise CommitVerificationError(
            "dono autenticado do repositório não tem home para cache Go"
        ) from error
    if not home.is_absolute() or os.fspath(home) in ("/", "/nonexistent"):
        raise CommitVerificationError(
            "home do dono para cache Go não é um diretório próprio absoluto")
    try:
        home_info = os.stat(home, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "home do dono para cache Go não está disponível") from error
    if (not stat.S_ISDIR(home_info.st_mode) or
            stat.S_ISLNK(home_info.st_mode) or
            home_info.st_uid != owner_uid or
            stat.S_IMODE(home_info.st_mode) & 0o022):
        raise CommitVerificationError(
            "home do dono para cache Go tem autoridade ou modo inválido")
    return home


def _run_pre_commit_snapshot(
    snapshot_root: pathlib.Path, hook_payload: bytes, index_file: str,
    goroot: pathlib.Path | None = None,
    go_cache_home: pathlib.Path | None = None,
) -> None:
    """Run exact hook bytes with an immutable private snapshot as ``$0``."""
    _trusted_system_executable(SHELL_BIN)
    try:
        script = hook_payload.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise CommitVerificationError("snapshot pre-commit não é UTF-8") from error
    command = [
        os.fspath(SHELL_BIN), "-c", script,
        os.fspath(snapshot_root / ".githooks" / "pre-commit"),
    ]
    try:
        hook_temporary = snapshot_root.parent / "hook-tmp"
        hook_temporary.mkdir(mode=0o700)
        environment = _trusted_environment(
            index_file=index_file,
            temporary_directory=hook_temporary)
        if go_cache_home is not None:
            # Only the Go compile-closure path consumes this HOME (the hook's
            # ``trusted_nice`` derives GOCACHE/GOMODCACHE/GOPATH from it); every
            # Git call in the hook keeps ``HOME=/`` via ``trusted_git``. Feeding
            # the authenticated owner home reuses the one warm, offline-complete
            # module cache so the gate compiles within its timeout instead of
            # failing on an unwritable ``/nonexistent/.cache/go-build``.
            environment["HOME"] = os.fspath(go_cache_home)
        if goroot is not None:
            resolved_goroot = goroot.resolve(strict=True)
            expected_goroot = (
                snapshot_root / ".toolchains" / "go1.26.4").resolve(strict=True)
            if (not resolved_goroot.is_dir() or resolved_goroot.is_symlink() or
                    resolved_goroot != expected_goroot):
                raise CommitVerificationError(
                    "GOROOT privado não pertence ao workspace autenticado")
            environment["GOROOT"] = os.fspath(resolved_goroot)
        completed = _run_closed_process(
            command, cwd=snapshot_root,
            environment=environment,
            timeout=HOOK_TIMEOUT_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CommitVerificationError(
            f"snapshot pre-commit não concluiu: {type(error).__name__}") from error
    if (len(completed.stdout) > MAX_GIT_OUTPUT_BYTES or
            len(completed.stderr) > MAX_GIT_OUTPUT_BYTES):
        raise CommitVerificationError("snapshot pre-commit excedeu saída")
    if completed.returncode != 0:
        stderr_detail = " ".join(completed.stderr.decode(
            "utf-8", errors="replace").split())
        stdout_detail = " ".join(completed.stdout.decode(
            "utf-8", errors="replace").split())
        detail = " | ".join(
            part for part in (
                f"stderr={stderr_detail}" if stderr_detail else "",
                f"stdout={stdout_detail}" if stdout_detail else "",
            ) if part)[:1200]
        if not detail:
            detail = "sem saída diagnóstica"
        raise CommitVerificationError(
            f"snapshot pre-commit reprovou rc={completed.returncode}: {detail}")


def _create_commit_object(
    epoch: CommitEpoch, index_file: str, message: str,
) -> tuple[str, str]:
    tree = _git_text(
        epoch.root, ["write-tree"], index_file=index_file)
    if HEX_OBJECT.fullmatch(tree) is None:
        raise CommitVerificationError("write-tree não retornou OID canônico")
    commit = _git_text(
        epoch.root,
        ["commit-tree", tree, "-p", epoch.expected_head],
        input_payload=message.encode("utf-8") + b"\n",
        commit_identity=True,
    )
    expected_length = 40 if epoch.object_format == "sha1" else 64
    if len(commit) != expected_length or HEX_OBJECT.fullmatch(commit) is None:
        raise CommitVerificationError("commit-tree não retornou OID canônico")
    _verify_commit_object(epoch, commit, tree, message)
    return commit, tree


def _verify_commit_object(
    epoch: CommitEpoch, commit: str, tree: str, message: str,
) -> None:
    payload = _run_git(epoch.root, ["cat-file", "commit", commit]).stdout
    try:
        header, committed_message = payload.split(b"\n\n", 1)
        lines = header.decode("utf-8", errors="strict").splitlines()
    except (ValueError, UnicodeDecodeError) as error:
        raise CommitVerificationError("objeto commit não é canônico") from error
    expected_prefixes = ("tree ", "parent ", "author ", "committer ")
    if (len(lines) != 4 or
            tuple(line.split(" ", 1)[0] + " " for line in lines) !=
            expected_prefixes or
            lines[0] != "tree " + tree or
            lines[1] != "parent " + epoch.expected_head or
            committed_message != message.encode("utf-8") + b"\n"):
        raise CommitVerificationError(
            "objeto commit diverge de tree/parent/mensagem fechados")
    identity = re.escape(f"{AUTHOR_NAME} <{AUTHOR_EMAIL}>")
    identity_pattern = re.compile(
        rf"^(?:author|committer) {identity} [0-9]+ [+-][0-9]{{4}}$")
    if (identity_pattern.fullmatch(lines[2]) is None or
            identity_pattern.fullmatch(lines[3]) is None):
        raise CommitVerificationError(
            "objeto commit perdeu identidade explícita")
    changed = _run_git(
        epoch.root,
        ["diff-tree", "--no-commit-id", "--name-only", "-r", "-z", commit],
    ).stdout
    try:
        changed_paths = [part.decode("utf-8", errors="strict")
                         for part in changed.split(b"\0") if part]
    except UnicodeDecodeError as error:
        raise CommitVerificationError("commit possui path não UTF-8") from error
    expected_paths = sorted(item["path"] for item in epoch.closure)
    if sorted(changed_paths) != expected_paths:
        raise CommitVerificationError(
            "objeto commit incluiu/omitiu path fora da closure")
    entries = _head_entries(epoch.root, commit, expected_paths)
    for item in epoch.closure:
        if entries.get(item["path"]) != (
                item["mode"], item["git_blob_oid"]):
            raise CommitVerificationError(
                f"objeto commit diverge no blob: {item['path']}")


def _revalidate_before_cas(
    transaction: Any,
    epoch: CommitEpoch,
    runtime_bindings: Mapping[pathlib.Path, str],
) -> None:
    transaction.revalidate()
    for path, expected_digest in sorted(
            epoch.dependency_bindings.items(), key=lambda item: os.fspath(item[0])):
        payload, _ = _safe_file_payload(path)
        if hashlib.sha256(payload).hexdigest() != expected_digest:
            raise CommitVerificationError(
                f"dependência mudou entre gate e CAS: {path}")
    for item in epoch.closure:
        if transaction.kind != "semantic-recut":
            payload, info = _safe_file_payload(epoch.root / item["path"])
            if (hashlib.sha256(payload).hexdigest() != item["sha256"] or
                    _worktree_mode(info) != item["mode"]):
                raise CommitVerificationError(
                    f"target mudou entre gate e CAS: {item['path']}")
    for path, expected_digest in sorted(
            runtime_bindings.items(), key=lambda item: os.fspath(item[0])):
        payload, _ = _safe_file_payload(path)
        if hashlib.sha256(payload).hexdigest() != expected_digest:
            raise CommitVerificationError(
                f"executável Go mudou entre snapshot e CAS: {path}")


def _current_expected_ref_oid(epoch: CommitEpoch) -> str | None:
    completed = _run_git(
        epoch.root,
        ["rev-parse", "--verify", epoch.expected_ref + "^{commit}"],
        check=False)
    if completed.returncode != 0:
        return None
    try:
        oid = completed.stdout.decode("ascii", errors="strict").strip()
    except UnicodeDecodeError:
        return None
    expected_length = 40 if epoch.object_format == "sha1" else 64
    if len(oid) != expected_length or HEX_OBJECT.fullmatch(oid) is None:
        return None
    return oid


def _assert_expected_ref_unchanged(
    epoch: CommitEpoch, phase: str,
) -> None:
    """Abort expensive work as soon as its captured commit epoch is stale."""
    if _current_expected_ref_oid(epoch) != epoch.expected_head:
        raise CommitBusy("branch avançou " + phase)
    head_payload, _ = _safe_file_payload(epoch.head_path, max_bytes=4096)
    if head_payload != epoch.head_payload:
        raise CommitBusy("HEAD foi retargetado " + phase)


def _update_ref_cas(epoch: CommitEpoch, commit: str) -> None:
    """Prepare an exact-ref CAS and resolve a lost response from live ref state."""
    _trusted_system_executable(GIT_BIN)
    command = [
        os.fspath(GIT_BIN), "-C", os.fspath(epoch.root),
        "--no-replace-objects", "-c", "core.fsmonitor=false", "-c",
        "core.untrackedCache=false", "-c", "core.hooksPath=/dev/null",
        "-c", "commit.gpgSign=false", "-c",
        "safe.directory=" + os.fspath(epoch.root),
        "update-ref", "--stdin", "-m",
        "v2 verified workflow plumbing commit",
    ]
    try:
        process = subprocess.Popen(
            command, cwd=epoch.root, env=_trusted_environment(),
            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, bufsize=0, start_new_session=True)
    except OSError as error:
        raise CommitVerificationError(
            "transação update-ref não pôde iniciar") from error
    assert process.stdin is not None
    assert process.stdout is not None
    prepared = False
    commit_sent = False
    applied_response = False
    failure: CommitBusy | None = None
    try:
        prefix = (
            "start\n" +
            f"update {epoch.expected_ref} {commit} {epoch.expected_head}\n" +
            "prepare\n"
        ).encode("ascii")
        process.stdin.write(prefix)
        process.stdin.flush()
        expected_responses = (b"start: ok\n", b"prepare: ok\n")
        for expected in expected_responses:
            ready, _, _ = select.select(
                [process.stdout], [], [], 120)
            if not ready:
                raise CommitBusy(
                    "transação update-ref excedeu timeout antes do CAS")
            line = process.stdout.readline()
            if line != expected:
                failure = CommitBusy(
                    "CAS da branch capturada perdeu a corrida; objeto "
                    "dangling seguro=" + commit)
                break
        if failure is not None:
            returncode = process.poll()
            if returncode is None:
                try:
                    process.communicate(input=b"abort\n", timeout=120)
                except (OSError, subprocess.TimeoutExpired):
                    _kill_process_group(process)
            returncode = process.returncode
        else:
            prepared = True
            current_payload, _ = _safe_file_payload(
                epoch.head_path, max_bytes=4096)
            if current_payload != epoch.head_payload:
                try:
                    process.communicate(input=b"abort\n", timeout=120)
                except (OSError, subprocess.TimeoutExpired):
                    _kill_process_group(process)
                failure = CommitBusy(
                    "HEAD foi retargetado; branch capturada não será promovida")
            else:
                commit_sent = True
                stdout, stderr = process.communicate(
                    input=b"commit\n", timeout=120)
                if (process.returncode == 0 and stdout == b"commit: ok\n" and
                        len(stderr) <= MAX_GIT_OUTPUT_BYTES):
                    applied_response = True
                else:
                    detail = " ".join(stderr.decode(
                        "utf-8", errors="replace").split())[:800]
                    failure = CommitBusy(
                        "CAS da branch capturada não confirmou resultado; "
                        "objeto=" + commit +
                        (" detalhe=" + detail if detail else ""),
                        cas_may_have_applied=True)
    except (OSError, subprocess.TimeoutExpired) as error:
        _kill_process_group(process)
        failure = CommitBusy(
            "transação update-ref perdeu resposta; objeto=" + commit +
            " causa=" + type(error).__name__,
            cas_may_have_applied=commit_sent)
    finally:
        if process.poll() is None:
            try:
                if prepared and not process.stdin.closed:
                    process.stdin.write(b"abort\n")
                    process.stdin.flush()
            except (OSError, ValueError):
                pass
            try:
                process.stdin.close()
            except (OSError, ValueError):
                pass
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                _kill_process_group(process)
        for stream in (process.stdin, process.stdout, process.stderr):
            try:
                stream.close()
            except (OSError, ValueError):
                pass
    if applied_response:
        return
    current = _current_expected_ref_oid(epoch)
    if current == commit:
        # The ref is the durable source of truth when update-ref committed but
        # its final response was lost.  The caller still owns index.lock and can
        # finish the matching index transaction safely.
        return
    if current == epoch.expected_head and failure is not None:
        raise failure
    raise CommitBusy(
        "CAS não aplicou o commit e a branch saiu do epoch; objeto dangling=" +
        commit + " ref_atual=" + (current or "ausente"),
        cas_may_have_applied=(
            failure.cas_may_have_applied if failure is not None else False))


def _canonical_repair_receipt_digest(
    epoch: CommitEpoch, commit: str, item: Mapping[str, str],
    transition: CanonicalIDRepairTransition,
) -> str:
    digest = hashlib.sha256()
    digest.update(b"v2-canonical-id-repair-receipt-v1\0")
    for value in (
            epoch.expected_head, commit, transition.target,
            transition.old_mode, transition.old_blob_oid,
            item["mode"], item["git_blob_oid"],
            transition.old_intent, transition.new_intent,
            str(transition.line_number)):
        digest.update(value.encode("utf-8") + b"\0")
    return digest.hexdigest()


def _is_semantic_recovery_closure(paths: set[str]) -> bool:
    """Classify a recovered commit by its product domain, not anchor churn.

    Fixed semantic anchors can already exist unchanged in a later generation,
    so requiring every anchor in the delta makes a legitimate post-CAS
    recovery fall through to the mass guard. A semantic recut always changes
    at least one page and one candidate portfolio, and every other changed path
    belongs to the fixed/runtime semantic closure.
    """
    if (not any(TARGET_REL.fullmatch(path) for path in paths) or
            not any(PORTFOLIO_REL.fullmatch(path) for path in paths)):
        return False
    return all(
        path in SEMANTIC_FIXED_CLOSURE or
        path in SEMANTIC_BOOTSTRAP_RUNTIME_MODES or
        TARGET_REL.fullmatch(path) is not None or
        PORTFOLIO_REL.fullmatch(path) is not None
        for path in paths
    )


def _recovery_guard_transaction(
    epoch: CommitEpoch, commit: str,
) -> Any:
    """Reconstruct only the guard mode after a durable-CAS process crash.

    The prepared-index recovery does not authorize a new ref: the exact commit
    is already the durable branch tip and the owned index.lock identifies its
    candidate tree.  It nevertheless reruns the finalized guard before index
    promotion.  An exact mechanical transition can be reconstructed entirely
    from parent/candidate blobs; every other prior workflow closure uses the
    common mass/review membership guard.
    """
    changed = [
        item for item in epoch.closure
        if TARGET_REL.fullmatch(item["path"]) is not None
    ]
    if _is_semantic_recovery_closure(
            {item["path"] for item in epoch.closure}):
        # This does not authorize a new commit.  Recovery is reachable only
        # after the exact candidate is already HEAD and can merely reconcile
        # the retained index.lock; the guard binds that live candidate OID.
        return types.SimpleNamespace(kind="semantic-recut")
    if len(changed) == 1:
        item = changed[0]
        old_entry = _head_entries(
            epoch.root, epoch.expected_head, [item["path"]]).get(item["path"])
        try:
            if old_entry is None or old_entry[0] != "100644":
                raise CommitVerificationError("repair recovery sem parent blob")
            old_payload = _run_git(
                epoch.root, ["cat-file", "blob", old_entry[1]]).stdout
            new_payload = _run_git(
                epoch.root, ["cat-file", "blob", item["git_blob_oid"]]).stdout
            old_intent, new_intent, line_number, _ = (
                _validate_canonical_id_repair_payloads(
                    old_payload, new_payload, item["path"]))
            locations = _head_v2_intent_locations(
                epoch.root, epoch.expected_head)
            if (locations.get(old_intent) != [(item["path"], line_number)] or
                    locations.get(new_intent)):
                raise CommitVerificationError(
                    "repair recovery perdeu unicidade global")
            if _folded_intent_locations(locations, new_intent) != [(
                    old_intent, item["path"], line_number)]:
                raise CommitVerificationError(
                    "repair recovery encontrou alias NFKD global")
        except CommitVerificationError:
            pass
        else:
            transition = CanonicalIDRepairTransition(
                expected_head=epoch.expected_head,
                target=item["path"],
                old_mode=old_entry[0],
                old_blob_oid=old_entry[1],
                new_blob_oid=item["git_blob_oid"],
                old_intent=old_intent,
                new_intent=new_intent,
                line_number=line_number,
                old_sha256=hashlib.sha256(old_payload).hexdigest(),
                new_sha256=hashlib.sha256(new_payload).hexdigest(),
            )
            return types.SimpleNamespace(
                kind="canonical-id-repair", transition=transition)
    return types.SimpleNamespace(kind="mass")


def _run_finalized_commit_guard(
    transaction: Any | None, epoch: CommitEpoch, commit: str,
    workspace: pathlib.Path,
) -> None:
    """Recheck the closure with the exact expected-HEAD guard implementation.

    The mutable worktree copy is deliberately outside this authority boundary:
    a dirty or replaced checker must neither authorize nor veto the captured
    transaction epoch.
    """
    changed = [
        item for item in epoch.closure
        if TARGET_REL.fullmatch(item["path"]) is not None
    ]
    if not changed:
        return
    recovery = transaction is None
    if transaction is None:
        transaction = _recovery_guard_transaction(epoch, commit)
    guard_root = workspace / "finalized-guard-root"
    guard_root.mkdir(mode=0o700)
    manifest, _ = _materialize_git_tree_subset(
        epoch.root, epoch.expected_head, (FINALIZED_COMMIT_GUARD_REL,),
        guard_root)
    if (len(manifest) != 1 or
            manifest[0]["path"] != FINALIZED_COMMIT_GUARD_REL or
            manifest[0]["mode"] != "100755"):
        raise CommitVerificationError(
            "checker finalized commit não é executável em expected HEAD")
    guard_copy = guard_root / FINALIZED_COMMIT_GUARD_REL
    environment = _trusted_environment(temporary_directory=workspace)
    environment.update({
        "WIKI_V2_AUTHENTICATED_COMMIT_OID": commit,
        "WIKI_V2_AUTHENTICATED_OLD_OID": epoch.expected_head,
        "WIKI_V2_AUTHENTICATED_CLOSURE_KIND": transaction.kind,
    })
    if recovery:
        # After a durable CAS the commit and the byte-exact prepared index are
        # authoritative.  Concurrent forward edits in the worktree must not
        # make that index.lock permanently unrecoverable.  The guard accepts
        # this relaxation only while the exact candidate is the live HEAD.
        environment["WIKI_V2_AUTHENTICATED_RECOVERY_OID"] = commit
    if transaction.kind == "canonical-id-repair":
        transition = getattr(transaction, "transition", None)
        if (not isinstance(transition, CanonicalIDRepairTransition) or
                len(changed) != 1 or
                changed[0]["path"] != transition.target or
                changed[0]["mode"] != "100644" or
                changed[0]["git_blob_oid"] != transition.new_blob_oid or
                epoch.expected_head != transition.expected_head):
            raise CommitVerificationError(
                "closure canonical-id-repair perdeu transição fechada")
        environment["WIKI_V2_AUTHENTICATED_REPAIR_SHA256"] = (
            _canonical_repair_receipt_digest(
                epoch, commit, changed[0], transition))
    elif transaction.kind == "semantic-recut":
        receipt = hashlib.sha256()
        receipt.update(b"v2-semantic-recut-commit-receipt-v1\0")
        receipt.update(epoch.expected_head.encode("ascii") + b"\0" +
                       commit.encode("ascii") + b"\0")
        for item in sorted(epoch.closure, key=lambda value: value["path"]):
            receipt.update(
                item["path"].encode("utf-8") + b"\0" +
                item["mode"].encode("ascii") + b"\0" +
                item["git_blob_oid"].encode("ascii") + b"\n")
        environment["WIKI_V2_AUTHENTICATED_SEMANTIC_RECUT_SHA256"] = (
            receipt.hexdigest())
    else:
        receipt = hashlib.sha256()
        receipt.update(b"v2-finalized-reference-receipt-v1\0")
        receipt.update(
            epoch.expected_head.encode("ascii") + b"\0" +
            commit.encode("ascii") + b"\0")
        for item in sorted(changed, key=lambda value: value["path"]):
            receipt.update(
                item["path"].encode("utf-8") + b"\0" +
                item["mode"].encode("ascii") + b"\0" +
                item["git_blob_oid"].encode("ascii") + b"\n")
        environment["WIKI_V2_AUTHENTICATED_CLOSURE_SHA256"] = (
            receipt.hexdigest())
    completed = _run_closed_process(
        [os.fspath(PYTHON_BIN), "-I", os.fspath(guard_copy),
         "--root", os.fspath(epoch.root),
         "--old", epoch.expected_head, "--new", commit],
        cwd=epoch.root, environment=environment, timeout=180)
    if completed.returncode != 0:
        detail = " ".join(completed.stderr.decode(
            "utf-8", errors="replace").split())[:1200]
        raise CommitVerificationError(
            f"checker finalized commit reprovou rc={completed.returncode}: {detail}")


def _copy_fd(
    source: int, target: int, *, max_bytes: int = MAX_INDEX_BYTES,
) -> int:
    total = 0
    while True:
        chunk = os.read(source, 1024 * 1024)
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            raise CommitVerificationError("índice excede limite transacional")
        view = memoryview(chunk)
        while view:
            written = os.write(target, view)
            if written < 1:
                raise OSError("cópia do índice não avançou")
            view = view[written:]
    return total


def _main_index_path(root: pathlib.Path) -> pathlib.Path:
    raw = _git_text(root, ["rev-parse", "--git-path", "index"])
    path = pathlib.Path(raw)
    if not path.is_absolute():
        path = root / path
    parent = path.parent.resolve(strict=True)
    candidate = parent / path.name
    if path.name != "index" or candidate.is_symlink():
        raise CommitVerificationError("path do índice principal não é seguro")
    return candidate


def _prepared_closure_digest(epoch: CommitEpoch) -> str:
    projection = [{
        "path": item["path"],
        "mode": item["mode"],
        "git_blob_oid": item["git_blob_oid"],
        "sha256": item["sha256"],
    } for item in sorted(epoch.closure, key=lambda value: value["path"])]
    return hashlib.sha256(_canonical_json(projection)).hexdigest()


def _descriptor_content_identity(
    info: os.stat_result, *, max_bytes: int = MAX_INDEX_BYTES,
) -> tuple[int, int, int, int, int]:
    if (not stat.S_ISREG(info.st_mode) or info.st_size < 0 or
            info.st_size > max_bytes):
        raise CommitVerificationError("inode preparado excedeu limite")
    return (
        info.st_dev, info.st_ino, info.st_size,
        info.st_mtime_ns, info.st_ctime_ns,
    )


def _stream_descriptor_digest(
    descriptor: int, *, max_bytes: int = MAX_INDEX_BYTES,
) -> tuple[int, int, int, int, int, str]:
    """Hash one bounded descriptor with constant-size resident buffers."""
    before = os.fstat(descriptor)
    identity = _descriptor_content_identity(before, max_bytes=max_bytes)
    digest = hashlib.sha256()
    offset = 0
    while offset < before.st_size:
        chunk = os.pread(
            descriptor, min(1024 * 1024, before.st_size - offset), offset)
        if not chunk:
            raise CommitVerificationError("inode preparado ficou truncado")
        digest.update(chunk)
        offset += len(chunk)
    after_identity = _descriptor_content_identity(
        os.fstat(descriptor), max_bytes=max_bytes)
    if after_identity != identity:
        raise CommitBusy("inode preparado mudou durante hashing")
    return (*identity, digest.hexdigest())


def _prepared_descriptor_digest(
    prepared: PreparedMainIndex,
) -> tuple[int, int, int, int, int, str]:
    """Fsync, revalidate identity, and reuse only its authenticated digest."""
    os.fsync(prepared.descriptor)
    info = os.fstat(prepared.descriptor)
    identity = _descriptor_content_identity(info)
    if (info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600):
        raise CommitVerificationError(
            "descritor prepared index perdeu UID/modo privado")
    cached = prepared.descriptor_identity_digest
    if cached is not None and cached[:5] == identity:
        return cached
    observed = _stream_descriptor_digest(prepared.descriptor)
    prepared.descriptor_identity_digest = observed
    return observed


def _prepared_index_record(
    prepared: PreparedMainIndex, phase: str,
) -> dict[str, Any]:
    if phase not in PREPARED_INDEX_PHASES:
        raise CommitVerificationError("fase de prepared index inválida")
    (inode_dev, inode_ino, index_size, index_mtime_ns,
     index_ctime_ns, index_sha256) = _prepared_descriptor_digest(prepared)
    record: dict[str, Any] = {
        "schema": PREPARED_INDEX_SCHEMA,
        "kind": prepared.kind,
        "fingerprint": prepared.fingerprint,
        "run_id": prepared.run_id,
        "owner_pid": prepared.owner_pid,
        "owner_start_ticks": prepared.owner_start_ticks,
        "started_unix_ns": prepared.started_unix_ns,
        "expected_ref": prepared.expected_ref,
        "expected_head": prepared.expected_head,
        "candidate": prepared.candidate,
        "object_format": prepared.object_format,
        "closure_digest": prepared.closure_digest,
        "nonce_name": prepared.nonce_path.name,
        "inode_dev": inode_dev,
        "inode_ino": inode_ino,
        "index_size": index_size,
        "index_mtime_ns": index_mtime_ns,
        "index_ctime_ns": index_ctime_ns,
        "index_sha256": index_sha256,
        "phase": phase,
    }
    record["record_sha256"] = hashlib.sha256(
        _canonical_json(record)).hexdigest()
    return record


def _validate_prepared_index_record(
    record: Mapping[str, Any], *, sidecar_path: pathlib.Path,
) -> dict[str, Any]:
    legacy_expected = {
        "schema", "kind", "fingerprint", "run_id", "owner_pid",
        "owner_start_ticks", "started_unix_ns", "expected_ref",
        "expected_head", "candidate", "object_format", "closure_digest",
        "nonce_name", "inode_dev", "inode_ino", "index_size",
        "index_sha256", "phase", "record_sha256",
    }
    identity_fields = {"index_mtime_ns", "index_ctime_ns"}
    expected = legacy_expected | identity_fields
    object_format = record.get("object_format")
    oid_length = 40 if object_format == "sha1" else 64
    nonce_name = record.get("nonce_name")
    if (frozenset(record) not in {
            frozenset(expected), frozenset(legacy_expected)} or
            record.get("schema") != PREPARED_INDEX_SCHEMA or
            record.get("kind") not in {
                "mass", "review", "canonical-id-repair", "semantic-recut"} or
            not isinstance(record.get("fingerprint"), str) or
            SHA256.fullmatch(record["fingerprint"]) is None or
            not isinstance(record.get("run_id"), str) or
            SINGLEFLIGHT_RUN_ID.fullmatch(record["run_id"]) is None or
            not isinstance(record.get("owner_pid"), int) or
            record["owner_pid"] <= 0 or
            not isinstance(record.get("owner_start_ticks"), int) or
            record["owner_start_ticks"] <= 0 or
            not isinstance(record.get("started_unix_ns"), int) or
            record["started_unix_ns"] <= 0 or
            not isinstance(record.get("expected_ref"), str) or
            not record["expected_ref"].startswith("refs/") or
            "\n" in record["expected_ref"] or
            object_format not in {"sha1", "sha256"} or
            not isinstance(record.get("expected_head"), str) or
            len(record["expected_head"]) != oid_length or
            HEX_OBJECT.fullmatch(record["expected_head"]) is None or
            not isinstance(record.get("candidate"), str) or
            len(record["candidate"]) != oid_length or
            HEX_OBJECT.fullmatch(record["candidate"]) is None or
            not isinstance(record.get("closure_digest"), str) or
            SHA256.fullmatch(record["closure_digest"]) is None or
            not isinstance(nonce_name, str) or
            PREPARED_INDEX_NAME.fullmatch(nonce_name) is None or
            not sidecar_path.name == nonce_name + ".json" or
            not isinstance(record.get("inode_dev"), int) or
            record["inode_dev"] < 0 or
            not isinstance(record.get("inode_ino"), int) or
            record["inode_ino"] <= 0 or
            not isinstance(record.get("index_size"), int) or
            not 0 <= record["index_size"] <= MAX_INDEX_BYTES or
            ("index_mtime_ns" in record and
             (not isinstance(record["index_mtime_ns"], int) or
              record["index_mtime_ns"] < 0)) or
            ("index_ctime_ns" in record and
             (not isinstance(record["index_ctime_ns"], int) or
              record["index_ctime_ns"] < 0)) or
            not isinstance(record.get("index_sha256"), str) or
            SHA256.fullmatch(record["index_sha256"]) is None or
            record.get("phase") not in PREPARED_INDEX_PHASES or
            not isinstance(record.get("record_sha256"), str) or
            SHA256.fullmatch(record["record_sha256"]) is None):
        raise CommitVerificationError(
            "sidecar de prepared index possui schema inválido")
    projection = dict(record)
    claimed = projection.pop("record_sha256")
    if hashlib.sha256(_canonical_json(projection)).hexdigest() != claimed:
        raise CommitVerificationError("sidecar de prepared index perdeu SHA")
    return dict(record)


def _read_prepared_index_artifact(
    sidecar_path: pathlib.Path,
) -> PreparedIndexArtifact:
    record = _read_control_json(
        sidecar_path, max_bytes=PREPARED_INDEX_SIDECAR_MAX_BYTES)
    if record is None:
        raise CommitVerificationError("sidecar de prepared index desapareceu")
    validated = _validate_prepared_index_record(
        record, sidecar_path=sidecar_path)
    nonce_path = sidecar_path.parent / validated["nonce_name"]
    try:
        info = os.stat(nonce_path, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "nonce de prepared index desapareceu") from error
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink not in {1, 2} or
            (info.st_dev, info.st_ino) !=
            (validated["inode_dev"], validated["inode_ino"])):
        raise CommitVerificationError(
            "nonce de prepared index perdeu inode/UID/modo")
    return PreparedIndexArtifact(validated, nonce_path, sidecar_path)


def _prepared_index_artifacts(root: pathlib.Path) -> list[PreparedIndexArtifact]:
    parent = _main_index_path(root).parent
    artifacts: list[PreparedIndexArtifact] = []
    try:
        entries = list(os.scandir(parent))
    except OSError as error:
        raise CommitVerificationError(
            "diretório Git não pôde enumerar prepared index") from error
    if len(entries) > 100000:
        raise CommitVerificationError(
            "diretório Git excedeu enumeração bounded")
    for entry in entries:
        if (not entry.name.endswith(".json") or
                PREPARED_INDEX_NAME.fullmatch(entry.name[:-5]) is None):
            continue
        artifacts.append(_read_prepared_index_artifact(parent / entry.name))
    return artifacts


def _write_prepared_index_phase(
    prepared: PreparedMainIndex, phase: str,
) -> None:
    payload = _canonical_json(_prepared_index_record(prepared, phase))
    _atomic_control_write(
        prepared.sidecar_path, payload,
        max_bytes=PREPARED_INDEX_SIDECAR_MAX_BYTES)
    prepared.sidecar_durable = True
    prepared.phase = phase


def _prepared_index_boundary(
    prepared: PreparedMainIndex, boundary: str,
) -> None:
    """Observable no-op used by focused crash-boundary tests."""
    del prepared, boundary


def _prepared_recovery_boundary(
    artifact: PreparedIndexArtifact, boundary: str,
) -> None:
    """Observable no-op used by focused recovery crash tests."""
    del artifact, boundary


def _artifact_for_inode(
    root: pathlib.Path, info: os.stat_result,
) -> PreparedIndexArtifact:
    matches = [
        artifact for artifact in _prepared_index_artifacts(root)
        if (artifact.record["inode_dev"], artifact.record["inode_ino"]) ==
        (info.st_dev, info.st_ino)
    ]
    if len(matches) != 1:
        raise CommitVerificationError(
            "index preparado não possui sidecar/inode único")
    return matches[0]


FOREIGN_INDEX_LOCK_MESSAGE = (
    "index.lock pertence a transação Git alheia — retry")


def _foreign_index_lock_contention(
    root: pathlib.Path, lock_info: os.stat_result,
    artifacts: list[PreparedIndexArtifact] | None = None,
) -> bool:
    """Se o ``index.lock`` vivo é de uma transação Git ALHEIA, não nossa.

    O lock preparado por este processo é sempre o hardlink do nonce
    (``st_nlink == 2``) e algum sidecar reivindica o inode.  Um lock com um
    único link e sem sidecar correspondente é o ``git commit``/hook/sessão de
    outra transação: contenção transitória (BUSY, exit 75), que o agendador
    re-tenta — jamais defeito determinístico do candidato.

    Adulteração do NOSSO artefato não passa por aqui e continua fail-closed:
    ``nlink == 2`` sem sidecar cai fora já no primeiro teste, e sidecar com
    schema/SHA quebrado faz a enumeração levantar ``CommitVerificationError``.
    """
    if lock_info.st_nlink != 1:
        return False
    if artifacts is None:
        artifacts = _prepared_index_artifacts(root)
    return not any(
        (artifact.record["inode_dev"], artifact.record["inode_ino"]) ==
        (lock_info.st_dev, lock_info.st_ino)
        for artifact in artifacts)


def _open_prepared_index_lock(root: pathlib.Path) -> tuple[int, pathlib.Path]:
    index_path = _main_index_path(root)
    lock_path = index_path.with_name(index_path.name + ".lock")
    try:
        descriptor = os.open(
            lock_path, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError as error:
        raise CommitVerificationError(
            "index.lock preparado não existe para recovery") from error
    except OSError as error:
        raise CommitVerificationError(
            "index.lock preparado é inseguro para recovery") from error
    try:
        info = os.fstat(descriptor)
        path_info = os.stat(lock_path, follow_symlinks=False)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 2 or
                stat.S_IMODE(info.st_mode) != 0o600 or
                info.st_uid != os.geteuid() or
                path_info.st_uid != os.geteuid() or
                stat.S_IMODE(path_info.st_mode) != 0o600 or
                (info.st_dev, info.st_ino) !=
                (path_info.st_dev, path_info.st_ino)):
            if (stat.S_ISREG(info.st_mode) and
                    _foreign_index_lock_contention(root, info)):
                # Entrada de recovery encontrando o lock de OUTRA transação
                # Git: nada aqui é desvinculado, e a recusa é transitória.
                raise CommitBusy(FOREIGN_INDEX_LOCK_MESSAGE)
            raise CommitVerificationError(
                "index.lock recovery não é regular/privado/canônico")
        artifact = _artifact_for_inode(root, info)
        nonce_info = os.stat(artifact.nonce_path, follow_symlinks=False)
        if ((nonce_info.st_dev, nonce_info.st_ino) !=
                (info.st_dev, info.st_ino) or nonce_info.st_nlink != 2):
            raise CommitVerificationError(
                "index.lock recovery perdeu hardlink nonce autenticado")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise CommitBusy(
                "index.lock recovery pertence a outra transação") from error
        locked = os.fstat(descriptor)
        locked_path = os.stat(lock_path, follow_symlinks=False)
        if ((locked.st_dev, locked.st_ino, locked.st_nlink,
             stat.S_IMODE(locked.st_mode)) !=
                (locked_path.st_dev, locked_path.st_ino,
                locked_path.st_nlink, stat.S_IMODE(locked_path.st_mode)) or
                locked.st_nlink != 2 or
                stat.S_IMODE(locked.st_mode) != 0o600 or
                locked.st_uid != os.geteuid() or
                locked_path.st_uid != os.geteuid()):
            raise CommitVerificationError(
                "index.lock recovery perdeu identidade após flock")
        return descriptor, lock_path
    except BaseException:
        os.close(descriptor)
        raise


def _recovery_commit_epoch(
    root: pathlib.Path,
    current_commit: str,
    expected_ref: str,
    head_path: pathlib.Path,
    head_payload: bytes,
    object_format: str,
) -> tuple[CommitEpoch, str, str]:
    payload = _run_git(root, ["cat-file", "commit", current_commit]).stdout
    try:
        header, raw_message = payload.split(b"\n\n", 1)
        lines = header.decode("utf-8", errors="strict").splitlines()
        message = raw_message.decode("utf-8", errors="strict")
    except (ValueError, UnicodeDecodeError) as error:
        raise CommitVerificationError(
            "commit atual não é candidato recovery canônico") from error
    if (len(lines) != 4 or
            tuple(line.split(" ", 1)[0] + " " for line in lines) !=
            ("tree ", "parent ", "author ", "committer ") or
            not message.endswith("\n") or "\n" in message[:-1]):
        raise CommitVerificationError(
            "commit recovery não possui tree/pai/identidade/mensagem fechados")
    tree = lines[0][len("tree "):]
    parent = lines[1][len("parent "):]
    expected_length = 40 if object_format == "sha1" else 64
    if (len(tree) != expected_length or len(parent) != expected_length or
            HEX_OBJECT.fullmatch(tree) is None or
            HEX_OBJECT.fullmatch(parent) is None):
        raise CommitVerificationError(
            "commit recovery perdeu OID de tree/pai")
    closed_message = _validate_message(message[:-1])

    changed_payload = _run_git(
        root,
        ["diff-tree", "--no-commit-id", "--name-only", "-r", "-z",
         current_commit],
    ).stdout
    try:
        changed_paths = [
            item.decode("utf-8", errors="strict")
            for item in changed_payload.split(b"\0") if item
        ]
    except UnicodeDecodeError as error:
        raise CommitVerificationError(
            "commit recovery possui path não UTF-8") from error
    changed_set = set(changed_paths)
    semantic_recovery = _is_semantic_recovery_closure(changed_set)
    legacy_recovery = all(
        TARGET_REL.fullmatch(path) is not None or
        RAW_RECOVERY_REL.fullmatch(path) is not None or
        PROVENANCE_REL.fullmatch(path) is not None
        for path in changed_paths)
    if (not changed_paths or len(changed_paths) != len(changed_set) or
            not (semantic_recovery or legacy_recovery)):
        raise CommitVerificationError(
            "commit recovery possui closure vazia ou path não autorizado")
    entries = _head_entries(root, current_commit, changed_paths)
    if set(entries) != set(changed_paths):
        raise CommitVerificationError(
            "commit recovery removeu ou perdeu blob da closure")
    closure: list[dict[str, str]] = []
    closure_payloads: dict[str, bytes] = {}
    for path in sorted(changed_paths):
        mode, oid = entries[path]
        expected_mode = (
            SEMANTIC_BOOTSTRAP_RUNTIME_MODES.get(path, "100644")
            if semantic_recovery else "100644")
        if mode != expected_mode:
            raise CommitVerificationError(
                "commit recovery possui mode inválido: " + path)
        blob = _run_git(root, ["cat-file", "blob", oid]).stdout
        if _git_blob_oid(blob, object_format) != oid:
            raise CommitVerificationError(
                "commit recovery possui blob inconsistente: " + path)
        digest = hashlib.sha256(blob).hexdigest()
        closure.append({
            "path": path,
            "sha256": digest,
            "mode": mode,
            "role": "recovered_authenticated_closure",
            "git_blob_oid": oid,
        })
        closure_payloads[path] = blob
    epoch = CommitEpoch(
        root=root,
        expected_head=parent,
        expected_ref=expected_ref,
        head_path=head_path,
        head_payload=head_payload,
        object_format=object_format,
        closure=tuple(closure),
        closure_payloads=closure_payloads,
        dependencies=(),
        dependency_bindings={},
        main_index_targets_before={},
        hook_payload=b"",
    )
    _verify_commit_object(epoch, current_commit, tree, closed_message)
    return epoch, tree, closed_message


def _prepared_terminal_authority(
    root: pathlib.Path, artifact: PreparedIndexArtifact, *,
    create_dead_owner_terminal: bool,
) -> dict[str, Any]:
    record = artifact.record
    if _pid_generation_alive(
            record["owner_pid"], record["owner_start_ticks"]):
        raise CommitBusy("prepared index ainda pertence a owner vivo")
    directory = _singleflight_directory(root)
    active_path = directory / "active.json"
    matching_active: dict[str, Any] | None = None
    active_raw = _read_control_json(
        active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    if active_raw is not None:
        active = _validate_active_record(active_raw)
        if (active["fingerprint"], active["run_id"]) == (
                record["fingerprint"], record["run_id"]):
            matching_active = active
            if (active["pid"] != record["owner_pid"] or
                    active["start_ticks"] != record["owner_start_ticks"] or
                    active["started_unix_ns"] != record["started_unix_ns"]):
                raise CommitVerificationError(
                    "sidecar diverge do owner singleflight")
            _raise_if_orphan_child_alive(active)
            if _pid_generation_alive(active["pid"], active["start_ticks"]):
                raise CommitBusy("owner singleflight ainda está vivo")
            terminal = _read_singleflight_terminal(
                directory, record["fingerprint"])
            if (terminal is None or
                    terminal["run_id"] != record["run_id"]):
                if not create_dead_owner_terminal:
                    raise CommitBusy(
                        "prepared index ainda não possui terminal correspondente")
                terminal = _dead_owner_terminal(
                    directory, active,
                    "owner morreu com prepared index recuperável",
                    ledger_root=root)
                matching_active = None
        # An unrelated current generation may exist only when the caller
        # already owns producer.lock. It cannot authenticate this artifact.
    terminal = _read_singleflight_terminal(
        directory, record["fingerprint"])
    if (terminal is None or terminal["run_id"] != record["run_id"] or
            terminal["pid"] != record["owner_pid"] or
            terminal["start_ticks"] != record["owner_start_ticks"] or
            terminal["started_unix_ns"] != record["started_unix_ns"]):
        raise CommitVerificationError(
            "prepared index não possui terminal singleflight correspondente")
    if matching_active is not None:
        visible = _read_control_json(
            active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        if visible != matching_active:
            raise CommitVerificationError(
                "active singleflight mudou durante recovery")
        _unlink_control(
            active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    return terminal


def _validate_prepared_inode(
    artifact: PreparedIndexArtifact, descriptor: int, *,
    require_record_hash: bool, allow_transition_ctime: bool = False,
) -> tuple[int, int, int, int, int]:
    info = os.fstat(descriptor)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink not in {1, 2} or
            (info.st_dev, info.st_ino) !=
            (artifact.record["inode_dev"], artifact.record["inode_ino"])):
        raise CommitVerificationError(
            "descritor prepared index perdeu inode/UID/modo")
    identity = _descriptor_content_identity(info)
    has_times = (
        "index_mtime_ns" in artifact.record and
        "index_ctime_ns" in artifact.record)
    if not has_times and not allow_transition_ctime:
        raise CommitVerificationError(
            "sidecar legado não autentica mtime/ctime do prepared index")
    if require_record_hash:
        observed = _stream_descriptor_digest(descriptor)
        if has_times:
            record_identity = (
                artifact.record["inode_dev"], artifact.record["inode_ino"],
                artifact.record["index_size"],
                artifact.record["index_mtime_ns"],
                artifact.record["index_ctime_ns"],
            )
            identity_matches = (
                observed[:4] == record_identity[:4]
                if allow_transition_ctime else
                observed[:5] == record_identity)
        else:
            identity_matches = observed[:3] == (
                artifact.record["inode_dev"], artifact.record["inode_ino"],
                artifact.record["index_size"],
            )
        if (not identity_matches or
                observed[5] != artifact.record["index_sha256"]):
            raise CommitVerificationError(
                "prepared index diverge da identidade/hash autenticada")
    elif has_times:
        recorded = (
            artifact.record["inode_dev"], artifact.record["inode_ino"],
            artifact.record["index_size"],
            artifact.record["index_mtime_ns"],
            artifact.record["index_ctime_ns"],
        )
        if (identity[:4] != recorded[:4] if allow_transition_ctime
                else identity != recorded):
            raise CommitVerificationError(
                "prepared index diverge da identidade autenticada")
    return identity


def _copy_descriptor_to_exclusive(
    descriptor: int, destination: pathlib.Path,
    *, max_bytes: int = MAX_INDEX_BYTES,
) -> tuple[int, int, int, int, int, str]:
    """Stream one stable descriptor into a private file without materializing."""
    before = os.fstat(descriptor)
    identity = _descriptor_content_identity(before, max_bytes=max_bytes)
    target = os.open(
        destination,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
    digest = hashlib.sha256()
    try:
        offset = 0
        while offset < before.st_size:
            chunk = os.pread(
                descriptor, min(1024 * 1024, before.st_size - offset), offset)
            if not chunk:
                raise CommitVerificationError(
                    "inode preparado ficou truncado durante cópia")
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(target, view)
                if written < 1:
                    raise OSError("cópia streaming do índice não avançou")
                view = view[written:]
            offset += len(chunk)
        os.fsync(target)
    finally:
        os.close(target)
    after_identity = _descriptor_content_identity(
        os.fstat(descriptor), max_bytes=max_bytes)
    if after_identity != identity:
        raise CommitBusy("índice fonte mudou durante cópia streaming")
    return (*identity, digest.hexdigest())


def _prepared_path_matches_inode(
    path: pathlib.Path, artifact: PreparedIndexArtifact, *, nlink: int,
) -> bool:
    try:
        info = os.stat(path, follow_symlinks=False)
    except FileNotFoundError:
        return False
    except OSError as error:
        raise CommitVerificationError(
            "path prepared index não pôde ser autenticado") from error
    return (
        stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and
        stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == nlink and
        (info.st_dev, info.st_ino) ==
        (artifact.record["inode_dev"], artifact.record["inode_ino"])
    )


def _remove_prepared_artifact(
    artifact: PreparedIndexArtifact, *, lock_path: pathlib.Path | None,
) -> None:
    """Remove only authenticated names; the main index is never unlinked."""
    parent = artifact.sidecar_path.parent
    if lock_path is not None and lock_path.exists():
        if not _prepared_path_matches_inode(lock_path, artifact, nlink=2):
            raise CommitVerificationError(
                "recusa unlink de index.lock sem inode autenticado")
        os.unlink(lock_path)
        _fsync_directory(parent)
    # Re-read the sidecar before removing it. A same-UID replacement cannot
    # redirect cleanup to a foreign inode because nonce_name/inode are closed.
    current = _read_prepared_index_artifact(artifact.sidecar_path)
    if current.record != artifact.record:
        raise CommitVerificationError(
            "sidecar mudou antes da limpeza autenticada")
    nonce_info = os.stat(current.nonce_path, follow_symlinks=False)
    if ((nonce_info.st_dev, nonce_info.st_ino) !=
            (artifact.record["inode_dev"], artifact.record["inode_ino"]) or
            nonce_info.st_nlink not in {1, 2}):
        raise CommitVerificationError("nonce mudou antes da limpeza")
    if nonce_info.st_nlink == 2:
        index_path = parent / "index"
        if not _prepared_path_matches_inode(index_path, artifact, nlink=2):
            raise CommitVerificationError(
                "segundo link de nonce não é o índice principal")
    _unlink_control(
        artifact.sidecar_path, max_bytes=PREPARED_INDEX_SIDECAR_MAX_BYTES)
    os.unlink(artifact.nonce_path)
    _fsync_directory(parent)


def _cleanup_promoted_prepared_index(
    lease: SingleFlightLease, terminal: Mapping[str, Any],
) -> None:
    """Best-effort nonce cleanup only after a durable success terminal."""
    if (terminal.get("state") != "success" or
            lease.prepared_sidecar_path is None or
            lease.prepared_nonce_path is None):
        return
    try:
        artifact = _read_prepared_index_artifact(
            lease.prepared_sidecar_path)
        record = artifact.record
        if ((record["fingerprint"], record["run_id"]) !=
                (lease.fingerprint, lease.run_id) or
                record["phase"] != "promoted"):
            return
        index_path = artifact.sidecar_path.parent / "index"
        lock_path = index_path.with_name(index_path.name + ".lock")
        if lock_path.exists() or not _prepared_path_matches_inode(
                index_path, artifact, nlink=2):
            return
        descriptor = os.open(
            artifact.nonce_path,
            os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            _validate_prepared_inode(
                artifact, descriptor, require_record_hash=True)
            _remove_prepared_artifact(artifact, lock_path=None)
        finally:
            os.close(descriptor)
    except (OSError, CommitVerificationError):
        # HEAD and the success terminal are already durable. Leaving the
        # authenticated nonce/sidecar is safer than rewriting success.
        return


def _rewrite_promoted_prepared_artifact(
    artifact: PreparedIndexArtifact, descriptor: int,
    exact_index_path: pathlib.Path,
) -> PreparedIndexArtifact:
    """Refresh only rename ctime after exact path, content and phase proof."""
    record = dict(artifact.record)
    expected_path = artifact.sidecar_path.parent / "index"
    if (exact_index_path != expected_path or
            record["phase"] not in {"cas", "ref_applied", "promoted"} or
            "index_mtime_ns" not in record or
            "index_ctime_ns" not in record):
        raise CommitVerificationError(
            "refresh promoted exige path/fase/identidade exatos")
    observed = _stream_descriptor_digest(descriptor)
    descriptor_info = os.fstat(descriptor)
    try:
        path_info = os.stat(exact_index_path, follow_symlinks=False)
    except OSError as error:
        raise CommitVerificationError(
            "índice promovido não pôde ser autenticado") from error
    recorded = (
        record["inode_dev"], record["inode_ino"], record["index_size"],
        record["index_mtime_ns"], record["index_ctime_ns"],
        record["index_sha256"],
    )
    if (observed[:4] != recorded[:4] or observed[5] != recorded[5] or
            _descriptor_content_identity(descriptor_info) != observed[:5] or
            _descriptor_content_identity(path_info) != observed[:5] or
            descriptor_info.st_uid != os.geteuid() or
            path_info.st_uid != os.geteuid() or
            descriptor_info.st_nlink != 2 or path_info.st_nlink != 2 or
            stat.S_IMODE(descriptor_info.st_mode) != 0o600 or
            stat.S_IMODE(path_info.st_mode) != 0o600):
        raise CommitVerificationError(
            "refresh promoted diverge de inode/size/mtime/hash exatos")
    record["phase"] = "promoted"
    record["index_ctime_ns"] = observed[4]
    record.pop("record_sha256")
    record["record_sha256"] = hashlib.sha256(
        _canonical_json(record)).hexdigest()
    _atomic_control_write(
        artifact.sidecar_path, _canonical_json(record),
        max_bytes=PREPARED_INDEX_SIDECAR_MAX_BYTES)
    return _read_prepared_index_artifact(artifact.sidecar_path)


def _write_prepared_recovery_success(
    root: pathlib.Path, artifact: PreparedIndexArtifact,
    report: Mapping[str, Any],
) -> None:
    record = artifact.record
    terminal = _terminal_record(
        fingerprint=record["fingerprint"], run_id=record["run_id"],
        pid=record["owner_pid"], start_ticks=record["owner_start_ticks"],
        started_unix_ns=record["started_unix_ns"], state="success",
        exit_code=0, failure_kind=None, cas_may_have_applied=False,
        stdout=_canonical_json(report).decode("utf-8"), stderr="")
    _write_terminal(_singleflight_directory(root), terminal)
    reported_kind = report.get("kind")
    _mirror_terminal_to_unit_ledger(
        root, terminal, unit_key=None, family_key=None,
        kind=reported_kind if isinstance(reported_kind, str) else None,
        input_oids_digest=None)


def _gc_orphan_prepared_nonces(root: pathlib.Path) -> int:
    """Reclaim only the exact pre-bound nonce of one dead pre-sidecar run."""
    directory = _singleflight_directory(root)
    active_path = directory / "active.json"
    active_raw = _read_control_json(
        active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    if active_raw is None:
        return 0
    active = _validate_active_record(active_raw)
    nonce_name = active.get("prepared_nonce_name")
    nonce_identity = active.get("prepared_nonce_identity")
    if (active["phase"] != "prepare_index" or nonce_name is None or
            nonce_identity is None):
        return 0
    _raise_if_orphan_child_alive(active)
    if _pid_generation_alive(active["pid"], active["start_ticks"]):
        raise CommitBusy("nonce órfão ainda pertence a owner vivo")
    terminal = _read_singleflight_terminal(
        directory, active["fingerprint"])
    if terminal is not None and (
            terminal["run_id"] != active["run_id"] or
            terminal["state"] != "failure"):
        raise CommitVerificationError(
            "nonce sem sidecar contradiz terminal singleflight")

    parent = _main_index_path(root).parent
    nonce_path = parent / nonce_name
    sidecar_path = parent / (nonce_name + ".json")
    try:
        entries = list(os.scandir(parent))
    except OSError as error:
        raise CommitVerificationError(
            "diretório Git não pôde enumerar nonce órfão") from error
    if len(entries) > 100000:
        raise CommitVerificationError(
            "diretório Git excedeu GC bounded de nonce")
    # Enumeration detects ambiguity only. It never selects deletion targets:
    # the active record's exact random name is the sole removal authority.
    for entry in entries:
        match = PREPARED_INDEX_NAME.fullmatch(entry.name)
        if (match is not None and match.group(1) == active["run_id"] and
                entry.name != nonce_name):
            raise CommitVerificationError(
                "outro nonce do mesmo run torna GC ambíguo")
    try:
        os.stat(sidecar_path, follow_symlinks=False)
    except FileNotFoundError:
        pass
    except OSError as error:
        raise CommitVerificationError(
            "sidecar potencial não pôde ser autenticado") from error
    else:
        return 0
    try:
        info = os.stat(nonce_path, follow_symlinks=False)
    except FileNotFoundError:
        return 0
    except OSError as error:
        raise CommitVerificationError(
            "nonce vinculado não pôde ser autenticado") from error
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or
            _descriptor_content_identity(info) != tuple(nonce_identity)):
        raise CommitVerificationError(
            "nonce vinculado diverge da identidade autenticada")
    identity = (
        info.st_dev, info.st_ino, info.st_mode, info.st_uid,
        info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns,
    )
    current = os.stat(nonce_path, follow_symlinks=False)
    current_identity = (
        current.st_dev, current.st_ino, current.st_mode, current.st_uid,
        current.st_nlink, current.st_size,
        current.st_mtime_ns, current.st_ctime_ns,
    )
    if current_identity != identity:
        raise CommitVerificationError(
            "nonce vinculado mudou antes da limpeza")
    os.unlink(nonce_path)
    _fsync_directory(parent)
    if terminal is None:
        _dead_owner_terminal(
            directory, active,
            "owner morreu entre nonce e sidecar prepared index")
    else:
        visible = _read_control_json(
            active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
        if visible != active:
            raise CommitVerificationError(
                "active mudou durante GC de nonce órfão")
        _unlink_control(
            active_path, max_bytes=SINGLEFLIGHT_STATE_MAX_BYTES)
    return 1


def _recover_prepared_main_index(root: pathlib.Path) -> dict[str, Any]:
    """Reclaim pre-CAS crashes or finish one authenticated post-CAS index.

    The producer lease is acquired before inspecting active/terminal state.
    Every unlink is bound to the sidecar's nonce/inode; there is no generic
    ``index.lock`` deletion path.
    """
    root = root.resolve(strict=True)
    directory = _singleflight_directory(root)
    producer = _singleflight_lock_descriptor(directory)
    try:
        try:
            fcntl.flock(producer, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise CommitBusy(
                "prepared index pertence a producer singleflight vivo") from error
        orphan_nonces_reclaimed = _gc_orphan_prepared_nonces(root)
        (current_commit, expected_ref, head_path,
         head_payload) = _capture_symbolic_head(root)
        object_format = _git_text(root, ["rev-parse", "--show-object-format"])
        index_path = _main_index_path(root)
        lock_path = index_path.with_name(index_path.name + ".lock")
        artifacts = _prepared_index_artifacts(root)
        if orphan_nonces_reclaimed:
            if lock_path.exists() or artifacts:
                raise CommitVerificationError(
                    "GC órfão encontrou outro prepared index; recusa misturar runs")
            return {
                "schema": "v2_prepared_index_recovery_v2",
                "recovered": True,
                "reclaimed_pre_cas": True,
                "orphan_nonces_reclaimed": orphan_nonces_reclaimed,
                "head": current_commit,
                "candidate": None,
                "publication_allowed": False,
                "index_policy": "noindex",
            }
        selected: list[PreparedIndexArtifact] = []
        if lock_path.exists():
            lock_info = os.stat(lock_path, follow_symlinks=False)
            selected = [artifact for artifact in artifacts if (
                artifact.record["inode_dev"], artifact.record["inode_ino"]
            ) == (lock_info.st_dev, lock_info.st_ino)]
            if not selected and _foreign_index_lock_contention(
                    root, lock_info, artifacts):
                # Entrada VIVA de recovery (a do CLI): sem esta cláusula o lock
                # de outra transação Git caía em "exatamente um prepared index
                # autenticado" — exit 1 determinístico por contenção.
                raise CommitBusy(FOREIGN_INDEX_LOCK_MESSAGE)
        else:
            index_info = os.stat(index_path, follow_symlinks=False)
            selected = [artifact for artifact in artifacts if (
                (artifact.record["inode_dev"], artifact.record["inode_ino"]) ==
                (index_info.st_dev, index_info.st_ino) or
                (artifact.record["expected_head"] == current_commit and
                 artifact.record["phase"] in {
                     "allocated", "linked", "preparing", "prepared", "cas",
                     "cas_not_applied"})
            )]
        if len(selected) != 1:
            raise CommitVerificationError(
                "recovery exige exatamente um prepared index autenticado")
        artifact = selected[0]
        record = artifact.record
        if (record["expected_ref"] != expected_ref or
                record["object_format"] != object_format):
            raise CommitVerificationError(
                "prepared index diverge do ref/object-format vivo")
        terminal = _prepared_terminal_authority(
            root, artifact, create_dead_owner_terminal=True)
        descriptor = os.open(
            artifact.nonce_path,
            os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise CommitBusy("prepared inode ainda possui owner vivo") from error
            if current_commit == record["expected_head"]:
                if (record["phase"] in {"cas", "ref_applied", "promoted"} or
                        terminal["state"] != "failure"):
                    raise CommitVerificationError(
                        "terminal/fase contradiz recovery pré-CAS")
                if lock_path.exists() and not _prepared_path_matches_inode(
                        lock_path, artifact, nlink=2):
                    raise CommitVerificationError(
                        "index.lock pré-CAS perdeu nonce autenticado")
                if record["phase"] in {"prepared", "cas_not_applied"}:
                    if not lock_path.exists():
                        raise CommitVerificationError(
                            "fase prepared pré-CAS perdeu hardlink exato")
                    _validate_prepared_inode(
                        artifact, descriptor, require_record_hash=True,
                        allow_transition_ctime=(
                            "index_ctime_ns" not in record),
                    )
                _remove_prepared_artifact(
                    artifact, lock_path=lock_path if lock_path.exists() else None)
                return {
                    "schema": "v2_prepared_index_recovery_v2",
                    "recovered": True,
                    "reclaimed_pre_cas": True,
                    "head": current_commit,
                    "candidate": record["candidate"],
                    "publication_allowed": False,
                    "index_policy": "noindex",
                }
            if current_commit != record["candidate"]:
                raise CommitVerificationError(
                    "ref vivo não é old nem candidate do sidecar")
            if record["phase"] in {
                    "allocated", "linked", "preparing", "cas_not_applied"}:
                raise CommitVerificationError(
                    "fase prepared index contradiz CAS durável")
            epoch, tree, _ = _recovery_commit_epoch(
                root, current_commit, expected_ref, head_path, head_payload,
                object_format)
            if _prepared_closure_digest(epoch) != record["closure_digest"]:
                raise CommitVerificationError(
                    "closure recovery diverge do sidecar")
            lock_present = lock_path.exists()
            if lock_present:
                if not _prepared_path_matches_inode(
                        lock_path, artifact, nlink=2):
                    raise CommitVerificationError(
                        "index.lock pós-CAS perdeu inode autenticado")
            elif not _prepared_path_matches_inode(
                    index_path, artifact, nlink=2):
                raise CommitVerificationError(
                    "rename pós-CAS não corresponde ao nonce autenticado")
            allow_recovery_ctime = (
                "index_ctime_ns" not in record or
                (not lock_present and record["phase"] in {
                    "cas", "ref_applied", "promoted"}))
            prepared_identity = _validate_prepared_inode(
                artifact, descriptor, require_record_hash=True,
                allow_transition_ctime=allow_recovery_ctime)
            with tempfile.TemporaryDirectory(
                    prefix="wiki-v2-index-recovery-", dir="/tmp",
                    ignore_cleanup_errors=True) as raw_workspace:
                workspace = pathlib.Path(raw_workspace)
                os.chmod(workspace, 0o700)
                reconstructed = workspace / "reconstructed.index"
                if lock_present:
                    main_descriptor = os.open(
                        index_path,
                        os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
                    close_main_descriptor = True
                    main_info = os.fstat(main_descriptor)
                    main_path_info = os.stat(
                        index_path, follow_symlinks=False)
                    if (not stat.S_ISREG(main_info.st_mode) or
                            main_info.st_uid != os.geteuid() or
                            main_info.st_nlink != 1 or
                            (main_info.st_dev, main_info.st_ino) !=
                            (main_path_info.st_dev, main_path_info.st_ino)):
                        os.close(main_descriptor)
                        raise CommitVerificationError(
                            "índice principal não é fonte recovery canônica")
                else:
                    main_descriptor = descriptor
                    close_main_descriptor = False
                try:
                    main_digest = _copy_descriptor_to_exclusive(
                        main_descriptor, reconstructed)
                finally:
                    if close_main_descriptor:
                        os.close(main_descriptor)
                _write_private_index_entries(
                    root, os.fspath(reconstructed), epoch.closure)
                reconstructed_descriptor = os.open(
                    reconstructed,
                    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
                try:
                    reconstructed_digest = _stream_descriptor_digest(
                        reconstructed_descriptor)
                finally:
                    os.close(reconstructed_descriptor)
                if (reconstructed_digest[2] != record["index_size"] or
                        reconstructed_digest[5] != record["index_sha256"]):
                    raise CommitVerificationError(
                        "prepared index não reconcilia o índice principal")
                _run_finalized_commit_guard(
                    None, epoch, current_commit, workspace)

            second_commit, second_ref, second_head_path, second_head_payload = (
                _capture_symbolic_head(root))
            if (second_commit != current_commit or second_ref != expected_ref or
                    second_head_path != head_path or
                    second_head_payload != head_payload):
                raise CommitBusy("HEAD mudou durante recovery do index.lock")
            if lock_present:
                second_main_descriptor = os.open(
                    index_path,
                    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
                try:
                    second_main_digest = _stream_descriptor_digest(
                        second_main_descriptor)
                finally:
                    os.close(second_main_descriptor)
            else:
                second_main_digest = _stream_descriptor_digest(descriptor)
            if second_main_digest != main_digest:
                raise CommitBusy("índice principal mudou durante recovery")
            second_prepared_identity = _validate_prepared_inode(
                artifact, descriptor, require_record_hash=True,
                allow_transition_ctime=allow_recovery_ctime)
            if second_prepared_identity != prepared_identity:
                raise CommitBusy("prepared index mudou durante recovery")
            if lock_present:
                if not _prepared_path_matches_inode(
                        lock_path, artifact, nlink=2):
                    raise CommitBusy("index.lock mudou durante recovery")
                os.replace(lock_path, index_path)
                _fsync_directory(index_path.parent)
            elif not _prepared_path_matches_inode(
                    index_path, artifact, nlink=2):
                raise CommitBusy("índice promovido mudou durante recovery")
            artifact = _rewrite_promoted_prepared_artifact(
                artifact, descriptor, index_path)
            _prepared_recovery_boundary(
                artifact, "post_rewrite_promoted")
            report = {
                "schema": "v2_prepared_index_recovery_v2",
                "recovered": True,
                "reclaimed_pre_cas": False,
                "head": current_commit,
                "parent": epoch.expected_head,
                "tree": tree,
                "closure_paths": [item["path"] for item in epoch.closure],
                "publication_allowed": False,
                "index_policy": "noindex",
            }
            _write_prepared_recovery_success(root, artifact, report)
            _remove_prepared_artifact(artifact, lock_path=None)
            return report
        finally:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_UN)
            finally:
                os.close(descriptor)
    finally:
        try:
            fcntl.flock(producer, fcntl.LOCK_UN)
        finally:
            os.close(producer)


def _owned_index_lock_matches(prepared: PreparedMainIndex) -> bool:
    if prepared.descriptor < 0:
        return False
    try:
        descriptor_info = os.fstat(prepared.descriptor)
        nonce_info = os.stat(prepared.nonce_path, follow_symlinks=False)
        authority_path = (
            prepared.index_path if prepared.promoted else prepared.lock_path)
        path_info = os.stat(authority_path, follow_symlinks=False)
    except OSError:
        return False
    identity = (descriptor_info.st_dev, descriptor_info.st_ino)
    return (
        identity == prepared.lock_identity ==
        (nonce_info.st_dev, nonce_info.st_ino) ==
        (path_info.st_dev, path_info.st_ino) and
        stat.S_ISREG(descriptor_info.st_mode) and
        stat.S_ISREG(nonce_info.st_mode) and
        stat.S_ISREG(path_info.st_mode) and
        descriptor_info.st_nlink == 2 and nonce_info.st_nlink == 2 and
        path_info.st_nlink == 2 and
        descriptor_info.st_uid == os.geteuid() and
        nonce_info.st_uid == os.geteuid() and
        path_info.st_uid == os.geteuid() and
        stat.S_IMODE(descriptor_info.st_mode) == 0o600 and
        stat.S_IMODE(nonce_info.st_mode) == 0o600 and
        stat.S_IMODE(path_info.st_mode) == 0o600)


def _fsync_directory(path: pathlib.Path) -> None:
    descriptor = os.open(
        path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _cleanup_proven_pre_cas_prepared_index(
    prepared: PreparedMainIndex,
) -> bool:
    """Remove only this run's authenticated inode with the old ref proven."""
    if (prepared.promoted or not prepared.sidecar_durable or
            prepared.descriptor < 0):
        return False
    artifact = _read_prepared_index_artifact(prepared.sidecar_path)
    record = artifact.record
    if ((record["fingerprint"], record["run_id"], record["owner_pid"],
         record["owner_start_ticks"], record["started_unix_ns"],
         record["expected_ref"], record["expected_head"],
         record["candidate"], record["closure_digest"]) !=
            (prepared.fingerprint, prepared.run_id, prepared.owner_pid,
             prepared.owner_start_ticks, prepared.started_unix_ns,
             prepared.expected_ref, prepared.expected_head,
             prepared.candidate, prepared.closure_digest) or
            (record["inode_dev"], record["inode_ino"]) !=
            prepared.lock_identity):
        raise CommitVerificationError(
            "sidecar pré-CAS diverge da geração em memória")
    if record["phase"] not in {
            "allocated", "linked", "preparing", "prepared",
            "cas_not_applied"}:
        return False
    current, expected_ref, _, _ = _capture_symbolic_head(prepared.root)
    if (current != prepared.expected_head or
            expected_ref != prepared.expected_ref):
        return False
    descriptor_info = os.fstat(prepared.descriptor)
    if (not stat.S_ISREG(descriptor_info.st_mode) or
            descriptor_info.st_uid != os.geteuid() or
            stat.S_IMODE(descriptor_info.st_mode) != 0o600 or
            (descriptor_info.st_dev, descriptor_info.st_ino) !=
            prepared.lock_identity):
        raise CommitVerificationError(
            "descritor pré-CAS perdeu inode/UID/modo")
    if record["phase"] in {"prepared", "cas_not_applied"}:
        _validate_prepared_inode(
            artifact, prepared.descriptor, require_record_hash=True)
    lock_for_cleanup: pathlib.Path | None = None
    if descriptor_info.st_nlink == 2:
        if not _prepared_path_matches_inode(
                prepared.lock_path, artifact, nlink=2):
            return False
        lock_for_cleanup = prepared.lock_path
    elif descriptor_info.st_nlink != 1:
        return False
    _remove_prepared_artifact(artifact, lock_path=lock_for_cleanup)
    prepared.linked = False
    return True


def _release_prepared_main_index(prepared: PreparedMainIndex) -> None:
    """Close ownership; clean only an authenticated, proven pre-CAS inode."""
    if prepared.descriptor < 0:
        return
    try:
        if prepared.sidecar_durable:
            try:
                _cleanup_proven_pre_cas_prepared_index(prepared)
            except (OSError, CommitVerificationError):
                # Tamper, ambiguous phase/ref, or a foreign replacement keeps
                # every recovery name fail-closed.
                pass
        else:
            # No recovery authority was published. Only a still-private nonce
            # created by this descriptor may be removed here.
            try:
                info = os.fstat(prepared.descriptor)
                nonce_info = os.stat(
                    prepared.nonce_path, follow_symlinks=False)
            except OSError:
                pass
            else:
                if ((info.st_dev, info.st_ino) ==
                        (nonce_info.st_dev, nonce_info.st_ino) and
                        info.st_nlink == 1 and nonce_info.st_nlink == 1):
                    os.unlink(prepared.nonce_path)
                    _fsync_directory(prepared.nonce_path.parent)
    finally:
        os.close(prepared.descriptor)
        prepared.descriptor = -1


def _reclaim_stale_pre_cas_lock(root: pathlib.Path) -> None:
    """Reclaim one dead prior generation while the new producer lock is held."""
    lease = _ACTIVE_SINGLEFLIGHT
    if lease is None or lease.descriptor < 0:
        raise CommitVerificationError(
            "reclaim pré-CAS exige producer singleflight exclusivo")
    index_path = _main_index_path(root)
    lock_path = index_path.with_name(index_path.name + ".lock")
    try:
        lock_info = os.stat(lock_path, follow_symlinks=False)
    except FileNotFoundError:
        return
    if _foreign_index_lock_contention(root, lock_info):
        # Transação Git ALHEIA em voo (commit comum, hook, outra sessão).
        # Antes isso virava CommitVerificationError (exit 1, determinística) e
        # queimava o budget UNIT_FAMILY_MICRO_ATTEMPT_LIMIT da família como se
        # fosse defeito do candidato.  Nada aqui desvincula, apaga ou
        # reivindica o lock alheio; só o exit vira 75 (BUSY) para re-tentativa.
        raise CommitBusy(FOREIGN_INDEX_LOCK_MESSAGE)
    artifact = _artifact_for_inode(root, lock_info)
    record = artifact.record
    terminal = _prepared_terminal_authority(
        root, artifact, create_dead_owner_terminal=False)
    current, expected_ref, _, _ = _capture_symbolic_head(root)
    if (current != record["expected_head"] or
            expected_ref != record["expected_ref"] or
            record["phase"] not in {
                "allocated", "linked", "preparing", "prepared",
                "cas_not_applied"} or
            terminal["state"] != "failure"):
        raise CommitBusy(
            "index.lock stale não é reclaim pré-CAS autenticável")
    descriptor = os.open(
        artifact.nonce_path, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise CommitBusy("prepared inode stale ainda possui owner") from error
        if not _prepared_path_matches_inode(lock_path, artifact, nlink=2):
            raise CommitVerificationError(
                "index.lock stale perdeu hardlink autenticado")
        if record["phase"] in {"prepared", "cas_not_applied"}:
            _validate_prepared_inode(
                artifact, descriptor, require_record_hash=True,
                allow_transition_ctime=("index_ctime_ns" not in record))
        _remove_prepared_artifact(artifact, lock_path=lock_path)
    finally:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)


def _prepare_main_index(
    epoch: CommitEpoch, workspace: pathlib.Path, commit: str,
    kind: str, lease: SingleFlightLease,
) -> PreparedMainIndex:
    """Publish sidecar first, then atomically hardlink ``index.lock``."""
    index_path = _main_index_path(epoch.root)
    lock_path = index_path.with_name(index_path.name + ".lock")
    if lock_path.exists():
        _reclaim_stale_pre_cas_lock(epoch.root)
    if (lease is not _ACTIVE_SINGLEFLIGHT or lease.terminal or
            SHA256.fullmatch(lease.fingerprint) is None or
            SINGLEFLIGHT_RUN_ID.fullmatch(lease.run_id) is None):
        raise CommitVerificationError(
            "prepared index diverge do lease/candidate singleflight")
    nonce_path = index_path.with_name(
        index_path.name + ".prepared-" + lease.run_id + "-" +
        secrets.token_hex(16))
    sidecar_path = nonce_path.with_name(nonce_path.name + ".json")
    _singleflight_bind_prepared_nonce(lease, nonce_path)
    try:
        target_fd = os.open(
            nonce_path,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC |
            os.O_NOFOLLOW,
            0o600,
        )
    except OSError as error:
        raise CommitVerificationError(
            "nonce de prepared index não pôde ser criado") from error
    info = os.fstat(target_fd)
    prepared = PreparedMainIndex(
        root=epoch.root,
        index_path=index_path,
        lock_path=lock_path,
        nonce_path=nonce_path,
        sidecar_path=sidecar_path,
        descriptor=target_fd,
        lock_identity=(info.st_dev, info.st_ino),
        fingerprint=lease.fingerprint,
        run_id=lease.run_id,
        owner_pid=lease.pid,
        owner_start_ticks=lease.start_ticks,
        started_unix_ns=lease.started_unix_ns,
        kind=kind,
        expected_ref=epoch.expected_ref,
        expected_head=epoch.expected_head,
        candidate=commit,
        object_format=epoch.object_format,
        closure_digest=_prepared_closure_digest(epoch),
    )
    lease.prepared_sidecar_path = sidecar_path
    candidate = workspace / "reconciled-main.index"
    try:
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or
                info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != 0o600):
            raise CommitVerificationError("nonce preparado não é privado")
        try:
            fcntl.flock(target_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:  # pragma: no cover - new unique inode
            raise CommitBusy(
                "nonce recém-criado possui owner concorrente") from error
        _singleflight_bind_prepared_nonce_identity(lease, target_fd)
        _fsync_directory(index_path.parent)
        _prepared_index_boundary(prepared, "post_nonce")
        _write_prepared_index_phase(prepared, "allocated")
        _fsync_directory(index_path.parent)
        _prepared_index_boundary(prepared, "before_link")
        try:
            os.link(nonce_path, lock_path, follow_symlinks=False)
        except FileExistsError as error:
            raise CommitBusy(
                "índice principal está em outra transação; CAS não iniciado") from error
        except OSError as error:
            raise CommitVerificationError(
                "index.lock não pôde adquirir hardlink preparado") from error
        prepared.linked = True
        _fsync_directory(index_path.parent)
        if not _owned_index_lock_matches(prepared):
            raise CommitBusy("hardlink index.lock perdeu identidade")
        _prepared_index_boundary(prepared, "post_link")
        _write_prepared_index_phase(prepared, "linked")
        _write_prepared_index_phase(prepared, "preparing")
        candidate_fd = os.open(
            candidate,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC |
            os.O_NOFOLLOW,
            0o600,
        )
        try:
            source_fd = os.open(
                index_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            try:
                source_before = os.fstat(source_fd)
                if (not stat.S_ISREG(source_before.st_mode) or
                        source_before.st_nlink != 1 or
                        source_before.st_size < 0 or
                        source_before.st_size > MAX_INDEX_BYTES):
                    raise CommitVerificationError(
                        "índice principal não é arquivo regular")
                copied = _copy_fd(source_fd, candidate_fd)
                if copied != source_before.st_size:
                    raise CommitVerificationError(
                        "cópia do índice principal ficou truncada")
                source_after = os.fstat(source_fd)
                path_after = os.stat(index_path, follow_symlinks=False)
                if ((source_before.st_dev, source_before.st_ino,
                     source_before.st_size, source_before.st_mtime_ns,
                     source_before.st_ctime_ns) !=
                    (source_after.st_dev, source_after.st_ino,
                     source_after.st_size, source_after.st_mtime_ns,
                     source_after.st_ctime_ns) or
                    (path_after.st_dev, path_after.st_ino) !=
                    (source_before.st_dev, source_before.st_ino)):
                    raise CommitVerificationError(
                        "índice principal mudou durante captura sob lock")
            finally:
                os.close(source_fd)
            os.fsync(candidate_fd)
        finally:
            os.close(candidate_fd)

        captured = _index_entries_for_paths(
            epoch.root, set(epoch.main_index_targets_before),
            index_file=os.fspath(candidate))
        if captured != epoch.main_index_targets_before:
            raise CommitVerificationError(
                "entradas-alvo do índice mudaram antes do index.lock")
        # A target that was already staged is allowed only as the exact
        # authenticated closure. Revalidate its stage-0 tuple above and its
        # bytes again from the index captured while index.lock is owned, before
        # reconciliation can rewrite or promote anything.
        for item in epoch.closure:
            if captured.get(item["path"]) == (
                    item["mode"], item["git_blob_oid"], "0"):
                _validate_index_closure_blob(
                    epoch.root, item,
                    epoch.closure_payloads[item["path"]],
                    epoch.object_format,
                    index_file=os.fspath(candidate),
                )
        _write_private_index_entries(
            epoch.root, os.fspath(candidate), epoch.closure)
        reconciled = _index_entries_for_paths(
            epoch.root, set(epoch.main_index_targets_before),
            index_file=os.fspath(candidate))
        for item in epoch.closure:
            if reconciled.get(item["path"]) != (
                    item["mode"], item["git_blob_oid"], "0"):
                raise CommitVerificationError(
                    "reconciliação não materializou blob: " + item["path"])
        source_fd = os.open(
            candidate, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            source_info = os.fstat(source_fd)
            if (not stat.S_ISREG(source_info.st_mode) or
                    source_info.st_nlink != 1 or
                    source_info.st_size < 0 or
                    source_info.st_size > MAX_INDEX_BYTES):
                raise CommitVerificationError(
                    "índice reconciliado privado é inseguro")
            os.lseek(target_fd, 0, os.SEEK_SET)
            os.ftruncate(target_fd, 0)
            copied = _copy_fd(source_fd, target_fd)
            if copied != source_info.st_size:
                raise CommitVerificationError(
                    "index.lock preparado ficou truncado")
            os.fsync(target_fd)
        finally:
            os.close(source_fd)
        if not _owned_index_lock_matches(prepared):
            raise CommitBusy("index.lock foi substituído durante preparação")
        _write_prepared_index_phase(prepared, "prepared")
        _fsync_directory(lock_path.parent)
        _prepared_index_boundary(prepared, "post_prepared")
        return prepared
    except BaseException:
        _release_prepared_main_index(prepared)
        raise


def _promote_prepared_main_index(
    epoch: CommitEpoch, prepared: PreparedMainIndex, commit: str,
) -> tuple[bool, str | None]:
    """Atomically install the pre-fsynced index after the matching durable CAS."""
    prepared.ref_applied = True
    try:
        current = _current_expected_ref_oid(epoch)
        if current != commit:
            raise CommitBusy(
                "branch avançou após CAS; index.lock retido para recuperação")
        head_payload, _ = _safe_file_payload(epoch.head_path, max_bytes=4096)
        if head_payload != epoch.head_payload:
            raise CommitBusy(
                "HEAD foi retargetado após CAS; index.lock retido")
        if not _owned_index_lock_matches(prepared):
            raise CommitBusy(
                "index.lock preparado perdeu identidade após CAS")
        _write_prepared_index_phase(prepared, "ref_applied")
        os.replace(prepared.lock_path, prepared.index_path)
        prepared.promoted = True
        _fsync_directory(prepared.index_path.parent)
        _prepared_index_boundary(prepared, "post_rename")
        _write_prepared_index_phase(prepared, "promoted")
        return False, None
    except Exception as error:
        return True, f"{type(error).__name__}: {error}"


def _commit_transaction_owner(
    transaction: Any, message: str, epoch: CommitEpoch,
    lease: SingleFlightLease,
) -> str:
    committed_oid: str | None = None
    tree_oid: str | None = None
    merit_attestation: dict[str, Any] | None = None
    gate_attestation: dict[str, Any] | None = None
    reconciliation_required = False
    reconciliation_error: str | None = None
    temporary_parent = pathlib.Path("/tmp")
    temporary_info = os.stat(temporary_parent, follow_symlinks=False)
    if (not stat.S_ISDIR(temporary_info.st_mode) or
            temporary_parent.is_symlink() or temporary_info.st_uid != 0 or
            not temporary_info.st_mode & stat.S_ISVTX):
        raise CommitVerificationError("/tmp não é diretório sticky confiável")
    _singleflight_phase(lease, "preflight")
    _preflight_uid_cache_and_package_atomic(epoch)
    with tempfile.TemporaryDirectory(
            prefix="wiki-v2-plumbing-commit-",
            dir=temporary_parent,
            ignore_cleanup_errors=True) as raw_workspace:
        workspace = pathlib.Path(raw_workspace)
        os.chmod(workspace, 0o700)
        private_index = workspace / "candidate.index"
        _materialize_private_index(epoch, os.fspath(private_index))
        _singleflight_phase(lease, "heavy_lock")
        lease.heavy_descriptor = _acquire_heavy_audit_lock(lease)
        _assert_expected_ref_unchanged(epoch, "antes do build privado")
        _singleflight_phase(lease, "private_build")
        snapshot_root, runtime_bindings, gate_attestation = (
            _materialize_gate_snapshot_root(epoch, workspace)
        )
        _assert_expected_ref_unchanged(epoch, "durante o build privado")
        _singleflight_phase(lease, "private_audit")
        merit_attestation, audit_bindings = _audit_candidate_tree(
            transaction, epoch, os.fspath(private_index), workspace,
            snapshot_root)
        runtime_bindings.update(audit_bindings)
        _assert_expected_ref_unchanged(
            epoch, "durante a auditoria privada")
        _singleflight_phase(lease, "private_precommit")
        if epoch.root == INSTALL_ROOT:
            _assert_private_v2_gate_capability(snapshot_root)
        private_goroot = None
        if epoch.root == INSTALL_ROOT:
            private_goroot = pathlib.Path(
                gate_attestation["toolchain_path"]).parent.parent
        _run_pre_commit_snapshot(
            snapshot_root, epoch.hook_payload, os.fspath(private_index),
            private_goroot,
            _authenticated_owner_go_home(epoch.root))
        _assert_expected_ref_unchanged(
            epoch, "durante o gate pre-commit privado")
        _singleflight_phase(lease, "commit_object")
        _validate_private_index(epoch, os.fspath(private_index))
        committed_oid, tree_oid = _create_commit_object(
            epoch, os.fspath(private_index), message)
        _revalidate_before_cas(transaction, epoch, runtime_bindings)
        _singleflight_phase(lease, "prepare_index")
        prepared_index = _prepare_main_index(
            epoch, workspace, committed_oid, transaction.kind, lease)
        try:
            # Recheck after index.lock acquisition.  From here until the CAS and
            # atomic rename, ordinary Git commits cannot observe a stale index.
            _revalidate_before_cas(transaction, epoch, runtime_bindings)
            _singleflight_phase(lease, "final_guard")
            _run_finalized_commit_guard(
                transaction, epoch, committed_oid, workspace)
            # The finalized guard can run for minutes. Reclose every mutable
            # workflow/dependency/target/runtime binding and the ref epoch after
            # it returns, immediately before entering update-ref.
            _revalidate_before_cas(transaction, epoch, runtime_bindings)
            _assert_expected_ref_unchanged(
                epoch, "depois do guard final e antes do CAS")
            # A signal can arrive after update-ref made the ref durable but
            # before Python executes the next statement. Mark the outcome
            # uncertain *before* entering that boundary; cleanup may remove
            # index.lock again only after observing the exact old ref.
            prepared_index.ref_applied = True
            _write_prepared_index_phase(prepared_index, "cas")
            _singleflight_phase(lease, "cas")
            try:
                _update_ref_cas(epoch, committed_oid)
            except BaseException as cas_error:
                # Live ref state, not the subprocess/Python exception, decides
                # whether removing index.lock is safe. If this probe is itself
                # interrupted or unreadable, the uncertain flag stays set.
                current_after_error = _current_expected_ref_oid(epoch)
                if current_after_error == epoch.expected_head:
                    try:
                        _write_prepared_index_phase(
                            prepared_index, "cas_not_applied")
                        _singleflight_phase(lease, "cas_not_applied")
                    except BaseException as phase_error:
                        raise CommitBusy(
                            "ref antigo comprovado, mas prova singleflight de "
                            "CAS não aplicado não ficou durável",
                            cas_may_have_applied=True,
                        ) from phase_error
                    prepared_index.ref_applied = False
                if not isinstance(cas_error, Exception):
                    # Preserve KeyboardInterrupt/SystemExit semantics. A
                    # durable or third-state ref retains the prepared lock.
                    raise
                if current_after_error != committed_oid:
                    # The exact old ref is safe to unlock; any third/absent
                    # state is ambiguous and keeps the prepared lock.
                    raise
                # A normal exception with the candidate ref already durable is
                # a lost response. Continue and promote the prepared index.
            reconciliation_required, reconciliation_error = (
                _promote_prepared_main_index(
                    epoch, prepared_index, committed_oid))
            _singleflight_phase(lease, "cas_terminal")
        finally:
            _release_prepared_main_index(prepared_index)

    # A post-CAS failure leaves our prepared index.lock in place, deliberately
    # failing ordinary Git commits closed until deterministic recovery.  It must
    # never be unlinked by a generic exception handler.
    report = {
        "identity_verified": True,
        "audit_merit_verified": merit_attestation.get("audit_ok") is True,
        "wave_commit_allowed": True,
        "commit_created": True,
        "kind": transaction.kind,
        "parent": epoch.expected_head,
        "commit": committed_oid,
        "tree": tree_oid,
        "files": [
            {"file": item["path"], "sha256": item["sha256"],
             "role": item["role"]}
            for item in epoch.closure
        ],
        "dependency_count": len(epoch.dependencies) + len(runtime_bindings),
        "index_reconciliation_required": reconciliation_required,
        "publication_allowed": False,
        "index_policy": "noindex",
    }
    if merit_attestation is not None:
        report["private_candidate_audit_attestation"] = merit_attestation
    if gate_attestation is not None:
        report["gate_build_attestation"] = gate_attestation
    if transaction.kind == "canonical-id-repair":
        transition = transaction.transition
        report["canonical_id_repair"] = {
            "target": transition.target,
            "old_intent": transition.old_intent,
            "new_intent": transition.new_intent,
            "line_number": transition.line_number,
            "old_blob_oid": transition.old_blob_oid,
            "new_blob_oid": transition.new_blob_oid,
            "transition_verified": True,
        }
    if reconciliation_error is not None:
        report["index_reconciliation_error"] = reconciliation_error
    return _canonical_json(report).decode("utf-8")


def _commit_oid_is_ancestor(
    root: pathlib.Path, commit_oid: str, head: str,
) -> bool:
    """Whether the recorded landed commit is already history under ``head``."""
    completed = _run_git(
        root, ["merge-base", "--is-ancestor", commit_oid, head], check=False)
    # 0 = ancestor (landed); 1 = not ancestor; anything else (unknown object,
    # corrupt store) is NOT proof of landing and must never fake a no-op.
    return completed.returncode == 0


def _unit_family_budget(
    rows: list[dict[str, Any]], family_key: str,
) -> tuple[int, int]:
    """Deterministic/transient failures in the family since the last reset.

    A reset is only an authenticated green (terminal success) in the family
    or an explicit motive-bearing reopen row — mirror of factoryworkqueue's
    "only authenticated positive ProductDelta resets the count".  Code edits
    never reset it: the family key carries no epoch.
    """
    deterministic = 0
    transient = 0
    for row in rows:
        if row.get("schema") == UNIT_LEDGER_REOPEN_SCHEMA:
            if row["family_key"] == family_key:
                deterministic = 0
                transient = 0
            continue
        if row.get("family_key") != family_key:
            continue
        if row["state"] == "success":
            deterministic = 0
            transient = 0
        elif row["failure_kind"] == "CommitBusy":
            transient += 1
        else:
            deterministic += 1
    return deterministic, transient


def _reopen_unit_family(
    root: pathlib.Path, family_key: str, reason: str,
) -> dict[str, Any]:
    """Append the explicit motive-bearing budget reset (RCA D4.8 §4.4).

    This is the sanctioned "supersessão explícita com motivo gravado": it
    never rewrites history (append-only evidence), it requires a real open
    circuit and a substantive motive, and the motive stays auditable in the
    ledger.  It is the census/RCA exit route — not a bypass an identical
    blind rerun can script, because the diagnostic-refused invocation and the
    reopen invocation are distinct commands with distinct evidence.
    """
    if SHA256.fullmatch(family_key) is None:
        raise CommitVerificationError(
            "--reopen-family exige family_key SHA-256 do diagnóstico")
    if reason.strip() != reason or not (
            UNIT_FAMILY_REOPEN_REASON_MIN_CHARS <= len(reason) <=
            UNIT_FAMILY_REOPEN_REASON_MAX_CHARS):
        raise CommitVerificationError(
            "--reopen-reason exige motivo real (" +
            str(UNIT_FAMILY_REOPEN_REASON_MIN_CHARS) + "-" +
            str(UNIT_FAMILY_REOPEN_REASON_MAX_CHARS) +
            " caracteres, sem espaço nas bordas)")
    rows = _read_unit_ledger(root)
    family_rows = [
        row for row in rows
        if row.get("schema") == UNIT_LEDGER_SCHEMA and
        row.get("family_key") == family_key
    ]
    if not any(row["state"] == "failure" for row in family_rows):
        raise CommitVerificationError(
            "família sem falha registrada no unit-ledger; reabertura sem "
            "circuito é recusada")
    deterministic, transient = _unit_family_budget(rows, family_key)
    if deterministic == 0 and transient == 0:
        raise CommitVerificationError(
            "família já está com orçamento limpo (verde ou reopen "
            "posterior); reabertura redundante é recusada")
    kind = next(
        (row["kind"] for row in reversed(family_rows)
         if row.get("kind") is not None), None)
    _append_unit_ledger_row(root, {
        "schema": UNIT_LEDGER_REOPEN_SCHEMA,
        "family_key": family_key,
        "kind": kind,
        "reason": reason,
        "ts_unix_ns": time.time_ns(),
    })
    return {
        "family_reopened": True,
        "family_key": family_key,
        "kind": kind,
        "deterministic_failures_cleared": deterministic,
        "transient_failures_cleared": transient,
        "unit_ledger": UNIT_LEDGER_REL,
        "publication_allowed": False,
        "index_policy": "noindex",
    }


def _unit_guard_before_execution(
    epoch: CommitEpoch, kind: str,
) -> dict[str, Any] | None:
    """Rerun guard keyed by unit identity + family budget (RCA D4.8 §4.1-4.4).

    Same ``unit_key`` with a terminal success already landed under the current
    epoch ⇒ idempotent no-op (returns the replay report).  The family budget
    (LineageKey semantics) refuses the third deterministic attempt on the
    same target family without an authenticated green — including reruns
    "renewed" only by code edits or byte micro-adjustments, which is exactly
    the 2026-07-21 loop shape.  The diagnostic always names the sanctioned
    routes; there is never a dead end without a declared succession route.
    """
    unit_key, family_key, _ = _unit_identity(epoch, kind)
    rows = _read_unit_ledger(epoch.root)
    for row in reversed(rows):
        if (row.get("schema") == UNIT_LEDGER_SCHEMA and
                row["unit_key"] == unit_key and
                row["state"] == "success" and
                row["commit_oid"] is not None and
                _commit_oid_is_ancestor(
                    epoch.root, row["commit_oid"], epoch.expected_head)):
            return {
                "replayed_no_op": True,
                "reason": (
                    "unit_key com terminal success já pousado como ancestral "
                    "do epoch atual; rerun idêntico é no-op idempotente"),
                "kind": kind,
                "unit_key": unit_key,
                "family_key": family_key,
                "commit": row["commit_oid"],
                "result_sha256": row["result_sha256"],
                "unit_ledger": UNIT_LEDGER_REL,
                "publication_allowed": False,
                "index_policy": "noindex",
            }
    deterministic, transient = _unit_family_budget(rows, family_key)
    if (deterministic >= UNIT_FAMILY_MICRO_ATTEMPT_LIMIT - 1 or
            transient >= MAX_UNIT_TRANSIENT_FAILURES):
        raise CommitVerificationError(
            "circuit-open: family_key=" + family_key + " (unit_key=" +
            unit_key + ") acumulou " + str(deterministic) +
            " falha(s) determinística(s) e " + str(transient) +
            " transiente(s) sem verde autenticado em " + UNIT_LEDGER_REL +
            "; a " + str(UNIT_FAMILY_MICRO_ATTEMPT_LIMIT) +
            "ª tentativa na mesma família é recusada (RCA D4.8 §4.3; "
            "orçamento por família não é resetado por edição de código nem "
            "por micro-ajuste de bytes). Rotas sancionadas: (1) abrir task "
            "de censo/RCA da família inteira no frontboard e corrigir a "
            "causa-raiz; (2) após o censo, reabrir com evidência explícita: "
            "--reopen-family " + family_key + " --reopen-reason \"<motivo "
            "real do censo>\" — o motivo fica gravado no ledger; jamais "
            "fabricar delta artificial para lavar a identidade")
    return None


def _semantic_recut_landed_no_op(root: pathlib.Path) -> dict[str, Any] | None:
    """Resolve a zero-staged-delta rerun against the unit ledger.

    The most recent semantic-recut unit with a terminal success whose commit
    is already an ancestor of the live HEAD proves the invocation is a rerun
    of a landed unit: replay it as an idempotent no-op instead of the
    historical "porcelain esgotado" dead end (RCA D4.8 §4.4).
    """
    current_head, _, _, _ = _capture_symbolic_head(root)
    for row in reversed(_read_unit_ledger(root)):
        if (row.get("schema") == UNIT_LEDGER_SCHEMA and
                row["kind"] == "semantic-recut" and
                row["state"] == "success" and
                row["commit_oid"] is not None and
                _commit_oid_is_ancestor(root, row["commit_oid"], current_head)):
            return {
                "replayed_no_op": True,
                "reason": (
                    "closure semântica sem delta staged e unidade "
                    "semantic-recut já pousada como ancestral do HEAD; "
                    "rerun idêntico é no-op idempotente"),
                "kind": "semantic-recut",
                "unit_key": row["unit_key"],
                "family_key": row["family_key"],
                "commit": row["commit_oid"],
                "result_sha256": row["result_sha256"],
                "unit_ledger": UNIT_LEDGER_REL,
                "publication_allowed": False,
                "index_policy": "noindex",
            }
    return None


def _assert_utc_day_headroom_for_private_audit() -> None:
    """Recusa entrar quando a virada UTC invalidaria a auditoria já paga.

    ``_audit_candidate_tree`` fixa ``audit_utc_date`` no início e reprova de
    forma DETERMINÍSTICA (exit 1, "data UTC mudou durante auditoria privada")
    se a data UTC houver mudado ao final.  Entre esses dois pontos rodam o
    build privado e o gate pre-commit, cada um limitado por
    ``HOOK_TIMEOUT_SECONDS``: no pior caso legítimo o trecho consome
    ``2 * HOOK_TIMEOUT_SECONDS``.  Entrar com menos dia restante que isso é
    apostar build + auditoria pagos contra o relógio e perder o lote inteiro
    por um invariante de calendário, não por defeito do candidato.

    A recusa é feita ANTES do single-flight: nenhum terminal durável é escrito,
    o exit é 75 (transitório) e o rerun após 00:00Z volta a executar sem exigir
    ``--retry-failed``.  Custo aceito: a janela ~23:00Z–00:00Z não admite
    entrada nova.
    """
    remaining = 86400 - (time.time() % 86400)
    horizon = 2 * HOOK_TIMEOUT_SECONDS
    if remaining < horizon:
        raise CommitBusy(
            f"virada UTC em {int(remaining)}s, abaixo dos {horizon}s exigidos "
            "pela auditoria privada (build + gate pre-commit sob "
            "HOOK_TIMEOUT_SECONDS); re-agende após 00:00Z")


def _assert_utc_day_headroom_before_new_entry(
    epoch: CommitEpoch, message: str, kind: str,
) -> None:
    """Aplica a guarda de virada UTC apenas a ENTRADA nova.

    Fingerprint com terminal de sucesso durável não executa build nem
    auditoria: ``_begin_singleflight`` apenas replaya o resultado (exit 0).
    Transformar esse replay idempotente em 75 puniria uma unidade JÁ POUSADA
    por um invariante de calendário que ela nem chega a tocar.

    Terminal ilegível/adulterado não é tratado como ausência: a exceção
    fail-closed sobe daqui exatamente como subiria de ``_begin_singleflight``,
    sem virar BUSY transitório.
    """
    terminal = _read_singleflight_terminal(
        _singleflight_directory(epoch.root),
        _singleflight_fingerprint(epoch, message, kind))
    if terminal is not None and terminal["state"] == "success":
        return
    _assert_utc_day_headroom_for_private_audit()


def _commit_transaction(
    transaction: Any, message: str, *, retry_failed: str | None = None,
) -> int:
    """Join/replay one fingerprint or produce it exactly once through CAS."""
    global _ACTIVE_SINGLEFLIGHT
    message = _validate_message(message)
    epoch = _build_commit_epoch(transaction, message)
    replay_report = _unit_guard_before_execution(epoch, transaction.kind)
    if replay_report is not None:
        try:
            print(
                _canonical_json(replay_report).decode("utf-8"),
                end="", flush=True)
        except (BrokenPipeError, OSError):
            return 0
        return 0
    # Depois do replay idempotente (unidade já pousada segue devolvendo 0) e
    # antes de reivindicar o single-flight: a partir daqui todo caminho custa
    # build + auditoria privada, que a virada UTC anularia.
    _assert_utc_day_headroom_before_new_entry(
        epoch, message, transaction.kind)
    decision = _begin_singleflight(
        epoch, message, transaction.kind, retry_failed)
    if isinstance(decision, SingleFlightReplay):
        return _raise_singleflight_replay(decision.record)
    lease = decision
    _ACTIVE_SINGLEFLIGHT = lease

    def release_terminal_leases() -> None:
        if lease.heavy_descriptor >= 0:
            _release_heavy_audit_lock(lease.heavy_descriptor)
            lease.heavy_descriptor = -1
        _release_singleflight(lease)

    try:
        stdout = _commit_transaction_owner(
            transaction, message, epoch, lease)
        terminal = _finish_singleflight_success(lease, stdout)
        del terminal
    except BaseException as error:
        # _write_terminal(SUCCESS) is the point of no return.  Interruptions
        # while unlinking active.json or cleaning prepared-index evidence must
        # release both leases and propagate without publishing FAILURE over the
        # already durable result.
        if lease.terminal:
            release_terminal_leases()
            raise
        try:
            terminal = _finish_singleflight_failure(lease, error)
        finally:
            release_terminal_leases()
        print(
            "commit-verified-v2-workflow-results: TERMINAL failure run_id=" +
            lease.run_id + " fingerprint=" + lease.fingerprint +
            " result_sha256=" + terminal["result_sha256"],
            file=sys.stderr, flush=True)
        raise
    # Terminal durability, not downstream stdout backpressure, is the lease
    # boundary. A slow pipe (or KeyboardInterrupt while printing) must never
    # retain the heavy/global locks or rewrite a durable success as failure.
    release_terminal_leases()
    try:
        print(stdout, end="", flush=True)
    except (BrokenPipeError, OSError):
        # The ref and terminal are durable. A closed stdout is not a Git
        # failure and future identical joiners can replay the result.
        return 0
    return 0


def _normal_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--kind", choices=(
            "mass", "review", "canonical-id-repair", "semantic-recut"))
    parser.add_argument("--root", type=pathlib.Path, default=INSTALL_ROOT)
    parser.add_argument("--queue", type=pathlib.Path)
    parser.add_argument("--results", default="-")
    parser.add_argument("--target")
    parser.add_argument("--message")
    parser.add_argument(
        "--retry-failed",
        help="retry somente o terminal failure cujo SHA-256 é informado")
    parser.add_argument("--recover-prepared-index", action="store_true")
    parser.add_argument(
        "--reopen-family",
        help="family_key SHA-256 do circuit-open a reabrir com motivo gravado")
    parser.add_argument(
        "--reopen-reason",
        help="motivo real e auditável do reopen (censo/RCA), gravado no ledger")
    arguments = parser.parse_args(argv)
    if (arguments.reopen_family is not None or
            arguments.reopen_reason is not None):
        if (arguments.reopen_family is None or
                arguments.reopen_reason is None or
                arguments.kind is not None or arguments.queue is not None or
                arguments.target is not None or arguments.results != "-" or
                arguments.message is not None or
                arguments.retry_failed is not None or
                arguments.recover_prepared_index):
            parser.error(
                "--reopen-family exige --reopen-reason e não aceita outro modo")
        root = arguments.root.resolve(strict=True)
        if (root != INSTALL_ROOT and
                os.environ.get("WIKI_VERIFY_V2_TEST_ROOT") != "1"):
            raise CommitVerificationError(
                "reopen-family exige o repositório canônico instalado")
        reopen_report = _reopen_unit_family(
            root, arguments.reopen_family, arguments.reopen_reason)
        try:
            print(
                _canonical_json(reopen_report).decode("utf-8"),
                end="", flush=True)
        except (BrokenPipeError, OSError):
            return 0
        return 0
    if arguments.recover_prepared_index:
        if (arguments.kind is not None or arguments.queue is not None or
                arguments.target is not None or
                arguments.results != "-" or arguments.message is not None or
                arguments.retry_failed is not None):
            parser.error(
                "--recover-prepared-index não aceita workflow/results/message")
        root = arguments.root.resolve(strict=True)
        if (root != INSTALL_ROOT and
                os.environ.get("WIKI_VERIFY_V2_TEST_ROOT") != "1"):
            raise CommitVerificationError(
                "recovery exige o repositório canônico instalado")
        print(_canonical_json(
            _recover_prepared_main_index(root)).decode("utf-8"),
              end="", flush=True)
        return 0
    if arguments.kind is None or arguments.message is None:
        parser.error("--kind e --message são obrigatórios no modo workflow")
    if arguments.kind == "canonical-id-repair":
        if (arguments.target is None or arguments.queue is not None or
                arguments.results != "-"):
            parser.error(
                "canonical-id-repair exige --target e não aceita queue/results")
        root = arguments.root.resolve(strict=True)
        if (root != INSTALL_ROOT and
                os.environ.get("WIKI_VERIFY_V2_TEST_ROOT") != "1"):
            raise CommitVerificationError(
                "canonical-id-repair exige o repositório canônico instalado")
        # Load the exact closed auditor/helper closure before deriving authority.
        # Its bindings then become repository dependencies of the commit epoch.
        _load_verifier()
        transaction = _build_canonical_id_repair_transaction(
            root, arguments.target)
        return _commit_transaction(
            transaction, arguments.message,
            retry_failed=arguments.retry_failed)
    if arguments.kind == "semantic-recut":
        if (arguments.target is not None or arguments.queue is not None or
                arguments.results != "-"):
            parser.error(
                "semantic-recut não aceita target/queue/results; closure é derivada")
        root = arguments.root.resolve(strict=True)
        if (root != INSTALL_ROOT and
                os.environ.get("WIKI_VERIFY_V2_TEST_ROOT") != "1"):
            raise CommitVerificationError(
                "semantic-recut exige o repositório canônico instalado")
        _load_verifier()
        try:
            transaction = _build_semantic_recut_transaction(root)
        except SemanticRecutNoStagedDelta as error:
            replay_report = _semantic_recut_landed_no_op(root)
            if replay_report is not None:
                try:
                    print(
                        _canonical_json(replay_report).decode("utf-8"),
                        end="", flush=True)
                except (BrokenPipeError, OSError):
                    return 0
                return 0
            # Every consumed/empty channel must declare its succession route
            # in the error itself (RCA D4.8 §4.4) — never a dead end that
            # invites envelope fabrication.
            raise CommitVerificationError(
                str(error) + "; sem unidade pousada correspondente no " +
                UNIT_LEDGER_REL + ". Rota de sucessão sancionada: re-derivar "
                "a fila do portfólio (tools/generate_v2_review_queue.py), "
                "produzir páginas pelo writing-mass validando bytes vivos, "
                "verificar com tools/verify-v2-workflow-results e então "
                "commit-verified — novos input_oids staged produzem unit_key "
                "novo e pousam; jamais fabricar envelope/páginas órfãs"
            ) from error
        return _commit_transaction(
            transaction, arguments.message,
            retry_failed=arguments.retry_failed)
    if arguments.target is not None:
        parser.error("--target pertence somente a canonical-id-repair")
    verifier = _load_verifier()
    verifier_argv = [
        "--kind", arguments.kind,
        "--root", os.fspath(arguments.root),
        "--results", arguments.results,
    ]
    if arguments.queue is not None:
        verifier_argv.extend(["--queue", os.fspath(arguments.queue)])
    return verifier.main(
        verifier_argv,
        verified_consumer=lambda transaction: _commit_transaction(
            transaction, arguments.message,
            retry_failed=arguments.retry_failed),
    )


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    return _normal_main(arguments)


def _entrypoint(argv: list[str] | None = None) -> int:
    try:
        return main(argv)
    except CommitBusy as error:
        print(
            f"commit-verified-v2-workflow-results: {error}",
            file=sys.stderr)
        return 75
    except CommitVerificationError as error:
        print(
            f"commit-verified-v2-workflow-results: {error}",
            file=sys.stderr)
        return 1
    except Exception as error:
        if type(error).__name__ == "LockBusy":
            print(
                f"commit-verified-v2-workflow-results: {error}",
                file=sys.stderr)
            return 75
        print(
            f"commit-verified-v2-workflow-results: {error}",
            file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(_entrypoint())
