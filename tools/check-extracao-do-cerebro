#!/usr/bin/env bash
# check-extracao-do-cerebro — o produto da IA local ainda está ancorado no texto?
# READ-ONLY: não escreve em data/, content/, public/ nem na fila.
#
# ★ O BURACO QUE ELE FECHA (§P10 do plano do cérebro, e B20 do ESTADO)
#
# Até 2026-09-16, NENHUM gate deste repositório lia
# `data/ai/extracoes_dispositivos.jsonl` nem `data/ai/dispositivos_promovidos.jsonl`
# — a qualidade era real e não era guardada por nada automático. E
# `data/ai/grafo_manifest.json`, produzido todo dia às 06:51, tinha UM leitor:
# `tools/test_grafo_juridico.py`. Teste não é consumidor de produção.
#
# ★ OS TRÊS PREDICADOS
#
#   ÂNCORA LITERAL      100,0000% dos itens da última linha por `chave` têm
#                       `texto_citado`. Medido no dia em que nasceu: 105.936
#                       itens em 36.334 chaves, ZERO sem âncora.
#   PROMOÇÃO            toda URN e toda súmula de `dispositivos_promovidos.jsonl`
#                       casa item ANCORADO da extração do mesmo `id_fonte`.
#                       Medido: 35.151 promoções, ZERO órfãs.
#   MANIFESTO DO GRAFO  coerência interna (total × soma por tipo, vizinhança ×
#                       nós), tamanhos declarados × `stat` do disco,
#                       `acordaos_fora_do_grafo == 0` e frescor de 30 h.
#
# ★ O VERDE DAQUI NÃO É PROVA DE QUALIDADE DE ATRIBUIÇÃO, e isto não é modéstia.
# `internal/cerebro/extracao.go:604` descarta o item não-ancorado ANTES de
# gravar: medir o arquivo prova que o FILTRO RODOU, não que a URN aponta o
# dispositivo certo. O trecho pode ocorrer no texto e a URN apontar outra coisa.
# Quem mede atribuição é leitura humana sobre amostra por stride
# (`tools/check-extracao-por-parser-amostra`), e nenhum exit code a substitui.
#
# Este gate é guarda contra REGRESSÃO: ele pega o dia em que o filtro parar de
# rodar, o dia em que a promoção passar a inventar aresta, e o dia em que o
# manifesto passar a descrever um grafo que não está mais no disco.
#
# O motor é internal/checks e é o MESMO que o gate "extracao-do-cerebro" executa
# pelo runner.
#
#   tools/check-extracao-do-cerebro
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e não `go-modern run ./cmd/check` direto: é por ele que passam o
# cache do binário, o teto de tempo e a política de argumentos.
exec "$ROOT/tools/run-check" extracao-do-cerebro --timings "$@"
