#!/usr/bin/env python3
"""measure-bcb-normativo-servable-address-20260812 — o endereço citado responde 200 e não entrega norma nenhuma.

O DEFEITO. `www.bcb.gov.br/estabilidadefinanceira/exibenormativo?...` é uma
casca Angular: 2.866 bytes, 114 caracteres de texto visível, cujo conteúdo é
"Essa pagina depende do javascript para abrir, favor habilitar". Quem audita a
página segue o link e não encontra o articulado. A norma citada está certa; o
endereço é que não a serve.

O QUE ESTA FERRAMENTA FAZ. Para cada norma citada pelas páginas atingidas,
procura o endereço que ENTREGA o texto e MEDE o que ele devolve, com o mesmo
instrumento de `measure-official-source-content-evidence-20260812` (piso de 500
caracteres de texto visível, >= 3 marcas de dispositivo, `%PDF-` aceito como
documento). Dois canais, ambos dentro do allowlist de fonte oficial:

  in.gov.br  — matéria do Diário Oficial da União, renderizada no servidor.
               Descoberta por busca do DOU e, quando o índice de busca falha,
               pela leitura do jornal do dia (`/leiturajornal`), que lista as
               matérias publicadas naquela seção. Nunca por slug inventado.
  bcb.gov.br — PDF legado em /pre/normativos/res/<ano>/pdf/, para as normas
               anteriores ao acervo digital do DOU.

O TESTE QUE DECIDE A TROCA não é "responde 200" nem "tem articulado": é o
DISPOSITIVO RECLAMADO aparecer no texto medido do endereço novo. O DOU serve o
texto ORIGINAL; citação que promete redação consolidada por norma posterior
não se satisfaz com ele, e nesse caso a ferramenta marca `dispositivo_ausente`
— fail-closed, sem troca.

Read-only sobre o acervo: NÃO escreve em data/editorial. A saída é a evidência
em data/ops/, consumida pelo gerador datado que aplica a troca.
"""
import json
import os
import re
import subprocess
import sys
import time
import hashlib
import urllib.parse
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SAIDA = ROOT / "data/ops/bcb_normativo_servable_address_20260812.jsonl"
CACHE = Path(os.environ.get("BCB_SERVABLE_CACHE", "/tmp/wiki-bcb-servable-20260812"))
# Identidade canonica (CLAUDE.md secao 11). Medido em 2026-09-05: www.bcb.gov.br
# 200/2.871 B (estabilidadefinanceira/pix); normativos.bcb.gov.br 404/724 B
# (mesmo 404 que o baseline do docstring registra -- endereco morto, nao
# rejeicao de UA). www.in.gov.br devolveu HTTP/2 PROTOCOL_ERROR (curl 92) e
# "Empty reply" em --http1.1, igual ao que tools/check-fonte-oficial-alcancavel
# ja documenta para este host (apex com problema de rede, independente de UA) --
# e o robots.txt dele nega tudo (Disallow: /), conforme o mesmo doc.
USER_AGENT = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
              "+https://wikijuridica.com.br/bot/; verificacao-de-fonte)")

PISO_TEXTO = 500
MINIMO_MARCAS = 3
SEM_TEXTO = re.compile(rb"(?is)<(script|style|noscript|template)\b.*?</\1>")
TAG = re.compile(rb"(?s)<[^>]*>")
ENTIDADE = re.compile(r"&[a-zA-Z]+;|&#\d+;")
ESPACO = re.compile(r"\s+")
MARCA_NORMATIVA = re.compile(
    r"(?i)\bart(?:\.|igos?|icolos?|ículos?|icles?)?\s*\.?\s*\d"
    r"|§\s*\d"
    r"|\bparágrafo único\b"
    r"|\bincis[oa]\b"
    r"|\bcaput\b")

_ultimo_por_host: dict[str, float] = {}


def busca_rede(url: str) -> tuple[bytes, int]:
    CACHE.mkdir(parents=True, exist_ok=True)
    chave = CACHE / (hashlib.sha256(url.encode()).hexdigest() + ".bin")
    if chave.exists():
        return chave.read_bytes(), 200
    host = urllib.parse.urlsplit(url).netloc
    espera = 1.1 - (time.time() - _ultimo_por_host.get(host, 0.0))
    if espera > 0:
        time.sleep(espera)
    tmp = str(chave) + ".tmp"
    proc = subprocess.run(
        ["curl", "-sL", "-A", USER_AGENT, "--max-time", "60", "-o", tmp, "-w", "%{http_code}", url],
        capture_output=True, text=True, check=False)
    _ultimo_por_host[host] = time.time()
    try:
        status = int((proc.stdout or "0").strip() or 0)
    except ValueError:
        status = 0
    corpo = Path(tmp).read_bytes() if Path(tmp).exists() else b""
    if status == 200 and corpo:
        os.replace(tmp, chave)
    elif Path(tmp).exists():
        os.remove(tmp)
    return corpo, status


def texto_visivel(bruto: bytes) -> str:
    limpo = TAG.sub(b" ", SEM_TEXTO.sub(b" ", bruto))
    try:
        texto = limpo.decode("utf-8")
    except UnicodeDecodeError:
        texto = limpo.decode("latin-1", "replace")
    return ESPACO.sub(" ", ENTIDADE.sub(" ", texto)).strip()


def texto_de_pdf(bruto: bytes) -> str:
    tmp = CACHE / ("pdf-" + hashlib.sha256(bruto).hexdigest()[:16] + ".pdf")
    tmp.write_bytes(bruto)
    proc = subprocess.run(["pdftotext", "-layout", str(tmp), "-"],
                          capture_output=True, check=False)
    return ESPACO.sub(" ", proc.stdout.decode("utf-8", "replace")).strip()


def mede(url: str) -> dict:
    bruto, status = busca_rede(url)
    reg = {"url": url, "http_status": status, "bytes": len(bruto),
           "sha256_documento": hashlib.sha256(bruto).hexdigest() if bruto else ""}
    if not bruto:
        reg.update({"midia": "", "faixa": "corpo_ausente", "tem_evidencia_de_conteudo": False,
                    "texto_visivel_chars": 0, "marcas_normativas": 0, "texto": ""})
        return reg
    if bruto[:5] == b"%PDF-":
        texto = texto_de_pdf(bruto)
        reg.update({"midia": "pdf", "faixa": "documento_pdf", "tem_evidencia_de_conteudo": True,
                    "texto_visivel_chars": len(texto),
                    "marcas_normativas": len(MARCA_NORMATIVA.findall(texto)), "texto": texto})
        return reg
    texto = texto_visivel(bruto)
    marcas = len(MARCA_NORMATIVA.findall(texto))
    if marcas >= MINIMO_MARCAS:
        faixa, evidencia = "articulado_no_texto", True
    elif len(texto) >= PISO_TEXTO:
        faixa, evidencia = "conteudo_sem_articulado", True
    else:
        faixa, evidencia = "casca_sem_conteudo", False
    reg.update({"midia": "html", "faixa": faixa, "tem_evidencia_de_conteudo": evidencia,
                "texto_visivel_chars": len(texto), "marcas_normativas": marcas, "texto": texto})
    return reg


def busca_dou(frase: str, **filtros) -> list[dict]:
    p = {"q": '"%s"' % frase, "s": filtros.pop("secao", "do1"), "sortType": "0",
         "delta": filtros.pop("delta", "30")}
    if filtros.get("de"):
        p.update({"exactDate": "personalizado", "publishFrom": filtros["de"],
                  "publishTo": filtros["ate"]})
    else:
        p["exactDate"] = "all"
    bruto, _ = busca_rede("https://www.in.gov.br/consulta/-/buscar/dou?" + urllib.parse.urlencode(p))
    return _materias(bruto)


def leitura_jornal(data: str, secao: str = "do1") -> list[dict]:
    bruto, _ = busca_rede("https://www.in.gov.br/leiturajornal?" +
                          urllib.parse.urlencode({"data": data, "secao": secao}))
    return _materias(bruto)


def _materias(bruto: bytes) -> list[dict]:
    html = bruto.decode("utf-8", "replace")
    # O bloco JSON precisa ser delimitado pelo ÚLTIMO "}" antes do </script>:
    # o conteúdo das matérias embute "</script>" em texto citado, e cortar no
    # primeiro fechamento parte o JSON no meio e devolve lista vazia — falso
    # "matéria não localizada" que já custou uma rodada inteira de medição.
    decodificador = json.JSONDecoder()
    for marca in ("_br_com_seatecnologia_in_buscadou_BuscaDouPortlet_params", "params"):
        abertura = '<script id="%s" type="application/json">' % marca
        i = html.find(abertura)
        if i < 0:
            continue
        inicio = html.find("{", i + len(abertura))
        if inicio < 0:
            continue
        try:
            dado, _ = decodificador.raw_decode(html, inicio)
        except json.JSONDecodeError:
            continue
        materias = dado.get("jsonArray", [])
        # A página do jornal do dia embute TAMBÉM o bloco do portlet de busca,
        # vazio, e ele aparece primeiro no HTML. Parar nele devolvia lista vazia
        # e classificava como "matéria não localizada" norma que estava lá.
        if materias:
            return materias
    return []


def main() -> int:
    plano = json.loads((ROOT / "tools" / (Path(__file__).name + ".plano.json")).read_text("utf-8"))
    saida = []
    for item in plano["normas"]:
        reg = {"schema_version": "bcb_normativo_servable_address_v1",
               "medido_em": "2026-08-12", "norma": item["norma"]}
        alvo = item.get("url_servivel")
        if not alvo:
            pref = item["slug_prefixo"]
            achados = []
            if item.get("busca"):
                achados = [m for m in busca_dou(item["busca"], de=item.get("de"), ate=item.get("ate"))
                           if m["urlTitle"].startswith(pref)]
            if not achados and item.get("jornal"):
                achados = [m for m in leitura_jornal(item["jornal"])
                           if m.get("urlTitle", "").startswith(pref)]
            if not achados:
                reg.update({"resolvido": False, "motivo": "materia nao localizada no DOU"})
                saida.append(reg)
                print(json.dumps(reg, ensure_ascii=False))
                continue
            reg["candidatos_dou"] = [a["urlTitle"] for a in achados]
            alvo = "https://www.in.gov.br/web/dou/-/" + achados[0]["urlTitle"]
            reg["publicado_em"] = achados[0].get("pubDate", "")
        medida = mede(alvo)
        texto = medida.pop("texto")
        reg.update(medida)
        reg["resolvido"] = medida["tem_evidencia_de_conteudo"]
        achou = {}
        for chave, alvo_re in item["dispositivos"].items():
            m = re.search(alvo_re, texto, re.I)
            achou[chave] = ("" if not m else
                            texto[max(0, m.start() - 80):m.start() + 260])
        reg["dispositivos"] = achou
        reg["dispositivo_ausente"] = sorted(k for k, v in achou.items() if not v)
        saida.append(reg)
        print(json.dumps({k: v for k, v in reg.items() if k != "dispositivos"}, ensure_ascii=False))
    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    with open(SAIDA, "w", encoding="utf-8") as fh:
        for reg in saida:
            fh.write(json.dumps(reg, ensure_ascii=False, sort_keys=True) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    resolvidas = sum(1 for r in saida if r.get("resolvido"))
    print("gravado %s — %d normas, %d com endereço que entrega texto" %
          (SAIDA, len(saida), resolvidas), file=sys.stderr)
    # Zero resolvido significa rede/parse quebrados, não "nenhuma norma existe":
    # sair 0 nesse caso mascararia falha de ferramenta como resultado medido.
    return 0 if resolvidas else 1


if __name__ == "__main__":
    sys.exit(main())
