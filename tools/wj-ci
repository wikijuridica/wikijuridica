#!/usr/bin/env bash
# tools/wj-ci — o CI da árvore wj/ (F0.O7): depcheck, vet e testes; para no
# primeiro vermelho.
#
# PORQUE: a TASKLIST F0.O7 pede "depcheck → wjlint → TLC → go test, falha no
# primeiro vermelho", e o CANON §5 manda verificar o deps.yml ANTES do go test.
# O repositório não tem Taskfile (decisão do chefe no barramento, achado 5): o CI
# de wj/ entra por aqui e pela rodada diária (tools/run-qualidade-diaria, etapa
# wj-ci). wjlint (F4.O2) e TLC (EscalonadorGPU.tla, PromocaoModelo.tla) entram
# entre o depcheck e o vet quando existirem.
#
# Nenhum outro executor alcança wj/: tools/go-build-check e a suíte completa da
# rodada diária varrem ./internal/... ./cmd/..., e o teste focado do pre-commit
# só olha ^(internal|cmd)/.
#
# Exit 0 = verde; 1 = vermelho (depcheck, vet ou teste); 2 = erro do depcheck ou
# do wj-enums: deps.yml, go list, compilação, enums.yaml inválido ou alvo
# divergente; 75 (EX_TEMPFAIL) = sem headroom de carga — nada foi medido, e a
# rodada diária registra "infra", não vermelho.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Egresso zero em build (S4): nenhum download de toolchain.
export GOTOOLCHAIN=local

if ! tools/check-load-headroom --max 12; then
	echo "wj-ci: sem headroom de carga; nada foi medido" >&2
	exit 75
fi

tools/wj-depcheck
tools/wj-enums --check  # F0.O2: exit 2 = enum divergente da fonte única (alvo editado à mão) ou erro
tools/wj-claims --check  # F2.O3: 11 exemplos · 27 ataques · 58 positivos; exit 2 se o placar divergir

# CACHE-BUSTER (BUG-107, ver tools/go-build-check): o cache de vet deste
# repositório já devolveu verde para pacote com diagnóstico; a tag descartável
# muda só a chave de cache. devcmds põe os dev-mains de wj/cmd/ no vet (o
# tools/go-modern só injeta a tag em run e test).
VET_NONCE="vetfrio$(date -u +%Y%m%d%H%M%S)"
./tools/run-heavy-throttled ./tools/go-modern vet -tags "devcmds,${VET_NONCE}" ./wj/...
./tools/run-heavy-throttled ./tools/go-modern test -count=1 ./wj/...
echo "wj-ci: verde (depcheck, vet e testes de ./wj/...)"
