#!/usr/bin/env python3
"""A gemea SERVIDA e o HTML de public/ tem de contar a mesma historia. READ-ONLY.

O DEFEITO QUE ELE EXISTE PARA PEGAR, medido em 2026-09-16 (P1b / B21)
=====================================================================
O conserto das 942 paginas com cronologia impossivel terminou com o HTML certo
no disco e no ar — e a GEMEA MARKDOWN ainda servindo a data falsa. A causa nao
estava no gerador nem no publicador: o processo Go carregava o `pages.json` das
06:51 contra o arquivo das 10:54, porque `tools/reload-wiki-server` NAO reinicia
quando o conjunto de rotas nao muda. `systemctl restart wikijuridica-server`
fechou o buraco.

Nenhum instrumento do repositorio enxergava isso, e a razao e' topologica:

  tools/check-static-freshness   compara public/ com o que o render PRODUZ
  tools/check-paridade-go-nginx  compara nginx com Go na MESMA rota dinamica
  internal/checks cronologia-de-publicacao  le public/ e so' public/

O acervo sai ESTATICO do disco (nginx -> public/) e a gemea sai do PROCESSO Go,
de uma copia de `pages.json` carregada no boot. Sao duas fontes de verdade para
a mesma URL, e o unico jeito de saber que elas divergiram e' perguntar as duas.
Divergencia aqui significa que um dos dois canais esta servindo estado velho —
e quem le a gemea e' exatamente o agente de IA que este portal quer citar.

O QUE ELE COMPARA, por rota amostrada
=====================================
  date_published  x  datePublished do JSON-LD
  date_modified   x  dateModified  do JSON-LD
  title           x  <h1> do HTML          <- NAO o <title>. Ver abaixo.
  url             x  <link rel=canonical>

O FALSO POSITIVO QUE A PRIMEIRA VERSAO DESTE GATE PRODUZIU (2026-09-16)
=======================================================================
Ele comparava `title` da gemea com o `<title>` do HTML e acusou 36 divergencias
em 40 rotas amostradas — 90%, com TODAS as datas batendo. O defeito era do
detector: `<title>` e' o titulo de BUSCA e o `<h1>` e' o titulo do DOCUMENTO, e
eles divergem POR DESENHO. Medido em /familia/pensao-para-pais-idosos/:

  <title>  Pensão para pais idosos: filhos são obrigados?
  <h1>     Filhos precisam pagar pensão para os pais idosos?
  gemea    title: "Filhos precisam pagar pensão para os pais idosos?"

A gemea carrega o titulo do DOCUMENTO. O par certo e' `title` x `<h1>`, e um
detector que nasce com 90% de falso positivo sobre amostra real nao mede o
portal: mede a propria regua.

As datas se comparam por STRING EXATA, nao por dia. Comparar por dia esconderia
metade do defeito: `2026-09-10` e `2026-09-10T17:22:26Z` sao o mesmo dia e sao
bytes diferentes para quem cita, e no acervo as duas formas convivem — 85 rotas
trazem timestamp em `content_revised_at` e 11.064 trazem data pura (medido em
content/pages.json, 2026-09-16). A pergunta deste gate e' "os dois canais
servem o MESMO documento?", e a resposta certa e' byte a byte.

AMOSTRA POR PASSO DETERMINISTICO, nunca por prefixo
===================================================
As rotas saem ordenadas do `published_manifest` e sao pegas de N em N. Prefixo
conveniente ("as 40 primeiras") mede uma area so': o acervo esta agrupado por
pasta, e /administrativo/ nasceu no mesmo lote.

SEM SINAL NAO E' APROVACAO
==========================
Servidor fora do ar, amostra vazia ou manifesto ilegivel saem com EXIT 2 —
veredito sobre o INSTRUMENTO. Um gate que devolve 0 quando nao conseguiu medir
e' pior que gate nenhum: ele compra confianca com silencio, que e' o modo de
falha ja catalogado neste repositorio em outros seis instrumentos.
"""
import argparse
import json
import os
import re
import subprocess
import sys

MANIFESTO = "data/editorial/published_manifest.jsonl"
# Identidade JA DECLARADA no contrato de sondas (tools/check-sonda-interna-declarada:73).
# Sonda nova com nome novo viraria agente desconhecido na propria medicao de bots.
AGENTE = "wikijuridica-superficie-probe/1.0"

JSONLD = re.compile(r'<script type="application/ld\+json">(.*?)</script>', re.S)
CANONICAL = re.compile(r'<link rel="canonical" href="([^"]+)"')
H1 = re.compile(r"<h1[^>]*>(.*?)</h1>", re.S)
MARCACAO = re.compile(r"<[^>]+>")


def rotas_do_manifesto(raiz):
    caminho = os.path.join(raiz, MANIFESTO)
    rotas = []
    with open(caminho, encoding="utf-8") as f:
        for linha in f:
            s = linha.strip()
            if not s:
                continue
            reg = json.loads(s)
            rota = (reg.get("path") or "").strip()
            if rota.startswith("/"):
                rotas.append(rota)
    return sorted(set(rotas))


def campos_do_html(caminho):
    with open(caminho, encoding="utf-8", errors="replace") as f:
        html = f.read()
    achados = {"datePublished": None, "dateModified": None}
    for bruto in JSONLD.findall(html):
        try:
            no = json.loads(bruto)
        except json.JSONDecodeError:
            continue
        for item in (no if isinstance(no, list) else [no]):
            if not isinstance(item, dict):
                continue
            grafo = item.get("@graph") if isinstance(item.get("@graph"), list) else [item]
            for g in grafo:
                if not isinstance(g, dict):
                    continue
                for campo in ("datePublished", "dateModified"):
                    if achados[campo] is None and isinstance(g.get(campo), str):
                        achados[campo] = g[campo]
    can = CANONICAL.search(html)
    h1 = H1.search(html)
    achados["canonical"] = can.group(1) if can else None
    # O H1 pode trazer marcacao inline (<em>, <span>); a comparacao e' sobre o
    # texto que o leitor ve, nao sobre o HTML que o envolve.
    achados["h1"] = MARCACAO.sub("", h1.group(1)).strip() if h1 else None
    return achados


def campos_da_gemea(base, rota, timeout_s):
    url = f"{base}{rota}index.md"
    proc = subprocess.run(
        ["curl", "-sS", "--max-time", str(timeout_s), "-A", AGENTE,
         "-H", "X-Warming-Request: true", "-w", "\n%{http_code}", url],
        capture_output=True, text=True, timeout=timeout_s + 10)
    corte = proc.stdout.rfind("\n")
    if corte < 0:
        return None, 0
    corpo, status = proc.stdout[:corte], proc.stdout[corte + 1:].strip()
    try:
        status = int(status)
    except ValueError:
        status = 0
    campos = {}
    for linha in corpo.split("\n"):
        m = re.match(r'^(title|url|date_published|date_modified):\s*"?(.*?)"?\s*$', linha)
        if m and m.group(1) not in campos:
            campos[m.group(1)] = m.group(2)
        if linha.startswith("---") and campos:
            break
    return campos, status


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--raiz", default=os.environ.get("WIKI_RAIZ", "/opt/wiki"))
    ap.add_argument("--base", default=os.environ.get("WIKI_BASE_ORIGEM", "http://127.0.0.1:8089"))
    ap.add_argument("--amostra", type=int, default=40, help="quantas rotas comparar (passo deterministico)")
    ap.add_argument("--timeout", type=int, default=15)
    args = ap.parse_args()
    raiz = os.path.abspath(args.raiz)

    try:
        rotas = rotas_do_manifesto(raiz)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"check-gemea-espelha-public: INSTRUMENTO: {MANIFESTO} ilegivel ({exc})", file=sys.stderr)
        return 2
    if len(rotas) < args.amostra:
        print(f"check-gemea-espelha-public: INSTRUMENTO: manifesto tem {len(rotas)} rota(s), "
              f"menos que a amostra pedida ({args.amostra}) — gate sem piso aprova o vazio", file=sys.stderr)
        return 2

    passo = max(1, len(rotas) // args.amostra)
    amostra = rotas[::passo][:args.amostra]

    comparadas, divergencias, sem_html, sem_gemea = 0, [], [], []
    for rota in amostra:
        caminho = os.path.join(raiz, "public", rota.strip("/"), "index.html")
        if not os.path.exists(caminho):
            sem_html.append(rota)
            continue
        html = campos_do_html(caminho)
        gemea, status = campos_da_gemea(args.base, rota, args.timeout)
        if status != 200 or not gemea:
            sem_gemea.append(f"{rota} (HTTP {status})")
            continue
        comparadas += 1
        pares = (
            ("date_published", gemea.get("date_published"), html.get("datePublished")),
            ("date_modified", gemea.get("date_modified"), html.get("dateModified")),
            ("title/h1", gemea.get("title"), html.get("h1")),
            ("url", gemea.get("url"), html.get("canonical")),
        )
        for campo, na_gemea, no_html in pares:
            if na_gemea is None or no_html is None:
                divergencias.append(f"{rota} [{campo}] gemea={na_gemea!r} html={no_html!r} — campo ausente de um dos canais")
            elif na_gemea != no_html:
                divergencias.append(f"{rota} [{campo}] gemea={na_gemea!r} html={no_html!r}")

    if sem_gemea and not comparadas:
        print(f"check-gemea-espelha-public: INSTRUMENTO: nenhuma gemea respondeu em {args.base} "
              f"({len(sem_gemea)} tentativas) — sem sinal nao e' aprovacao", file=sys.stderr)
        for r in sem_gemea[:5]:
            print(f"  {r}", file=sys.stderr)
        return 2
    if comparadas < args.amostra // 2:
        print(f"check-gemea-espelha-public: INSTRUMENTO: so' {comparadas} de {len(amostra)} rotas foram "
              f"comparadas (piso: metade da amostra) — o veredito seria sobre o vazio", file=sys.stderr)
        for r in (sem_html[:3] + sem_gemea[:3]):
            print(f"  {r}", file=sys.stderr)
        return 2

    print(f"check-gemea-espelha-public: {comparadas} rota(s) comparadas em {len(rotas)} do manifesto "
          f"(passo {passo}); base {args.base}")
    if sem_html:
        print(f"  sem HTML em public/: {len(sem_html)} (ex.: {', '.join(sem_html[:3])})")
    if sem_gemea:
        print(f"  gemea nao respondeu: {len(sem_gemea)} (ex.: {', '.join(sem_gemea[:3])})")

    if divergencias:
        print(file=sys.stderr)
        for d in divergencias[:40]:
            print(f"check-gemea-espelha-public: DIVERGENCIA {d}", file=sys.stderr)
        print(f"\ncheck-gemea-espelha-public: REPROVADO — {len(divergencias)} divergencia(s) entre a gemea "
              "servida pelo processo e o HTML de public/; um dos dois canais esta servindo estado velho "
              "(o caso conhecido e' o processo Go com pages.json anterior ao ultimo deploy: "
              "tools/reload-wiki-server nao reinicia quando o conjunto de rotas nao muda)", file=sys.stderr)
        return 1
    print("check-gemea-espelha-public: pass — os dois canais servem o mesmo documento nas rotas amostradas")
    return 0


if __name__ == "__main__":
    sys.exit(main())
