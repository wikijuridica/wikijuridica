#!/usr/bin/env python3
"""tools/consultar-grafo — resolve uma chave exata ou termo (FTS5) contra
data/ai/grafo.sqlite e imprime o no e seus vizinhos.

E a base da futura ferramenta MCP `grafo(entidade)` em Go: a saida --json e o
contrato estavel que aquele endpoint vai reexpor.

Uso:
    tools/consultar-grafo "Código Civil"
    tools/consultar-grafo "urn:lex:br:federal:lei:2002-01-10;10406" --json
    tools/consultar-grafo --db data/ai/grafo.sqlite --profundidade 2 "STF"
"""
import argparse
import json
import os
import sqlite3
import sys

ROOT_PADRAO = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))


def resolver_no(conn, termo):
    row = conn.execute(
        "SELECT id, tipo, chave, rotulo, atributos FROM nos WHERE chave = ?", (termo,)
    ).fetchone()
    if row:
        return row
    try:
        row = conn.execute(
            "SELECT n.id, n.tipo, n.chave, n.rotulo, n.atributos FROM nos_fts f "
            "JOIN nos n ON n.id = f.rowid WHERE nos_fts MATCH ? ORDER BY rank LIMIT 1",
            (termo,),
        ).fetchone()
    except sqlite3.OperationalError:
        row = None
    return row


def no_para_dict(row):
    id_, tipo, chave, rotulo, atributos = row
    return {"id": id_, "tipo": tipo, "chave": chave, "rotulo": rotulo, "atributos": json.loads(atributos)}


def vizinhos_diretos(conn, no_id):
    saida = []
    for tipo_aresta, alvo_id, peso, fonte, n_tipo, n_chave, n_rotulo, n_atributos in conn.execute(
        "SELECT a.tipo, a.destino, a.peso, a.fonte, n.tipo, n.chave, n.rotulo, n.atributos "
        "FROM arestas a JOIN nos n ON n.id = a.destino WHERE a.origem = ? ORDER BY a.tipo, n.chave",
        (no_id,),
    ):
        saida.append({
            "tipo_aresta": tipo_aresta, "direcao": "saida", "peso": peso, "fonte": fonte,
            "no": {"id": alvo_id, "tipo": n_tipo, "chave": n_chave, "rotulo": n_rotulo, "atributos": json.loads(n_atributos)},
        })
    for tipo_aresta, alvo_id, peso, fonte, n_tipo, n_chave, n_rotulo, n_atributos in conn.execute(
        "SELECT a.tipo, a.origem, a.peso, a.fonte, n.tipo, n.chave, n.rotulo, n.atributos "
        "FROM arestas a JOIN nos n ON n.id = a.origem WHERE a.destino = ? ORDER BY a.tipo, n.chave",
        (no_id,),
    ):
        saida.append({
            "tipo_aresta": tipo_aresta, "direcao": "entrada", "peso": peso, "fonte": fonte,
            "no": {"id": alvo_id, "tipo": n_tipo, "chave": n_chave, "rotulo": n_rotulo, "atributos": json.loads(n_atributos)},
        })
    return saida


def vizinhos(conn, no_id, profundidade, limite):
    visitado = {no_id}
    fronteira = [no_id]
    resultado = []
    for nivel in range(1, max(profundidade, 1) + 1):
        proxima = []
        for atual in fronteira:
            for item in vizinhos_diretos(conn, atual):
                item["profundidade"] = nivel
                resultado.append(item)
                if len(resultado) >= limite:
                    return resultado
                alvo_id = item["no"]["id"]
                if alvo_id not in visitado:
                    visitado.add(alvo_id)
                    proxima.append(alvo_id)
        fronteira = proxima
        if not fronteira:
            break
    return resultado


def main():
    ap = argparse.ArgumentParser(description="Consulta o grafo de conhecimento juridico por chave exata ou termo (FTS5).")
    ap.add_argument("termo")
    ap.add_argument("--db", default=os.path.join(ROOT_PADRAO, "data", "ai", "grafo.sqlite"))
    ap.add_argument("--profundidade", type=int, default=1)
    ap.add_argument("--limite", type=int, default=200, help="teto de vizinhos devolvidos (evita explosao em no-hub)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    conn = sqlite3.connect(args.db)
    row = resolver_no(conn, args.termo)
    if row is None:
        print(f"nenhum no encontrado para {args.termo!r}", file=sys.stderr)
        return 1

    no = no_para_dict(row)
    viz = vizinhos(conn, no["id"], args.profundidade, args.limite)

    if args.json:
        print(json.dumps({"no": no, "vizinhos": viz}, ensure_ascii=False))
        return 0

    print(f"{no['tipo']}: {no['rotulo']} ({no['chave']})")
    for v in viz:
        seta = "->" if v["direcao"] == "saida" else "<-"
        print(f"  {seta} {v['tipo_aresta']} {seta} {v['no']['tipo']}:{v['no']['rotulo']} (peso={v['peso']}, fonte={v['fonte']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
