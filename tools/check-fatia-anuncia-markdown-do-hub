#!/usr/bin/env python3
"""check-fatia-anuncia-markdown-do-hub — READ-ONLY.

Reprova quando uma fatia de paginação `/{área}/pagina/N/` materializada em
public/ NÃO anuncia, no `<head>`, o Markdown do hub da área — ou quando anuncia
a gêmea da PRÓPRIA fatia, que responde 404.

O DEFEITO (T8.1 do PLANO_SUPERFICIE_BOTS_20260826, a queixa-manchete do dono),
medido em 2026-08-26 com `-A 'wiki-fase8/1.0' -H 'X-Warming-Request: true'`:

    /familia/pagina/2/ com Accept: text/markdown -> 200 text/html, calado
    /familia/pagina/2/index.md                   -> 404, 7.361 B de HTML
    /familia/index.md                            -> 200, 59.349 B text/markdown
    head de public/familia/pagina/2/index.html   -> ZERO link rel=alternate md
    head de public/familia/index.html            -> anuncia /familia/index.md

São 185 rotas indexáveis mudas num canal que responde por 86,5% do que bot de
IA pede neste portal. A correção está em internal/seo/seo.go
(markdownDiscoveryLink + hubDaFatiaDePaginacao, commit 57ccede0): a fatia passa
a anunciar `{origin}/{área}/index.md`, que é o documento que lista TODOS os
membros da área — superset estrito do que a fatia mostra.

★ ESTE GATE NASCE VERMELHO, E ISSO É O PONTO.

O acervo é servido do DISCO pelo nginx, e o HTML das 185 fatias só carrega a
correção depois que a transação de publicação as reescrever. Rodar a transação
completa AGORA promoveria trabalho de outra frente: o ensaio de 2026-08-26,
depois do commit da correção, acusa

    HTML escrito : 10070 páginas (10070 REESCRITAS)
    hubs de área : 217 rotas (217 REESCRITAS)
    sitemap      : 4 shards reescritos, índice REESCRITO
    feed atom/rss: REESCRITOS

com `data/editorial/published_manifest.jsonl` e o estoque v2 modificados por
outra frente na worktree. Publicar de carona seria promover o que ninguém
reviu — a proibição que o próprio publicador documenta em
cmd/publish-v2-direct/main.go:2281-2286 e a razão de `--only-discovery` existir.

Então a pendência vira INSTRUMENTO em vez de nota: enquanto este gate estiver
vermelho, o disco está atrás da fonte, e o número que ele imprime diz
exatamente quantas fatias faltam. Ele fica verde sozinho na primeira publicação
sancionada — ninguém precisa lembrar.

ARMADILHA QUE ELE TAMBÉM GUARDA: o mapa `$wj_gemea` do nginx exclui
`~^/[^/]+/pagina/` do header `Link`, e isso está CERTO — o header anunciaria
`<canonical>index.md`, que na fatia é 404. Corpo e header divergirem em ALCANCE
não é incoerência; anunciar um 404 seria. Por isso o gate exige o alvo certo e
proíbe o errado, em vez de exigir "algum" anúncio.
"""

from __future__ import annotations

import argparse
import os
import re
import sys

BYTES_DE_CABECA = 16384
ALTERNATE_MD = re.compile(
    rb"""<link\s+rel=["']alternate["']\s+type=["']text/markdown["']\s+href=["']([^"']+)["']""",
    re.IGNORECASE,
)


def fatias(raiz_public: str) -> list[tuple[str, str]]:
    """Devolve (arquivo, área) para cada /{área}/pagina/N/index.html do disco."""
    encontradas: list[tuple[str, str]] = []
    if not os.path.isdir(raiz_public):
        return encontradas
    for area in sorted(os.listdir(raiz_public)):
        pasta_pagina = os.path.join(raiz_public, area, "pagina")
        if not os.path.isdir(pasta_pagina):
            continue
        for numero in sorted(os.listdir(pasta_pagina)):
            arquivo = os.path.join(pasta_pagina, numero, "index.html")
            if os.path.isfile(arquivo):
                encontradas.append((arquivo, area))
    return encontradas


def main() -> int:
    parser = argparse.ArgumentParser(
        description="reprova fatia de paginacao que nao anuncia o Markdown do hub da area"
    )
    parser.add_argument("--root", default=None, help="raiz do repositorio")
    parser.add_argument("--base", default="https://wikijuridica.com.br",
                        help="origem canonica esperada nos href absolutos")
    args = parser.parse_args()

    raiz = os.path.abspath(args.root or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    base = args.base.rstrip("/")

    mudas: list[str] = []
    erradas: list[str] = []
    corretas = 0

    encontradas = fatias(os.path.join(raiz, "public"))
    for arquivo, area in encontradas:
        try:
            with open(arquivo, "rb") as fh:
                cabeca = fh.read(BYTES_DE_CABECA)
        except OSError as erro:
            erradas.append(f"{arquivo}: ilegivel ({erro})")
            continue
        esperado = f"{base}/{area}/index.md".encode()
        alvos = [m.group(1) for m in ALTERNATE_MD.finditer(cabeca)]
        if not alvos:
            mudas.append(arquivo)
            continue
        if esperado in alvos:
            corretas += 1
            continue
        erradas.append(
            f"{arquivo}: anuncia {alvos[0].decode('utf-8', 'replace')} "
            f"em vez de {esperado.decode()} -- a gemea da propria fatia responde 404"
        )

    print(f"check-fatia-anuncia-markdown-do-hub: fatias={len(encontradas)} "
          f"corretas={corretas} mudas={len(mudas)} alvo_errado={len(erradas)}")
    if not encontradas:
        print("nenhuma fatia materializada em public/ -- nada a conferir.")
        return 0
    if not mudas and not erradas:
        print("OK: toda fatia de paginacao aponta o Markdown do hub da area.")
        return 0

    for arquivo in erradas:
        print(f"FALHA: {arquivo}", file=sys.stderr)
    if mudas:
        amostra = ", ".join(os.path.relpath(a, raiz) for a in mudas[:5])
        print(f"FALHA: {len(mudas)} fatia(s) sem <link rel=alternate type=text/markdown> "
              f"-- o disco esta atras de internal/seo/seo.go; a proxima publicacao sancionada "
              f"as reescreve. Amostra: {amostra}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
