#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
cd "$ROOT"

if [[ $# -lt 1 ]]; then
	echo "run-generate-supervised: usage: run-generate-supervised ./cmd/generate-name [args...]" >&2
	exit 64
fi

pkg="$1"
shift
subcmd=""
case "$pkg" in
./cmd/generate)
	# Multiplexed form: `./cmd/generate <subcommand>` routes to the single
	# cmd/generate binary. Everything below (name/producer/material-claim/lock)
	# stays identical to the standalone `./cmd/generate-<subcommand>` form
	# because we reconstruct name="generate-<subcommand>". Additive: the
	# ./cmd/generate-* branch is byte-for-byte unchanged, so the non-migrated
	# tools behave exactly as before.
	if [ "$#" -lt 1 ]; then
		echo "run-generate-supervised: ./cmd/generate requires a subcommand, e.g. ./cmd/generate demand-signals" >&2
		exit 64
	fi
	subcmd="$1"
	shift
	case "$subcmd" in
	'' | -* | *[!a-z0-9-]*)
		echo "run-generate-supervised: invalid subcommand name: $subcmd" >&2
		exit 64
		;;
	esac
	;;
./cmd/generate-*) ;;
*)
	echo "run-generate-supervised: only ./cmd/generate <subcommand> or ./cmd/generate-* packages are allowed, got $pkg" >&2
	exit 64
	;;
esac

json_escape() {
	value="$1"
	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	value="${value//$'\n'/ }"
	value="${value//$'\r'/ }"
	printf '%s' "$value"
}

if [ -n "$subcmd" ]; then
	name="generate-${subcmd}"
else
	name="${pkg#./cmd/}"
fi
producer="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/$name}"
claim_dir="$ROOT/.agents/runtime/generate-wrapper-claims"
claim_path_rel=".agents/runtime/generate-wrapper-claims/${name}.jsonl"

supervised_material_claim_path() {
	local tool_name="$1"
	local stem="${tool_name#generate-}"
	stem="${stem//-/_}"
	local candidate
	local found=()
	for candidate in \
		"data/editorial/${stem}.jsonl" \
		"data/editorial/${stem}_evidence.jsonl" \
		"data/editorial/${stem}_rehearsal.jsonl" \
		"data/ops/${stem}.jsonl" \
		"data/ops/${stem}_evidence.jsonl" \
		"data/ops/${stem}_rehearsal.jsonl" \
		"data/research/${stem}.jsonl" \
		"data/research/${stem}_evidence.jsonl" \
		"data/research/${stem}_rehearsal.jsonl" \
		"data/source-registry/${stem}.jsonl" \
		"data/source-registry/${stem}_evidence.jsonl" \
		"data/source-audit/${stem}.jsonl" \
		"data/audits/${stem}.jsonl" \
		"data/ai/${stem}.jsonl"; do
		if [[ -e "$ROOT/$candidate" ]]; then
			found+=("$candidate")
		fi
	done
	if [[ "${#found[@]}" -eq 1 ]]; then
		printf '%s\n' "${found[0]}"
		return 0
	fi
	if [[ "${#found[@]}" -gt 1 ]]; then
		echo "run-generate-supervised: material artifact claim is ambiguous for $tool_name: ${found[*]}; set WIKI_HEAVY_ARTIFACT_CLAIM_PATH explicitly" >&2
		return 2
	fi
	return 1
}

if [[ -z "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-}" ]]; then
	if ! material_claim_path="$(supervised_material_claim_path "$name")"; then
		echo "run-generate-supervised: material artifact claim required for $name; wrapper must set WIKI_HEAVY_ARTIFACT_CLAIM_PATH to the data/content/public artifact, not $claim_path_rel" >&2
		exit 2
	fi
	export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="$material_claim_path"
fi
case "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH" in
.agents/runtime/generate-wrapper-claims/* | ./.agents/runtime/generate-wrapper-claims/* | "$ROOT/.agents/runtime/generate-wrapper-claims/"*)
	echo "run-generate-supervised: material artifact claim cannot point to wrapper claim log: $WIKI_HEAVY_ARTIFACT_CLAIM_PATH" >&2
	exit 2
	;;
esac

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:${name}:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="$producer"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:$WIKI_HEAVY_ARTIFACT_CLAIM_PATH}"

# O supervisor mede wall-clock/exit/timeout sem alterar argv. Geradores que
# realmente implementam --timings podem declarar a capability explicitamente
# no proprio wrapper; so nesse caso este adaptador injeta a flag. Isso evita
# transformar --timings em root posicional ou flag desconhecida nos demais.
timings_capability="${WIKI_GENERATE_TIMINGS_CAPABILITY:-supervisor_wall_clock_v1}"
timing_args=()
case "$timings_capability" in
supervisor_wall_clock_v1)
	export WIKI_HEAVY_TIMING_MODE=supervisor_wall_clock_v1
	;;
child_flag_v1)
	export WIKI_HEAVY_TIMING_MODE=child_flag_v1
	timings_present=0
	for arg in "$@"; do
		if [[ "$arg" == "--timings" ]]; then
			timings_present=1
			break
		fi
	done
	if [[ "$timings_present" == "0" ]]; then
		timing_args=(--timings)
	fi
	;;
*)
	echo "run-generate-supervised: WIKI_GENERATE_TIMINGS_CAPABILITY must be supervisor_wall_clock_v1 or child_flag_v1, got $timings_capability" >&2
	exit 2
	;;
esac
case "$WIKI_HEAVY_BUDGET_MS" in
'' | *[!0-9]*)
	echo "run-generate-supervised: WIKI_HEAVY_BUDGET_MS must be numeric, got $WIKI_HEAVY_BUDGET_MS" >&2
	exit 2
	;;
esac
case "$WIKI_HEAVY_EXPECTED_DURATION_MS" in
'' | *[!0-9]*)
	echo "run-generate-supervised: WIKI_HEAVY_EXPECTED_DURATION_MS must be numeric, got $WIKI_HEAVY_EXPECTED_DURATION_MS" >&2
	exit 2
	;;
esac
mkdir -p "$claim_dir"

checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
input_fingerprint="$(
	{
		printf 'package:%s\n' "$pkg"
		printf 'producer:%s\n' "$producer"
		printf 'timings_capability:%s\n' "$timings_capability"
		printf 'args:'
		printf '%s\0' "$@"
		printf '\n'
		sha256sum "$ROOT/tools/run-generate-supervised" "$ROOT/tools/$name" 2>/dev/null || true
	} | sha256sum | awk '{print "sha256:" $1}'
)"
command_display="$pkg"
if [[ -n "$subcmd" ]]; then
	command_display="$command_display $subcmd"
fi
record_child_timings=0
if [[ "${#timing_args[@]}" -gt 0 ]]; then
	record_child_timings=1
else
	for arg in "$@"; do
		if [[ "$arg" == "--timings" ]]; then
			record_child_timings=1
			break
		fi
	done
fi
if [[ "$record_child_timings" == "1" ]]; then
	command_display="$command_display --timings"
fi
tmp_claim="$(mktemp "$claim_dir/.${name}.XXXXXX")"
{
	printf '{"claim_type":"supervised_generate_wrapper","checked_at":"%s","path":"%s","package":"%s","producer":"%s","input_fingerprint":"%s","output_fingerprint_expected":"%s","output_fingerprint_esperado":"%s","lock_scope":"%s","budget_ms":%s,"expected_duration_ms":%s,"stop_condition":"%s","throughput_expected":"%s","timing_mode":"%s","command":"%s","publication_allowed":false,"render_allowed":false,"sitemap_allowed":false,"public_path":"","index_policy":"noindex"}\n' \
		"$(json_escape "$checked_at")" \
		"$(json_escape "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH")" \
		"$(json_escape "$pkg")" \
		"$(json_escape "$producer")" \
		"$(json_escape "$input_fingerprint")" \
		"$(json_escape "$WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED")" \
		"$(json_escape "$WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED")" \
		"$(json_escape "$WIKI_HEAVY_LOCK_SCOPE")" \
		"$WIKI_HEAVY_BUDGET_MS" \
		"$WIKI_HEAVY_EXPECTED_DURATION_MS" \
		"$(json_escape "$WIKI_HEAVY_STOP_CONDITION")" \
		"$(json_escape "$WIKI_HEAVY_THROUGHPUT_EXPECTED")" \
		"$(json_escape "$WIKI_HEAVY_TIMING_MODE")" \
		"$(json_escape "$command_display")"
	if [[ -f "$claim_dir/${name}.jsonl" ]]; then
		cat "$claim_dir/${name}.jsonl"
	fi
} >"$tmp_claim"
mv "$tmp_claim" "$claim_dir/${name}.jsonl"

if [ -n "$subcmd" ]; then
	exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" "$pkg" "$subcmd" "${timing_args[@]}" "$@"
fi
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" "$pkg" "${timing_args[@]}" "$@"
