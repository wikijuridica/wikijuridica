#!/usr/bin/env python3
"""check-social-temas-espelhados — toda página pública tem tema na rede social.

POR QUE ESTE GATE EXISTE, com a data e o número que o originaram.

Toda página do acervo é publicada com uma âncora para o seu tema na rede social
(`/redesocial/tema/{área}/{slug}/`, cobrada por `check-ancora-redesocial`), e o
link é derivado da ROTA — não do banco. O tema, por sua vez, só existe depois que
`cmd/generate-social-temas` espelha o `published_manifest` no `var/social/social.db`.
Quando a publicação anda e a semeadura não, cada página nova vira um link
anunciado para uma URL que devolve 404.

Medido em 2026-09-10 sobre `data/ops/access/nginx-2026-09-*.jsonl` (10 dias):
**1.161 requisições de bots valiosos em 817 caminhos distintos** de
`/redesocial/tema/jurisprudencia/stj-tema-N/` receberam 404 — GPTBot 817,
PerplexityBot 339. O banco tinha 10.141 temas para 11.039 páginas publicadas:
898 páginas sem tema, todas com o link no HTML servido. Não é rota privada nem
scanner: é o próprio portal mandando o crawler para o vazio, na superfície que o
contrato chama de AI-first.

O REMÉDIO É CONTEÚDO, NUNCA REMOVER O LINK (ordem do dono, 2026-09-10: "não
exclua conteúdo, se tem URL, tem conteúdo no repo"). Por isso este gate não
sugere apagar âncora: ele manda semear.

O gate é READ-ONLY por contrato: não escreve banco, manifesto nem série.
Exit 0 = todo caminho do manifesto tem tema. Exit 1 = falta tema (com a lista).
Exit 2 = infra ausente (manifesto ou banco ilegível), que não é veredito sobre o
produto.
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFESTO = os.path.join(RAIZ, "data", "editorial", "published_manifest.jsonl")
BANCO = os.path.join(RAIZ, "var", "social", "social.db")
# O mesmo par (área, slug) que cmd/generate-social-temas deriva: exatamente dois
# segmentos. Hub e paginação não têm tema e não entram na conta.
SEGMENTOS_DE_TEMA = 2


def caminhos_do_manifesto(caminho: str) -> set[str]:
    """Rotas /área/slug/ únicas do manifesto de publicação."""
    rotas: set[str] = set()
    with open(caminho, encoding="utf-8") as arquivo:
        for linha in arquivo:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            rota = (registro.get("path") or registro.get("route") or "").strip()
            if not rota.startswith("/") or not rota.endswith("/"):
                continue
            partes = [p for p in rota.strip("/").split("/") if p]
            if len(partes) != SEGMENTOS_DE_TEMA:
                continue
            rotas.add("/" + "/".join(partes) + "/")
    return rotas


def temas_do_banco(caminho: str) -> set[str]:
    """Caminhos espelhados na tabela `temas`, lidos em modo somente-leitura."""
    uri = "file:" + caminho + "?mode=ro"
    conexao = sqlite3.connect(uri, uri=True)
    try:
        cursor = conexao.execute("SELECT caminho FROM temas")
        return {str(linha[0]).strip() for linha in cursor.fetchall() if linha and linha[0]}
    finally:
        conexao.close()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--manifesto", default=MANIFESTO)
    parser.add_argument("--banco", default=BANCO)
    parser.add_argument("--amostra", type=int, default=10,
                        help="quantos caminhos faltantes listar (0 = todos)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if not os.path.isfile(args.manifesto):
        print("check-social-temas-espelhados: manifesto ausente em %s" % args.manifesto, file=sys.stderr)
        return 2
    if not os.path.isfile(args.banco):
        print("check-social-temas-espelhados: banco social ausente em %s" % args.banco, file=sys.stderr)
        return 2

    try:
        rotas = caminhos_do_manifesto(args.manifesto)
        temas = temas_do_banco(args.banco)
    except (OSError, sqlite3.Error) as erro:
        print("check-social-temas-espelhados: leitura falhou: %s" % erro, file=sys.stderr)
        return 2

    faltantes = sorted(rotas - temas)
    # Tema sem página no manifesto NÃO reprova: página supersedida sai do
    # manifesto e o tema fica, com as respostas e os follows que ele já tem.
    # Remover seria destruir conteúdo, e o espelho não remove por desenho.
    orfaos = len(temas - rotas)

    if args.json:
        print(json.dumps({
            "schema_version": "social_temas_espelhados_v1",
            "paginas_no_manifesto": len(rotas),
            "temas_no_banco": len(temas),
            "faltantes": len(faltantes),
            "orfaos_relatados": orfaos,
            "amostra": faltantes[: args.amostra or len(faltantes)],
        }, ensure_ascii=False, sort_keys=True))
    else:
        print("paginas /area/slug/ no manifesto : %d" % len(rotas))
        print("temas espelhados no banco        : %d" % len(temas))
        print("orfaos (tema sem pagina)         : %d — relatados, nunca removidos" % orfaos)
        print("FALTANDO tema                    : %d" % len(faltantes))
        for rota in faltantes[: args.amostra or len(faltantes)]:
            print("  %s  ->  /redesocial/tema%s" % (rota, rota))
        if len(faltantes) > (args.amostra or len(faltantes)):
            print("  (+%d)" % (len(faltantes) - args.amostra))

    if faltantes:
        print("\ncheck-social-temas-espelhados: %d pagina(s) publicadas anunciam um tema que devolve 404."
              "\n  Cada uma tem a ancora /redesocial/tema/... no HTML servido, entao o crawler segue e bate no vazio."
              "\n  Semeie (o comando NAO remove nada; orfaos so sao relatados):"
              "\n    ./tools/go-modern run ./cmd/generate-social-temas            # ensaio"
              "\n    ./tools/go-modern run ./cmd/generate-social-temas --aplicar  # aplica"
              % len(faltantes), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
