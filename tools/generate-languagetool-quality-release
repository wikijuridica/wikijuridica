#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-languagetool-quality-release [flags]

Runs cmd/generate-languagetool-quality through the full-corpus cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_GO_CMD_TIMEOUT_SECONDS="${WIKI_GO_CMD_TIMEOUT_SECONDS:-300}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-$WIKI_GO_CMD_TIMEOUT_SECONDS}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:languagetool-quality-release:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-300000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-240000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=4}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_incremental_languagetool_release_or_reported_service_issue_or_incremental_budget_exhausted_with_fail_closed_evidence}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/languagetool_quality_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-languagetool-quality-release}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/languagetool_quality_evidence.jsonl}"
cd "$ROOT"

LANGUAGETOOL_ENDPOINT="${WIKI_LANGUAGETOOL_ENDPOINT:-http://127.0.0.1:8082/v2/check}"
LANGUAGETOOL_CACHE_PATH="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PATH:-.cache/languagetool_quality_cache.jsonl}"
LANGUAGETOOL_BATCH_RECORDS="${WIKI_LANGUAGETOOL_RELEASE_BATCH_RECORDS:-8}"
LANGUAGETOOL_BATCH_MAX_BYTES="${WIKI_LANGUAGETOOL_RELEASE_BATCH_MAX_BYTES:-262144}"
LANGUAGETOOL_CONCURRENCY="${WIKI_LANGUAGETOOL_RELEASE_CONCURRENCY:-8}"
LANGUAGETOOL_TIMEOUT="${WIKI_LANGUAGETOOL_RELEASE_TIMEOUT:-60s}"
LANGUAGETOOL_MAX_TEXT_BYTES="${WIKI_LANGUAGETOOL_RELEASE_MAX_TEXT_BYTES:-65536}"
LANGUAGETOOL_VERSION="${WIKI_LANGUAGETOOL_VERSION:-6.8}"

WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS="${WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS:-1024}"
case "$WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS" in
'' | *[!0-9]*)
	echo "generate-languagetool-quality-release: WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS must be numeric and defaults to positive incremental live-miss budget" >&2
	exit 2
	;;
esac
MAX_LIVE_CHECK_ARGS=()
if [[ "$WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS" -gt 0 ]]; then
	MAX_LIVE_CHECK_ARGS=(--max-live-checks "$WIKI_LANGUAGETOOL_RELEASE_MAX_LIVE_CHECKS")
fi

CACHE_PLAN_PATH="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_PATH:-data/ops/languagetool_quality_cache_plan.json}"
CACHE_PLAN_TMP=""
cleanup_cache_plan_tmp() {
	if [[ -n "$CACHE_PLAN_TMP" ]]; then
		rm -f -- "$CACHE_PLAN_TMP"
	fi
}
trap cleanup_cache_plan_tmp EXIT
CACHE_PLAN_ARGS=(
	--cache-plan-json
	--endpoint "$LANGUAGETOOL_ENDPOINT"
	--require-service
	--require-scale-sidecar
	--full-corpus
	--batch-records "$LANGUAGETOOL_BATCH_RECORDS"
	--batch-max-bytes "$LANGUAGETOOL_BATCH_MAX_BYTES"
	--concurrency "$LANGUAGETOOL_CONCURRENCY"
	--timeout "$LANGUAGETOOL_TIMEOUT"
	--max-text-bytes "$LANGUAGETOOL_MAX_TEXT_BYTES"
	--service-version "$LANGUAGETOOL_VERSION"
	--cache-path "$LANGUAGETOOL_CACHE_PATH"
	--timings
	"${MAX_LIVE_CHECK_ARGS[@]}"
)
mkdir -p "$(dirname -- "$CACHE_PLAN_PATH")"
CACHE_PLAN_TMP="$(mktemp "${CACHE_PLAN_PATH}.tmp.XXXXXX")"
(
	export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_TIMEOUT_SECONDS:-120}"
	export WIKI_HEAVY_LOCK_SCOPE="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_LOCK_SCOPE:-generate:languagetool-quality-release-cache-plan:gocache:$GOCACHE}"
	export WIKI_HEAVY_BUDGET_MS="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_BUDGET_MS:-120000}"
	export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_EXPECTED_DURATION_MS:-60000}"
	export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_THROUGHPUT_EXPECTED:-records_per_second=100}"
	export WIKI_HEAVY_STOP_CONDITION="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_STOP_CONDITION:-cache_plan_json_emitted_readonly_before_heavy_generator_or_fail_closed}"
	export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_PATH:-data/ops/languagetool_quality_cache_plan.json}"
	export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_PRODUCER:-tools/generate-languagetool-quality-release-cache-plan}"
	export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_LANGUAGETOOL_RELEASE_CACHE_PLAN_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:$CACHE_PLAN_PATH}"
	echo "languagetool_cache_plan_readonly endpoint=$LANGUAGETOOL_ENDPOINT cache_path=$LANGUAGETOOL_CACHE_PATH plan_path=$CACHE_PLAN_PATH budget_ms=$WIKI_HEAVY_BUDGET_MS expected_duration_ms=$WIKI_HEAVY_EXPECTED_DURATION_MS throughput_expected=$WIKI_HEAVY_THROUGHPUT_EXPECTED stop_condition=$WIKI_HEAVY_STOP_CONDITION" >&2
	exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-languagetool-quality "${CACHE_PLAN_ARGS[@]}"
) >"$CACHE_PLAN_TMP"
mv -f -- "$CACHE_PLAN_TMP" "$CACHE_PLAN_PATH"
CACHE_PLAN_TMP=""

. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"

exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-languagetool-quality \
	--endpoint "$LANGUAGETOOL_ENDPOINT" \
	--require-service \
	--require-scale-sidecar \
	--full-corpus \
	--batch-records "$LANGUAGETOOL_BATCH_RECORDS" \
	--batch-max-bytes "$LANGUAGETOOL_BATCH_MAX_BYTES" \
	--concurrency "$LANGUAGETOOL_CONCURRENCY" \
	--timeout "$LANGUAGETOOL_TIMEOUT" \
	--max-text-bytes "$LANGUAGETOOL_MAX_TEXT_BYTES" \
	--service-version "$LANGUAGETOOL_VERSION" \
	--cache-path "$LANGUAGETOOL_CACHE_PATH" \
	--timings \
	"${MAX_LIVE_CHECK_ARGS[@]}" \
	"$@"
