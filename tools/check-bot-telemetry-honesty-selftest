#!/usr/bin/env python3
"""check-bot-telemetry-honesty-selftest — prova que o gate anti-fraude reprova.

READ-ONLY sobre o repositorio: monta cenarios FORJADOS num diretorio temporario
proprio e confere que a quarta perna do `check-bot-telemetry-honesty` (a que
impede a sonda deste repositorio de virar metrica de rastreio) reprova cada um.
Nenhum dado real e lido, escrito ou alterado.

POR QUE ISTO EXISTE COMO FERRAMENTA, e nao como script jogado fora depois: a
regra deste repositorio diz que *gate que nao pode reprovar e pior que gate
ausente, porque produz confianca falsa* — e uma das tarefas do plano de
2026-08-26 foi exatamente achar cinco checks sem nenhum caminho de saida != 0.
Um gate anti-fraude nasceu hoje; provar UMA vez que ele reprova nao vale nada
se ninguem puder repetir a prova amanha.

O CENARIO SADIO NO FIM NAO E DECORACAO: sem ele, um gate que reprovasse TUDO
passaria neste selftest com louvor. Falso positivo e falha tao grave quanto
falso negativo — ja custou a este projeto uma acusacao contra 78 linhas de
medicao real.
"""

import importlib.machinery
import importlib.util
import json
import os
import shutil
import sys
import tempfile

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
GATE = os.path.join(RAIZ, "tools", "check-bot-telemetry-honesty")

# O gate nao tem extensao .py: sem loader explicito, spec_from_file_location
# devolve None e o import falha com um AttributeError que nao explica nada.
sys.path.insert(0, os.path.join(RAIZ, "tools"))
_loader = importlib.machinery.SourceFileLoader("gate_bth", GATE)
_spec = importlib.util.spec_from_loader("gate_bth", _loader)
gate = importlib.util.module_from_spec(_spec)
_loader.exec_module(gate)

UA_BOT = {
    "user_agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)",
    "bot_simulation": False,
    "warming": False,
}

CASOS = [
    ("metrica acima do trafego nao marcado (5.000 declaradas, 1 real)", True,
     [UA_BOT],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 5000,
       "requests_is_metric": True, "simulations_excluded": 0}]),

    ("produtor parou de declarar simulations_excluded", True,
     [UA_BOT],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 1,
       "requests_is_metric": True}]),

    ("access log perdeu o campo de marcacao", True,
     [{"user_agent": UA_BOT["user_agent"]}],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 1,
       "requests_is_metric": True, "simulations_excluded": 0}]),

    ("sonda propria marcada NAO conta como trafego (20.000 simuladas, 0 metrica)", False,
     [dict(UA_BOT, bot_simulation=True) for _ in range(5)],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 0,
       "requests_is_metric": False, "simulations_excluded": 5}]),

    ("CENARIO SADIO: 1 declarada, 1 real, campos presentes", False,
     [UA_BOT],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 1,
       "requests_is_metric": True, "simulations_excluded": 0}]),

    # OS DOIS QUE A CRITICA ADVERSARIAL FORJOU E O GATE DEIXOU PASSAR.
    #
    # Nao sao hipoteses: um crítico Fable reproduziu os dois em sandbox contra a
    # PRIMEIRA versao desta perna, em 2026-08-26, e os dois deram verde. Entram
    # aqui como controle permanente porque a correcao de um furo so vale se
    # alguem puder provar amanha que ele continua fechado.
    ("BYPASS POR DATA: linha datada no futuro escondia fraude no dia real", True,
     [UA_BOT],
     [{"date": "2026-08-26", "agent_key": "googlebot", "requests": 50000,
       "requests_is_metric": True, "simulations_excluded": 0},
      {"date": "2026-08-27", "agent_key": "googlebot", "requests": 1,
       "requests_is_metric": True, "simulations_excluded": 0}]),

    # Este NAO reprova, e nao deve: agente sem referencia no log e
    # inconfrontavel, e afirmar sem base e o defeito que o gate combate. O que
    # o furo original fazia de errado era CONTA-LO como confrontado, escondendo
    # a lacuna. A verificacao disso esta na conferencia de resumo abaixo.
    ("agent_key fora do registry nao pode ser contado como confrontado", False,
     [dict(UA_BOT, bot_simulation=True)],
     [{"date": "2026-08-26", "agent_key": "agente-que-nao-existe", "requests": 99999,
       "requests_is_metric": True, "simulations_excluded": 0}]),
]

# ---------------------------------------------------------------------------
# checar_borda (2026-09-02): a mesma logica de prova, agora sobre a serie da
# BORDA (edge_bot_agents_daily.jsonl) e o vocabulario v4 — Cloudflare + faixa
# de IP oficial. `checar_sonda_propria` acima nunca exercitou `checar_borda`;
# sem estes casos, um `AUTENTICIDADE_V4` errado ou uma coerencia numerica
# quebrada so apareceria em producao, contra dado real.
CASOS_BORDA = [
    ("v4 coerente: cloudflare + ip_range fecham a soma", False, [
        {"schema_version": "edge_bot_agents_daily_v4", "date": "2026-09-02",
         "agent_key": "perplexitybot", "requests_sampled": 8, "requests_estimated": 8,
         "requests_sampled_cloudflare_verified": 5, "requests_estimated_cloudflare_verified": 5,
         "requests_sampled_ip_range": 3, "requests_estimated_ip_range": 3,
         "authenticity": "cloudflare_and_ip_range",
         "verified_bot_categories": {"search_engine_crawler": 5},
         "requests_sampled_unverified_ua": 2},
    ]),
    ("v4 NAO fecha a soma (sampled != cloudflare + ip_range)", True, [
        {"schema_version": "edge_bot_agents_daily_v4", "date": "2026-09-02",
         "agent_key": "perplexitybot", "requests_sampled": 8, "requests_estimated": 8,
         "requests_sampled_cloudflare_verified": 5, "requests_estimated_cloudflare_verified": 5,
         "requests_sampled_ip_range": 2, "requests_estimated_ip_range": 2,
         "authenticity": "cloudflare_and_ip_range",
         "verified_bot_categories": {"search_engine_crawler": 5},
         "requests_sampled_unverified_ua": 1},
    ]),
    ("v4 authenticity=ip_range_at_edge com requests_sampled_ip_range=0", True, [
        {"schema_version": "edge_bot_agents_daily_v4", "date": "2026-09-02",
         "agent_key": "perplexitybot", "requests_sampled": 0, "requests_estimated": 0,
         "requests_sampled_cloudflare_verified": 0, "requests_estimated_cloudflare_verified": 0,
         "requests_sampled_ip_range": 0, "requests_estimated_ip_range": 0,
         "authenticity": "ip_range_at_edge", "verified_bot_categories": {},
         "requests_sampled_unverified_ua": 5},
    ]),
    # v3 e LEGADO aceito (identidade ja verificada pela Cloudflare, so sem a
    # segunda perna de faixa de IP) — a linha v4 vem POR CIMA (ultima do
    # arquivo) para nao disparar producer_stale, que so olha a ULTIMA linha.
    ("v3 legado com unverified_at_edge continua passando, v4 por cima", False, [
        {"schema_version": "edge_bot_agents_daily_v3", "date": "2026-08-30",
         "agent_key": "googlebot", "requests_sampled": 0, "requests_estimated": 0,
         "authenticity": "unverified_at_edge", "requests_sampled_unverified_ua": 4},
        {"schema_version": "edge_bot_agents_daily_v4", "date": "2026-09-02",
         "agent_key": "googlebot", "requests_sampled": 26, "requests_estimated": 26,
         "requests_sampled_cloudflare_verified": 26, "requests_estimated_cloudflare_verified": 26,
         "requests_sampled_ip_range": 0, "requests_estimated_ip_range": 0,
         "authenticity": "cloudflare_verified_bot_category",
         "verified_bot_categories": {"search_engine_crawler": 26},
         "requests_sampled_unverified_ua": 0},
    ]),
]


def main():
    sandbox = tempfile.mkdtemp(prefix="selftest-bot-telemetry-")
    os.makedirs(os.path.join(sandbox, "data/ops/access"))
    gate.ROOT = sandbox
    gate.ORIGEM = os.path.join(sandbox, "data/ops/origin_bot_traffic_daily.jsonl")
    gate.BORDA = os.path.join(sandbox, "data/ops/edge_bot_agents_daily.jsonl")

    falhas = []
    print("check-bot-telemetry-honesty-selftest")
    try:
        for nome, deve_reprovar, access, ledger in CASOS:
            with open(os.path.join(sandbox, "data/ops/access/access-2026-08-26.jsonl"), "w",
                      encoding="utf-8") as handle:
                for registro in access:
                    handle.write(json.dumps(registro) + "\n")
            with open(gate.ORIGEM, "w", encoding="utf-8") as handle:
                for registro in ledger:
                    handle.write(json.dumps(registro) + "\n")

            problemas, _resumo = gate.checar_sonda_propria()
            reprovou = bool(problemas)
            ok = reprovou == deve_reprovar
            print("  %-8s %-62s (esperado: %s)"
                  % ("OK" if ok else "FALHOU", nome[:62],
                     "reprovar" if deve_reprovar else "passar"))
            if problemas:
                print("           -> %s" % problemas[0][:120])
            if not ok:
                falhas.append(nome)

            # O SEGUNDO CONTROLE NAO SE PROVA PELO exit code, e por isso a
            # conferencia e do RESUMO: o gate acerta ao nao reprovar, e erraria
            # ao declarar que confrontou. Sem esta linha o cenario passaria
            # exatamente como passava quando o furo existia.
            if nome.startswith("agent_key fora do registry"):
                if _resumo.get("agents_checked"):
                    print("           -> FURO: declarou %d agente(s) confrontado(s) sem "
                          "referencia no log" % _resumo["agents_checked"])
                    falhas.append(nome + " (contou como confrontado)")
                elif not _resumo.get("unmatched_keys"):
                    print("           -> FURO: nao declarou o agente inconfrontavel na ressalva")
                    falhas.append(nome + " (lacuna nao declarada)")
                else:
                    print("           -> ressalva correta: %s" % ", ".join(_resumo["unmatched_keys"]))

        print("\ncheck-bot-telemetry-honesty-selftest (checar_borda, schema v4)")
        for nome, deve_reprovar, linhas in CASOS_BORDA:
            with open(gate.BORDA, "w", encoding="utf-8") as handle:
                for registro in linhas:
                    handle.write(json.dumps(registro) + "\n")

            problemas, _resumo = gate.checar_borda()
            reprovou = bool(problemas)
            ok = reprovou == deve_reprovar
            print("  %-8s %-62s (esperado: %s)"
                  % ("OK" if ok else "FALHOU", nome[:62],
                     "reprovar" if deve_reprovar else "passar"))
            if problemas:
                print("           -> %s" % problemas[0][:160])
            if not ok:
                falhas.append(nome)
    finally:
        shutil.rmtree(sandbox, ignore_errors=True)

    if falhas:
        print("\ncheck-bot-telemetry-honesty-selftest: FAIL")
        for nome in falhas:
            print("  - o gate nao se comportou como o desenho manda em: %s" % nome)
        return 1
    print("\ncheck-bot-telemetry-honesty-selftest: OK (%d cenario(s), reprova e passa onde deve)"
          % (len(CASOS) + len(CASOS_BORDA)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
