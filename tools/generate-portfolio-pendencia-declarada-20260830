#!/usr/bin/env python3
"""generate-portfolio-pendencia-declarada-20260830 — declara no portfólio a
intenção que ainda não tem página.

POR QUE EXISTE. `portfolio_v2` marca com `needs_source_research` a intenção cuja
pesquisa de fonte ainda não fechou; sem a marca, o registro afirma que está
PRONTO. Medido em 2026-08-30 na área de aéreo: 4 registros afirmavam estar
prontos e não tinham página em shard nenhum — nem ativa, nem pulada com razão.

O portfólio estava dizendo o que não era, e o gate de completude
(`TestAereoPortfolioCompletionMatchesFinalizedShards`) tinha razão em reprovar.
Este gerador NÃO escreve página nem inventa fonte: ele corrige a AFIRMAÇÃO,
marcando como pendente o que de fato está pendente. A página continua a ser
escrita depois, e quando ela existir a marca sai pelo caminho normal.

Uso:
    ./tools/generate-portfolio-pendencia-declarada-20260830 --area aereo --seco
    ./tools/generate-portfolio-pendencia-declarada-20260830 --area aereo
"""
from __future__ import annotations

import argparse
import glob
import json
import os

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def carrega(padrao: str) -> dict[str, tuple[str, int, dict]]:
    fora: dict[str, tuple[str, int, dict]] = {}
    for caminho in sorted(glob.glob(os.path.join(RAIZ, padrao))):
        for indice, linha in enumerate(open(caminho, encoding="utf-8")):
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            intent = registro.get("intent_id")
            if intent:
                fora[intent] = (caminho, indice, registro)
    return fora


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--area", required=True, help="prefixo da area (ex.: aereo)")
    parser.add_argument("--seco", action="store_true")
    args = parser.parse_args()

    portfolio = carrega(f"data/editorial/portfolio_v2/{args.area}*.jsonl")
    paginas = carrega(f"data/editorial/v2_pages/{args.area}*.jsonl")

    pendentes = []
    for intent, (caminho, _, registro) in portfolio.items():
        if registro.get("needs_source_research"):
            continue
        if intent in paginas:
            continue
        pendentes.append((intent, caminho))

    print(f"area {args.area}: portfolio={len(portfolio)} paginas={len(paginas)} "
          f"prontos SEM pagina alguma={len(pendentes)}")
    for intent, caminho in pendentes:
        print(f"  {intent}  ({os.path.basename(caminho)})")
    if args.seco:
        print("(--seco: nada foi escrito)")
        return 0
    if not pendentes:
        return 0

    por_arquivo: dict[str, list[str]] = {}
    alvo = {i for i, _ in pendentes}
    for caminho in {c for _, c in pendentes}:
        linhas = open(caminho, encoding="utf-8").read().splitlines()
        for indice, linha in enumerate(linhas):
            if not linha.strip():
                continue
            registro = json.loads(linha)
            if registro.get("intent_id") in alvo:
                registro["needs_source_research"] = True
                linhas[indice] = json.dumps(registro, ensure_ascii=False)
        por_arquivo[caminho] = linhas
    for caminho, linhas in por_arquivo.items():
        with open(caminho, "w", encoding="utf-8") as fh:
            fh.write("\n".join(linhas) + "\n")
    print(f"marcados como pendentes: {len(pendentes)} registro(s) em {len(por_arquivo)} arquivo(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
