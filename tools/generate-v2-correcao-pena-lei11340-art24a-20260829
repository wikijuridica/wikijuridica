#!/usr/bin/env python3
"""generate-v2-correcao-pena-lei11340-art24a-20260829 — a pena do art. 24-A da
Lei Maria da Penha estava servida ao público na redação REVOGADA em 2024.

★ O DEFEITO (achado colateral da triagem do BUG-116, 2026-08-29)

Duas rotas publicadas do shard `leis-13.jsonl` afirmam que descumprir medida
protetiva é punido com DETENÇÃO de três meses a dois anos:

    /leis/11340-art-24-a/  (intent lei-11340-art-24-a)
        meta_description : "...com detenção de 3 meses a 2 anos..."
        corpo            : "A pena é de detenção, de três meses a dois anos."
        anchor_claim     : "...a pena de detenção de três meses a dois anos..."
    /leis/11340-art-22/    (intent lei-11340-art-22)
        corpo            : "...incorre no crime do art. 24-A, com pena de detenção..."

Essa é a redação ORIGINAL, dada pela Lei nº 13.641, de 2018. Ela foi substituída
pela Lei nº 14.994, de 2024, e o Planalto a publica TACHADA — ou seja, morta.

★ A PROVA (contrato R9: fonte oficial primária, com URL e data)

Texto oficial consolidado, lido em 2026-08-29:

    https://www.planalto.gov.br/ccivil_03/_ato2004-2006/2006/lei/l11340.htm
    sha256 do documento: 488268242fbb9247107248cd2fca73b00e7084fd6d296d193558ce1236907587

    "Art. 24-A. Descumprir decisão judicial que defere medidas protetivas de
     urgência previstas nesta Lei:            (Incluído pela Lei nº 13.641, de 2018)
     Pena – detenção, de 3 (três) meses a 2 (dois) anos.   [TACHADO no original]
     Pena – reclusão, de 2 (dois) a 5 (cinco) anos, e multa.
                                       (Redação dada pela Lei nº 14.994, de 2024)"

A mesma medição está gravada, por artigo, em
`data/legal-corpus/lei_11340_2006.json` — corpus que só existiu a partir desta
sessão, porque o gerador do corpus não conseguia ler este documento (ele é
UTF-16 e a cascata de decodificação caía em latin-1, que aceita qualquer byte).

Outras quatro páginas do acervo (criminal-16, criminal-w3-04, criminal-w3-06 e
glossario-17) já traziam a pena nova. Era o shard `leis-13` que ficou para trás,
e ele é justamente o que responde pela rota nomeada do artigo.

★ POR QUE UM GERADOR DATADO

Contrato do repositório: página reprovada se conserta por gerador datado com
lease e CAS, nunca por edição do JSONL à mão — outra frente pode estar gravando
o mesmo shard, e a edição manual venceria a corrida em silêncio. O CAS abaixo
compara o sha256 do arquivo lido com o do arquivo no instante da gravação e
aborta se alguém escreveu no meio.

★ O QUE ESTE GERADOR NÃO FAZ

Não mexe em `verified_at`. A fonte declarada continua sendo a mesma URL, com o
mesmo http_status, conferida em 2026-07-10 — e o texto tachado já estava lá
naquela data. O defeito nunca foi a data da conferência: foi a LEITURA do
documento, que copiou a redação morta. Carimbar data nova esconderia isso.

Uso:
    tools/generate-v2-correcao-pena-lei11340-art24a-20260829 --seco
    tools/generate-v2-correcao-pena-lei11340-art24a-20260829
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import sys
import tempfile

RAIZ = pathlib.Path(__file__).resolve().parent.parent
SHARD = RAIZ / "data" / "editorial" / "v2_pages" / "leis-13.jsonl"
CORPUS = RAIZ / "data" / "legal-corpus" / "lei_11340_2006.json"

# Cada troca é literal e ancorada no texto oficial. Nada de regex larga: se a
# frase mudar, a substituição não acontece e o gerador denuncia, em vez de
# reescrever algo que ninguém conferiu.
TROCAS = [
    (
        "com detenção de 3 meses a 2 anos e fiança que só o juiz concede.",
        "com reclusão de 2 a 5 anos e fiança que só o juiz concede.",
    ),
    (
        "A pena é de detenção, de três meses a dois anos.",
        "A pena, na redação dada pela Lei nº 14.994, de 2024, é de reclusão, de "
        "dois a cinco anos, e multa; até então era de detenção, de três meses a "
        "dois anos.",
    ),
    (
        "a pena de detenção de três meses a dois anos",
        "a pena de reclusão de dois a cinco anos e multa, na redação da Lei "
        "14.994/2024",
    ),
    (
        "incorre no crime do art. 24-A, com pena de detenção,",
        "incorre no crime do art. 24-A, com pena de reclusão,",
    ),
]

INTENTS = {"lei-11340-art-24-a", "lei-11340-art-22"}

# A meta description do portal tem faixa contratual de 70 a 160 caracteres. Se a
# troca jogar a linha para fora dela, a correção jurídica criaria um defeito de
# SEO — e este gerador prefere abortar a entregar isso.
META_MIN, META_MAX = 70, 160


def sha256(caminho: pathlib.Path) -> str:
    return hashlib.sha256(caminho.read_bytes()).hexdigest()


def confere_corpus() -> None:
    """Recusa correr se a premissa não se sustentar no texto oficial indexado."""
    try:
        dados = json.loads(CORPUS.read_text(encoding="utf-8"))
    except OSError as erro:
        raise SystemExit(
            f"corpus da Lei 11.340 ilegível em {CORPUS}: {erro}\n"
            "Gere-o antes: tools/generate-legal-corpus --apenas lei_11340_2006"
        )
    texto = dados.get("articles", {}).get("24-A")
    if not texto:
        raise SystemExit(
            "ABORTADO: o corpus não traz o art. 24-A da Lei 11.340 — sem o texto "
            "oficial não há como afirmar qual é a pena vigente."
        )
    if "reclusão" not in texto:
        raise SystemExit(
            "ABORTADO: o art. 24-A no corpus não fala em reclusão. A premissa "
            "desta correção caiu; releia o Planalto antes de aplicar."
        )
    if "detenção" in texto:
        raise SystemExit(
            "ABORTADO: o corpus trouxe a redação revogada (detenção) junto com a "
            "vigente. O descarte de texto tachado falhou — corrija o extrator "
            "antes, senão esta correção fixaria a pena errada."
        )


def corrige_texto(valor: str) -> tuple[str, int]:
    trocas = 0
    for velho, novo in TROCAS:
        if velho in valor:
            trocas += valor.count(velho)
            valor = valor.replace(velho, novo)
    return valor, trocas


def corrige_registro(registro: dict) -> int:
    trocas = 0
    for campo, valor in registro.items():
        if isinstance(valor, str):
            novo, n = corrige_texto(valor)
            if n:
                if campo == "meta_description" and not (
                    META_MIN <= len(novo) <= META_MAX
                ):
                    raise SystemExit(
                        f"ABORTADO: meta_description ficaria com {len(novo)} "
                        f"caracteres, fora da faixa {META_MIN}-{META_MAX}."
                    )
                registro[campo] = novo
                trocas += n
        elif isinstance(valor, list):
            for item in valor:
                if not isinstance(item, dict):
                    continue
                for chave, texto in item.items():
                    if not isinstance(texto, str):
                        continue
                    novo, n = corrige_texto(texto)
                    if n:
                        item[chave] = novo
                        trocas += n
    return trocas


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--seco", action="store_true", help="relata sem gravar")
    args = ap.parse_args()

    confere_corpus()

    if not SHARD.exists():
        raise SystemExit(f"shard ausente: {SHARD}")

    sha_lido = sha256(SHARD)
    linhas = SHARD.read_text(encoding="utf-8").splitlines()

    saida: list[str] = []
    total = 0
    tocados: list[str] = []
    for linha in linhas:
        if not linha.strip():
            saida.append(linha)
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") in INTENTS:
            trocas = corrige_registro(registro)
            if trocas:
                total += trocas
                tocados.append(f"{registro['intent_id']} ({trocas})")
            saida.append(json.dumps(registro, ensure_ascii=False))
            continue
        saida.append(linha)

    print("correção da pena do art. 24-A da Lei 11.340/2006 (detenção -> reclusão)")
    print(f"  shard        : {SHARD.relative_to(RAIZ)}")
    print(f"  ocorrências  : {total}")
    print(f"  páginas      : {', '.join(tocados) if tocados else '(nenhuma)'}")

    if total == 0:
        print("  nada a fazer — a pena já está na redação vigente")
        return 0
    if args.seco:
        print("  --seco: nada gravado")
        return 0

    if sha256(SHARD) != sha_lido:
        print(
            "ABORTADO: o shard mudou entre a leitura e a gravação — outra frente "
            "está escrevendo. Rode de novo.",
            file=sys.stderr,
        )
        return 2

    conteudo = "\n".join(saida) + "\n"
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=str(SHARD.parent), prefix=".pena24a_", delete=False
    ) as tmp:
        tmp.write(conteudo)
        temporario = pathlib.Path(tmp.name)
    os.replace(temporario, SHARD)
    print(f"  gravado (atômico) — sha {sha_lido[:12]} -> {sha256(SHARD)[:12]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
