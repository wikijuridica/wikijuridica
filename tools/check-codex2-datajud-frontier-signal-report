#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: check-codex2-datajud-frontier-signal-report [flags]

Roda o contract test do join semântico DataJud×fronteira e, em seguida, o gate
homônimo pelo runner cacheado. Flags são repassadas ao run-check (ex.: --timings).
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# O `go test` abaixo é pesado (compila e relinga sob um módulo de ~504 pacotes)
# e rodava CRU: sem lock, sem orçamento e sem teto de tempo — dois agentes
# chamando o check ao mesmo tempo disputavam CPU/GOCACHE, e um teste travado
# prendia o chamador. Passa a herdar o mesmo regime dos irmãos da família
# (ver tools/check-codex2-source-frontier): run-heavy-throttled serializa por
# escopo de GOCACHE e aplica o orçamento; -timeout corta o deadlock com
# diagnóstico em vez do default de 10 min do Go. O binário vem do toolchain
# fixado (go-modern), não do `go` do PATH.
#
# Só o BUDGET_MS governa o tempo: declarar WIKI_HEAVY_TIMEOUT_SECONDS maior que
# ele seria mentira operacional — o menor dos dois vence (run-heavy-throttled
# avisa no timeout quando isso acontece).
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-check:codex2-datajud-frontier-signal-report:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-420000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-120000}"
# Faltava esta linha, apesar do comentário acima dizer "herda o mesmo regime
# dos irmãos da família" — tools/check-codex2-source-frontier declara
# records_per_second=100 para a mesma forma (go test de um único TestXxx sob
# run-heavy-throttled). Sem ela, TestHeavyRunWrappersDeclareNumericThroughputExpected
# reprova: telemetria de throughput numérico é obrigatória para todo wrapper
# que passa por run-heavy-throttled.
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-check_pass_or_report_issues_with_timings}"
"$ROOT/tools/run-heavy-throttled" "$ROOT/tools/go-modern" test -count=1 -timeout 300s \
	./internal/codex2datajudfrontiersignalreport ./internal/contract/codex2 \
	-run TestCodex2DataJudFrontierSignalReport
exec "$ROOT/tools/run-check" codex2-datajud-frontier-signal-report "$@"
