#!/usr/bin/env python3
"""Verifica a série de tráfego de bot da ORIGEM pelo leitor canônico, e mostra o
tamanho do erro que a leitura errada produz.

Read-only: não escreve nada.

O QUE ESTE GATE REPROVA
  1. linha com schema desconhecido (nenhum campo de contagem reconhecido) —
     schema novo entrando sem que o leitor saiba somá-lo é subcontagem silenciosa;
  2. linha ilegível no ledger;
  3. divergência acima do teto entre a leitura canônica (soma) e a leitura errada
     (última linha por chave), quando `--exigir-divergencia` é passado — serve
     para provar, com número, que a regra importa.

O gate NÃO reprova por volume baixo de bot: isso é fato do mundo, não defeito de
dado.
"""

import argparse
import sys

sys.path.insert(0, "tools")
import origintelemetry as ot  # noqa: E402

# Bots cuja série interessa reportar por padrão. Não é allowlist de validação —
# o gate valida o arquivo inteiro; esta lista só ordena o relatório.
DESTAQUE = (
    "googlebot", "bingbot", "oai-searchbot", "chatgpt-user",
    "claudebot", "gptbot", "perplexitybot", "duckassistbot",
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--raiz", default=".", help="raiz do repositório")
    parser.add_argument("--inicio", help="data inicial ISO inclusiva (AAAA-MM-DD)")
    parser.add_argument("--fim", help="data final ISO inclusiva (AAAA-MM-DD)")
    parser.add_argument("--exigir-divergencia", action="store_true",
                        help="reprova se a leitura errada NÃO divergir da canônica "
                             "(a regra deixou de importar, ou o ledger mudou de forma)")
    args = parser.parse_args()

    por_agente, diagnostico = ot.serie_somada(args.raiz, args.inicio, args.fim)
    problemas = []

    if diagnostico["linhas_ilegiveis"]:
        problemas.append(f"{diagnostico['linhas_ilegiveis']} linha(s) ilegível(is) no ledger")
    if diagnostico["linhas_sem_campo_conhecido"]:
        problemas.append(
            f"{diagnostico['linhas_sem_campo_conhecido']} linha(s) com schema desconhecido: "
            f"nenhum de {ot.CAMPOS_AUTENTICO} presente. Schema novo exige ensinar o leitor "
            f"canônico a somá-lo, senão a subcontagem é silenciosa"
        )

    print(f"ledger                 : {ot.LEDGER_REL}")
    janela = f"{args.inicio or '(início)'} .. {args.fim or '(fim)'}"
    print(f"janela                 : {janela}")
    print(f"linhas lidas           : {diagnostico['linhas_lidas']}")
    print(f"  fora da janela       : {diagnostico['linhas_fora_da_janela']}")
    print(f"  não somáveis         : {diagnostico['linhas_nao_somaveis']} (sem summable — não entram, seria dobrar)")
    print(f"schemas encontrados    : {dict(diagnostico['schemas'])}")
    print(f"campos usados na soma  : {dict(diagnostico['campos_usados'])}")
    print()
    print("SÉRIE CANÔNICA (soma por (date, agent_key), como o produtor manda):")
    print(f"  {'bot':<20}{'autênticas':>11}{'forjadas':>10}{'n/verif.':>10}{'linhas':>8}{'dias':>6}")
    ordenados = sorted(por_agente.items(), key=lambda kv: -kv[1]["autenticas"])
    vistos = set()
    for agente, dados in ordenados:
        if agente in DESTAQUE or dados["autenticas"] > 0:
            print(f"  {agente:<20}{dados['autenticas']:>11}{dados['forjadas']:>10}"
                  f"{dados['nao_verificaveis']:>10}{dados['linhas']:>8}{dados['dias']:>6}")
            vistos.add(agente)
    for agente in DESTAQUE:
        if agente not in vistos:
            print(f"  {agente:<20}{'0':>11}{'0':>10}{'0':>10}{'0':>8}{'0':>6}")

    errada = ot.leitura_errada_dedup(args.raiz, args.inicio, args.fim)
    print()
    print("O QUE A LEITURA ERRADA (última linha por chave) devolveria:")
    divergentes = 0
    for agente in DESTAQUE:
        certo = por_agente.get(agente, {}).get("autenticas", 0)
        torto = errada.get(agente, 0)
        if certo != torto:
            divergentes += 1
            fator = (certo / torto) if torto else float("inf")
            fator_txt = f"{fator:.1f}×" if torto else "∞"
            print(f"  {agente:<20} canônica {certo:>6}   errada {torto:>6}   subconta {fator_txt}")
    if not divergentes:
        print("  (nenhuma divergência nos bots de destaque)")

    if args.exigir_divergencia and not divergentes:
        problemas.append(
            "a leitura errada não divergiu da canônica: ou o ledger deixou de ser "
            "incremental, ou a janela é pequena demais para o gate provar a regra"
        )

    print()
    if problemas:
        for problema in problemas:
            print(f"REPROVADO: {problema}", file=sys.stderr)
        return 1
    print("OK — série lida pelo leitor canônico, sem linha ilegível nem schema desconhecido.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
