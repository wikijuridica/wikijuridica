#!/usr/bin/env python3
"""Mede quanto tempo cada crawler leva para pedir uma URL pela PRIMEIRA vez.

Read-only.

POR QUE ESTA MÉTRICA (2026-08-20).

"Requisições por dia" não serve para avaliar trabalho de frescor: o número é
dominado por topologia de cache e por amostragem, e sobe quando o bot repete URLs
que já conhece. O que responde "o conteúdo novo fez o bot voltar?" é o intervalo
entre PUBLICAR uma URL e o crawler PEDI-LA pela primeira vez.

Os dois lados do cruzamento já existiam no repositório e ninguém os cruzava:

  data/ops/crawl_coverage_state.json
      crawlers_verified.<bot>.paths_first_seen  -> {rota: data da 1a visita}
  data/editorial/first_published_at.json
      first_published_at                        -> {unique_intent_id: data de estreia}

Faltava a ponte intent -> rota, que vem do published_manifest.

LEIA O NÚMERO COM AS DUAS RESSALVAS:

  1. `paths_first_seen` é medido na BORDA. A data é de quando o crawler pediu a
     rota, não de quando a indexou — rastreado não é indexado.
  2. O registro de cobertura começa em 2026-08-05. Página publicada antes disso
     pode ter sido pedida antes da primeira medição, e aí o intervalo calculado é
     PISO, não valor exato. Essas ficam marcadas como `anterior_ao_registro`.
"""

import argparse
import json
import os
import statistics
import sys
from collections import Counter, defaultdict
from datetime import date

COBERTURA_REL = "data/ops/crawl_coverage_state.json"
ESTREIAS_REL = "data/editorial/first_published_at.json"
MANIFESTO_REL = "data/editorial/published_manifest.jsonl"

# Primeiro dia com registro de cobertura. Antes disso não há observação, e um
# intervalo calculado contra essa borda é piso.
INICIO_DO_REGISTRO = "2026-08-05"


def carrega_json(raiz, rel):
    with open(os.path.join(raiz, rel), encoding="utf-8") as arquivo:
        return json.load(arquivo)


def ponte_intent_para_rota(raiz):
    """unique_intent_id -> path, lida do manifesto publicado."""
    ponte = {}
    with open(os.path.join(raiz, MANIFESTO_REL), encoding="utf-8") as arquivo:
        for linha in arquivo:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            uid, rota = registro.get("unique_intent_id"), registro.get("path")
            if uid and rota:
                ponte[uid] = rota
    return ponte


def dias_entre(inicio_iso, fim_iso):
    return (date.fromisoformat(fim_iso) - date.fromisoformat(inicio_iso)).days


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--raiz", default=".")
    parser.add_argument("--bot", action="append", help="limita aos bots dados (repetível)")
    parser.add_argument("--json", action="store_true", help="saída JSON em vez de tabela")
    args = parser.parse_args()

    cobertura = carrega_json(args.raiz, COBERTURA_REL)
    estreias = carrega_json(args.raiz, ESTREIAS_REL).get("first_published_at", {})
    ponte = ponte_intent_para_rota(args.raiz)

    # rota -> data de estreia, que é o lado "publicação" do cruzamento.
    estreia_por_rota = {}
    for uid, quando in estreias.items():
        rota = ponte.get(uid)
        if rota:
            estreia_por_rota[rota] = quando

    verificados = cobertura.get("crawlers_verified") or {}
    alvos = args.bot or sorted(verificados)
    resultado = {}

    for bot in alvos:
        dados = verificados.get(bot) or {}
        primeira_visita = dados.get("paths_first_seen") or {}
        intervalos, pisos, nunca = [], 0, 0
        exemplos = []

        for rota, quando_publicou in estreia_por_rota.items():
            visto = primeira_visita.get(rota)
            if not visto:
                nunca += 1
                continue
            if quando_publicou < INICIO_DO_REGISTRO:
                pisos += 1
            dias = dias_entre(quando_publicou, visto)
            # Visita ANTERIOR à estreia registrada acontece quando a página já
            # existia antes do registro de cobertura começar: conta como 0, com
            # a ressalva de piso já marcada acima.
            intervalos.append(max(dias, 0))
            if len(exemplos) < 3 and dias >= 0:
                exemplos.append((rota, quando_publicou, visto, dias))

        resultado[bot] = {
            "rotas_publicadas": len(estreia_por_rota),
            "com_primeira_visita": len(intervalos),
            "nunca_pedidas": nunca,
            "mediana_dias": statistics.median(intervalos) if intervalos else None,
            "media_dias": round(sum(intervalos) / len(intervalos), 1) if intervalos else None,
            "p90_dias": (sorted(intervalos)[int(len(intervalos) * 0.9)] if len(intervalos) >= 10 else None),
            "maximo_dias": max(intervalos) if intervalos else None,
            "anterior_ao_registro": pisos,
            "exemplos": exemplos,
        }

    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=1))
        return 0

    print(f"rotas publicadas com data de estreia: {len(estreia_por_rota)}")
    print(f"registro de cobertura começa em      : {INICIO_DO_REGISTRO}")
    print()
    print(f"{'bot':<18}{'visitadas':>10}{'nunca':>8}{'mediana':>9}{'média':>8}{'p90':>6}{'máx':>6}{'piso':>7}")
    for bot in alvos:
        d = resultado[bot]
        def fmt(valor):
            return "-" if valor is None else f"{valor:g}"
        print(f"{bot:<18}{d['com_primeira_visita']:>10}{d['nunca_pedidas']:>8}"
              f"{fmt(d['mediana_dias']):>9}{fmt(d['media_dias']):>8}"
              f"{fmt(d['p90_dias']):>6}{fmt(d['maximo_dias']):>6}{d['anterior_ao_registro']:>7}")
    print()
    print("mediana/média/p90/máx = dias entre publicar a URL e o crawler pedi-la pela 1ª vez.")
    print("piso = páginas publicadas antes do registro de cobertura: o intervalo delas é PISO.")
    print("Rastreado NÃO é indexado: esta métrica mede acesso, não presença no índice.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
