#!/usr/bin/env python3
"""check-identidade-da-home — exige que a home SIRVA os nos de identidade da
entidade, e que os perfis declarados em content/site.json cheguem ao HTML.

Read-only: le public/index.html, public/sobre/index.html e content/site.json.

POR QUE ESTE GATE EXISTE. internal/render emite os nos de identidade assim:

    if script, report := structureddata.RenderOrganizationScript(...); report.Passed() && script != "" {

Nao ha ramo de erro. Quando a validacao reprova -- uma URL de perfil com
fragmento, com http, com espaco na borda --, o bloco simplesmente NAO SAI, sem
erro, sem log, sem gate. A home publica perde `Organization` e `LegalService`, e
nada no pipeline percebe: releaseStructuredDataIssues so cobre pagina com
`Article`, e a home nao tem Article; structureddataevidence so varre a camada de
ensaio, onde a home tambem nao esta.

O resultado seria o pior tipo de defeito: o portal continua no ar, todas as
paginas respondem 200, e a entidade que sustenta E-E-A-T num dominio YMYL
desaparece do grafo -- por causa de uma barra a mais numa URL de rede social.

O gate transforma esse silencio em reprovacao. Ele NAO valida a forma das URLs
(isso e de internal/structureddata, que ja o faz): ele verifica o CONTRATO DE
PRESENCA -- o que foi declarado na configuracao chegou ao HTML servido?
"""

import json
import re
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
HOME = RAIZ / "public" / "index.html"
SOBRE = RAIZ / "public" / "sobre" / "index.html"
SITE = RAIZ / "content" / "site.json"

# Os nos que a home TEM de servir. WebSite entra junto porque e o terceiro no da
# mesma familia e some pelo mesmo mecanismo.
NOS_DA_HOME = ("Organization", "LegalService", "WebSite")

BLOCO_JSONLD = re.compile(r'<script type="application/ld\+json">(.*?)</script>', re.S)


def blocos_jsonld(html: str):
    for bruto in BLOCO_JSONLD.findall(html):
        try:
            yield json.loads(bruto)
        except json.JSONDecodeError as erro:
            raise SystemExit(f"REPROVADO: JSON-LD invalido no HTML servido: {erro}")


def tipos_presentes(html: str) -> set:
    tipos = set()

    def visita(valor):
        if isinstance(valor, dict):
            if isinstance(valor.get("@type"), str):
                tipos.add(valor["@type"])
            for filho in valor.values():
                visita(filho)
        elif isinstance(valor, list):
            for filho in valor:
                visita(filho)

    for bloco in blocos_jsonld(html):
        visita(bloco)
    return tipos


def perfis_no_html(html: str) -> set:
    perfis = set()

    def visita(valor):
        if isinstance(valor, dict):
            bruto = valor.get("sameAs")
            if isinstance(bruto, list):
                perfis.update(p for p in bruto if isinstance(p, str))
            for filho in valor.values():
                visita(filho)
        elif isinstance(valor, list):
            for filho in valor:
                visita(filho)

    for bloco in blocos_jsonld(html):
        visita(bloco)
    return perfis


def main() -> int:
    if not HOME.exists():
        print(f"PENDENTE: {HOME} nao existe; rode a publicacao antes deste gate.")
        return 2

    falhas = []
    html_home = HOME.read_text(encoding="utf-8")

    presentes = tipos_presentes(html_home)
    for no in NOS_DA_HOME:
        if no not in presentes:
            falhas.append(
                f"a home NAO serve o no {no}. O emissor engole erro de validacao "
                f"(render.go: `if report.Passed()`), entao a causa provavel e uma "
                f"URL invalida em content/site.json derrubando o bloco inteiro."
            )

    identidade = json.loads(SITE.read_text(encoding="utf-8")).get("editorial_identity", {})
    da_pessoa = identidade.get("same_as") or []
    da_marca = identidade.get("organization_same_as") or []

    if da_marca or da_pessoa:
        servidos = perfis_no_html(html_home)
        for perfil in list(da_marca) + list(da_pessoa):
            if perfil not in servidos:
                falhas.append(
                    f"o perfil {perfil} esta declarado em content/site.json e NAO "
                    f"chegou ao JSON-LD da home -- foi recusado na validacao e o "
                    f"bloco sumiu em silencio."
                )
        # A ProfilePage de /sobre/ carrega o perfil da PESSOA; a da marca fica na
        # home. Conferir os dois lados impede que um deles seja publicado sozinho.
        if da_pessoa and SOBRE.exists():
            servidos_sobre = perfis_no_html(SOBRE.read_text(encoding="utf-8"))
            for perfil in da_pessoa:
                if perfil not in servidos_sobre:
                    falhas.append(
                        f"o perfil {perfil} da PESSOA nao chegou a ProfilePage de /sobre/."
                    )

    print("== identidade servida na home ==")
    print(f"  nos exigidos                {', '.join(NOS_DA_HOME)}")
    print(f"  nos presentes               {', '.join(sorted(presentes)) or '(nenhum)'}")
    print(f"  perfis da marca declarados  {len(da_marca)}")
    print(f"  perfis da pessoa declarados {len(da_pessoa)}")

    if falhas:
        print()
        for falha in falhas:
            print(f"  REPROVADO {falha}")
        print(f"\nREPROVADO: {len(falhas)} defeito(s) de identidade na home.")
        return 1
    print("\nAPROVADO: a home serve a entidade completa e todo perfil declarado chegou ao HTML.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
