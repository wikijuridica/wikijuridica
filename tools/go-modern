#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A VERSAO SAI DO go.mod, QUE E A FONTE UNICA (internal/gotoolchain).
#
# Ela estava copiada a mao aqui e em mais tres lugares, e DUAS ja tinham
# envelhecido para go1.26.4 enquanto o go.mod dizia go1.26.6 -- uma delas num
# artefato de proveniencia, que afirmava a terceiros uma versao que nao roda.
#
# O fallback e literal DE PROPOSITO: este wrapper e o caminho de TODO comando Go
# do repositorio. Se o go.mod ficar ilegivel, ele tem de continuar funcionando
# com a ultima versao conhecida em vez de derrubar a sessao inteira -- e o
# teste TestWrapperUsaOToolchainDoGoMod reprova se as duas divergirem.
VERSION="$(awk '/^[[:space:]]*toolchain[[:space:]]+go/{print $2; exit}' "$ROOT/go.mod" 2>/dev/null || true)"
if [[ -z "${VERSION:-}" ]]; then
	VERSION="go1.26.6"
fi

# Dev-mains (cmd/ exceto server/build/factory/check) sao build-tagged com
# //go:build devcmds para tirar ~347 links do `go build ./...` quente (10min -> ~8s
# so producao). `go run ./cmd/<devmain>` precisa da tag, senao falha com
# "build constraints exclude all Go files". Parse somente as flags de build
# anteriores ao pacote: argumentos do programa depois de ./cmd/... (inclusive
# um literal --tags=...) nao podem mudar o build. Quando -tags ja existe,
# preserve as tags do chamador e acrescente devcmds.
merge_devcmd_tag_value() {
	local value="$1"
	if [[ ",$value," == *,devcmds,* ]] || [[ " $value " == *" devcmds "* ]]; then
		printf '%s' "$value"
		return
	fi
	if [[ -n "$value" ]]; then
		printf '%s,devcmds' "$value"
	else
		printf 'devcmds'
	fi
}

goflags_tag_value() {
	local -a fields=()
	local field value="" goflags_index
	read -r -a fields <<<"${GOFLAGS:-}"
	for ((goflags_index = 0; goflags_index < ${#fields[@]}; goflags_index++)); do
		field="${fields[$goflags_index]}"
		case "$field" in
		-tags=*) value="${field#-tags=}" ;;
		-tags)
			if ((goflags_index + 1 < ${#fields[@]})); then
				value="${fields[$((goflags_index + 1))]}"
			fi
			;;
		esac
	done
	printf '%s' "$value"
}

run_flag_takes_value() {
	case "$1" in
	-C | -asmflags | -buildmode | -compiler | -covermode | -coverpkg | \
		-exec | -gccgoflags | -gcflags | -installsuffix | -ldflags | -mod | \
		-modfile | -overlay | -p | -pgo | -pkgdir | -toolexec | -vet)
		return 0
		;;
	esac
	return 1
}

race_requested=0
go_args=("$@")
command_index=0
case "${go_args[0]:-}" in
-C)
	if ((${#go_args[@]} < 3)); then
		echo "tools/go-modern: -C requires a directory and a Go subcommand" >&2
		exit 2
	fi
	command_index=2
	;;
-C=*) command_index=1 ;;
esac
if [[ "${go_args[$command_index]:-}" == "run" ]]; then
	tags_seen=0
	for ((i = command_index + 1; i < ${#go_args[@]}; i++)); do
		arg="${go_args[$i]}"
		case "$arg" in
		-race | -race=true)
			race_requested=1
			;;
		-tags)
			if ((i + 1 >= ${#go_args[@]})); then
				echo "tools/go-modern: -tags requires a value" >&2
				exit 2
			fi
			go_args[$((i + 1))]="$(merge_devcmd_tag_value "${go_args[$((i + 1))]}")"
			tags_seen=1
			((i += 1))
			continue
			;;
		-tags=*)
			go_args[$i]="-tags=$(merge_devcmd_tag_value "${arg#-tags=}")"
			tags_seen=1
			;;
		--)
			break
			;;
		-*=*) ;;
		-*)
			if run_flag_takes_value "$arg"; then
				((i += 1))
			fi
			;;
		*)
			# Primeiro argumento nao-flag e o pacote (ou primeiro arquivo .go).
			# Tudo depois pertence ao programa e deve permanecer byte a byte.
			break
			;;
		esac
	done
	if [[ "$tags_seen" == "0" ]]; then
		inherited_tags="$(goflags_tag_value)"
		go_args=("${go_args[@]:0:$((command_index + 1))}" -tags "$(merge_devcmd_tag_value "$inherited_tags")" "${go_args[@]:$((command_index + 1))}")
	fi
	set -- "${go_args[@]}"
elif [[ "${go_args[$command_index]:-}" == "test" ]]; then
	# test: mesma injecao de devcmds do run (testar cmd/ dev-main sem a tag
	# falha com "build constraints exclude all Go files" — mordeu cmd/discover-demand
	# em 07-21 e cmd/promote-authorial-mass-public-release em 07-23). Nao ha
	# "!devcmds" no repo, entao a tag extra apenas INCLUI dev-mains; pacotes de
	# producao compilam identicos. Diferente do run, argumentos do binario de
	# teste so comecam apos um literal -args — a varredura para ali; valores
	# soltos de flags de teste (-run TestX) caem no case padrao e sao ignorados.
	tags_seen=0
	for ((i = command_index + 1; i < ${#go_args[@]}; i++)); do
		arg="${go_args[$i]}"
		case "$arg" in
		-race | -race=true)
			race_requested=1
			;;
		-tags)
			if ((i + 1 >= ${#go_args[@]})); then
				echo "tools/go-modern: -tags requires a value" >&2
				exit 2
			fi
			go_args[$((i + 1))]="$(merge_devcmd_tag_value "${go_args[$((i + 1))]}")"
			tags_seen=1
			((i += 1))
			;;
		-tags=*)
			go_args[$i]="-tags=$(merge_devcmd_tag_value "${arg#-tags=}")"
			tags_seen=1
			;;
		-args)
			break
			;;
		-*=*) ;;
		-*)
			if run_flag_takes_value "$arg"; then
				((i += 1))
			fi
			;;
		*) ;;
		esac
	done
	if [[ "$tags_seen" == "0" ]]; then
		inherited_tags="$(goflags_tag_value)"
		go_args=("${go_args[@]:0:$((command_index + 1))}" -tags "$(merge_devcmd_tag_value "$inherited_tags")" "${go_args[@]:$((command_index + 1))}")
	fi
	set -- "${go_args[@]}"
else
	# -race e uma flag de build para test/build/install. Nao use esta varredura
	# no subcomando run, onde -race depois do pacote pode ser argumento do app.
	for arg in "$@"; do
		case "$arg" in
		-race | -race=true) race_requested=1 ;;
		esac
	done
fi

if [[ "${GOFLAGS:-}" =~ (^|[[:space:]])-race($|[[:space:]]) ]] ||
	[[ "${GOFLAGS:-}" =~ (^|[[:space:]])-race=true($|[[:space:]]) ]]; then
	race_requested=1
fi

# O runtime de corrida exige cgo nas plataformas suportadas. Nao imponha o
# inverso para comandos comuns: CGO_ENABLED=0 muda build tags, selecao de
# arquivos e o grafo compilado, portanto nao e uma simples otimizacao de
# linker. Sem -race, preserve integralmente o default oficial do Go; um valor
# explicitamente herdado do operador tambem continua soberano.
if [[ -z "${CGO_ENABLED+x}" && "$race_requested" == "1" ]]; then
	export CGO_ENABLED=1
fi

if [[ -n "${GO_MODERN_BIN:-}" ]]; then
	exec "$GO_MODERN_BIN" "$@"
fi

for candidate in \
	"$ROOT/.toolchains/$VERSION/bin/go" \
	"/opt/wiki/.toolchains/$VERSION/bin/go"; do
	if [[ -x "$candidate" ]]; then
		exec "$candidate" "$@"
	fi
done

echo "tools/go-modern: missing $VERSION. Install the official Linux amd64 tarball under .toolchains/$VERSION or set GO_MODERN_BIN." >&2
exit 127
