#!/usr/bin/env bash
# tools/check-v2-cross-shard-collision — READ-ONLY.
#
# Atalho da casa para o gate ja registrado em internal/checks
# ("v2-cross-shard-collision", checks.go:428 e :1646), implementado em
# internal/v2crossshardcollision e exposto por cmd/check-v2-cross-shard-collision.
# O gate reprova quando duas paginas VIVAS do estoque v2 compartilham o mesmo
# intent_id (unicidade global) ou o mesmo title/h1 entre shards distintos.
#
# Ate agora o unico atalho existente era um binario ELF solto na raiz do repo,
# compilado em 16/07: ele executa uma versao CONGELADA da fonte e nao acompanha
# alteracoes de internal/v2crossshardcollision. Este wrapper usa run-check, que
# recompila ./cmd/check quando a fonte muda — o resultado sempre corresponde ao
# codigo vivo da worktree.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
exec "$ROOT/tools/run-check" v2-cross-shard-collision "$@"
