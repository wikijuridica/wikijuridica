#!/usr/bin/env python3
"""Registra a autoridade da ANAC em www.gov.br no registro de fontes v2.

★ O DEFEITO (medido em 2026-08-30)

`./tools/check-v2-portfolio-source-hints` reprovava com exit 2:

    source hint catalog entry is not resolved: anac-dicas-documentos-embarque

A entrada EXISTE no catalogo e tem URL. O que falta e do outro lado: o
`source_registry_v2.jsonl` tem doze autoridades em `www.gov.br` — ANS, INPI,
INSS, MJ, Previdencia, Receita Federal, SUSEP, gov.br/servicos — e NENHUMA da
ANAC. O `RegistryMatcher` casa por caminho canonico, entao a URL da ANAC nao
resolve e o gate reprova, corretamente.

Cinco dicas do catalogo apontam para `www.gov.br/anac`, em tres caminhos
distintos, e os tres respondem 200 (sondados em 2026-08-30 com o UA do projeto):

    /pt-br/assuntos/passageiros/documentos-para-embarque
    /pt-br/assuntos/passageiros/transporte-de-liquidos-em-voos-internacionais
    /pt-br/assuntos/passageiros/anac_passageiro/

A ANAC ja e autoridade usada pelo acervo — a Resolucao 400 e a base do canal
aereo — so que pelo host `www.anac.gov.br`, que E registrado. O que faltava era
o portal institucional em `www.gov.br/anac`.

★ ESTENDE, NUNCA DUPLICA — e a primeira versao desta ferramenta ia errado

Eu ia criar uma entrada NOVA `anac-govbr`, copiando o envelope da SUSEP. O
proprio gerador me barrou: `anac-govbr` JA EXISTE. O que ela tem e
`official_domains: ["www.anac.gov.br"]` e dois `canonical_base_urls`, ambos das
Resolucoes 280 e 400 no host antigo. Faltava o portal institucional novo, em
`www.gov.br/anac`. Criar a segunda entrada seria duplicar autoridade.

★ E POR QUE ISTO NAO AFROUXA NADA

`official_domains` NAO autoriza sozinho. Em
`tools/check_v2_portfolio_source_hints.py:88` ele so valida que cada
`canonical_base_urls` pertence a um dominio declarado; o casamento real e por
PREFIXO DE CAMINHO exato (host + path + query, linha 91). Acrescentar
`www.gov.br` aos dominios da ANAC nao libera o gov.br inteiro: libera apenas os
tres caminhos declarados abaixo, todos sob `/anac/pt-br/assuntos/passageiros/`.

Nenhuma flag publica e tocada: a entrada mantem `publication_allowed`,
`render_allowed`, `sitemap_allowed` e `approval` como ja estao.

Uso:
    ./tools/generate-source-registry-anac-20260830 [--verificar]
"""
import json
import pathlib
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
REGISTRO = RAIZ / "data/source-registry/source_registry_v2.jsonl"
ALVO_ID = "anac-govbr"
DOMINIO_NOVO = "www.gov.br"

CAMINHOS = (
    "https://www.gov.br/anac/pt-br/assuntos/passageiros/documentos-para-embarque",
    "https://www.gov.br/anac/pt-br/assuntos/passageiros/transporte-de-liquidos-em-voos-internacionais",
    "https://www.gov.br/anac/pt-br/assuntos/passageiros/anac_passageiro/",
)


def main(argv):
    verificar = "--verificar" in argv
    linhas = REGISTRO.read_text(encoding="utf-8").splitlines()
    registros = [json.loads(l) for l in linhas if l.strip()]
    alvo = next((r for r in registros if r.get("source_id") == ALVO_ID), None)
    if alvo is None:
        print(f"REPROVADO: {ALVO_ID} ausente do registro — esta ferramenta "
              f"ESTENDE uma autoridade existente, nao cria autoridade nova")
        return 1

    dominios = list(alvo.get("official_domains") or [])
    bases = list(alvo.get("canonical_base_urls") or [])
    faltam = [u for u in CAMINHOS if u not in bases]
    precisa_dominio = DOMINIO_NOVO not in dominios

    if not faltam and not precisa_dominio:
        print(f"inalterado: {ALVO_ID} ja cobre os {len(CAMINHOS)} caminhos "
              f"do portal institucional")
        return 0
    if verificar:
        print(f"PENDENTE {ALVO_ID}: falta(m) {len(faltam)} caminho(s)"
              + (f" e o dominio {DOMINIO_NOVO}" if precisa_dominio else ""))
        for u in faltam:
            print(f"    {u}")
        return 1

    # Fail-closed: nenhuma flag publica pode mudar por esta extensao.
    antes = {c: alvo.get(c) for c in ("approval", "publication_allowed",
                                      "render_allowed", "sitemap_allowed",
                                      "raw_official_text_stored", "public_path",
                                      "record_status")}
    if precisa_dominio:
        dominios.append(DOMINIO_NOVO)
        alvo["official_domains"] = sorted(set(dominios))
    alvo["canonical_base_urls"] = sorted(set(bases + list(CAMINHOS)))
    alvo["checked_at"] = "2026-08-30"
    depois = {c: alvo.get(c) for c in antes}
    if antes != depois:
        print(f"REPROVADO: a extensao mudaria flag de publicacao "
              f"({antes} -> {depois}); nada foi escrito")
        return 1

    REGISTRO.write_text(
        "\n".join(json.dumps(r, ensure_ascii=False, sort_keys=True)
                  for r in registros) + "\n",
        encoding="utf-8")
    print(f"estendido: {ALVO_ID} — dominios={alvo['official_domains']}, "
          f"{len(alvo['canonical_base_urls'])} caminho(s) canonico(s); "
          f"flags de publicacao inalteradas")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
