# ------------------------------------------------ 5.9 A DATA DE CADA PAGINA
etapa "7.9/9 data de revisao: quem mudou ganha data nova"
# POR QUE ESTA ETAPA NASCEU, e por que ela vem ANTES da publicacao.
#
# `tools/generate-page-content-revision` existe desde 2026-08-07 e resolve o
# defeito da data unica. Mas so `tools/deploy-publico` o chamava -- e a
# publicacao canonica desde a politica PUBLICAR E CORRIGIR e
# `cmd/publish-v2-direct`, que NAO o chamava. Resultado medido em 2026-08-26: o
# ledger nao era gravado desde 20/08, e 9.582 URLs anunciavam <lastmod>
# 2026-08-06 enquanto 10.059 de 10.059 rotas tinham `html_sha256` diferente do
# manifesto de 20/08. Cem por cento do acervo servindo bytes novos sob data de
# vinte dias atras.
#
# O CUSTO DISSO NAO E COSMETICO. `lastmod` e o sinal que diz ao crawler se vale
# a pena voltar. Acervo enriquecido que se declara parado convida o bot a nao
# voltar exatamente onde houve novidade -- e o dono nomeou isso: pagina que
# parece obsoleta desmotiva o robo.
#
# ANTES da publicacao, e nao depois: o gerador escreve `content_revised_at`, que
# `cmd/publish-v2-direct` le para carimbar o HTML, o <lastmod> e o
# Last-Modified. Rodando depois, a data nova so alcancaria o publico na onda
# SEGUINTE -- um dia de defasagem num sinal cuja unica funcao e ser oportuno.
#
# NAO REPROVA A ONDA: data que nao avancou e defeito de sinal, nao de conteudo,
# e parar a publicacao por causa dela deixaria o acervo sem as paginas do dia
# para corrigir um carimbo. Registra e segue.
if timeout 900 nice -n 19 ./tools/generate-page-content-revision \
	>"$LOGS_COLETA/revisao.log" 2>&1; then
	grep -E 'conteúdo mudou|novas|datas distintas' "$LOGS_COLETA/revisao.log" | head -4 | sed 's/^/  /'
else
	echo "  data de revisao: FALHOU (ver $LOGS_COLETA/revisao.log) — a onda segue, o carimbo fica velho"
	registra "revisao-de-data"
fi

# ------------------------------------------------ 5.95 A DATA DE ESTREIA
etapa "7.95/9 data de estreia: quem ja estreou nao estreia de novo"
# POR QUE ESTA ETAPA NASCEU (P1b, 2026-09-16), e por que ela vem ANTES da
# publicacao.
#
# `tools/generate-first-published-at` existe desde 2026-08-20 e resolve o
# defeito da estreia que anda. Ele era ORFAO: nenhum runner, nenhum timer,
# nenhum hook o chamava. Resultado medido em 2026-09-16 --
# `data/editorial/first_published_at.json` congelado ha 18 dias, com 10.107
# chaves contra 11.114 do manifesto, e 942 paginas SERVIDAS declarando
# `datePublished` de hoje com `dateModified` de dias antes: cronologia
# impossivel, no ar, re-datada a cada onda. /jurisprudencia/ 875, /leis/ 38,
# /sumulas/ 29.
#
# ANTES da publicacao, e nao depois: `cmd/publish-v2-direct` LE este arquivo
# para carimbar o `datePublished` do JSON-LD e o `approved_at` do manifesto.
# Rodando depois, a data certa so alcancaria o publico na onda seguinte -- e ate
# la a flag `-published-at "$HOJE"` teria carimbado a data de hoje outra vez.
#
# A FONTE DELE E O HISTORICO GIT DO MANIFESTO, que a etapa 8.05/9 passou a
# gravar: o gerador percorre os commits do published_manifest e anota em qual
# deles cada rota aparece pela PRIMEIRA vez. Logo, a passada de hoje enxerga o
# manifesto que a onda de ONTEM commitou; a rota que estreia HOJE entra no
# registro na onda seguinte, e nesse meio-tempo ela usa a data da passada, que
# para rota nova e a data certa. Enquanto o manifesto nao era commitado, a fonte
# que consertaria o dado era justamente a que a onda deixava de gravar.
#
# NAO REPROVA A ONDA: metadado que nao avancou e defeito de sinal, nao de
# conteudo, e o publicador ja trata ausencia do arquivo caindo na data da
# passada. Registra e segue -- mesma postura da 7.9/9.
if timeout 900 nice -n 19 python3 ./tools/generate-first-published-at \
	>"$LOGS_COLETA/estreia.log" 2>&1; then
	grep -E 'intents com data recuperada|intents ja conhecidos|gravado' "$LOGS_COLETA/estreia.log" | sed 's/^/  /'
else
	echo "  data de estreia: FALHOU (ver $LOGS_COLETA/estreia.log) — a onda segue, a estreia fica congelada"
	registra "estreia"
fi

# ---------------------------------------------------------------- 6. PUBLICAR
etapa "8/9 publicação transacional"
if timeout 1800 nice -n 10 $GO run ./cmd/publish-v2-direct \
	-published-at "$HOJE" -reviewed-at "$HOJE" -allow-public-write \
	>"$LOGS_COLETA/publica.log" 2>&1; then
	grep -E 'manifesto \+ gate index|publishedmanifest.Validate|HTML escrito|recarga' \
		"$LOGS_COLETA/publica.log" | sed 's/^/  /'
else
	registra "publicacao"
	tail -5 "$LOGS_COLETA/publica.log" >&2
	# A ONDA PARA AQUI, e a diferença é grande: até 2026-08-26 este ramo apenas
	# registrava a falha e SEGUIA para as etapas 8.5/9 e 9/9 — e a 9/9 RECARREGA O
	# SERVIDOR.
	#
	# Recarregar depois de uma publicação que falhou é o gatilho do pior modo de
	# falha que este portal tem. A transação escreve sitemap e manifesto em
	# momentos distintos; interrompida no meio, o disco fica com sitemap sem
	# manifesto correspondente, e essa condição ABORTA O BOOT
	# (published_manifest_sitemap_loc_without_manifest). Como a unit do servidor
	# tem Restart=always, RestartSec=5 e StartLimitIntervalSec=0 — sem teto —, o
	# resultado é laço infinito de reinício, provocado pela própria onda.
	#
	# E há dois danos menores no mesmo caminho: recomprimir brotli (8.5/9) sobre
	# HTML de publicação parcial propaga o parcial para o canal que a Cloudflare
	# consome, e anunciar ao IndexNow (9/9) URLs de uma transação que falhou é pior
	# que não anunciar — o buscador vem buscar o que não está lá.
	#
	# As outras cinco paradas desta onda (flag inválida, reparo quebrado,
	# preservação, texto repetido, texto partido) já seguiam este padrão: `registra`
	# e `exit 1`. A publicação era a exceção, e era justamente a mais cara.
	echo "  A ONDA PAROU: a publicacao transacional falhou, e recarregar o servidor" >&2
	echo "  depois disso pode reinicia-lo contra sitemap sem manifesto -- condicao" >&2
	echo "  que aborta o boot, com Restart=always e sem teto de tentativas." >&2
	# EXIT 2, nao 1: publicacao transacional que falha e a coisa mais cara que
	# acontece nesta onda -- e era indistinguivel, no codigo de saida, de "um gate
	# reprovou uma pagina". A unit mascarava o 1 e o dono nunca era alertado do
	# caso grave. Auditoria de 2026-08-28.
	exit 2
fi

# --------------------------------------- 6.1 O QUE A TRANSACAO ACABOU DE GRAVAR
etapa "8.05/9 commit do manifesto publicado e do registro de estreia"
# DEFEITO N13, medido em 2026-09-16: a onda commitava portfolio (5/9) e paginas
# (6/9) e NUNCA o `published_manifest.jsonl`. Ele estava modificado ha 6 dias no
# worktree, com o ultimo commit em 2026-09-10.
#
# O CUSTO NAO E COSMETICO, e fecha um laco: o registro de estreia da etapa
# 7.95/9 deriva a data do HISTORICO GIT deste manifesto. Sem o commit, a rota
# publicada hoje nunca ganha evidencia datada, o publicador cai na flag
# `-published-at "$HOJE"` amanha, e a data de estreia anda mais um dia -- todo
# dia. A fonte que conserta o dado era a que a onda deixava de gravar.
#
# O `add` leva o CAMINHO EXATO, nunca o diretorio: o indice e compartilhado
# entre sessoes e `data/editorial` inteiro varreria estoque, portfolio e censo
# de quem estiver trabalhando ao lado. A mensagem vai por ARQUIVO, que e o
# contrato deste repositorio, e as duas invocacoes ficam em linhas separadas
# porque o pre-commit compila o INDICE e reprova se ele mudar no meio.
#
# DEPOIS da publicacao transacional, porque e ela quem escreve os dois arquivos,
# e so no ramo de sucesso -- commitar manifesto de transacao que falhou gravaria
# no historico um retrato que o disco nao tem.
ESTREIA_PARA_COMMIT="data/editorial/first_published_at.json"
MANIFESTO_PARA_COMMIT="data/editorial/published_manifest.jsonl"
MENSAGEM_MANIFESTO="$LOGS_COLETA/commit-manifesto.msg"
# ESTA ETAPA E LOAD-BEARING, E POR ISSO ELA NAO FALHA EM SILENCIO.
#
# Ela NAO interrompe a onda: a publicacao ja aconteceu e esta coerente, e parar
# aqui deixaria `.br` velho ao lado de HTML novo (8.5/9) e o servidor sem recarga
# (9/9) -- dois danos maiores que o que ela evita. Mas falhar sem alarme e o
# padrao que produziu os tres elos deste defeito, entao a falha sai NOMEADA, com
# a consequencia e o comando de recuperacao, e a falha ACUMULADA (manifesto sem
# commit ha mais de um dia) entra no relatorio com chave propria.
#
# RECONCILIACAO, e ate onde ela vai: um commit perdido NAO perde a data. A etapa
# 7.95/9 usa tambem o registro de revisao de conteudo como TETO, entao a rota
# volta a ser datada no ciclo seguinte, com no maximo UM dia de atraso; e o
# `datePublished` SERVIDO nao e afetado, porque `cmd/publish-v2-direct` toma o
# minimo entre a data declarada, o registro e a revisao. O que o commit perdido
# custa e precisao de um dia no registro -- nao a data.
if [ "$COMMIT_RESTRITO" = "1" ]; then
	# O MANIFESTO E O REGISTRO DE ESTREIA FECHAM UM LACO, e por isso eles estao
	# na allowlist da porta restrita: `tools/generate-first-published-at` deriva
	# a estreia do HISTORICO GIT deste manifesto. Sem este commit a rota
	# publicada hoje nunca ganha evidencia datada, o publicador cai na flag
	# `-published-at "$HOJE"` amanha, e a data de estreia anda mais um dia --
	# todo dia. Foi assim que o manifesto passou seis dias sem commit e 999 rotas
	# ficaram sem evidencia datada nenhuma.
	#
	# NAO INTERROMPE A PASSADA em nenhuma classe: a publicacao ja aconteceu e
	# esta coerente, e parar aqui deixaria `.br` velho ao lado de HTML novo e o
	# servidor sem recarga -- dois danos maiores que o que se evitaria. O custo
	# de um commit perdido e' de UM dia de precisao no registro, e nunca na data
	# SERVIDA: `cmd/publish-v2-direct` toma o minimo entre a data declarada, o
	# registro e a revisao de conteudo.
	if ! git diff --quiet -- "$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"; then
		if ! commita_restrito publicacao "$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"; then
			quarentena "commit_de_publicacao_adiado_${CLASSE_DO_COMMIT}" \
				"o commit do manifesto e do registro de estreia nao passou ($CLASSE_DO_COMMIT); o custo e' de UM dia de precisao no registro de estreia, nunca na data servida" \
				"a passada seguinte commita; se a classe for peca, leia o log em .agents/runtime/cerebro-commitar/" \
				"$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"
		else
			echo "  manifesto e estreia commitados pela porta restrita"
		fi
	else
		echo "  manifesto e estreia sem novidade"
	fi
elif ! git diff --quiet -- "$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"; then
	printf '%s\n' "chore(publicacao): manifesto publicado e registro de estreia da passada $ROTULO de $HOJE" \
		>"$MENSAGEM_MANIFESTO"
	com_teto 300 "git add manifesto+estreia" git add "$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"
	if com_teto 600 "git commit manifesto+estreia" git commit -q -F "$MENSAGEM_MANIFESTO" -- "$MANIFESTO_PARA_COMMIT" "$ESTREIA_PARA_COMMIT"; then
		echo "  manifesto e estreia commitados"
	else
		registra "commit:manifesto"
		ULTIMO_COMMIT_DO_MANIFESTO="$(git log -1 --format=%cd --date=short -- "$MANIFESTO_PARA_COMMIT" 2>/dev/null || true)"
		echo "  commit do manifesto FALHOU -- a onda segue, e o custo e precisao de UM dia" >&2
		echo "  no registro de estreia (o servido nao muda: o publicador toma o minimo)." >&2
		echo "  ultimo commit do manifesto: ${ULTIMO_COMMIT_DO_MANIFESTO:-nenhum} / hoje: $HOJE" >&2
		echo "  recuperacao, em DOIS comandos separados (o pre-commit compila o indice):" >&2
		echo "    git add $MANIFESTO_PARA_COMMIT $ESTREIA_PARA_COMMIT" >&2
		echo "    git commit -F $MENSAGEM_MANIFESTO -- $MANIFESTO_PARA_COMMIT $ESTREIA_PARA_COMMIT" >&2
		# INICIO DO DIAGNOSTICO ACUMULADO 8.05/9 -- ancora literal, nao decoracao:
		# tools/test_onda_commit_do_manifesto.py extrai EXATAMENTE estas linhas e as
		# executa com uma data forjada, porque o ramo so roda quando o commit falha.
		if [[ -n "$ULTIMO_COMMIT_DO_MANIFESTO" ]]; then
			DIAS_SEM_COMMIT=$((( $(date -d "$HOJE" +%s) - $(date -d "$ULTIMO_COMMIT_DO_MANIFESTO" +%s)) / 86400))
			# DOIS DIAS E OUTRA COISA. Uma falha isolada custa um dia de precisao;
			# duas seguidas significam que a causa nao e transitoria -- foi assim
			# que o manifesto passou 6 dias sem commit e 999 rotas ficaram sem
			# evidencia datada nenhuma. Chave propria para nao se confundir com a
			# falha do dia no relatorio.
			if ((DIAS_SEM_COMMIT >= 2)); then
				registra "commit:manifesto-acumulado-${DIAS_SEM_COMMIT}d"
				echo "  ACUMULADO: $DIAS_SEM_COMMIT dias sem commit do manifesto -- a causa nao e transitoria." >&2
			fi
		fi
		# FIM DO DIAGNOSTICO ACUMULADO 8.05/9
	fi
else
	echo "  manifesto e estreia sem novidade"
fi

# ------------------------------------------------- 8-bis. FILA DE REFINAMENTO
# A política de 2026-08-06 é explícita: o que entra como MÉDIO "vira fila de
# refinamento com causa nomeada" — publicar não encerra o defeito.
#
# O publicador JÁ detecta e imprime essas classes ("gate de qualidade: N
# classe(s) de achado MÉDIO", seguido de uma linha por classe). O que faltava
# era alguém guardar: a onda grepava só manifesto, HTML e recarga, então o aviso
# morria em "$LOGS_COLETA/publica.log" — arquivo volátil que ninguém lê às
# 04:28. Foi assim que 8 páginas de diário ficaram no ar com "edição" repetida
# 47 vezes; o publicador avisou todos os dias e o aviso não tinha destinatário.
#
# A fila NÃO reprova a onda. Médio publica, por decisão do dono; o que muda é
# que o defeito passa a ter registro datado, contagem e causa nomeada.
FILA_REFINAMENTO="data/ops/refinement_queue.jsonl"
if grep -q 'achado MÉDIO' "$LOGS_COLETA/publica.log" 2>/dev/null; then
	# O ROTULO ENTRA COMO `origem` (2026-09-16): a deduplicacao abaixo e' por
	# (data, origem), e com a origem literal `onda-diaria` a passada do
	# publicador SUBSTITUIRIA a linha da onda do mesmo dia -- a divida de um
	# produtor apagando a do outro, com a serie continuando a somar certo e
	# medindo errado.
	com_teto 300 "fila de refinamento" python3 - "$FILA_REFINAMENTO" "$HOJE" "$LOGS_COLETA/publica.log" "$ROTULO" <<'PYFILA'
import json, re, sys
fila, dia, log, origem = sys.argv[1:5]
classes = {}
dentro = False
for linha in open(log, encoding="utf-8", errors="replace"):
    if "achado MÉDIO" in linha:
        dentro = True
        continue
    if not dentro:
        continue
    # As linhas da lista vêm indentadas: "  codigo    N ocorrência(s)".
    casado = re.match(r"\s+([a-z0-9_]+)\s+(\d+) ocorr", linha)
    if casado:
        classes[casado.group(1)] = int(casado.group(2))
    elif linha.strip() and not linha.startswith(" "):
        break
if classes:
    # UMA LINHA POR DIA E ORIGEM, NAO UMA POR EXECUCAO.
    #
    # Isto era `open(fila, "a")` puro, e a onda roda mais de uma vez por dia
    # quando alguem a relanca. Resultado medido em 2026-08-29: a data
    # 2026-08-26 aparecia QUATRO vezes, com o mesmo conteudo, e qualquer soma
    # sobre a fila multiplicava a divida por quatro. Serie que conta o mesmo
    # dia varias vezes nao mede tendencia -- e tendencia e a unica pergunta
    # que essa fila responde: a divida esta crescendo ou caindo?
    registro = {
        "data": dia,
        "origem": origem,
        "classes": classes,
        "total": sum(classes.values()),
    }
    anteriores = []
    try:
        with open(fila, encoding="utf-8") as entrada:
            for linha in entrada:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    antigo = json.loads(linha)
                except json.JSONDecodeError:
                    anteriores.append(linha)  # linha ilegivel se preserva
                    continue
                if antigo.get("data") == dia and antigo.get("origem") == origem:
                    continue  # substituida pela execucao de agora
                anteriores.append(json.dumps(antigo, ensure_ascii=False))
    except FileNotFoundError:
        pass
    anteriores.append(json.dumps(registro, ensure_ascii=False))
    with open(fila, "w", encoding="utf-8") as saida:
        saida.write("\n".join(anteriores) + "\n")
    for codigo, quantos in sorted(classes.items(), key=lambda par: -par[1]):
        print(f"  fila de refinamento: {codigo} — {quantos} ocorrência(s)")
PYFILA
else
	echo "  fila de refinamento: nenhum achado médio nesta onda"
fi

# ------------------------------------------------- 6.5 RECOMPRIMIR O QUE MUDOU
etapa "8.5/9 brotli estatico das paginas reescritas"
# ESTA ETAPA EXISTE PORQUE A ANTERIOR CRIA A BOMBA QUE ELA DESARMA.
#
# `brotli_static on` manda o nginx servir `$uri.br` quando o arquivo existe, e
# ele NÃO compara frescor com o fonte. A etapa 8/9 reescreve `index.html`,
# `feed.xml`, `rss.xml`, `sitemap.xml` e os shards — todos com gêmea `.br` desde
# 2026-08-26. Sem recomprimir aqui, o disco fica com HTML novo ao lado de `.br`
# velho, e quem pede `Accept-Encoding: br` recebe o velho.
#
# Quem pede br é justamente quem não pode receber errado: medido no access log,
# a Cloudflare puxa a origem comprimida (os fetches batem BYTE A BYTE com o
# `stat` dos `.br`). Ou seja, o corpo velho não ficaria num cliente isolado —
# entraria no cache de borda e seria distribuído a TODOS, enquanto o IndexNow da
# etapa seguinte anuncia essas mesmas URLs como recém-atualizadas.
#
# Roda ANTES da 9/9 de propósito: anunciar ao buscador uma URL cujo corpo servido
# ainda é o de ontem é pior que não anunciar. E o gerador poda antes de comprimir,
# então uma interrupção aqui deixa AUSÊNCIA de `.br` (que o nginx resolve
# comprimindo em q5) e nunca conteúdo velho.
# O exit vem de PIPESTATUS[0], nunca do pipeline: `cmd | sed` devolve o status do
# SED, e um `if !` em cima disso jamais dispararia. É a mesma armadilha que a
# etapa 9/9 comenta logo abaixo — ela morde duas vezes no mesmo arquivo.
com_teto 1800 "generate-brotli-static" nice -n 19 ./tools/generate-brotli-static --jobs 4 2>&1 | sed 's/^/  /'
if [[ ${PIPESTATUS[0]} -ne 0 ]]; then registra "brotli"; fi

etapa "8.6/9 a onda avançou? (conjunto de intents, não contagem de shard)"
# Vem DEPOIS da publicacao transacional e ANTES dos gates de resultado, porque
# e' o veredito da onda: se o acervo nao ganhou nenhuma rota, tudo o que os
# gates abaixo medirem sera' sobre o acervo de ontem. Nao interrompe a onda --
# a publicacao ja aconteceu e esta' coerente --, mas entra em `registra` e o
# relatorio do dia sai marcado.
# ★ QUANDO 0 E' O PISO CERTO, e por que isso NAO e' afrouxar o gate (2026-09-16)
#
# `--minimo 1` existe porque a onda das 04:20 tem por FUNCAO trazer rota nova:
# ela coleta a fonte oficial do dia e monta pagina do que chegou. Em 2026-09-09
# ela imprimiu "415 paginas" com `novas: 0` e a fabrica ficou cinco dias parada
# sem um unico vermelho — este piso e' a correcao daquilo, e na onda ele fica.
#
# A passada de ENRIQUECIMENTO do cerebro e' outra grandeza: o comentario autoral
# entra numa pagina que JA existe e JA esta publicada, e o produto dela e' o
# corpo da rota mudando, nao um `unique_intent_id` novo. `novas_publicadas` e'
# ZERO POR CONSTRUCAO ali, e cobrar 1 seria reprovar a passada por ela ter
# funcionado como foi desenhada.
#
# O piso NAO fica sem substituto: quem cobra o resultado dessa passada e'
# `tools/publicar-estoque`, que mede, ANTES e DEPOIS, quantos comentarios
# aprovados do cerebro ainda nao estao no estoque -- criterio POSITIVO e mais
# estrito que "apareceu rota nova", porque nomeia exatamente quais pecas
# faltavam e quais continuam faltando.
#
# E o que este gate protege de verdade continua valendo nos dois casos: ele
# tambem conta `sumiram`, e rota que DESAPARECE do manifesto reprova
# independentemente do piso.
if ! com_teto 300 "check-onda-avanca --depois" ./tools/check-onda-avanca --depois --minimo "$MINIMO_NOVAS" --rotulo "$ROTULO"; then
	registra "onda-avanca"
fi

etapa "8.7/9 gates da onda: o que a onda acabou de produzir esta correto?"
# POR QUE ESTES TRES, E POR QUE AQUI (2026-08-27).
#
# Os tres nasceram nesta sessao e nenhum tinha gatilho — eram gates orfaos, a
# mesma condicao de outros 98 no repositorio. Gate que existe e nao roda e igual
# a gate que nao existe, e este e o unico ponto do dia em que a onda ja produziu
# tudo o que eles medem.
#
# Rodam DEPOIS da publicacao e da compressao de proposito: os tres medem o
# RESULTADO (o que ficou no ar, o que ficou no estoque), nao a intencao. E
# nenhum deles PARA a onda: a publicacao ja aconteceu e esta coerente; o que eles
# encontram e fila de correcao, registrada em `registra` para o relatorio do dia.
for gate in check-frescor-canal-diario check-derived-authorial-floor check-public-sem-lixo check-edge-vary-contract check-lastmod-causalidade check-bot-telemetry-honesty-selftest check-served-vs-manifest check-cronologia-de-publicacao; do
	if [[ -x "./tools/$gate" ]]; then
		"./tools/$gate" >"$LOGS_COLETA/$gate.log" 2>&1
		codigo=$?
		if [[ $codigo -ne 0 ]]; then
			echo "  $gate: reprovou (exit $codigo) — ver $LOGS_COLETA/$gate.log"
			tail -3 "$LOGS_COLETA/$gate.log" | sed 's/^/    /'
			registra "$gate"
		else
			echo "  $gate: ok"
		fi
	fi
done

etapa "8.8/9 fila de propostas de reescrita (o conteudo parado vira pauta)"
# POR QUE ESTA ETAPA NASCEU (2026-09-16, P8), com o numero que a justifica.
#
# tools/generate-propostas-reescrita era ORFAO — nenhum runner, timer ou hook o
# chamava — e, pior, NAO TERMINAVA sobre o corpus atual: ele buscava o acordao
# candidato por NORMA INTEIRA, e o CPC sozinho reune dezenas de milhares de
# acordaos, o que punha o cosseno TF-IDF na casa de 10^8 chamadas.
# data/ai/propostas_reescrita.jsonl estava congelado no lote unico de
# 2026-09-08, 100 propostas, zero aplicadas.
#
# Corrigido o indice para exigir DISPOSITIVO (artigo) em comum, medido em
# 2026-09-16 sobre o grafo real: 467.479 pares avaliados, 124,5 s de parede,
# 1,03 GB de pico, 5.998 candidatas (1.968 delas de precedente, contra 100 no
# lote antigo). A mediana da similaridade dos precedentes subiu de 0,020 para
# 0,195 — o laco por artigo nao e so mais rapido, e o unico que sustenta
# atribuicao.
#
# POR QUE AQUI. Ele le content/pages.json, o censo de severidade (7/9) e
# data/ops/eventos/, e os tres so estao frescos depois da publicacao (8/9) e do
# commit do manifesto (8.05/9). Roda DEPOIS dos gates da onda porque nao decide
# nada sobre o que foi publicado: produz PAUTA.
#
# NAO PARA A ONDA. A saida e proposta com evidencia, nunca pagina: falhar aqui
# significa que a pauta do dia nao foi atualizada, e a do dia anterior continua
# servindo. Entra em `registra` para o relatorio.
if timeout 900 nice -n 19 python3 ./tools/generate-propostas-reescrita --dias 7 --limite 100 --timings \
	>"$LOGS_COLETA/propostas-reescrita.log" 2>&1; then
	printf '  %s\n' "$(grep -m1 'propostas (de' "$LOGS_COLETA/propostas-reescrita.log" | cut -c1-160)"
else
	printf '  falhou (exit %s) — a pauta anterior segue servindo, a onda continua\n' "$?"
	registra "propostas:reescrita"
fi

# ---------------------------------------------------------------- 7. PROVAR
etapa "9/9 prova em HTTP real"
# Relatório do publicador não é prova. A prova é a rota responder, o markdown
# existir e a borda servir o mesmo byte que o disco.
# TETO: a recarga fala com o systemd e espera o socket voltar. Sem teto, um
# `systemctl` preso numa transação do gerenciador segura a onda inteira — e a
# onda segura o flock, e o dia seguinte não roda.
if ! com_teto 180 "reload-wiki-server" ./tools/reload-wiki-server; then registra "recarga"; fi
# A ONDA CORRIGE O QUE SABE CORRIGIR, em vez de so reportar.
#
# Ate 2026-08-26 esta linha era `if ! check; then registra; fi`: a onda terminava
# PARCIAL toda vez que a borda ficasse com a versao anterior de um artefato, e
# alguem precisava purgar a mao no dia seguinte. Purga de artefato de descoberta
# e barata, idempotente e nao destroi nada -- exatamente o tipo de conserto que
# nao precisa de gente.
#
# UMA TENTATIVA, e so uma: se a purga nao resolver, a causa NAO e cache (foi
# assim que a injecao do Cloudflare Web Analytics ficou escondida por tras de
# um "purgue" repetido em laco), e o gate agora nomeia a causa real. Repetir
# purga contra injecao gastaria cota e mascararia o defeito.
if ! com_teto 300 "check-edge-discovery-freshness" ./tools/check-edge-discovery-freshness; then
	echo "  borda divergente — purgando os artefatos de descoberta e reconferindo (1 tentativa)"
	if ./tools/purge-edge-cache --url / --url /sitemap.xml --url /feed.xml --url /rss.xml \
		--url /robots.txt --url /llms.txt --url /llms-full.txt >/dev/null 2>&1; then
		# A borda precisa de alguns segundos para propagar a purga antes da reconferencia.
		timeout 20 tail -f /dev/null 2>/dev/null || true
		if com_teto 300 "check-edge-discovery-freshness (reconferencia)" ./tools/check-edge-discovery-freshness; then
			echo "  frescor-borda: resolvido pela purga automatica"
		else
			registra "frescor-borda"
		fi
	else
		registra "frescor-borda"
	fi
fi
# O exit REAL vem de PIPESTATUS[0]: "cmd | tail | sed" devolve o status do SED,
# e um IndexNow que falhasse passaria por bem-sucedido. É a armadilha que este
# repositório já catalogou — e ela estava aqui.
timeout 600 python3 tools/generate-indexnow-incremental-submit 2>&1 | tail -4 | sed 's/^/  /'
if [[ ${PIPESTATUS[0]} -ne 0 ]]; then registra "indexnow"; fi

# ★ FIM VERDADEIRO. Ver `etapa()`: sem esta marca, toda parada por `exit 1`
# direto de gate era gravada no ledger como `escopo: completa` -- e o publicador
# autonomo, que le esse campo, imprimia "cadeia completou: sim" para uma cadeia
# parada na 4/9. A marca fica na ULTIMA linha executavel, depois da 9/9.
CHEGOU_AO_FIM=1
