#!/usr/bin/env python3
"""check-sca-sbom-direct-coverage -- read-only.

Mede a COBERTURA real dos SBOMs: para cada modulo Go rastreado, quantos pares
`module@version` das dependencias DIRETAS aparecem no SBOM versionado dele.

Existe porque "o SBOM esta velho" e uma afirmacao sobre mtime, e mtime nao e
cobertura. A pergunta que importa e outra: das dependencias que este modulo
declara HOJE, quantas o SBOM commitado descreve? Um SBOM com timestamp de ontem
e versoes de tres meses atras passa em qualquer conferencia de data e nao
descreve nada.

O par conferido e `nome@versao`, nao so o nome: SBOM que lista a dependencia
certa na versao errada e pior que SBOM sem ela, porque parece cobertura.

Sai 1 quando ha modulo sem SBOM ou par direto sem cobertura.
"""
import json
import os
import re
import subprocess
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def slug(diretorio):
    """Espelha scaSBOMSlug em internal/checks/checks.go."""
    d = diretorio.strip("/")
    if d == "":
        return ""
    if d == "tools/sca":
        return "tools"
    return d.split("/")[-1]


def caminho_bom(diretorio):
    s = slug(diretorio)
    return "data/ops/sca_cyclonedx_bom.json" if not s else f"data/ops/sca_{s}_cyclonedx_bom.json"


def diretas(caminho_gomod):
    """Requires diretos: dentro de `require (...)` ou em linha, sem // indirect."""
    fora = []
    bloco = False
    with open(caminho_gomod, encoding="utf-8") as handle:
        for linha in handle:
            nu = linha.strip()
            if nu.startswith("require ("):
                bloco = True
                continue
            if bloco and nu == ")":
                bloco = False
                continue
            if "// indirect" in linha:
                continue
            if not (bloco or nu.startswith("require ")):
                continue
            m = re.match(r"^(?:require\s+)?([^\s/][^\s]*)\s+(v[^\s]+)", nu)
            if m:
                fora.append((m.group(1), m.group(2)))
    return fora


def main():
    os.chdir(RAIZ)
    modulos = subprocess.run(
        ["git", "ls-files", "--", "go.mod", "*/go.mod"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    if not modulos:
        print("check-sca-sbom-direct-coverage: nenhum go.mod rastreado -- descoberta falhou", file=sys.stderr)
        return 1

    total = falhas = 0
    problemas = []
    for gomod in sorted(modulos):
        diretorio = "/" if gomod == "go.mod" else "/" + os.path.dirname(gomod)
        bom = caminho_bom(diretorio)
        pares = diretas(gomod)
        total += len(pares)
        if not os.path.exists(bom):
            falhas += len(pares)
            problemas.append(
                f"sca_sbom_ausente modulo={diretorio} bom={bom} diretas={len(pares)} "
                f"-- gere com `./tools/generate-sca-sbom --scope={slug(diretorio) or 'root'}`"
            )
            continue
        with open(bom, encoding="utf-8") as handle:
            documento = json.load(handle)
        conhecidos = {(c.get("name"), c.get("version")) for c in documento.get("components", [])}
        faltando = [f"{n}@{v}" for n, v in pares if (n, v) not in conhecidos]
        falhas += len(faltando)
        estado = "ok" if not faltando else f"faltam {len(faltando)}"
        print(f"{diretorio:<24} {os.path.basename(bom):<40} {len(pares) - len(faltando)}/{len(pares)} {estado}")
        for par in faltando:
            problemas.append(f"sca_sbom_direta_sem_cobertura modulo={diretorio} par={par}")

    percentual = 100.0 * falhas / total if total else 0.0
    print(f"\nTOTAL diretas={total} sem_cobertura={falhas} ({percentual:.1f}%)")
    for problema in problemas[:40]:
        print("  " + problema)
    if len(problemas) > 40:
        print(f"  ... e mais {len(problemas) - 40}")
    return 1 if falhas else 0


if __name__ == "__main__":
    raise SystemExit(main())
