#!/usr/bin/env python3
"""generate-catalog-sha-pin-20260805 — fixa o digest do catalogo de source_hints.

POR QUE. O relaunch da fila de escrita e o drain dos lotes leem o catalogo em
momentos diferentes. Se cada um enxergar uma versao, um intent resolve num
passo e nao resolve no seguinte, e o lote volta ao parqueamento sem causa
visivel. O pin declara QUAL catalogo vale para esta rodada: quem consome
confere o digest antes de projetar fontes.

Escreve data/ops/catalog_sha_pin_20260805.txt com o sha256 do arquivo exato,
o numero de chaves e a data. Read-only sobre o catalogo.
"""
import datetime as dt
import hashlib
import json
import pathlib

ROOT = pathlib.Path("/opt/wiki")
CATALOG = ROOT / "data/editorial/v2_source_hint_catalog.json"
PIN = ROOT / "data/ops/catalog_sha_pin_20260805.txt"

raw = CATALOG.read_bytes()
digest = hashlib.sha256(raw).hexdigest()
chaves = len(json.loads(raw.decode("utf-8"))["source_hints"])
agora = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")

PIN.write_text(
    "# Pin do catalogo de source_hints — rodada de destravamento da fila de escrita\n"
    "# O relaunch e o drain TEM de usar este mesmo catalogo: confira o digest\n"
    "# antes de projetar fontes. Divergiu, nao projete — realinhe primeiro.\n"
    f"arquivo: {CATALOG.relative_to(ROOT).as_posix()}\n"
    f"sha256: {digest}\n"
    f"chaves: {chaves}\n"
    f"bytes: {len(raw)}\n"
    f"fixado_em: {agora}\n",
    encoding="utf-8")
print("sha256:", digest)
print("chaves:", chaves, "| bytes:", len(raw))
print("pin:", PIN)
