#!/usr/bin/env python3
"""Normaliza o wave2 do recheck Cowork para o schema estrito de
LoadCoworkLiveBrowserInsumo (internal/v2sourceprovenance/cowork_live_browser.go).

Le data/source-audit/cowork_source_recheck_20260722_wave2.jsonl (schema livre:
url, reachable, http_status, final_url, title, looks_official, method, note,
verified_at) e ANEXA os registros convertidos ao arquivo ja sancionado
data/source-audit/cowork_source_recheck_20260722.jsonl (schema exigido pelo
loader: url, reachable, final_url, title, looks_official, note, verified_at,
method, affected_pages, verdict).

Por que anexar em vez de escrever um arquivo "_wave2_normalized.jsonl"
separado: coworkInsumoRelPathPattern (cowork_live_browser.go:44) e
"^data/source-audit/cowork_source_recheck_\\d{8}\\.jsonl$" -- qualquer sufixo
depois dos 8 digitos (inclusive "_normalized") reprova o load com
v2_source_provenance_cowork_insumo_path_not_sanctioned. Mudar esse regex
tocaria cowork_live_browser.go, que esta em bundle Go done_pending_commit de
outra frente e e proibido nesta tarefa. Anexar ao arquivo ja aceito e a unica
rota que nao toca codigo.

Regras de honestidade (nunca fabricar justificativa):
- method: recebe o prefixo obrigatorio "cowork-fable-live-" + o metodo
  original do wave2 (live_fetch_200 -> cowork-fable-live-fetch-200;
  websearch_confirmed -> cowork-fable-live-websearch-confirmed). O metodo
  final ainda descreve, na integra, como o wave2 verificou a URL.
- note: preservada verbatim. NENHUM marcador de "precisa de navegador"
  (client-rendered/client-side/captcha/spa requer js) e adicionado por
  padrao. So os 3 registros que o proprio wave2 ja descreve como pagina STJ
  renderizada por JS ("JS query page"/"JS page") recebem o sufixo
  " (client-rendered)" -- e uma reafirmacao textual do mesmo fato ja
  registrado pelo wave2, nao uma alegacao nova. Nenhum outro registro e
  marcado: URLs com fragmento (#art...) nunca colidem com a chave de
  requisicao (que e fragment-stripped) e paginas gov.br/planalto normais
  passam pelo fetch metadata-only comum sem precisar do insumo.
- verdict: "ok" para todos -- nenhum registro do wave2 tem verdict
  "replace_source"; todos sao reachable=true / looks_official=true.
- affected_pages: contagem real de ocorrencias da URL exata em
  data/editorial/v2_pages/*.jsonl (grep de string, read-only), nunca 0
  arbitrario.

Efeitos colaterais: escreve (append) em
data/source-audit/cowork_source_recheck_20260722.jsonl e em
data/source-audit/cowork_source_recheck_20260722_wave2_normalize_manifest.json
(proveniencia: source_file, normalized_at, tool, mapping por URL). Nao toca
data/editorial/v2_pages nem codigo Go.
"""

import argparse
import glob
import json
import os
import sys
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
WAVE2_PATH = os.path.join(ROOT, "data/source-audit/cowork_source_recheck_20260722_wave2.jsonl")
TARGET_PATH = os.path.join(ROOT, "data/source-audit/cowork_source_recheck_20260722.jsonl")
MANIFEST_PATH = os.path.join(
    ROOT, "data/source-audit/cowork_source_recheck_20260722_wave2_normalize_manifest.json"
)
V2_PAGES_GLOB = os.path.join(ROOT, "data/editorial/v2_pages/*.jsonl")

# URLs cujo proprio wave2 ja documenta, no campo note, que a pagina exige
# renderizacao client-side (paginas de busca/edicao de informativo do STJ,
# servidas via JS). So estas recebem o marcador honesto "client-rendered".
GENUINE_CLIENT_RENDERED_URLS = {
    "https://processo.stj.jus.br/jurisprudencia/externo/informativo/?acao=pesquisarumaedicao&livre=0565.cod.",
    "https://scon.stj.jus.br/jurisprudencia/externo/informativo/?acao=pesquisar&aplicacao=informativo&livre=%40CNOT%3D013890",
    "https://processo.stj.jus.br/jurisprudencia/externo/informativo/?acao=pesquisarumaedicao&livre=%270882%27.cod.",
}

TARGET_FIELDS = [
    "url",
    "reachable",
    "final_url",
    "title",
    "looks_official",
    "note",
    "verified_at",
    "method",
    "affected_pages",
    "verdict",
]


def load_jsonl(path):
    records = []
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            records.append(json.loads(line))
    return records


def count_affected_pages(url, shard_texts):
    total = 0
    for text in shard_texts:
        if url in text:
            total += text.count(url)
    return total


def normalize_method(raw_method):
    raw_method = (raw_method or "").strip()
    if raw_method.startswith("cowork-fable-live-"):
        return raw_method
    mapped = raw_method.replace("_", "-")
    return "cowork-fable-live-" + mapped


def normalize_note(url, note):
    note = note or ""
    if url in GENUINE_CLIENT_RENDERED_URLS and "client-rendered" not in note.lower():
        return note + " (client-rendered)"
    return note


def build_target_record(raw, shard_texts):
    url = raw["url"]
    final_url = raw.get("final_url") or url
    record = {
        "url": url,
        "reachable": bool(raw.get("reachable", False)),
        "final_url": final_url,
        "title": raw.get("title", ""),
        "looks_official": bool(raw.get("looks_official", False)),
        "note": normalize_note(url, raw.get("note", "")),
        "verified_at": raw["verified_at"],
        "method": normalize_method(raw.get("method", "")),
        "affected_pages": count_affected_pages(url, shard_texts),
        "verdict": "ok",
    }
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="computa e imprime o resultado sem escrever em disco",
    )
    args = parser.parse_args()

    if not os.path.isfile(WAVE2_PATH):
        print(f"generate-cowork-recheck-normalize: insumo ausente: {WAVE2_PATH}", file=sys.stderr)
        return 2
    if not os.path.isfile(TARGET_PATH):
        print(f"generate-cowork-recheck-normalize: alvo sancionado ausente: {TARGET_PATH}", file=sys.stderr)
        return 2

    raw_records = load_jsonl(WAVE2_PATH)
    existing_records = load_jsonl(TARGET_PATH)
    existing_urls = {r["url"] for r in existing_records}

    shard_texts = []
    for path in sorted(glob.glob(V2_PAGES_GLOB)):
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            shard_texts.append(fh.read())

    normalized = []
    skipped_duplicate = []
    for raw in raw_records:
        if raw["url"] in existing_urls:
            skipped_duplicate.append(raw["url"])
            continue
        normalized.append(build_target_record(raw, shard_texts))

    for record in normalized:
        for field in TARGET_FIELDS:
            if field not in record:
                raise SystemExit(f"campo ausente apos normalizacao: {field} ({record.get('url')})")
        extra = set(record.keys()) - set(TARGET_FIELDS)
        if extra:
            raise SystemExit(f"campo nao permitido pelo schema estrito: {extra} ({record.get('url')})")

    manifest = {
        "tool": "tools/generate-cowork-recheck-normalize",
        "normalized_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "source_file": os.path.relpath(WAVE2_PATH, ROOT),
        "target_file": os.path.relpath(TARGET_PATH, ROOT),
        "records_in_source": len(raw_records),
        "records_appended": len(normalized),
        "records_skipped_duplicate_url": skipped_duplicate,
        "client_rendered_marked_urls": sorted(GENUINE_CLIENT_RENDERED_URLS),
        "appended_urls": [r["url"] for r in normalized],
    }

    if args.dry_run:
        print(json.dumps(manifest, ensure_ascii=False, indent=2))
        print(f"[dry-run] appended={len(normalized)} target={TARGET_PATH}")
        return 0

    with open(TARGET_PATH, "a", encoding="utf-8") as fh:
        for record in normalized:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")

    with open(MANIFEST_PATH, "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, ensure_ascii=False, indent=2)
        fh.write("\n")

    print(f"generate-cowork-recheck-normalize: appended={len(normalized)} target={TARGET_PATH} manifest={MANIFEST_PATH}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
