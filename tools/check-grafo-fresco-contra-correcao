#!/usr/bin/env python3
"""check-grafo-fresco-contra-correcao — READ-ONLY.

O grafo (`data/ai/grafo.sqlite`) é uma FUNÇÃO PURA de
`data/ai/extracoes_dispositivos.jsonl` — `tools/generate-grafo-juridico:277` lê o
arquivo inteiro e guarda a ÚLTIMA linha por chave. Quem consulta o grafo
(`mcp__wikijuridica__impacto`, `contexto_juridico`, `grafo`, e
`tools/generate-risco-superacao`, que roda no `ExecStartPost` da mesma unit) vê o
que o grafo tem, não o que a fonte diz.

POR QUE ESTE GATE NASCEU (2026-09-11). Em 2026-09-10 duas passadas de revisão
(`lista_nao_atravessa_norma_v7` e `norma_nomeada_no_artigo_v8`) retiraram de
`extracoes_dispositivos.jsonl` a citação `acordao:STJ:1444372 -> 13105!art253` —
um artigo do RISTJ que a quebra de lista tinha feito herdar a norma do CPC. O
writeback ficou correto no mesmo minuto. O grafo NÃO: ele fora regenerado ANTES
das duas passadas, e continuou servindo a aresta errada, com o `gerado_em` na cara
de quem lesse o manifesto. A lição ficou na mensagem de commit da regeneração
anterior e não na sequência — este gate é ela virando mecânica.

O CRITÉRIO, e por que ele não é "o arquivo é mais novo que o grafo". O cérebro
trabalha 24/7 e apende o tempo todo: "fonte mais nova que derivado" é o REGIME
NORMAL, e um gate com esse critério reprovaria sempre, viraria ruído e ensinaria
a ignorá-lo. O dano é outro, e é estreito: uma passada que REMOVE ou TROCA uma URN
que o grafo já publicou. Aí o grafo não está incompleto — está ERRADO.

Então, para cada chave com duas ou mais ocorrências no arquivo, este gate compara
o conjunto de URNs da ÚLTIMA linha com o da PENÚLTIMA:

  acréscimo  última ⊇ penúltima. O grafo está incompleto e o timer o completa.
             NÃO reprova. Medido em 2026-09-11: 1.530 das 2.015 chaves
             reprocessadas.
  correção   última removeu ou trocou URN da penúltima. REPROVA quando o
             `gerado_em` dessa linha for posterior ao `gerado_em` do grafo.
             Medido em 2026-09-11: 485 correções no histórico, ZERO delas
             posteriores ao grafo — o gate nasce verde, e nasce verde porque a
             regeneração foi feita, não porque o critério é frouxo.

A régua está em `.agents/runtime/regua/20260911-frescor-do-grafo-contra-correcao.md`,
escrita antes da medição.

CARDINALIDADE ANTES DA AMOSTRA. A primeira linha traz linhas, chaves, chaves
reprocessadas, acréscimos, correções e o `gerado_em` do grafo, ANTES de qualquer
veredito.

Uso:
    tools/check-grafo-fresco-contra-correcao
    tools/check-grafo-fresco-contra-correcao --raiz /caminho
"""
from __future__ import annotations

import argparse
import collections
import datetime
import json
import sqlite3
import sys
from pathlib import Path

EXTRACOES = "data/ai/extracoes_dispositivos.jsonl"
GRAFO = "data/ai/grafo.sqlite"
TETO_DE_LISTA = 20


def instante(texto: str) -> datetime.datetime | None:
    """RFC3339 em UTC, como o cérebro e o gerador do grafo gravam (`...Z`)."""
    texto = (texto or "").strip()
    if not texto:
        return None
    try:
        return datetime.datetime.fromisoformat(texto.replace("Z", "+00:00"))
    except ValueError:
        return None


def gerado_em_do_grafo(caminho: Path) -> str:
    """Lê `meta.gerado_em` sem tomar lock de escrita no SQLite vivo."""
    conexao = sqlite3.connect("file:%s?mode=ro" % caminho, uri=True)
    try:
        return dict(conexao.execute("select chave, valor from meta").fetchall()).get("gerado_em", "")
    finally:
        conexao.close()


def urns(registro: dict) -> set[str]:
    return {str(item.get("urn", "")).strip()
            for item in (registro.get("dispositivos") or [])
            if str(item.get("urn", "")).strip()}


def main(argv: list[str]) -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--raiz", default=None)
    argumentos = analisador.parse_args(argv)

    raiz = Path(argumentos.raiz).resolve() if argumentos.raiz \
        else Path(__file__).resolve().parent.parent

    caminho_extracoes = raiz / EXTRACOES
    caminho_grafo = raiz / GRAFO
    if not caminho_extracoes.exists():
        print("check-grafo-fresco-contra-correcao: sem %s — nada a comparar" % EXTRACOES)
        return 0
    if not caminho_grafo.exists():
        print("check-grafo-fresco-contra-correcao: sem %s — o grafo ainda não foi gerado" % GRAFO)
        return 0

    carimbo_do_grafo = gerado_em_do_grafo(caminho_grafo)
    quando_grafo = instante(carimbo_do_grafo)

    historico: dict[str, list[dict]] = collections.defaultdict(list)
    linhas = 0
    with caminho_extracoes.open(encoding="utf-8") as arquivo:
        for numero, linha in enumerate(arquivo, 1):
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError as erro:
                raise SystemExit("check-grafo-fresco-contra-correcao: %s linha %d: %s"
                                 % (caminho_extracoes, numero, erro))
            chave = str(registro.get("chave", "")).strip()
            if not chave:
                continue
            linhas += 1
            historico[chave].append(registro)

    acrescimos = 0
    correcoes: list[tuple[str, str, list[str]]] = []
    for chave, ocorrencias in historico.items():
        if len(ocorrencias) < 2:
            continue
        ultima, penultima = urns(ocorrencias[-1]), urns(ocorrencias[-2])
        if ultima >= penultima:
            acrescimos += 1
            continue
        correcoes.append((chave,
                          str(ocorrencias[-1].get("gerado_em", "")),
                          sorted(penultima - ultima)))

    reprocessadas = sum(1 for o in historico.values() if len(o) >= 2)
    print("linhas: %d | chaves: %d | reprocessadas: %d | acréscimo: %d | correção: %d | "
          "grafo gerado_em: %s"
          % (linhas, len(historico), reprocessadas, acrescimos, len(correcoes),
             carimbo_do_grafo or "(ausente)"))

    if quando_grafo is None:
        print("REPROVADO: o grafo não declara `gerado_em` em `meta` — sem ele nenhum "
              "consumidor consegue saber se a aresta que recebe ainda existe na fonte.")
        return 1

    posteriores = []
    for chave, carimbo, retiradas in correcoes:
        quando = instante(carimbo)
        if quando is not None and quando > quando_grafo:
            posteriores.append((chave, carimbo, retiradas))

    if not posteriores:
        print("  o grafo é posterior a toda correção: nenhuma URN retirada da fonte "
              "continua servida")
        return 0

    posteriores.sort(key=lambda p: p[1])
    print("REPROVADO: %d correção(ões) da fonte são POSTERIORES ao grafo — ele serve "
          "URN que a revisão já retirou." % len(posteriores))
    print("  `impacto`, `contexto_juridico` e `grafo` respondem com essa aresta, e "
          "`risco_superacao.jsonl` deriva dela.")
    print("  Regenere antes de afirmar qualquer número sobre o grafo:")
    print("    ./tools/generate-grafo-juridico --timings && ./tools/generate-risco-superacao --timings")
    for chave, carimbo, retiradas in posteriores[:TETO_DE_LISTA]:
        print("    %s  (corrigido em %s, retirou %s)"
              % (chave, carimbo, ", ".join(retiradas) or "(troca sem perda de conjunto)"))
    if len(posteriores) > TETO_DE_LISTA:
        print("    ... e mais %d (total já declarado acima)" % (len(posteriores) - TETO_DE_LISTA))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
