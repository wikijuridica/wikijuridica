#!/usr/bin/env python3
"""generate-v2-separador-milhar-citacao-20260806 — "art. 1723" vira "art. 1.723".

O DEFEITO: 153 ocorrências em 83 páginas NO AR citam artigo de lei sem o
separador de milhar — "o art. 1542 do Código Civil", "o art. 1723", "a Lei
13811/2019". A forma correta é "art. 1.542", "art. 1.723", "Lei 13.811/2019".

Não é preciosismo tipográfico: é a mesma classe que um auditor humano marcou
como REPROVADA:5 neste acervo, com a justificativa literal "Artefato de
numeração na citação legal: 'art. 1723 do Código Civil' (sem separador de
milhar), enquanto o restante da página usa a forma correta". Citação legal é o
que dá autoridade à página; escrita fora do padrão ela sinaliza texto gerado sem
revisão — exatamente o julgamento que o Google diz aplicar a conteúdo em escala.

TESTE DE FALSO POSITIVO, feito antes de escrever: extraí os 71 números distintos
capturados após "art."/"artigo" e TODOS caem entre 1.000 e 2.500 — a faixa dos
artigos do Código Civil, que termina no 2.046. Nenhum é ano, valor, CEP ou
número de processo. A regra de captura exige que o número NÃO seja seguido de
outro dígito, ponto, hífen ou barra, o que já exclui "1.723" (correto), datas e
números de lei com ano.

O que NÃO é tocado: número de até três dígitos (art. 927 não leva separador),
número já com ponto, e qualquer sequência seguida de "/" (Lei 8.078/90 com o ano
colado). O caso "Lei 13811/2019" é tratado à parte, porque ali o separador entra
no número da lei e a barra do ano permanece.

CONTRATO DE ESCRITA: lease de época, lock exclusivo, CAS pelo sha256 da linha
viva, escrita atômica com fsync, word_count recalculado (o separador não muda a
tokenização, mas recalcular é mais barato que supor), demais linhas byte a byte.
Idempotente. NÃO commita e NÃO republica.

Uso:
    tools/generate-v2-separador-milhar-citacao-20260806 --dry-run
    tools/generate-v2-separador-milhar-citacao-20260806
"""
from __future__ import annotations

import argparse
import fcntl
import glob
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.separador-milhar-citacao-20260806.lock"

# Artigo com 4 ou 5 dígitos, sem separador. O lookahead recusa dígito, ponto,
# hífen e barra logo depois — assim "1.723", "1723/2019" e "1723-A" não entram.
ARTIGO = re.compile(r"(\bart(?:igo)?s?\.?\s*)(\d{4,5})(?![\d.\-/])")
# Número de lei/decreto sem separador. A barra do ano PODE vir depois, e fica.
NORMA = re.compile(
    r"(\b(?:Lei|Leis|Decreto|Decretos|LC|Lei\s+Complementar)\s*n?[º°]?\s*)(\d{4,6})(?![\d.])")

# Faixa plausível de artigo em diploma brasileiro. O Código Civil termina no
# 2.046; fora disso, o número provavelmente não é artigo e o reparo se abstém.
ARTIGO_MIN, ARTIGO_MAX = 1000, 2500
# Faixa de número de lei federal: da década de 1930 até as atuais.
NORMA_MIN, NORMA_MAX = 1000, 30000

# PÁGINAS SOB ARQUIVO DE SUPERSESSÃO — não se corrigem por este canal.
#
# `fam-heranca-entra-na-partilha` está preservada em
# data/editorial/v2_superseded/duplicate-intent-consolidation-2026-07-15.jsonl, e
# o gate v2-supersession-integrity compara o registro ativo com aquele payload
# autenticado. Editá-la aqui produz
# `active_source_changed_without_provenance` e ABORTA O COMMIT — foi o que
# aconteceu em 2026-08-06.
#
# A correção dela não é proibida; é que exige o canal com proveniência durável
# (revisão independente, forward committed ou recut semântico), que é outro
# procedimento. Corrigir a formatação por atalho custaria a evidência que
# justifica a supersessão — vale menos que o defeito.
SOB_SUPERSESSAO = {
    "fam-heranca-entra-na-partilha",
}

CAMPOS_TEXTO = ("opening",)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value):
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record):
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def separar(numero: str) -> str:
    return format(int(numero), ",").replace(",", ".")


def corrigir_texto(texto):
    """Devolve (texto novo, quantas trocas)."""
    if not texto:
        return texto, 0
    trocas = 0

    def artigo(match):
        nonlocal trocas
        valor = int(match.group(2))
        if not (ARTIGO_MIN <= valor <= ARTIGO_MAX):
            return match.group(0)
        trocas += 1
        return match.group(1) + separar(match.group(2))

    def norma(match):
        nonlocal trocas
        valor = int(match.group(2))
        if not (NORMA_MIN <= valor <= NORMA_MAX):
            return match.group(0)
        trocas += 1
        return match.group(1) + separar(match.group(2))

    texto = ARTIGO.sub(artigo, texto)
    texto = NORMA.sub(norma, texto)
    return texto, trocas


def corrigir_registro(record):
    total = 0
    novo, n = corrigir_texto(record.get("opening"))
    if n:
        record["opening"] = novo
        total += n
    for section in record.get("sections") or []:
        for campo in ("heading", "text"):
            novo, n = corrigir_texto(section.get(campo))
            if n:
                section[campo] = novo
                total += n
    for item in record.get("faq") or []:
        for campo in ("q", "a"):
            novo, n = corrigir_texto(item.get(campo))
            if n:
                item[campo] = novo
                total += n
    for campo in ("title", "h1", "meta_description"):
        novo, n = corrigir_texto(record.get(campo))
        if n:
            record[campo] = novo
            total += n
    return total


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    shards = sorted(glob.glob(os.fspath(ROOT / "data/editorial/v2_pages/*.jsonl")))
    paginas = 0
    trocas = 0
    tocados = []

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for shard in shards:
                    path = Path(shard)
                    linhas = path.read_bytes().decode("utf-8").split("\n")
                    fim_newline = bool(linhas) and linhas[-1] == ""
                    if fim_newline:
                        linhas = linhas[:-1]
                    saida = []
                    mudou_shard = 0
                    for numero, raw in enumerate(linhas, 1):
                        if not raw.strip():
                            raise SystemExit(f"{shard}: linha em branco {numero}")
                        registro = json.loads(raw)
                        if registro.get("intent_id") in SOB_SUPERSESSAO:
                            saida.append(raw)
                            continue
                        digest = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
                        n = corrigir_registro(registro)
                        if not n:
                            saida.append(raw)
                            continue
                        # CAS: a linha não pode ter mudado desde a leitura.
                        atual = hashlib.sha256(
                            path.read_bytes().decode("utf-8").split("\n")[numero - 1].strip().encode("utf-8")
                        ).hexdigest()
                        if atual != digest:
                            raise SystemExit(
                                f"CAS FALHOU em {shard}:{numero}: outra frente tocou este registro.")
                        registro["word_count"] = word_count(registro)
                        saida.append(json.dumps(registro, ensure_ascii=False, sort_keys=True))
                        paginas += 1
                        trocas += n
                        mudou_shard += n
                        tocados.append((registro.get("intent_id"), n))
                    if mudou_shard and not args.dry_run:
                        payload = "\n".join(saida) + ("\n" if fim_newline else "")
                        atomic_write(path, payload.encode("utf-8"))
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    print("páginas com citação corrigida : %d" % paginas)
    print("ocorrências corrigidas        : %d" % trocas)
    for intent, n in tocados[:12]:
        print("  %-52s %d" % (intent, n))
    if len(tocados) > 12:
        print("  ... e mais %d páginas" % (len(tocados) - 12))
    if args.dry_run:
        print("\n--dry-run: nada foi escrito.")
    elif paginas:
        print("\nReingerir o estoque e republicar para o espelho refletir a correção.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
