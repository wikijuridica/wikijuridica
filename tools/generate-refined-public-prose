#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-refined-public-prose [--repair-lines=N[,M...]] [--repair-thin-lines=N[,M...]] [--repair-release-blocker-lines=N[,M...]] [--repair-search-surface-duplicate-lines=N[,M...]] [--repair-external-dedupe-phrases] [--repair-external-dedupe-phrase-lines=N[,M...]] [--repair-repeated-phrase-lines=N[,M...]] [--repair-ptbr-release-lines=N[,M...]] [--repair-generic-evidence-lines=N[,M...]] [--repair-dynamic-corpus-lines=N[,M...]] [--repair-dynamic-origin-residual-lines=N[,M...]] [--repair-language-pattern-blockers] [--repair-search-surface-duplicates] [flags]

Runs cmd/generate-refined-public-prose through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

repair_release_blockers=0
for arg in "$@"; do
	case "$arg" in
	--repair-release-blockers)
		repair_release_blockers=1
		;;
	esac
done

stable_marker="$ROOT/.agents/runtime/refined-public-prose-release-blockers-stable.env"

sha_file() {
	if [ -f "$1" ]; then
		sha256sum "$1" | awk '{print $1}'
	else
		printf 'missing'
	fi
}

line_count_file() {
	if [ -f "$1" ]; then
		wc -l <"$1" | awk '{print $1}'
	else
		printf '0'
	fi
}

release_blocker_state_key() {
	{
		printf 'refined:%s\n' "$(sha_file "$ROOT/data/editorial/refined_public_prose.jsonl")"
		printf 'patterns:%s\n' "$(sha_file "$ROOT/data/editorial/public_prose_language_patterns.jsonl")"
		printf 'wrapper:%s\n' "$(sha_file "$ROOT/tools/generate-refined-public-prose")"
		printf 'cmd:%s\n' "$(sha_file "$ROOT/cmd/generate-refined-public-prose/main.go")"
		printf 'engine:%s\n' "$(sha_file "$ROOT/internal/refinedpublicprose/refined.go")"
		printf 'pattern_analyzer:%s\n' "$(sha_file "$ROOT/internal/publicproselanguagepatterns/patterns.go")"
	} | sha256sum | awk '{print $1}'
}

write_release_blocker_stable_marker() {
	marker_reason="$1"
	mkdir -p "$(dirname "$stable_marker")"
	tmp_marker="$(mktemp "${stable_marker}.XXXXXX")"
	{
		printf 'state_key=%s\n' "$(release_blocker_state_key)"
		printf 'checked_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		printf 'command=generate-refined-public-prose --repair-release-blockers\n'
		printf 'reason=%s\n' "$marker_reason"
		printf 'publication=false\n'
		printf 'index_policy=noindex\n'
	} >"$tmp_marker"
	mv "$tmp_marker" "$stable_marker"
}

release_blocker_patterns_fresh_and_clean() {
	patterns_path="$ROOT/data/editorial/public_prose_language_patterns.jsonl"
	[ -s "$patterns_path" ] || return 1
	command -v jq >/dev/null 2>&1 || return 1
	current_refined_sha="$(sha_file "$ROOT/data/editorial/refined_public_prose.jsonl")"
	current_refined_records="$(line_count_file "$ROOT/data/editorial/refined_public_prose.jsonl")"
	jq -s -e --arg refined_sha "$current_refined_sha" --argjson refined_records "$current_refined_records" '
    length > 0 and
    length == $refined_records and
    all(.[]; .source_refined_public_prose_file_sha256 == $refined_sha) and
    all(.[]; .release_blocker == false) and
    all(.[]; (.quality_issue_count // 0) == 0) and
    all(.[]; ((.required_fixes // []) | length) == 0) and
    all(.[]; .publication_allowed == false and .render_allowed == false and .sitemap_allowed == false and (.public_path // "") == "" and .index_policy == "noindex")
  ' "$patterns_path" >/dev/null
}

export WIKI_GO_CMD_TIMEOUT_SECONDS="${WIKI_GO_CMD_TIMEOUT_SECONDS:-1800}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:refined-public-prose:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=223}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/editorial/refined_public_prose.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-refined-public-prose}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/editorial/refined_public_prose.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-1800}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"

if [[ "$repair_release_blockers" = "1" ]]; then
	current_state_key="$(release_blocker_state_key)"
	marker_state_key=""
	if [[ -f "$stable_marker" ]]; then
		marker_state_key="$(sed -n 's/^state_key=//p' "$stable_marker" | sed -n '1p')"
	fi
	if [[ "$current_state_key" != "" && "$current_state_key" = "$marker_state_key" ]] && release_blocker_patterns_fresh_and_clean; then
		echo "generate-refined-public-prose: repair_release_blockers=stable state_key=$current_state_key publication=false index_policy=noindex"
		exit 0
	fi
fi

if [[ "$repair_release_blockers" = "1" ]]; then
	set +e
	run-heavy-throttled run-go-cmd-cached ./cmd/generate-refined-public-prose --timings "$@"
	status=$?
	set -e

	if [[ "$status" = "0" ]]; then
		write_release_blocker_stable_marker "repair_completed"
	fi

	exit "$status"
fi

exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-refined-public-prose --timings "$@"
