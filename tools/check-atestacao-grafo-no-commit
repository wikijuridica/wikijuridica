#!/usr/bin/env bash
# check-atestacao-grafo-no-commit — quem mexe no grafo do validador reatesta
# NO MESMO COMMIT.
#
# POR QUE EXISTE, medido em 2026-08-29. `internal/v2ingest` guarda numa
# constante Go o sha256 do grafo de fonte do validador, e `ingest-v2-stock`
# RECUSA publicar quando a constante nao bate. `tools/check-validator-attestation`
# ja antecipa essa cobranca — mas ele so era invocado DENTRO do `deploy-publico`,
# no passo 0a. Resultado: o defeito nascia no commit e so aparecia no deploy, que
# morria antes de comecar. Aconteceu cinco vezes (eedb3edf, 896d83ae, 612b687c,
# 63ed4b2d e o deploy das 21:34 de 2026-08-29), e dez commits tocaram
# internal/v2ingest so hoje, dos quais SEIS eram unicamente re-atestacao.
#
# A ARMADILHA QUE FAZ ISSO REINCIDIR e que o grafo NAO e o diretorio
# `internal/v2ingest`: e a CLOSURE TRANSITIVA de import a partir de
# `internal/v2ingest` e `cmd/ingest-v2-stock` — 96 pacotes do modulo. O deploy
# das 21:34 morreu porque um commit tocou `internal/structureddata`,
# `internal/legalfacts` e `internal/legalcorpusindex`, que ninguem associa ao
# ingest e estao todos no grafo. Uma regra escrita por prefixo de diretorio
# ("tocou internal/v2ingest/") NAO teria pego nenhum dos tres.
#
# POR QUE ESTE GATE NAO RECALCULA O HASH. `check-validator-attestation` compara
# o hash do DISCO, e o disco de um commit parcial (`git commit -- <pathspec>`,
# que este repositorio manda usar) tem trabalho de outras frentes. Reprovar o
# meu commit por arquivo alheio ainda nao commitado seria falso positivo caro, e
# falso positivo em massa e a familia de defeito que mais custou nesta casa. Este
# gate le SO o indice do commit e cobra a disciplina que de fato falhou: se o
# commit muda um arquivo Go de producao que esta no grafo, o atestado gerado
# entra no mesmo commit.
#
# Custo: ZERO quando o commit nao tem Go de producao, ZERO quando o atestado ja
# esta no commit, e ~2,2 s (`go list -deps`) so no caso restante — que e
# exatamente o caso de risco.
#
# Uso:
#   ./tools/check-atestacao-grafo-no-commit
#   WIKI_ATESTACAO_ARQUIVOS_DO_COMMIT=<arquivo com um caminho por linha> ...
#     (para o selftest provar o detector sem tocar o indice do repositorio)
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

ATESTADO=internal/v2ingest/validator_fingerprint_attestation_generated.go

if [[ -n ${WIKI_ATESTACAO_ARQUIVOS_DO_COMMIT:-} ]]; then
	if [[ ! -f $WIKI_ATESTACAO_ARQUIVOS_DO_COMMIT ]]; then
		echo "REPROVADO: WIKI_ATESTACAO_ARQUIVOS_DO_COMMIT aponta para arquivo inexistente" >&2
		exit 1
	fi
	mapfile -t ARQUIVOS <"$WIKI_ATESTACAO_ARQUIVOS_DO_COMMIT"
else
	# Deliberadamente com o ambiente git herdado: sob o pre-commit, GIT_INDEX_FILE
	# aponta para o indice DESTE commit, e e justamente ele que queremos ler.
	if ! mapfile -t ARQUIVOS < <(git diff --cached --name-only --diff-filter=ACMR); then
		echo "REPROVADO: nao foi possivel ler o indice do commit" >&2
		exit 1
	fi
fi

# 1. O atestado ja esta no commit? Disciplina cumprida, custo zero.
for arquivo in "${ARQUIVOS[@]}"; do
	[[ $arquivo == "$ATESTADO" ]] && {
		echo "OK: o atestado do grafo entra neste commit"
		exit 0
	}
done

# 2. O commit tem Go de producao ou mexe no modulo? Teste nao entra no grafo
#    (validator_fingerprint_graph.go:669 descarta *_test.go).
CANDIDATOS=()
for arquivo in "${ARQUIVOS[@]}"; do
	case "$arquivo" in
	go.mod | go.sum) CANDIDATOS+=("$arquivo") ;;
	*_test.go) ;;
	*.go) CANDIDATOS+=("$arquivo") ;;
	esac
done
if [[ ${#CANDIDATOS[@]} -eq 0 ]]; then
	echo "OK: o commit nao toca Go de producao nem o modulo"
	exit 0
fi

# 3. Quais diretorios estao no grafo? So aqui se paga o `go list`.
if ! DEPS=$(./tools/go-modern list -deps ./internal/v2ingest ./cmd/ingest-v2-stock 2>&1); then
	echo "REPROVADO: nao foi possivel listar o grafo do validador" >&2
	echo "$DEPS" | tail -5 >&2
	exit 1
fi
DIRS_DO_GRAFO=$(printf '%s\n' "$DEPS" | sed -n 's|^portaljuridico/||p')

NO_GRAFO=()
for arquivo in "${CANDIDATOS[@]}"; do
	case "$arquivo" in
	go.mod | go.sum)
		NO_GRAFO+=("$arquivo")
		continue
		;;
	esac
	dir=$(dirname "$arquivo")
	if printf '%s\n' "$DIRS_DO_GRAFO" | grep -qxF "$dir"; then
		NO_GRAFO+=("$arquivo")
	fi
done

if [[ ${#NO_GRAFO[@]} -eq 0 ]]; then
	echo "OK: nenhum dos ${#CANDIDATOS[@]} arquivo(s) Go do commit esta no grafo do validador"
	exit 0
fi

# ★ FALSO POSITIVO QUE ESTE BLOCO FECHA, apanhado no primeiro caso real
# (2026-08-30). O commit toca o grafo, mas o atestado JA descreve o grafo atual —
# porque a reatestacao entrou num commit anterior desta mesma sessao, quando as
# mudancas ja estavam no disco. Nessa situacao `git commit -- <pathspec>` NAO
# inclui o arquivo do atestado, simplesmente porque ele nao tem diferenca a
# commitar, e exigi-lo tornaria o gate impossivel de satisfazer: a fatia 3 de uma
# integracao em tres fatias reprovava sem que nada estivesse errado.
#
# A pergunta certa nao e "o atestado esta neste commit?", e sim "este commit
# DEIXA o atestado stale?". `check-validator-attestation` responde exatamente
# isso contra o disco, custa ~4 s, e so e pago neste ramo — que e o unico de
# risco. Verde ali significa que o grafo esta atestado, e o commit nao introduz
# divergencia nenhuma.
if [[ -x ./tools/check-validator-attestation ]] && ./tools/check-validator-attestation >/dev/null 2>&1; then
	echo "OK: ${#NO_GRAFO[@]} arquivo(s) do commit estao no grafo, e o atestado ja o descreve"
	exit 0
fi

{
	echo "REPROVADO: ${#NO_GRAFO[@]} arquivo(s) deste commit estao no grafo de fonte do validador,"
	echo "           e o atestado (${ATESTADO}) nao entra junto."
	for arquivo in "${NO_GRAFO[@]}"; do
		echo "             $arquivo"
	done
	echo
	echo "  Sem reatestar, ingest-v2-stock recusa publicar e NENHUM deploy passa —"
	echo "  o acervo fica preso na versao anterior ate alguem descobrir por que."
	echo
	echo "  Remedio, duas linhas:"
	echo "      ./tools/go-modern generate ./internal/v2ingest"
	echo "      git add $ATESTADO"
	echo "  e inclua o caminho no pathspec do proprio commit."
} >&2
exit 1
