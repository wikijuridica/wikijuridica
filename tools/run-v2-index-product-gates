	# pre-extracted .toolchains directory is never a build input.
	"$PYTHON_BIN" -I - "$GO_ARCHIVE" "$GOROOT_PARENT" "$GO_ARCHIVE_SHA256" <<'PY'
import hashlib
import io
import os
import pathlib
import stat
import sys
import tarfile

archive = pathlib.Path(sys.argv[1])
destination_root = pathlib.Path(sys.argv[2])
expected = sys.argv[3]
try:
    if archive.resolve(strict=True) != archive:
        raise RuntimeError("archive path is not canonical")
    descriptor = os.open(
        archive, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        before = os.fstat(descriptor)
        if (not stat.S_ISREG(before.st_mode) or
                before.st_uid != os.geteuid() or before.st_nlink != 1 or
                stat.S_IMODE(before.st_mode) & 0o022 or
                before.st_size <= 0 or
                before.st_size > 128 * 1024 * 1024):
            raise RuntimeError("archive metadata is unsafe")
        chunks = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise RuntimeError("archive truncated")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise RuntimeError("archive grew")
        after = os.fstat(descriptor)
        before_identity = (
            before.st_dev, before.st_ino, before.st_size,
            before.st_mtime_ns, before.st_ctime_ns)
        after_identity = (
            after.st_dev, after.st_ino, after.st_size,
            after.st_mtime_ns, after.st_ctime_ns)
        if before_identity != after_identity:
            raise RuntimeError("archive changed during read")
    finally:
        os.close(descriptor)
    payload = b"".join(chunks)
    if hashlib.sha256(payload).hexdigest() != expected:
        raise RuntimeError("archive SHA256 mismatch")
    seen = set()
    total = 0
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as bundle:
        members = bundle.getmembers()
        if not members or len(members) > 30000:
            raise RuntimeError("archive inventory is invalid")
        for member in members:
            pure = pathlib.PurePosixPath(member.name)
            canonical = pure.as_posix()
            if (not canonical or canonical in seen or
                    pure.parts[0] != "go" or
                    any(part in {"", ".", ".."} for part in pure.parts) or
                    member.name.startswith("/") or
                    not (member.isdir() or member.isfile()) or
                    member.size < 0 or member.size > 512 * 1024 * 1024):
                raise RuntimeError("unsafe archive member: " + member.name)
            seen.add(canonical)
            total += member.size
            if total > 2 * 1024 * 1024 * 1024:
                raise RuntimeError("archive expanded size exceeds limit")
            target = destination_root.joinpath(*pure.parts)
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True, mode=0o700)
                if target.is_symlink() or not target.is_dir():
                    raise RuntimeError("archive directory is unsafe")
                continue
            target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            source = bundle.extractfile(member)
            if source is None:
                raise RuntimeError("archive member cannot be read")
            content = source.read(member.size + 1)
            if len(content) != member.size:
                raise RuntimeError("archive member size mismatch")
            mode = 0o500 if member.mode & 0o111 else 0o400
            output = os.open(
                target,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                os.O_CLOEXEC | os.O_NOFOLLOW,
                mode,
            )
            try:
                view = memoryview(content)
                while view:
                    written = os.write(output, view)
                    if written < 1:
                        raise RuntimeError("archive extraction stalled")
                    view = view[written:]
            finally:
                os.close(output)
    goroot = destination_root / "go"
    if (goroot / "VERSION").read_bytes().splitlines()[:1] != [b"go1.26.5"]:
        raise RuntimeError("toolchain VERSION mismatch")
    go_binary = goroot / "bin" / "go"
    go_info = os.lstat(go_binary)
    if (not stat.S_ISREG(go_info.st_mode) or
            not go_info.st_mode & stat.S_IXUSR):
        raise RuntimeError("toolchain go binary is invalid")
except (OSError, EOFError, tarfile.TarError, RuntimeError) as error:
    print(
        "v2-index-product-gates: toolchain oficial inseguro: " + str(error),
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
	GOROOT="$GOROOT_PARENT/go"
	GO_BIN="$GOROOT/bin/go"

	MODULE_PROXY_CANON="$(CDPATH='' cd -- "$MODULE_PROXY" 2>/dev/null && pwd -P)" || {
		echo "v2-index-product-gates: proxy local de módulos ausente" >&2
		exit 1
	}
	# CAMINHO CANÔNICO, e não "caminho sem symlink" (corrigido em 2026-09-09).
	#
	# A exigência original era que `pwd -P` devolvesse exatamente a string
	# configurada e que o último componente não fosse symlink. Em 2026-09-08 o
	# cache de módulos do host passou a viver fora de $HOME —
	# /home/rafael/go/pkg/mod é um symlink para /storage/cache/gomod — e a
	# guarda passou a recusar TODO commit de página v2 com "proxy local de
	# módulos não canônico". Bloqueio total do estoque editorial por uma
	# mudança de layout de disco, sem defeito de segurança nenhum:
	# `tools/test_pre_commit_product_gates.py` reprovou em 3 casos por isso.
	#
	# O que a guarda protege continua protegido, e agora de forma mais forte:
	# passamos a USAR o caminho já resolvido (`MODULE_PROXY_CANON`) em vez da
	# string configurada, de modo que nenhuma etapa posterior possa ser
	# redirecionada trocando um symlink no meio do caminho, e exigimos que o
	# alvo real seja do próprio usuário e não gravável por grupo/outros — que é
	# a checagem de modo logo abaixo, agora aplicada ao destino verdadeiro.
	MODULE_PROXY="$MODULE_PROXY_CANON"
	MODULE_PROXY_OWNER="$($STAT_BIN -c %U "$MODULE_PROXY")"
	[ "$MODULE_PROXY_OWNER" = "$(id -un)" ] || [ "$MODULE_PROXY_OWNER" = "root" ] || {
		echo "v2-index-product-gates: proxy local de módulos de outro dono: $MODULE_PROXY_OWNER" >&2
		exit 1
	}
	MODULE_PROXY_MODE="$($STAT_BIN -c %a "$MODULE_PROXY")"
	[ $((0$MODULE_PROXY_MODE & 0022)) -eq 0 ] || {
		echo "v2-index-product-gates: proxy local de módulos gravável por terceiros" >&2
		exit 1
	}

	# A committed go.mod is part of the authenticated source closure, but a local
	# `replace` may point outside that closure (including an absolute path back into
	# the concurrently mutable worktree).  Parse with the authenticated Go tool,
	# then reject every filesystem replacement before compiling any gate package.
	GO_MOD_JSON="$WORK/go-mod.json"
	(
		cd "$SOURCE"
		"$ENV_BIN" -i \
			PATH="$GOROOT/bin:/usr/bin:/bin" HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent \
			LC_ALL=C LANG=C TMPDIR="$GO_PRIVATE_TMP" GOENV=off GOTOOLCHAIN=local \
			GOWORK=off GOROOT="$GOROOT" GOPATH="$GO_PRIVATE_PATH" \
			GOMODCACHE="$GO_PRIVATE_MODCACHE" GOCACHE="$GO_PRIVATE_BUILDCACHE" \
			"$GO_BIN" mod edit -json >"$GO_MOD_JSON"
	)
	[ "$($STAT_BIN -c %s "$GO_MOD_JSON")" -le $((16 * 1024 * 1024)) ] || {
		echo "v2-index-product-gates: go.mod autenticado excede representação segura" >&2
		exit 1
	}
	"$PYTHON_BIN" -I - "$GO_MOD_JSON" <<'PY'
import json
import pathlib
import sys

try:
    document = json.loads(pathlib.Path(sys.argv[1]).read_bytes())
    replacements = document.get("Replace") or []
    if not isinstance(replacements, list):
        raise RuntimeError("Replace não é lista")
    for replacement in replacements:
        if not isinstance(replacement, dict):
            raise RuntimeError("replace inválido")
        target = replacement.get("New")
        if not isinstance(target, dict):
            raise RuntimeError("destino de replace inválido")
        path = target.get("Path")
        version = target.get("Version")
        if not isinstance(path, str) or not path:
            raise RuntimeError("path de replace inválido")
        if version in (None, ""):
            raise RuntimeError(
                "replace local foge da closure imutável: " + path)
        if not isinstance(version, str):
            raise RuntimeError("versão de replace inválida")
except (OSError, UnicodeDecodeError, json.JSONDecodeError, RuntimeError) as error:
    print(
        "v2-index-product-gates: go.mod inseguro: " + str(error),
        file=sys.stderr,
    )
    raise SystemExit(1)
PY

