#!/usr/bin/env python3
"""retirar-pagina-do-ar — o freio que a publicacao diaria exige.

POR QUE ISTO PRECISA EXISTIR ANTES DA PRIMEIRA ONDA AUTOMATICA.

A partir de 2026-08-20 o portal publica sozinho, todo dia as 04:20, sem ninguem
olhando. Uma pagina com citacao legal errada, com dado pessoal que escapou do
anonimizador ou com afirmacao que o corpo nao sustenta precisa sair do ar HOJE
-- e ate agora nao havia caminho para isso. Publicar sem via de retirada e
publicar sem freio.

A MAQUINARIA EXISTENTE NAO RESOLVE. internal/v2semanticrecut faz RECORTE
SEMANTICO: troca o conteudo de uma pagina por outro, dentro de uma transacao
propria. Nao e retirada. E a remocao de orfaos do publicador cobre apenas
SHARDS DE SITEMAP -- o HTML de uma pagina que sai do manifesto CONTINUA em
public/, servido pelo nginx direto do disco. Retirada que nao retira.

O QUE ESTA FERRAMENTA FAZ, e a ordem importa:

  1. PRESERVA o registro inteiro, com o texto, em
     .agents/runtime/paginas-retiradas/<data>/. Isto vem PRIMEIRO e nao e
     opcional: o contrato deste repositorio proibe descartar pagina redigida, e
     retirar do ar nao e descartar -- e tirar de circulacao preservando o texto.
  2. converte o registro do estoque em TOMBSTONE (skipped=true + skip_reason),
     que e a forma que o censo ja entende: ele deixa de aprovar a pagina, e ela
     sai do manifesto e do sitemap na proxima transacao.
  3. REMOVE o HTML de public/, porque a transacao nao o faz. Sem este passo a
     URL continua respondendo 200 com o conteudo defeituoso.
  4. imprime os dois comandos que fecham a retirada: publicar (para o manifesto
     e o sitemap convergirem) e purgar a borda (senao a Cloudflare serve a
     versao antiga pelo Edge TTL de sete dias -- retirar do disco NAO retira do
     ar enquanto a borda tiver copia).

O QUE ELA NAO FAZ: nao decide. Quem decide que a pagina sai e quem leu o
defeito. O motivo entra por --motivo e vai para o skip_reason, para o registro
dizer POR QUE, e nao apenas QUE.

Uso:
    tools/retirar-pagina-do-ar --intent <id> --motivo "<texto>" --dry-run
    tools/retirar-pagina-do-ar --intent <id> --motivo "<texto>"
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
import tempfile
from datetime import date
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
SHARDS = RAIZ / "data/editorial/v2_pages"
PUBLIC = RAIZ / "public"
MANIFESTO = RAIZ / "data/editorial/published_manifest.jsonl"
PRESERVACAO = RAIZ / ".agents/runtime/paginas-retiradas"
LEDGER = RAIZ / "data/ops/paginas_retiradas.jsonl"


def rota_publicada(intent: str) -> str | None:
    if not MANIFESTO.exists():
        return None
    for linha in MANIFESTO.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if registro.get("unique_intent_id") == intent:
            return registro.get("path")
    return None


def escreve_atomico(caminho: Path, texto: str) -> None:
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=caminho.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write(texto)
        temporario.flush()
        os.fsync(temporario.fileno())
        provisorio = temporario.name
    os.replace(provisorio, caminho)


def _casa_intent(html: Path, intent: str) -> bool:
    """A rota de um HTML órfão casa com o intent pedido?

    O casamento é por SUFIXO do slug, não por igualdade: o intent
    `dia-ms-20260819` corresponde à rota `/diarios/ms-20260819/`, porque o
    prefixo do intent é da família e o diretório é da área. Comparar strings
    inteiras não acharia nada, e comparar frouxo demais acharia várias — por
    isso o chamador recusa quando há mais de um candidato, em vez de escolher.
    """
    slug = html.parent.name
    if not slug:
        return False
    if slug == intent:
        return True
    # FRONTEIRA DE HÍFEN, e ela não é preciosismo. O `endswith` cru casou
    # `dia-ms-20260819` com o slug `9` de `/glossario/pagina/9/` — e mais dez
    # rotas de paginação —, porque a string termina em "9". A guarda de
    # ambiguidade barrou os 11 candidatos antes de qualquer remoção, mas um
    # matcher que precisa da guarda para não apagar o arquivo errado é matcher
    # defeituoso. O sufixo só vale se for um componente inteiro do intent.
    return intent.endswith("-" + slug)


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--intent", required=True, help="intent_id da página")
    analisador.add_argument("--motivo", required=True,
                            help="por que ela sai do ar; vai para o skip_reason")
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    intent = argumentos.intent.strip()
    motivo = " ".join(argumentos.motivo.split())
    if len(motivo) < 12:
        print("o motivo precisa dizer POR QUE, não apenas QUE — mínimo 12 caracteres",
              file=sys.stderr)
        return 2

    # Localiza o registro no estoque.
    alvo_shard, alvo_registro, alvo_linha = None, None, -1
    for arquivo in sorted(SHARDS.glob("*.jsonl")):
        linhas = arquivo.read_text(encoding="utf-8").splitlines()
        for indice, linha in enumerate(linhas):
            if not linha.strip():
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            if registro.get("intent_id") == intent:
                alvo_shard, alvo_registro, alvo_linha = arquivo, registro, indice
                break
        if alvo_shard:
            break

    if alvo_registro is None:
        # ÓRFÃ DE public/ — o caso que esta ferramenta descrevia e não cobria.
        #
        # O docstring acima diz, corretamente, que "o HTML de uma página que sai
        # do manifesto CONTINUA em public/". Existe uma classe pior: HTML que
        # NUNCA teve registro — publicado por uma geração antiga e sobrevivente
        # a filtros que vieram depois.
        #
        # Medido em 2026-08-26: `/diarios/ms-20260819/` servia 200 com 24.072
        # bytes e `<meta name="robots" content="index,follow,max-snippet:-1">`,
        # FORA do sitemap e FORA do manifesto. Das 10.298 rotas com index.html,
        # 4 estavam nessa situação e 3 eram `noindex` legítimo — essa era a
        # única indexável. E o gerador de diários a REJEITA por mérito: ela tem
        # "corpo 71% igual ao de dia-se-20260819", quase-duplicata. Ou seja: ela
        # não pode ganhar registro, porque o gate de anti-duplicidade está certo
        # ao recusá-la. A única saída correta é sair do ar.
        #
        # Sem este caminho, a ferramenta respondia "não está no estoque v2" e
        # devolvia o problema a quem perguntou — deixando no ar uma página
        # indexável que viola a coerência de artefato que o CLAUDE.md chama de
        # INEGOCIÁVEL.
        #
        # A preservação continua vindo primeiro: o HTML é o único texto que
        # existe (não há registro para copiar), então é ele que se guarda.
        rota_orfa = f"/{intent}/" if intent.startswith("/") is False else intent
        candidatos = [p for p in PUBLIC.rglob("index.html")
                      if p.parent.name and _casa_intent(p, intent)]
        if not candidatos:
            print(f"intent {intent!r} não está no estoque v2 nem tem HTML órfão em public/",
                  file=sys.stderr)
            print("  (se a página existe com outra rota, passe o intent que o HTML declara)",
                  file=sys.stderr)
            return 1
        if len(candidatos) > 1:
            print(f"intent {intent!r}: {len(candidatos)} HTMLs casam — ambíguo, não vou adivinhar:",
                  file=sys.stderr)
            for c in candidatos[:5]:
                print(f"      {c.relative_to(RAIZ)}", file=sys.stderr)
            return 1
        html_orfao = candidatos[0]
        rota_orfa = "/" + str(html_orfao.parent.relative_to(PUBLIC)) + "/"
        print(f"intent    : {intent}  (ÓRFÃO — sem registro em estoque nenhum)")
        print(f"rota      : {rota_orfa}")
        print(f"HTML      : {html_orfao.relative_to(RAIZ)} ({html_orfao.stat().st_size} bytes)")
        print(f"motivo    : {motivo}")
        if argumentos.dry_run:
            print("\n--dry-run: nada alterado")
            return 0
        destino = RAIZ / ".agents/runtime/paginas-retiradas" / date.today().isoformat()
        destino.mkdir(parents=True, exist_ok=True)
        preservado = destino / f"{intent}.orfa.html"
        shutil.copy2(html_orfao, preservado)
        registro_orfao = destino / f"{intent}.orfa.json"
        registro_orfao.write_text(json.dumps({
            "intent_id": intent, "rota": rota_orfa, "motivo": motivo,
            "retirada_em": date.today().isoformat(),
            "classe": "orfa_de_public_sem_registro",
            "html_preservado": str(preservado.relative_to(RAIZ)),
            "bytes": html_orfao.stat().st_size,
        }, ensure_ascii=False, indent=1), encoding="utf-8")
        html_orfao.unlink()
        try:
            html_orfao.parent.rmdir()
        except OSError:
            pass  # diretório com outros arquivos permanece, e está certo
        print(f"\nPRESERVADO: {preservado.relative_to(RAIZ)}")
        print(f"REGISTRO  : {registro_orfao.relative_to(RAIZ)}")
        print(f"REMOVIDO  : {html_orfao.relative_to(RAIZ)}")
        print("\nÓrfã não estava no manifesto nem no sitemap, então NÃO há transação a rodar.")
        print("Purgue a borda se a rota já tiver sido cacheada:")
        print(f"  tools/purge-edge-cache --url https://wikijuridica.com.br{rota_orfa}")
        return 0
    if alvo_registro.get("skipped") is True:
        print(f"{intent} já é tombstone: skip_reason={alvo_registro.get('skip_reason')!r}")
        return 0

    rota = rota_publicada(intent)
    html = PUBLIC / rota.strip("/") / "index.html" if rota else None
    palavras = alvo_registro.get("word_count", 0)

    print(f"intent    : {intent}")
    print(f"shard     : {alvo_shard.relative_to(RAIZ)}")
    print(f"rota      : {rota or '(não está no manifesto)'}")
    print(f"HTML      : {'existe' if html and html.exists() else 'ausente'}")
    print(f"palavras  : {palavras}")
    print(f"motivo    : {motivo}")

    if argumentos.dry_run:
        print("\n--dry-run: nada alterado")
        return 0

    hoje = date.today().isoformat()

    # 1. PRESERVAR ANTES DE TUDO. Texto redigido não se perde numa retirada.
    destino = PRESERVACAO / hoje
    destino.mkdir(parents=True, exist_ok=True)
    preservado = destino / f"{intent}.json"
    preservado.write_text(json.dumps(alvo_registro, ensure_ascii=False, indent=1) + "\n",
                          encoding="utf-8")
    if html and html.exists():
        shutil.copy2(html, destino / f"{intent}.html")
    print(f"\n1. preservado em {preservado.relative_to(RAIZ)}")

    # 2. Converter em tombstone: o censo deixa de aprovar, e a página sai do
    #    manifesto e do sitemap na próxima transação.
    linhas = alvo_shard.read_text(encoding="utf-8").splitlines()
    tombstone = {
        "intent_id": intent,
        "skipped": True,
        "skip_reason": f"retirada_do_ar_{hoje}: {motivo}",
        "retirada_em": hoje,
        "texto_preservado_em": str(preservado.relative_to(RAIZ)),
        "palavras_no_momento_da_retirada": palavras,
    }
    linhas[alvo_linha] = json.dumps(tombstone, ensure_ascii=False)
    escreve_atomico(alvo_shard, "\n".join(l for l in linhas if l.strip()) + "\n")
    print(f"2. tombstone gravado em {alvo_shard.relative_to(RAIZ)}")

    # 3. Remover o HTML: a transação NÃO faz isso, e sem este passo a URL
    #    continua respondendo 200 com o conteúdo defeituoso.
    if html and html.exists():
        html.unlink()
        try:
            html.parent.rmdir()
        except OSError:
            pass  # diretório com outros arquivos: deixa como está
        print(f"3. HTML removido de {html.relative_to(RAIZ)}")
    else:
        print("3. sem HTML a remover")

    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as saida:
        saida.write(json.dumps({
            "data": hoje, "intent_id": intent, "rota": rota, "motivo": motivo,
            "palavras": palavras, "texto_preservado_em": str(preservado.relative_to(RAIZ)),
        }, ensure_ascii=False) + "\n")
    print(f"4. registrado em {LEDGER.relative_to(RAIZ)}")

    print("\nFALTA FECHAR A RETIRADA — dois comandos, nesta ordem:")
    print("  nice -n 19 python3 tools/generate-v2-publication-severity --write")
    print("  ./tools/go-modern run ./cmd/publish-v2-direct \\")
    print("      -published-at <hoje> -reviewed-at <hoje> -allow-public-write")
    if rota:
        print(f"  ./tools/purge-edge-cache --url {rota}")
        print("\n  A purga NÃO é opcional: enquanto a Cloudflare tiver cópia, ela serve")
        print("  o conteúdo retirado pelo Edge TTL inteiro. Tirar do disco não tira do ar.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
