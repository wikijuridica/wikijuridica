#!/usr/bin/env python3
"""check-anchor-claim-publication — o registro derivado bate com a regra e com o dado?

READ-ONLY. Confere `data/editorial/anchor_claim_publication.jsonl`, que decide o
que a proveniência de cada página publica, contra as três coisas que ele afirma:

  1. A REGRA DE FORMA. Toda afirmação publicada tem de passar nas mesmas
     condições que `internal/content.AnchorClaimAdmissible` aplica em Go —
     4 a 45 palavras, sem data ISO, sem abrir por traço de transcrição. A regra
     vive nas duas linguagens porque as duas pontas rodam separadas; esta
     ferramenta é o que impede as duas de divergirem em silêncio.
  2. O DADO DE ORIGEM. Toda afirmação publicada tem de existir, verbatim, em
     `data/editorial/v2_pages` para aquela mesma fonte daquela mesma página. O
     registro derivado não pode inventar frase nem migrar frase entre páginas.
  3. A UNICIDADE. Nenhuma afirmação publicada pode aparecer em duas páginas —
     é a barreira anti-molde, e ela é o motivo de o registro existir.

E confere a coerência estrutural: rota do registro existe em `content/pages.json`,
e `content_sha256` bate com o `html_sha256` do `published_manifest`.

Sai 1 quando encontra divergência. Não corrige nada.

Uso:
    tools/check-anchor-claim-publication
"""
from __future__ import annotations

import collections
import datetime
import glob
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRO = ROOT / "data/editorial/anchor_claim_publication.jsonl"
ESTOQUE = ROOT / "data/editorial/v2_pages"
PAGES_JSON = ROOT / "content/pages.json"
MANIFESTO = ROOT / "data/editorial/published_manifest.jsonl"

MIN_PALAVRAS = 4
MAX_PALAVRAS = 45
DATA_ISO = re.compile(r"\d{4}-\d{2}-\d{2}")
TRACOS = ("-", "–", "—")


def recusa_por_forma(claim: str) -> str:
    texto = claim.strip()
    if not texto:
        return "vazio"
    if texto[0] in TRACOS:
        return "abre_com_traco_de_transcricao"
    if DATA_ISO.search(texto):
        return "data_iso_no_texto_visivel"
    palavras = len(texto.split())
    if palavras < MIN_PALAVRAS:
        return "fragmento_truncado"
    if palavras > MAX_PALAVRAS:
        return "longo_demais_para_atribuicao"
    return ""


def main() -> int:
    if not REGISTRO.is_file():
        # Ausência não é defeito: sem o registro, o acervo serve como servia
        # antes de 2026-08-26. É o degrade que internal/content documenta.
        print(f"{REGISTRO.relative_to(ROOT)} ausente — nada a conferir (degrade previsto)")
        return 0

    with open(PAGES_JSON, encoding="utf-8") as handle:
        paginas = {p["path"]: p for p in json.load(handle) if p.get("path")}

    manifesto = {}
    with open(MANIFESTO, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            if registro.get("path") and registro.get("html_sha256"):
                manifesto[registro["path"]] = registro["html_sha256"]

    # (intent-less) rota + url -> claim de origem, lido do estoque via pages.json
    origem: dict[tuple[str, str], str] = {}
    por_intent: dict[str, list[dict]] = {}
    for caminho in sorted(glob.glob(str(ESTOQUE / "*.jsonl"))):
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                registro = json.loads(linha)
                if registro.get("skipped") or not registro.get("intent_id"):
                    continue
                por_intent[registro["intent_id"]] = registro.get("official_sources") or []
    for rota, pagina in paginas.items():
        fontes = por_intent.get(pagina.get("unique_intent_id") or "")
        if not fontes:
            continue
        for fonte in fontes:
            url = (fonte.get("url") or "").strip()
            if url:
                origem[(rota, url)] = (fonte.get("anchor_claim") or "").strip()

    falhas: list[str] = []
    # A divergencia de `content_sha256` e UM fato sobre o registro inteiro, nao
    # 10 mil defeitos independentes: quando o acervo e republicado, TODA rota
    # passa a divergir de uma vez. Misturada em `falhas`, ela ocupava as 40
    # linhas exibidas e escondia por completo o que este check existe para
    # achar -- afirmacao fora da regra de forma, afirmacao que o estoque nao
    # tem, afirmacao migrada entre paginas. Medido em 2026-08-29: 10.070 de
    # 10.070 rotas divergindo, e nenhuma das verificacoes substantivas visivel.
    # Separar as duas listas NAO afrouxa nada: a divergencia continua reprovando
    # e continua nomeada, agora com o produtor que a regenera.
    falhas_versao: list[str] = []
    publicadas = 0
    rotas = 0
    # A contagem é por ROTA DISTINTA, e não por ocorrência.
    #
    # A primeira versão contava ocorrências e acusou 81 "moldes" que não eram:
    # 84 páginas do acervo (0,83%) listam a MESMA URL de fonte duas ou três
    # vezes na própria proveniência — defeito de dado que já existe publicado —,
    # e a mesma frase aparecia N vezes na MESMA página. Molde é a frase repetida
    # entre páginas diferentes; repetição dentro de uma página é outro problema,
    # com outra correção, e confundir os dois faria este check reprovar para
    # sempre por um defeito que ele não mede.
    vistas: dict[str, set[str]] = collections.defaultdict(set)
    duplicadas_na_pagina = 0
    onde: dict[str, str] = {}

    with open(REGISTRO, encoding="utf-8") as handle:
        for numero, linha in enumerate(handle, 1):
            linha = linha.strip()
            if not linha:
                continue
            row = json.loads(linha)
            rota = row.get("path") or ""
            rotas += 1
            if rota not in paginas:
                falhas.append(f"linha {numero}: rota {rota} não existe em content/pages.json")
                continue
            sha = (row.get("content_sha256") or "").strip()
            if sha and manifesto.get(rota) and sha != manifesto[rota]:
                falhas_versao.append(rota)
            for fonte in row.get("sources") or []:
                claim = (fonte.get("anchor_claim") or "").strip()
                url = (fonte.get("url") or "").strip()
                if not claim:
                    continue
                publicadas += 1
                motivo = recusa_por_forma(claim)
                if motivo:
                    falhas.append(f"linha {numero}: {rota} publica afirmação que a regra recusa ({motivo})")
                esperado = origem.get((rota, url))
                if esperado is None:
                    falhas.append(f"linha {numero}: {rota} publica afirmação de fonte que o estoque não tem ({url})")
                elif esperado != claim:
                    falhas.append(f"linha {numero}: {rota} publica afirmação que não é a do estoque ({url})")
                if rota in vistas[claim]:
                    duplicadas_na_pagina += 1
                vistas[claim].add(rota)
                if claim not in onde:
                    onde[claim] = rota

    repetidas = [(c, len(r)) for c, r in vistas.items() if len(r) >= 2]
    for claim, n in repetidas[:10]:
        falhas.append(f"afirmação publicada em {n} páginas (molde), primeira em {onde[claim]}: {claim[:70]}")

    print("check-anchor-claim-publication — READ-ONLY\n")
    print(f"rotas no registro: {rotas}")
    print(f"afirmações publicadas: {publicadas}")
    print(f"afirmações distintas: {len(vistas)}")
    print(f"afirmações repetidas entre páginas: {len(repetidas)}")
    print(f"afirmações repetidas DENTRO da mesma página (URL de fonte duplicada "
          f"na proveniência, defeito de dado preexistente): {duplicadas_na_pagina}")
    if falhas_versao or falhas:
        print("\nREPROVADO:")
    if falhas_versao:
        gerado_em = datetime.date.fromtimestamp(REGISTRO.stat().st_mtime).isoformat()
        print(f"  - versão de conteúdo defasada: content_sha256 diverge do "
              f"published_manifest em {len(falhas_versao)} de {rotas} rota(s). "
              f"O registro foi gerado em {gerado_em} e o acervo foi republicado "
              f"depois. Regenerar com tools/generate-anchor-claim-publication-20260826.")
        for rota in falhas_versao[:5]:
            print(f"      exemplo: {rota}")
        if len(falhas_versao) > 5:
            print(f"      ... e mais {len(falhas_versao) - 5} rota(s)")
    if falhas:
        for falha in falhas[:40]:
            print("  - " + falha)
        if len(falhas) > 40:
            print(f"  ... e mais {len(falhas) - 40}")
    if falhas_versao or falhas:
        return 1
    print("\nOK: registro coerente com a regra, com o estoque e com o manifesto.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
