#!/usr/bin/env bash
# check-git-guard-regressao — prova que o guard de git destrutivo continua
# bloqueando o que destrói e liberando o que não destrói.
#
# ★ POR QUE ESTE GATE EXISTE (2026-08-29).
#
# O hook `~/.claude/hooks/git-guard.sh` é a guarda que impede um agente de
# rodar `git reset --hard`, `checkout --`, `clean -fd`, `stash` e a família
# inteira que descarta worktree. Ele é indispensável: o CLAUDE.md deste
# repositório proíbe reverter trabalho, e a proibição precisa de dente.
#
# Só que ele casa por SUBSTRING, e substring larga apanha inocente. Medido
# hoje: o padrão "git worktree remove" barrou a limpeza de uma worktree de
# medição criada pelo próprio agente — e barrou depois até o comando que ia
# MEDIR esse comportamento num repositório descartável em /tmp. Worktree
# isolada é a ferramenta sancionada para decidir se um vermelho é regressão ou
# pré-existente; um guard que deixa CRIAR e proíbe LIMPAR transforma cada
# medição em lixo permanente, e lixo acumulado é o que torna o `git status`
# ilegível — que foi a causa de duas varreduras acidentais de trabalho alheio.
#
# A correção foi liberar `git worktree remove` SEM --force, e a base é fonte
# primária, `git worktree --help`, verbatim: "Only clean worktrees (no
# untracked files and no modification in tracked files) can be removed.
# Unclean worktrees or ones with submodules can be removed with --force. The
# main worktree cannot be removed."
#
# É a mesma família do `wmctrl -c`, que casou por substring do título e fechou
# o terminal do dono. Por isso a lição não fica em prosa: fica aqui, executável.
#
# O gate é READ-ONLY: monta JSON de entrada, chama o hook e lê o exit code.
# Nenhum comando git é executado.
set -uo pipefail

HOOK="${WIKI_GIT_GUARD_HOOK:-$HOME/.claude/hooks/git-guard.sh}"

if [[ ! -f "$HOOK" ]]; then
	echo "git_guard_ausente hook=$HOOK — o guard de git destrutivo não está instalado" >&2
	exit 1
fi
if ! bash -n "$HOOK" 2>/dev/null; then
	echo "git_guard_sintaxe_invalida hook=$HOOK — bash -n reprovou; hook quebrado falha ABERTO" >&2
	exit 1
fi

FALHAS=0
TOTAL=0

# veredito <esperado:PASSA|BLOQUEIA> <comando>
veredito() {
	local esperado="$1" cmd="$2" json rc obtido
	TOTAL=$((TOTAL + 1))
	json="$(python3 -c 'import json,sys; print(json.dumps({"tool_name":"Bash","tool_input":{"command":sys.argv[1]}}))' "$cmd")"
	printf '%s' "$json" | bash "$HOOK" >/dev/null 2>&1
	rc=$?
	if [[ $rc -eq 0 ]]; then obtido="PASSA"; else obtido="BLOQUEIA"; fi
	if [[ "$obtido" != "$esperado" ]]; then
		printf 'git_guard_regressao esperado=%s obtido=%s comando=%q\n' "$esperado" "$obtido" "$cmd" >&2
		FALHAS=$((FALHAS + 1))
	fi
}

# --- o que DESTRÓI worktree e tem de continuar bloqueado -------------------
veredito BLOQUEIA 'git reset --hard origin/main'
veredito BLOQUEIA 'git reset --hard'
veredito BLOQUEIA 'git checkout -- .'
veredito BLOQUEIA 'git checkout .'
veredito BLOQUEIA 'git restore .'
veredito BLOQUEIA 'git revert HEAD'
veredito BLOQUEIA 'git clean -fd'
veredito BLOQUEIA 'git stash'
veredito BLOQUEIA 'git stash pop'
veredito BLOQUEIA 'git cherry-pick abc1234'
veredito BLOQUEIA 'git switch --force main'
veredito BLOQUEIA 'git switch --discard-changes main'
veredito BLOQUEIA 'git branch -D frente'
veredito BLOQUEIA 'git rm arquivo.go'

# --- auditoria de cobertura: os verbos que o CLAUDE.md proíbe nominalmente ---
# "PROIBIDO git reset, checkout, restore, revert, stash, clean, cherry-pick —
#  eles descartam a worktree e perdem a evolução de agentes concorrentes."
# O cherry-pick estava na proibição do contrato e FALTAVA no guard; foi este
# gate, na primeira execução, que o encontrou.
veredito BLOQUEIA 'git cherry-pick --continue'
veredito BLOQUEIA 'git rebase main'
veredito BLOQUEIA 'git rebase --abort'
veredito BLOQUEIA 'git push --force origin main'
veredito BLOQUEIA 'git push -f origin main'
veredito BLOQUEIA 'git apply -R patch.diff'
veredito BLOQUEIA 'git checkout HEAD~1 -- arquivo.go'
veredito BLOQUEIA 'git restore --staged --worktree .'

# --- worktree: só o --force destrói; sem ele o git já recusa suja ----------
veredito PASSA 'git worktree remove /opt/wiki/.agents/runtime/worktrees/medicao'
veredito PASSA 'git worktree remove ../baseline'
veredito PASSA 'git worktree prune'
veredito PASSA 'git worktree list'
veredito PASSA 'git worktree add --detach /tmp/wt HEAD'
veredito BLOQUEIA 'git worktree remove --force /opt/wiki/x'
veredito BLOQUEIA 'git worktree remove -f ../wt'
veredito BLOQUEIA 'git worktree remove --force --force ../wt'
veredito BLOQUEIA 'git worktree remove -ff ../wt'

# --- o trabalho legítimo que NUNCA pode ser barrado ------------------------
veredito PASSA 'git status --porcelain'
veredito PASSA 'git diff --cached --stat'
veredito PASSA 'git log --oneline -5'
veredito PASSA 'git show HEAD:internal/checks/checks.go'
veredito PASSA 'git add internal/gittestenv'
veredito PASSA 'git commit -F msg.txt -- internal/checks'
veredito PASSA 'git stash list'
veredito PASSA 'git stash show'
veredito PASSA 'git rm --cached data/ops/estado.json'
veredito PASSA 'git ls-files -s tools/'

if [[ $FALHAS -gt 0 ]]; then
	echo "check-git-guard-regressao: REPROVADO ${FALHAS}/${TOTAL}" >&2
	exit 1
fi
echo "check-git-guard-regressao: pass ${TOTAL}/${TOTAL} vereditos"
