MEDIDO_EM = "2026-09-16"
TRECHO_ANTIGO = "jdireito civil e do consumidor"
TRECHO_NOVO = "direito civil e do consumidor"

# O PLANO. `linha_sha256_antes` e `_depois` são as duas únicas formas que este
# registro pode ter: qualquer terceira é outra frente tendo escrito por cima, e
# aí o reparo aborta em vez de decidir sozinho o que fazer com o trabalho dela.
