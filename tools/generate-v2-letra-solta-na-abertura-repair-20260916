        "linha_sha256_antes":
            "732d526b86c72fa4100896cd4d231bd97e5a96c4a03b953a73cf6da80524a64c",
        "linha_sha256_depois":
            "5f2cc89fdb8b154d8f2bf3674a2b599b25d596436c34d65909288ab73f9560de",
        "confere_word_count": False,
    },
)

NOME = "letra-solta-na-abertura-20260916"
RE_PALAVRA = re.compile(r"[0-9A-Za-zÀ-ÖØ-öø-ÿ]+")


class CASFalhou(RuntimeError):
    """O registro no disco não é nenhuma das duas formas que o plano conhece."""


@contextlib.contextmanager
def lock_exclusivo(caminho: pathlib.Path):
    caminho.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(caminho, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def escrita_atomica(caminho: pathlib.Path, payload: bytes) -> None:
    """mkstemp -> fsync -> replace -> fsync do diretório, modo 0644.

    O fsync do DIRETÓRIO é o que falta na maioria das escritas ditas atômicas:
    sem ele o rename pode não estar durável depois de uma queda, e o shard
    reaparece truncado ou com o nome velho apontando para nada.
    """
    diretorio = caminho.parent
    fd, temporario = tempfile_mkstemp(diretorio, caminho.name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporario, 0o644)
        os.replace(temporario, caminho)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporario)
        raise
    dir_fd = os.open(diretorio, os.O_RDONLY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def tempfile_mkstemp(diretorio: pathlib.Path, base: str) -> tuple[int, str]:
    import tempfile
    return tempfile.mkstemp(prefix=f".{base}.", suffix=".tmp", dir=str(diretorio))


def conta_palavras_do_corpo(registro: dict) -> int:
    """A fórmula canônica de word_count (tools/generate_v2_review_queue.py:474).

    Reimplementá-la seria medir a coisa ao lado; ela está aqui porque aquele
    módulo não expõe a contagem isolada, e o que importa NESTE gerador não é o
    valor absoluto e sim a INVARIÂNCIA: `jdireito` e `direito` são um token
    cada, então o corpo tem de contar igual antes e depois. Se não contar, o
    ingest rejeitaria com `declared_word_count_incoherent` e a página sumiria do
    estoque sem ninguém ter pedido.
    """
    partes = [registro.get("opening") or ""]
    for secao in registro.get("sections") or []:
        partes.append(secao.get("heading") or "")
        partes.append(secao.get("text") or "")
    for item in registro.get("faq") or []:
        partes.append(item.get("q") or "")
        partes.append(item.get("a") or "")
    return len(RE_PALAVRA.findall(" ".join(partes)))


def sha256_de(texto: str) -> str:
    return hashlib.sha256(texto.encode("utf-8")).hexdigest()


def preserva_anterior(raiz: pathlib.Path, alvo: dict, linha: str) -> pathlib.Path:
    """Página redigida nunca se descarta: o registro anterior fica em
    `.agents/runtime/` com data ANTES de qualquer escrita."""
    destino = (raiz / ".agents" / "runtime" / NOME / MEDIDO_EM /
               (pathlib.Path(alvo["arquivo"]).stem + "." + alvo["intent_id"] + ".jsonl"))
    destino.parent.mkdir(parents=True, exist_ok=True)
    escrita_atomica(destino, (linha + "\n").encode("utf-8"))
    return destino


def repara(raiz: pathlib.Path, aplicar: bool) -> tuple[int, int, list[dict]]:
    tocados, ja_reparados, evidencia = 0, 0, []
    for alvo in ALVOS:
        caminho = raiz / alvo["arquivo"]
        if not caminho.exists():
            raise FileNotFoundError(f"alvo ausente: {caminho}")
        bruto = caminho.read_text(encoding="utf-8")
        if not bruto.endswith("\n"):
            raise ValueError(f"{alvo['arquivo']}: JSONL sem quebra final; não reescrevo forma que não reconheço")
        linhas = bruto[:-1].split("\n")
        sha_shard_antes = hashlib.sha256(caminho.read_bytes()).hexdigest()

        agulha = '"intent_id":"' + alvo["intent_id"] + '"'
        indices = [i for i, linha in enumerate(linhas) if agulha in linha]
        if len(indices) != 1:
            raise ValueError(
                f"{alvo['arquivo']}: {len(indices)} linha(s) com {alvo['intent_id']}; o plano viu exatamente 1")
        indice = indices[0]
        linha = linhas[indice]
        atual = sha256_de(linha)

        if atual == alvo["linha_sha256_depois"]:
            ja_reparados += 1
            print(f"  = {alvo['arquivo']} linha {indice + 1}: já reparado (CAS bate com a forma final)")
            continue
        if atual != alvo["linha_sha256_antes"]:
            raise CASFalhou(
                f"CAS FALHOU em {alvo['arquivo']} linha {indice + 1} ({alvo['intent_id']}): "
                f"sha256 da linha é {atual}, o plano viu {alvo['linha_sha256_antes']} "
                f"(e a forma reparada seria {alvo['linha_sha256_depois']}). "
                "Outra frente escreveu por cima — NADA foi tocado.")

        ocorrencias = linha.count(TRECHO_ANTIGO)
        if ocorrencias != alvo["ocorrencias"]:
            raise CASFalhou(
                f"CAS DO TRECHO FALHOU em {alvo['arquivo']} linha {indice + 1}: "
                f"{ocorrencias} ocorrência(s) de {TRECHO_ANTIGO!r}, o plano mediu {alvo['ocorrencias']}")

        nova_linha = linha.replace(TRECHO_ANTIGO, TRECHO_NOVO)
        if sha256_de(nova_linha) != alvo["linha_sha256_depois"]:
            raise CASFalhou(
                f"a linha reparada de {alvo['arquivo']} não bate com o oráculo: "
                f"{sha256_de(nova_linha)} != {alvo['linha_sha256_depois']}")

        if alvo["confere_word_count"]:
            antes_reg, depois_reg = json.loads(linha), json.loads(nova_linha)
            palavras_antes = conta_palavras_do_corpo(antes_reg)
            palavras_depois = conta_palavras_do_corpo(depois_reg)
            declarado = depois_reg.get("word_count")
            if palavras_antes != palavras_depois:
                raise CASFalhou(
                    f"o corpo mudou de {palavras_antes} para {palavras_depois} palavras: "
                    "o reparo teria de redeclarar word_count, e isso não é remoção de byte")
            if declarado != antes_reg.get("word_count"):
                raise CASFalhou("word_count declarado mudou sem ninguém ter pedido")
            print(f"  · word_count: declarado={declarado} corpo={palavras_depois} (invariante)")

        guardado = preserva_anterior(raiz, alvo, linha) if aplicar else None
        linhas[indice] = nova_linha
        tocados += 1
        conteudo = ("\n".join(linhas) + "\n").encode("utf-8")
        sha_shard_depois = hashlib.sha256(conteudo).hexdigest()
        if aplicar:
            escrita_atomica(caminho, conteudo)
        evidencia.append({
            "arquivo": alvo["arquivo"],
            "intent_id": alvo["intent_id"],
            "linha": indice + 1,
            "linhas_no_shard": len(linhas),
            "ocorrencias_trocadas": ocorrencias,
            "trecho_antigo": TRECHO_ANTIGO,
            "trecho_novo": TRECHO_NOVO,
            "linha_sha256_antes": atual,
            "linha_sha256_depois": sha256_de(nova_linha),
            "shard_sha256_antes": sha_shard_antes,
            "shard_sha256_depois": sha_shard_depois,
            "registro_anterior_em": str(guardado.relative_to(raiz)) if guardado else None,
            "oraculo": "cmd/generate-acordao-pages/main_test.go:TestORACULOPaginaDoCerebro1438501",
            "medido_em": MEDIDO_EM,
        })
        print(f"  ✓ {alvo['arquivo']} linha {indice + 1}: {ocorrencias} ocorrência(s) "
              f"· {len(linhas) - 1}/{len(linhas) - 1} demais linhas intocadas")
    return tocados, ja_reparados, evidencia


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="tira a letra solta da fonte da prosa que o portal assina (acórdão 1438501)")
    parser.add_argument("--aplicar", action="store_true", help="escreve; sem isto é dry-run")
    parser.add_argument("--raiz", default=str(ROOT),
                        help="raiz alternativa (os controles rodam contra cópia, não contra o estoque vivo)")
    args = parser.parse_args(argv)
    raiz = pathlib.Path(args.raiz).resolve()

    try:
        with canonical_stock_write_lease(raiz):
            with lock_exclusivo(raiz / "data" / "editorial" / f".{NOME}.lock"):
                tocados, ja_reparados, evidencia = repara(raiz, args.aplicar)
                if args.aplicar and evidencia:
                    ledger = raiz / "data" / "ops" / f"letra_solta_na_abertura_repair_{MEDIDO_EM.replace('-', '')}.jsonl"
                    ledger.parent.mkdir(parents=True, exist_ok=True)
                    escrita_atomica(ledger, "".join(
                        json.dumps(e, ensure_ascii=False, sort_keys=True) + "\n"
                        for e in evidencia).encode("utf-8"))
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75
    except CASFalhou as erro:
        print(f"{erro}", file=sys.stderr)
        return 2

    print(f"alvos no plano: {len(ALVOS)} · reparados agora: {tocados} · já reparados: {ja_reparados}")
    if not args.aplicar:
        print("  (dry-run: nada foi escrito; use --aplicar)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
