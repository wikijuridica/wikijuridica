#!/usr/bin/env python3
"""measure-anchor-claim-placeholder-20260812 — enumera o preenchimento que promete conferencia e nao entrega.

O DEFEITO. `official_sources[].anchor_claim` existe para carregar o TEXTO DO
DISPOSITIVO, copiado do documento oficial: e o que permite a qualquer pessoa
conferir que a fonte sustenta o que a pagina afirma. Em parte do acervo ele traz
a string de preenchimento "texto oficial vigente da norma no Planalto" — um
rotulo generico onde deveria estar o caput do artigo. Campo de evidencia escrito
sem a evidencia correspondente.

O QUE ESTE MEDIDOR FAZ (read-only, nao escreve em data/editorial):
  1. conta o preenchimento em duas unidades, porque as duas circulam:
     ocorrencias da STRING literal e CAMPOS afetados (um campo pode conte-la 2x);
  2. para cada campo, resolve a norma pela URL da fonte contra data/legal-corpus,
     por IDENTIDADE de norma (o acervo cita `constituicao.htm` e o corpus
     confere em `constituicaocompilado.htm` — URL exata nao casa);
  3. descobre qual dispositivo O CORPO daquela pagina invoca, lendo
     data/ops/citation_inventory.jsonl (diploma + artigo extraidos do texto);
  4. monta o claim candidato pela MESMA regra ja sancionada em
     generate-v2-second-official-source-from-corpus-20260806 (caput ate o
     primeiro paragrafo/inciso, teto de 320 caracteres);
  5. FAIL-CLOSED nominal onde nao da para provar: norma fora do corpus, corpo que
     nao invoca dispositivo daquela norma, artigo ausente do corpus. Claim errado
     e pior que claim ausente.

Uso:
    tools/measure-anchor-claim-placeholder-20260812
    tools/measure-anchor-claim-placeholder-20260812 --json <saida>
"""
from __future__ import annotations

import argparse
import collections
import hashlib
import json
import os
import re
from pathlib import Path

ROOT = Path(os.path.dirname(os.path.abspath(os.path.dirname(__file__))))
CORPUS = ROOT / "data/legal-corpus"
PAGES = ROOT / "data/editorial/v2_pages"
INVENTARIO = ROOT / "data/ops/citation_inventory.jsonl"
MANIFESTO = ROOT / "data/editorial/published_manifest.jsonl"

PLACEHOLDER = "texto oficial vigente da norma no Planalto"
ANCHOR_MAX = 320  # mesmo teto do gerador sancionado


def normalizar_url(url: str) -> str:
    """Identidade da norma: o sufixo de consolidacao nao muda a lei."""
    url = (url or "").strip().lower()
    url = url.split("#", 1)[0].split("?", 1)[0]
    url = re.sub(r"^https?://(www\.)?", "", url)
    arquivo = url.rsplit("/", 1)[-1]
    arquivo = re.sub(r"\.html?$", "", arquivo)
    arquivo = re.sub(r"(compilado|compilada|compilado2|consol|cons)$", "", arquivo)
    return arquivo


def carregar_corpus() -> tuple[dict, dict]:
    diplomas, por_url = {}, {}
    for caminho in sorted(CORPUS.glob("*.json")):
        dados = json.loads(caminho.read_text(encoding="utf-8"))
        slug = dados.get("slug") or caminho.stem
        diplomas[slug] = dados
        for campo in ("source_url", "conference_url", "citation_url", "declared_url"):
            if dados.get(campo):
                por_url[normalizar_url(dados[campo])] = slug
    return diplomas, por_url


def _cortar(texto: str) -> str:
    if len(texto) > ANCHOR_MAX:
        corte = texto.rfind(" ", 0, ANCHOR_MAX)
        texto = texto[:corte if corte > 0 else ANCHOR_MAX].rstrip(" ,;") + "…"
    return texto.strip()


def texto_do_artigo(dados: dict, artigo: str) -> str | None:
    chave = (artigo or "").replace(".", "").upper()
    bruto = (dados.get("articles") or {}).get(chave)
    return " ".join(bruto.split()) if bruto else None


def caput_do_artigo(dados: dict, artigo: str) -> str | None:
    texto = texto_do_artigo(dados, artigo)
    if not texto:
        return None
    caput = re.split(r"\s(?:§|Par[áa]grafo [úu]nico|I\s*-\s)", texto)[0]
    return _cortar(caput)


def fragmento_do_qualificador(dados: dict, artigo: str, qualificador: str) -> str | None:
    """O § ou inciso que a pagina invoca — nao o caput.

    Quando o corpo escreve "o § 7º do art. 159 do CTB", o dispositivo que
    sustenta a afirmacao e aquele paragrafo. Devolver o caput ali seria repetir
    o defeito que este trabalho corrige: prometer conferencia e entregar outra
    coisa.
    """
    texto = texto_do_artigo(dados, artigo)
    if not texto or not qualificador:
        return None
    qualificador = qualificador.strip()

    par = re.match(r"§+\s*([\d]+)", qualificador)
    if par:
        numero = par.group(1)
        marca = re.search(rf"§\s*{numero}(?![\d])\s*[ºo°]?\s*", texto)
        if not marca:
            return None
        resto = texto[marca.end():]
        fim = re.search(r"\s§\s*\d", resto)
        return _cortar(resto[:fim.start()] if fim else resto)

    if re.fullmatch(r"[IVXLC]+", qualificador):
        marca = re.search(rf"(?:^|\s){re.escape(qualificador)}\s*[-–—]\s*", texto)
        if not marca:
            return None
        resto = texto[marca.end():]
        fim = re.search(r"\s[IVXLC]+\s*[-–—]\s|\s§\s*\d", resto)
        return _cortar(resto[:fim.start()] if fim else resto)

    return None


PALAVRA_RE = re.compile(r"[0-9a-zà-öø-ÿ]{4,}", re.IGNORECASE)
VAZIAS = {"para", "pela", "pelo", "pelos", "pelas", "como", "quando", "que",
          "com", "dos", "das", "seus", "suas", "este", "esta", "esse", "essa",
          "sobre", "entre", "ainda", "artigo", "art", "lei", "codigo", "código",
          "caso", "casos", "outros", "outras", "mesmo", "mesma", "sera", "será"}


def termos(texto: str) -> set:
    return {p.lower() for p in PALAVRA_RE.findall(texto or "")} - VAZIAS


def sobreposicao(frase: str, caput: str) -> float:
    """Fracao dos termos do caput que a frase do corpo tambem usa.

    E a mesma medida do detector: um claim que nao compartilha termo nenhum com
    o dispositivo citado nao esta carregando aquele dispositivo.
    """
    a, b = termos(caput), termos(frase)
    if not a:
        return 0.0
    return len(a & b) / len(a)


def carregar_inventario() -> dict:
    """(intent_id, diploma) -> Counter de artigos que o CORPO invoca."""
    mapa = collections.defaultdict(collections.Counter)
    frases = {}
    with open(INVENTARIO, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if not linha:
                continue
            reg = json.loads(linha)
            intent, diploma = reg.get("intent_id"), reg.get("diploma")
            artigo = (reg.get("article") or "").strip()
            if not (intent and diploma and artigo):
                continue
            mapa[(intent, diploma)][artigo] += 1
            frases.setdefault((intent, diploma, artigo), []).append(
                ((reg.get("qualifier") or "").strip(), reg.get("claim") or ""))
    return mapa, frases


def carregar_publicadas() -> dict:
    pub = {}
    with open(MANIFESTO, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if linha:
                reg = json.loads(linha)
                pub[reg["unique_intent_id"]] = reg.get("path")
    return pub


def enumerar(diplomas, por_url, invent, frases, publicadas):
    """Enumera os campos afetados. Devolve (linhas, strings, campos).

    Extraido de main() para que o gerador datado importe ESTA funcao: plano e
    aplicacao nascem do mesmo codigo e nao podem divergir.
    """
    strings = campos = 0
    linhas = []
    for shard in sorted(PAGES.glob("*.jsonl")):
        for numero, linha in enumerate(open(shard, encoding="utf-8"), 1):
            if PLACEHOLDER not in linha:
                continue
            reg = json.loads(linha)
            intent = reg.get("intent_id")
            # sha256 da LINHA VIVA: e o que o gerador datado compara antes de
            # escrever. Sem ele o CAS de linha seria promessa vazia — a frente
            # que publica pode reescrever o corpo entre o plano e a aplicacao,
            # mudando qual dispositivo a pagina invoca, sem que o preenchimento
            # ou a URL mudem.
            linha_sha = hashlib.sha256(
                linha.rstrip("\n").encode("utf-8")).hexdigest()
            for indice, fonte in enumerate(reg.get("official_sources") or []):
                claim = fonte.get("anchor_claim") or ""
                if PLACEHOLDER not in claim:
                    continue
                campos += 1
                strings += claim.count(PLACEHOLDER)

                # forma do campo: so preenchimento, duplicado, ou misto com texto real
                resto = " | ".join(
                    p.strip() for p in claim.split("|")
                    if p.strip() and p.strip() != PLACEHOLDER)
                forma = ("so_preenchimento" if not resto
                         else "misto_com_texto_real")

                url = fonte.get("url") or ""
                diploma = por_url.get(normalizar_url(url))
                artigo = novo = motivo = None
                grau = None
                dispositivo = None
                if not diploma:
                    motivo = "norma_fora_do_corpus"
                elif not diplomas[diploma].get("confiavel_para_acusar_divergencia"):
                    motivo = "corpus_nao_confiavel_para_o_diploma"
                else:
                    contagem = invent.get((intent, diploma)) or collections.Counter()
                    # Entre os artigos que o corpo invoca daquela norma, vence o
                    # que o proprio corpo PARAFRASEIA — sobreposicao de termos
                    # entre a frase da pagina e o caput oficial. Escolher "o mais
                    # citado" seria chute; isto e medida.
                    validos = []
                    for art in contagem:
                        for qualificador, frase in frases.get((intent, diploma, art), []):
                            if qualificador:
                                # O corpo invocou § ou inciso ESPECIFICO. Se o
                                # trecho nao sai do corpus, nao se cai no caput:
                                # devolver o caput no lugar do paragrafo pedido e
                                # repetir o defeito (o art. 159 do CTB entregava
                                # "A Carteira Nacional de Habilitacao:" onde a
                                # pagina falava do registro unico no Renach).
                                trecho = fragmento_do_qualificador(
                                    diplomas[diploma], art, qualificador)
                                if not trecho:
                                    continue
                            else:
                                trecho = caput_do_artigo(diplomas[diploma], art)
                            if not trecho or len(trecho) < 40:
                                continue
                            # Enunciado que so anuncia uma lista ("As medidas de
                            # seguranca sao:") nao sustenta afirmacao nenhuma.
                            if trecho.rstrip().endswith(":") and len(trecho) < 120:
                                continue
                            validos.append((sobreposicao(frase, trecho), art,
                                            qualificador, trecho))
                    validos.sort(key=lambda t: (-t[0], t[1]))
                    if not contagem:
                        motivo = "corpo_nao_invoca_dispositivo_dessa_norma"
                    elif not validos:
                        motivo = "dispositivo_invocado_ausente_do_corpus"
                    else:
                        grau, artigo, qualificador, novo = validos[0]
                        dispositivo = (f"art. {artigo}, {qualificador}"
                                       if qualificador else f"art. {artigo}")

                linhas.append({
                    "shard": shard.name,
                    "linha": numero,
                    "linha_sha256": linha_sha,
                    "intent_id": intent,
                    "path": publicadas.get(intent),
                    "publicada": intent in publicadas,
                    "source_index": indice,
                    "source_name": fonte.get("name"),
                    "source_url": url,
                    "diploma": diploma,
                    "forma_do_campo": forma,
                    "texto_real_preservar": resto or None,
                    "artigo_invocado_pelo_corpo": artigo,
                    "dispositivo": dispositivo,
                    "sobreposicao": round(grau,3) if grau is not None else None,
                    "artigos_candidatos": (
                        dict(invent.get((intent, diploma)) or {}) if diploma else {}),
                    "claim_novo": novo,
                    "fail_closed": motivo,
                    "frase_do_corpo": (frases.get((intent, diploma, artigo)) or [("","")])[0][1][:200],
                })

    return linhas, strings, campos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", default="")
    args = parser.parse_args()

    diplomas, por_url = carregar_corpus()
    invent, frases = carregar_inventario()
    publicadas = carregar_publicadas()
    linhas, strings, campos = enumerar(diplomas, por_url, invent, frases, publicadas)

    preenchiveis = [r for r in linhas if r["claim_novo"]]
    pendentes = [r for r in linhas if not r["claim_novo"]]
    print(f"ocorrencias da STRING .............. {strings}")
    print(f"CAMPOS anchor_claim afetados ....... {campos}")
    print(f"paginas distintas .................. {len({r['intent_id'] for r in linhas})}")
    print(f"shards distintos ................... {len({r['shard'] for r in linhas})}")
    print(f"publicadas ......................... {len({r['intent_id'] for r in linhas if r['publicada']})}")
    print()
    print(f"PREENCHIVEIS (claim provado) ....... {len(preenchiveis)}")
    print(f"FAIL-CLOSED (pendencia de coleta) .. {len(pendentes)}")
    for motivo, n in collections.Counter(r["fail_closed"] for r in pendentes).most_common():
        print(f"    {motivo}: {n}")
    print()
    print("forma do campo:")
    for forma, n in collections.Counter(r["forma_do_campo"] for r in linhas).most_common():
        print(f"    {forma}: {n}")
    print()
    print("por diploma:")
    for dip, n in collections.Counter(r["diploma"] or "(fora do corpus)" for r in linhas).most_common():
        print(f"    {dip}: {n}")
    ambiguos = [r for r in preenchiveis if len(r["artigos_candidatos"]) > 1]
    print(f"\ncom mais de um artigo candidato: {len(ambiguos)}")

    if args.json:
        Path(args.json).write_text(
            json.dumps({"gerado_em": "2026-08-12", "ocorrencias_string": strings,
                        "campos": campos, "linhas": linhas},
                       ensure_ascii=False, indent=1), encoding="utf-8")
        print(f"\ndetalhe: {args.json}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
