def ler_jsonl(caminho):
    """Lista de registros de um JSONL; linha ilegível é pulada, arquivo
    ausente vira lista vazia. Erro de I/O propaga — é o caso do exit 3."""
    registros = []
    if not os.path.isfile(caminho):
        return registros
    with open(caminho, encoding="utf-8") as fh:
        for bruto in fh:
            bruto = bruto.strip()
            if not bruto:
                continue
            try:
                registros.append(json.loads(bruto))
            except json.JSONDecodeError:
                continue
    return registros


def dominio_do_site():
    with open(SITE, encoding="utf-8") as fh:
        base = json.load(fh)["base_url"]
    return base.split("://", 1)[-1].rstrip("/")


def resolver_zona(env):
    """(zona_id, erro). `CLOUDFLARE_ZONE_ID` no ambiente tem precedência (mesma
    convenção de tools/apply-cache-rules); senão `GET /zones?name=` pelo
    módulo de credencial, que já cacheia por processo."""
    explicita = (env or {}).get("CLOUDFLARE_ZONE_ID")
    if explicita:
        return explicita, None
    return cloudflare_auth.zona_id(dominio_do_site(), env=env)


RESOLVER_ZONA = resolver_zona


def instante(texto):
    """ISO-8601 → datetime com fuso; 'Z' aceito; sem fuso assume UTC (os
    ledgers deste repositório gravam em UTC). Inválido → None."""
    if not isinstance(texto, str) or not texto:
        return None
    try:
        valor = dt.datetime.fromisoformat(texto.replace("Z", "+00:00"))
    except ValueError:
        return None
    if valor.tzinfo is None:
        valor = valor.replace(tzinfo=dt.timezone.utc)
    return valor


# ───────────────────────────── GraphQL ───────────────────────────────────────

def janela_do_dia(dia):
    return f"{dia.isoformat()}T00:00:00Z", f"{dia.isoformat()}T23:59:59Z"


def grupos_de(dados):
    zonas = ((dados or {}).get("viewer") or {}).get("zones") or []
    return (zonas[0] if zonas else {}).get("httpRequestsAdaptiveGroups") or []


def grupos_1d_de(dados):
    zonas = ((dados or {}).get("viewer") or {}).get("zones") or []
    return (zonas[0] if zonas else {}).get("httpRequests1dGroups") or []


def intervalo_de(grupo):
    return (grupo.get("avg") or {}).get("sampleInterval") or 1


def agrega_cache_status(grupos):
    """{por_status: {status: {requests, bytes, pct, sample_interval_medio}},
    total_requests, total_bytes}. `requests` é o count — ver o cabeçalho para
    a medição que mostra que o count já é a contagem."""
    por_status = {}
    for g in grupos:
        status = (g.get("dimensions") or {}).get("cacheStatus") or "sem_status"
        fatia = por_status.setdefault(status, {"requests": 0, "bytes": 0, "_si": 0.0})
        n = g.get("count", 0)
        fatia["requests"] += n
        fatia["bytes"] += (g.get("sum") or {}).get("edgeResponseBytes") or 0
        fatia["_si"] += n * intervalo_de(g)
    total_r = sum(f["requests"] for f in por_status.values())
    total_b = sum(f["bytes"] for f in por_status.values())
    for fatia in por_status.values():
        ponderado = fatia.pop("_si")
        fatia["sample_interval_medio"] = round(ponderado / fatia["requests"], 3) if fatia["requests"] else None
        fatia["pct"] = round(100.0 * fatia["requests"] / total_r, 2) if total_r else None
    return {
        "por_status": dict(sorted(por_status.items())),
        "total_requests": total_r,
        "total_bytes": total_b,
    }


def conferencia_exata(cache_status, grupos_1d):
    """Confronta Σ count do adaptativo com o total exato do 1dGroups do mesmo
    dia. Razão ~1,00 é o esperado (medido: 0,997–1,002); longe disso, o count
    deixou de ser contagem e a linha tem de dizer."""
    soma = {"requests": 0, "bytes": 0, "cachedRequests": 0, "cachedBytes": 0}
    for g in grupos_1d:
        for chave in soma:
            soma[chave] += (g.get("sum") or {}).get(chave) or 0
    exato_r = soma["requests"]
    exato_hit = soma["cachedRequests"]
    hit = (cache_status["por_status"].get("hit") or {}).get("requests", 0)
    return {
        "requests_1d": exato_r if grupos_1d else None,
        "bytes_1d": soma["bytes"] if grupos_1d else None,
        "cached_requests_1d": exato_hit if grupos_1d else None,
        "razao_requests": round(cache_status["total_requests"] / exato_r, 4) if exato_r else None,
        "razao_hit": round(hit / exato_hit, 4) if exato_hit else None,
        "fonte": "httpRequests1dGroups (exato) vs Σ count de httpRequestsAdaptiveGroups",
    }


def familia_de(user_agent):
    """Primeira família de FAMILIAS_DE_BOT cuja substring aparece no UA em
    minúsculas; None se nenhuma."""
    ua = (user_agent or "").lower()
    for familia in FAMILIAS_DE_BOT:
        if familia in ua:
            return familia
    return None


def particiona_misses(grupos, limite=LIMITE_MISSES):
    """Quatro fatias disjuntas dos MISS do dia — ver o cabeçalho."""
    aquecedor = {"requests": 0, "_si": 0.0}
    proprio_outros = {"requests": 0}
    restantes = {"requests": 0}
    familias = {f: {"requests": 0, "cloudflare_verified": 0} for f in FAMILIAS_DE_BOT}
    uas_aquecedor = set()
    for g in grupos:
        dims = g.get("dimensions") or {}
        ua = dims.get("userAgent") or ""
        categoria = dims.get("verifiedBotCategory") or ""
        n = g.get("count", 0)
        if ua.startswith(PREFIXO_AQUECEDOR):
            alvo = aquecedor
            uas_aquecedor.add(ua)
            alvo["_si"] += n * intervalo_de(g)
        elif ua.startswith(PREFIXO_PROPRIO):
            alvo = proprio_outros
        else:
            familia = familia_de(ua)
            if familia:
                alvo = familias[familia]
                if categoria:
                    alvo["cloudflare_verified"] += n
            else:
                alvo = restantes
        alvo["requests"] += n

    ponderado = aquecedor.pop("_si")
    aquecedor["sample_interval_medio"] = (
        round(ponderado / aquecedor["requests"], 3) if aquecedor["requests"] else None)
    aquecedor["user_agents"] = sorted(uas_aquecedor)
    total = sum(g.get("count", 0) for g in grupos)
    return {
        "misses_do_aquecedor": aquecedor,
        "misses_trafego_proprio_outros": proprio_outros,
        "misses_de_bots_verificados": familias,
        "misses_restantes": restantes,
        "misses_total": {"requests": total},
        "query_truncated": len(grupos) >= limite,
    }


def consultar_dia(zona, dia):
    """(bloco_graphql, erro). Quatro consultas; qualquer erro devolve
    (None, motivo) — nunca meio bloco."""
    desde, ate = janela_do_dia(dia)
    variaveis = {"zone": zona, "since": desde, "until": ate}
    dados, erro = GRAPHQL(CONSULTA_CACHE_STATUS, variaveis)
    if erro:
        return None, f"cache_status: {erro}"
    cache_status = agrega_cache_status(grupos_de(dados))
    dados, erro = GRAPHQL(CONSULTA_EXATA_1D, {"zone": zona, "dia": dia.isoformat()})
    if erro:
        return None, f"conferencia_exata: {erro}"
    conferencia = conferencia_exata(cache_status, grupos_1d_de(dados))
    dados, erro = GRAPHQL(CONSULTA_CACHE_STATUS_SEM_PROPRIO, variaveis)
    if erro:
        return None, f"cache_status_sem_trafego_proprio: {erro}"
    sem_proprio = agrega_cache_status(grupos_de(dados))
    dados, erro = GRAPHQL(CONSULTA_MISSES_POR_UA, dict(variaveis, limite=LIMITE_MISSES))
    if erro:
        return None, f"misses_por_ua: {erro}"
    misses = particiona_misses(grupos_de(dados))
    bloco = {
        "window_start": desde,
        "window_end": ate,
        "cache_status": cache_status,
        "conferencia_exata": conferencia,
        "cache_status_sem_trafego_proprio": sem_proprio,
    }
    bloco.update(misses)
    return bloco, None


# ───────────────────────────── disco ─────────────────────────────────────────

def share_autoaquecimento(dia, linhas_trafego):
    """Última linha do dia em edge_traffic_daily: self_warming_requests /
    requests. Sem linha ou denominador zero ⇒ nao_mensuravel."""
    alvo = None
    for r in linhas_trafego:
        if r.get("date") == dia.isoformat():
            alvo = r
    if alvo is None:
        return {"self_warming_requests": None, "requests": None, "share": None,
                "status": "sem_linha_no_dia"}
    proprio = alvo.get("self_warming_requests") or 0
    total = alvo.get("requests") or 0
    if total <= 0:
        return {"self_warming_requests": proprio, "requests": total, "share": None,
                "status": "nao_mensuravel"}
    return {"self_warming_requests": proprio, "requests": total,
            "share": round(proprio / total, 4), "status": "ok",
            "cobertura_do_ledger": alvo.get("self_warming_coverage")}


_RE_URLS = re.compile(r"(\d+) URL\(s\)")
_RE_TAGS = re.compile(r"(\d+) tag\(s\)")


def purgas_do_dia(dia, purgas):
    prefixo = dia.isoformat()
    tudo = 0
    url = {"execucoes": 0, "urls": 0}
    tag = {"execucoes": 0, "tags": 0}
    falhas = 0
    for p in purgas:
        if not (p.get("purged_at") or "").startswith(prefixo):
            continue
        if p.get("success") is not True:
            falhas += 1
            continue
        escopo = p.get("scope") or ""
        if escopo == "tudo":
            tudo += 1
            continue
        m_url = _RE_URLS.search(escopo)
        if m_url:
            url["execucoes"] += 1
            url["urls"] += int(m_url.group(1))
        m_tag = _RE_TAGS.search(escopo)
        if m_tag:
            tag["execucoes"] += 1
            tag["tags"] += int(m_tag.group(1))
    return {"purgas_tudo": tudo, "purgas_url": url, "purgas_tag": tag,
            "purgas_falhas": falhas}


def travessia_por_bot(dia, borda_por_chave, linhas_origem):
    """origem ÷ borda por agent_key, numeradores gravados, sem divisão por
    zero. Ver o cabeçalho para a escolha de campo em cada ledger."""
    data = dia.isoformat()
    borda = {}
    for (d, agente), r in borda_por_chave.items():
        if d != data or not agente:
            continue
        total = r.get("requests_sampled") or 0
        faixa_ip = r.get("requests_sampled_ip_range") or 0
        if total > 0:
            valor, campo = total, "requests_sampled"
        elif faixa_ip > 0:
            valor, campo = faixa_ip, "requests_sampled_ip_range"
        else:
            valor, campo = 0, "requests_sampled"
        borda[agente] = {
            "valor": valor, "campo": campo,
            "cloudflare_verified": r.get("requests_sampled_cloudflare_verified"),
            "ip_range": r.get("requests_sampled_ip_range"),
            "estimated_produtor": r.get("requests_estimated"),
        }
    origem = {}
    for r in linhas_origem:
        if r.get("date") != data or not r.get("agent_key"):
            continue
        if r.get("summable") is False:
            continue
        agente = r["agent_key"]
        entrada = origem.setdefault(agente, {"valor": 0, "campo": None, "linhas": 0})
        if r.get("requests_authentic") is not None:
            entrada["valor"] += r["requests_authentic"]
            entrada["campo"] = entrada["campo"] or "requests_authentic"
        else:
            entrada["valor"] += r.get("requests") or 0
            entrada["campo"] = entrada["campo"] or "requests"
        entrada["linhas"] += 1

    resultado = {}
    for agente in sorted(set(borda) | set(origem)):
        b = borda.get(agente, {"valor": 0, "campo": None, "cloudflare_verified": None,
                               "ip_range": None, "estimated_produtor": None})
        o = origem.get(agente, {"valor": 0, "campo": None, "linhas": 0})
        if b["valor"] > 0:
            razao = round(o["valor"] / b["valor"], 4)
            status = "ok"
        else:
            razao = None
            status = "nao_mensuravel"
        resultado[agente] = {
            "origem": o["valor"], "origem_campo": o["campo"], "origem_linhas": o["linhas"],
            "borda": b["valor"], "borda_campo": b["campo"],
            "borda_cloudflare_verified": b["cloudflare_verified"],
            "borda_ip_range": b["ip_range"],
            "borda_estimated_produtor": b["estimated_produtor"],
            "travessia": razao,
            "status": status,
            "origem_acima_da_borda": bool(razao is not None and razao > 1),
        }
    return resultado


def purga_na_janela(inicio, instantes_purga, janela_s):
    """True se alguma purga bem-sucedida ocorreu em [inicio − janela_s, inicio]."""
    limite = inicio - dt.timedelta(seconds=janela_s)
    return any(limite <= p <= inicio for p in instantes_purga)


def misses_pre_head_sem_purga(dia, varreduras, purgas, janela_s=JANELA_POS_PURGA_S):
    """Soma de cobertura_pre_head.miss das varreduras so_frios do dia sem purga
    bem-sucedida nos `janela_s` anteriores ao início — ver o cabeçalho."""
    data = dia.isoformat()
    purgas_ok = [instante(p.get("purged_at")) for p in purgas if p.get("success") is True]
    purgas_ok = [p for p in purgas_ok if p is not None]
    total = 0
    so_frios = contadas = excluidas = durante = 0
    for v in varreduras:
        if not (v.get("started_at") or "").startswith(data):
            continue
        if v.get("so_frios") is not True:
            continue
        pre_head = v.get("cobertura_pre_head")
        if not isinstance(pre_head, dict):
            continue
        so_frios += 1
        inicio = instante(v.get("started_at"))
        fim = instante(v.get("finished_at")) or inicio
        if inicio is None:
            continue
        if purga_na_janela(inicio, purgas_ok, janela_s):  # exclusao-pos-purga
            excluidas += 1
            continue
        if any(inicio < p <= fim for p in purgas_ok):
            durante += 1
        contadas += 1
        total += pre_head.get("miss") or 0
    return {"total": total, "varreduras_so_frios": so_frios,
            "varreduras_contadas": contadas,
            "varreduras_excluidas_por_purga": excluidas,
            "purgas_durante_varredura": durante,
            "janela_s": janela_s}


# ───────────────────────────── linha e gravação ──────────────────────────────

def monta_linha(dia, disco, graphql_bloco, motivo_graphql):
    linha = {
        "schema_version": SCHEMA,
        "date": dia.isoformat(),
        "graphql_disponivel": graphql_bloco is not None,
    }
    if graphql_bloco is None:
        linha["motivo_graphql"] = motivo_graphql
    else:
        linha.update(graphql_bloco)
    linha.update(disco)
    return linha


def assinatura(linha):
    return json.dumps({k: v for k, v in linha.items() if k != "gerado_em"},
                      sort_keys=True, ensure_ascii=False)


def grava(linha, caminho=None):
    """Append idempotente: devolve True se gravou, False se a linha idêntica
    (ignorando `gerado_em`) já estava lá."""
    caminho = caminho or SAIDA
    nova = assinatura(linha)
    for existente in ler_jsonl(caminho):
        if assinatura(existente) == nova:
            return False
    linha = dict(linha)
    linha["gerado_em"] = dt.datetime.now(dt.timezone.utc).isoformat()
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    with open(caminho, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    return True


def resumo(linha):
    partes = [linha["date"]]
    if linha.get("graphql_disponivel"):
        cs = linha["cache_status"]["por_status"]
        hit = cs.get("hit", {})
        miss = cs.get("miss", {})
        partes.append("hit=%s (%s%%) miss=%s (%s%%) razao_exato=%s" % (
            hit.get("requests", 0), hit.get("pct"),
            miss.get("requests", 0), miss.get("pct"),
            linha["conferencia_exata"].get("razao_requests")))
        partes.append("miss_aquecedor=%s" % linha["misses_do_aquecedor"]["requests"])
        bots = {f: v["requests"] for f, v in linha["misses_de_bots_verificados"].items() if v["requests"]}
        partes.append("miss_bots=%s" % json.dumps(bots, sort_keys=True))
    else:
        partes.append("graphql=indisponivel(%s)" % linha.get("motivo_graphql"))
    partes.append("autoaquecimento=%s" % linha["share_autoaquecimento"].get("share"))
    partes.append("purgas tudo=%d url=%d(%d) tag=%d(%d)" % (
        linha["purgas_tudo"], linha["purgas_url"]["execucoes"], linha["purgas_url"]["urls"],
        linha["purgas_tag"]["execucoes"], linha["purgas_tag"]["tags"]))
    partes.append("pre_head_sem_purga=%d" % linha["misses_pre_head_sem_purga"]["total"])
    return " | ".join(partes)


def main(argv=None):
    parser = argparse.ArgumentParser(description="linha de base diária do cache da borda")
    parser.add_argument("--dia", help="YYYY-MM-DD em UTC (padrão: ontem)")
    parser.add_argument("--dias", type=int, default=1,
                        help="quantos dias até --dia, inclusive (padrão 1)")
    args = parser.parse_args(argv)

    hoje = dt.datetime.now(dt.timezone.utc).date()
    try:
        ultimo = dt.date.fromisoformat(args.dia) if args.dia else hoje - dt.timedelta(days=1)
    except ValueError:
        print(f"--dia invalido: {args.dia!r} (esperado YYYY-MM-DD)", file=sys.stderr)
        return 2
    if args.dias < 1:
        print("--dias tem de ser >= 1", file=sys.stderr)
        return 2
    dias = [ultimo - dt.timedelta(days=i) for i in range(args.dias - 1, -1, -1)]

    try:
        borda_por_chave, descartadas = edgetelemetry.serie_saneada(RAIZ, caminho=BORDA)
        linhas_origem = ler_jsonl(ORIGEM)
        purgas = ler_jsonl(PURGAS)
        varreduras = ler_jsonl(AQUECIMENTO)
        trafego = ler_jsonl(TRAFEGO)
    except OSError as erro:
        print(f"falha lendo ledger de entrada: {erro}", file=sys.stderr)
        return 3

    env = cloudflare_auth.ambiente()
    cab, rotulo = cloudflare_auth.cabecalhos("leitura", env=env)
    zona, motivo_credencial = None, None
    if cab is None:
        motivo_credencial = "sem_credencial"
        print("sem credencial Cloudflare (CLOUDFLARE_ZONE_TOKEN ou Global Key em .env.local): "
              "a parte GraphQL nao sera medida; a parte do disco segue", file=sys.stderr)
    else:
        zona, erro = RESOLVER_ZONA(env)
        if erro or not zona:
            motivo_credencial = f"zona_nao_resolvida: {erro}"
            print(f"zona nao resolvida ({erro}): a parte GraphQL nao sera medida", file=sys.stderr)

    graphql_faltou = False
    for dia in dias:
        disco = {
            "share_autoaquecimento": share_autoaquecimento(dia, trafego),
            "travessia_por_bot": travessia_por_bot(dia, borda_por_chave, linhas_origem),
            "misses_pre_head_sem_purga": misses_pre_head_sem_purga(dia, varreduras, purgas),
            "borda_linhas_descartadas_pela_serie_saneada": len(descartadas),
        }
        disco.update(purgas_do_dia(dia, purgas))

        bloco, motivo = None, motivo_credencial
        if motivo is None:
            if (hoje - dia).days > RETENCAO_DIAS:
                motivo = "fora_da_retencao"
            else:
                bloco, erro = consultar_dia(zona, dia)
                if bloco is None:
                    motivo = f"api: {erro}"
        if bloco is None:
            graphql_faltou = True
            print(f"  {dia}: GraphQL nao medido ({motivo})", file=sys.stderr)

        linha = monta_linha(dia, disco, bloco, motivo)
        try:
            gravou = grava(linha)
        except OSError as erro:
            print(f"falha gravando {SAIDA}: {erro}", file=sys.stderr)
            return 3
        print(("  gravada   " if gravou else "  identica  ") + resumo(linha))

    print(f"\nledger: {os.path.relpath(SAIDA, RAIZ)}  credencial: {rotulo}")
    return 2 if graphql_faltou else 0


if __name__ == "__main__":
    raise SystemExit(main())
