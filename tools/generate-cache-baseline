# Retenção do httpRequestsAdaptiveGroups no plano Free: 8 dias (medido pelo
# produtor da borda, tools/generate-bot-agents-daily). Dia mais antigo que isso
# devolve vazio — e vazio NÃO é "zero requisições", é "dado que já não existe".
RETENCAO_DIAS = 8

# Famílias de bot do contrato, casadas por SUBSTRING do User-Agent minúsculo.
# A ORDEM importa: cada UA entra na primeira família que casar, para que as
# fatias sejam disjuntas e a soma feche com o total de MISS do dia.
FAMILIAS_DE_BOT = ("perplexitybot", "oai-searchbot", "chatgpt-user", "gptbot",
                   "bingbot", "amazonbot", "googlebot", "claudebot")

PREFIXO_PROPRIO = "wikijuridica"
PREFIXO_AQUECEDOR = "wikijuridica-cache-warm"

# Janela de contaminação por purga: purga bem-sucedida até este tanto antes do
# início da varredura faz o MISS do pré-HEAD ser consequência da purga.
JANELA_POS_PURGA_S = 3600

# Teto de grupos da consulta de MISS por User-Agent. Medido em 2026-09-08: 189
# grupos num dia. O teto fica 26× acima e a linha grava `query_truncated` se
# algum dia bater nele — total montado sobre lista truncada é subcontagem.
LIMITE_MISSES = 5000

CONSULTA_CACHE_STATUS = """
query($zone: String!, $since: Time!, $until: Time!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: 50,
        filter: {datetime_geq: $since, datetime_leq: $until},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      sum { edgeResponseBytes }
      dimensions { cacheStatus }
    }
  } }
}
"""

CONSULTA_CACHE_STATUS_SEM_PROPRIO = """
query($zone: String!, $since: Time!, $until: Time!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: 50,
        filter: {datetime_geq: $since, datetime_leq: $until, userAgent_notlike: "wikijuridica%"},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      sum { edgeResponseBytes }
      dimensions { cacheStatus }
    }
  } }
}
"""

# SEM `userAgent_notlike` de propósito: o aquecedor precisa estar no resultado
# para ser nomeado como fatia. A partição é feita no cliente.
CONSULTA_MISSES_POR_UA = """
query($zone: String!, $since: Time!, $until: Time!, $limite: Int!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: $limite,
        filter: {datetime_geq: $since, datetime_leq: $until, cacheStatus: "miss"},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      dimensions { userAgent verifiedBotCategory }
    }
  } }
}
"""

# O total EXATO do dia (sem amostragem) — a régua contra a qual o count do
# adaptativo é conferido em toda execução. É o mesmo dataset e a mesma forma
# de consulta de tools/check-edge-traffic (`CONSULTA_DIARIA`).
CONSULTA_EXATA_1D = """
query($zone: String!, $dia: Date!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequests1dGroups(limit: 10, filter: {date_geq: $dia, date_leq: $dia}) {
      dimensions { date }
      sum { requests bytes cachedRequests cachedBytes }
    }
  } }
}
"""

