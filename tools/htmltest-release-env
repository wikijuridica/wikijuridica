#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# .cache/tools em vez de /tmp/opt-wiki-tools: o /tmp morre no reboot, e foi por
# isso que htmltest e muffet sumiram juntos e o tool-artifact-provenance passou
# a reprovar com artifact_not_found sem que nada os reinstalasse (BUG-067,
# 2026-08-29). O .cache/ do repo ja esta no .gitignore e ja hospeda o vnu.jar.
BIN_DIR="${WIKI_HTMLTEST_BIN_DIR:-$ROOT/.cache/tools}"
HTMLTEST_BIN="$BIN_DIR/htmltest"
mkdir -p "$BIN_DIR"

if [ ! -x "$HTMLTEST_BIN" ]; then
	GOBIN="$BIN_DIR" go-modern install github.com/wjdp/htmltest@v0.17.0
fi

export WIKI_HTMLTEST_BIN="$HTMLTEST_BIN"

if [ "$#" -gt 0 ]; then
	exec "$@"
fi

exec "$HTMLTEST_BIN" --version
