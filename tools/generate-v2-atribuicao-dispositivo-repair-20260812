#!/usr/bin/env python3
"""generate-v2-atribuicao-dispositivo-repair-20260812 — corrige dispositivo mal atribuído e dois erros de língua.

O DEFEITO. Auditoria de 2026-08-12 leu 66 páginas publicadas inteiras e conferiu
cada citação contra o texto oficial do Planalto. Quatro defeitos jurídicos reais
sobreviveram à conferência (nenhum é falso positivo — todos foram reconferidos
hoje, com o HTML oficial baixado e o sha256 anotado no arquivo de dados):

  Lei 9.099/1995: a página de seguros dizia que o Juizado Especial Cível dispensa
      advogado "até esse teto" de 40 salários mínimos. Os 40 salários são a
      COMPETÊNCIA do art. 3º, I. A dispensa de advogado é do art. 9º e vai só
      até VINTE salários mínimos; acima disso "a assistência é obrigatória".
      É o único defeito do lote com dano prático: leitor com causa entre 20 e 40
      salários ajuizaria sozinho e teria a inicial indeferida.
  CTB art. 306: a enumeração "exame clínico, perícia, vídeo, prova testemunhal
      ou outros meios de prova em direito admitidos" foi atribuída ao §1º. Ela é
      do §2º (redação da Lei 12.971/2014). O §1º fixa os índices (6 dg/L de
      sangue, 0,3 mg/L de ar alveolar) e os sinais disciplinados pelo Contran.
  CC art. 1.583, §2º: o "tempo de convívio dividido de forma equilibrada" foi
      atribuído ao art. 1.584, §2º, que trata de outra coisa — a guarda
      compartilhada aplicada quando não há acordo entre os pais.
  CC art. 1.584, §2º — vigência: a regra do "sem acordo" foi atribuída à Lei
      14.713/2023. Ela é da Lei 13.058/2014; a de 2023 só acrescentou a exceção
      de probabilidade de risco de violência doméstica ou familiar.
  CTB art. 40, §2º — inversão lógica: a FAQ de trânsito perguntava se carro com
      DRL também precisa de farol baixo aceso e respondia "Sim", explicando em
      seguida que o dispositivo DISPENSA o veículo com luzes de rodagem diurna.
      A atribuição estava certa e a explicação também; era a resposta que
      contradizia o próprio parágrafo.

E dois defeitos de língua na mesma leva: "Na lane comercial" (vocabulário
interno do pipeline vazando para texto público) e "se o titular morrer ou fica
inválido" (concordância verbal).

POR QUE CORRIGIR PARA FRENTE. As páginas já estão no ar. A política de
publicar-e-corrigir (CLAUDE.md 2026-08-06) manda corrigir no estoque canônico,
nunca despublicar nem descartar texto redigido. O texto anterior das seis
páginas está preservado em
`.agents/runtime/backup-paginas-20260812-correcao-juridica/`.

CONTRATO DE ESCRITA (idêntico ao de generate-v2-citation-attribution-repair-20260807,
que é o caminho sancionado para correção pontual de trecho): lease de época,
lock exclusivo próprio, CAS pelo sha256 da LINHA viva, CAS por TRECHO
(exatamente uma ocorrência), demais linhas preservadas byte a byte, word_count
recalculado pela fórmula do ingest, forma de serialização da linha preservada,
escrita atômica com fsync, idempotente. NÃO commita e NÃO republica.

Uso:
    tools/generate-v2-atribuicao-dispositivo-repair-20260812 --dry-run
    tools/generate-v2-atribuicao-dispositivo-repair-20260812
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.atribuicao-dispositivo-repair-20260812.lock"
DADOS = Path(__file__).with_suffix(".data.json")
PAGES = ROOT / "data/editorial/v2_pages"

# O texto novo não pode afirmar mais do que a fonte primária sustenta, nem
# prometer resultado (Provimento OAB 205/2021).
TEXTOS_PROIBIDOS = (
    "jurisprudência pacífica", "entendimento pacificado", "com certeza",
    "sempre ganha", "garantimos", "asseguramos o êxito", "êxito garantido",
)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go.

    Soma opening, heading e text de cada seção, q e a de cada FAQ. Declarar sem
    recalcular derruba a página no ingest (declared_word_count_incoherent).
    """
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def dump_como_a_linha(record: dict, linha_viva: str) -> str:
    """Reemite o registro na MESMA forma de serialização da linha viva.

    O acervo mistura a forma padrão e a compacta. Descobrir a forma pelo
    round-trip do registro ORIGINAL (não do corrigido) e reusá-la mantém a
    diferença de bytes restrita ao texto que realmente mudou.
    """
    original = json.loads(linha_viva)
    for separadores in ((", ", ": "), (",", ":")):
        if json.dumps(original, ensure_ascii=False,
                      separators=separadores) == linha_viva:
            return json.dumps(record, ensure_ascii=False,
                              separators=separadores)
    # Forma não reconhecida: emite na padrão e avisa, porque a linha vai mudar
    # em mais bytes do que a correção exige.
    print(f"  aviso: forma de serialização não reconhecida em "
          f"{record.get('intent_id')}; reemitindo na forma padrão",
          file=sys.stderr)
    return json.dumps(record, ensure_ascii=False)


def _campos(record: dict):
    """Percorre todo texto visível do registro como (get, set)."""
    yield ("opening",
           lambda: record.get("opening") or "",
           lambda v: record.__setitem__("opening", v))
    for indice, section in enumerate(record.get("sections") or []):
        for chave in ("heading", "text"):
            yield (f"sections[{indice}].{chave}",
                   (lambda s=section, k=chave: s.get(k) or ""),
                   (lambda v, s=section, k=chave: s.__setitem__(k, v)))
    for indice, item in enumerate(record.get("faq") or []):
        for chave in ("q", "a"):
            yield (f"faq[{indice}].{chave}",
                   (lambda i=item, k=chave: i.get(k) or ""),
                   (lambda v, i=item, k=chave: i.__setitem__(k, v)))


def _contar(record: dict, trecho: str) -> int:
    return sum(ler().count(trecho) for _nome, ler, _escrever in _campos(record))


def _substituir(record: dict, antes: str, depois: str) -> str | None:
    """Aplica a substituição e devolve o nome do campo tocado."""
    for nome, ler, escrever in _campos(record):
        atual = ler()
        if antes in atual:
            escrever(atual.replace(antes, depois))
            return nome
    return None


def carregar_reparos() -> list[dict]:
    if not DADOS.is_file():
        raise SystemExit(f"arquivo de dados ausente: {DADOS}")
    with open(DADOS, encoding="utf-8") as handle:
        dados = json.load(handle)
    reparos = dados.get("correcoes")
    if not isinstance(reparos, list) or not reparos:
        raise SystemExit(f"{DADOS.name}: 'correcoes' vazio ou ausente")
    return reparos


def indexar_shards() -> dict[str, str]:
    """intent_id -> shard, lido do acervo vivo.

    O shard vem do disco, nunca do arquivo de dados: se um agente errar o
    caminho, a correção iria para o lugar errado ou não seria encontrada.
    """
    onde: dict[str, str] = {}
    for shard in sorted(PAGES.glob("*.jsonl")):
        for linha in shard.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            intent = json.loads(linha).get("intent_id")
            if intent:
                onde[intent] = os.path.relpath(shard, ROOT)
    return onde


def preflight(reparos: list[dict], onde: dict[str, str]) -> dict[str, list[dict]]:
    problemas: list[str] = []
    por_shard: dict[str, list[dict]] = {}
    vistos: set[tuple[str, str]] = set()
    for reparo in reparos:
        intent = reparo.get("intent_id") or ""
        antes = reparo.get("old") or ""
        depois = reparo.get("new") or ""
        rotulo = f"{intent}/{reparo.get('campo', '?')}"
        if not intent:
            problemas.append("correção sem intent_id")
            continue
        if intent not in onde:
            problemas.append(f"{rotulo}: intent não existe no acervo vivo")
            continue
        if not antes or not depois:
            problemas.append(f"{rotulo}: trecho vazio")
        if antes == depois:
            problemas.append(f"{rotulo}: texto novo idêntico ao atual")
        if not reparo.get("dispositivo"):
            problemas.append(f"{rotulo}: sem dispositivo nomeado")
        if not reparo.get("porque"):
            problemas.append(f"{rotulo}: sem razão declarada")
        chave = (intent, antes)
        if chave in vistos:
            problemas.append(f"{rotulo}: trecho repetido no arquivo de dados")
        vistos.add(chave)
        for proibido in TEXTOS_PROIBIDOS:
            if proibido in depois.lower():
                problemas.append(
                    f"{rotulo}: texto novo afirma mais do que se conferiu "
                    f"({proibido!r})")
        por_shard.setdefault(onde[intent], []).append(reparo)
    if problemas:
        for problema in problemas:
            print(f"PREFLIGHT FALHOU: {problema}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(reparos)} correção(ões) em "
          f"{len({r['intent_id'] for r in reparos})} página(s), "
          f"{len(por_shard)} shard(s); toda correção nomeia dispositivo e razão")
    return por_shard


def aplicar(shard_rel: str, reparos: list[dict], dry_run: bool) -> tuple[int, int]:
    path = ROOT / shard_rel
    bruto = path.read_bytes().decode("utf-8")
    linhas = bruto.split("\n")
    fim_com_newline = bool(linhas) and linhas[-1] == ""
    if fim_com_newline:
        linhas = linhas[:-1]

    por_intent: dict[str, list[dict]] = {}
    for reparo in reparos:
        por_intent.setdefault(reparo["intent_id"], []).append(reparo)

    saida: list[str] = []
    alterados = 0
    ja_feitos = 0
    for numero, raw in enumerate(linhas, 1):
        if not raw.strip():
            raise SystemExit(f"{shard_rel}: linha em branco {numero}")
        intent = json.loads(raw).get("intent_id")
        if intent not in por_intent:
            saida.append(raw)
            continue

        registro = json.loads(raw)
        digest_antes = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        aplicadas = 0
        pulos = 0
        for reparo in por_intent[intent]:
            antes, depois = reparo["old"], reparo["new"]
            if _contar(registro, depois) >= 1 and _contar(registro, antes) == 0:
                pulos += 1
                continue
            ocorrencias = _contar(registro, antes)
            if ocorrencias != 1:
                raise SystemExit(
                    f"CAS DE TRECHO FALHOU em {shard_rel}:{numero} ({intent}): "
                    f"o trecho de {reparo.get('dispositivo', '?')} aparece "
                    f"{ocorrencias} vez(es), esperado exatamente 1. "
                    f"Reler o conteúdo vivo antes de reaplicar.")
            campo = _substituir(registro, antes, depois)
            if campo is None:
                raise SystemExit(
                    f"{shard_rel}:{numero} ({intent}): substituição não aplicada")
            declarado = reparo.get("campo")
            if declarado and declarado != campo:
                print(f"  aviso: {intent} — trecho estava em {campo}, "
                      f"o dado dizia {declarado}", file=sys.stderr)
            aplicadas += 1
            print(f"  {intent}: {campo} <- {reparo.get('dispositivo')}")

        if not aplicadas:
            ja_feitos += pulos
            saida.append(raw)
            continue

        antes_wc = registro.get("word_count")
        registro["word_count"] = word_count(registro)
        nova = dump_como_a_linha(registro, raw)
        atual = hashlib.sha256(
            path.read_bytes().decode("utf-8").split("\n")[numero - 1]
            .strip().encode("utf-8")).hexdigest()
        if atual != digest_antes:
            raise SystemExit(
                f"CAS DE LINHA FALHOU em {shard_rel}:{numero} ({intent}): "
                f"outra frente tocou este registro durante a execução.")
        saida.append(nova)
        alterados += 1
        ja_feitos += pulos
        print(f"    -> {aplicadas} correção(ões), "
              f"word_count {antes_wc} -> {registro['word_count']}")

    if alterados and not dry_run:
        payload = "\n".join(saida) + ("\n" if fim_com_newline else "")
        atomic_write(path, payload.encode("utf-8"))
    return alterados, ja_feitos


def escrever_evidencia(reparos: list[dict], onde: dict[str, str]) -> None:
    """Materializa a evidência auditável em data/, uma linha por correção.

    O arquivo é reescrito por inteiro, de forma determinística e ordenada, para
    que reexecutar o gerador não duplique registro nem mude bytes à toa. Cada
    linha carrega o dispositivo, a razão, o par old/new literal, a URL oficial
    consultada, a data da consulta e o sha256 do documento baixado — quem quiser
    conferir refaz o download e compara o hash.
    """
    destino = ROOT / "data/editorial/v2_dispositivo_repair_evidence_20260812.jsonl"
    linhas: list[str] = []
    for reparo in sorted(reparos, key=lambda r: (r["intent_id"], r.get("campo", ""))):
        fonte = reparo.get("fonte_conferida_hoje") or {}
        registro = {
            "gerador": Path(__file__).name,
            "gerado_em": "2026-08-12",
            "intent_id": reparo["intent_id"],
            "shard": onde.get(reparo["intent_id"], ""),
            "campo": reparo.get("campo", ""),
            "dispositivo": reparo.get("dispositivo", ""),
            "porque": reparo.get("porque", ""),
            "trecho_anterior": reparo.get("old", ""),
            "trecho_corrigido": reparo.get("new", ""),
            "fonte_oficial_url": fonte.get("url", ""),
            "fonte_consultada_em": fonte.get("data", ""),
            "fonte_http_status": fonte.get("http_status"),
            "fonte_sha256_documento": fonte.get("sha256_documento", ""),
            "fonte_texto_literal": fonte.get("literal", ""),
            "texto_anterior_preservado_em":
                ".agents/runtime/backup-paginas-20260812-correcao-juridica/",
        }
        linhas.append(json.dumps(registro, ensure_ascii=False))
    atomic_write(destino, ("\n".join(linhas) + "\n").encode("utf-8"))
    print(f"evidência: {len(linhas)} registro(s) em "
          f"{os.path.relpath(destino, ROOT)}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    reparos = carregar_reparos()
    onde = indexar_shards()
    por_shard = preflight(reparos, onde)

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                total_alterados = 0
                total_ja = 0
                for shard in sorted(por_shard):
                    print(f"\n{shard}")
                    alterados, ja = aplicar(shard, por_shard[shard], args.dry_run)
                    total_alterados += alterados
                    total_ja += ja
                if not args.dry_run:
                    escrever_evidencia(reparos, onde)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if args.dry_run:
        print(f"\n--dry-run: {total_alterados} página(s) alterável(is), "
              f"{total_ja} correção(ões) já aplicada(s). Nada escrito.")
        return 0
    print(f"\n{total_alterados} página(s) corrigida(s), "
          f"{total_ja} correção(ões) já estava(m) aplicada(s).")
    if total_alterados:
        print("Reingerir o estoque e republicar para o espelho refletir a correção.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
