#!/usr/bin/env python3
"""generate-retorno-por-rota — a metrica que o mandato AI-first (§1) manda olhar:
RETORNO POR AGENTE nas portas de maquina, por dia, a partir do evento unificado
(data/ops/eventos/eventos-*.jsonl, agregado por dia x path). Nao le log bruto.

Uma linha por (dia, familia de rota): requisicoes, agentes de IA, a contagem
por agente (as chaves de por_agente do evento; "humano_ou_nao_identificado"
inclui scanners de MCP e a propria sonda quando ela nao veio marcada) e, desde
2026-09-08, por cliente OAuth identificado (client_id do Bearer valido, gravado
pelo ledger do Go em qualquer rota) — identidade declarada, sem User-Agent. As
familias sao fechadas e nomeadas aqui — /mcp, /api/v1/lote, /api/v1/novidades,
/api/v1/outros, /changes.json, /feed, gemea.md, /llms*.txt, descritores, /a2a,
html (o resto, so para a razao maquina/humano) — porque contar "tudo que nao e
HTML" esconde qual porta um agente usou.

Idempotente: reescreve data/ops/retorno_por_rota_daily.jsonl inteiro a cada
execucao (fonte e o evento unificado, que ja e cumulativo), em ordem estavel;
mesma entrada = mesmos bytes fora de gerado_em. Zero e um numero: dia sem
requisicao na familia entra com 0, para a serie nao ter buraco que pareca falta
de coleta.
"""
import argparse, collections, glob, json, os, sys, time

SCHEMA = "retorno_por_rota_daily_v1"
FAMILIAS = ["/mcp", "/api/v1/lote", "/api/v1/novidades", "/api/v1/outros", "/changes.json", "/feed",
            "gemea.md", "/llms*.txt", "descritores", "/a2a", "html"]


def familia(path):
    p = path or ""
    if p.startswith("/mcp"):
        return "/mcp"
    if p.startswith("/api/v1/lote"):
        return "/api/v1/lote"
    if p.startswith("/api/v1/novidades"):
        return "/api/v1/novidades"
    if p.startswith("/api/v1/"):
        return "/api/v1/outros"
    if p == "/changes.json":
        return "/changes.json"
    if p.startswith("/feed"):
        return "/feed"
    if p.endswith(".md"):
        return "gemea.md"
    if p.startswith("/llms"):
        return "/llms*.txt"
    if p.startswith("/.well-known") or p.startswith("/openapi"):
        return "descritores"
    if p.startswith("/a2a"):
        return "/a2a"
    return "html"


def agrega(linhas):
    """linhas: iteravel de dicts do evento unificado. Devolve lista ordenada de
    registros (dia, familia)."""
    por = collections.defaultdict(lambda: {"requisicoes": 0, "agentes_de_ia": 0, "por_agente": collections.Counter(),
                                           "por_cliente_oauth": collections.Counter(), "paths": 0})
    dias = set()
    for e in linhas:
        d = e.get("date")
        if not d or "requisicoes" not in e:
            continue
        dias.add(d)
        r = por[(d, familia(e.get("path")))]
        r["requisicoes"] += int(e.get("requisicoes") or 0)
        r["agentes_de_ia"] += int(e.get("agentes_de_ia") or 0)
        r["paths"] += 1
        for a, n in (e.get("por_agente") or {}).items():
            r["por_agente"][a] += int(n or 0)
        for c, n in (e.get("por_cliente_oauth") or {}).items():
            r["por_cliente_oauth"][c] += int(n or 0)
    saida = []
    for d in sorted(dias):
        total = sum(por[(d, f)]["requisicoes"] for f in FAMILIAS)
        for f in FAMILIAS:
            r = por[(d, f)]
            saida.append({
                "schema_version": SCHEMA, "date": d, "familia": f, "requisicoes": r["requisicoes"],
                "agentes_de_ia": r["agentes_de_ia"], "paths_distintos": r["paths"],
                "pct_do_dia": round(100.0 * r["requisicoes"] / total, 2) if total else 0.0,
                "por_agente": dict(sorted(r["por_agente"].items(), key=lambda kv: (-kv[1], kv[0]))[:12]),
                "por_cliente_oauth": dict(sorted(r["por_cliente_oauth"].items(), key=lambda kv: (-kv[1], kv[0]))[:12]),
                "clientes_identificados": len(r["por_cliente_oauth"]),
            })
    return saida


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    ap.add_argument("--root", default=".")
    ap.add_argument("--eventos", default="data/ops/eventos")
    ap.add_argument("--saida", default="data/ops/retorno_por_rota_daily.jsonl")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    root = os.path.abspath(args.root)
    t0 = time.time()

    def linhas():
        for f in sorted(glob.glob(os.path.join(root, args.eventos, "eventos-*.jsonl"))):
            with open(f, encoding="utf-8") as fh:
                for l in fh:
                    if l.strip():
                        yield json.loads(l)

    registros = agrega(linhas())
    gerado_em = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    ultimo = [r for r in registros if r["date"] == registros[-1]["date"]] if registros else []
    resumo = {r["familia"]: r["requisicoes"] for r in ultimo}
    print("retorno-por-rota: %d linhas, %d dias, ultimo dia %s: %s, %.2fs" % (
        len(registros), len({r["date"] for r in registros}), ultimo[0]["date"] if ultimo else "-",
        json.dumps(resumo, ensure_ascii=False), time.time() - t0))
    if args.dry_run:
        return 0
    destino = os.path.join(root, args.saida)
    tmp = destino + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        for r in registros:
            f.write(json.dumps(dict(r, gerado_em=gerado_em), ensure_ascii=False, sort_keys=True) + "\n")
    os.replace(tmp, destino)
    return 0


if __name__ == "__main__":
    sys.exit(main())
