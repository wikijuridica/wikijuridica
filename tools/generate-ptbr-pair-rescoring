#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_RAPIDFUZZ_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/rapidfuzz-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-rapidfuzz-venv"
if [[ -n "${WIKI_RAPIDFUZZ_VENV:-}" ]]; then
	VENV="$WIKI_RAPIDFUZZ_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
if [[ ! -x "$PY" ]]; then
	python3 -m venv "$VENV"
fi
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-rapidfuzz.txt" | awk '{print $1}')"
MARKER="$VENV/.requirements-rapidfuzz-$REQ_HASH.ok"
if [[ ! -f "$MARKER" ]]; then
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 "$PY" -m pip install --disable-pip-version-check --prefer-binary -r "$ROOT/tools/requirements-rapidfuzz.txt"
	rm -f "$VENV"/.requirements-rapidfuzz-*.ok
	touch "$MARKER"
fi
export WIKI_RAPIDFUZZ_PYTHON="$PY"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:ptbr-pair-rescoring:data/ops/ptbr_pair_rescoring_evidence.jsonl}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-30000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-items_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-ptbr pair rescoring evidence written or validation failure}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/ptbr_pair_rescoring_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-ptbr-pair-rescoring}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-blocked_rapidfuzz_pair_rescoring_jsonl_no_publication}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-ptbr-pair-rescoring --timings "$@"
