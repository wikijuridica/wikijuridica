#!/usr/bin/env bash
# tools/datajud-fila — ESCREVE (não é read-only).
#
# Opera a fila do DataJud: semeia pedidos a partir do que o advogado já
# acompanha no DJEN, consulta o CNJ FORA do caminho do usuário e grava a série
# de latência percebida. A prosa completa está no cabeçalho de
# cmd/datajud-fila/main.go.
#
# ★ O NÚMERO QUE EXIGE A FILA, medido em 2026-09-04 contra a API real:
#
#   took                          = 28.289 ms   (28 s DO LADO DO CNJ)
#   dataHoraUltimaAtualizacao     = 2026-07-24  (42 dias de atraso)
#   nivelSigilo                   = 0           (a API entrega o nível de sigilo)
#
# Vinte e oito segundos por processo. Qualquer tela que consulte o DataJud
# durante a renderização está quebrada por construção — daí a ordem do plano:
# fila, cache e limitador ANTES de destravar a coleta.
#
# ★ RITMO: 120 req/min é a cláusula 3.13 do termo de uso do CNJ, aplicada por
# `internal/datajudfila` com rate.Limiter (2 req/s, rajada 1) e
# `sony/gobreaker/v2` na frente da rede. Não há bandeira para afrouxar isso.
#
# ★ CHAVE PÚBLICA, não credencial nova: a APIKey é publicada pelo próprio CNJ
# no documento oficial de acesso. Entra por --chave ou $DATAJUD_API_KEY.
#
#   ./tools/datajud-fila --semear-do-djen                          # ensaio
#   ./tools/datajud-fila --semear-do-djen --amostra 20             # probe por passo
#   ./tools/datajud-fila --semear-do-djen --aplicar                # enfileira
#   ./tools/datajud-fila --processar 25 --aplicar                  # worker (precisa da chave)
#   ./tools/datajud-fila --listar conta-alfa --aplicar             # o que aquela conta pediu
#
# ★ ENSAIO É O PADRÃO e não cria o banco: criar o arquivo já seria escrever.
#
# ★ ONDE O DADO MORA: var/datajud/ — nunca var/on-demand-cache, que o deploy
# apaga com rm -rf. Aqui dentro há pedido em aberto do advogado, que não se
# refaz, e resposta do CNJ, que custa 28 s para refazer.
#
# ★ O TETO DE 1800 s É DO PRÓPRIO run-go-cmd-cached ("shard/cache/optimize
# instead of increasing the timeout"), e por isso o --tempo-limite do comando
# fica em 25 min: uma passada que não cabe aí se reparte em rodadas com
# --processar, e não em prazo maior.
#
# ★ O ENVELOPE. O throughput declarado (2 registros/s) é o teto da fonte: a
# cláusula 3.13 dá 2 req/s, e nenhuma passada honesta pode prometer mais que
# isso quando o trabalho é consultar o CNJ. A semeadura sozinha é muito mais
# rápida (não toca a rede) e o número real sai na linha TIMING.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-datajud:fila:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-1740000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=2}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_queue_state_reported}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/datajud_latencia_percebida.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/datajud-fila}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/datajud_latencia_percebida.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-1800}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/datajud-fila --timings "$@"
