#!/bin/bash
# check-tmux-activity-clock — qual campo do tmux serve de relógio de atividade?
#
# A pergunta decide se um reaper de sessão abandonada mata trabalho. O
# `ai-session-reaper` nasceu usando `session_activity` com a hipótese de que o
# pane de um processo ativo repinta e isso renova o campo. A crítica adversarial
# afirmou o contrário: `session_activity` mediria interação de CLIENTE, e numa
# sessão detached — a população-alvo inteira — ficaria congelado no instante do
# detach, transformando a carência num cronômetro de execução.
#
# Este teste decide por medição, não por leitura de documentação: sobe uma sessão
# detached produzindo output contínuo e compara os dois campos ao longo do tempo.
#
# Read-only sobre o estado do dono: cria sessão própria com prefixo `clockprobe-`
# (fora do escopo `ai-*` de qualquer reaper) e a remove ao sair.

set -uo pipefail
S="clockprobe-$$"
JANELA="${1:-40}" # segundos de observação

limpar() { tmux kill-session -t "$S" 2>/dev/null; }
trap limpar EXIT INT TERM

campo() { tmux display-message -p -t "$S" "$1" 2>/dev/null; }

tmux new-session -d -s "$S" -x 100 -y 30 \
	'while true; do echo "tick $(date +%s)"; sleep 1; done' 2>/dev/null || {
	echo "não foi possível criar a sessão de teste"
	exit 2
}
command sleep 2

echo "sessão de teste: $S (detached, imprimindo uma linha por segundo)"
echo

sa0=$(campo '#{session_activity}')
wa0=$(campo '#{window_activity}')
t0=$(date +%s)
printf '  t=%2ss  session_activity=%s  window_activity=%s\n' 0 "$sa0" "$wa0"

for _ in $(seq 1 "$((JANELA / 10))"); do
	command sleep 10
	sa=$(campo '#{session_activity}')
	wa=$(campo '#{window_activity}')
	printf '  t=%2ss  session_activity=%s (Δ%s)  window_activity=%s (Δ%s)\n' \
		"$(($(date +%s) - t0))" "$sa" "$((sa - sa0))" "$wa" "$((wa - wa0))"
done

sa=$(campo '#{session_activity}')
wa=$(campo '#{window_activity}')
dsa=$((sa - sa0))
dwa=$((wa - wa0))
dt=$(($(date +%s) - t0))

echo
echo "após ${dt}s de output contínuo numa sessão DETACHED:"
echo "  session_activity avançou ${dsa}s"
echo "  window_activity  avançou ${dwa}s"
echo
falhou=0
if [ "$dsa" -lt $((dt / 2)) ]; then
	echo "  VEREDITO: session_activity NÃO acompanha output — não serve de relógio"
	echo "            para sessão detached. Usá-lo faz a carência virar cronômetro"
	echo "            contado a partir do detach, matando trabalho em andamento."
	falhou=1
else
	echo "  VEREDITO: session_activity acompanha o output."
fi
if [ "$dwa" -ge $((dt / 2)) ]; then
	echo "  window_activity acompanha o output — é o relógio correto."
else
	echo "  ATENÇÃO: window_activity também não acompanha; nenhum dos dois serve."
	falhou=1
fi
exit "$falhou"
