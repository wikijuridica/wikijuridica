#!/usr/bin/env python3
"""check-lastmod-causalidade-selftest — prova que o gate de causalidade do
lastmod distingue re-datacao LEGITIMA de data FABRICADA, e reprova se confundir
as duas.

Read-only: nao escreve nada. Importa `tools/check-lastmod-causalidade` e
exercita o MESMO `_parse_ledger` que o gate usa em producao -- reimplementar a
leitura aqui provaria a copia, nao o detector.

POR QUE ESTE ARQUIVO EXISTE. Ate 2026-08-27 o parser lia so `content_sha256`, e
o invariante 1 concluia "data fabricada" para toda rota cuja data avancasse sem
que o TEXTO mudasse. Mas o gerador re-data por `served_sha256` de proposito, e
diz isso por escrito (generate-page-content-revision:569-584): o servido e a
chave que enxerga JSON-LD, og:image e credencial estruturada -- conteudo para a
maquina que nao aparece em campo autoral nenhum.

As duas ferramentas discordavam entre si, e a primeira mudanca a disparar a
divergencia foi o preenchimento de `same_as` em content/site.json: o JSON-LD da
home muda, o texto nao, e o gate acusaria FRAUDE DE SINAL numa re-datacao
correta. Corrigir sem prova viraria a suspeita oposta -- a de que o gate foi
afrouxado para deixar passar. As tres propriedades abaixo separam as duas
leituras.

  A. RE-DATACAO LEGITIMA PELO SERVIDO. Texto identico, servido diferente, data
     nova: e o caso da home ao ganhar um perfil no sameAs. Tem de passar.

  B. O DEFEITO REAL CONTINUA PEGO. Nenhum dos dois hashes mudou e a data andou:
     e frescor fabricado, que e a razao de o gate existir. Tem de reprovar.

  C. LEDGER ANTERIOR AO CAMPO. Sem `served_sha256` nas duas pontas, o veredito
     precisa ser o mesmo de antes -- a correcao nao pode virar anistia
     retroativa para linha antiga do ledger.
"""

import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

GATE = Path(__file__).resolve().parent / "check-lastmod-causalidade"


def carrega_gate():
    """Importa o gate sem executar o main() dele."""
    loader = importlib.machinery.SourceFileLoader("gate_lastmod", str(GATE))
    modulo = importlib.util.module_from_spec(importlib.util.spec_from_loader("gate_lastmod", loader))
    argv = sys.argv
    sys.argv = ["gate_lastmod"]
    try:
        loader.exec_module(modulo)
    except SystemExit:
        pass
    finally:
        sys.argv = argv
    return modulo


def ledger(**campos) -> bytes:
    return json.dumps(campos).encode("utf-8")


def re_datacao_legitima(gate, antes: bytes, depois: bytes, rota: str) -> bool:
    """Espelha a decisao do invariante 1: algum hash mudou = causa legitima."""
    texto_a, servido_a, _ = gate._parse_ledger(antes)[rota]
    texto_d, servido_d, _ = gate._parse_ledger(depois)[rota]
    return texto_a != texto_d or servido_a != servido_d


def main() -> int:
    gate = carrega_gate()
    falhas = []

    # A. servido mudou (JSON-LD ganhou sameAs), texto intacto.
    if not re_datacao_legitima(
        gate,
        ledger(path="/", content_sha256="AAA", served_sha256="S1", revised_on="2026-08-20"),
        ledger(path="/", content_sha256="AAA", served_sha256="S2", revised_on="2026-08-27"),
        "/",
    ):
        falhas.append(
            "A: mudanca no served_sha256 foi lida como data fabricada -- o gate "
            "acusaria fraude numa re-datacao que o gerador faz por desenho"
        )

    # B. nada mudou e a data andou: o defeito que o gate existe para pegar.
    if re_datacao_legitima(
        gate,
        ledger(path="/x/", content_sha256="BBB", served_sha256="S9", revised_on="2026-08-20"),
        ledger(path="/x/", content_sha256="BBB", served_sha256="S9", revised_on="2026-08-27"),
        "/x/",
    ):
        falhas.append(
            "B: data avancou com os DOIS hashes iguais e o gate aceitou -- "
            "frescor fabricado deixaria de ser detectado"
        )

    # C. ledger anterior ao campo served: veredito preservado.
    if re_datacao_legitima(
        gate,
        ledger(path="/y/", content_sha256="CCC", revised_on="2026-08-20"),
        ledger(path="/y/", content_sha256="CCC", revised_on="2026-08-27"),
        "/y/",
    ):
        falhas.append(
            "C: linha de ledger SEM served_sha256 passou a ser aceita -- a "
            "correcao virou anistia retroativa"
        )

    # D. a tupla tem de ter exatamente 3 campos: quem desempacotar com 2 quebra
    #    em runtime, que foi como o invariante 2 caiu ao ganhar o campo novo.
    registros = gate._parse_ledger(ledger(path="/z/", content_sha256="D", served_sha256="E", revised_on="2026-08-27"))
    if len(registros["/z/"]) != 3:
        falhas.append(f"D: _parse_ledger devolveu tupla de {len(registros['/z/'])} campos, esperados 3")

    print("== selfteste da causalidade do lastmod ==")
    if falhas:
        for falha in falhas:
            print(f"  REPROVADO {falha}")
        print(f"\nREPROVADO: {len(falhas)} propriedade(s) do gate caiu(ram).")
        return 1
    print("  A re-datacao pelo servido           LEGITIMA")
    print("  B data sem causa nenhuma            FABRICADA (segue pega)")
    print("  C ledger anterior ao campo served   veredito preservado")
    print("  D forma da tupla                    3 campos")
    print("\nAPROVADO: o gate separa re-datacao legitima de frescor fabricado.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
