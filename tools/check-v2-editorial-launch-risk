_GRAPHEME = _regex.compile(r"\X") if _regex else None


def grapheme_count(value: str) -> int:
    """Réplica de ptbrdisplaybudget.CharacterCount (uniseg.GraphemeClusterCount)."""
    if _GRAPHEME is None:
        return len(unicodedata.normalize("NFC", value))
    return len(_GRAPHEME.findall(value))


def rune_count(value: str) -> int:
    """Réplica de utf8.RuneCountInString usada por v2ingest/validate.go:597."""
    return len(value)


_MN = "Mn"


def fold(value: str) -> str:
    """Réplica de ptbrtext.FoldTokenForCompare: NFC -> lower -> NFD -> drop Mn."""
    value = unicodedata.normalize("NFC", value.strip()).lower()
    decomposed = unicodedata.normalize("NFD", value)
    return "".join(ch for ch in decomposed if unicodedata.category(ch) != _MN)


_TOKEN_SPLIT = re.compile(r"[^0-9a-z]+")


def words(value: str) -> list[str]:
    """Réplica de v2ingest.normalizedWords."""
    return [t for t in _TOKEN_SPLIT.split(fold(value)) if t]


def body_word_count(page: dict) -> int:
    """Réplica de v2ingest.bodyWordCount (validate.go:962-973)."""
    total = len(words(page.get("opening") or ""))
    for section in page.get("sections") or []:
        total += len(words(section.get("heading") or ""))
        total += len(words(section.get("text") or ""))
    for item in page.get("faq") or []:
        total += len(words(item.get("q") or ""))
        total += len(words(item.get("a") or ""))
    return total


def public_text(page: dict) -> str:
    """Todo o texto que o leitor/Googlebot enxerga."""
    parts = [
        page.get("title") or "",
        page.get("meta_description") or "",
        page.get("h1") or "",
        page.get("opening") or "",
    ]
    for section in page.get("sections") or []:
        parts.append(section.get("heading") or "")
        parts.append(section.get("text") or "")
    for item in page.get("faq") or []:
        parts.append(item.get("q") or "")
        parts.append(item.get("a") or "")
    return "\n".join(parts)


