    v2ingest (validate.go:584-596): scenario_id e context_id vazios."""
    seed = seed_term_id(intent_id)
    if not seed or not practice_area:
        return ""
    return "/" + slug(practice_area) + "/" + slug(seed) + "/"


def query_key(value: str) -> str:
    return " ".join(words(value))


def query_tokens(value: str) -> frozenset:
    # Token numérico NUNCA é descartado por tamanho: "súmula 12" vs "súmula 13"
    # e "art 25" vs "art 26" só se distinguem pelo número, e a primeira versão
    # deste filtro (len > 2) apagava exatamente esse discriminador, gerando
    # Jaccard 1.0 entre páginas distintas.
    return frozenset(t for t in words(value)
                     if t not in STOPWORDS and (len(t) > 2 or t.isdigit()))


def analyse(worst: int) -> dict:
    portfolio = load_portfolio()
    findings = defaultdict(list)
    counts = Counter()
    totals = Counter()
    wc_histogram = Counter()
    verified_years = Counter()
    status_counts = Counter()
    citation_pairs = Counter()
    query_index = defaultdict(list)      # chave normalizada -> [intent_id]
    title_index = defaultdict(list)
    path_index = defaultdict(list)       # path público canônico -> [intent_id]
    token_index = defaultdict(list)      # (area) -> [(intent, tokens, query)]

    for name in sorted(os.listdir(PAGES_DIR)):
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(PAGES_DIR, name)
        rel = os.path.join("data/editorial/v2_pages", name)
        with open(path, encoding="utf-8") as handle:
            for lineno, line in enumerate(handle, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    page = json.loads(line)
                except json.JSONDecodeError:
                    counts["json_invalid"] += 1
                    findings["json_invalid"].append(
                        {"file": rel, "line": lineno, "intent_id": "?"})
                    continue
                totals["records"] += 1
                if page.get("skipped"):
                    totals["tombstones"] += 1
                    continue
                intent = page.get("intent_id") or ""
                record = portfolio.get(intent)
                if record is None:
                    totals["sem_join_portfolio"] += 1
                    counts["sem_join_portfolio"] += 1
                    findings["sem_join_portfolio"].append(
                        {"file": rel, "line": lineno, "intent_id": intent})
                    continue
                totals["ativas"] += 1
                where = {"file": rel, "line": lineno, "intent_id": intent}

                title = (page.get("title") or "").strip()
                meta = (page.get("meta_description") or "").strip()
                h1 = (page.get("h1") or "").strip()

                t_graph, t_rune = grapheme_count(title), rune_count(title)
                m_graph, m_rune = grapheme_count(meta), rune_count(meta)
                if t_graph < TITLE_MIN or t_graph > TITLE_MAX:
                    counts["title_len"] += 1
                    findings["title_len"].append(
                        dict(where, graphemes=t_graph, runes=t_rune, title=title))
                if m_graph < META_MIN or m_graph > META_MAX:
                    counts["meta_len"] += 1
                    findings["meta_len"].append(
                        dict(where, graphemes=m_graph, runes=m_rune, meta=meta[:90]))
                if t_graph != t_rune or m_graph != m_rune:
                    counts["grapheme_rune_divergence"] += 1
                    findings["grapheme_rune_divergence"].append(
                        dict(where, title_graphemes=t_graph, title_runes=t_rune,
                             meta_graphemes=m_graph, meta_runes=m_rune))
                if h1 and h1 == title:
                    counts["h1_equals_title"] += 1
                    findings["h1_equals_title"].append(dict(where, title=title))

                page_type = page.get("page_type") or record.get("page_type") or ""
                actual = body_word_count(page)
                declared = int(page.get("word_count") or 0)
                wc_histogram[min(actual // 100 * 100, 2000)] += 1
                band = WORD_BANDS.get(page_type)
                if band:
                    lo, hi = band[0] * 9 // 10, band[1] * 11 // 10
                    if actual < lo:
                        counts["thin"] += 1
                        findings["thin"].append(
                            dict(where, page_type=page_type, words=actual,
                                 min_allowed=lo))
                    elif actual > hi:
                        counts["verbose"] += 1
                        findings["verbose"].append(
                            dict(where, page_type=page_type, words=actual,
                                 max_allowed=hi))
                else:
                    counts["page_type_sem_banda"] += 1
                if declared <= 0:
                    counts["wc_missing"] += 1
                    findings["wc_missing"].append(dict(where, declared=declared))
                elif actual > 0 and abs(declared - actual) * 10 > actual:
                    counts["wc_drift"] += 1
                    findings["wc_drift"].append(
                        dict(where, declared=declared, actual=actual))

                text = public_text(page)
                for code, pattern in OAB_PATTERNS:
                    hit = first_unexculpated(text, pattern)
                    if hit is None:
                        continue
                    counts["oab_" + code] += 1
                    findings["oab_" + code].append(dict(where, frase=hit))
                for code, pattern in OAB_WATCH:
                    if pattern.search(text):
                        counts[code] += 1
                for code, pattern in VOCAB_PATTERNS:
                    match = pattern.search(text)
                    if match:
                        counts["vocab_" + code] += 1
                        findings["vocab_" + code].append(
                            dict(where, trecho=context(text, match)))
                # Lista sancionada de vocabulário interno (validate.go:96-104),
                # aplicada sobre os MESMOS tokens foldados do gate Go.
                leaked = sorted(set(words(text)) & FORBIDDEN_INTERNAL_TOKENS)
                if leaked:
                    counts["vocab_interno_sancionado"] += 1
                    findings["vocab_interno_sancionado"].append(
                        dict(where, tokens=leaked))
                    confirmed = [t for t in leaked
                                 if not LEGITIMATE_LEGAL_DRAFT.search(text)
                                 or t not in ("rascunho", "rascunhos")]
                    if confirmed:
                        counts["vocab_interno_confirmado"] += 1
                        findings["vocab_interno_confirmado"].append(
                            dict(where, tokens=confirmed))

                if MOJIBAKE_RE.search(text):
                    counts["mojibake"] += 1
                    findings["mojibake"].append(
                        dict(where, trecho=context(text, MOJIBAKE_RE.search(text))))
                if HTML_ENTITY_RE.search(text):
                    counts["html_entity"] += 1
                    findings["html_entity"].append(
                        dict(where, trecho=context(text, HTML_ENTITY_RE.search(text))))
                if unicodedata.normalize("NFC", text) != text:
                    counts["nfd_text"] += 1
                    findings["nfd_text"].append(dict(where))

                wage = STALE_WAGE_RE.search(text)
                if wage and WAGE_CONTEXT_RE.search(text):
                    counts["stale_min_wage"] += 1
                    findings["stale_min_wage"].append(
                        dict(where, valor=wage.group(1), trecho=context(text, wage)))

                for match in CITATION_RE.finditer(text):
                    article = int(match.group(1))
                    norm = normalize_norm(match.group(2))
                    if not norm:
                        continue
                    citation_pairs[(norm, article)] += 1
                    limit = NORM_LAST_ARTICLE.get(norm)
                    if limit and article > limit:
                        counts["citation_range"] += 1
                        findings["citation_range"].append(
                            dict(where, norma=norm, artigo=article,
                                 ultimo_artigo_real=limit,
                                 trecho=context(text, match)))

                sources = page.get("official_sources") or []
                if not sources:
                    counts["sem_fonte"] += 1
                    findings["sem_fonte"].append(dict(where))
                page_sem_prova = False
                for source in sources:
                    status = source.get("http_status")
                    status_counts[str(status)] += 1
                    if status is not None and status != 200:
                        counts["fonte_http_nao_200"] += 1
                        findings["fonte_http_nao_200"].append(
                            dict(where, url=source.get("url", "")[:120], status=status))
                    verified = str(source.get("verified_at") or "")[:4]
                    if verified.isdigit():
                        verified_years[verified] += 1
                    if status is None or not verified.isdigit():
                        page_sem_prova = True
                    host = host_of(source.get("url") or "")
                    if host and host not in ALLOWED_HOST_EXACT and not any(
                            host.endswith(s) for s in ALLOWED_HOST_SUFFIXES):
                        counts["fonte_host_fora_allowlist"] += 1
                        findings["fonte_host_fora_allowlist"].append(
                            dict(where, host=host))
                if sources and page_sem_prova:
                    counts["fonte_sem_prova_de_verificacao"] += 1
                    findings["fonte_sem_prova_de_verificacao"].append(
                        dict(where, fontes=len(sources)))
                if page.get("needs_source_research"):
                    counts["needs_source_research"] += 1
                    findings["needs_source_research"].append(dict(where))

                if not (page.get("internal_link_topics") or []):
                    counts["sem_internal_link_topics"] += 1
                    findings["sem_internal_link_topics"].append(dict(where))

                query = record.get("long_tail_query") or ""
                area = record.get("practice_area") or ""

                path = public_page_path(area, intent)
                if not path:
                    counts["public_path_inderivavel"] += 1
                    findings["public_path_inderivavel"].append(dict(where))
                else:
                    path_index[path].append((intent, rel, lineno))
                if query:
                    query_index[query_key(query)].append((intent, rel, lineno, area))
                    token_index[area].append((intent, query_tokens(query), query, rel, lineno))
                if title:
                    title_index[query_key(title)].append((intent, rel, lineno))

    # --- colisão de URL pública -------------------------------------------
    # Duas páginas ativas que derivam o MESMO path só podem existir como uma
    # URL: a segunda sobrescreve ou derruba a transação. Hoje esse defeito faz
    # o diagnóstico canônico tools/check-v2-internal-link-graph abortar antes
    # de contar órfãs.
    for path, group in path_index.items():
        if len(group) > 1:
            counts["colisao_public_path"] += len(group)
            findings["colisao_public_path"].append(
                {"public_path": path,
                 "paginas": [{"intent_id": i, "file": f, "line": l} for i, f, l in group]})

    # --- canibalização -----------------------------------------------------
    for key, group in query_index.items():
        if len(group) > 1:
            counts["cannibal_query_exata"] += len(group)
            findings["cannibal_query_exata"].append(
                {"long_tail_query_normalizada": key,
                 "paginas": [{"intent_id": i, "file": f, "line": l} for i, f, l, _ in group]})
    for key, group in title_index.items():
        if len(group) > 1:
            counts["cannibal_title_exato"] += len(group)
            findings["cannibal_title_exato"].append(
                {"title_normalizado": key,
                 "paginas": [{"intent_id": i, "file": f, "line": l} for i, f, l in group]})

    for area, entries in token_index.items():
        by_token = defaultdict(list)
        for index, (intent, tokens, query, rel, lineno) in enumerate(entries):
            for token in tokens:
                by_token[token].append(index)
        seen_pairs = set()
        for token, indexes in by_token.items():
            if len(indexes) > 120:      # token genérico da área: não discrimina
                continue
            for position, left in enumerate(indexes):
                for right in indexes[position + 1:]:
                    pair = (left, right)
                    if pair in seen_pairs:
                        continue
                    seen_pairs.add(pair)
                    a_tokens, b_tokens = entries[left][1], entries[right][1]
                    if not a_tokens or not b_tokens:
                        continue
                    inter = len(a_tokens & b_tokens)
                    union = len(a_tokens | b_tokens)
                    jaccard = inter / union if union else 0.0
                    if jaccard >= 0.75 and query_key(entries[left][2]) != query_key(entries[right][2]):
                        counts["cannibal_query_jaccard"] += 1
                        findings["cannibal_query_jaccard"].append({
                            "practice_area": area,
                            "jaccard": round(jaccard, 3),
                            "a": {"intent_id": entries[left][0], "query": entries[left][2],
                                  "file": entries[left][3], "line": entries[left][4]},
                            "b": {"intent_id": entries[right][0], "query": entries[right][2],
                                  "file": entries[right][3], "line": entries[right][4]},
                        })

    for key in findings:
        findings[key] = findings[key][:worst]

    return {
        "denominador": dict(totals),
        "contagem_por_defeito": dict(sorted(counts.items(), key=lambda kv: -kv[1])),
        "distribuicao_palavras_corpo": dict(sorted(wc_histogram.items())),
        "fonte_verified_at_por_ano": dict(sorted(verified_years.items())),
        "fonte_http_status": dict(sorted(status_counts.items(),
                                         key=lambda kv: -kv[1])),
        "citacoes_norma_artigo_distintas": len(citation_pairs),
        "citacoes_mais_frequentes": [
            {"norma": n, "artigo": a, "ocorrencias": c}
            for (n, a), c in citation_pairs.most_common(15)],
        "piores_casos": {k: v for k, v in findings.items() if v},
    }


def normalize_norm(raw: str) -> str:
    folded = " ".join(fold(raw).split())
    folded = re.sub(r"\bn[o°º]?\s*", "", folded).strip()
    if folded in NORM_ALIASES:
        return NORM_ALIASES[folded]
    match = re.match(r"lei\s+([\d.]+)", folded)
    if match:
        number = match.group(1).rstrip(".")
        if "." not in number and len(number) > 3:
            number = number[:-3] + "." + number[-3:]
        return "lei " + number
    return folded if folded in NORM_LAST_ARTICLE else ""


def host_of(url: str) -> str:
    match = re.match(r"https?://([^/]+)", url)
    return match.group(1).lower() if match else ""


_SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+|\n+")


def first_unexculpated(text: str, pattern: re.Pattern) -> str | None:
    """Devolve a primeira FRASE em que o padrão casa sem sinal de negação,
    ressalva, citação ou atribuição a terceiro. None quando todos os casamentos
    do texto são prosa técnica correta."""
    for sentence in _SENTENCE_SPLIT.split(text):
        match = pattern.search(sentence)
        if not match:
            continue
        if OAB_EXCULPATORY.search(sentence):
            continue
        if QUOTED.search(sentence[:match.start()]):
            continue
        return " ".join(sentence.split())[:300]
    return None


def context(text: str, match: re.Match, span: int = 70) -> str:
    start = max(0, match.start() - span)
    end = min(len(text), match.end() + span)
    return " ".join(text[start:end].split())


def veredito(report: dict) -> tuple[bool, dict]:
    """(aprovado, criticos_encontrados) a partir do relatório de analyse().
    Função pura e isolada para o teste de falso-positivo poder chamá-la sem
    duplicar o corte critério-a-critério."""
    defeitos = report["contagem_por_defeito"]
    criticos = {code: defeitos[code] for code in CRITICAL_CLASSES
                if defeitos.get(code, 0) > 0}
    return not criticos, criticos


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true", help="relatório completo em JSON")
    parser.add_argument("--worst", type=int, default=12,
                        help="quantos piores casos guardar por classe (default 12)")
    args = parser.parse_args()

    report = analyse(args.worst)
    aprovado, criticos = veredito(report)
    report["veredito"] = {
        "aprovado": aprovado,
        "classes_criticas_monitoradas": list(CRITICAL_CLASSES),
        "criticos_encontrados": criticos,
    }

    if args.json:
        json.dump(report, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return 0 if aprovado else 1

    totals = report["denominador"]
    print("estoque v2 — risco editorial pré-indexação")
    print(f"  registros lidos ........ {totals.get('records', 0)}")
    print(f"  tombstones (skipped) ... {totals.get('tombstones', 0)}")
    print(f"  ativas com join ........ {totals.get('ativas', 0)}")
    print(f"  ativas sem join ........ {totals.get('sem_join_portfolio', 0)}")
    print()
    print("defeitos (páginas afetadas):")
    for code, value in report["contagem_por_defeito"].items():
        marca = " <<< CRÍTICO" if code in criticos else ""
        print(f"  {code:32s} {value}{marca}")
    print()
    print("distribuição de palavras do corpo (faixa de 100):")
    for bucket, value in report["distribuicao_palavras_corpo"].items():
        print(f"  {bucket:5d}+ {'#' * min(60, value // 40)} {value}")
    print()
    if aprovado:
        print("VEREDITO: aprovado — nenhuma classe crítica com ocorrência > 0.")
    else:
        print("VEREDITO: REPROVADO — classes críticas com ocorrência:")
        for code, value in criticos.items():
            print(f"  {code:32s} {value}")
    return 0 if aprovado else 1


if __name__ == "__main__":
    sys.exit(main())
