def load_portfolio() -> dict:
    portfolio = {}
    for name in sorted(os.listdir(PORTFOLIO_DIR)):
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(PORTFOLIO_DIR, name)
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                intent = record.get("intent_id")
                if intent:
                    portfolio[intent] = record
    return portfolio


def slug(*parts: str) -> str:
    """Réplica de publicpath.Slug (publicpath.go:25-37): só [a-z0-9], '-' entre
    tokens. NÃO remove acento — 'ç' e 'ã' viram separador, igual ao Go."""
    tokens = []
    for part in parts:
        token = ""
        for char in part.lower():
            if ("a" <= char <= "z") or ("0" <= char <= "9"):
                token += char
            elif token:
                tokens.append(token)
                token = ""
        if token:
            tokens.append(token)
    return "-".join(tokens)


def seed_term_id(intent_id: str) -> str:
    """Réplica de v2ingest.seedTermIDFromIntentID (validate.go:766-772)."""
    separator = intent_id.find("-")
    if separator <= 0 or separator == len(intent_id) - 1:
        return ""
    return intent_id[separator + 1:]


