#!/usr/bin/env bash
# check-ingress-fontes-completas — o deploy vigia TODOS os arquivos do ingress?
#
# O DEFEITO QUE ISTO FECHA, medido em producao em 2026-08-29.
#
# `tools/deploy-publico` decide recarregar o nginx comparando o sha256 das
# "fontes do ingress" com a impressao do deploy anterior. A lista dessas fontes
# era escrita a mao e continha UM arquivo: ops/nginx/wikijuridica.conf.
#
# A CSP nao mora nele. Ela mora em ops/nginx/security-headers.conf, que entra por
# `include` -- e a config que a unit realmente carrega e ops/nginx/standalone/
# nginx.conf, que tambem nao estava na lista. Resultado: mudar o hash da CSP nao
# mudava a impressao, o deploy concluia "ingress intacto" e NAO recarregava o
# nginx. O acervo saiu com o script novo e o header vivo continuou autorizando o
# hash antigo: o navegador recusou o script inline em TODA pagina, em silencio --
# sem erro no log, sem 500, com o HTML perfeito. Quarenta minutos assim, e a
# purga que veio depois cacheou a combinacao morta na borda por sete dias.
#
# "Silencioso" e o adjetivo que importa: nenhum gate de disponibilidade acusa,
# porque nada esta fora do ar. So a medicao morre, e painel vazio e
# indistinguivel de "nao ha visitantes".
#
# A CORRECAO E A LISTA ESTAR COMPLETA, e este check e quem cobra: ele resolve os
# `include` de verdade, a partir da config que a unit carrega, e compara com o
# que o deploy declara vigiar. Lista manual envelhece; conferencia automatica,
# nao.
#
# Uso: ./tools/check-ingress-fontes-completas
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

CONF_RAIZ="${WIKI_NGINX_CONF:-/opt/wiki/ops/nginx/standalone/nginx.conf}"
DEPLOY="${WIKI_DEPLOY_SCRIPT:-tools/deploy-publico}"

if [[ ! -f $CONF_RAIZ ]]; then
	echo "REPROVADO: config raiz do ingress nao existe: $CONF_RAIZ" >&2
	exit 1
fi

# Resolve os `include` recursivamente, e SO os que apontam para dentro do repo:
# /etc/nginx/mime.types e do sistema, nao e artefato deste deploy e nao muda com
# ele. `include` com glob nao e expandido de proposito -- hoje nao existe nenhum,
# e adivinhar o glob errado daria falso verde.
declare -A vistos=()
pendentes=("$CONF_RAIZ")
while [[ ${#pendentes[@]} -gt 0 ]]; do
	atual="${pendentes[0]}"
	pendentes=("${pendentes[@]:1}")
	[[ -n ${vistos[$atual]:-} ]] && continue
	[[ -f $atual ]] || continue
	vistos[$atual]=1
	while read -r incluido; do
		case "$incluido" in
		/opt/wiki/*) pendentes+=("$incluido") ;;
		*) : ;; # fora do repo: do sistema, nao do deploy
		esac
	done < <(grep -oE '^\s*include\s+\S+;' "$atual" | sed -E 's/^\s*include\s+//; s/;$//')
done

# O que o deploy declara vigiar.
declarado="$(grep -oE 'NGINX_CONF_FONTES="\$\{WIKI_NGINX_CONF_FONTES:-[^}]*\}"' "$DEPLOY" |
	sed -E 's/.*:-//; s/\}"$//')"
if [[ -z $declarado ]]; then
	echo "REPROVADO: nao achei NGINX_CONF_FONTES em $DEPLOY" >&2
	exit 1
fi

faltando=()
for arquivo in "${!vistos[@]}"; do
	relativo="${arquivo#/opt/wiki/}"
	encontrado=0
	for decl in $declarado; do
		[[ "${decl#/opt/wiki/}" == "$relativo" ]] && encontrado=1 && break
	done
	[[ $encontrado -eq 0 ]] && faltando+=("$relativo")
done

if [[ ${#faltando[@]} -eq 0 ]]; then
	echo "OK: o deploy vigia os $((${#vistos[@]})) arquivo(s) de config do ingress"
	for arquivo in "${!vistos[@]}"; do echo "  ${arquivo#/opt/wiki/}"; done | sort
	exit 0
fi

echo "REPROVADO: o deploy NAO vigia $((${#faltando[@]})) arquivo(s) que o ingress carrega:" >&2
printf '  %s\n' "${faltando[@]}" >&2
echo "" >&2
echo "  Consequencia: mudanca nesses arquivos nao dispara reload do nginx. Se for" >&2
echo "  a CSP, o navegador recusa o script inline em toda pagina EM SILENCIO." >&2
echo "  Remedio: acrescente-os a NGINX_CONF_FONTES em $DEPLOY." >&2
exit 1
