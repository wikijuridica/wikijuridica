#!/usr/bin/env python3
"""hook-block-tmp-product-write — avisa quando um agente escreve produto em /tmp.

Hook PreToolUse do Claude Code. NÃO BLOQUEIA: apenas devolve um aviso ao modelo
e ao operador quando o destino da escrita é um diretório volátil e a extensão
carrega trabalho estruturado.

Por que avisar e não bloquear (decisão do dono, 2026-08-04): o Claude Code tem
plan mode e fluxos read-only em que escrever em /tmp é legítimo — o próprio
harness aponta um scratchpad lá. Um bloqueio literal inviabilizaria esses
fluxos, e o objetivo real nunca foi proibir /tmp: é NÃO PERDER TRABALHO.

A garantia de não perder vem em duas camadas, ambas fora do caminho crítico:
  1. este aviso, que lembra o agente de gravar o que é produto dentro do repo;
  2. `tools/generate-tmp-product-rescue`, que COPIA para
     `.agents/runtime/tmp_rescue/<AAAAMMDD>/` tudo que ficou em /tmp — rodado ao
     fim do turno pelo hook Stop, de modo que mesmo o que for esquecido
     sobrevive ao próximo boot.

O risco é real: /usr/lib/tmpfiles.d/tmp.conf declara `D /tmp 1777 root root -`,
e o `D` faz o systemd apagar TODO o conteúdo de /tmp a cada boot. Em 2026-07-28
isso quase custou 115 páginas redigidas (39.950 palavras), salvas no commit
63f0b56b.

Contrato: sempre sai com 0 (nunca trava a ferramenta). Quando há aviso, escreve
em stdout o JSON de hook com `additionalContext` (lido pelo modelo) e
`systemMessage` (mostrado ao operador).
"""

from __future__ import annotations

import json
import pathlib
import sys

VOLATILE_PREFIXES = ("/tmp/", "/var/tmp/", "/dev/shm/")

# Extensões que carregam trabalho: perder uma dessas custa tokens e horas.
PRODUCT_SUFFIXES = (".jsonl", ".json", ".md", ".py", ".go", ".sh", ".html", ".mdx", ".yaml", ".yml")

WRITE_TOOLS = ("Write", "Edit", "NotebookEdit", "MultiEdit")

AVISO = (
    "Escrita de produto em diretório volátil: {destino}\n"
    "O systemd apaga TODO o conteúdo de /tmp a cada boot (`D /tmp` em "
    "/usr/lib/tmpfiles.d/tmp.conf) — em 2026-07-28 isso quase custou 115 páginas "
    "redigidas.\n"
    "Se este arquivo for produto (página, dado editorial, pesquisa, evidência, "
    "ferramenta), grave-o no repositório em vez de /tmp:\n"
    "  dado/página      -> /opt/wiki/data/...\n"
    "  rascunho/staging -> /opt/wiki/.agents/runtime/scratch/ ou .../staging/\n"
    "  ferramenta       -> /opt/wiki/tools/\n"
    "e commite por pathspec na mesma sessão. Se for scratch descartável de "
    "análise (plan mode, leitura), pode seguir em /tmp: o hook Stop roda "
    "tools/generate-tmp-product-rescue e copia o que sobrar para "
    ".agents/runtime/tmp_rescue/, então nada se perde no próximo boot."
)


def destino_da_chamada(payload: dict) -> str:
    tool_input = payload.get("tool_input") or {}
    for chave in ("file_path", "notebook_path", "path"):
        valor = tool_input.get(chave)
        if isinstance(valor, str) and valor:
            return valor
    return ""


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except (ValueError, OSError):
        # Payload ilegível não é motivo para atrapalhar o trabalho do agente.
        return 0

    if payload.get("tool_name") not in WRITE_TOOLS:
        return 0

    destino = destino_da_chamada(payload)
    if not destino:
        return 0
    try:
        resolvido = str(pathlib.Path(destino).expanduser())
    except (OSError, RuntimeError):
        resolvido = destino
    if not resolvido.startswith(VOLATILE_PREFIXES):
        return 0
    if pathlib.PurePath(resolvido).suffix.lower() not in PRODUCT_SUFFIXES:
        return 0

    texto = AVISO.format(destino=resolvido)
    json.dump({
        "systemMessage": f"Aviso: produto em diretório volátil ({resolvido}) — resgate automático ativo.",
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "additionalContext": texto,
        },
    }, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
