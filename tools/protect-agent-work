#!/usr/bin/env bash
# protect-agent-work — versiona o produto que agentes deixaram untracked.
#
# Por que existe: em 2026-08-06 uma varredura achou 61% dos vereditos de
# auditoria (2.466 intent_ids, semanas de trabalho pago) existindo apenas
# como arquivos soltos em .agents/runtime/, e 18 artefatos de dados que
# haviam sumido da worktree — entre eles o indice de release gate sem o
# qual o servidor nao sobe. Untracked nao e backup: uma limpeza de
# working tree apaga tudo, e agente de IA que le `git status` trata
# untracked como ruido e ignora trabalho importante.
#
# O que faz: classifica cada caminho untracked em PRODUTO (versiona) ou
# EFEMERO (ignora), e commita o produto em lote. Read-only por padrao;
# so escreve com --commit.
#
# Uso:
#   tools/protect-agent-work              # relatorio, nao escreve nada
#   tools/protect-agent-work --commit     # versiona o produto encontrado
#   tools/protect-agent-work --max-mb 20  # pula arquivo maior que 20 MB

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

COMMIT=0
MAX_MB=60
while [ $# -gt 0 ]; do
	case "$1" in
	--commit)
		COMMIT=1
		shift
		;;
	--max-mb)
		MAX_MB="$2"
		shift 2
		;;
	-h | --help)
		sed -n '2,20p' "$0"
		exit 0
		;;
	*)
		echo "opcao desconhecida: $1" >&2
		exit 2
		;;
	esac
done
MAX_BYTES=$((MAX_MB * 1024 * 1024))

# Efemero: reproduzivel em segundos, ou lock/cache que o sistema regenera.
# Tudo que nao casar aqui e tratado como produto — na duvida, versiona.
is_ephemeral() {
	case "$1" in
	*.lock | *.pid | *.sock | *.partial.jsonl | *.tmp | *.swp | *~) return 0 ;;
	tools/_tmp_* | */_tmp_* | */node_modules/* | */.cache/*) return 0 ;;
	.release-staging/* | var/on-demand-cache/* | public/*) return 0 ;;
	*.test | *.o | *.a) return 0 ;;
	*.stale-resume-* | *.stale-v1-*) return 0 ;;
	esac
	return 1
}

produto=()
efemero=0
grande=0
bytes_produto=0

while IFS= read -r path; do
	[ -n "$path" ] || continue
	# Expande diretorio untracked nos arquivos que contem.
	if [ -d "$path" ]; then
		mapfile -t files < <(find "$path" -type f 2>/dev/null)
	else
		files=("$path")
	fi
	for f in "${files[@]}"; do
		[ -f "$f" ] || continue
		if is_ephemeral "$f"; then
			efemero=$((efemero + 1))
			continue
		fi
		sz=$(stat -c%s "$f" 2>/dev/null || echo 0)
		if [ "$sz" -gt "$MAX_BYTES" ]; then
			grande=$((grande + 1))
			printf '  GRANDE (%s MB, pulado): %s\n' "$((sz / 1048576))" "$f"
			continue
		fi
		produto+=("$f")
		bytes_produto=$((bytes_produto + sz))
	done
done < <(git status --porcelain | awk '/^\?\?/ {print substr($0,4)}')

echo "=== protect-agent-work ==="
printf 'produto untracked : %d arquivos (%.1f MB)\n' "${#produto[@]}" "$(echo "$bytes_produto" | awk '{print $1/1048576}')"
printf 'efemero ignorado  : %d arquivos\n' "$efemero"
printf 'grande (>%s MB)   : %d arquivos — versione a mao se for produto\n' "$MAX_MB" "$grande"

if [ "${#produto[@]}" -eq 0 ]; then
	echo "nada a proteger."
	exit 0
fi

echo
echo "--- por diretorio ---"
printf '%s\n' "${produto[@]}" | sed 's|/[^/]*$||' | sort | uniq -c | sort -rn | head -15

if [ "$COMMIT" -eq 0 ]; then
	echo
	echo "relatorio apenas. rode com --commit para versionar."
	exit 0
fi

# Commit em lotes: pathspec gigante estoura o limite de argumentos.
printf '%s\0' "${produto[@]}" | xargs -0 -n 400 git add -- || exit 1
staged=$(git diff --cached --name-only | wc -l)
if [ "$staged" -eq 0 ]; then
	echo "nada ficou staged (tudo ja ignorado pelo .gitignore?)"
	exit 0
fi

git commit -q -m "protect(agentes): versiona $staged arquivos de produto untracked

Varredura automatica de tools/protect-agent-work: produto de agente que
estava fora do controle de versao e sobreviveria apenas ate a proxima
limpeza da working tree." || exit 1
# SEM trailer de co-autoria de modelo desde 2026-09-23: o CLAUDE.md fixa que
# "nenhum commit leva co-autoria de modelo", e .githooks/commit-msg reprova a
# linha `Co-Authored-By: Claude ...` — com ela, o `|| exit 1` acima dispararia.

echo "protegidos $staged arquivos em $(git log -1 --format=%h)."
