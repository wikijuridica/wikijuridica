#!/usr/bin/env bash
# Regenera a cadeia de tres camadas do inventario de URLs de fonte oficial na
# UNICA ordem em que ela fecha sem quebrar a que vem depois.
#
# POR QUE ISTO EXISTE (2026-09-05)
# ================================
# `internal/officialsourceurlliveevidence.GenerateAt` exige IGUALDADE EXATA
# entre `manifest.run_date` (gravado em
# data/source-registry/official_source_url_inventory_manifest.json) e a data
# UTC de hoje (evidence.go:244). Nenhum job existente avancava esse campo: o
# timer `wikijuridica-source-evidence-recheck` so reescreve `checked_at` de
# registros com TTL vencido, e nunca tocava o inventario nem o manifesto. Em
# 2026-09-05 o manifesto datava de 30/08 e
# `TestOfficialSourceURLLiveEvidenceStaysBlockedMetadataOnly` reprovava todo
# dia com `official_source_url_live_evidence_inventory_run_date_mismatch`.
#
# A causa raiz nao e o teste nem o gate: e a AUSENCIA de um produtor diario
# para `cmd/generate-official-source-url-inventory`. Relaxar a igualdade do
# `GenerateAt` seria afrouxar contrato de dado real (a igualdade existe para
# que o inventario nunca fique "quase fresco"); o conserto e dar a ele o job
# que falta.
#
# A CADEIA TEM TRES ELOS, NUNCA UM SO
# ====================================
# O inventario (`official_source_url_inventory.jsonl` +
# `_manifest.json`) e regenerado com `run_date` de hoje. Isso muda
# `official_source_url_inventory_payload_sha256` de TODO registro, porque o
# hash do payload inclui `run_date` (ver `inventoryRecordPayloadSHA256` em
# internal/officialsourceurlliveevidence/inventory.go). Os registros de
# tentativa de metadado (`official_source_url_live_metadata_attempts.jsonl`)
# guardam esse mesmo hash para provar que casam com UM inventario especifico
# — regenerar so o inventario e parar aqui reprovaria em cascata com
# `official_source_url_live_evidence_metadata_attempt_inventory_fingerprint_mismatch`
# em cada um dos milhares de registros.
#
# Por isso o segundo passo usa
# `sourceliveevidence.GeneratePreservingStoredLiveAttemptsAt`: ele recalcula
# os campos de identidade/fingerprint contra o inventario NOVO e preserva
# byte a byte a MEDICAO ja feita (status HTTP, content-type, etc.) de cada
# tentativa — nao dispara nenhuma requisicao de rede. So o terceiro passo
# agrega os dois em `official_source_url_live_evidence.jsonl`.
#
# Rodar so um dos tres, ou fora desta ordem, quebra o proximo elo. Medido em
# 2026-09-05 sob load average 23 (maquina disputada por outras sessoes):
#
#   generate-official-source-url-inventory              47.4s
#   generate-official-source-url-live-metadata-attempts  75.3s
#   generate-official-source-url-live-evidence           17.9s
#   total                                               140.6s
#
# Nenhum dos tres faz rede (grep por net/http, http.Get, http.Do no
# cmd/generate-official-source-url-inventory devolve vazio) — sao
# deterministicos sobre o que ja esta em disco.
set -euo pipefail
cd /opt/wiki || exit 2

echo "1/3 official-source-url-inventory"
./tools/go-modern run -tags devcmds ./cmd/generate-official-source-url-inventory

echo "2/3 official-source-url-live-metadata-attempts (preservando medicao armazenada, sem rede)"
./tools/go-modern run -tags devcmds ./cmd/generate-official-source-url-live-metadata-attempts

echo "3/3 official-source-url-live-evidence"
./tools/go-modern run -tags devcmds ./cmd/generate-official-source-url-live-evidence

echo "official-source-url-inventory-refresh: cadeia completa, run_date atualizado"
