#!/usr/bin/env python3
"""check-graph-authority — o acervo publicado nao pode regredir em autoridade.

READ-ONLY. Roda `cmd/measure-graph-authority` (render offline, nunca escreve em
public/) e compara o resultado com o piso medido e commitado em
`data/ops/graph_authority_floor.json`.

POR QUE EXISTE. Ate 2026-08-26 o unico gate de dado estruturado do repositorio
validava 360 registros de uma camada de ENSAIO e nunca abria o acervo: 10.070
nos Article no ar nao passavam por gate nenhum. Foi assim que passaram, sem
ninguem ver, (a) 10.070 paginas sem a credencial do responsavel tecnico no
grafo, (b) um mesmo @id de Person com dois nomes diferentes, (c) 17.050 links
inline apontando a lei inteira e (d) 128 links para uma URL oficial que
responde 404.

O piso NAO e um numero inventado: e a medicao do dia em que cada correcao
entrou. Subir o piso e trabalho; descer e regressao, e o gate reprova.

Uso:
    tools/check-graph-authority
    tools/check-graph-authority --json
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PISO = ROOT / "data/ops/graph_authority_floor.json"

# Metrica -> sentido. "min" = nao pode cair; "max" = nao pode subir.
SENTIDO = {
    "artigos": "min",
    "autor_com_job_title": "min",
    "autor_com_has_credential": "min",
    "autor_com_id": "min",
    "links_inline_com_fragmento": "min",
    "artigos_com_mentions": "min",
    "artigos_citam_lei_sem_no_legislation": "max",
    "paginas_acima_50kb": "max",
    "paginas_que_anunciam_atualizacao_falsa": "max",
    "maior_pagina_bytes": "max",
}


def mede() -> dict:
    saida = subprocess.run(
        ["./tools/go-modern", "run", "./cmd/measure-graph-authority"],
        cwd=ROOT, capture_output=True, text=True)
    if saida.returncode != 0:
        print(saida.stderr.strip() or "measure-graph-authority falhou", file=sys.stderr)
        raise SystemExit(2)
    return json.loads(saida.stdout)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if not PISO.exists():
        print(f"piso ausente: {os.path.relpath(PISO, ROOT)}", file=sys.stderr)
        return 2
    piso = json.loads(PISO.read_text(encoding="utf-8"))
    atual = mede()

    falhas = []
    linhas = []
    for metrica, sentido in SENTIDO.items():
        if metrica not in piso.get("metricas", {}):
            continue
        esperado = piso["metricas"][metrica]
        obtido = atual.get(metrica)
        if obtido is None:
            falhas.append(f"{metrica}: ausente do relatorio")
            continue
        ruim = obtido < esperado if sentido == "min" else obtido > esperado
        linhas.append((metrica, sentido, esperado, obtido, ruim))
        if ruim:
            falhas.append(f"{metrica}: piso {esperado}, medido {obtido} ({sentido})")

    duplicados = atual.get("person_id_com_mais_de_um_nome") or {}
    if duplicados:
        falhas.append(f"@id de Person com mais de um nome: {duplicados}")

    if args.json:
        print(json.dumps({"piso": piso, "medido": atual, "falhas": falhas},
                         ensure_ascii=False, indent=1))
    else:
        for metrica, sentido, esperado, obtido, ruim in linhas:
            marca = "FALHA" if ruim else "ok   "
            print(f"{marca} {metrica:45s} piso({sentido})={esperado:<10} medido={obtido}")
        print(f"{'FALHA' if duplicados else 'ok   '} person_id_com_mais_de_um_nome"
              f"{'':<21} piso(max)=0          medido={len(duplicados)}")

    if falhas:
        print("\nREPROVADO:", file=sys.stderr)
        for falha in falhas:
            print(f"  - {falha}", file=sys.stderr)
        return 1
    print("\naprovado: nenhuma metrica de autoridade do grafo regrediu")
    return 0


if __name__ == "__main__":
    sys.exit(main())
