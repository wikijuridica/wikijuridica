#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""generate-v2-glossario-adcorpus-adjudication-20260805.

Adjudica a UNICA colisao viva de h1 entre as 9.620 paginas do estoque canonico
v2, apontada pelo gate `check-v2-cross-shard-collision`:

  h1 "Venda ad corpus e ad mensuram: quando a metragem do imóvel importa"
     glossario-w3-06.jsonl : gloss-venda-ad-corpus-ad-mensuram
     glossario-w3-07.jsonl : gloss-imob-venda-ad-corpus-mensuram

## Decisao editorial: DIFERENCIAR (rota b), nao consolidar

As duas paginas foram lidas inteiras (title, meta, h1, opening, secoes, fontes).
Nao sao a mesma pagina com dois ids — sao dois angulos distintos que herdaram o
mesmo h1 do gerador de corpo:

  06 (gloss-venda-ad-corpus-ad-mensuram) e o VERBETE DOUTRINARIO do instituto:
     as duas formas de ajuste de preco, as tres saidas do art. 500 do CC, a
     tolerancia de um vinte avos, o prazo decadencial de um ano do art. 501
     contado do registro (com o deslocamento do paragrafo unico) e a retificacao
     de registro do art. 213 da Lei 6.015/1973. Exemplos rurais, por hectare.

  07 (gloss-imob-venda-ad-corpus-mensuram) e a pagina APLICADA a quem comprou:
     parte da clausula ad corpus usada como escudo pelo vendedor, ensina o que
     medir e comparar (matricula, escritura, memorial, levantamento por
     profissional habilitado), separa area privativa de area comum em unidade
     de condominio e traz a vinculacao da oferta pelo art. 30 do CDC quando o
     vendedor e incorporadora. Exemplo urbano, apartamento.

Nenhuma das duas absorve a outra sem perda: tombstonar 06 apagaria o prazo do
art. 501 e a retificacao registral; tombstonar 07 apagaria o CDC e a leitura de
area privativa. Title e meta de cada uma JA estao no seu proprio angulo — o h1
de 07 e o unico campo fora de lugar, e e nele que a intervencao se limita.

## Escopo minimo

Reescreve APENAS o campo `h1` de gloss-imob-venda-ad-corpus-mensuram, ancorando-o
no que so essa pagina diz (a clausula nao e escudo). Corpo intocado: por isso o
`word_count` declarado NAO e recalculado nem regravado — e apenas CONFERIDO
contra a formula do ingest (`bodyWordCount`), abortando se divergir da tolerancia
de 10%. Gerador de h1 que mexe em contagem de corpo esconde mudanca de corpo.

## Por que gerador datado, e nao edicao manual

Contrato do repo: JSONL editorial so muda por gerador. Mesmo padrao de
`generate-v2-oab-phrase-repair-20260805` e `generate-v2-title-length-repair-20260804`:
lease de epoca do estoque, lock exclusivo, CAS pelo sha256 da LINHA atual (aborta
se outra frente tocou o registro), CAS tambem por VALOR (so troca se o h1 atual
for exatamente o esperado), demais linhas preservadas byte a byte, ordem original
das chaves preservada (diff de um campo so), escrita atomica com fsync,
idempotente. NAO committa.
"""

from __future__ import annotations

from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.glossario-adcorpus-adjudication-20260805.lock"

SHARD = "data/editorial/v2_pages/glossario-w3-07.jsonl"
INTENT = "gloss-imob-venda-ad-corpus-mensuram"

# h1 final: ancorado na PROVA (matricula, memorial, medicao), que e a faceta
# exclusiva desta pagina — o title fala do problema ("o que fazer") e a meta
# fala da margem legal e da oferta. Tres facetas distintas, sem eco entre elas.
H1_AFTER = "Matrícula, memorial e medição: como provar a diferença de área"

# Estados anteriores ACEITOS, cada um com o sha256 da linha inteira naquele
# estado. Sao dois porque a adjudicacao teve duas versoes na mesma sessao: a
# primeira ("A cláusula ad corpus não é escudo...") desfazia a colisao mas
# repetia as cinco primeiras palavras da propria meta_description da pagina
# ("A cláusula ad corpus não encerra a discussão sobre metragem"), eco de molde
# que o contrato anti-template reprova. Manter os dois estados aceitos deixa o
# gerador aplicavel tanto sobre o acervo original quanto sobre a worktree ja
# tocada, sem nunca aceitar uma linha desconhecida.
ACCEPTED_PRIOR: dict[str, str] = {
    # h1 original (o que colidia com glossario-w3-06)
    "Venda ad corpus e ad mensuram: quando a metragem do imóvel importa":
        "483810f36832d5de5719ccc1572837ed4fe7ebd3ae321643f94266a96a5f8e3a",
    # h1 intermediario desta sessao
    "A cláusula ad corpus não é escudo contra a diferença de metragem":
        "0e2a5e807d7211b570089a484c3588ea9c81f595afa4e27f780c8ba6ed117b5e",
}

# h1 que fica com a pagina doutrinaria, e que o novo h1 nao pode repetir.
H1_SIBLING = "Venda ad corpus e ad mensuram: quando a metragem do imóvel importa"
SIBLING_SHARD = "data/editorial/v2_pages/glossario-w3-06.jsonl"
SIBLING_INTENT = "gloss-venda-ad-corpus-ad-mensuram"

# Palavra final que deixaria o h1 pendurado (espelha terminalFragmentWords do
# ingest, internal/v2ingest/validate.go).
TERMINAL_FRAGMENT_WORDS = {
    "ao", "aos", "até", "à", "às", "com", "da", "das", "de", "desde", "do", "dos",
    "e", "em", "entre", "mediante", "na", "nas", "no", "nos", "ou", "para",
    "pela", "pelas", "pelo", "pelos", "perante", "por", "sem", "sob", "sobre",
    "a", "o", "as", "os", "que", "se",
}

# Vocabulario interno que nunca pode vazar para campo visivel.
FORBIDDEN = ("rascunho", "cta", "seed", "release gate", "lorem", "placeholder", "template")

WORD_COUNT_TOLERANCE = 0.10


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def body_word_count(record: dict) -> int:
    """Reproduz `bodyWordCount` de internal/v2ingest/validate.go (abertura +
    heading e texto de cada secao + Q e A de cada FAQ)."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def normalize_identity(value: str) -> str:
    """Espelha normalizeIdentity de internal/v2crossshardcollision/collision.go."""
    return " ".join(value.strip().lower().split())


def live_identity_index() -> tuple[dict[str, list[str]], dict[str, list[str]]]:
    directory = ROOT / "data/editorial/v2_pages"
    h1_index: dict[str, list[str]] = {}
    title_index: dict[str, list[str]] = {}
    for path in sorted(directory.glob("*.jsonl")):
        if path.name.endswith(".partial.jsonl"):
            continue
        for raw in path.read_text(encoding="utf-8").splitlines():
            if not raw.strip():
                continue
            record = json.loads(raw)
            if record.get("skipped") or (record.get("superseded_by") or "").strip():
                continue
            member = f"{path.name}:{record.get('intent_id')}"
            h1_index.setdefault(normalize_identity(record.get("h1") or ""), []).append(member)
            title_index.setdefault(normalize_identity(record.get("title") or ""), []).append(member)
    return h1_index, title_index


def preflight() -> None:
    problems: list[str] = []

    if H1_AFTER in ACCEPTED_PRIOR:
        problems.append("h1 novo identico a um estado anterior")
    if normalize_identity(H1_AFTER) == normalize_identity(H1_SIBLING):
        problems.append("h1 novo repete o h1 da pagina irma")
    lowered = H1_AFTER.lower()
    for term in FORBIDDEN:
        if term in lowered:
            problems.append(f"h1 novo contem vocabulario interno {term!r}")
    if not (20 <= len(H1_AFTER) <= 90):
        problems.append(f"h1 novo com {len(H1_AFTER)} caracteres, fora de 20-90")
    last = re.split(r"[^0-9A-Za-zÀ-ÿ]+", H1_AFTER.strip())[-1].lower()
    if last in TERMINAL_FRAGMENT_WORDS:
        problems.append(f"h1 novo termina em conectivo pendurado ({last!r})")
    if H1_AFTER != H1_AFTER.strip() or "  " in H1_AFTER:
        problems.append("h1 novo com espacamento irregular")

    h1_index, title_index = live_identity_index()
    key = normalize_identity(H1_AFTER)
    # O proprio registro alvo nao conta como colisao: numa reexecucao ele ja
    # carrega o h1 novo, e sem esta exclusao o gerador deixaria de ser
    # idempotente (abortaria no preflight contra si mesmo).
    target = f"glossario-w3-07.jsonl:{INTENT}"
    others_h1 = [member for member in h1_index.get(key, []) if member != target]
    others_title = [member for member in title_index.get(key, []) if member != target]
    if others_h1:
        problems.append(f"h1 novo ja existe no acervo: {others_h1}")
    if others_title:
        problems.append(f"h1 novo colide com um title vivo: {others_title}")

    sibling = [m for m in h1_index.get(normalize_identity(H1_SIBLING), [])]
    expected = {
        f"glossario-w3-06.jsonl:{SIBLING_INTENT}",
        f"glossario-w3-07.jsonl:{INTENT}",
    }
    if set(sibling) not in (expected, {f"glossario-w3-06.jsonl:{SIBLING_INTENT}"}):
        problems.append(f"estado inesperado do h1 em colisao: {sibling}")

    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: h1 novo unico no acervo ({len(H1_AFTER)} chars), sem colisao com title vivo")


def apply_adjudication() -> int:
    path = ROOT / SHARD
    text = path.read_bytes().decode("utf-8")
    lines = text.split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    output: list[str] = []
    changed = 0
    already = 0
    applied_from = ""
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{SHARD}: linha em branco {number}")
        record = json.loads(raw)
        if record.get("intent_id") != INTENT:
            output.append(raw)
            continue

        if record.get("h1") == H1_AFTER:
            already += 1
            output.append(raw)
            continue

        h1_current = record.get("h1")
        if h1_current not in ACCEPTED_PRIOR:
            raise SystemExit(
                f"{SHARD}:{number} ({INTENT}): h1 atual nao e um estado aceito.\n"
                f"  aceitos: {sorted(ACCEPTED_PRIOR)}\n  atual:   {h1_current!r}"
            )
        expected_digest = ACCEPTED_PRIOR[h1_current]
        current = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        if current != expected_digest:
            raise SystemExit(
                f"CAS FALHOU em {SHARD}:{number} ({INTENT}): linha atual nao e a esperada.\n"
                f"  esperado: {expected_digest}\n  atual:    {current}\n"
                "Outra frente tocou este registro. Reler o conteudo vivo antes de reaplicar."
            )

        # Anti-eco intra-registro: o h1 nao pode abrir com as mesmas palavras do
        # title, da meta ou da abertura. Nao ha gate de ingest para isso (so
        # `h1_equals_title`), mas repetir o inicio da meta no h1 e molde visivel
        # ao leitor e na SERP — foi o defeito da primeira versao deste gerador.
        def _prefix(value: str, size: int = 4) -> str:
            return " ".join(normalize_identity(value or "").split()[:size])

        for field in ("title", "meta_description", "opening"):
            if normalize_identity(H1_AFTER) == normalize_identity(record.get(field) or ""):
                raise SystemExit(f"{INTENT}: h1 novo identico ao campo {field}")
            if _prefix(H1_AFTER) and _prefix(H1_AFTER) == _prefix(record.get(field) or ""):
                raise SystemExit(
                    f"{INTENT}: h1 novo abre com as mesmas 4 palavras de {field} "
                    f"({_prefix(H1_AFTER)!r}) — eco de molde, abortado sem escrever."
                )

        declared = record.get("word_count")
        computed = body_word_count(record)
        if not isinstance(declared, int) or declared <= 0:
            raise SystemExit(f"{SHARD}:{number} ({INTENT}): word_count declarado invalido: {declared!r}")
        if abs(declared - computed) > max(1, int(computed * WORD_COUNT_TOLERANCE)):
            raise SystemExit(
                f"{SHARD}:{number} ({INTENT}): word_count declarado={declared} "
                f"x calculado={computed} fora da tolerancia do ingest. "
                "Este gerador nao toca corpo — divergencia e defeito anterior, reportar."
            )
        print(f"  word_count conferido (corpo intocado): declarado={declared} calculado={computed}")

        applied_from = h1_current
        record["h1"] = H1_AFTER  # substituicao in-place: ordem das chaves preservada
        output.append(json.dumps(record, ensure_ascii=False))
        changed += 1

    if changed == 0 and already == 0:
        raise SystemExit(f"{SHARD}: intent {INTENT} nao encontrado")

    if changed:
        payload = "\n".join(output)
        if trailing_newline:
            payload += "\n"
        atomic_write(path, payload.encode("utf-8"))

    print(f"{SHARD} ({INTENT}): reescritos={changed} ja_aplicados={already}")
    if changed:
        print(f"  h1 antes: {applied_from}")
        print(f"  h1 agora: {H1_AFTER}")
        print(f"  {SIBLING_SHARD} ({SIBLING_INTENT}) mantem o h1 doutrinario, intocado.")
    return changed


def main() -> int:
    preflight()
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                changed = apply_adjudication()
    except StockEpochBusy as error:
        print(
            f"generate-v2-glossario-adcorpus-adjudication-20260805: estoque ocupado: {error}",
            file=sys.stderr,
        )
        return 75
    if changed:
        print("OK. Reingerir o estoque para o espelho refletir a adjudicacao.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
