#!/usr/bin/env python3
"""Mede a QUALIDADE da referência legislativa nos espelhos de acórdão do STJ.

POR QUE EXISTE. Em 2026-09-08, ao datar as normas que o corpus cita, a fonte
oficial (normas.leg.br) recusou 5 dos 37 pedidos com "sem legislationDate". A
conferência mostrou que a recusa estava CERTA e o dado bruto do STJ é que
carrega o ano errado:

  o espelho cita `LEG:FED LEI:006015 ANO:1993`, e a Lei 6.015 (Registros
  Públicos) é de 31/12/1973 — `lei:1993;6015` não existe na fonte oficial,
  `lei:1973;6015` responde 200;
  o espelho cita `LEG:FED LEI:008935 ANO:2004`, e a Lei 8.935 (Cartórios) é de
  18/11/1994.

Adivinhar o ano certo seria fabricar citação legal a partir de palpite — o §8
proíbe, e é a classe P1 sob a OAB. Então a recusa fica, contada, e vira MEDIDA DA
FONTE. Este script transforma esse subproduto numa série: quanto da referência
legislativa bruta de cada competência é aproveitável, e quanto não é porque o
próprio espelho erra.

O QUE ELE NÃO FAZ: não corrige, não adivinha, não consulta a rede. Ele cruza o
corpus já coletado com a evidência já gravada por
`tools/generate-lexml-norm-registry-20260826`. Rodar duas vezes dá o mesmo
resultado.

Saída: data/ops/stj_espelhos_qualidade_daily.jsonl (uma linha por competência).
"""

import argparse
import collections
import glob
import json
import os
import re
import sys
import time

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CORPUS = os.path.join(RAIZ, "data/corpus/jurisprudencia/stj-espelhos")
EVIDENCIA = os.path.join(RAIZ, "data/source-audit/lexml_norm_registry_20260826.jsonl")
SAIDA = os.path.join(RAIZ, "data/ops/stj_espelhos_qualidade_daily.jsonl")
SCHEMA = "stj_espelhos_qualidade_daily_v1"

# As espécies que TÊM urn:lex federal por (espécie, número, ano). O resto —
# RSN, RES, RGI, PRT, CIR, ENU, SUM — é ato interno ou enunciado, e a ausência
# de URN ali NÃO é defeito da fonte: é o modelo do LexML. Contamos à parte para
# não inflar a taxa de erro com o que nunca poderia ser datado.
ESPECIES_DATAVEIS = {
    "LEI": "lei", "LCP": "lei.complementar", "DEC": "decreto",
    "DEL": "decreto.lei", "MPR": "medida.provisoria",
}
REFERENCIA = re.compile(r"LEG:(\w{3})\s+(\w{3}):0*([\w-]+)\s+ANO:(\d{4}|\*+)")


def evidencia_por_chave():
    """chave_fallback -> (resolvida?, motivo). Chave repetida fica com a ÚLTIMA
    linha, que é a consulta mais recente (o arquivo é append-only)."""
    por_chave = {}
    if not os.path.exists(EVIDENCIA):
        return por_chave
    with open(EVIDENCIA, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            d = json.loads(linha)
            chave = d.get("chave_fallback")
            if not chave:
                continue
            por_chave[chave] = (bool(d.get("data")), d.get("motivo") or "")
    return por_chave


def competencia_do_arquivo(caminho):
    """`registros-2022-05.jsonl` -> `2022-05`."""
    nome = os.path.basename(caminho)
    achado = re.search(r"registros-(\d{4}-\d{2})\.jsonl$", nome)
    return achado.group(1) if achado else nome


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args()

    evidencia = evidencia_por_chave()
    if not evidencia:
        print("sem evidência do LexML em %s: rode primeiro "
              "tools/generate-lexml-norm-registry-20260826" % EVIDENCIA, file=sys.stderr)
        return 2

    por_competencia = collections.defaultdict(lambda: collections.Counter())
    exemplos = collections.defaultdict(list)
    for arquivo in sorted(glob.glob(os.path.join(CORPUS, "registros-*.jsonl"))):
        comp = competencia_do_arquivo(arquivo)
        contas = por_competencia[comp]
        with open(arquivo, encoding="utf-8") as f:
            for linha in f:
                d = json.loads(linha)
                contas["acordaos"] += 1
                brutas = d.get("referencias_legislativas_brutas") or []
                if d.get("dispositivos_citados_urn") or d.get("sumulas_citadas"):
                    contas["acordaos_com_referencia_estruturada"] += 1
                    continue
                if not brutas:
                    contas["acordaos_sem_referencia"] += 1
                    continue
                contas["acordaos_so_com_bruta"] += 1
                for texto in brutas:
                    contas["linhas_brutas"] += 1
                    achado = REFERENCIA.search(texto)
                    if not achado:
                        contas["linhas_sem_forma_reconhecida"] += 1
                        continue
                    esfera, especie, numero, ano = achado.groups()
                    if esfera != "FED":
                        contas["linhas_nao_federais"] += 1
                        continue
                    if especie not in ESPECIES_DATAVEIS:
                        contas["linhas_de_especie_sem_urn"] += 1
                        continue
                    if not ano.isdigit():
                        contas["linhas_sem_ano"] += 1
                        continue
                    chave = "lei-ref:%s:%s:%s" % (ESPECIES_DATAVEIS[especie], numero.lstrip("0"), ano)
                    resolvida, motivo = evidencia.get(chave, (None, ""))
                    if resolvida is None:
                        contas["linhas_nao_consultadas"] += 1
                    elif resolvida:
                        contas["linhas_datadas"] += 1
                    else:
                        # A fonte oficial NÃO conhece essa (espécie, número, ano).
                        # O ato existe com OUTRO ano — o espelho é que erra.
                        contas["linhas_recusadas_pela_fonte"] += 1
                        if len(exemplos[comp]) < 5:
                            exemplos[comp].append({"chave": chave, "motivo": motivo,
                                                   "id_fonte": d.get("id_fonte")})

    dia = time.strftime("%Y-%m-%d", time.gmtime())
    agora = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    linhas = []
    for comp in sorted(por_competencia):
        c = por_competencia[comp]
        consultadas = c["linhas_datadas"] + c["linhas_recusadas_pela_fonte"]
        linhas.append({
            "schema_version": SCHEMA, "date": dia, "competencia": comp,
            **{k: c[k] for k in sorted(c)},
            # A taxa é sobre o que foi CONSULTADO, não sobre todas as linhas
            # brutas: espécie sem URN e linha não federal nunca poderiam ser
            # datadas, e metê-las no denominador inventaria um erro que não é da
            # fonte.
            "taxa_recusa_pela_fonte": (round(c["linhas_recusadas_pela_fonte"] / consultadas, 4)
                                       if consultadas else None),
            "consultadas": consultadas,
            "exemplos_de_recusa": exemplos[comp],
            "gerado_em": agora,
        })

    largura = max((len(l["competencia"]) for l in linhas), default=12)
    print("%-*s %9s %8s %8s %9s %8s" % (largura, "competencia", "acordaos",
                                        "brutas", "datadas", "recusadas", "taxa"))
    for l in linhas:
        print("%-*s %9d %8d %8d %9d %8s" % (
            largura, l["competencia"], l["acordaos"], l.get("linhas_brutas", 0),
            l.get("linhas_datadas", 0), l.get("linhas_recusadas_pela_fonte", 0),
            l["taxa_recusa_pela_fonte"]))

    if args.dry_run:
        print("--dry-run: nada gravado", file=sys.stderr)
        return 0
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    antigas = []
    if os.path.exists(SAIDA):
        with open(SAIDA, encoding="utf-8") as f:
            antigas = [l for l in f if json.loads(l).get("date") != dia]
    tmp = SAIDA + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(antigas)
        for l in linhas:
            f.write(json.dumps(l, ensure_ascii=False, sort_keys=True) + "\n")
    os.replace(tmp, SAIDA)
    print("gravado em %s" % SAIDA)
    return 0


if __name__ == "__main__":
    sys.exit(main())
