                          (ESTADO_UMA_VEZ, "pedida_uma_vez_so"),
                          (ESTADO_REVISITADA, "pedida_e_revisitada")):
        valor = registro[chave]
        # Percentagem SEMPRE com o denominador impresso ao lado: a cobertura
        # deste portal ja "caiu" de 72,01% para 70,39% enquanto o numerador
        # SUBIA 125 URLs, so porque o denominador crescia.
        print("  %-20s %6d de %d  (%5.2f%%)"
              % (estado, valor, denominador, 100.0 * valor / denominador if denominador else 0.0))
    print()
    descobertas = registro["descobertas"]
    print("EIXO DESCOBERTA: %d de %d achadas, %d nunca pedidas"
          % (descobertas, denominador, registro["nunca_pedida"]))
    print("EIXO RETORNO   : %d de %d achadas com revisita provada%s"
          % (registro["pedida_e_revisitada"], descobertas,
             ("  (%.2f%%)" % (100.0 * registro["pedida_e_revisitada"] / descobertas))
             if descobertas else ""))
    print("   -> %s" % registro["nota_uma_vez_so"])
    print()
    print("requisicoes aceitas ........ %d (por faixa secundaria: %d)"
          % (registro["requisicoes_aceitas"], registro["requisicoes_por_faixa_secundaria"]))
    print("fora do sitemap (nao conta) . %d" % registro["requisicoes_fora_do_sitemap"])
    print("rotas so vistas na origem ... %d  (mede o quanto a borda amostrada e piso)"
          % registro["rotas_so_no_log"])
    print("contradicoes snapshot x log . %d  (snapshot diz nunca-pedida, log tem requisicao)"
          % registro["contradicoes_snapshot_vs_log"])
    if registro["descartes_por_motivo"]:
        print("descartes entre as linhas candidatas:")
        for motivo, quantidade in sorted(registro["descartes_por_motivo"].items(),
                                         key=lambda par: -par[1]):
            print("   %-26s %d" % (motivo, quantidade))
    if registro["arquivos_log_inacessiveis"]:
        print("ARQUIVOS INACESSIVEIS (nao viram zero, viram ressalva):")
        for item in registro["arquivos_log_inacessiveis"]:
            print("   %s -> %s" % (item["arquivo"], item["erro"]))
    print()
    print("cobertura_e_piso=true. %s" % registro["nota_piso"])

    if detalhe:
        print()
        alvos = [estado_filtro] if estado_filtro else list(ESTADOS)
        for estado in alvos:
            rotas = sorted(rota for rota, dados in resultado["por_rota"].items()
                           if dados["estado"] == estado)
            print("--- %s (%d) ---" % (estado, len(rotas)))
            mostradas = rotas if limite == 0 else rotas[:limite]
            for rota in mostradas:
                dados = resultado["por_rota"][rota]
                print("   %s  datas_log=%s borda=%s fonte=%s"
                      % (rota, ",".join(dados["datas_log"]) or "-",
                         dados["data_borda"] or "-", dados["fonte"]))
            if len(rotas) > len(mostradas):
                print("   ... e mais %d (use --limite 0 para todas)"
                      % (len(rotas) - len(mostradas)))


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Classifica cada URL do sitemap em NUNCA_PEDIDA / "
                    "PEDIDA_UMA_VEZ_SO / PEDIDA_E_REVISITADA pelo Googlebot verificado.")
    parser.add_argument("--root", default=ROOT_PADRAO, help="raiz do repositorio")
    parser.add_argument("--log-glob", default=LOG_GLOB, help="glob das rotacoes de log")
    parser.add_argument("--detalhe", action="store_true", help="lista as rotas por estado")
    parser.add_argument("--estado", choices=list(ESTADOS), help="filtra --detalhe por estado")
    parser.add_argument("--limite", type=int, default=40,
                        help="rotas por estado em --detalhe (0 = todas)")
    parser.add_argument("--json", action="store_true", help="imprime o registro em JSON")
    # --registrar existe, mas o CAMINHO SANCIONADO e tools/generate-veredito-por-url.
    #
    # O contrato separa os papeis: check-* nao escreve, generate-* escreve. A
    # flag fica aqui porque e onde a serie e montada, e o wrapper e quem carrega
    # o nome de quem escreve -- assim ninguem roda um `check-` esperando que ele
    # nao toque o disco e descobre o contrario depois.
    parser.add_argument("--registrar", action="store_true",
                        help="acrescenta a linha em " + SERIE)
    args = parser.parse_args(argv)

    rotas_sitemap, primeiro_dia, aceitas, contexto, erros = coletar(args.root, args.log_glob)
    if erros:
        print("INCONCLUSIVO — fonte indisponivel (exit 2, nunca reprovacao):", file=sys.stderr)
        for erro in erros:
            print("  - %s" % erro, file=sys.stderr)
        return 2

    resultado = classificar(rotas_sitemap, aceitas, primeiro_dia)

    snapshot = carregar_snapshot(args.root)
    if snapshot:
        contexto["snapshot_nunca"] = snapshot["nunca"]
        contexto["snapshot_as_of"] = snapshot["as_of"]
        contexto["snapshot_total"] = snapshot["total"]
        nunca_agora = {rota for rota, dados in resultado["por_rota"].items()
                       if dados["estado"] == ESTADO_NUNCA}
        contexto["snapshot_divergencia"] = len(nunca_agora ^ snapshot["paths"])
        # O snapshot foi gerado num instante; requisicao posterior a ele
        # contradiz sem que nenhum dos dois esteja errado. Fica contada, nao
        # escondida e nao "corrigida".
        contexto["contradicoes"] = sum(
            1 for rota in snapshot["paths"]
            if resultado["por_rota"].get(rota, {}).get("datas_log"))

    contexto["borda_rotas_no_sitemap"] = len(set(primeiro_dia) & rotas_sitemap)

    registro = montar_registro(len(rotas_sitemap), resultado, contexto)

    if not registro["soma_confere"]:
        print("INVARIANTE QUEBRADA: %d + %d + %d = %d, sitemap tem %d"
              % (registro["nunca_pedida"], registro["pedida_uma_vez_so"],
                 registro["pedida_e_revisitada"], registro["soma_dos_estados"],
                 registro["denominador"]), file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(registro, sort_keys=True))
    else:
        imprimir_relatorio(registro, resultado, args.detalhe, args.estado, args.limite)

    if args.registrar:
        caminho = os.path.join(args.root, SERIE)
        os.makedirs(os.path.dirname(caminho), exist_ok=True)
        with open(caminho, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(registro, sort_keys=True) + "\n")
        if not args.json:
            print("\nserie: +1 linha em %s" % SERIE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
