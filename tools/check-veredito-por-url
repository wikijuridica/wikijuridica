    print("=== VEREDITO DO GOOGLEBOT POR URL — %d URLs no sitemap ===" % denominador)
    print("origem : %s -> %s (%d dias com requisicao aceita), %d arquivos, %d inacessiveis"
          % (registro["janela_log_inicio"] or "sem linha aceita",
             registro["janela_log_fim"] or "-",
