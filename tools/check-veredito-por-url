def carregar_borda(root):
    """(paths_first_seen, meta, erro)."""
    caminho = os.path.join(root, ESTADO_BORDA)
    try:
        with open(caminho, encoding="utf-8") as handle:
            dados = json.load(handle)
    except (OSError, ValueError) as erro:
        return {}, {}, "%s: %s" % (ESTADO_BORDA, str(erro)[:100])
    registro = (dados.get("crawlers_verified") or {}).get(AGENTE_ALVO)
    if not registro:
        return {}, {}, "%s: sem crawlers_verified.%s" % (ESTADO_BORDA, AGENTE_ALVO)
    primeiro_dia = registro.get("paths_first_seen") or {}
    if not isinstance(primeiro_dia, dict) or not primeiro_dia:
        return {}, {}, "%s: paths_first_seen vazio" % ESTADO_BORDA
    dias = sorted(registro.get("days_ingested") or [])
    meta = {
        "borda_dias": len(dias),
        "borda_inicio": dias[0] if dias else None,
        "borda_fim": dias[-1] if dias else None,
        "borda_atualizada_em": registro.get("last_updated"),
        "borda_rotas": len(primeiro_dia),
    }
    return primeiro_dia, meta, None


def carregar_snapshot(root):
    caminho = os.path.join(root, SNAPSHOT_NUNCA)
    try:
        with open(caminho, encoding="utf-8") as handle:
            dados = json.load(handle)
    except (OSError, ValueError):
        return None
    registro = (dados.get("crawlers") or {}).get(AGENTE_ALVO)
    if not registro:
        return None
    return {
        "nunca": registro.get("never_requested_count"),
        "as_of": registro.get("as_of"),
        "total": dados.get("sitemap_total"),
        "paths": set(registro.get("never_requested_paths") or []),
    }


def coletar(root, padrao_log=LOG_GLOB):
    """Lê tudo e devolve (aceitas, contexto, erros_fatais)."""
    aceitas = []
    descartes = collections.Counter()
    arquivos = []
    inacessiveis = []
    linhas_lidas = 0
    instantes = []
    faixa_secundaria = 0

    rotas_sitemap, hosts, shards = paths_do_sitemap(root)
    # `www.` é o mesmo site: o vhost redireciona para o apex, e um 301 é o bot
    # TOCANDO o path. A borda conta por path, sem host — aceitar os dois mantém
    # as duas fontes falando da mesma coisa. O contador fica à vista.
    hosts_aceitos = set(hosts) | {"www." + host for host in hosts}

    primarias, secundarias, meta_faixas = carregar_faixas(root)
    primeiro_dia, meta_borda, erro_borda = carregar_borda(root)

    for caminho in descobrir_logs(padrao_log):
        linhas, erro = ler_arquivo_log(caminho)
        if erro:
            inacessiveis.append({"arquivo": caminho, "erro": erro})
            continue
        aceitas_do_arquivo = 0
        for bruto in linhas:
            linhas_lidas += 1
            veredito = analisar_linha(bruto, primarias, secundarias, hosts_aceitos)
            if not veredito["aceita"]:
                if PRE_FILTRO in bruto or PRE_FILTRO.upper() in bruto:
                    # Só o descarte de linha CANDIDATA vira estatística: contar
                    # "ua_nao_googlebot" para o milhão de linhas de visitante
                    # afogaria os motivos que importam.
                    descartes[veredito["motivo"]] += 1
                continue
            aceitas.append(veredito)
            aceitas_do_arquivo += 1
            instantes.append(veredito["instante"])
            if veredito["faixa"] == "secundaria":
                faixa_secundaria += 1
        arquivos.append({"arquivo": caminho, "linhas": len(linhas),
                         "aceitas": aceitas_do_arquivo})

    dias = sorted({registro["data"] for registro in aceitas})
    contexto = {
        "gerado_em": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "shards_sitemap": len(shards),
        "arquivos_log": arquivos,
        "arquivos_inacessiveis": inacessiveis,
        "linhas_lidas": linhas_lidas,
        "aceitas": len(aceitas),
        "aceitas_faixa_secundaria": faixa_secundaria,
        "descartes": dict(sorted(descartes.items())),
        "log_inicio": min(instantes) if instantes else None,
        "log_fim": max(instantes) if instantes else None,
        "log_dias": len(dias),
        "hosts_do_sitemap": sorted(hosts),
    }
    contexto.update(meta_faixas)
    contexto.update(meta_borda)

    erros = []
    if not rotas_sitemap:
        erros.append("sitemap sem rotas em %s" % os.path.join(root, SITEMAP_GLOB))
    if erro_borda:
        erros.append(erro_borda)
    if inacessiveis and len(inacessiveis) == len(descobrir_logs(padrao_log)):
        erros.append("nenhuma rotacao de log legivel em %s" % padrao_log)
    if not primarias:
        erros.append("faixas oficiais ausentes em data/ops/bot_ip_ranges/")

    return rotas_sitemap, primeiro_dia, aceitas, contexto, erros


def imprimir_relatorio(registro, resultado, detalhe, estado_filtro, limite):
