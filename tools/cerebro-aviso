PLUGIN_SO_PADRAO = "/usr/lib/x86_64-linux-gnu/xfce4/panel/plugins/libgenmon.so"
MARCA_DO_COMANDO = "cerebro-aviso genmon"
PERIODO_MS = 10000


def dir_painel():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "xfce4", "panel")


def xfconf(*argumentos):
    resultado = subprocess.run(["xfconf-query", "-c", "xfce4-panel", *argumentos],
                               capture_output=True, text=True, timeout=30)
    return resultado.returncode, resultado.stdout


def ids_registrados():
    """TODOS os /plugins/plugin-N, nao so os do array do painel 1 (vigilia: id
    repetido em painel diferente faz o xfce4-panel descartar um dos dois)."""
    _, saida = xfconf("-l")
    ids = []
    for linha in saida.splitlines():
        casamento = re.fullmatch(r"/plugins/plugin-(\d+)", linha.strip())
        if casamento:
            ids.append(int(casamento.group(1)))
    return sorted(set(ids))


def ids_do_painel():
    rc, saida = xfconf("-p", "/panels/panel-1/plugin-ids")
    if rc != 0:
        return []
    return [int(linha.strip()) for linha in saida.splitlines() if re.fullmatch(r"\d+", linha.strip())]


def rc_do_plugin(painel, id_plugin):
    return os.path.join(painel, f"genmon-{id_plugin}.rc")


def id_do_nosso_genmon(painel):
    """Reconhece pelo Command do rc, nunca pelo numero."""
    for id_plugin in ids_registrados():
        _, tipo = xfconf("-p", f"/plugins/plugin-{id_plugin}")
        if tipo.strip() != "genmon":
            continue
        try:
            with open(rc_do_plugin(painel, id_plugin), encoding="utf-8") as arquivo:
                conteudo = arquivo.read()
        except OSError:
            continue
        for linha in conteudo.splitlines():
            if linha.startswith("Command=") and MARCA_DO_COMANDO in linha:
                return id_plugin
    return None


def conteudo_rc():
    # Font=(default) quebra o CSS do plugin e o rotulo fica com largura zero
    # (tools/vigilia, medido em 2026-09-10): sempre fonte real.
    return (f"Command={EU} genmon\n"
            f"UpdatePeriod={PERIODO_MS}\n"
            "Text=cérebro\n"
            "UseLabel=0\n"
            "Font=Sans Bold 10\n")


def painel_rodando(proc):
    try:
        entradas = os.listdir(proc)
    except OSError:
        return False
    for entrada in entradas:
        if not entrada.isdigit():
            continue
        try:
            with open(os.path.join(proc, entrada, "comm"), encoding="utf-8", errors="replace") as arquivo:
                if arquivo.read().strip() == "xfce4-panel":
                    return True
        except OSError:
            continue
    return False


def cmd_painel(args):
    seco = args.seco
    if shutil.which("xfconf-query") is None:
        print("cerebro-aviso: xfconf-query ausente", file=sys.stderr)
        return 2
    plugin_so = os.environ.get("CEREBRO_AVISO_PLUGIN_SO", PLUGIN_SO_PADRAO)
    if not os.path.exists(plugin_so):
        print(f"cerebro-aviso: plugin genmon ausente ({plugin_so}). "
              "Instale antes: sudo apt-get install -y xfce4-genmon-plugin", file=sys.stderr)
        return 2
    painel = dir_painel()
    prefixo = "[seco] faria: " if seco else ""
    mudou = False

    id_plugin = id_do_nosso_genmon(painel)
    if id_plugin is not None:
        print(f"genmon do cérebro já registrado (plugin-{id_plugin})")
    else:
        registrados = ids_registrados()
        id_plugin = (max(registrados) if registrados else 0) + 1
        print(f"{prefixo}xfconf-query -c xfce4-panel -p /plugins/plugin-{id_plugin} -n -t string -s genmon")
        if not seco:
            rc, _ = xfconf("-p", f"/plugins/plugin-{id_plugin}", "-n", "-t", "string", "-s", "genmon")
            if rc != 0:
                print(f"cerebro-aviso: xfconf-query recusou criar plugin-{id_plugin}", file=sys.stderr)
                return 2
        mudou = True

    caminho_rc = rc_do_plugin(painel, id_plugin)
    try:
        with open(caminho_rc, encoding="utf-8") as arquivo:
            atual = arquivo.read()
    except OSError:
        atual = None
    if atual != conteudo_rc():
        print(f"{prefixo}escrever {caminho_rc}")
        if not seco:
            os.makedirs(painel, exist_ok=True)
            with open(caminho_rc, "w", encoding="utf-8") as arquivo:
                arquivo.write(conteudo_rc())

    no_painel = ids_do_painel()
    if id_plugin not in no_painel:
        # Reescreve o array inteiro (xfconf nao tem append), deduplicado: id
        # repetido no array faz o painel comer um dos dois (vigilia, 2026-09-10).
        novos = []
        for item in no_painel + [id_plugin]:
            if item not in novos:
                novos.append(item)
        argumentos = ["-p", "/panels/panel-1/plugin-ids", "-a"]
        for item in novos:
            argumentos += ["-t", "int", "-s", str(item)]
        print(f"{prefixo}pôr plugin-{id_plugin} no fim do painel 1")
        if not seco:
            rc, _ = xfconf(*argumentos)
            if rc != 0:
                print("cerebro-aviso: xfconf-query recusou reescrever o array do painel", file=sys.stderr)
                return 2
        mudou = True

    if not mudou:
        print("nada a mudar no painel")
        return 0

    executavel = shutil.which("xfce4-panel")
    if executavel is None:
        print("cerebro-aviso: xfce4-panel ausente; o plugin só aparece num painel novo", file=sys.stderr)
        return 2
    os.environ.setdefault("DISPLAY", ":0")
    if not os.environ.get("SESSION_MANAGER"):
        print("aviso: SESSION_MANAGER ausente — relançado daqui, o logout pode salvar uma sessão sem painel; "
              "prefira rodar este subcomando num terminal da sessão gráfica")
    # O plugin novo so carrega em processo NOVO do painel (vigilia: `-r` nao basta).
    if painel_rodando(args.proc):
        print(f"{prefixo}xfce4-panel -q && xfce4-panel (relançar para carregar o plugin)")
        if not seco:
            subprocess.run([executavel, "-q"], capture_output=True, timeout=30)
    else:
        print(f"{prefixo}xfce4-panel (painel não estava rodando)")
    if not seco:
        subprocess.Popen([executavel], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    return 0


