def evidencia(av, raiz):
    b = av.batimento or {}
    partes = [f"{ARQ_BATIMENTO}"]
    if b:
        partes.append(f"estado={b.get('estado')} ts={b.get('ts')} proximo_batimento_ate={b.get('proximo_batimento_ate')} pid={b.get('pid')}")
        if b.get("classe_pausa"):
            partes.append(f"classe_pausa={b.get('classe_pausa')} pausada_desde={b.get('pausada_desde')} limiar_pausa_s={b.get('limiar_pausa_s')}")
    partes.append(f"motivo={av.motivo}")
    partes.append("tools/cerebro-aviso genmon")
    return "; ".join(partes)


def notificar(raiz, argumentos):
    comando = [os.path.join(raiz, ARQ_NOTIFICADOR), "--chave", CHAVE_ALERTA,
               "--origem", ORIGEM_ALERTA, "--json"] + argumentos
    try:
        resultado = subprocess.run(comando, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as erro:
        return 2, {"erro": f"{type(erro).__name__}: {erro}"}
    try:
        evento = json.loads(resultado.stdout) if resultado.stdout.strip() else {}
    except ValueError:
        evento = {"stdout": resultado.stdout.strip()[:300]}
    if resultado.returncode != 0:
        evento = dict(evento, stderr=resultado.stderr.strip()[-300:])
    return resultado.returncode, evento


def decidir(av, estado, agora):
    """Pura: (novo_estado, acao). acao in {None, 'vermelho', 'amarelo', 'resolvido'}."""
    anterior_cor = estado.get("cor_observada")
    cor_desde = parse_ts(estado.get("cor_desde"))
    cor_notificada = estado.get("cor_notificada") or VERDE
    incidente_desde = parse_ts(estado.get("incidente_desde"))

    if av.cor != anterior_cor or cor_desde is None:
        cor_desde = agora
    if av.cor == VERDE:
        novo_incidente = incidente_desde
    else:
        candidatos = [t for t in (incidente_desde, av.incidente_desde, agora) if t is not None]
        novo_incidente = min(candidatos)

    acao = None
    if av.cor == VERMELHO and cor_notificada != VERMELHO:
        # So a SEGUNDA observacao confirma (ver CARENCIA_VERMELHO_S).
        if anterior_cor == VERMELHO and (agora - cor_desde).total_seconds() >= CARENCIA_VERMELHO_S:
            acao = VERMELHO
    elif av.cor == AMARELO and cor_notificada == VERDE:
        inicio = av.pausa_desde or cor_desde
        if av.pausa_desde is not None and (agora - inicio).total_seconds() >= CARENCIA_AMARELO_S:
            acao = AMARELO
    elif av.cor == VERDE and cor_notificada != VERDE:
        acao = "resolvido"

    novo = {
        "schema_version": SCHEMA_ESTADO,
        "cor_observada": av.cor,
        "motivo_observado": av.motivo,
        "cor_desde": iso(cor_desde),
        "cor_notificada": cor_notificada,
        "incidente_desde": iso(novo_incidente) if (novo_incidente and av.cor != VERDE) else
                           (estado.get("incidente_desde") if cor_notificada != VERDE else None),
        "motivo_do_incidente": estado.get("motivo_do_incidente") if cor_notificada != VERDE else None,
    }
    if acao in (VERMELHO, AMARELO):
        novo["cor_notificada"] = acao
        if not novo.get("motivo_do_incidente"):
            novo["motivo_do_incidente"] = av.motivo
    elif acao == "resolvido":
        novo["cor_notificada"] = VERDE
    if av.cor == VERDE and novo["cor_notificada"] == VERDE:
        novo["incidente_desde"] = None
        novo["motivo_do_incidente"] = None
    return novo, acao


def argumentos_da_notificacao(av, acao, estado_anterior, raiz, agora):
    if acao == VERMELHO:
        titulo = "Cérebro pausado por defeito" if "pausa" in av.motivo else "Cérebro parado"
        return ["--severidade", "alta", "--titulo", titulo,
                "--mensagem", f"{av.rotulo}: {trunca(av.frase, 300)}",
                "--evidencia", evidencia(av, raiz)]
    if acao == AMARELO:
        return ["--severidade", "media", "--titulo", "Cérebro em pausa há mais de 5 min",
                "--mensagem", f"{av.rotulo}: {trunca(av.frase, 300)}",
                "--evidencia", evidencia(av, raiz)]
    inicio = parse_ts(estado_anterior.get("incidente_desde"))
    duracao = f" depois de {fmt_dur((agora - inicio).total_seconds())}" if inicio else ""
    motivo = estado_anterior.get("motivo_do_incidente") or estado_anterior.get("motivo_observado") or "?"
    return ["--resolvido", "--titulo", "Cérebro saudável de novo",
            "--mensagem", f"{av.rotulo}{duracao} de incidente (motivo: {motivo})"]


def cmd_transicao(args):
    raiz = args.raiz
    agora = args.agora or datetime.datetime.now(datetime.timezone.utc)
    av = avaliar(raiz, args.proc, agora)
    if av.batimento is not None:
        registrar_amostra(raiz, av.batimento)

    caminho_estado = os.path.join(raiz, ARQ_TRANSICAO_ESTADO)
    os.makedirs(os.path.dirname(caminho_estado), exist_ok=True)
    with open(caminho_estado + ".lock", "w", encoding="utf-8") as trava:
        fcntl.flock(trava.fileno(), fcntl.LOCK_EX)
        estado = le_json(caminho_estado) or {}
        novo, acao = decidir(av, estado, agora)

        rc_notificacao, evento = 0, None
        if acao is not None:
            rc_notificacao, evento = notificar(raiz, argumentos_da_notificacao(av, acao, estado, raiz, agora))
            if rc_notificacao != 0:
                # Nao entregou: o estado NAO avanca, e a proxima passada tenta de
                # novo. O exit 2 aciona o OnFailure, que e o canal de reserva.
                novo["cor_notificada"] = estado.get("cor_notificada") or VERDE

        mudou_cor = (estado.get("cor_observada"), estado.get("motivo_observado")) != (av.cor, av.motivo)
        if mudou_cor or acao is not None:
            linha = {
                "schema_version": SCHEMA_TRANSICAO,
                "ts": iso(agora),
                "de": {"cor": estado.get("cor_observada"), "motivo": estado.get("motivo_observado")},
                "para": {"cor": av.cor, "motivo": av.motivo},
                "rotulo": av.rotulo,
                "frase": av.frase,
                "notificacao": acao,
                "notificacao_rc": rc_notificacao if acao is not None else None,
                "canais": (evento or {}).get("canais") if isinstance(evento, dict) else None,
                "batimento_ts": (av.batimento or {}).get("ts"),
                "pid": (av.batimento or {}).get("pid"),
            }
            caminho_linhas = os.path.join(raiz, ARQ_TRANSICOES)
            with open(caminho_linhas, "a", encoding="utf-8") as arquivo:
                arquivo.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
            print(f"cerebro-aviso: {estado.get('cor_observada')}/{estado.get('motivo_observado')} -> "
                  f"{av.cor}/{av.motivo}" + (f" · notificacao={acao} rc={rc_notificacao}" if acao else ""))

        if novo != estado:
            grava_atomico(caminho_estado, novo)

    if acao is not None and rc_notificacao != 0:
        print(f"NAO MEDIDO: notify-owner saiu com {rc_notificacao} ao entregar '{acao}': {evento}",
              file=sys.stderr)
        return 2
    if acao is not None and isinstance(evento, dict):
        desktop = str((evento.get("canais") or {}).get("desktop") or "")
        if desktop.startswith("falhou"):
            print(f"NAO MEDIDO: notificacao '{acao}' registrada, mas o desktop falhou: {desktop}",
                  file=sys.stderr)
            return 2
    return 0


