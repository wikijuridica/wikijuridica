def instante_arg(valor):
    instante = parse_ts(valor)
    if instante is None:
        raise argparse.ArgumentTypeError(f"--agora precisa de RFC3339 com fuso: {valor!r}")
    return instante


def main(argv=None):
    analisador = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = analisador.add_subparsers(dest="comando", required=True)
    for nome in ("genmon", "transicao"):
        p = sub.add_parser(nome)
        p.add_argument("--raiz", default=RAIZ_PADRAO)
        p.add_argument("--proc", default="/proc")
        p.add_argument("--agora", type=instante_arg, default=None,
                       help="relogio injetado (RFC3339), para fixture reproduzivel")
    p = sub.add_parser("painel")
    p.add_argument("--seco", action="store_true", help="imprime o que faria, sem escrever")
    p.add_argument("--proc", default="/proc")
    args = analisador.parse_args(argv)
    if args.comando == "genmon":
        return cmd_genmon(args)
    if args.comando == "transicao":
        return cmd_transicao(args)
    return cmd_painel(args)


if __name__ == "__main__":
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
    from saida_de_medidor import main_protegido

    main_protegido(main)
