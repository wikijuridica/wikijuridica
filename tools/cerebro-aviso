def comando_do_log(raiz):
    """Clique do painel: so quando o log E um terminal existem de fato."""
    log = os.path.join(raiz, ARQ_CEREBRO_LOG)
    if not os.access(log, os.X_OK):
        return None
    if shutil.which("xfce4-terminal"):
        return f"xfce4-terminal --hold -x {log} ver -f"
    if shutil.which("wezterm"):
        return f"wezterm start -- {log} ver -f"
    return None


def rotulo_markup(av):
    cor = COR_HEX[av.cor]
    peso = ' weight="bold"' if av.cor == VERMELHO else ""
    if av.cor == VERMELHO:
        return f'<span foreground="{cor}"{peso}>{escapa(av.glifo)} {escapa(av.rotulo)}</span>'
    return f'<span foreground="{cor}">{escapa(av.glifo)}</span> {escapa(av.rotulo)}'


def saida_genmon(raiz, proc, agora):
    av = avaliar(raiz, proc, agora)
    amostras = ler_amostras(raiz)
    linhas = [av.frase[:1].upper() + av.frase[1:], ""]
    linhas.extend(av.linhas)
    if av.batimento is not None:
        linhas.append(texto_ritmo(ritmo(amostras, av.batimento)))
    linhas.append(texto_enfileiramento(raiz))
    clique = comando_do_log(raiz)
    if os.access(os.path.join(raiz, ARQ_CEREBRO_LOG), os.X_OK):
        linhas.append("Log: tools/cerebro-log ver" + (" · clique para acompanhar ao vivo" if clique else ""))
    else:
        linhas.append("Log: journalctl -u wikijuridica-cerebro (tools/cerebro-log ainda não instalado)")
    saida = [f"<txt>{rotulo_markup(av)}</txt>",
             "<tool>" + escapa("\n".join(linhas)) + "</tool>"]
    if clique:
        saida.append(f"<txtclick>{clique}</txtclick>")
    if av.batimento is not None:
        registrar_amostra(raiz, av.batimento)
    return "\n".join(saida) + "\n"


def cmd_genmon(args):
    agora = args.agora or datetime.datetime.now(datetime.timezone.utc)
    try:
        sys.stdout.write(saida_genmon(args.raiz, args.proc, agora))
    except Exception as erro:  # o painel nao pode ficar em branco
        traceback.print_exc()
        sys.stdout.write(
            f'<txt><span foreground="{COR_HEX[VERMELHO]}" weight="bold">'
            f'{GLIFO[VERMELHO]} Cérebro aviso com defeito</span></txt>\n'
            f"<tool>{escapa('tools/cerebro-aviso genmon caiu: ' + type(erro).__name__ + ': ' + str(erro))}"
            f"{escapa(chr(10) + 'O estado do cérebro NÃO foi lido. Rode o subcomando num terminal para ver o traceback.')}</tool>\n")
    return 0


