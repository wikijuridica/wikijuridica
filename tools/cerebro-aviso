# amostras e ritmo
# ═══════════════════════════════════════════════════════════════════════════

def ler_amostras(raiz):
    dados = le_json(os.path.join(raiz, ARQ_AMOSTRAS)) or {}
    amostras = []
    for item in dados.get("amostras") or []:
        if not isinstance(item, dict):
            continue
        instante = parse_ts(item.get("ts"))
        concluidas = item.get("concluidas")
        if instante is None or isinstance(concluidas, bool) or not isinstance(concluidas, int):
            continue
        amostras.append((instante, concluidas))
    amostras.sort(key=lambda par: par[0])
    return amostras


def amostra_do_batimento(batimento):
    if not isinstance(batimento, dict):
        return None
    instante = parse_ts(batimento.get("ts"))
    concluidas = batimento.get("concluidas")
    if instante is None or isinstance(concluidas, bool) or not isinstance(concluidas, int):
        return None
    return instante, concluidas


def registrar_amostra(raiz, batimento):
    """Acrescenta (ts, concluidas) do batimento se ele e novo e espacado.

    A chave e o `ts` que o WORKER carimbou, nunca o relogio de quem le: o genmon
    le o mesmo batimento varias vezes, e uma amostra por leitura inventaria
    ritmo zero entre batimentos. `concluidas` que DIMINUI (fila recriada) zera o
    historico: delta negativo nao e ritmo."""
    nova = amostra_do_batimento(batimento)
    if nova is None:
        return False
    caminho = os.path.join(raiz, ARQ_AMOSTRAS)
    try:
        os.makedirs(os.path.dirname(caminho), exist_ok=True)
        trava = open(caminho + ".lock", "w", encoding="utf-8")
    except OSError as erro:
        print(f"cerebro-aviso: amostra não registrada ({erro})", file=sys.stderr)
        return False
    with trava:
        try:
            fcntl.flock(trava.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            # Outro processo (genmon x transicao) esta gravando a mesma amostra.
            return False
        amostras = ler_amostras(raiz)
        if amostras:
            ultima_ts, ultima_c = amostras[-1]
            if nova[0] <= ultima_ts or nova[1] < ultima_c:
                if nova[1] < ultima_c or nova[0] < ultima_ts:
                    amostras = []
                else:
                    return False
            elif (nova[0] - ultima_ts).total_seconds() < AMOSTRA_ESPACO_MIN_S:
                return False
        amostras.append(nova)
        corte = nova[0] - datetime.timedelta(seconds=AMOSTRA_RETENCAO_S)
        amostras = [par for par in amostras if par[0] >= corte][-AMOSTRA_MAX:]
        grava_atomico(caminho, {
            "schema_version": SCHEMA_AMOSTRAS,
            "amostras": [{"ts": iso(t), "concluidas": c} for t, c in amostras],
        })
    return True


def ritmo(amostras, batimento):
    """(delta, span_s) sobre a ultima hora, ou None sem DUAS amostras reais.

    A leitura atual conta como amostra (ela e um (ts, concluidas) declarado pelo
    worker), mas so se for mais nova que a ultima guardada."""
    pontos = list(amostras)
    atual = amostra_do_batimento(batimento)
    if atual is not None and (not pontos or atual[0] > pontos[-1][0]):
        pontos.append(atual)
    if len(pontos) < 2:
        return None
    topo = pontos[-1]
    janela = [par for par in pontos if (topo[0] - par[0]).total_seconds() <= JANELA_RITMO_S]
    if len(janela) < 2:
        return None
    base = janela[0]
    span = (topo[0] - base[0]).total_seconds()
    delta = topo[1] - base[1]
    if span <= 0 or delta < 0:
        return None
    return delta, span


def texto_ritmo(medida):
    if medida is None:
        return "Ritmo: ainda sem duas amostras do batimento (aparece em alguns minutos)"
    delta, span = medida
    texto = f"Ritmo: +{fmt_int(delta)} concluídas em {fmt_dur(span)}"
    if span >= RITMO_SPAN_MIN_PARA_HORA_S:
        texto += f" (≈{fmt_int(round(delta * 3600 / span))}/h)"
    return texto


