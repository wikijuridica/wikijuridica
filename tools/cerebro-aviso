def ultima_linha_jsonl(caminho, janela=16384):
    """Ultima linha JSON valida, lendo so o fim do arquivo (o ledger cresce)."""
    try:
        with open(caminho, "rb") as arquivo:
            arquivo.seek(0, os.SEEK_END)
            tamanho = arquivo.tell()
            arquivo.seek(max(0, tamanho - janela))
            cauda = arquivo.read().decode("utf-8", errors="replace")
    except OSError:
        return None
    for linha in reversed(cauda.splitlines()):
        linha = linha.strip()
        if not linha:
            continue
        try:
            dados = json.loads(linha)
        except ValueError:
            continue
        if isinstance(dados, dict):
            return dados
    return None


def texto_enfileiramento(raiz):
    linha = ultima_linha_jsonl(os.path.join(raiz, ARQ_ENFILEIRAR))
    if linha is None:
        return "Enfileiramento: sem registro em " + ARQ_ENFILEIRAR
    inicio = parse_ts(linha.get("inicio"))
    duracao = linha.get("duracao_s")
    partes = []
    if inicio is not None:
        partes.append(f"último às {hora_local(inicio)}")
    if isinstance(duracao, (int, float)) and not isinstance(duracao, bool):
        partes.append(f"levou {fmt_dur(duracao)}")
    if linha.get("gatilho"):
        partes.append(f"gatilho {linha.get('gatilho')}")
    exits = []
    for etapa in ("embeddings", "extracoes"):
        dados = linha.get(etapa)
        if isinstance(dados, dict) and "exit" in dados:
            exits.append(f"{etapa} exit {dados.get('exit')}")
    partes.extend(exits)
    return "Enfileiramento: " + (", ".join(partes) if partes else "linha sem campos reconhecidos")


