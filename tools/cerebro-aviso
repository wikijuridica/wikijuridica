class Avaliacao:
    """O que o painel e a transicao sabem sobre o cerebro neste instante."""

    def __init__(self, cor, motivo, rotulo, frase):
        self.cor = cor
        self.motivo = motivo
        # rotulo: texto curto do painel (sem marcacao); frase: uma linha humana
        # que vai para o topo do tooltip e para a notificacao.
        self.rotulo = rotulo
        self.frase = frase
        self.batimento = None
        self.linhas = []
        self.incidente_desde = None
        self.pausa_desde = None
        self.glifo = GLIFO[cor]

    def como_dict(self):
        return {"cor": self.cor, "motivo": self.motivo, "rotulo": self.rotulo,
                "frase": self.frase}


def processo_do_cerebro(proc, pid):
    """(vivo, detalhe). Vivo exige /proc/<pid> E comm == cerebro quando legivel.

    Sem a conferencia do comm, um pid reaproveitado depois de reboot ou de muito
    fork (o batimento velho continua no disco) le verde ate o prazo vencer."""
    if pid <= 0:
        return False, "o batimento não declara pid"
    base = os.path.join(proc, str(pid))
    if not os.path.isdir(base):
        return False, f"pid {pid} ausente de /proc"
    try:
        with open(os.path.join(base, "comm"), encoding="utf-8", errors="replace") as arquivo:
            comm = arquivo.read().strip()
    except OSError:
        return True, f"pid {pid} vivo (comm ilegível)"
    if comm != COMM_DO_CEREBRO:
        return False, f"pid {pid} é outro processo ({comm})"
    return True, f"pid {pid} vivo"


def avaliar(raiz, proc, agora):
    caminho = os.path.join(raiz, ARQ_BATIMENTO)
    try:
        with open(caminho, encoding="utf-8") as arquivo:
            bruto = arquivo.read()
    except FileNotFoundError:
        return Avaliacao(VERMELHO, "batimento_ausente", "Cérebro sem batimento",
                         f"{ARQ_BATIMENTO} não existe: o cérebro não declara pulso nenhum")
    except OSError as erro:
        return Avaliacao(VERMELHO, "batimento_ilegivel", "Cérebro batimento ilegível",
                         f"não consegui ler {ARQ_BATIMENTO}: {erro}")
    try:
        batimento = json.loads(bruto)
    except ValueError as erro:
        return Avaliacao(VERMELHO, "batimento_ilegivel", "Cérebro batimento ilegível",
                         f"{ARQ_BATIMENTO} não é JSON válido: {erro}")
    if not isinstance(batimento, dict):
        return Avaliacao(VERMELHO, "batimento_ilegivel", "Cérebro batimento ilegível",
                         f"{ARQ_BATIMENTO} não é um objeto JSON")

    estado = str(batimento.get("estado") or "")
    ts = parse_ts(batimento.get("ts"))
    prazo = parse_ts(batimento.get("proximo_batimento_ate"))
    pid = inteiro(batimento, "pid")
    vivo, detalhe_pid = processo_do_cerebro(proc, pid)
    pausada_desde = parse_ts(batimento.get("pausada_desde"))
    limiar = inteiro(batimento, "limiar_pausa_s")
    classe = str(batimento.get("classe_pausa") or "")
    curto_classe = CLASSES_DE_PAUSA.get(classe, (classe or "sem classe", ""))[0]

    if ts is None or prazo is None:
        campo = "ts" if ts is None else "proximo_batimento_ate"
        av = Avaliacao(VERMELHO, "batimento_sem_prazo", "Cérebro batimento sem prazo",
                       f"campo `{campo}` ausente ou fora do RFC3339: não há como separar travado de lote longo")
    elif agora > prazo:
        # VALE PARA QUALQUER ESTADO: quem se declarou trabalhando e nao voltou no
        # prazo que ele mesmo pediu esta travado.
        parado = (agora - ts).total_seconds()
        av = Avaliacao(VERMELHO, "batimento_vencido", f"Cérebro parado {fmt_dur(parado)}",
                       f"o worker prometeu voltar até {hora_local(prazo)} e não voltou "
                       f"(último batimento às {hora_local(ts)}, estado declarado {estado or '?'})")
        av.incidente_desde = prazo
    elif not vivo:
        av = Avaliacao(VERMELHO, "processo_ausente", "Cérebro sem processo",
                       f"{detalhe_pid}: o batimento no disco é de um processo que não existe mais")
        av.incidente_desde = ts
    elif estado == ESTADO_PAUSADO_POR_DEFEITO:
        duracao = (agora - pausada_desde).total_seconds() if pausada_desde else None
        rotulo = "Cérebro pausa com defeito" + (f" {fmt_dur(duracao)}" if duracao is not None else "")
        av = Avaliacao(VERMELHO, "pausado_por_defeito", rotulo,
                       f"pausado por defeito ({classe or 'classe não declarada'})"
                       + (f" há {fmt_dur(duracao)}" if duracao is not None else ""))
        av.pausa_desde = pausada_desde
        av.incidente_desde = pausada_desde or ts
    elif (estado in (ESTADO_PAUSADO_TRANSITORIO, ESTADO_PAUSADO_A_PEDIDO) and pausada_desde
          and limiar > 0 and (agora - pausada_desde).total_seconds() > limiar):
        duracao = (agora - pausada_desde).total_seconds()
        av = Avaliacao(VERMELHO, "pausa_acima_do_limiar",
                       f"Cérebro pausa com defeito {fmt_dur(duracao)}",
                       f"pausa ({classe}) há {fmt_dur(duracao)}, acima do limiar de {fmt_dur(limiar)} que o próprio worker declarou")
        av.pausa_desde = pausada_desde
        av.incidente_desde = pausada_desde
    elif estado in (ESTADO_PAUSADO_TRANSITORIO, ESTADO_PAUSADO_A_PEDIDO):
        duracao = (agora - pausada_desde).total_seconds() if pausada_desde else None
        motivo = "pausado_a_pedido" if estado == ESTADO_PAUSADO_A_PEDIDO else "pausa"
        rotulo = f"Cérebro pausa ({curto_classe})" + (f" {fmt_dur(duracao)}" if duracao is not None else "")
        frase = ("pausado a pedido" if motivo == "pausado_a_pedido" else f"em pausa ({classe or 'classe não declarada'})")
        if duracao is not None:
            frase += f" há {fmt_dur(duracao)}"
            if limiar > 0:
                frase += f", limiar {fmt_dur(limiar)}"
        av = Avaliacao(AMARELO, motivo, rotulo, frase)
        av.pausa_desde = pausada_desde
        av.incidente_desde = pausada_desde or ts
    elif estado not in ESTADOS_CONHECIDOS:
        av = Avaliacao(AMARELO, "estado_desconhecido", "Cérebro estado desconhecido",
                       f"estado declarado {estado!r} não é nenhum dos que este aviso conhece")
        av.glifo = GLIFO_ATENCAO
    else:
        anomalias = [(campo, inteiro(batimento, campo), texto)
                     for campo, texto in ANOMALIAS_POR_PRESENCA if inteiro(batimento, campo) > 0]
        verbo = verbo_do_lote(batimento, estado)
        if anomalias:
            resumo = "; ".join(f"{n} {texto}" for _, n, texto in anomalias)
            av = Avaliacao(AMARELO, "contradicao_declarada", f"Cérebro atenção · {verbo}",
                           f"{verbo}, mas o worker declara: {resumo}")
            av.glifo = GLIFO_ATENCAO
        else:
            av = Avaliacao(VERDE, estado, f"Cérebro {verbo} · {fmt_int(inteiro(batimento, 'concluidas'))}",
                           f"{verbo}, batimento no prazo, processo vivo")
    av.batimento = batimento
    av.linhas = detalhes(batimento, agora, ts, prazo, detalhe_pid, pausada_desde, limiar, classe)
    return av


def verbo_do_lote(batimento, estado):
    if estado == ESTADO_OCIOSO:
        return "ocioso"
    tipo = str(batimento.get("tipo_lote") or "")
    if not tipo:
        return "trabalhando"
    return TIPOS_DE_LOTE.get(tipo, (tipo, tipo))[0]


def detalhes(b, agora, ts, prazo, detalhe_pid, pausada_desde, limiar, classe):
    linhas = []
    estado = str(b.get("estado") or "?")
    if ts is not None:
        linhas.append(f"Estado: {estado} (declarado às {hora_local(ts)}, há {fmt_dur((agora - ts).total_seconds())})")
    else:
        linhas.append(f"Estado: {estado}")
    tipo = str(b.get("tipo_lote") or "")
    modelo = str(b.get("modelo_lote") or "")
    ultimo = parse_ts(b.get("ultimo_lote_em"))
    if tipo:
        frase = TIPOS_DE_LOTE.get(tipo, (tipo, tipo))[1]
        prefixo = "Fazendo" if estado == ESTADO_TRABALHANDO else "Último lote"
        texto = f"{prefixo}: {frase}"
        if modelo:
            texto += f" com {modelo}"
        if estado == ESTADO_TRABALHANDO and inteiro(b, "lote"):
            texto += f" (lote de {inteiro(b, 'lote')})"
        linhas.append(texto)
    else:
        linhas.append("Fazendo: não declarado por este binário (campos tipo_lote/modelo_lote ausentes)")
    if ultimo is not None:
        linhas.append(f"Último lote concluído às {hora_local(ultimo)} (há {fmt_dur((agora - ultimo).total_seconds())})")
    linhas.append(
        f"Fila: {fmt_int(inteiro(b, 'concluidas'))} concluídas · {fmt_int(inteiro(b, 'pendentes'))} pendentes "
        f"({fmt_int(inteiro(b, 'elegiveis_agora'))} elegíveis) · {inteiro(b, 'executando')} executando · "
        f"{inteiro(b, 'erros')} erros")
    if classe or pausada_desde:
        rotulo = CLASSES_DE_PAUSA.get(classe, ("", classe or "classe não declarada"))[1]
        texto = f"Pausa: {classe or '?'} — {rotulo}"
        if pausada_desde is not None:
            texto += f"; desde {hora_local(pausada_desde)}, há {fmt_dur((agora - pausada_desde).total_seconds())}"
        if limiar > 0:
            texto += f" de {fmt_dur(limiar)} de limiar"
        linhas.append(texto)
        if b.get("sonda_pausa"):
            linhas.append(f"Sonda: {b.get('sonda_pausa')}")
        if b.get("diagnostico_pausa"):
            linhas.append(f"Diagnóstico: {trunca(b.get('diagnostico_pausa'))}")
    disjuntor = parse_ts(b.get("disjuntor_aberto_ate"))
    if disjuntor is not None and disjuntor > agora:
        linhas.append(f"Disjuntor do Ollama aberto até {hora_local(disjuntor)}")
    sem_elegivel = parse_ts(b.get("sem_elegivel_desde"))
    if sem_elegivel is not None:
        linhas.append(f"Fila sem elegível desde {hora_local(sem_elegivel)} (há {fmt_dur((agora - sem_elegivel).total_seconds())})")
    for campo, texto in ANOMALIAS_POR_PRESENCA:
        if inteiro(b, campo) > 0:
            linhas.append(f"Atenção: {inteiro(b, campo)} {texto} ({campo})")
    if prazo is not None:
        linhas.append(f"Próximo batimento esperado até {hora_local(prazo)}")
    linhas.append(f"Processo: {detalhe_pid}")
    return linhas


