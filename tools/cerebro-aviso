def parse_ts(valor):
    """RFC3339 -> datetime com fuso. None quando ausente ou invalido."""
    if not isinstance(valor, str) or not valor.strip():
        return None
    texto = valor.strip()
    if texto.endswith("Z") or texto.endswith("z"):
        texto = texto[:-1] + "+00:00"
    try:
        instante = datetime.datetime.fromisoformat(texto)
    except ValueError:
        return None
    if instante.tzinfo is None:
        return None
    return instante


def iso(instante):
    return instante.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def hora_local(instante):
    return instante.astimezone().strftime("%H:%M")


def fmt_int(numero):
    return f"{int(numero):,}".replace(",", ".")


def fmt_dur(segundos):
    segundos = max(0, int(segundos))
    if segundos < 60:
        return f"{segundos} s"
    minutos = segundos // 60
    if minutos < 60:
        return f"{minutos} min"
    horas, resto = divmod(minutos, 60)
    return f"{horas} h {resto:02d} min"


def escapa(texto):
    """Escape de marcacao Pango. O genmon passa <txt> por gtk_label_set_markup e
    <tool> por gtk_widget_set_tooltip_markup (strings de libgenmon.so, 4.1.1): um
    `&` cru no diagnostico do daemon derruba o tooltip inteiro."""
    return (str(texto).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def inteiro(batimento, campo):
    valor = batimento.get(campo)
    if isinstance(valor, bool) or not isinstance(valor, (int, float)):
        return 0
    return int(valor)


def trunca(texto, limite=TRUNCA_DIAGNOSTICO):
    texto = " ".join(str(texto).split())
    return texto if len(texto) <= limite else texto[: limite - 1] + "…"


def grava_atomico(caminho, dados):
    diretorio = os.path.dirname(caminho)
    os.makedirs(diretorio, exist_ok=True)
    descritor, temporario = tempfile.mkstemp(prefix=os.path.basename(caminho) + ".",
                                             suffix=".tmp", dir=diretorio)
    try:
        with os.fdopen(descritor, "w", encoding="utf-8") as arquivo:
            json.dump(dados, arquivo, ensure_ascii=False, sort_keys=True)
        os.replace(temporario, caminho)
    except BaseException:
        if os.path.exists(temporario):
            os.unlink(temporario)
        raise


def le_json(caminho):
    """Objeto JSON do arquivo, ou None quando ausente/ilegivel (estado proprio
    do aviso: perde-lo so zera amostras ou a cor observada)."""
    try:
        with open(caminho, encoding="utf-8") as arquivo:
            dados = json.load(arquivo)
    except (OSError, ValueError):
        return None
    return dados if isinstance(dados, dict) else None


