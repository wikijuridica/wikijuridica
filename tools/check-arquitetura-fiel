#!/usr/bin/env python3
"""check-arquitetura-fiel — impede que a documentacao de arquitetura apodreca.

POR QUE EXISTE. Em 2026-08-12 esta sessao cometeu ONZE medicoes erradas, nenhuma
apanhada por gate, todas com a mesma causa: o artefato foi lido com a chave que
alguem SUPOS, ou por fora da camada que o repo mantem para sanea-lo. Havia um
documento no repo descrevendo boa parte dessas armadilhas
(docs/DADOS_CONFIAVEIS_E_ARMADILHAS.md) — e ele nao estava na lista de leitura
obrigatoria do CLAUDE.md, nem tinha como saber se continuava verdadeiro.

O defeito de fundo nao e falta de documento: e documento que nao se prova. Este
repositorio ja teve comentario MENTINDO em codigo de producao, corrigido como
bug (o do allowlist que prometia aceitar CFM, ICAO e EUR-Lex sem que nenhuma
passasse). Documentacao de arquitetura apodrece do mesmo jeito, e mais rapido:
o simbolo e renomeado, o arquivo e movido, e a prosa continua afirmando com
confianca uma coisa que ja nao existe.

O QUE ESTE CHECK FAZ. Le docs/arquitetura_fiel_ancoras.tsv — a lista de ancoras
que sustentam as afirmacoes do documento — e prova, uma a uma, que:

  1. o arquivo citado existe;
  2. o simbolo/trecho citado ainda APARECE nesse arquivo.

POR QUE ANCORA POR SIMBOLO, E NAO POR NUMERO DE LINHA. Numero de linha apodrece
na primeira edicao acima dele: um `import` novo desloca tudo e o gate passaria a
gritar sem que nada de verdade tenha mudado — gate que grita no dado bom e gate
que o operador aprende a ignorar. O simbolo sobrevive a deslocamento e morre
exatamente quando deve: quando alguem o renomeia ou o remove, que e o momento em
que a afirmacao da documentacao deixou de ser verdadeira.

O QUE ELE NAO FAZ, e e importante dizer. Ele NAO prova que a prosa interpretou o
simbolo corretamente — nenhum programa faz isso. Ele prova que a prosa aponta
para algo que EXISTE. E o piso, nao o teto: o teto continua sendo ler o codigo.

Uso:
    tools/check-arquitetura-fiel            # reprova (exit 1) se alguma ancora morreu
    tools/check-arquitetura-fiel --listar   # imprime as ancoras e sai 0
"""

from __future__ import annotations

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
ANCORAS = os.path.join(ROOT, "docs", "arquitetura_fiel_ancoras.tsv")
DOCUMENTO = os.path.join(ROOT, "docs", "ARQUITETURA_FIEL.md")

# Teto de leitura por arquivo. O maior arquivo ancorado hoje tem alguns MB; 64 MB
# cobre com folga e impede que um arquivo inesperadamente gigante trave o gate.
MAX_BYTES = 64 * 1024 * 1024


def carrega_ancoras(caminho):
    """Devolve (ancoras, erros_de_forma).

    Formato por linha, separado por TAB:
        caminho_relativo <TAB> simbolo_esperado <TAB> o_que_sustenta

    Linha vazia e linha iniciada por '#' sao ignoradas.
    """
    ancoras = []
    problemas = []
    if not os.path.isfile(caminho):
        return ancoras, ["%s: arquivo de ancoras ausente" % os.path.relpath(caminho, ROOT)]
    with open(caminho, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            linha = bruto.rstrip("\n")
            if not linha.strip() or linha.lstrip().startswith("#"):
                continue
            partes = linha.split("\t")
            if len(partes) != 3:
                problemas.append(
                    "linha %d: esperava 3 campos separados por TAB, veio %d" % (numero, len(partes)))
                continue
            rel, simbolo, sustenta = (p.strip() for p in partes)
            if not rel or not simbolo or not sustenta:
                problemas.append("linha %d: campo vazio" % numero)
                continue
            ancoras.append({
                "linha": numero,
                "arquivo": rel,
                "simbolo": simbolo,
                "sustenta": sustenta,
            })
    return ancoras, problemas


def verifica(ancora):
    """Devolve None se a ancora esta viva, ou a razao pela qual ela morreu."""
    caminho = os.path.join(ROOT, ancora["arquivo"])
    if not os.path.exists(caminho):
        return "arquivo nao existe"
    if os.path.isdir(caminho):
        # Ancora de diretorio: o simbolo e um nome de arquivo que precisa existir dentro dele.
        if not os.path.exists(os.path.join(caminho, ancora["simbolo"])):
            return "o diretorio existe, mas nao contem %r" % ancora["simbolo"]
        return None
    try:
        tamanho = os.path.getsize(caminho)
    except OSError as erro:
        return "nao deu para medir o arquivo: %s" % erro
    if tamanho > MAX_BYTES:
        return "arquivo acima do teto de leitura (%d bytes)" % tamanho
    try:
        with open(caminho, encoding="utf-8", errors="replace") as arquivo:
            conteudo = arquivo.read()
    except OSError as erro:
        return "nao deu para ler: %s" % erro
    if ancora["simbolo"] not in conteudo:
        return "o simbolo %r nao aparece mais no arquivo" % ancora["simbolo"]
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--listar", action="store_true",
                        help="imprime as ancoras verificadas e sai 0")
    args = parser.parse_args()

    ancoras, problemas_de_forma = carrega_ancoras(ANCORAS)

    if not os.path.isfile(DOCUMENTO):
        print("check-arquitetura-fiel: %s ausente — a documentacao que estas ancoras sustentam "
              "nao existe" % os.path.relpath(DOCUMENTO, ROOT), file=sys.stderr)
        return 1

    if problemas_de_forma:
        for problema in problemas_de_forma:
            print("check-arquitetura-fiel: %s" % problema, file=sys.stderr)
        return 1

    if not ancoras:
        # Zero ancora e vacuidade: o gate passaria sem provar nada, que e pior que
        # reprovar. Mesma razao pela qual o gate de colisao de rota recusa rodar
        # com o acervo vazio.
        print("check-arquitetura-fiel: nenhuma ancora carregada — um gate que nao "
              "prova nada nao protege nada", file=sys.stderr)
        return 1

    if args.listar:
        for ancora in ancoras:
            print("%s\t%s\t%s" % (ancora["arquivo"], ancora["simbolo"], ancora["sustenta"]))
        return 0

    mortas = []
    for ancora in ancoras:
        razao = verifica(ancora)
        if razao:
            mortas.append((ancora, razao))

    arquivos = len({a["arquivo"] for a in ancoras})
    if not mortas:
        print("check-arquitetura-fiel: OK — %d ancora(s) vivas em %d arquivo(s); "
              "toda afirmacao ancorada de %s aponta para algo que existe"
              % (len(ancoras), arquivos, os.path.relpath(DOCUMENTO, ROOT)))
        return 0

    print("check-arquitetura-fiel: %d de %d ancora(s) MORRERAM — a documentacao de "
          "arquitetura afirma o que o codigo nao sustenta mais:"
          % (len(mortas), len(ancoras)), file=sys.stderr)
    for ancora, razao in mortas:
        print("  %s (ancoras.tsv:%d)" % (ancora["arquivo"], ancora["linha"]), file=sys.stderr)
        print("      sustenta: %s" % ancora["sustenta"], file=sys.stderr)
        print("      problema: %s" % razao, file=sys.stderr)
    print("", file=sys.stderr)
    print("Corrija a DOCUMENTACAO para o que o codigo faz hoje, e a ancora junto. "
          "Remover a ancora sem corrigir a prosa transforma este gate em teatro.",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
