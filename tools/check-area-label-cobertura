#!/usr/bin/env python3
"""check-area-label-cobertura — nenhuma area publicada pode cair no ASCII.

READ-ONLY. Confere, nos DOIS sentidos, content/area_labels.json contra as areas
que realmente tem pagina em content/pages.json, e confere que a tabela gerada
internal/structureddata/area_labels_generated.go nao divergiu da config.

POR QUE EXISTE. O nome visivel da area vivia num mapa curado a mao dentro do
codigo, com um fallback title-case ASCII para quem nao estivesse nele. O
fallback nao falha, nao avisa e nao aparece em teste nenhum -- ele so escreve
"Diarios" onde deveria estar "Diarios" com acento. Medido em 2026-08-26: SETE
slugs com pagina publicada sem entrada no mapa, tres deles precisando de acento,
alcancando 283 URLs no breadcrumb visivel E no JSON-LD.

O fallback continua no render (uma area nova nao pode derrubar a pagina). Quem
reprova e este gate.

Uso:
    tools/check-area-label-cobertura
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "content/area_labels.json"
PAGINAS = ROOT / "content/pages.json"
TABELA = ROOT / "internal/structureddata/area_labels_generated.go"


def main() -> int:
    rotulos: dict[str, str] = json.loads(CONFIG.read_text(encoding="utf-8"))["rotulos"]
    paginas = json.loads(PAGINAS.read_text(encoding="utf-8"))
    publicadas: dict[str, int] = {}
    for pagina in paginas:
        segmentos = [s for s in (pagina.get("path") or "").split("/") if s]
        if len(segmentos) >= 2:
            publicadas[segmentos[0]] = publicadas.get(segmentos[0], 0) + 1

    falhas: list[str] = []
    for slug in sorted(set(publicadas) - set(rotulos)):
        falhas.append(f"area {slug!r} tem {publicadas[slug]} pagina(s) e nenhum rotulo "
                      f"em content/area_labels.json -- o breadcrumb dela cairia no "
                      f"title-case ASCII")
    for slug, rotulo in sorted(rotulos.items()):
        if not rotulo.strip():
            falhas.append(f"area {slug!r}: rotulo vazio nao e rotulo")

    gerado = dict(re.findall(r'^\t"([^"]+)":\s*"((?:[^"\\]|\\.)*)",$',
                             TABELA.read_text(encoding="utf-8"), re.M))
    gerado = {k: v.encode().decode("unicode_escape") if "\\" in v else v
              for k, v in gerado.items()}
    if gerado != rotulos:
        so_na_tabela = sorted(set(gerado) - set(rotulos))
        so_na_config = sorted(set(rotulos) - set(gerado))
        divergentes = sorted(k for k in set(gerado) & set(rotulos) if gerado[k] != rotulos[k])
        falhas.append(
            "a tabela gerada divergiu da config (rode "
            "tools/generate-area-label-table-20260826): "
            f"so_na_tabela={so_na_tabela} so_na_config={so_na_config} "
            f"divergentes={divergentes}")

    print(f"areas publicadas: {len(publicadas)} · rotulos configurados: {len(rotulos)} "
          f"· na tabela gerada: {len(gerado)}")
    if falhas:
        print("\nREPROVADO:", file=sys.stderr)
        for falha in falhas:
            print(f"  - {falha}", file=sys.stderr)
        return 1
    print("aprovado: toda area publicada tem rotulo proprio, e a tabela gerada bate com a config")
    return 0


if __name__ == "__main__":
    sys.exit(main())
