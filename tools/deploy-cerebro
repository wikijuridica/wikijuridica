#!/usr/bin/env bash
# deploy-cerebro — reconstroi bin/cerebro e reinicia a unit do cerebro.
#
# POR QUE EXISTE: ate 2026-09-11 `bin/cerebro` nao tinha caminho de build. A
# unit so dizia, em comentario, "construido por ./tools/go-modern build -o
# bin/cerebro ./cmd/cerebro/". O preco apareceu no mesmo dia: `b4fe2ba1` (a
# retentativa do corte, que tirava tres acordaos da lapide permanente) foi
# commitado 01:45 e o binario em execucao era de 21:58 da vespera. O conserto
# ficou morto no disco por quatro horas.
#
# `check-binario-vs-fonte` passou a acusar a defasagem no mesmo dia; este script
# e o que a apaga. Gate sem drenador e vermelho que ninguem apaga.
#
# ORDEM, e ela nao e detalhe:
#   1. build para `.novo` — o Go escreve IN-PLACE e sobrescrever o binario de um
#      processo vivo devolve ETXTBSY;
#   2. conferir que o `.novo` declara o HEAD, antes de trocar qualquer coisa;
#   3. `mv -f` (rename(2), atomico; o processo vivo segue no inode antigo);
#   4. restart — `Fila.Recuperar` devolve a `pendente` o que ficou `executando`,
#      entao no pior caso uma tarefa e refeita, nunca perdida;
#   5. provar que a unit subiu e que o gate fechou para o alvo `cerebro`.
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$RAIZ"

BIN="bin/cerebro"
NOVO="$BIN.novo"
UNIT="wikijuridica-cerebro.service"

printf 'deploy-cerebro: construindo %s a partir de ./cmd/cerebro/\n' "$NOVO"
./tools/go-modern build -o "$NOVO" ./cmd/cerebro/

cabeca="$(git rev-parse HEAD)"
declarada="$(./tools/go-modern version -m "$NOVO" | awk -F= '/vcs.revision=/ {print $2; exit}')"
if [ "$declarada" != "$cabeca" ]; then
	rm -f "$NOVO"
	printf 'deploy-cerebro: o binario declara %s e o HEAD e %s — build fora do caminho sancionado, nada trocado\n' \
		"${declarada:-'(nenhuma)'}" "$cabeca" >&2
	exit 1
fi

mv -f "$NOVO" "$BIN"
printf 'deploy-cerebro: %s trocado (vcs.revision=%s)\n' "$BIN" "${cabeca:0:12}"

sudo -n systemctl restart "$UNIT"
if ! systemctl is-active --quiet "$UNIT"; then
	printf 'deploy-cerebro: %s NAO subiu depois do restart\n' "$UNIT" >&2
	sudo -n journalctl -u "$UNIT" --since "-60s" --no-pager | tail -20 >&2
	exit 1
fi
printf 'deploy-cerebro: %s ativo\n' "$UNIT"

./tools/check-binario-vs-fonte
