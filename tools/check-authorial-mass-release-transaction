#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: check-authorial-mass-release-transaction [flags]

Runs the authorial-mass-release-transaction check through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="check:authorial-mass-release-transaction:gocache:$GOCACHE"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-360000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-120000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=84}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-check_pass_or_report_issues_with_timings}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-check" authorial-mass-release-transaction --timings "$@"
