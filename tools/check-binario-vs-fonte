#!/usr/bin/env python3
"""check-binario-vs-fonte — o que está NO AR corresponde ao que está no fonte?

READ-ONLY. Sai != 0 quando o binário em execução não embarca o código atual.

POR QUE EXISTE: em 2026-08-26 o servidor em produção rodava um binário de
2026-08-20 13:08, com 18 commits de `internal/` e `cmd/` fora dele. Consequências
medidas: `/rss.xml` devolvia 404 no processo Go (a string `application/rss+xml`
tinha ZERO ocorrências no binário) e três hubs serviam "Conteúdos jurídicos de
Diarios" — sem acento — porque o processo carregou `content/area_hub_editorial.json`
ANTES de o arquivo existir. Nada disso disparou alarme: o portal respondia 200 em
tudo, porque o nginx serve o HTML estático do disco e só o que falta cai no Go.

O defeito é pior que "desatualizado": ele envenena a AUDITORIA. Sondar
`127.0.0.1:8089` mostra o passado, e qualquer conclusão tirada dali descreve um
código que não existe mais. É a armadilha A4 do PLANO_SUPERFICIE_BOTS_20260826.

────────────────────────────────────────────────────────────────────────────
POR QUE O CRITÉRIO NÃO É `vcs.modified`, QUE SERIA O ÓBVIO

O plano mandava, textualmente, "reprovar `vcs.modified=true`". **Medido na
execução: esse gate ficaria VERMELHO PARA SEMPRE nesta máquina.** O Go marca
`vcs.modified=true` quando QUALQUER arquivo rastreado está modificado — e os
timers do portal reescrevem JSONL de `data/ops/` continuamente. No momento da
medição: 91 arquivos sujos, dos quais UM era Go (`go.sum`). Este worktree nunca
estará limpo, por desenho.

Gate que não pode passar é bug do gate (R22 do plano, e o CONTRATO_DADO_REAL R2:
"gate vermelho não é veredito"). O critério correto é o que responde à pergunta
que importa — *o binário embarca o código de hoje?* — e esse é `vcs.revision`:

    reprova  <=>  existe commit que tocou internal/, cmd/, go.mod ou go.sum
                  DEPOIS do commit que o binário declara em vcs.revision

Arquivo de dado sujo não reprova. Commit de código não embarcado, sim.

────────────────────────────────────────────────────────────────────────────
O QUE ELE NÃO COBRE, dito por extenso

- Não vê alteração NÃO COMMITADA de código: se alguém editar um `.go` e não
  commitar, `vcs.revision` continua batendo. A guarda contra isso é o aviso de
  `vcs.modified` sobre arquivos Go, emitido como INFORMAÇÃO, nunca como falha.
- Não vê o binário do nginx nem o do cloudflared. Desde 2026-09-11 ele cobre os
  TRÊS binários Go que servem unit — `wikijuridica-server`, `wikijuridica-social`
  e `cerebro` —, cada um contra o fecho de pacotes do seu próprio `cmd/`.
- Não prova que o processo VIVO usa o arquivo medido: se alguém trocar
  `bin/wikijuridica-server` sem reiniciar, o disco está novo e a memória velha.
  Por isso o gate compara também o mtime do binário com o início do processo.
"""

import json
import os
import subprocess
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
# WIKI_BINARIO existe para TESTAR o gate: o binário de produção não pode ser
# trocado com o processo vivo ("Text file busy"), então provar que ele reprova
# um binário defasado exige apontá-lo para outro arquivo. Em produção fica no
# default.
BINARIO = os.environ.get("WIKI_BINARIO") or os.path.join(RAIZ, "bin/wikijuridica-server")
SERVICO = "wikijuridica-server"

# ★ TRES BINARIOS SERVEM UNIT, E ATE 2026-09-11 O GATE OLHAVA UM.
#
# O docstring acima dizia por extenso "so o servidor Go", e o preco apareceu
# hoje: `b4fe2ba1` (a retentativa do corte da extracao, que tirava tres acordaos
# da lapide permanente) foi commitado 01:45 e o `bin/cerebro` em execucao era de
# 21:58 do dia anterior. O conserto ficou morto no disco por quatro horas e
# ficaria indefinidamente, porque `bin/cerebro` nao tem caminho de build
# automatico — a unit so diz, em comentario, "construido por ./tools/go-modern
# build -o bin/cerebro ./cmd/cerebro/". Binario que ninguem reconstroi e codigo
# que nao roda, e gate que nao olha e defeito que ninguem ve.
#
# O FECHO E POR PACOTE, NAO PELA ARVORE. Usar `CAMINHOS_DE_CODIGO` inteiro para
# `bin/cerebro` deixaria este gate VERMELHO PARA SEMPRE — qualquer commit em
# `internal/render` reprovaria um binario que nao importa `internal/render`. E
# "gate que nao pode passar e bug do gate", que e a regra que o proprio
# docstring aplicou para recusar `vcs.modified`. O fecho sai de
# `go-modern list -deps`, que o §1 do CLAUDE.md sanciona para exatamente isto.
#
# O PONTO CEGO, nomeado e nao resolvido: `list -deps` le o HEAD, nao o fecho de
# quando o binario nasceu. Pacote que SAIU do fecho depois do build nao reprova.
# O buraco e estreito (pacote que sai deixa de influir no binario novo) e o
# conserto exigiria guardar o fecho junto do binario — decisao para quando
# houver caso, nao hoje.
ALVOS = (
    {"nome": "server", "binario": "bin/wikijuridica-server",
     "servico": "wikijuridica-server", "pacote": "./cmd/server"},
    {"nome": "social", "binario": "bin/wikijuridica-social",
     "servico": "wikijuridica-social", "pacote": "./cmd/social"},
    {"nome": "cerebro", "binario": "bin/cerebro",
     "servico": "wikijuridica-cerebro", "pacote": "./cmd/cerebro"},
)
# Como reconstruir cada um, nomeado na mensagem de falha: gate sem drenador e
# vermelho que ninguem apaga.
# ★ O DRENADOR DO server E DO social E O DEPLOY, NAO O `deploy-binario-go`
# (2026-09-11). A primeira redacao desta tabela apontava os dois para
# `deploy-binario-go`, e MEDIDO no arquivo ele e server-only:
# `BINARIO_VIVO = "bin/wikijuridica-server"`, `SERVICO = "wikijuridica-server"`,
# build de `./cmd/server` (linhas 95-99 e 273). Ele nao conhece `cmd/social`.
# Quem reconstroi os dois e `deploy-publico` com `REBUILD=1`, que e o default:
# compila `bin/wikijuridica-server.next` e `bin/wikijuridica-social.next`
# (linhas 495 e 502) e troca os dois no passo 4 (849 e 864). `deploy-binario-go`
# continua sendo o caminho para trocar O SERVIDOR sem republicar o acervo.
#
# Nomear a ferramenta errada aqui e "comentario que mente", so que na saida de um
# gate: quem lesse depois de uma publicacao rodaria a outra por cima.
DRENADOR = {
    "server": "./tools/deploy-publico (REBUILD=1, o default) "
              "ou ./tools/deploy-binario-go para trocar so o binario",
    "social": "./tools/deploy-publico (REBUILD=1, o default) — "
              "deploy-binario-go NAO conhece cmd/social",
    "cerebro": "./tools/deploy-cerebro",
}
# Caminhos cujo commit MUDA o comportamento do binário.
#
# ★ ARQUIVO DE TESTE NÃO ENTRA NO BINÁRIO (2026-09-05).
# `go build` não compila `*_test.go` — só `go test` o faz, num binário
# descartável. Contá-los aqui produzia vermelho por commit que não pode ter
# mudado nada do que roda em produção: medido em 2026-09-05, dos 4 commits
# acusados sobre vcs.revision=6a293de6, DOIS eram só arquivo de teste
# (91b34f05 em internal/redesocialcompletude, e0fae8e9 em
# internal/contract/checkmeta). Com a exclusão restam 2a14a29f e 4b04bb75, que
# são código de produção de verdade — o gate continua vermelho, e certo.
#
# Isso NÃO é afrouxamento: é a diferença entre o que o compilador inclui e o
# que ele descarta. E é a exclusão mais estreita possível de propósito.
# `testdata/` NÃO entra na lista mesmo hoje não havendo nenhum `//go:embed`
# apontando para lá (verificado em 2026-09-05,
# `grep -rn go:embed internal/ cmd/ | grep -i testdata` devolve zero): a
# ausência de embed é uma condição que uma linha futura muda em silêncio,
# enquanto "o compilador não compila _test.go" é do toolchain e não muda.
#
# O pathspec do git sem `:(glob)` deixa `*` casar `/`, então `*_test.go`
# alcança `internal/x/y_test.go` em qualquer profundidade.
CAMINHOS_DE_CODIGO = ["internal/", "cmd/", "go.mod", "go.sum"]
EXCLUSOES_DE_CODIGO = [":(exclude)*_test.go"]


def roda(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60, cwd=RAIZ, **kw)


def revisao_do_binario(binario: str = "") -> tuple[str | None, bool]:
    """(vcs.revision, vcs.modified) declarados no binário."""
    r = roda([os.path.join(RAIZ, "tools/go-modern"), "version", "-m", binario or BINARIO])
    rev, mod = None, False
    for linha in (r.stdout or "").split("\n"):
        campos = linha.split()
        if len(campos) >= 2 and campos[0] == "build":
            if campos[1].startswith("vcs.revision="):
                rev = campos[1].split("=", 1)[1]
            elif campos[1].startswith("vcs.modified="):
                mod = campos[1].split("=", 1)[1] == "true"
    return rev, mod


def fecho_de_caminhos(pacote: str) -> tuple[list[str] | None, str]:
    """Diretórios do repo que o binário de `pacote` de fato compila.

    `go list -deps` devolve os import paths do fecho; os do módulo começam por
    `portaljuridico/` e viram caminho relativo à raiz. `go.mod`/`go.sum` valem
    para todos os alvos por construção.
    """
    r = roda([os.path.join(RAIZ, "tools/go-modern"), "list", "-deps", pacote])
    if r.returncode != 0:
        return None, (r.stderr or r.stdout or "").strip().split("\n")[-1]
    caminhos = {
        p[len("portaljuridico/"):] + "/"
        for p in (r.stdout or "").split()
        if p.startswith("portaljuridico/")
    }
    if not caminhos:
        return None, f"fecho vazio para {pacote}"
    return sorted(caminhos) + ["go.mod", "go.sum"], ""


def verifica_alvo(alvo: dict) -> tuple[list[str], list[str], str]:
    """(problemas, avisos, linha_ok) de UM binário."""
    problemas: list[str] = []
    avisos: list[str] = []
    nome = alvo["nome"]
    binario = os.environ.get(f"WIKI_BINARIO_{nome.upper()}") or (
        BINARIO if nome == "server" else os.path.join(RAIZ, alvo["binario"])
    )

    if not os.path.exists(binario):
        return [f"[{nome}] binario ausente: {binario}"], [], ""

    rev, modificado = revisao_do_binario(binario)
    if not rev:
        return [f"[{nome}] o binario nao declara vcs.revision "
                "(construido fora do caminho sancionado?)"], [], ""

    caminhos, erro = fecho_de_caminhos(alvo["pacote"])
    if caminhos is None:
        # Falha ALTO: alargar o escopo em silêncio produziria vermelho por
        # commit que não toca este binário, e estreitá-lo esconderia defasagem.
        problemas.append(f"[{nome}] nao consegui derivar o fecho de {alvo['pacote']}: {erro}")
        caminhos = CAMINHOS_DE_CODIGO

    if roda(["git", "cat-file", "-e", rev + "^{commit}"]).returncode != 0:
        problemas.append(
            f"[{nome}] vcs.revision={rev[:12]} nao existe neste repositorio — "
            "binario de outra arvore ou commit perdido"
        )
    else:
        r = roda(["git", "log", "--oneline", f"{rev}..HEAD", "--"]
                 + caminhos + EXCLUSOES_DE_CODIGO)
        atrasados = [l for l in (r.stdout or "").strip().split("\n") if l.strip()]
        if atrasados:
            problemas.append(
                f"[{nome}] {len(atrasados)} commit(s) do FECHO de {alvo['pacote']} "
                f"DEPOIS do binario (vcs.revision={rev[:12]}); reconstrua com "
                f"{DRENADOR.get(nome, '(sem drenador nomeado)')}:"
            )
            for l in atrasados[:8]:
                problemas.append(f"      {l}")
            if len(atrasados) > 8:
                problemas.append(f"      ... e mais {len(atrasados) - 8}")

    # O processo vivo usa este arquivo? (disco novo + memória velha)
    r = roda(["systemctl", "show", alvo["servico"], "-p", "ExecMainStartTimestampMonotonic",
              "-p", "ExecMainStartTimestamp", "--value"])
    inicio = (r.stdout or "").strip().split("\n")[0]
    if inicio:
        rp = roda(["date", "-d", inicio, "+%s"])
        try:
            t_proc = int((rp.stdout or "0").strip())
            t_bin = int(os.path.getmtime(binario))
            if t_bin > t_proc:
                problemas.append(
                    f"[{nome}] o binario em disco e MAIS NOVO que o processo em execucao "
                    f"({t_bin - t_proc}s) — falta reiniciar {alvo['servico']}"
                )
        except ValueError:
            avisos.append(f"[{nome}] nao consegui converter o inicio do processo ({inicio!r})")

    # Informação, nunca falha: worktree Go sujo.
    if modificado:
        r = roda(["git", "status", "--porcelain", "--", "*.go", "go.mod", "go.sum"])
        sujos = [l for l in (r.stdout or "").strip().split("\n") if l.strip()]
        if sujos:
            avisos.append(
                f"[{nome}] vcs.modified=true com {len(sujos)} arquivo(s) Go sujo(s) — "
                "o binario pode conter codigo nao commitado:"
            )
            avisos.extend(f"      {l}" for l in sujos[:5])
        else:
            avisos.append(
                f"[{nome}] vcs.modified=true, mas NENHUM arquivo Go esta sujo — e so dado "
                "(os timers reescrevem data/ops continuamente). Por isso este gate "
                "NAO reprova por vcs.modified."
            )
    return problemas, avisos, f"{nome}={rev[:12]} ({len(caminhos) - 2} pacotes no fecho)"


def main() -> int:
    problemas: list[str] = []
    avisos: list[str] = []
    oks: list[str] = []
    for alvo in ALVOS:
        p, a, ok = verifica_alvo(alvo)
        problemas.extend(p)
        avisos.extend(a)
        if ok:
            oks.append(ok)

    for a in avisos:
        print(f"  info: {a}" if not a.startswith("      ") else a)
    if problemas:
        print("check-binario-vs-fonte: FAIL")
        for p in problemas:
            print(f"  - {p}" if not p.startswith("      ") else p)
        return 1
    print(f"check-binario-vs-fonte: OK ({' · '.join(oks)}; sem commit de codigo posterior)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
