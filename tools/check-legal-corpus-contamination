#!/usr/bin/env python3
"""check-legal-corpus-contamination — o corpus em disco é ponto fixo do extrator?

POR QUE EXISTE, e por que `check-legal-corpus-extractor` não bastava. Aquele
gate prova o EXTRATOR contra fixtures de HTML oficial e confere uma lista
NOMINAL de dispositivos no disco. Nenhum dos dois alcança a pergunta que
importa depois de uma regeneração: *os 8.852 artigos que estão gravados agora
saíram do extrator como ele é hoje?*

Foi essa lacuna que deixou, até 2026-09-10, contaminação a montante passar
verde por um mês inteiro em dado consumido por `internal/legalcorpusindex` (que
decide se uma citação do acervo aponta para artigo existente) e pelos geradores
de página. Medido no corpus daquela data, antes da correção do fatiador:

    1.541 de 8.830 artigos (17,5%)  cabeçalho de divisão dentro do corpo
       56 artigos (0,6%)            ordinal do próprio número como 1ª letra do caput
       25 artigos                   promulgação, assinaturas e rodapé do DOU
       24 artigos                   JavaScript do WAF do Planalto (`f5_cspm`)
      145 artigos                   controle C1 no lugar de travessão e aspas
        1 artigo                    sufixo perdido: o art. 7-A do CTB gravado
                                    como art. 7, sobrescrevendo o art. 7 real

O CRITÉRIO CENTRAL NÃO TEM NÚMERO MÁGICO, e é isso que o torna sustentável:
para cada corpo gravado, este gate reaplica `fim_do_dispositivo` do PRÓPRIO
extrator. Se o corte ainda encontra o que cortar, o corpo não é ponto fixo — ou
o dado está velho em relação ao extrator, ou o extrator regrediu. Nos dois casos
a resposta é regenerar `tools/generate-legal-corpus`, nunca afrouxar a régua.

DUAS REGRAS AQUI *NÃO* SÃO PONTO FIXO, e ficam nomeadas para que ninguém as
tome por derivadas:

  1. `PISO_DE_NOTAS_DE_VIGENCIA` é um piso medido, não derivado. Ele existe
     porque a falha simétrica da contaminação é a AMPUTAÇÃO, e amputação não
     tem ponto fixo que a denuncie: um extrator que cortasse cedo demais
     produziria corpos que são ponto fixo dele mesmo. A contagem de notas é o
     único sinal barato de que o texto oficial continua inteiro.
  2. `SUFIXO_PERDIDO_RE` é heurística de FORMA, não de ponto fixo: ela reconhece
     o caput que começa no segundo segmento do sufixo do próprio cabeçalho
     ("A. Quando os delitos deste Capítulo…", que era o art. 359-M-A do Código
     Penal gravado como art. 359-M). Está aqui porque esse defeito NÃO aparece
     em `fim_do_dispositivo` — ele nasce em `ARTIGO_RE`, antes do corte — e foi
     ele que apagou dois artigos do Código Penal e um do CTB.

O QUE ELE NÃO COBRA, de propósito: nota de vigência. "(Redação dada pela Lei nº
13.146, de 2015)", "(Vide ADI 6050)", "(Revogado)" e "(Vigência)" são TEXTO
OFICIAL do dispositivo e carregam a informação mais importante que existe sobre
ele — se ainda vale. O extrator depende delas para escolher a redação vigente
(`Redação dada pel|Incluíd[oa] pel` no corpo). Este gate CONTA as notas e
reprova se o total desabar, porque queda de nota é amputação, não limpeza.

Read-only: não escreve nada. Roda em segundos.

Uso:
    tools/check-legal-corpus-contamination
    tools/check-legal-corpus-contamination --detalhe
"""
from __future__ import annotations

import argparse
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
CORPUS = os.path.join(ROOT, "data/legal-corpus")

# Piso medido em 2026-09-10, depois da correção, sobre os 29 diplomas. Não é
# meta nem tolerância: é o número que o extrator corrigido produz. Queda de
# notas abaixo disto significa que alguém passou a cortar texto do artigo.
PISO_DE_NOTAS_DE_VIGENCIA = 2900


def carregar_extrator():
    """Importa `tools/generate-legal-corpus` — ele não tem extensão .py.

    A régua deste gate É o extrator. Reimplementar as expressões aqui criaria
    duas verdades, e a divergência entre elas apareceria como gate verde sobre
    dado sujo — exatamente o modo de falha que este arquivo existe para fechar.
    """
    caminho = os.path.join(ROOT, "tools/generate-legal-corpus")
    spec = importlib.util.spec_from_loader(
        "generate_legal_corpus",
        importlib.machinery.SourceFileLoader("generate_legal_corpus", caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


# O ordinal do próprio cabeçalho sobrando como primeira letra do caput. O "O"
# MAIÚSCULO é artigo definido legítimo ("O presente código estabelece…") e fica
# fora: medido em 2026-09-10, são 2.123 caputs que começam assim.
ORDINAL_SOLTO_RE = re.compile(r"^[ \t\r\n]*[º°o](?![\wÀ-ÿ])")

# Fecho da publicação: a fórmula do art. 84, IV da Constituição, o rodapé do
# Planalto e a assinatura presidencial não são texto de dispositivo nenhum.
FECHO_RE = re.compile(
    r"d[ao]\s+Independ[êe]ncia\s+e\s+\d{1,3}\s*[º°o]?\s*d[ao]\s+Rep[úu]blica"
    r"|Este texto n[ãa]o substitui o publicado")

# Conteúdo de <script>: `<[^>]+>` troca a tag por espaço e preserva o miolo.
SCRIPT_RE = re.compile(r"f5_cspm|wp\.loadEventEnd|document\.getElementById")

# Controle C1: cp1252 lido como latin-1 transforma travessão, aspa curva e
# apóstrofo em caractere de controle invisível, e a frase sai mutilada.
CONTROLE_C1_RE = re.compile("[" + "".join(chr(c) for c in range(0x80, 0xa0)) + "]")

# Nota de vigência — CONTADA, nunca reprovada por existir.
NOTA_DE_VIGENCIA_RE = re.compile(
    r"\(\s*(?:Reda[çc][ãa]o dada|Inclu[íi]d[oa]|Acrescid[oa]|Renumerad[oa]"
    r"|Revogad[oa]|Vide|Vig[êe]ncia|Vetado|Regulamento|Execu[çc][ãa]o suspensa)",
    re.IGNORECASE)

# O sufixo do dispositivo pertence à CHAVE, não ao corpo. A forma é a que
# OCORREU, não uma família inventada: letra maiúscula sozinha, com hífen
# opcional antes, seguida IMEDIATAMENTE de ponto — "A. Quando os delitos deste
# Capítulo…" (art. 359-M-A do Código Penal gravado como 359-M) e "-A. A
# autoridade portuária…" (art. 7-A do CTB gravado como art. 7).
#
# O PONTO É OBRIGATÓRIO de propósito: com `[.\-–—]` no lugar dele, um caput que
# abrisse direto no inciso ("I - as fontes de recursos…") casaria, e a régua
# passaria a acusar texto legítimo. Nenhum inciso do corpus escreve "I." — o
# Planalto usa travessão —, e é essa diferença que separa as duas formas.
SUFIXO_PERDIDO_RE = re.compile(r"^[ \t\r\n]*-?[A-Z]\s*\.\s")


def classifica(modulo, corpo):
    """Motivos pelos quais este corpo não é ponto fixo do extrator."""
    motivos = []
    if modulo.fim_do_dispositivo(corpo) != corpo:
        motivos.append("corte_pendente")
    if ORDINAL_SOLTO_RE.match(corpo):
        motivos.append("ordinal_solto_no_caput")
    if FECHO_RE.search(corpo):
        motivos.append("fecho_da_publicacao")
    if SCRIPT_RE.search(corpo):
        motivos.append("javascript_do_waf")
    if CONTROLE_C1_RE.search(corpo):
        motivos.append("controle_c1")
    if SUFIXO_PERDIDO_RE.match(corpo):
        motivos.append("sufixo_perdido_no_cabecalho")
    return motivos


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--detalhe", action="store_true",
                        help="imprime cada artigo contaminado, com o trecho")
    args = parser.parse_args()

    modulo = carregar_extrator()
    arquivos = sorted(glob.glob(os.path.join(CORPUS, "*.json")))
    if not arquivos:
        print("nenhum diploma em %s" % os.path.relpath(CORPUS, ROOT), file=sys.stderr)
        return 2

    falhas = []
    total_artigos = total_notas = 0
    por_motivo = {}
    print("=== CORPUS LEGAL: o dado é ponto fixo do extrator? ===")
    print("diplomas: %d" % len(arquivos))
    print()
    print("%-22s %7s %9s %7s" % ("diploma", "artigos", "sujos", "notas"))
    print("-" * 50)
    for caminho in arquivos:
        slug = os.path.basename(caminho)[:-5]
        with open(caminho, encoding="utf-8") as handle:
            artigos = json.load(handle).get("articles", {})
        sujos = 0
        for numero, corpo in sorted(artigos.items()):
            motivos = classifica(modulo, corpo)
            if NOTA_DE_VIGENCIA_RE.search(corpo):
                total_notas += 1
            if not motivos:
                continue
            sujos += 1
            for motivo in motivos:
                por_motivo[motivo] = por_motivo.get(motivo, 0) + 1
            falhas.append("%s art. %s: %s" % (slug, numero, ",".join(motivos)))
            if args.detalhe:
                limpo = " ".join(corpo.split())
                cortado = " ".join(modulo.fim_do_dispositivo(corpo).split())
                print("  %-18s art %-8s %s" % (slug, numero, ",".join(motivos)))
                print("           sobra: %r" % limpo[len(cortado):][:110])
        total_artigos += len(artigos)
        print("%-22s %7d %9d %7s" % (slug, len(artigos), sujos,
                                     "" if not sujos else "!"))
    print("-" * 50)
    print("%-22s %7d %9d %7d" % ("TOTAL", total_artigos, len(falhas), total_notas))

    if por_motivo:
        print("\npor motivo:")
        for motivo, quantos in sorted(por_motivo.items(), key=lambda p: -p[1]):
            print("  %-30s %d" % (motivo, quantos))

    if total_notas < PISO_DE_NOTAS_DE_VIGENCIA:
        falhas.append(
            "notas de vigência caíram para %d (piso medido: %d) — queda de nota é "
            "amputação de texto oficial, não limpeza de sujeira"
            % (total_notas, PISO_DE_NOTAS_DE_VIGENCIA))

    if falhas:
        print("\nREPROVADO — %d artigo(s)/condição(ões) fora do ponto fixo." % len(falhas))
        for problema in falhas[:40]:
            print("  - %s" % problema)
        if len(falhas) > 40:
            print("  … e %d outros (use --detalhe)" % (len(falhas) - 40))
        print("\n  o conserto é regenerar o corpus com o extrator atual:")
        print("    PLANALTO_CACHE=<cache> tools/generate-legal-corpus")
        print("  e NUNCA afrouxar a régua deste gate.")
        return 1

    print("\nAPROVADO — todo corpo gravado é ponto fixo do extrator, "
          "com %d notas de vigência preservadas." % total_notas)
    return 0


if __name__ == "__main__":
    sys.exit(main())
