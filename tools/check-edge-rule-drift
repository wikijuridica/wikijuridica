#!/usr/bin/env python3
"""check-edge-rule-drift — a borda serve o que o repositorio declara?

READ-ONLY. Sai != 0 quando o ruleset de cache da zona diverge do corpo
versionado em ops/cloudflare/cache-rules.json.

POR QUE EXISTE, e o precedente e de cinco dias atras. Em 2026-08-22T13:10:13Z a
Cache Rule da zona foi ESVAZIADA: ruleset na versao 14 com ZERO regras. O acervo
inteiro passou a atravessar o tunel a cada requisicao, e a cobertura de cache de
borda caiu para 0,0% -- 40 de 40 amostras `DYNAMIC`. O alarme do proprio portal
disparou a cada duas horas por cinco dias, e ninguem consumiu.

O QUE JA EXISTIA E NAO PEGOU: `tools/check-edge-vary-contract` le o mesmo
endpoint e SAI VERDE com zero regras vivas -- ele confere a forma do bloco
`vary` quando existe regra, e nao ha regra nenhuma para conferir. Gate verde
sobre mundo vazio.

Este gate reprova explicitamente o caso `rules` ausente ou vazio, que e o de
hoje, e compara regra a regra com o corpo versionado.

E REGISTRA A VERSAO VIVA do ruleset: foi o historico de versoes da API o UNICO
instrumento que conseguiu DATAR a derivacao (v7 em 18/08 com a regra boa, v8 em
21/08 ja vazia, v9-v11 com templates de painel, v12-v14 em NOVE SEGUNDOS ate
zerar). Sem esse campo, "quando comecou" e adivinhacao.

Credencial: tools/cloudflare_auth.py resolve CLOUDFLARE_ZONE_TOKEN (Bearer de
zona, menor privilegio) com fallback para CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN
(Global API Key, cabecalhos X-Auth-Email/X-Auth-Key -- essa credencial devolve
"Invalid API Token" se tentada como Bearer, medido em 2026-08-26; nao esta
invalida, so tem outro modo de autenticar). Ver a docstring daquele modulo
para a medicao completa.
"""
import json
import os
import sys
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import cloudflare_auth  # noqa: E402  (tools/ nao e pacote; o caminho entra acima)

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
CANONICO = os.path.join(RAIZ, "ops/cloudflare/cache-rules.json")
ENV = os.path.join(RAIZ, ".env.local")
FASE = "http_request_cache_settings"
API = "https://api.cloudflare.com/client/v4"


def ambiente():
    return cloudflare_auth.ambiente(ENV)


# CREDENCIAL CENTRALIZADA em tools/cloudflare_auth.py desde 2026-09-03 (antes,
# a logica abaixo estava copiada em 10 ferramentas e importada por
# SourceFileLoader em mais 4 -- a explicacao completa de "duas formas de
# credencial" mora agora na docstring do modulo).
#
# Esta funcao continua aqui, com este NOME e esta ASSINATURA, de proposito:
# check-cache-rule-viva, check-edge-tiered-drift,
# check-cache-rule-rollback-frescor e generate-cache-rule-rollback importam
# ESTE arquivo por SourceFileLoader e chamam `ambiente()` e
# `_credenciais(env, precisa_escrever=...)` nele -- a suite de teste de dois
# deles monta um modulo falso com exatamente esta forma. Trocar nome ou
# assinatura quebra os quatro sem tocar em nenhum deles.
#
# O `if precisa_escrever` espelha o controle de fluxo original: tenta a Global
# API Key (unica com escopo de escrita); se ela nao existir, cai para
# `cabecalhos("leitura", ...)`, que tenta o Bearer de zona antes da Global Key
# -- nunca None so porque a operacao pretendia escrever mas so o token de
# zona existe (esse caso vira 403 limpo no PUT, nao uma excecao aqui).
def _credenciais(env, precisa_escrever=False):
    """Devolve (cabecalhos, rotulo). Bearer de zona para leitura; Global API Key
    quando a operacao escreve, porque o Bearer de zona nao tem esse escopo."""
    if precisa_escrever:
        cab, rotulo = cloudflare_auth.cabecalhos("escrita", env=env)
        if cab is not None:
            return cab, rotulo
    return cloudflare_auth.cabecalhos("leitura", env=env)


def pega(url, cabecalhos):
    req = urllib.request.Request(url, headers=cabecalhos)
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode("utf-8"))


def normaliza(regra):
    """Compara o que DECIDE comportamento, ignorando o que a API acrescenta
    (id, version, ref, last_updated) e a descricao, que e texto humano."""
    return {
        "action": regra.get("action"),
        "expression": " ".join((regra.get("expression") or "").split()),
        "enabled": regra.get("enabled", True),
        "action_parameters": regra.get("action_parameters") or {},
    }


def main():
    env = ambiente()
    zona = env.get("CLOUDFLARE_ZONE_ID", "b2e1366a94c5dcac97f2fc264f18928f")
    cabecalhos, rotulo = _credenciais(env)
    if cabecalhos is None:
        print("check-edge-rule-drift: FAIL\n  - sem credencial Cloudflare em .env.local")
        return 1
    try:
        resp = pega(f"{API}/zones/{zona}/rulesets/phases/{FASE}/entrypoint", cabecalhos)
    except urllib.error.HTTPError as e:
        print(f"check-edge-rule-drift: FAIL\n  - API respondeu {e.code}: {e.reason}")
        return 1
    except Exception as e:
        print(f"check-edge-rule-drift: FAIL\n  - nao consegui ler o ruleset: {e}")
        return 1
    if not resp.get("success"):
        print(f"check-edge-rule-drift: FAIL\n  - API sem sucesso: {resp.get('errors')}")
        return 1

    vivo = resp["result"]
    regras_vivas = vivo.get("rules") or []
    print(f"ruleset : {vivo.get('name')}")
    print(f"version : {vivo.get('version')} | last_updated: {vivo.get('last_updated')}")
    print(f"regras vivas: {len(regras_vivas)}")

    with open(CANONICO, encoding="utf-8") as f:
        regras_canonicas = (json.load(f).get("rules") or [])
    print(f"regras versionadas em {os.path.relpath(CANONICO, RAIZ)}: {len(regras_canonicas)}")

    # O CASO DE HOJE, e o que o gate irmao atravessa em verde.
    if not regras_vivas:
        print("check-edge-rule-drift: FAIL")
        print("  - a zona esta com ZERO regras de cache. Todo o acervo atravessa o tunel")
        print("    a cada requisicao, e a cobertura de cache de borda e 0%.")
        print(f"    O repositorio declara {len(regras_canonicas)} regra(s) que nao estao no ar.")
        print("  Aplicar com: tools/apply-cache-rules")
        return 1

    vv = [normaliza(r) for r in regras_vivas]
    vc = [normaliza(r) for r in regras_canonicas]
    if vv == vc:
        print("check-edge-rule-drift: OK (a borda serve exatamente o que o repositorio declara)")
        return 0

    print("check-edge-rule-drift: FAIL")
    print("  - o ruleset vivo DIVERGE do corpo versionado.")
    for i in range(max(len(vv), len(vc))):
        a = vv[i] if i < len(vv) else None
        b = vc[i] if i < len(vc) else None
        if a == b:
            continue
        print(f"    regra {i}:")
        if a is None:
            print("      falta no ar:", (regras_canonicas[i].get('description') or '')[:100])
            continue
        if b is None:
            print("      sobra no ar:", (regras_vivas[i].get('description') or '')[:100])
            continue
        for chave in ("action", "enabled", "expression", "action_parameters"):
            if a.get(chave) != b.get(chave):
                print(f"      {chave}:")
                print(f"        no ar        : {json.dumps(a.get(chave), ensure_ascii=False)[:220]}")
                print(f"        versionado   : {json.dumps(b.get(chave), ensure_ascii=False)[:220]}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
