#!/usr/bin/env bash
# tools/check-load-headroom — READ-ONLY.
#
# Gate de carga: exit 0 se há headroom (load1 < --max), exit 1 caso contrário.
# Todo comando pesado deve passar por aqui antes de rodar:
#
#   tools/check-load-headroom --max 12 && nice -n 10 ./tools/go-modern build ./...
#
# Uso:
#   tools/check-load-headroom                       # checa 1x, max=10.0, sem esperar
#   tools/check-load-headroom --max 8.5              # limite customizado
#
# Flags:
#   --max FLOAT     opcional, default 10.0. Limite de load1 considerado seguro.
#   --wait 0        compatibilidade explícita. Espera positiva é recusada:
#                   não faça polling passivo; avance em frente independente e
#                   reavalie uma vez quando houver comando pesado executável.
set -euo pipefail

MAX="10.0"
WAIT="0"

usage() {
	echo "Uso: tools/check-load-headroom [--max FLOAT] [--wait 0]" >&2
	exit 2
}

while [ $# -gt 0 ]; do
	case "$1" in
	--max)
		[ $# -ge 2 ] || usage
		MAX="$2"
		shift 2
		;;
	--wait)
		[ $# -ge 2 ] || usage
		WAIT="$2"
		shift 2
		;;
	-h | --help) usage ;;
	*)
		echo "flag desconhecida: $1" >&2
		usage
		;;
	esac
done

get_load1() {
	cut -d' ' -f1 /proc/loadavg 2>/dev/null || uptime | sed -E 's/.*load average:? *([0-9.,]+).*/\1/' | tr ',' '.'
}

LOAD1="$(get_load1)"
python3 - "$LOAD1" "$MAX" "$WAIT" <<'PYEOF'
import math
import sys

load_raw, max_raw, wait_raw = sys.argv[1:4]
try:
    load1 = float(load_raw)
    max_value = float(max_raw)
    wait = int(wait_raw)
except ValueError:
    print("erro: --max deve ser float e --wait deve ser inteiro", file=sys.stderr)
    raise SystemExit(2)

if not math.isfinite(max_value) or max_value <= 0:
    print("erro: --max deve ser finito e positivo", file=sys.stderr)
    raise SystemExit(2)
if not math.isfinite(load1) or load1 < 0:
    print(f"erro: load1 inválido: {load_raw}", file=sys.stderr)
    raise SystemExit(1)
if wait != 0:
    print(
        "erro: --wait diferente de zero foi removido para impedir polling/loop passivo; "
        "avance em frente independente e reavalie uma vez antes do próximo comando pesado",
        file=sys.stderr,
    )
    raise SystemExit(2)

if load1 < max_value:
    print(f"headroom OK: load1={load_raw} < max={max_raw}")
    raise SystemExit(0)
print(
    f"sem headroom: load1={load_raw} >= max={max_raw}; "
    "não espere/polle — avance em frente independente",
    file=sys.stderr,
)
raise SystemExit(1)
PYEOF
