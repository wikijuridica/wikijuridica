#!/usr/bin/env bash
# generate-veredito-por-url — grava a série do veredito por URL.
#
# POR QUE ESTE WRAPPER EXISTE, e por que ele e uma linha.
#
# O contrato do repositorio e categorico: "tools/check-* sao read-only;
# tools/generate-* escrevem — misturar os dois papeis e bug" (CLAUDE.md).
# `check-veredito-por-url` nasceu com uma flag `--registrar` que gravava
# `data/ops/veredito_por_url.jsonl` de dentro de um `check-*`. A analise estava
# certa, o papel e que estava errado.
#
# Aqui o papel fica explicito: quem escreve tem nome de quem escreve. O check
# continua podendo ser rodado por qualquer um, a qualquer hora, sem efeito no
# disco -- que e a propriedade que faz dele um check.
set -euo pipefail
cd "$(dirname "$0")/.."
exec ./tools/check-veredito-por-url --registrar "$@"
