#!/usr/bin/env bash
# Gate read-only e fail-closed. O binário aplica snapshot v2readguard, budgets e
# limite de evidência; argumentos não recebem expansão/eval neste wrapper.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
exec "$ROOT/tools/run-go-cmd-cached" ./cmd/check-v2-body-semantic-duplicates "$@"
