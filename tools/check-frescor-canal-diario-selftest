#!/usr/bin/env python3
"""check-frescor-canal-diario-selftest — prova que o gate de frescor não
acusa falso positivo, e que ele PEGA o defeito real quando ele existe.

Read-only: não escreve nada fora de diretórios temporários próprios.
Exercita `tools/check-frescor-canal-diario` como subprocesso — nunca
reimplementa a lógica dele, senão a prova provaria a cópia, não o detector.

DUAS FRENTES DE PROVA:

  1. SOBRE O REPOSITÓRIO REAL — a exigência literal da tarefa que originou
     este gate: rodar contra o estado atual e provar que `/jurisprudencia/`
     e `/sumulas/` NUNCA saem como REPROVA. Esses dois canais têm
     `publication_date` sistematicamente vazio (datam pelo julgamento, não
     pela coleta) e a fonte respondeu 304 (fonte inalterada) — a combinação
     que, com um comparador ingênuo de datas, garantiria falso positivo
     todo dia.

  2. SOBRE FIXTURES SINTÉTICAS — cada cenário isola UMA propriedade e usa
     `--hoje` fixo para não depender do relógio de parede:
       A. canal sazonal com fonte saudável (304) e publication_date vazio
          em TODAS as páginas → OK (a mesma condição da prova 1, controlada).
       B. canal sazonal com a fonte falhando de verdade → REPROVA.
       C. canal de cadência com gap de 1 dia (o normal) → OK.
       D. canal de cadência com gap de 3 dias e coleta OK → REPROVA (a causa
          é publicação que não converteu, não a coleta).
       E. canal de cadência cuja coleta falhou HOJE → REPROVA, mesmo que o
          gap de publicação ainda esteja dentro da tolerância (a falha de
          coleta pesa mais e não deve esperar o gap crescer para acusar).
       F. canal de cadência com páginas publicadas mas NENHUMA com
          publication_date preenchido → REPROVA (contrato quebrado — a
          mesma trap do cenário A, mas em canal que NÃO deveria estar vazio).
       G. canal de cadência cuja coleta GRAVOU o arquivo do dia e ainda assim
          falhou (o estado que o coletor de diários passou a ter em
          2026-09-04: fonte parada, janela cheia, nenhuma edição inédita) →
          REPROVA com o motivo descrevendo ISSO, e nunca "recoletado por
          outro caminho" — não houve recoleta nenhuma.
       H. o mesmo ramo com `--hoje` no passado → o gate compara o arquivo do
          dia contra o `hoje` que recebeu, não contra o relógio de parede.

Uso:
    tools/check-frescor-canal-diario-selftest
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GATE = ROOT / "tools/check-frescor-canal-diario"


def roda_gate(raiz: Path, hoje: str | None = None):
    comando = [sys.executable, str(GATE), "--raiz", str(raiz), "--json"]
    if hoje:
        comando += ["--hoje", hoje]
    resultado = subprocess.run(comando, capture_output=True, text=True)
    try:
        veredito = json.loads(resultado.stdout)
    except json.JSONDecodeError:
        veredito = None
    return resultado.returncode, veredito, resultado.stdout, resultado.stderr


def veredito_do_canal(veredito, canal: str) -> str | None:
    if not veredito:
        return None
    for item in veredito:
        if item["canal"] == canal:
            return item["veredito"]
    return None


def escreve_jsonl(caminho: Path, registros: list[dict]):
    caminho.parent.mkdir(parents=True, exist_ok=True)
    with caminho.open("w", encoding="utf-8") as arquivo:
        for registro in registros:
            arquivo.write(json.dumps(registro, ensure_ascii=False) + "\n")


def linha_ledger(fonte: str, dia: str, ok: bool, saida: str, hora="07:00:00"):
    return {
        "schema_version": "daily_content_collect_v1",
        "medido_em": f"{dia}T{hora}+00:00",
        "fonte": fonte,
        "exit_code": 0 if ok else 1,
        "ok": ok,
        "saida": saida,
    }


def linha_manifest(intent_id: str, path: str):
    return {
        "manifest_id": f"manifest-{intent_id}",
        "unique_intent_id": intent_id,
        "path": path,
        "page_status": "published",
    }


def linha_pagina(intent_id: str, practice_area: str, publication_date: str):
    return {
        "intent_id": intent_id,
        "practice_area": practice_area,
        "publication_date": publication_date,
    }


def falhas():
    problemas = []

    # ---------------------------------------------------- PROVA 1: REAL
    codigo, veredito, saida, err = roda_gate(ROOT)
    if veredito is None:
        problemas.append(f"gate não devolveu JSON válido contra o repositório real: {err}")
    else:
        for canal in ("jurisprudencia", "sumulas"):
            v = veredito_do_canal(veredito, canal)
            if v != "OK":
                problemas.append(
                    f"FALSO POSITIVO sobre dado real: canal {canal} veio {v}, "
                    f"esperava OK (fonte respondeu 304, parado é correto). Saída: {saida}")

    # ------------------------------------------- PROVA 2A: sazonal saudável
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("stj-precedentes", "2026-09-01", True, "temas.csv inalterado (304)"),
            linha_ledger("stf-informativo", "2026-09-01", True, "fonte inalterada (304)"),
        ])
        escreve_jsonl(raiz / "data/editorial/published_manifest.jsonl", [
            linha_manifest("jur-x", "/jurisprudencia/x/"),
            linha_manifest("sum-x", "/sumulas/x/"),
        ])
        escreve_jsonl(raiz / "data/editorial/v2_pages/a.jsonl", [
            linha_pagina("jur-x", "jurisprudencia", ""),
            linha_pagina("sum-x", "sumulas", ""),
        ])
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-01")
        for canal in ("jurisprudencia", "sumulas"):
            v = veredito_do_canal(veredito, canal)
            if v != "OK":
                problemas.append(f"[2A] {canal} veio {v}, esperava OK (304 + publication_date vazio é normal aqui)")

    # -------------------------------------------- PROVA 2B: sazonal falhando
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("stj-precedentes", "2026-09-01", False, "erro: HTTP 500"),
            linha_ledger("stf-informativo", "2026-09-01", True, "fonte inalterada (304)"),
        ])
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-01")
        v = veredito_do_canal(veredito, "sumulas")
        if v != "REPROVA":
            problemas.append(f"[2B] sumulas veio {v}, esperava REPROVA (stj-precedentes falhou de verdade)")
        v = veredito_do_canal(veredito, "jurisprudencia")
        if v != "REPROVA":
            problemas.append(f"[2B] jurisprudencia veio {v}, esperava REPROVA "
                              f"(uma das duas fontes obrigatórias falhou)")

    # -------------------------------------------- PROVA 2C: cadência, gap=1
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("diarios-municipais", "2026-09-02", True, "gravado: ... (300 registros)"),
        ])
        (raiz / "data/research/daily/diarios-municipais").mkdir(parents=True, exist_ok=True)
        (raiz / "data/research/daily/diarios-municipais/2026-09-02.jsonl").write_text("{}\n")
        escreve_jsonl(raiz / "data/editorial/published_manifest.jsonl", [
            linha_manifest("dia-rj-20260901", "/diarios/rj-20260901/"),
        ])
        escreve_jsonl(raiz / "data/editorial/v2_pages/diarios.jsonl", [
            linha_pagina("dia-rj-20260901", "diarios", "2026-09-01"),
        ])
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-02")
        v = veredito_do_canal(veredito, "diarios")
        if v != "OK":
            problemas.append(f"[2C] diarios veio {v}, esperava OK (gap de 1 dia é o normal)")

    # -------------------------------------------- PROVA 2D: cadência, gap=3
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("diarios-municipais", "2026-09-04", True, "gravado: ... (300 registros)"),
        ])
        (raiz / "data/research/daily/diarios-municipais").mkdir(parents=True, exist_ok=True)
        (raiz / "data/research/daily/diarios-municipais/2026-09-04.jsonl").write_text("{}\n")
        escreve_jsonl(raiz / "data/editorial/published_manifest.jsonl", [
            linha_manifest("dia-rj-20260901", "/diarios/rj-20260901/"),
        ])
        escreve_jsonl(raiz / "data/editorial/v2_pages/diarios.jsonl", [
            linha_pagina("dia-rj-20260901", "diarios", "2026-09-01"),
        ])
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-04")
        v = veredito_do_canal(veredito, "diarios")
        if v != "REPROVA":
            problemas.append(f"[2D] diarios veio {v}, esperava REPROVA (gap de 3 dias, coleta OK — "
                              f"publicação não converteu)")

    # ------------------------------------- PROVA 2E: cadência, falha hoje
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("diarios-municipais", "2026-09-01", False, "erro: HTTP 404"),
        ])
        escreve_jsonl(raiz / "data/editorial/published_manifest.jsonl", [
            linha_manifest("dia-rj-20260901", "/diarios/rj-20260901/"),
        ])
        escreve_jsonl(raiz / "data/editorial/v2_pages/diarios.jsonl", [
            linha_pagina("dia-rj-20260901", "diarios", "2026-09-01"),
        ])
        # gap seria 0 (publicado hoje mesmo) — mas a coleta FALHOU, e isso
        # tem que pesar mais do que o gap ainda pequeno.
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-01")
        v = veredito_do_canal(veredito, "diarios")
        if v != "REPROVA":
            problemas.append(f"[2E] diarios veio {v}, esperava REPROVA (coleta falhou hoje, "
                              f"mesmo com gap pequeno)")

    # ------------- PROVA 2G: gravou o arquivo do dia E FALHOU (fonte parada)
    #
    # O estado que o texto do gate DESCREVIA ERRADO. Desde 2026-09-04 o coletor
    # de diários grava o arquivo do dia e ainda assim sai com exit 1 — quando a
    # janela volta cheia sem nenhuma edição inédita (fonte parada) ou quando
    # pagou texto novo sem índice novo. Não houve recoleta nenhuma, e o gate
    # dizia "recoletado por outro caminho. Defeito é de processo, não de
    # frescor": manda procurar um operador que não existe e inverte o
    # diagnóstico — o canal ESTÁ estagnado, e a causa é a fonte.
    #
    # Reprovar continua certo. O que se cobra aqui é a descrição.
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("diarios-municipais", "2026-09-10", False,
                         "gravado: data/research/daily/diarios-municipais/2026-09-10.jsonl "
                         "(166 registros, 0 inédita(s)) erro: 166 edicao(oes) na janela desde "
                         "2026-08-29 e NENHUMA inedita no acervo"),
        ])
        (raiz / "data/research/daily/diarios-municipais").mkdir(parents=True, exist_ok=True)
        (raiz / "data/research/daily/diarios-municipais/2026-09-10.jsonl").write_text("{}\n")
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-10")
        item = next((i for i in (veredito or []) if i["canal"] == "diarios"), None)
        if item is None:
            problemas.append(f"[2G] gate não avaliou o canal diarios: {err or saida}")
        else:
            if item["veredito"] != "REPROVA":
                problemas.append(f"[2G] diarios veio {item['veredito']}, esperava REPROVA "
                                 f"(índice não avançou — o arquivo em disco não desmente isso)")
            if "recoletado" in item["motivo"]:
                problemas.append("[2G] o motivo diz 'recoletado', mas foi a PRÓPRIA coleta que gravou e "
                                 f"falhou; ninguém recoletou nada: {item['motivo']}")
            if "gravou o arquivo do dia" not in item["motivo"]:
                problemas.append("[2G] o motivo tem que descrever o estado real (a coleta gravou e ainda "
                                 f"assim falhou): {item['motivo']}")

    # ------- PROVA 2H: o ramo do arquivo do dia respeita --hoje, não o relógio
    #
    # O gate comparava o arquivo mais recente com `datetime.now()` em vez do
    # `hoje` que ele recebe e usa em todo o resto. Com `--hoje` no passado, um
    # arquivo do dia da fixture era lido como "não há dado do dia" — o ramo
    # inteiro ficava inalcançável em teste, e a descrição errada nunca aparecia.
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("diarios-municipais", "2026-08-20", False, "erro: HTTP 500 na fonte"),
        ])
        (raiz / "data/research/daily/diarios-municipais").mkdir(parents=True, exist_ok=True)
        (raiz / "data/research/daily/diarios-municipais/2026-08-20.jsonl").write_text("{}\n")
        codigo, veredito, saida, err = roda_gate(raiz, "2026-08-20")
        item = next((i for i in (veredito or []) if i["canal"] == "diarios"), None)
        if item is None:
            problemas.append(f"[2H] gate não avaliou o canal diarios: {err or saida}")
        else:
            if item["veredito"] != "REPROVA":
                problemas.append(f"[2H] diarios veio {item['veredito']}, esperava REPROVA (coleta falhou)")
            if "não há dado do dia" in item["motivo"]:
                problemas.append("[2H] o arquivo de 2026-08-20 existe e `--hoje` é 2026-08-20: dizer que "
                                 f"não há dado do dia é comparar contra o relógio de parede: {item['motivo']}")
            if "não diz que foi esta execução" not in item["motivo"]:
                problemas.append("[2H] sem `gravado:` na saída, o gate não pode afirmar quem gravou — tem "
                                 f"que dizer que o ledger não distingue: {item['motivo']}")

    # --------------------------------- PROVA 2F: contrato quebrado (cadência)
    with tempfile.TemporaryDirectory() as tmp:
        raiz = Path(tmp)
        escreve_jsonl(raiz / "data/ops/daily_content_collect.jsonl", [
            linha_ledger("noticias-oficiais", "2026-09-01", True, "gravado: ..."),
        ])
        escreve_jsonl(raiz / "data/editorial/published_manifest.jsonl", [
            linha_manifest("not-x", "/noticias/x/"),
        ])
        escreve_jsonl(raiz / "data/editorial/v2_pages/noticias.jsonl", [
            linha_pagina("not-x", "noticias", ""),  # publication_date VAZIO — não deveria, em cadência
        ])
        codigo, veredito, saida, err = roda_gate(raiz, "2026-09-01")
        v = veredito_do_canal(veredito, "noticias")
        if v != "REPROVA":
            problemas.append(f"[2F] noticias veio {v}, esperava REPROVA (contrato quebrado: "
                              f"canal de cadência sem publication_date)")

    return problemas


def main() -> int:
    problemas = falhas()
    if problemas:
        print(f"check-frescor-canal-diario-selftest: {len(problemas)} propriedade(s) falharam:\n")
        for problema in problemas:
            print(f"  - {problema}")
        return 1
    print("check-frescor-canal-diario-selftest: todas as propriedades OK "
          "(sem falso positivo em jurisprudencia/sumulas reais; "
          "detecta falha de coleta, gap de publicação e contrato quebrado).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
