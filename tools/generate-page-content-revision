# desconsiderar -- e o campo perde valor justamente quando ha novidade real.
#
# A regra: quando a mesma execucao carimba mais de LOTE_MINIMO rotas, ela grava
# o DIA (AAAA-MM-DD), que e verdade sem fingir precisao; abaixo disso grava o
# instante em UTC, que e util para a pagina que mudou sozinha. As duas formas ja
# convivem no ledger por desenho, e o protocolo de sitemap aceita as duas.
LOTE_MINIMO = 50

# TETO DE CHURN — a barreira que faltava, e que em 2026-08-28 foi HUMANA.
#
# Medido no proprio ledger, par a par entre versoes commitadas: em 72 h o acervo
