#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
NPROC="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
exec "$ROOT/tools/run-go-cmd-cached" ./cmd/profile-tests \
	--package ./internal/contract/... \
	--threshold-seconds "${PROFILE_THRESHOLD_SECONDS:-5}" \
	--top "${PROFILE_TOP:-12}" \
	--p "${PROFILE_P:-$NPROC}" \
	--parallel "${PROFILE_PARALLEL:-$NPROC}" \
	--timeout "${PROFILE_TIMEOUT:-20m}" \
	--gomaxprocs "${PROFILE_GOMAXPROCS:-$NPROC}" \
	--cpuprofile "${PROFILE_CPUPROFILE:-}" \
	--memprofile "${PROFILE_MEMPROFILE:-}" \
	--trace "${PROFILE_TRACE:-}" \
	--stream
