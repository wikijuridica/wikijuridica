ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Origin que o tunel serve ao publico (ops/cloudflared/config.yml: ingress ->
# http://127.0.0.1:8088). Bater aqui evita a borda e evita o cache.
ORIGIN_HOST = "http://127.0.0.1:8088"
DEFAULT_URL = "/previdenciario/maternidade-homem/"

# UA proprio para QUALQUER alvo remoto — ver cabecalhos_para(). Mesmo literal
# que tools/check-superficie-bots-live usa, de proposito: um humano lendo o
# access log ve um UNICO prefixo marcando toda sonda de primeira parte.
UA_PROPRIO_BORDA = "wikijuridica-superficie-probe/1.0"

# Mesmo ledger que tools/check-superficie-bots-live grava, mesmo schema
# (edge_probe_requests_v1). tools/check-edge-traffic:LEDGERS_PROPRIOS soma os
# dois; ledger novo nao ganha copia da regra, entra AQUI.
LEDGER_PROPRIO = os.path.join(ROOT, "data/ops/edge_probe_requests.jsonl")


def dominio_publico():
    """URL publica do site.json — nunca hardcoded (contrato do repositorio)."""
    try:
        with open(os.path.join(ROOT, "content/site.json"), encoding="utf-8") as handle:
            return json.load(handle)["base_url"].rstrip("/")
    except (OSError, ValueError, KeyError):
        return ""


def eh_local(host):
    return "127.0.0.1" in host or "localhost" in host or "[::1]" in host


def cabecalhos_para(host, nome_perfil, ua_real):
    """Decide o User-Agent e os cabecalhos extras de uma sonda, PELO ALVO
    (host) — nunca pelo modo escolhido em linha de comando, para que
    `--host https://...` fique tao seguro quanto `--borda`.

    REGRA (2026-09-03, CLAUDE.md: "PROIBIDO self-warming/requests com
    User-Agent de bots reais — FRAUDE"). UA de bot real (Googlebot, GPTBot,
    PerplexityBot etc.) SO sai contra 127.0.0.1: a origem le X-Bot-Simulation
    e exclui a visita do trafego real. Contra QUALQUER alvo remoto — a borda
    publica, que NAO le X-Bot-Simulation — o UA e sempre PROPRIO e declarado;
    a identidade simulada viaja so no UA (sufixo "(simula: <perfil>)").

    O valor de X-Bot-Simulation fica SEMPRE "true", nas duas camadas — nunca o
    nome do bot. internal/httpserver/access_log.go:isWarmingRequest confere
    IGUALDADE EXATA (case-insensitive) com "true"; um valor diferente faria a
    origem gravar bot_simulation=false numa requisicao que, contra a borda,
    pode atravessar ate um MISS de cache e chegar aqui — contaminando o
    proprio ledger de trafego real que este cabecalho existe para blindar.
    X-Warming-Request: true e quem risca a requisicao remota de
    organic_requests (ver LEDGER_PROPRIO)."""
    if eh_local(host):
        return ua_real, {"X-Bot-Simulation": "true"}
    return (
        "%s (simula: %s)" % (UA_PROPRIO_BORDA, nome_perfil),
        {"X-Warming-Request": "true", "X-Bot-Simulation": "true"},
    )


def pedir(host, caminho, nome_perfil, ua_real, timeout=20.0):
    ua, extras = cabecalhos_para(host, nome_perfil, ua_real)
    cabecalhos = {
        "User-Agent": ua,
        "Accept-Encoding": "identity",
        "Accept": "text/html,application/xhtml+xml",
    }
    cabecalhos.update(extras)
    if eh_local(host):
        # Sem o Host correto o nginx cai no server block errado e o canonical
        # sai com 127.0.0.1 — o teste mediria uma pagina que ninguem recebe.
        publico = dominio_publico()
        if publico:
            cabecalhos["Host"] = publico.split("//", 1)[-1]
    pedido = urllib.request.Request(host.rstrip("/") + caminho, headers=cabecalhos)
    try:
        with urllib.request.urlopen(pedido, timeout=timeout) as resposta:
            corpo = resposta.read()
            return resposta.status, corpo, dict(resposta.headers)
    except urllib.error.HTTPError as erro:
        return erro.code, b"", {}
    except Exception as erro:
        return 0, str(erro)[:80].encode(), {}


def analisar(corpo):
    texto = corpo.decode("utf-8", "replace")
    def achar(padrao):
        achado = re.search(padrao, texto, re.I | re.S)
        return achado.group(1).strip() if achado else ""
    scripts = re.findall(r"<script([^>]*)>", texto, re.I)
    # Três categorias, e a distinção importa para saber QUEM consertar:
    #   JSON-LD          — dado estruturado, não executa nada, é o esperado
    #   injetado na borda — o Cloudflare adiciona o beacon do Web Analytics na
    #                       resposta; não está no HTML do repositório e só o
    #                       titular da conta pode desligar
    #   do projeto        — JS que o render emitiu: violação de contrato nossa
    naolds = [s for s in scripts if "application/ld+json" not in s.lower()]
    borda = [s for s in naolds if "cloudflareinsights.com" in s.lower() or "cf-beacon" in s.lower()]
    # QUARTA categoria, desde 2026-08-19: o registro de ferramentas WebMCP, que e
    # script executavel AUTORIZADO (emenda do dono para integracao de agente de
    # IA), inline, sem atributos, e liberado na CSP por hash sha256. Ele nao e
    # violacao de contrato — e superficie de agente deliberada. O gate byte a byte
    # vive no Go; aqui desconta-se pelo marcador unico do corpo.
    webmcp = 1 if "document.modelContext||navigator.modelContext" in texto else 0
    executaveis = [s for s in naolds if s not in borda]
    if webmcp and executaveis:
        # a tag do WebMCP e `<script>` sem atributos: remove UMA ocorrencia vazia
        for i, atributos in enumerate(executaveis):
            if not atributos.strip():
                del executaveis[i]
                break
    return {
        "title": achar(r"<title>(.*?)</title>"),
        "meta": achar(r'<meta name="description" content="(.*?)"'),
        "h1": re.sub(r"<[^>]+>", "", achar(r"<h1[^>]*>(.*?)</h1>")),
        "canonical": achar(r'<link rel="canonical" href="(.*?)"'),
        "robots": achar(r'<meta name="robots" content="(.*?)"'),
        "jsonld": len(re.findall(r'application/ld\+json', texto, re.I)),
        "links_internos": len(re.findall(r'href="/[a-z]', texto)),
        "js_executavel": len(executaveis),
        "js_da_borda": len(borda),
        "whatsapp": texto.count("wa.me"),
        "relacionados": 1 if "Conteúdos relacionados" in texto else 0,
        "texto_visivel": len(re.sub(r"<[^>]+>", " ", texto).split()),
    }


def cf_cache_status(headers):
    """Le cf-cache-status de um dict de headers HTTP, sem depender de caixa —
    `dict(resposta.headers)` preserva a caixa que o servidor mandou
    (Cloudflare envia "CF-Cache-Status"), e um .get() literal minusculo
    perderia o valor. 2026-09-03: sem isto, o modo --borda nao dizia se a
    requisicao foi respondida pela BORDA (HIT) ou alcancou a origem (MISS) —
    exatamente o que prova qual camada respondeu de verdade."""
    for chave, valor in headers.items():
        if chave.lower() == "cf-cache-status":
            return valor
    return "-"


def registrar_ledger_borda(contagem_por_status, total_urls, inicio_iso):
    """Grava o que ESTA execucao mandou a um alvo remoto, no MESMO schema que
    tools/check-superficie-bots-live usa (edge_probe_requests_v1) — para
    tools/check-edge-traffic descontar de organic_requests. Sem flag para
    pular: toda passada que sai daqui para fora de 127.0.0.1 se registra
    (2026-09-03, mesma regra do topo do arquivo)."""
    os.makedirs(os.path.dirname(LEDGER_PROPRIO), exist_ok=True)
    with open(LEDGER_PROPRIO, "a", encoding="utf-8") as f:
        f.write(json.dumps({
            "schema_version": "edge_probe_requests_v1",
            "ferramenta": "tools/check-what-bots-see",
            "started_at": inicio_iso,
            "finished_at": datetime.now(timezone.utc).isoformat(),
            "urls": total_urls,
            "status": dict(contagem_por_status),
            "user_agent": UA_PROPRIO_BORDA,
            "warming_header": True,
            "counts_as_audience": False,
            "motivo": "sonda de comparacao de perfis (check-what-bots-see) contra alvo "
                      "remoto; atravessa a Cloudflare e por isso precisa ser descontada "
                      "de organic_requests",
        }, ensure_ascii=False) + "\n")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default=None,
                        help="alvo explicito; por padrao o origin (%s)" % ORIGIN_HOST)
    parser.add_argument("--borda", action="store_true",
                        help="medir pelo dominio publico, atravessando o Cloudflare, com UA "
                             "PROPRIO (2026-09-03: nunca mais UA de bot real fora de "
                             "127.0.0.1). Prova cache/headers/JS injetado; NAO prova "
                             "cloaking por classe nem bloqueio de bot real — ver secoes "
                             "1 e 3 da saida.")
    parser.add_argument("--url", default=DEFAULT_URL)
    parser.add_argument("--rajada", type=int, default=15,
                        help="requisicoes seguidas por bot valioso para provar que nao ha bloqueio")
    args = parser.parse_args()

    if args.host is None:
        if args.borda:
            # Cair para o origin aqui seria pior que falhar: o modo pedido nao
            # aconteceria e a saida ainda diria "modo ORIGIN", como se fosse
            # escolha de quem chamou.
            args.host = dominio_publico()
            if not args.host:
                print("check-what-bots-see: --borda pedido, mas content/site.json nao "
                      "informou base_url", file=sys.stderr)
                return 2
        else:
            args.host = ORIGIN_HOST
    pela_borda = not eh_local(args.host)

    print("=== O QUE CADA VISITANTE RECEBE ===")
    print("url: %s%s" % (args.host, args.url))
    inicio_iso = datetime.now(timezone.utc).isoformat()
    contagem_status_borda = Counter()
    contagem_cache_borda = Counter()
    if pela_borda:
        # Numero declarado antes de gastar: 15 perfis + 1 releitura p/ peso.
        # Nao ha mais rajada pela borda (2026-09-03): ver secao 3 abaixo.
        custo = len(PERFIS) + 1
        print("modo BORDA: ~%d requisicoes com UA PROPRIO (%s) vao para a borda," % (custo, UA_PROPRIO_BORDA))
        print("            marcadas X-Warming-Request e registradas em")
        print("            data/ops/edge_probe_requests.jsonl para sair de organic_requests.")
        print("            Nenhum UA de bot real sai daqui contra este alvo — secoes 1 e 3")
        print("            abaixo ficam com prova parcial nesse modo.")
    else:
        print("modo ORIGIN: fora da borda — nao entra na analytics do Cloudflare")
    print()

    resultados = {}
    cabecalho_tabela = "%-20s %-8s %-9s %-8s %-7s %s" % ("PERFIL", "HTTP", "BYTES", "PALAVRAS", "JSONLD", "SHA-256")
    if pela_borda:
        cabecalho_tabela += "  %s" % "CF-CACHE"
    print(cabecalho_tabela)
    for nome, ua, classe in PERFIS:
        status, corpo, headers = pedir(args.host, args.url, nome, ua)
        cache = cf_cache_status(headers) if pela_borda else None
        if pela_borda:
            contagem_status_borda[str(status)] += 1
            contagem_cache_borda[cache] += 1
        if status != 200:
            linha = "%-20s %-8s %s" % (nome, status, "SEM RESPOSTA — " + corpo.decode("utf-8", "replace")[:50])
            if pela_borda:
                linha += "  cf-cache=%s" % cache
            print(linha)
            resultados[nome] = None
            continue
        sha = hashlib.sha256(corpo).hexdigest()
        dados = analisar(corpo)
        resultados[nome] = (sha, dados, classe)
        linha = "%-20s %-8s %-9s %-8s %-7s %s" % (
            nome, status, len(corpo), dados["texto_visivel"], dados["jsonld"], sha[:16])
        if pela_borda:
            linha += "  %s" % cache
        print(linha)

    validos = {n: v for n, v in resultados.items() if v}
    if not validos:
        if pela_borda:
            registrar_ledger_borda(contagem_status_borda, len(PERFIS), inicio_iso)
        print("\nnenhum perfil obteve resposta — o site esta fora?")
        return 1

    problemas = []

    # 1. Mesmo conteudo para todos.
    shas = {v[0] for v in validos.values()}
    print("\n--- 1. MESMO CONTEUDO PARA TODOS (anti-cloaking) ---")
    if len(shas) == 1:
        print("  OK: os %d perfis receberam bytes IDENTICOS." % len(validos))
        if pela_borda:
            print("  NAO PROVA ausencia de cloaking por classe de bot: pela borda TODO")
            print("  perfil usa o MESMO UA proprio (2026-09-03 — a identidade so viaja no")
            print("  UA/header, que a borda nao le para roteamento). Isto prova so que o")
            print("  caminho servido nao varia entre sondagens; a prova por classe exige")
            print("  rodar no ORIGIN (modo padrao, sem --borda / --host remoto).")
    else:
        problemas.append("conteudo diferente por User-Agent (%d versoes)" % len(shas))
        porsha = {}
        for nome, (sha, _, _) in validos.items():
            porsha.setdefault(sha, []).append(nome)
        for sha, nomes in porsha.items():
            print("  %s : %s" % (sha[:16], ", ".join(nomes)))

    faltando = [n for n, v in resultados.items() if v is None]
    if faltando:
        problemas.append("perfis sem resposta 200: %s" % ", ".join(faltando))

    # 2. Conteudo completo no primeiro response.
    print("\n--- 2. PAGINA COMPLETA E LEVE NO PRIMEIRO RESPONSE ---")
    exemplo = next(iter(validos.values()))[1]
    for campo, rotulo in [("title", "title"), ("meta", "meta description"),
                          ("h1", "h1"), ("canonical", "canonical")]:
        valor = exemplo[campo]
        if valor:
            print("  %-16s %s" % (rotulo, valor[:72]))
        else:
            problemas.append("%s ausente" % rotulo)
            print("  %-16s AUSENTE" % rotulo)
    print("  %-16s %s" % ("robots", exemplo["robots"] or "AUSENTE"))
    print("  %-16s %d bloco(s)" % ("JSON-LD", exemplo["jsonld"]))
    print("  %-16s %d" % ("links internos", exemplo["links_internos"]))
    print("  %-16s %d" % ("WhatsApp", exemplo["whatsapp"]))
    print("  %-16s %s" % ("relacionados", "sim" if exemplo["relacionados"] else "nao"))
    print("  %-16s %d palavras" % ("texto visivel", exemplo["texto_visivel"]))
    if exemplo["js_executavel"]:
        problemas.append("%d <script> executavel emitido pelo projeto — o contrato e zero JS" % exemplo["js_executavel"])
        print("  %-16s %d  <-- PROBLEMA (emitido pelo render)" % ("JS do projeto", exemplo["js_executavel"]))
    else:
        print("  %-16s 0 (so JSON-LD)" % "JS do projeto")
    if exemplo["js_da_borda"]:
        # Não entra em `problemas`: o repositório não pode consertar sozinho, e
        # tratar como falha deixaria o check permanentemente vermelho. Mas fica
        # visível toda vez, porque é JavaScript de terceiro numa página que
        # promete não ter nenhum, e é conexão extra em Core Web Vitals.
        print("  %-16s %d  <-- injetado pelo Cloudflare (Web Analytics), NAO esta no repo"
              % ("JS da borda", exemplo["js_da_borda"]))
