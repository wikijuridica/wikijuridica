#!/usr/bin/env bash
# run-tdd-guard-test — roda `go test` e entrega o resultado ao TDD Guard.
#
# O TDD Guard (plugin do Claude Code) le UM arquivo para saber o estado da suite:
# .claude/tdd-guard/data/test.json. Quem grava esse arquivo e o reporter
# tdd-guard-go, alimentado pelo fluxo JSON de `go test -json`. Este wrapper e o
# alvo de teste do repositorio para esse fluxo.
#
# TRES DECISOES QUE ESTE ARQUIVO CARREGA, e o motivo de cada uma:
#
# 1. PACOTE E OBRIGATORIO. A receita generica do TDD Guard e `go test -json ./...`,
#    que aqui e proibida: sao 488 pacotes, o hook .claude/hooks/block-heavy-go.sh
#    aborta com exit 2 e permissions.deny barra o comando. Nao ha default pesado
#    escondido — quem quer a suite inteira pede a suite inteira, ENVELOPADA:
#
#      ./tools/run-heavy-throttled ./tools/run-tdd-guard-test ./internal/... ./cmd/...
#
#    O envelope capa GOMAXPROCS, aplica nice e serializa com lock. O servidor de
#    8 nucleos travou por sobrecarga em 2026-07-08 justamente sem ele.
#
# 2. O CODIGO DE SAIDA SAI DE PIPESTATUS, COM O `go test` NA FRENTE. Num pipe sem
#    `pipefail`, `$?` e o codigo do ULTIMO comando — o reporter, que sai 0 mesmo
#    com a suite vermelha; essa forma ingenua transforma teste reprovado em verde
#    silencioso (tools/test_run_tdd_guard_test.sh reprova por ela no caso 3).
#    `set -o pipefail` fecha esse buraco, mas abre outro: ele devolve o ultimo
#    codigo nao-zero, entao um reporter que quebra com a suite VERDE pinta a suite
#    de vermelho. Ler PIPESTATUS separa os dois papeis — o codigo do teste manda,
#    e a falha do reporter sai com mensagem propria, que e o unico jeito de a
#    sessao saber que o TDD Guard ficou cego (caso 5 do teste).
#
# 3. O GO SAI PELO WRAPPER ./tools/go-modern, nunca pelo `go` do PATH: o toolchain
#    do repositorio vem do go.mod (.toolchains/), e um binario de outra versao
#    compila com regras diferentes das que os gates medem.
#
# Rodar:
#     ./tools/run-tdd-guard-test ./internal/pageinline/
#     ./tools/run-tdd-guard-test -run TestFoo ./internal/render/
set -uo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$#" -eq 0 ]; then
	echo "run-tdd-guard-test: informe ao menos um pacote (ex.: ./internal/pageinline/)" >&2
	echo "  suite inteira, envelopada:" >&2
	echo "    ./tools/run-heavy-throttled ./tools/run-tdd-guard-test ./internal/... ./cmd/..." >&2
	exit 2
fi

if ! command -v tdd-guard-go >/dev/null 2>&1; then
	echo "run-tdd-guard-test: reporter tdd-guard-go ausente do PATH." >&2
	echo "  instale (MIT, versao fixada):" >&2
	echo "    go install github.com/nizos/tdd-guard/reporters/go/cmd/tdd-guard-go@v0.2.1" >&2
	exit 127
fi

cd "$RAIZ" || exit 1

# -count=1 desliga o cache de teste: um relatorio montado sobre resultado
# cacheado nao diz nada sobre o codigo que acabou de mudar, que e exatamente o
# que o TDD Guard precisa saber.
"$RAIZ/tools/go-modern" test -json -count=1 "$@" 2>&1 |
	tdd-guard-go -project-root "$RAIZ"

# PIPESTATUS e VOLATIL: a primeira atribuicao ja e um comando e zera o array, e
# ler PIPESTATUS[1] na linha seguinte aborta com "unbound variable". Copiar o
# array inteiro num unico comando e o que preserva os dois codigos.
estados=("${PIPESTATUS[@]}")
codigo_teste=${estados[0]}
codigo_reporter=${estados[1]:-0}

if [ "$codigo_teste" -ne 0 ]; then
	exit "$codigo_teste"
fi
if [ "$codigo_reporter" -ne 0 ]; then
	echo "run-tdd-guard-test: a suite passou, mas o reporter tdd-guard-go falhou (exit $codigo_reporter)." >&2
	echo "  o TDD Guard esta cego ate isso ser corrigido: .claude/tdd-guard/data/test.json nao reflete esta rodada." >&2
	exit "$codigo_reporter"
fi
exit 0
