def graphql(headers, consulta, variaveis):
    corpo = json.dumps({"query": consulta, "variables": variaveis}).encode()
    pedido = urllib.request.Request(API + "/graphql", data=corpo, headers=headers)
    try:
        with urllib.request.urlopen(pedido, timeout=60) as resposta:
            dados = json.loads(resposta.read().decode("utf-8"))
    except urllib.error.HTTPError as erro:
        return None, "HTTP %s" % erro.code
    except Exception as erro:
        return None, str(erro)[:120]
    if dados.get("errors"):
        return None, "; ".join(e.get("message", "?") for e in dados["errors"][:2])
    zonas = (dados.get("data") or {}).get("viewer", {}).get("zones") or []
    return (zonas[0] if zonas else {}), ""


def familia_de(user_agent, pais="", categoria_verificada="", chaves_promovidas=frozenset()):
    """Quem é o cliente, com a identidade do robô AUTENTICADA quando é robô.

    A ordem dos critérios importa, e mudou em 2026-08-12 (e ganhou uma quarta
    linha em 2026-09-02):

      1. `verifiedBotCategory` da Cloudflare — a verificação da própria borda,
         por rDNS e faixa de IP publicada pelo operador. É o critério FORTE: um
         robô que passa por ele é aquele robô, venha de onde vier.
      2. faixa de IP oficial já confirmada na série por agente
         (`chaves_promovidas`, lida de edge_bot_agents_daily.jsonl) — segundo
         critério FORTE, para o operador que a Cloudflare não autentica mas que
         publica a própria faixa (medido: PerplexityBot, ~700 req/dia).
      3. país de origem — o heurístico anterior, mantido como terceira linha
         para nomear a sonda que sai desta máquina.
      4. UA de robô que não passou em nenhum dos três: NÃO é visita de robô, e
         agora é dito assim, em vez de entrar na conta com o nome do operador
         que o User-Agent alegava.

    A verificação só é exigida de quem se apresenta como robô conhecido. Pessoa
    com navegador nunca tem categoria verificada — cobrá-la ali transformaria
    todo visitante humano em suspeito, que é o falso positivo óbvio deste tipo
    de detector.
    """
    baixo = (user_agent or "").lower()
    if not baixo:
        return "sem User-Agent"
    # Ferramentas deste repositório se identificam com UA próprio
    # (wikijuridica-check-*, wikijuridica-watchdog). Contá-las como visita seria
    # inflar a própria métrica — a proibição mais dura do contrato do projeto.
    if baixo.startswith("wikijuridica-"):
        return "ferramenta interna (fora da metrica)"
    local = (pais or "").upper() == "BR"
    verificado = bool((categoria_verificada or "").strip())
    chave = botagents.agente_de(user_agent)
    promovido = bool(chave and chave in chaves_promovidas)
    for rotulo, marcas in FAMILIAS:
        if any(marca in baixo for marca in marcas):
            if verificado or promovido:
                return rotulo
            if local and rotulo in FAMILIAS_SEMPRE_ESTRANGEIRAS:
                return ROTULO_SIMULACAO
            if local and any(marca in baixo for marca in FERRAMENTAS_LOCAIS):
                return ROTULO_SIMULACAO
            if rotulo in FAMILIAS_SEMPRE_ESTRANGEIRAS:
                return ROTULO_NAO_VERIFICADO
            return rotulo
    return "pessoa (navegador)"


def agentes_promovidos_por_ip_range():
    """agent_key -> True, para o operador cuja ÚLTIMA linha (maior `date`) em
    edge_bot_agents_daily.jsonl já tem `authenticity` em
    AUTENTICIDADE_PROMOVE_IP.

    Só LÊ; não recalcula a faixa (isso é trabalho do produtor,
    tools/generate-bot-agents-daily). "Última" é por DATA, não por posição no
    arquivo — o append-only reprocessa a mesma janela de 8 dias a cada
    execução, então uma linha de um dia mais velho pode aparecer DEPOIS de uma
    mais nova no arquivo.

    Arquivo ausente ou schema sem o campo `authenticity` devolve conjunto
    vazio — nunca erro: esta é uma leitura de conveniência, e sua ausência não
    pode derrubar a série principal desta ferramenta.
    """
    por_agente_data = {}
    por_agente_authenticity = {}
    if not os.path.isfile(SERIE_AGENTES):
        return frozenset()
    try:
        with open(SERIE_AGENTES, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except ValueError:
                    continue
                chave = registro.get("agent_key")
                data = registro.get("date") or ""
                if not chave or not data:
                    continue
                if data >= por_agente_data.get(chave, ""):
                    por_agente_data[chave] = data
                    por_agente_authenticity[chave] = registro.get("authenticity")
    except OSError:
        return frozenset()
    return frozenset(chave for chave, autenticidade in por_agente_authenticity.items()
                     if autenticidade in AUTENTICIDADE_PROMOVE_IP)


def trafego_liquido(headers, zona, ini, fim):
    """(requests_liquido, distinct_ips, aviso_truncado, erro) na janela [ini, fim].

    `requests_liquido` vem de CONSULTA_LIQUIDA: requisição bruta AMOSTRADA cujo
    User-Agent não começa por "wikijuridica" — filtro no SERVIDOR, sem somar
    baldes truncados no cliente. `distinct_ips` vem de CONSULTA_LIQUIDA_IPS: a
    contagem de `clientIP` distintos no mesmo filtro — não é o `uniques` de
    httpRequests1dGroups (ver o comentário das duas consultas).

    Falha de rede aqui NUNCA derruba a série principal: devolve zeros e o erro,
    e quem chama decide se imprime o aviso.
    """
    variaveis = {"zone": zona, "since": ini.strftime("%Y-%m-%dT%H:%M:%SZ"),
                "until": fim.strftime("%Y-%m-%dT%H:%M:%SZ")}
    dados, erro = graphql(headers, CONSULTA_LIQUIDA, variaveis)
    if erro:
        return 0, 0, False, erro
    grupos = dados.get("httpRequestsAdaptiveGroups", [])
    requests_liquido = grupos[0]["count"] if grupos else 0

    dados_ips, erro_ips = graphql(headers, CONSULTA_LIQUIDA_IPS,
                                  dict(variaveis, limite=LIMITE_LIQUIDA_IPS))
    if erro_ips:
        return requests_liquido, 0, False, erro_ips
    grupos_ips = dados_ips.get("httpRequestsAdaptiveGroups", [])
    truncado = len(grupos_ips) >= AVISO_LIQUIDA_IPS
    return requests_liquido, len(grupos_ips), truncado, ""


def aquecimento_por_dia():
    """Volume de aquecimento por dia UTC, lido do ledger REAL — nunca estimado.

    A CONTAGEM E A SOMA DO MAPA `status`, nao o campo `urls`: uma URL que voltou
    429 CHEGOU a borda e foi contada por ela, entao pertence ao total. Na
    varredura de 2026-08-12T01:14 os dois batem (9.835 = 8.541x200 + 1.294x429);
    quando divergirem, a diferenca aparece em `urls_declared` para conferencia.

    ATRIBUICAO: pelo dia UTC de `started_at` — a mesma referencia da dimensao
    `date` do httpRequests1dGroups. Execucao que atravessa a meia-noite cai
    inteira no dia de inicio e marca `straddle`, porque o ledger nao registra
    quantas requisicoes cairam de cada lado: com a marca, o dia se le como
    aproximado; sem ela, seria numero inventado.

    Execucao sem mapa `status` (interrompida antes de qualquer resposta) NAO
    vira zero silencioso: conta em `sem_status`, e o dia perde a condicao de
    exato.

    Devolve (por_dia, primeira_data, primeiro_instante, linhas_ilegiveis).
    """
    por_dia = {}
    primeira_data = ""
    primeiro_instante = ""
    ilegiveis = 0
    caminhos = [c for c in LEDGERS_PROPRIOS if os.path.exists(c)]
    if not caminhos:
        return por_dia, "", "", 0

    def _linhas_de_todos():
        """Linhas de TODOS os ledgers de tráfego próprio, em sequência. O
        agrupamento é por dia, então a ordem entre ledgers não importa."""
        for caminho in caminhos:
            with open(caminho, encoding="utf-8") as handle:
                for bruta in handle:
                    yield bruta

    for linha in _linhas_de_todos():
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
            inicio = str(registro["started_at"])
            dia = inicio[:10]
            fim = str(registro.get("finished_at") or "")[:10]
            status = registro.get("status") or {}
            total = sum(int(v) for v in status.values())
            declaradas = int(registro.get("urls") or 0)
        except Exception:
            # Linha corrompida nao pode virar zero: some do total e some da
            # afirmacao de exatidao. Ela e contada e dita na saida.
            ilegiveis += 1
            continue
        dados = por_dia.setdefault(dia, {"requests": 0, "runs": 0, "urls_declared": 0,
                                         "sem_status": 0, "straddle": False})
        dados["requests"] += total
        dados["runs"] += 1
        dados["urls_declared"] += declaradas
        if not status:
            dados["sem_status"] += 1
        if fim and fim != dia:
            dados["straddle"] = True
        if not primeira_data or dia < primeira_data:
            primeira_data = dia
        if not primeiro_instante or inicio < primeiro_instante:
            primeiro_instante = inicio
    return por_dia, primeira_data, primeiro_instante, ilegiveis


def separar_proprio(bruto, paginas, aquecido, data, hoje, primeira_data, primeiro_instante):
    """Anota um dia da serie com o trafego proprio e devolve a audiencia.

    Nenhum campo afirma exatidao que a evidencia nao sustenta: dia anterior ao
    ledger fica com `organic_requests: null` e diz por que, em vez de chutar.
    """
    campos = {
        "self_traffic_source": os.path.relpath(AQUECIMENTO, ROOT),
        "page_views_filter": "none_includes_self_traffic",
        "uniques_filter": "none_includes_self_traffic",
    }
    if not primeira_data or data < primeira_data:
        # O ledger comecou depois deste dia. O aquecimento pode ter existido
        # (varredura manual) e nao ha registro que o quantifique.
        campos.update({
            "self_warming_requests": None,
            "self_warming_runs": 0,
            "self_warming_coverage": "no_ledger",
            "self_warming_note": "dia anterior a primeira linha do ledger (%s): o volume proprio"
                                 " deste dia nao e reconstruivel" % (primeira_data or "ausente"),
            "organic_requests": None,
            "organic_requests_basis": "unavailable_no_ledger",
            "organic_page_views_min": None,
        })
        return campos, None

    dados = aquecido.get(data) or {"requests": 0, "runs": 0, "urls_declared": 0,
                                   "sem_status": 0, "straddle": False}
    warm = dados["requests"]
    campos["self_warming_requests"] = warm
    campos["self_warming_runs"] = dados["runs"]
    campos["self_warming_urls_declared"] = dados["urls_declared"]

    ressalvas = []
    if data == primeira_data:
        # O ledger nasceu no meio deste dia: o que rodou antes de primeiro_instante
        # nao esta registrado, entao o proprio pode ser MAIOR e a audiencia MENOR.
        ressalvas.append("ledger comeca em %s, nao a 00:00 UTC" % primeiro_instante)
    if dados["straddle"]:
        ressalvas.append("execucao atravessa a meia-noite UTC e foi somada no dia de inicio")
    if dados["sem_status"]:
        ressalvas.append("%d execucao(oes) sem mapa de status (nao somadas)" % dados["sem_status"])
    if dados["runs"] == 0:
        # Dia dentro da vigencia do ledger e sem NENHUMA execucao registrada. O
        # timer roda de 4 em 4 horas, entao isso e uma de duas coisas: o timer
        # estava parado (e ai o zero e verdade) ou a execucao caiu antes de
        # gravar a linha (e ai nao e). Daqui nao da para distinguir as duas, e
        # escrever "aquecimento = 0" afirmaria o que nao foi medido — por isso a
        # audiencia deste dia sai como LIMITE SUPERIOR, nunca como valor fechado.
        ressalvas.append("nenhuma execucao de aquecimento registrada neste dia:"
                         " timer parado ou execucao que nao gravou")
    if data == hoje:
        ressalvas.append("dia em curso: bruto e aquecimento ainda crescendo")

    campos["self_warming_coverage"] = "ledger" if not ressalvas else "ledger_com_ressalva"
    if ressalvas:
        campos["self_warming_note"] = "; ".join(ressalvas)

    organico = bruto - warm
    if organico < 0:
        # Nunca publicar negativo nem grampear em zero: os dois seriam numero
        # falso. A defasagem do agregado da borda (minutos) contra o ledger
        # (instantaneo) e a causa provavel, e quem le precisa ver isso.
        campos["organic_requests"] = None
        campos["organic_requests_basis"] = "unavailable_warming_exceeds_raw"
        campos["self_warming_note"] = ("aquecimento (%d) maior que o bruto da borda (%d):"
                                       " defasagem do agregado; audiencia nao derivavel"
                                       % (warm, bruto))
        campos["organic_page_views_min"] = None
        return campos, None

    campos["organic_requests"] = organico
    # PISO, nao valor: o ledger conta requisicoes, e parte do aquecimento bate em
    # /robots.txt, /sitemap.xml, /feed.xml, /llms.txt e nos shards, que a borda
    # NAO conta como pageView — e um 429 tambem nao e pageView. Subtrair tudo
    # tira mais do que entrou, logo o resultado e limite inferior. Decompor
    # exatamente exigiria o ledger separar por tipo de alvo, o que ele nao faz:
    # publicar um numero "exato" aqui seria estimativa disfarcada.
    campos["organic_page_views_min"] = max(0, paginas - warm)
    if (data == primeira_data or dados["straddle"] or dados["sem_status"]
            or dados["runs"] == 0):
        campos["organic_requests_basis"] = "upper_bound_raw_minus_warming_ledger"
    elif data == hoje:
        campos["organic_requests_basis"] = "provisional_raw_minus_warming_ledger"
    else:
        campos["organic_requests_basis"] = "exact_raw_minus_warming_ledger"
    return campos, organico


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dias", type=int, default=7)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    env = ler_env()
    headers = cabecalhos(env)
    if not headers:
        print("check-edge-traffic: sem credencial Cloudflare em .env.local "
              "(CLOUDFLARE_ZONE_TOKEN ou CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN)", file=sys.stderr)
        return 2
    with open(SITE, encoding="utf-8") as handle:
        dominio = json.load(handle)["base_url"].rstrip("/").split("//", 1)[-1]

    zonas = urllib.request.Request(API + "/zones?name=" + dominio, headers=headers)
    try:
        with urllib.request.urlopen(zonas, timeout=30) as resposta:
            resultado = json.loads(resposta.read().decode("utf-8"))
    except Exception as erro:
        print("check-edge-traffic: zona indisponivel: %s" % str(erro)[:120], file=sys.stderr)
        return 1
    if not resultado.get("result"):
        print("check-edge-traffic: zona %s nao encontrada" % dominio, file=sys.stderr)
        return 1
    zona = resultado["result"][0]["id"]

    # UTC, nao a hora local. A dimensao `date` do httpRequests1dGroups e o dia
    # UTC, e o ledger de aquecimento grava started_at em UTC — este servidor
    # roda em UTC-3, entao `date.today()` discordava dos dois entre 21h e 24h
    # locais: o dia UTC recem-FECHADO ainda casava com "hoje" e era gravado com
    # a ressalva "dia em curso", afirmando movimento onde nao havia mais. Alem
    # disso, nessas 3 horas o dia UTC corrente nem era pedido a API.
    hoje = datetime.datetime.now(datetime.timezone.utc).date()
    desde = hoje - datetime.timedelta(days=args.dias - 1)
    dados, erro = graphql(headers, CONSULTA_DIARIA,
                          {"zone": zona, "since": desde.isoformat(), "until": hoje.isoformat()})
    if erro:
        print("check-edge-traffic: consulta diaria falhou: %s" % erro, file=sys.stderr)
        return 1
    dias = dados.get("httpRequests1dGroups", [])

    aquecido, primeira_warm, instante_warm, warm_ilegiveis = aquecimento_por_dia()

    print("=== TRAFEGO NA BORDA — %s ===" % dominio)
    print("medido pelo Cloudflare, sem JavaScript no navegador")
    # A série diária não traz User-Agent, então BRUTO é tudo que passou pela
    # borda: audiência, verificação local e o aquecimento do próprio servidor.
    # Chamar isso de "tráfego real" foi o que fez 2026-08-06 parecer 1.966
    # visitas quando 915 eram verificação local — e o que faria 2026-08-12
    # parecer 31.708 quando 29.552 eram o nosso próprio aquecimento.
    print("BRUTO = tudo que passou pela borda. AQUECIM. = requisicoes do proprio")
    print("servidor (tools/warm-edge-cache), contadas no ledger real. AUDIENCIA =")
    print("BRUTO - AQUECIM.: e a unica coluna que representa quem procurou o site.\n")
    print("%-11s %9s %9s %10s %9s %8s %9s" % (
        "DIA", "BRUTO", "AQUECIM.", "AUDIENCIA", "PAGEVIEWS", "UNICOS", "TRAFEGO"))
    registros = []
    for grupo in dias:
        soma, unico = grupo["sum"], grupo["uniq"]
        data = grupo["dimensions"]["date"]
        campos, organico = separar_proprio(soma["requests"], soma["pageViews"], aquecido,
                                           data, hoje.isoformat(), primeira_warm, instante_warm)
        warm = campos.get("self_warming_requests")
        print("%-11s %9d %9s %10s %9d %8d %8.1fMB" % (
            data, soma["requests"],
            "-" if warm is None else "%d" % warm,
            "-" if organico is None else "%d" % organico,
            soma["pageViews"], unico["uniques"], soma["bytes"] / 1048576))
        registro = {
            "schema_version": SCHEMA,
            "date": data,
            # Bruto, como a borda conta o dia de calendário: inclui verificação
            # local e aquecimento. Nunca leia isto como visita.
            "requests": soma["requests"],
            "requests_filter": "none_raw_edge_count",
            "page_views": soma["pageViews"],
            "uniques": unico["uniques"],
            "bytes": soma["bytes"],
        }
        registro.update(campos)
        registros.append(registro)

    # A ressalva vai junto da tabela, não num rodapé que ninguém lê: quem vê um
    # traço precisa saber ali mesmo que aquele dia NÃO é audiência medida.
    sem_ledger = [r["date"] for r in registros if r.get("self_warming_coverage") == "no_ledger"]
    if sem_ledger:
        print("\n  '-' = dia anterior ao ledger de aquecimento (%s): o BRUTO desses dias"
              % (primeira_warm or "ausente"))
        print("  pode conter varredura propria e NAO ha registro que a quantifique.")
        print("  sob ressalva: %s" % ", ".join(sem_ledger))
    ressalvados = [r["date"] for r in registros
                   if r.get("self_warming_coverage") == "ledger_com_ressalva"]
    if ressalvados:
        print("\n  ressalva no ledger (audiencia e limite, nao valor fechado):")
        for registro in registros:
            if registro.get("self_warming_coverage") == "ledger_com_ressalva":
                print("    %s: %s" % (registro["date"], registro.get("self_warming_note", "")))
    if warm_ilegiveis:
        print("\n  AVISO: %d linha(s) ilegivel(is) em %s — nao somadas, o aquecimento"
              % (warm_ilegiveis, os.path.relpath(AQUECIMENTO, ROOT)))
        print("  informado e piso, nao total.")

    if dias:
        ultimo = dias[-1]["sum"]
        erros = {s["edgeResponseStatus"]: s["requests"]
                 for s in ultimo.get("responseStatusMap", []) if s["edgeResponseStatus"] >= 400}
        if erros:
            print("\n--- respostas de erro (ultimo dia) ---")
            for codigo, quantidade in sorted(erros.items()):
                marca = "   <-- rate limit" if codigo == 429 else ""
                print("  %s  %d%s" % (codigo, quantidade, marca))
        paises = sorted(ultimo.get("countryMap", []), key=lambda c: -c["requests"])[:5]
        if paises:
            print("\n--- origem (ultimo dia) ---")
            for pais in paises:
                print("  %-4s %d" % (pais["clientCountryName"], pais["requests"]))

    # Quem são: separa robô de pessoa por User-Agent.
    # A API recusa janela maior que 1 dia neste conjunto ("cannot request a time
    # range wider than 1d"), por ser o dado amostrado e mais caro. Pedir mais
    # nao devolve nada — entao a janela e 24h, e a saida diz isso.
    fim = datetime.datetime.now(datetime.timezone.utc)
    ini = fim - datetime.timedelta(hours=23, minutes=50)
    agentes, erro_agentes = graphql(headers, CONSULTA_AGENTES, {
        "zone": zona,
        "since": ini.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "until": fim.strftime("%Y-%m-%dT%H:%M:%SZ")})
    if erro_agentes:
        print("\n(quem visita: indisponivel — %s)" % erro_agentes)
    else:
        chaves_promovidas = agentes_promovidos_por_ip_range()
        contagem = {}
        origem = {}
        promovidos_por_ip = {}
        linhas = agentes.get("httpRequestsAdaptiveGroups", [])
        for grupo in linhas:
            dimensoes = grupo["dimensions"]
            pais = dimensoes.get("clientCountryName") or ""
            rotulo = familia_de(dimensoes.get("userAgent"), pais,
                                dimensoes.get("verifiedBotCategory"), chaves_promovidas)
            contagem[rotulo] = contagem.get(rotulo, 0) + grupo["count"]
            if rotulo not in (ROTULO_SIMULACAO, ROTULO_NAO_VERIFICADO,
                              "ferramenta interna (fora da metrica)"):
                origem.setdefault(rotulo, {})
                origem[rotulo][pais] = origem[rotulo].get(pais, 0) + grupo["count"]
                chave = botagents.agente_de(dimensoes.get("userAgent"))
                if (chave in chaves_promovidas
                        and not (dimensoes.get("verifiedBotCategory") or "").strip()):
                    promovidos_por_ip[rotulo] = promovidos_por_ip.get(rotulo, 0) + grupo["count"]
        # A métrica é o que veio de FORA. O que o próprio servidor gerou fica
        # visível logo abaixo, nomeado — separado da conta, nunca apagado.
        fora = {r: q for r, q in contagem.items()
                if r not in (ROTULO_SIMULACAO, ROTULO_NAO_VERIFICADO,
                             "ferramenta interna (fora da metrica)")}
        total = sum(fora.values()) or 1
        print("\n--- quem visita (ultimas 24h; amostragem do Cloudflare, use como PROPORCAO) ---")
        if len(linhas) >= 200:
            # A consulta agrupa por (UA, host, pais): quanto mais robô distinto
            # aparece, mais combinações. No teto, a cauda foi cortada e o que
            # falta são justamente os visitantes raros — dizer o total sem esta
            # linha seria apresentar amostra truncada como censo.
            print("  AVISO: consulta no teto de 200 combinacoes — a cauda foi cortada.")
        for rotulo, quantidade in sorted(fora.items(), key=lambda kv: -kv[1]):
            paises = origem.get(rotulo, {})
            de = ", ".join("%s=%d" % (p or "?", n)
                           for p, n in sorted(paises.items(), key=lambda kv: -kv[1])[:3])
            print("  %-30s %7d  (%4.1f%%)  de %s" % (
                rotulo, quantidade, 100.0 * quantidade / total, de))

        # PRÓPRIO é só o que ESTE servidor gerou (simulação de auditoria saindo
        # do Brasil + ferramenta interna). Bot estrangeiro não verificado (UA
        # de robô que não veio do Brasil e a Cloudflare não autenticou) NÃO é
        # tráfego próprio — é tráfego real de fora sem verificação, e ganha
        # bloco separado logo abaixo. Confundir os dois foi o defeito medido em
        # 2026-09-02: ~700 req/dia do PerplexityBot apareciam neste bloco como
        # se o próprio servidor as tivesse gerado.
        proprio = {r: q for r, q in contagem.items()
                  if r in (ROTULO_SIMULACAO, "ferramenta interna (fora da metrica)")}
        estrangeiro_nao_verificado = {r: q for r, q in contagem.items() if r == ROTULO_NAO_VERIFICADO}
        if proprio:
            # Isto é o que o painel do Cloudflare soma junto e apresenta como
            # robô. Aqui fica na conta certa: tráfego que o servidor gerou
            # contra si mesmo. Somar como visita é a fraude de métrica que o
            # contrato do repositório proíbe.
            print("\n  --- gerado pelo proprio servidor (NAO e visita) ---")
            for rotulo, quantidade in sorted(proprio.items(), key=lambda kv: -kv[1]):
                print("  %-30s %7d  (%4.1f%% do bruto)" % (
                    rotulo, quantidade, 100.0 * quantidade / (sum(contagem.values()) or 1)))
            print("  o painel do Cloudflare NAO faz essa separacao: la esses numeros")
            print("  aparecem como Googlebot, OpenAI, Anthropic e Perplexity.")

        if estrangeiro_nao_verificado:
            # NEM visita confirmada (falta autenticacao) NEM sonda desta casa
            # (nao veio do Brasil nem foi promovido por faixa de IP oficial) —
            # tercEIRA categoria, que ate 2026-09-02 caia dentro do bloco acima
            # e era lida como se o proprio servidor a tivesse gerado.
            print("\n  --- %s ---" % ROTULO_ESTRANGEIRO_NAO_VERIFICADO_TEXTO)
            for rotulo, quantidade in sorted(estrangeiro_nao_verificado.items(), key=lambda kv: -kv[1]):
                print("  %-30s %7d  (%4.1f%% do bruto)" % (
                    rotulo, quantidade, 100.0 * quantidade / (sum(contagem.values()) or 1)))
            print("  pode ser operador real sem verificacao da Cloudflare (ver")
            print("  data/ops/bot_ip_ranges/ e tools/check-crawler-error-budget para a lane por")
            print("  IP) ou User-Agent forjado. Nao entra na metrica ate ter verificacao.")

        if promovidos_por_ip:
            print("\n  --- promovido a verificado por faixa de IP oficial (edge_bot_agents_daily) ---")
            for rotulo, quantidade in sorted(promovidos_por_ip.items(), key=lambda kv: -kv[1]):
                print("  %-30s %7d  (ja contado em 'quem visita' acima)" % (rotulo, quantidade))

        # CONFERENCIA INDEPENDENTE do numero do ledger — nunca a fonte dele.
        # As janelas sao diferentes (dia de calendario UTC contra 24h moveis) e
        # este conjunto e AMOSTRADO e truncado no teto de combinacoes, entao os
        # dois nao batem na unidade e nao devem. A comparacao existe para
        # apanhar deriva grossa: aquecimento rodando sem gravar no ledger
        # apareceria aqui como UA proprio muito acima do registrado.
        interna = contagem.get("ferramenta interna (fora da metrica)", 0)
        registro_hoje = next((r for r in registros if r["date"] == hoje.isoformat()), None)
        ledger_hoje = (registro_hoje or {}).get("self_warming_requests")
        if ledger_hoje is not None and interna:
            print("\n  conferencia do aquecimento: ledger = %d (exato, dia UTC) contra"
                  % ledger_hoje)
            print("  %d de UA proprio na amostra de 24h. Janela e amostragem diferentes:"
                  % interna)
            print("  serve para ver deriva, nao para bater na unidade.")

        # A separação vai para a série do dia, não só para o terminal: quem ler
        # o histórico daqui a um mês precisa saber quanto daquele número era
        # verificação própria.
        #
        # JANELA DIFERENTE, NOME DIFERENTE: `requests` é o dia de calendário;
        # estes dois vêm da janela móvel de ~24h e são amostrados pelo
        # Cloudflare. Somados dão mais que o bruto. O sufixo _sampled_24h existe
        # para impedir a subtração `requests - local_...`, que produz número sem
        # sentido. Use-os como PROPORÇÃO.
        for registro in registros:
            if registro["date"] == hoje.isoformat():
                # v5: só simulação local + ferramenta interna — bot estrangeiro
                # não verificado SAIU deste campo (ver o comentário de SCHEMA).
                registro["local_verification_sampled_24h"] = sum(proprio.values())
                registro["external_sampled_24h"] = sum(fora.values())
                # Detalhe do que ficou de fora, para que "próprio" não vire uma
                # caixa-preta: sonda desta máquina, ferramenta interna e UA de
                # robô que a borda não autenticou são coisas diferentes.
                registro["unverified_bot_ua_sampled_24h"] = contagem.get(ROTULO_NAO_VERIFICADO, 0)
                # v5: nomeado à parte — não é "tráfego próprio", é tráfego real
                # de origem estrangeira sem verificação da Cloudflare nem faixa
                # de IP oficial catalogada.
                registro["foreign_unverified_bot_sampled_24h"] = sum(estrangeiro_nao_verificado.values())
                # Volume que JÁ está contado em `external_sampled_24h` (dentro
                # de `fora`) só porque a série por agente o promoveu por faixa
                # de IP oficial — nomeado para não virar caixa-preta dentro de
                # "audiência". Vazio enquanto edge_bot_agents_daily não gravar
                # authenticity em AUTENTICIDADE_PROMOVE_IP (ver o comentário de
                # SERIE_AGENTES).
                registro["bot_promoted_by_ip_range_sampled_24h"] = promovidos_por_ip
                registro["bot_identity_verification"] = "cloudflare_verified_bot_category"
                registro["bot_identity_verification_ip_range_promotion"] = bool(promovidos_por_ip)
                registro["sampled_window_start"] = ini.strftime("%Y-%m-%dT%H:%M:%SZ")
                registro["sampled_window_end"] = fim.strftime("%Y-%m-%dT%H:%M:%SZ")
                # Requisição líquida filtrada NO SERVIDOR (userAgent_notlike),
                # sem o teto de 200 combinações de CONSULTA_AGENTES — ver
                # CONSULTA_LIQUIDA. NÃO é `page_views` nem `uniques`: o dataset
                # amostrado não tem esses campos (introspecção GraphQL viva,
                # 2026-09-02 — ver o comentário da consulta). `bytes` seguem
                # brutos (SCHEMA de cima), nunca removidos.
                liquido, ips_distintos, ips_truncado, erro_liquido = trafego_liquido(
                    headers, zona, ini, fim)
                if erro_liquido:
                    registro["requests_sem_trafego_proprio_sampled_24h"] = None
                    registro["distinct_client_ips_sem_trafego_proprio_sampled_24h"] = None
                    registro["requests_sem_trafego_proprio_basis"] = "indisponivel: " + erro_liquido
                else:
                    registro["requests_sem_trafego_proprio_sampled_24h"] = liquido
                    registro["distinct_client_ips_sem_trafego_proprio_sampled_24h"] = ips_distintos
                    registro["requests_sem_trafego_proprio_basis"] = (
                        "httpRequestsAdaptiveGroups, filter userAgent_notlike:\"wikijuridica%\", "
                        "amostrado; NAO e page_views nem uniques (campos ausentes neste dataset)")
                    if ips_truncado:
                        registro["requests_sem_trafego_proprio_note"] = (
                            "consulta de clientIP distintos perto/no teto de %d grupos — "
                            "distinct_client_ips pode subestimar" % LIMITE_LIQUIDA_IPS)
                    print("\n  liquido (filtro no servidor, 24h): %d requisicao(oes), %d IP(s) de "
                          "cliente distinto(s)%s"
                          % (liquido, ips_distintos, "  [AVISO: perto do teto]" if ips_truncado else ""))

        # Como a separação é feita, dita toda vez: quem lê precisa saber em que
        # ela se apoia — e onde ela erraria.
        print("\n  criterio: robo entra na metrica se a Cloudflare AUTENTICAR a identidade")
        print("  (verifiedBotCategory = rDNS + faixa de IP publicada pelo operador) OU se a")
        print("  serie por agente (edge_bot_agents_daily.jsonl) ja o tiver promovido por faixa")
        print("  de IP oficial. O X-Bot-Simulation que a sonda deste repositorio manda so chega")
        print("  ao nginx, nunca a borda — por isso a origem BR continua como terceira linha,")
        print("  para nomear a sonda que sai desta maquina. UA de operador estrangeiro sem")
        print("  nenhuma das verificacoes aparece como '%s',"
              % ROTULO_NAO_VERIFICADO)
        print("  em bloco proprio — NUNCA somado ao trafego que este servidor gera.")
        ausentes = [r for r, _ in FAMILIAS if r in ("Googlebot", "OpenAI", "Anthropic") and r not in fora]
        if ausentes:
            print("\n  AINDA NAO VISTOS de fato: %s" % ", ".join(ausentes))
            print("  (dominio novo: o sitemap e o canal; a descoberta leva dias a semanas)")

    if registros:
        os.makedirs(os.path.dirname(SERIE), exist_ok=True)
        ultimo_por_data = {}
        if os.path.exists(SERIE):
            with open(SERIE, encoding="utf-8") as handle:
                for linha in handle:
                    linha = linha.strip()
                    if linha:
                        try:
                            anterior = json.loads(linha)
                            ultimo_por_data[anterior["date"]] = anterior
                        except Exception:
                            continue
        vistos = set(ultimo_por_data)
        # O dia corrente é reescrito a cada execução porque o número ainda está
        # crescendo. O arquivo é append-only (nunca reescrito, para não competir
        # com outra frente), então uma data pode ter VÁRIAS linhas: a ÚLTIMA é a
        # boa. Somar o arquivo inteiro conta o mesmo dia duas vezes — quem
        # consumir precisa deduplicar por `date` mantendo a última ocorrência.
        #
        # A regra anterior era `data nova OU hoje`, e com ela um dia FECHADO
        # nunca mais recebia linha: a ultima versao de ontem ficava sendo o
        # retrato parcial gravado ontem. Com a anotacao de aquecimento isso
        # seria pior que estagnacao — o dia fechado ficaria para sempre sem
        # separar audiencia de trafego proprio. Agora tambem se acrescenta
        # quando o registro recalculado DIFERE do ultimo gravado: append-only
        # preservado (nada e reescrito), e o passado converge.
        novos = [r for r in registros
                 if r["date"] == hoje.isoformat() or ultimo_por_data.get(r["date"]) != r]
        with open(SERIE, "a", encoding="utf-8") as handle:
            for registro in novos:
                handle.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")
        print("\nserie gravada em %s (%d registro(s))" % (os.path.relpath(SERIE, ROOT), len(novos)))
        repetidas = len(vistos & {r["date"] for r in registros})
        if repetidas:
            print("append-only: dedupe por `date` mantendo a ULTIMA linha (%d data(s) repetida(s))"
                  % repetidas)

    if args.json:
        print(json.dumps(registros, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
