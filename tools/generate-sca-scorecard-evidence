#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:sca-scorecard-evidence:gocache:${GOCACHE:-$HOME/.cache/go-build}}"
# ORÇAMENTO x TIMEOUT — o efetivo é o MENOR dos dois (run-heavy-throttled:621-640).
# Até 2026-07-30 o wrapper declarava BUDGET_MS=60000 e TIMEOUT_SECONDS=420: o
# teto real era 60 s e os 420 s NUNCA estavam em vigor. Os dois vieram do mesmo
# commit de boilerplate de telemetria (805b971e, "Add telemetry claims to
# generator wrappers"), não de calibração — e 60 s CONTRADIZ o programa que este
# wrapper executa: cmd/generate-sca-scorecard-evidence usa
# defaultTimeoutSeconds=180 só para o subprocesso do Scorecard (main.go:25,109),
# depois de materializar o worktree visível inteiro. Resultado: SIGKILL garantido
# a cada execução, sem evidência gerada e com snapshot órfão de centenas de MB no
# disco (a coleta abaixo existe por causa disso). Alinhar o budget aos 420 s
# declarados NÃO é "subir timeout para mascarar lentidão": é fazer o contrato
# valer o que ele diz e o que o programa precisa. O custo real está sendo
# atacado por engenharia (ver bloco CUSTO abaixo).
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-420000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-30000}"
# CUSTO — a unidade de trabalho deste comando NÃO é "record": ele grava UM
# registro de evidência e, para isso, copia+hasheia byte-a-byte todo arquivo
# visível do repo (`git ls-files --cached --others --exclude-standard`) para um
# snapshot novo em .cache/ (main.go:158-226), sem cache, índice ou delta entre
# execuções. Medido em 2026-07-30: 10.736 arquivos / 851 MB visíveis (eram 1,15
# GB antes de classificar os binários de raiz no .gitignore); só o piso de
# leitura+sha256, sem a escrita e sem o Scorecard, custa 9,7 s a 118 MB/s. Por
# isso a métrica declarada é items_per_second (item = arquivo visível
# materializado), 358 = 10.736 arquivos no EXPECTED_DURATION_MS declarado —
# `records_per_second=20` era número sem lastro no trabalho executado.
# PENDENTE (exige build Go): trocar a materialização full-tree por snapshot
# persistente + delta por identidade de inode em
# materializeScorecardLocalRootWithHooks (main.go:158).
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-items_per_second=358}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/sca_scorecard_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-sca-scorecard-evidence}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/sca_scorecard_evidence.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-420}"

# Coleta de snapshots órfãos antes de começar.
# cmd/generate-sca-scorecard-evidence copia o worktree visível para
# .cache/wiki-scorecard-local-* (main.go:189) e só apaga via `defer cleanup()`
# (main.go:115). Quando o supervisor mata o processo com SIGKILL
# (run-heavy-throttled -> process-tree-supervisor --kill-after), nenhum defer
# roda e o snapshot multi-GB fica no disco sem rota de limpeza. Sem esta coleta,
# cada timeout deixa lixo permanente e o custo cresce junto com o corpus.
# Só remove o que está claramente abandonado: a idade mínima é ordens de
# grandeza maior que a duração máxima de uma execução (timeout declarado = 420s),
# então o snapshot de uma execução concorrente viva nunca é tocado.
WIKI_SCORECARD_ORPHAN_REAP_MINUTES="${WIKI_SCORECARD_ORPHAN_REAP_MINUTES:-60}"
case "$WIKI_SCORECARD_ORPHAN_REAP_MINUTES" in
'' | *[!0-9]*)
	echo "generate-sca-scorecard-evidence: WIKI_SCORECARD_ORPHAN_REAP_MINUTES precisa ser inteiro em minutos" >&2
	exit 2
	;;
esac
if [ "$WIKI_SCORECARD_ORPHAN_REAP_MINUTES" -lt 15 ]; then
	echo "generate-sca-scorecard-evidence: WIKI_SCORECARD_ORPHAN_REAP_MINUTES mínimo é 15 (protege snapshot de execução concorrente)" >&2
	exit 2
fi
if [ -d "$ROOT/.cache" ]; then
	while IFS= read -r orphan_snapshot; do
		[ -n "$orphan_snapshot" ] || continue
		echo "generate-sca-scorecard-evidence: removendo snapshot órfão de execução morta (idade > ${WIKI_SCORECARD_ORPHAN_REAP_MINUTES}min): $orphan_snapshot" >&2
		rm -rf -- "$orphan_snapshot" 2>/dev/null || true
	done < <(find "$ROOT/.cache" -maxdepth 1 -type d -name 'wiki-scorecard-local-*' -mmin "+$WIKI_SCORECARD_ORPHAN_REAP_MINUTES" -print 2>/dev/null || true)
fi

exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-sca-scorecard-evidence --timings "$@"
