              f"{floor['targets_raised']}/{floor['targets_below_before']} elevados; "
              f"{len(floor['still_below'])} abaixo "
              f"({len(floor['orphans_no_affinity'])} órfãos de afinidade)")
        print(f"saída pré-backfill    : {result['out_hist_pre_backfill']}")
        print(f"backfill              : {b['edges_added']} aresta(s) em "
              f"{b['sources_filled']} página(s); slots {b['slots_idle_before']} -> "
              f"{b['slots_idle_after']}; {b['never_crawled_edges']} aresta(s) para "
              f"{b['never_crawled_targets_reached']} destino(s) nunca rastreado(s); "
              f"{b['sources_without_candidates']} página(s) sem candidato afim")
    return result


