# --------------------------------------------------------------------------
# Constantes copiadas do Go. Mudou lá, muda aqui — e --anchors reprova.
# --------------------------------------------------------------------------
MAX_RELATED_LINKS = 6          # content.MaxRelatedLinksPerPage
FLOOR_RESERVED_SLOTS = 2       # v2publish.InboundFloorReservedSlots
CAP_PRE_PISO = MAX_RELATED_LINKS - FLOOR_RESERVED_SLOTS
INBOUND_FLOOR = 2              # v2publish.InboundFloorMeshEntries
MIN_TOPIC_OVERLAP = 2          # relatedlinks.minTopicOverlap
DECLARED_TOPIC_BONUS = 100
SAME_AREA_BONUS = 15
BACKFILL_MAX_GAIN_PER_TARGET = 2
BACKFILL_CANDIDATE_POOL = 24
MESH_MAX_SPOKES_PER_PAGE = 3   # v2internallinkgraph.meshMaxSpokesPerPage

# relatedlinks.stopwords, verbatim.
STOPWORDS = {
    "a", "o", "as", "os", "de", "da", "do", "das", "dos", "e", "em", "no",
    "na", "nos", "nas", "para", "por", "com", "sem", "que", "ao", "aos", "um",
    "uma", "se", "ou", "ate", "pelo", "pela",
    "direito", "juridico", "juridica", "lei", "legal", "processo", "acao",
    "caso", "sobre", "como", "quando", "onde", "qual", "quais",
    "meu", "minha", "seu", "sua", "nao",
}

# relatedlinks.normalizeToken: SÓ estes acentos dobram; o resto do que não é
# [a-z0-9] é descartado. Repare que è, ì, ò e ù não estão no Go — e por isso
# também não podem estar aqui.
FOLD = {
    "á": "a", "à": "a", "â": "a", "ã": "a", "ä": "a",
    "é": "e", "ê": "e", "ë": "e",
    "í": "i", "î": "i", "ï": "i",
    "ó": "o", "ô": "o", "õ": "o", "ö": "o",
    "ú": "u", "û": "u", "ü": "u",
    "ç": "c", "ñ": "n",
}
FIELD_RE = re.compile(r"[^\W_]+", re.UNICODE)


def normalize_token(value: str) -> str:
    out = []
    for ch in value.lower():
        if ("a" <= ch <= "z") or ("0" <= ch <= "9"):
            out.append(ch)
        elif ch in FOLD:
            out.append(FOLD[ch])
    return "".join(out)


def significant_tokens(text: str) -> list[str]:
    tokens: list[str] = []
    seen: set[str] = set()
    for field in FIELD_RE.findall(text):
        token = normalize_token(field)
        if len(token) < 4 or token in STOPWORDS or token in seen:
            continue
        seen.add(token)
        tokens.append(token)
    return tokens


def common_token_cutoff(total: int) -> int:
    cutoff = total // 20
    return 40 if cutoff < 40 else cutoff


def slug(*parts: str) -> str:
    """publicpath.Slug — SEM dobra de acento (o Go só aceita [a-z0-9])."""
    tokens: list[str] = []
    for part in parts:
        if not part:
            continue
        for raw in re.split(r"[^a-z0-9]+", part.lower()):
            if raw:
                tokens.append(raw)
    return "-".join(tokens)


def seed_term_id(intent_id: str) -> str:
    index = intent_id.find("-")
    if index >= 0 and index + 1 < len(intent_id):
        return intent_id[index + 1:]
    return intent_id


def public_path(area: str, intent_id: str) -> str:
    return "/" + slug(area) + "/" + slug(seed_term_id(intent_id)) + "/"


