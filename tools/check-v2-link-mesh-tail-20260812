def git_show(ref: str, rel: str) -> bytes:
    return subprocess.run(["git", "-C", os.fspath(ROOT), "show", f"{ref}:{rel}"],
                          capture_output=True, check=True).stdout


def load_stock(ref: str = "") -> list[dict]:
    """v2publish.LoadPages: ordem de arquivo, descarta sem intent_id ou sem seção."""
    pages: list[dict] = []
    if ref:
        listing = subprocess.run(
            ["git", "-C", os.fspath(ROOT), "ls-tree", "--name-only", f"{ref}:data/editorial/v2_pages"],
            capture_output=True, check=True, text=True).stdout.split()
        shards = [(name, None) for name in sorted(n for n in listing if n.endswith(".jsonl"))]
    else:
        shards = [(p.name, p) for p in sorted((ROOT / "data/editorial/v2_pages").glob("*.jsonl"))]
    for name, path in shards:
        if path is None:
            text = git_show(ref, f"data/editorial/v2_pages/{name}").decode("utf-8")
        else:
            text = path.read_text(encoding="utf-8")
        for raw in text.splitlines():
            raw = raw.strip()
            if not raw:
                continue
            record = json.loads(raw)
            if not record.get("intent_id") or not record.get("sections"):
                continue
            record["_shard"] = name
            pages.append(record)
    return pages


def load_severity(ref: str = "") -> dict[str, dict]:
    rel = "data/editorial/v2_publication_severity.jsonl"
    if ref:
        text = git_show(ref, rel).decode("utf-8")
    else:
        text = (ROOT / rel).read_text(encoding="utf-8")
    index: dict[str, dict] = {}
    for raw in text.splitlines():
        raw = raw.strip()
        if not raw:
            continue
        row = json.loads(raw)
        if row.get("intent_id"):
            index[row["intent_id"]] = row
    return index


def select_publishable(stock: list[dict], severity: dict[str, dict]):
    """v2publish.SelectPublishable, inclusive a colisão de rota."""
    areas: dict[str, str] = {}
    skipped: dict[str, str] = {}
    by_path: dict[str, list[str]] = defaultdict(list)
    candidates: list[dict] = []
    for page in stock:
        intent = page["intent_id"]
        row = severity.get(intent)
        if row is None:
            skipped[intent] = "sem_linha_no_censo"
            continue
        if not row.get("publish"):
            reasons = row.get("critical_reasons") or []
            skipped[intent] = ",".join(reasons) if reasons else "critico"
            continue
        area = row.get("area") or slug(page.get("practice_area") or "")
        if not area:
            skipped[intent] = "area_indefinida"
            continue
        areas[intent] = area
        path = public_path(area, intent)
        by_path[path].append(intent)
        candidates.append(page)

    colliding: set[str] = set()
    for path, intents in by_path.items():
        if len(intents) > 1:
            for intent in intents:
                colliding.add(intent)
                skipped[intent] = "rota_colidente:" + path

    selected = [p for p in candidates if p["intent_id"] not in colliding]
    for intent in colliding:
        areas.pop(intent, None)
    selected.sort(key=lambda p: p["intent_id"])
    return selected, areas, skipped


def load_suppressed_pairs() -> set[str]:
    """internallinkmesh.LoadSuppressedPairs: pares de cluster de risco."""
    prefixes = ("authorial-mass-draft-v2-", "authorial-mass-draft-",
                "authorial-mass-content-", "v2-page-")

    def intent_from_content_id(content_id: str) -> str:
        cid = content_id.strip()
        if not cid or "=" in cid:
            return ""
        for prefix in prefixes:
            if cid.startswith(prefix):
                return cid[len(prefix):]
        return cid

    pairs: set[str] = set()
    path = ROOT / "data/editorial/semantic_cluster_index.jsonl"
    if not path.is_file():
        return pairs
    with open(path, encoding="utf-8") as handle:
        for raw in handle:
            raw = raw.strip()
            if not raw:
                continue
            record = json.loads(raw)
            if record.get("record_kind") != "cluster":
                continue
            if record.get("max_public_members") != 0:
                continue
            members = record.get("member_content_ids") or record.get("assigned_content_id") or []
            ids = [i for i in (intent_from_content_id(m) for m in members) if i]
            if len(ids) < 2:
                continue
            for i in range(len(ids)):
                for j in range(i + 1, len(ids)):
                    a, b = ids[i], ids[j]
                    pairs.add(a + "\x00" + b if a < b else b + "\x00" + a)
    return pairs


def load_mesh_artifact() -> dict[str, list[dict]]:
    """internallinkmesh.Load — índice + fatias por offset/length dos shards."""
    index_path = ROOT / "content/internal_link_mesh_index.jsonl"
    if not index_path.is_file():
        return {}
    shard_cache: dict[str, bytes] = {}
    by_intent: dict[str, list[dict]] = {}
    with open(index_path, encoding="utf-8") as handle:
        for raw in handle:
            raw = raw.strip()
            if not raw:
                continue
            entry = json.loads(raw)
            shard_rel = entry["shard_path"]
            if shard_rel not in shard_cache:
                shard_cache[shard_rel] = (ROOT / shard_rel).read_bytes()
            blob = shard_cache[shard_rel][entry["offset"]:entry["offset"] + entry["length"]]
            if hashlib.sha256(blob).hexdigest() != entry["sha256"]:
                raise SystemExit(f"sha256 divergente no artefato da malha: {entry['path']}")
            record = json.loads(blob.decode("utf-8"))
            by_intent[record["intent_id"]] = record.get("links") or []
    return by_intent


def load_institutional_paths() -> set[str]:
    data = json.loads((ROOT / "content/pages.json").read_text(encoding="utf-8"))
    paths = {page.get("path") for page in data if page.get("path")}
    paths.add("/fontes/")
    return paths


def load_never_requested(ref: str) -> set[str]:
    """Rotas que o Googlebot nunca pediu, lidas de um ref do git (read-only)."""
    if ref:
        blob = subprocess.run(
            ["git", "-C", os.fspath(ROOT), "show",
             f"{ref}:data/ops/crawl_coverage_never_requested.json"],
            capture_output=True, check=True).stdout
        coverage = json.loads(blob)
    else:
        coverage = json.loads(
            (ROOT / "data/ops/crawl_coverage_never_requested.json").read_text(encoding="utf-8"))
    googlebot = coverage.get("crawlers", {}).get("googlebot")
    if not googlebot:
        raise SystemExit(
            "cobertura de rastreio sem a chave 'googlebot' — use --coverage-ref a4c48ea8")
    return {p.strip() for p in googlebot.get("never_requested_paths", []) if p.strip()}


# --------------------------------------------------------------------------
# Índice de assunto e pontuação (relatedlinks.go)
# --------------------------------------------------------------------------
class SubjectIndex:
    """buildSubjectIndex + overlapScores, com ids inteiros para caber no tempo."""

    def __init__(self, selected: list[dict], areas: dict[str, str],
                 overlay: dict[str, list[str]] | None = None,
                 strip: dict[str, list[str]] | None = None):
        self.ids: list[str] = [p["intent_id"] for p in selected]
        self.pos: dict[str, int] = {iid: i for i, iid in enumerate(self.ids)}
        self.area: list[str] = [areas.get(iid, "") for iid in self.ids]
        self.shard: list[str] = [p.get("_shard", "") for p in selected]
        self.topics: list[list[str]] = []
        self.tokens: list[list[str]] = []
        postings: dict[str, list[int]] = defaultdict(list)
        for i, page in enumerate(selected):
            topics = list(page.get("internal_link_topics") or [])
            if strip:
                remover = set(strip.get(page["intent_id"], []))
                topics = [t for t in topics if t not in remover]
            if overlay:
                for extra in overlay.get(page["intent_id"], []):
                    if extra not in topics:
                        topics.append(extra)
            self.topics.append(topics)
            subject = " ".join([page.get("title") or "", page.get("h1") or "",
                                " ".join(topics)])
            tokens = significant_tokens(subject)
            self.tokens.append(tokens)
            for token in tokens:
                postings[token].append(i)
        self.postings = postings
        self.cutoff = common_token_cutoff(len(self.ids))
        # Termos que o corte descarta: pré-computar evita testar em cada consulta.
        self.hot = {t for t, lst in postings.items() if len(lst) > self.cutoff}

    def overlap_scores(self, i: int) -> dict[int, int]:
        counter: Counter[int] = Counter()
        for token in self.tokens[i]:
            if token in self.hot:
                continue
            counter.update(self.postings[token])
        counter.pop(i, None)
        area = self.area[i]
        scores: dict[int, int] = {}
        for other, count in counter.items():
            if count < MIN_TOPIC_OVERLAP:
                continue
            score = count * 10
            if self.area[other] == area:
                score += SAME_AREA_BONUS
            scores[other] = score
        return scores

    def with_declared(self, i: int) -> dict[int, int]:
        """overlapScores + bônus de tópico declarado que É um intent publicado."""
        scores = self.overlap_scores(i)
        for topic in self.topics[i]:
            declared = topic.strip()
            if not declared or declared == self.ids[i]:
                continue
            target = self.pos.get(declared)
            if target is None:
                continue
            scores[target] = scores.get(target, 0) + DECLARED_TOPIC_BONUS
        return scores


# --------------------------------------------------------------------------
# A cadeia
# --------------------------------------------------------------------------
def run_chain(index: SubjectIndex, selected: list[dict], areas: dict[str, str],
              suppressed: set[str], artifact: dict[str, list[dict]],
              never: set[str], verbose: bool = True,
              pool: int = BACKFILL_CANDIDATE_POOL,
              target_cap: int = BACKFILL_MAX_GAIN_PER_TARGET):
    n = len(index.ids)
    title = [(p.get("title") or "").strip() for p in selected]
    path = [public_path(areas[p["intent_id"]], p["intent_id"]) for p in selected]
    path_to_node = {path[i]: i for i in range(n)}

    def is_suppressed(a: int, b: int) -> bool:
        x, y = index.ids[a], index.ids[b]
        return (x + "\x00" + y if x < y else y + "\x00" + x) in suppressed

    # --- 1. malha base, truncada em capPrePiso -----------------------------
    related: list[list[int]] = [[] for _ in range(n)]
    for i in range(n):
        scores = index.with_declared(i)
        for other in [o for o in scores if is_suppressed(i, o)]:
            del scores[other]
        if not scores:
            continue
        area = index.area[i]
        ordered = sorted(scores.items(),
                         key=lambda kv: (-kv[1], index.area[kv[0]] != area, index.ids[kv[0]]))
        picked = [o for o, _ in ordered[:MAX_RELATED_LINKS]
                  if path[o] and title[o]]
        related[i] = picked[:CAP_PRE_PISO]

    # --- 2. união com o artefato (artefato primeiro) -----------------------
    servible = load_institutional_paths() | set(path)
    artifact_edges = 0
    for i in range(n):
        links = artifact.get(index.ids[i]) or []
        primary: list[int] = []
        seen: set[str] = set()
        for link in links:
            target, anchor = (link.get("path") or "").strip(), (link.get("anchor") or "").strip()
            if not target or not anchor or target == "/" or target == path[i] or target in seen:
                continue
            if target not in servible:
                continue
            seen.add(target)
            primary.append(target)
            if len(primary) >= MESH_MAX_SPOKES_PER_PAGE:
                break
        if not primary:
            continue
        merged: list[int] = []
        used: set[str] = set()
        for target in primary:
            if len(merged) >= CAP_PRE_PISO:
                break
            node = path_to_node.get(target)
            if node is None or target in used:
                continue
            used.add(target)
            merged.append(node)
            artifact_edges += 1
        for node in related[i]:
            if len(merged) >= CAP_PRE_PISO:
                break
            if path[node] in used:
                continue
            used.add(path[node])
            merged.append(node)
        related[i] = merged

    artifact_count = [0] * n
    for i in range(n):
        for link in (artifact.get(index.ids[i]) or []):
            target = (link.get("path") or "").strip()
            if target and target in servible and target != path[i]:
                artifact_count[i] += 1
        artifact_count[i] = min(artifact_count[i], MESH_MAX_SPOKES_PER_PAGE)

    inbound = Counter()
    for i in range(n):
        for node in related[i]:
            inbound[node] += 1

    # --- 3. piso de entradas ----------------------------------------------
    floor = {"edges_added": 0, "targets_raised": 0, "suppressed_skipped": 0,
             "still_below": [], "orphans_no_affinity": []}
    outgoing = [set(related[i]) for i in range(n)]
    targets = sorted(((inbound[i], index.ids[i], i) for i in range(n)
                      if inbound[i] < INBOUND_FLOOR),
                     key=lambda t: (t[0], t[1]))
    floor["targets_below_before"] = len(targets)
    for _, _, target in targets:
        need = INBOUND_FLOOR - inbound[target]
        if need <= 0:
            floor["targets_raised"] += 1
            continue
        scores = index.overlap_scores(target)
        if not scores:
            floor["orphans_no_affinity"].append(index.ids[target])
            floor["still_below"].append(index.ids[target])
            continue
        area = index.area[target]
        ordered = sorted(scores.items(),
                         key=lambda kv: (-kv[1], index.area[kv[0]] != area, index.ids[kv[0]]))
        for source, _score in ordered:
            if need <= 0:
                break
            if len(related[source]) >= MAX_RELATED_LINKS:
                continue
            if source == target or target in outgoing[source]:
                continue
            if is_suppressed(source, target):
                floor["suppressed_skipped"] += 1
                continue
            related[source].append(target)
            outgoing[source].add(target)
            inbound[target] += 1
            floor["edges_added"] += 1
            need -= 1
        if need <= 0:
            floor["targets_raised"] += 1
        else:
            floor["still_below"].append(index.ids[target])

    out_hist_pre = Counter(len(related[i]) for i in range(n))

    # --- 4. backfill dos slots reservados ----------------------------------
    back = Counter()
    slots_idle_before = sum(max(0, MAX_RELATED_LINKS - len(related[i])) for i in range(n))
    inbound_snapshot = dict(inbound)
    never_node = [path[i] in never for i in range(n)]

    queues: list[list[tuple]] = [[] for _ in range(n)]
    for i in range(n):
        if len(related[i]) >= MAX_RELATED_LINKS:
            continue  # fila só é consumida por origem com espaço
        scores = index.with_declared(i)
        area = index.area[i]
        candidates = []
        for other, score in scores.items():
            if other == i or other in outgoing[i]:
                continue
            if not path[other] or not title[other]:
                continue
            candidates.append((-score, not never_node[other],
                               inbound_snapshot.get(other, 0),
                               index.area[other] != area, index.ids[other], other))
        candidates.sort()
        queues[i] = candidates[:pool]

    cursor = [0] * n
    gained: Counter[int] = Counter()
    filled: set[int] = set()
    never_reached: set[int] = set()
    # Motivo pelo qual cada origem parou, para o diagnóstico da cauda.
    stopped: list[Counter] = [Counter() for _ in range(n)]

    for _round in range(MAX_RELATED_LINKS):
        added = 0
        for i in range(n):
            if len(related[i]) >= MAX_RELATED_LINKS:
                continue
            queue = queues[i]
            k = cursor[i]
            while k < len(queue):
                _neg, _nc, _inb, _sa, _iid, other = queue[k]
                if other == i or other in outgoing[i]:
                    stopped[i]["ja_ligado"] += 1
                    k += 1
                    continue
                if is_suppressed(i, other):
                    back["suppressed_skipped"] += 1
                    stopped[i]["quase_duplicata"] += 1
                    k += 1
                    continue
                if i in outgoing[other]:
                    back["reciprocal_skipped"] += 1
                    stopped[i]["reciprocidade"] += 1
                    k += 1
                    continue
                if gained[other] >= target_cap:
                    back["target_cap_skipped"] += 1
                    stopped[i]["teto_por_destino"] += 1
                    k += 1
                    continue
                related[i].append(other)
                outgoing[i].add(other)
                inbound[other] += 1
                gained[other] += 1
                filled.add(i)
                back["edges_added"] += 1
                if never_node[other]:
                    back["never_crawled_edges"] += 1
                    never_reached.add(other)
                added += 1
                k += 1
                break
            cursor[i] = k
        if added == 0:
            break

    slots_idle_after = 0
    sources_without_candidates = 0
    idle_sources: list[int] = []
    for i in range(n):
        space = MAX_RELATED_LINKS - len(related[i])
        if space > 0:
            slots_idle_after += space
            sources_without_candidates += 1
            idle_sources.append(i)

    result = {
        "n": n, "path": path, "title": title, "related": related,
        "inbound": inbound, "artifact_edges": artifact_edges,
        "floor": floor, "out_hist_pre_backfill": dict(sorted(out_hist_pre.items())),
        "backfill": {
            "slots_idle_before": slots_idle_before,
            "slots_idle_after": slots_idle_after,
            "edges_added": back["edges_added"],
            "sources_filled": len(filled),
            "never_crawled_edges": back["never_crawled_edges"],
            "never_crawled_targets_reached": len(never_reached),
            "suppressed_skipped": back["suppressed_skipped"],
            "reciprocal_skipped": back["reciprocal_skipped"],
            "target_gain_cap_skipped": back["target_cap_skipped"],
