def propose_overlay(out_path: str, index: SubjectIndex, result,
                    without_new: list[int], suppressed: set[str]) -> None:
    """Para cada alvo sem entrada nova, o vizinho afim MAIS FORTE que pode citá-lo.

    É só a proposta MECÂNICA — o par ainda tem que ser conferido contra o texto
    real das duas páginas antes de virar tópico. Serve para medir o teto do ganho
    antes de gastar leitura com pares que não renderiam nada.
    """
    pares = []
    for target in without_new:
        scores = index.overlap_scores(target)
        if not scores:
            continue
        area = index.area[target]
        ordered = sorted(scores.items(),
                         key=lambda kv: (-kv[1], index.area[kv[0]] != area, index.ids[kv[0]]))
        opcoes = []
        for source, score in ordered:
            a, b = index.ids[source], index.ids[target]
            chave = a + "\x00" + b if a < b else b + "\x00" + a
            if chave in suppressed:
                continue
            if target in result["outgoing"][source]:
                continue
            if index.ids[target] in index.topics[source]:
                continue
            # Quantos tópicos da fonte JÁ resolvem para um intent publicado: cada
            # um vale +100 e disputaria a mesma cabeça de fila com o novo.
            concorrentes = sum(1 for t in index.topics[source]
                               if t.strip() in index.pos and t.strip() != index.ids[source])
            opcoes.append({
                "fonte_intent_id": index.ids[source],
                "fonte_path": result["path"][source],
                "fonte_title": result["title"][source],
                "fonte_area": index.area[source],
                "fonte_shard": index.shard[source],
                "score_afinidade": score,
                "fonte_destinos_do_artefato": result["artifact_count"][source],
                "fonte_topicos_intent_concorrentes": concorrentes,
                "fonte_saida_hoje": len(result["related"][source]),
                "termos_em_comum": sorted(
                    set(index.tokens[source]) & set(index.tokens[target])),
            })
            if len(opcoes) >= 6:
                break
        if not opcoes:
            continue
        # A melhor fonte é a que faz o +100 PEGAR: sem concorrente de +100, com
        # folga na base (artefato ocupa no máximo 3 dos 4 slots pré-piso) e com
        # a maior afinidade real. Ordem só reordena o que já é afim.
        opcoes.sort(key=lambda o: (o["fonte_topicos_intent_concorrentes"],
                                   o["fonte_destinos_do_artefato"],
                                   -o["score_afinidade"], o["fonte_intent_id"]))
        pares.append({
            "alvo_intent_id": index.ids[target],
            "alvo_path": result["path"][target],
            "alvo_title": result["title"][target],
            "alvo_area": area,
            "alvo_entradas_hoje": result["inbound"][target],
            "fontes_candidatas": opcoes[:3],
        })
    Path(out_path).write_text(
        json.dumps(pares, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    print(f"  {len(pares)} par(es) propostos para {len(without_new)} alvo(s)")


def classify(index: SubjectIndex, result, i: int) -> tuple[str, dict]:
    """Por que ESTA origem terminou com slot vazio."""
    queue = result["queues"][i]
    stop = result["stopped"][i]
    scores = index.with_declared(i)
    affine = len([o for o in scores if o != i])
    detail = {
        "candidatos_afins": affine,
        "fila": len(queue),
        "fila_consumida": result["cursor"][i],
        "recusas": dict(stop),
        "tokens": len(index.tokens[i]),
        "topicos": len(index.topics[i]),
        "slots_vazios": MAX_RELATED_LINKS - len(result["related"][i]),
    }
    if affine == 0:
        return "sem_nenhum_candidato_afim", detail
    if len(queue) == 0:
        return "todos_candidatos_ja_ligados", detail
    if result["cursor"][i] < len(queue):
        return "fila_nao_esgotada", detail  # não deveria acontecer; sinaliza bug
    dominante = stop.most_common(1)[0][0] if stop else "fila_curta"
    if affine > len(queue) and dominante == "teto_por_destino":
        return "pool_24_esgotado_por_teto_de_destino", detail
    return "fila_esgotada_" + dominante, detail


def write_diagnosis(out_path: str, index: SubjectIndex, result, without_new: list[int]) -> None:
    lines: list[str] = []
    causes = Counter()
    for i in result["idle_sources"]:
        cause, detail = classify(index, result, i)
        causes[cause] += 1
        lines.append(json.dumps({
            "tipo": "slot_vazio",
            "intent_id": index.ids[i],
            "path": result["path"][i],
            "area": index.area[i],
            "title": result["title"][i],
            "causa": cause,
            **detail,
        }, ensure_ascii=False))
    # Artigos nunca rastreados sem entrada nova: quem PODERIA cita-los?
    idle_set = set(result["idle_sources"])
    for i in without_new:
        scores = index.overlap_scores(i)
        vizinhos_com_slot = [o for o in scores if o in idle_set]
        lines.append(json.dumps({
            "tipo": "nunca_rastreado_sem_entrada_nova",
            "intent_id": index.ids[i],
            "path": result["path"][i],
            "area": index.area[i],
            "title": result["title"][i],
            "vizinhos_afins": len(scores),
            "vizinhos_afins_com_slot_vazio": len(vizinhos_com_slot),
            "entradas_hoje": result["inbound"][i],
            "ganho_no_backfill": result["gained"][i],
            "tokens": len(index.tokens[i]),
            "topicos": len(index.topics[i]),
        }, ensure_ascii=False))
    Path(out_path).write_text("\n".join(lines) + "\n", encoding="utf-8")
    print("causas dos slots vazios:")
    for cause, count in causes.most_common():
        print(f"  {count:5d}  {cause}")


