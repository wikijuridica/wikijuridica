#!/usr/bin/env python3
"""Toda transacao citada por arquivo VERSIONADO tem recibo VERSIONADO.

★ POR QUE ESTE GATE EXISTE (BUG-053, reincidente em 2026-08-30)

`data/editorial/stock_manifest.json` e `data/ops/v2_ingest_transaction_receipt.json`
sao versionados e citam um `transaction_id`. O recibo terminal correspondente
vive em `data/ops/v2_ingest_terminal_receipts/<id>.terminal.json`.

Quando o recibo NAO esta no git, o repositorio afirma uma transacao cuja prova
nao existe para quem clonar — e o backup, que leva os untracked nao-ignorados,
tambem nao o alcanca se ele estiver ignorado. O plano registrou o caso em
2026-08-29 (BUG-053: "o manifesto aponta para uma prova ausente") e ele
REINCIDIU hoje: a re-ingestao do BUG-217 gerou
`v2-rewrite-v5-7099acf50a2c098a9a6e2b6a558a5fe7.terminal.json`, o manifesto foi
commitado citando-o, e o recibo ficou de fora do mesmo commit.

Prosa nao segurou na primeira vez. Por isso vira comando.

Uso:
    ./tools/check-recibo-de-transacao-versionado
"""
import json
import pathlib
import re
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
RECIBOS_REL = "data/ops/v2_ingest_terminal_receipts"
CITANTES = (
    "data/editorial/stock_manifest.json",
    "data/ops/v2_ingest_transaction_receipt.json",
)
TRANSACAO = re.compile(r"v2-[a-z0-9-]+-[0-9a-f]{32}")


def rastreado(rel):
    saida = subprocess.run(
        ["git", "-C", str(RAIZ), "ls-files", "--error-unmatch", rel],
        capture_output=True, text=True)
    return saida.returncode == 0


def main():
    citadas = {}
    for rel in CITANTES:
        caminho = RAIZ / rel
        if not caminho.is_file():
            continue
        for identificador in TRANSACAO.findall(
                caminho.read_text(encoding="utf-8")):
            citadas.setdefault(identificador, []).append(rel)
    if not citadas:
        print("check-recibo-de-transacao-versionado: pass — "
              "nenhum arquivo versionado cita transacao")
        return 0

    faltando = []
    for identificador, quem in sorted(citadas.items()):
        rel = f"{RECIBOS_REL}/{identificador}.terminal.json"
        caminho = RAIZ / rel
        if not caminho.is_file():
            faltando.append((identificador, quem, "recibo AUSENTE do disco"))
        elif not rastreado(rel):
            faltando.append((identificador, quem, "recibo NAO versionado"))
    if faltando:
        print(f"REPROVADO: {len(faltando)} transacao(oes) citada(s) por arquivo "
              f"versionado sem recibo versionado — quem clonar o repositorio "
              f"recebe a afirmacao sem a prova:")
        for identificador, quem, motivo in faltando:
            print(f"    {identificador}  {motivo}")
            for rel in quem:
                print(f"        citada em {rel}")
        print("    Conserto: git add "
              f"{RECIBOS_REL}/<id>.terminal.json e inclua no MESMO commit "
              "do manifesto.")
        return 1
    print(f"check-recibo-de-transacao-versionado: pass — "
          f"{len(citadas)} transacao(oes) citada(s), todas com recibo "
          f"versionado")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
