#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-editorial-history-snapshot}"
# 2026-08-29: este wrapper nasceu SEM claim material em e9e0b9db (2026-08-04),
# depois que bb9b33db (2026-07-04) ja exigia um em run-generate-supervised — por
# isso ele saia exit 2 em producao ("material artifact claim required"). O stem
# "editorial_history_snapshot" nao resolve nenhum dos 14 candidatos de
# supervised_material_claim_path, entao a declaracao tem de ser explicita.
# O artefato reivindicado e a RAIZ do ledger (editorialhistoryledger.
# HistoryDirRelPath), nao so o index: cmd/generate-editorial-history-snapshot
# escreve index.jsonl E objects/sha256/* na mesma transacao. Reivindicar o
# diretorio cobre as duas escritas e satisfaz o cold start do run-heavy-throttled
# (que exige que o dirname do claim exista; o proprio ledger cria a raiz).
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/editorial/editorial_history}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate-editorial-history-snapshot "$@"
