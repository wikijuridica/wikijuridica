NEW_PAGES = [SOBRE, METODOLOGIA, AVISO_LEGAL, TERMOS]
HOME_LINKS = ["/sobre/", "/metodologia/", "/aviso-legal/", "/termos/", "/privacidade/"]


def main() -> int:
    original = open(PATH, encoding="utf-8").read()
    pages = json.loads(original)

    existing = {p.get("path") for p in pages}
    added = []
    for record in NEW_PAGES:
        if record["path"] in existing:
            continue
        pages.append(record)
        added.append(record["path"])

    linked = []
    for page in pages:
        if page.get("path") != "/":
            continue
        links = page.setdefault("internal_links", [])
        for target in HOME_LINKS:
            if target not in links:
                links.append(target)
                linked.append(target)

    rendered = json.dumps(pages, indent=1, ensure_ascii=False)
    if rendered == original:
        print("no change")
        return 0
    with open(PATH, "w", encoding="utf-8") as handle:
        handle.write(rendered)
    print("added:", added)
    print("home links added:", linked)
    return 0


if __name__ == "__main__":
    sys.exit(main())
