#!/usr/bin/env python3
"""check-cabecalhos-no-fio — o que o crawler RECEBE bate com o contrato?

POR QUE ESTE GATE EXISTE, e por que ele nao e mais um diff de config.

Em 2026-08-28 eu removi `more_set_headers 'Vary: Accept-Encoding'` do
`location @fallback` do arquivo ERRADO -- `ops/nginx/wikijuridica.conf`, que esta
dormente -- em vez do `ops/nginx/standalone/nginx.conf`, que e o que a unit
carrega. `check-nginx-standalone-parity` disse `pass`, e a resposta real
continuou saindo com o `Vary` incompleto.

O gate de paridade nao errou: ele responde "o dedicado tem todas as diretivas de
resposta que o vivo tem?", e compara CONJUNTOS de linhas por nome de diretiva,
sem contexto de location. Uma linha identica noutra location cobre a
divergencia. E pergunta de migracao, nao de paridade por rota.

Este gate faz a pergunta que faltava, e faz do unico jeito que nao mente: MEDINDO
O FIO. Config e intencao; cabecalho servido e fato. Se alguem editar o arquivo
errado, recarregar o nginx errado, ou puser a diretiva na location errada, o fio
denuncia e o texto da config nao.

CLASSES MEDIDAS, e por que cada uma importa ao crawler:
  pagina   — o acervo. 31% do que o Googlebot pede.
  sitemap  — 36,5% do que ele pede. Como ele acha o que e novo.
  robots   — 29,4%. Decide se ele entra.
  markdown — a gemea negociada por Accept; e a superficie dos agentes de IA.
  erro     — o 404. Se vier 200, vira soft 404 e consome rastreio.

Sonda com UA proprio e X-Warming-Request, NUNCA com UA de bot real: sondar como
Googlebot e fraude e contamina a propria telemetria que este repo usa.
"""
import argparse
import json
import pathlib
import sys
import urllib.error
import urllib.request

RAIZ = pathlib.Path(__file__).resolve().parent.parent
CONTRATO = RAIZ / "ops" / "contrato-cabecalhos.json"
UA = "wikijuridica-superficie-probe/1.0"


def busca(base, caminho, host, accept=None, encoding="gzip"):
    req = urllib.request.Request(base.rstrip("/") + caminho)
    req.add_header("User-Agent", UA)
    req.add_header("X-Warming-Request", "true")
    req.add_header("Accept-Encoding", encoding)
    if host:
        req.add_header("Host", host)
    if accept:
        req.add_header("Accept", accept)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, {k.lower(): v for k, v in r.headers.items()}
    except urllib.error.HTTPError as e:
        return e.code, {k.lower(): v for k, v in e.headers.items()}
    except (urllib.error.URLError, OSError) as e:
        # Erro de rede NAO e violacao de contrato. Exit 2, nunca 1 -- a licao do
        # check-edge-vary-contract, que lia tunel oscilando como envenenamento.
        print(f"  INCONCLUSIVO: {e}", file=sys.stderr)
        sys.exit(2)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--base", default="http://127.0.0.1:8088")
    ap.add_argument("--host", default="wikijuridica.com.br")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if not CONTRATO.is_file():
        print(f"FALHA: contrato ausente em {CONTRATO}", file=sys.stderr)
        return 2
    contrato = json.loads(CONTRATO.read_text(encoding="utf-8"))

    violacoes, conferidas = [], 0
    resultado = {}
    for nome, regra in contrato["classes"].items():
        status, cab = busca(args.base, regra["rota"], args.host,
                            accept=regra.get("accept"))
        atual = {}
        if status != regra["status"]:
            violacoes.append((nome, "status", regra["status"], status))
        for chave, esperado in regra["cabecalhos"].items():
            recebido = cab.get(chave)
            atual[chave] = recebido
            conferidas += 1
            if esperado is None:
                if recebido is not None:
                    violacoes.append((nome, chave, "ausente", recebido))
            elif recebido is None:
                violacoes.append((nome, chave, esperado, "AUSENTE"))
            elif esperado not in recebido:
                violacoes.append((nome, chave, esperado, recebido))
        resultado[nome] = {"status": status, "cabecalhos": atual}
        print(f"  {nome:<9} {regra['rota']:<34} status={status}")
        for chave in regra["cabecalhos"]:
            print(f"      {chave}: {atual.get(chave) or '<ausente>'}")

    if args.json:
        print(json.dumps({"conferidas": conferidas, "violacoes": len(violacoes),
                          "medido": resultado}, ensure_ascii=False, indent=2))

    if violacoes:
        print(f"\nFALHA: {len(violacoes)} cabecalho(s) divergem do contrato "
              f"(de {conferidas} conferidos):")
        for nome, chave, esperado, recebido in violacoes:
            print(f"  [{nome}] {chave}: esperado {esperado!r}, recebido {recebido!r}")
        print("\n  Config e intencao; o fio e fato. Confira se a diretiva foi para o")
        print("  arquivo que a unit carrega (ops/nginx/standalone/nginx.conf) e se o")
        print("  nginx foi recarregado.")
        return 1

    print(f"\ncabecalhos no fio: {conferidas} conferidos, nenhum divergente")
    return 0


if __name__ == "__main__":
    sys.exit(main())
