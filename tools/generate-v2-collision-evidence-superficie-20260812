    "publication_allowed": False,
    "publication_candidate": False,
    "render_allowed": False,
    "sitemap_allowed": False,
    "indexable": False,
    "index_policy": "noindex",
    "approval": False,
    "public_path": "",
}


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def linha_original_do_git() -> str:
    resultado = subprocess.run(
        ["git", "show", f"{GIT_REV}:{GIT_PATH}"],
        capture_output=True, text=True, cwd=os.fspath(ROOT), check=False)
    if resultado.returncode != 0:
        raise SystemExit(f"git show falhou ({resultado.returncode}): {resultado.stderr.strip()}")
    for linha in resultado.stdout.splitlines():
        if not linha.strip():
            continue
        if json.loads(linha).get("intent_id") == INTENT_PERDEDOR:
            return linha
    raise SystemExit(f"{INTENT_PERDEDOR} ausente em {GIT_PATH}@{GIT_REV[:8]}")


def registro_por_intent(shard: Path, intent: str):
    for numero, linha in enumerate(shard.read_text(encoding="utf-8").splitlines(), 1):
        if not linha.strip():
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") == intent:
            return numero, registro
    return None, None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true",
                        help="grava de fato; sem esta flag a ferramenta só mostra o que faria")
    args = parser.parse_args()

    linha = linha_original_do_git()
    sha_linha = hashlib.sha256(linha.encode("utf-8")).hexdigest()
    if sha_linha != SHA_LINHA_ORIGINAL:
        print(f"CAS falhou: linha original em {GIT_REV[:8]} tem sha256 {sha_linha}, "
              f"esperado {SHA_LINHA_ORIGINAL}", file=sys.stderr)
        return 1
    original = json.loads(linha)
    if original.get("skipped") or str(original.get("superseded_by") or "").strip():
        print("CAS falhou: a linha recuperada já é tombstone, não é o texto redigido.", file=sys.stderr)
        return 1
    if not original.get("opening") or not original.get("sections"):
        print("CAS falhou: a linha recuperada não tem corpo.", file=sys.stderr)
        return 1

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                numero_perdedora, perdedora = registro_por_intent(SHARD_PERDEDORA, INTENT_PERDEDOR)
                if perdedora is None:
                    print(f"CAS falhou: {INTENT_PERDEDOR} ausente de {SHARD_PERDEDORA.name}", file=sys.stderr)
                    return 1
                if not perdedora.get("skipped"):
                    print(f"CAS falhou: {INTENT_PERDEDOR} está VIVO em {SHARD_PERDEDORA.name}: "
                          "não há página perdida a preservar — o defeito seria colisão viva.",
                          file=sys.stderr)
                    return 1
                numero_canonica, canonica = registro_por_intent(SHARD_CANONICA, INTENT_CANONICO)
                if canonica is None or canonica.get("skipped"):
                    print(f"CAS falhou: {INTENT_CANONICO} não está vivo em {SHARD_CANONICA.name}; "
                          "a rota não tem dono e a decisão do par mudou.", file=sys.stderr)
                    return 1

                preservado = dict(original)
                preservado.update(FLAGS_FECHADAS)
                payload = (json.dumps(preservado, ensure_ascii=False,
                                      separators=(", ", ": ")) + "\n").encode("utf-8")
                proveniencia = {
                    "schema_version": 1,
                    "record_type": "v2_public_path_collision_preserved_page",
                    "intent_id": INTENT_PERDEDOR,
                    "public_path_disputada": ROTA,
                    "intent_id_que_ficou_com_a_rota": INTENT_CANONICO,
                    "canonical_shard": SHARD_CANONICA.name,
                    "canonical_line": numero_canonica,
                    "tombstone_shard": SHARD_PERDEDORA.name,
                    "tombstone_line": numero_perdedora,
                    "tombstone_skip_reason": perdedora.get("skip_reason", ""),
                    "recovered_from_git_rev": GIT_REV,
                    "recovered_from_path": GIT_PATH,
                    "original_record_sha256": sha_linha,
                    "preserved_record_sha256": hashlib.sha256(payload).hexdigest(),
                    "word_count": original.get("word_count"),
                    "title": original.get("title"),
                    "reason": ("derivação de rota (seedTermIDFromIntentID) remove só o primeiro "
                               "segmento do intent_id: amb- e imob- na mesma practice_area colapsam "
                               "na mesma URL; o verbete perdeu a rota para o guia de problema"),
                    "checked_at": "2026-08-12",
                }
                proveniencia_payload = (json.dumps(proveniencia, ensure_ascii=False,
                                                   indent=1, sort_keys=True) + "\n").encode("utf-8")

                print(f"rota disputada: {ROTA}")
                print(f"  fica com:  {INTENT_CANONICO} ({SHARD_CANONICA.name}:{numero_canonica}, "
                      f"{canonica.get('word_count')} palavras) — publicada")
                print(f"  preservar: {INTENT_PERDEDOR} ({original.get('word_count')} palavras, "
                      f"tombstone em {SHARD_PERDEDORA.name}:{numero_perdedora})")
                print(f"  destino:   {DESTINO.relative_to(ROOT)}")
                print(f"  sidecar:   {PROVENIENCIA.relative_to(ROOT)}")
                print(f"  sha256 do registro preservado: {proveniencia['preserved_record_sha256'][:16]}")

                if DESTINO.exists() and DESTINO.read_bytes() == payload:
                    # O texto já está preservado. A proveniência é o que torna a
                    # preservação auditável: se um --apply anterior morreu entre
                    # as duas escritas, completá-la aqui em vez de declarar
                    # "idempotente" sobre um par incompleto.
                    if PROVENIENCIA.exists() and PROVENIENCIA.read_bytes() == proveniencia_payload:
                        print("já preservado com bytes idênticos; nada a fazer (idempotente).")
                        return 0
                    faltando = "ausente" if not PROVENIENCIA.exists() else "divergente"
                    print(f"  texto já preservado; proveniência {faltando}.")
                    if not args.apply:
                        print("sem --apply: nada escrito.")
                        return 0
                    atomic_write(PROVENIENCIA, proveniencia_payload)
                    print("  proveniência gravada.")
                    return 0
                if DESTINO.exists():
                    print(f"CAS falhou: {DESTINO.name} já existe com outro conteúdo; "
                          "não sobrescrevo texto preservado.", file=sys.stderr)
                    return 1
                if not args.apply:
                    print("sem --apply: nada escrito.")
                    return 0
                atomic_write(DESTINO, payload)
                atomic_write(PROVENIENCIA, proveniencia_payload)
                print("  gravado.")
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75
    print("NÃO commitado e NÃO publicado. Estoque v2_pages intocado.")
    return 0


if __name__ == "__main__":
