GIT_PATH = "data/editorial/v2_pages/imobiliario-inf2.jsonl"
# CAS: sha256 da LINHA original exata naquela revisão.
SHA_LINHA_ORIGINAL = "f0b9121ca16c361b8ef986cb1d019eb55c90fec32a9e69c833994acbf505ce20"

# Estado fechado de publicação, na forma do precedente
