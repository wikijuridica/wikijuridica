#!/usr/bin/env python3
"""check-git-invocacao-saneada — nenhuma invocacao de git no codigo Go pode
herdar GIT_DIR/GIT_INDEX_FILE do processo que a chamou.

★ POR QUE ESTE GATE EXISTE (medido em 2026-08-29).

`git -C <root> ls-files` NAO garante que o git va olhar para <root>. Com GIT_DIR
no ambiente, ele VENCE o `-C` — e o comando responde sobre OUTRO repositorio,
com exit 0 e saida perfeitamente plausivel. Medido dentro de um repositorio
recem-criado com exatamente dois arquivos:

    $ git -C . ls-files -- go.mod '*/go.mod'
    go.mod
    sub/go.mod

    $ GIT_DIR=/opt/wiki/.git git -C . ls-files -- go.mod '*/go.mod'
    go.mod
    tools/ci/go.mod
    tools/duckdbolap/go.mod
    ...

Nao houve erro: houve RESPOSTA ERRADA.

Isso atinge producao porque o `.githooks/pre-commit` exporta GIT_DIR e
GIT_INDEX_FILE, e num commit PARCIAL — `git commit -- <paths>`, a forma
sancionada neste repositorio — esse indice temporario contem apenas HEAD mais
os caminhos do pathspec. Todo gate que descobre o proprio universo por
`git ls-files` e roda sob o hook mede um RECORTE. E universo que encolhe nao
deixa o gate vermelho: deixa VERDE, por nao ter visto nada.

Trinta e um pontos de producao estavam nessa forma quando isto foi medido, e
doze arquivos de teste. Corrigidos com `internal/gitenv` (producao) e
`internal/gittestenv` (teste). Este gate existe para que o proximo ponto nasca
saneado em vez de reabrir a familia inteira daqui a dois meses.

O QUE ELE REPROVA: `exec.Command("git", ...)` ou `exec.CommandContext(..., "git", ...)`
sem que o mesmo bloco atribua `cmd.Env` a partir de gitenv/gittestenv.

O QUE ELE ACEITA, e por que:
  - o proprio internal/gitenv e internal/gittestenv (sao a implementacao);
  - `cmd.Env` montado a partir de uma funcao local de saneamento cujo nome
    contenha "Environment"/"Ambiente" (padrao anterior, ainda correto);
  - um comentario `//gitenv:deliberado` na linha anterior ou seguinte, para o
    caso REAL de querer o ambiente herdado — quem inspeciona o indice do commit
    em andamento, por exemplo. Excecao NOMEADA e auditavel; ausencia de excecao
    e esquecimento.

READ-ONLY. Exit 0 quando limpo, 1 quando ha ponto sem saneamento.
"""
import os
import re
import subprocess
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PACOTES_IMPLEMENTACAO = ("internal/gitenv/", "internal/gittestenv/")
INVOCACAO = re.compile(r'exec\.Command(?:Context)?\((?:[^,)]*,\s*)?"git"')
SANEADO = re.compile(r'\.Env\s*=\s*(?:gitenv|gittestenv)\.|(?:Environment|Ambiente)\w*\(\)')
DELIBERADO = "//gitenv:deliberado"
JANELA_DEPOIS = 12  # onde o cmd.Env costuma aparecer, apos a invocacao
# A janela PARA TRAS e maior porque a marca //gitenv:deliberado vem acompanhada
# da razao, e a razao ocupa linhas: o proprio gate reprovou uma excecao valida
# na primeira execucao por olhar so 2 linhas acima de uma marca com 4 linhas de
# explicacao. Excecao que exige justificativa curta demais vira excecao sem
# justificativa.
JANELA_ANTES = 10


def arquivos_go():
    saida = subprocess.run(
        ["git", "ls-files", "-z", "--", "internal/*.go", "cmd/*.go",
         "internal/**/*.go", "cmd/**/*.go"],
        cwd=RAIZ, capture_output=True, text=True,
    )
    return [c for c in saida.stdout.split("\0") if c.endswith(".go")]


def main():
    faltantes = []
    for rel in arquivos_go():
        if rel.startswith(PACOTES_IMPLEMENTACAO):
            continue
        caminho = os.path.join(RAIZ, rel)
        try:
            with open(caminho, encoding="utf-8", errors="replace") as f:
                linhas = f.read().split("\n")
        except OSError:
            continue
        for i, linha in enumerate(linhas):
            if not INVOCACAO.search(linha):
                continue
            contexto = "\n".join(linhas[max(0, i - JANELA_ANTES): i + JANELA_DEPOIS])
            if DELIBERADO in contexto or SANEADO.search(contexto):
                continue
            faltantes.append(f"{rel}:{i + 1}: {linha.strip()[:100]}")

    if faltantes:
        print(f"git_invocacao_sem_saneamento total={len(faltantes)}", file=sys.stderr)
        for f in faltantes:
            print(f"  {f}", file=sys.stderr)
        print("", file=sys.stderr)
        print("Conserto: use gitenv.Command(root, args...) em producao, ou", file=sys.stderr)
        print("cmd.Env = gittestenv.Environment() em teste. Se o ambiente herdado", file=sys.stderr)
        print("E a intencao, escreva //gitenv:deliberado com a razao em uma linha.", file=sys.stderr)
        return 1
    print("check-git-invocacao-saneada: pass — nenhuma invocacao de git herda o ambiente do chamador")
    return 0


if __name__ == "__main__":
    sys.exit(main())
