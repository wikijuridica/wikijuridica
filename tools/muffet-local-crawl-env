#!/bin/sh
# Materializa o muffet FIXADO e exporta WIKI_MUFFET_BIN, no mesmo desenho do
# tools/htmltest-release-env.
#
# Por que este arquivo nasceu (2026-08-29, BUG-067): o htmltest tinha wrapper e
# o muffet NAO tinha nenhum. O unico lugar que instalava o muffet era o
# `command_template` gravado na evidencia (`go run ...@v2.11.5`), que nao deixa
# binario nenhum no disco. Resultado medido: o gate
# `tool-artifact-provenance` reprovava com `muffet artifact_not_found` e o
# gerador se RECUSAVA a escrever a evidencia enquanto isso durasse.
#
# O diretorio padrao tambem mudou. Era /tmp/opt-wiki-tools, que morre no
# reboot: por isso as duas ferramentas sumiram juntas e nenhum gate as
# reinstalava. `.cache/tools` fica dentro do repo (e ja esta no .gitignore,
# linha 5), sobrevive ao reboot e segue o mesmo padrao de `.cache/vnu` e
# `.toolchains/`.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
BIN_DIR="${WIKI_MUFFET_BIN_DIR:-$ROOT/.cache/tools}"
MUFFET_BIN="$BIN_DIR/muffet"
mkdir -p "$BIN_DIR"

if [ ! -x "$MUFFET_BIN" ]; then
	GOBIN="$BIN_DIR" go-modern install github.com/raviqqe/muffet/v2@v2.11.5
fi

export WIKI_MUFFET_BIN="$MUFFET_BIN"

if [ "$#" -gt 0 ]; then
	exec "$@"
fi

exec "$MUFFET_BIN" --version
