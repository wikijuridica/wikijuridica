#!/usr/bin/env python3
"""check-buglog-status-coerente — o BUGLOG nao pode afirmar o contrario do
frontboard sobre o estado de um bug.

★ POR QUE ESTE GATE EXISTE (BUG-125, medido em 2026-08-29).

O BUGLOG e a narrativa dos defeitos; o frontboard e o estado operacional. Os
dois eram mantidos A MAO, e divergiram: **31 linhas do BUGLOG diziam "aberto"
para bug JA FECHADO**, incluindo dez derrubados por medicao (nunca houve
defeito) e seis fechados por refutacao (executa-los REVERTERIA trabalho).

O custo disso e concreto e ja aconteceu nesta sessao: uma delegacao inteira foi
gasta para descobrir que nao havia bug. Registro que mente sobre o estado faz o
proximo agente reabrir investigacao encerrada — e o dono paga por isso.

READ-ONLY, por convencao do repositorio. Quem conserta e o par
`tools/generate-buglog-status`.

O criterio e ESTREITO de proposito: so acusa quando o BUGLOG afirma o CONTRARIO
do fato. Redacao diferente nao e divergencia — a linha de status costuma
carregar a narrativa do fecho ("FECHADO — a FONTE tambem foi corrigida: paginas
vem do indice"), que vale mais que o rotulo e nao se sobrescreve. Um criterio
largo aqui destruiria informacao paga; a primeira versao do gerador ia fazer
isso com 118 linhas, e o modo --seco pegou antes.
"""
import io
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BUGLOG = os.path.join(RAIZ, "docs", "goal", "BUGLOG.md")
FRONTBOARD = os.path.join(RAIZ, ".agents", "runtime", "p0_frontboard.jsonl")
CABECALHO = re.compile(r"^##\s+(BUG-[A-Za-z0-9]+)\b")
STATUS = re.compile(r"^-\s+\*\*Status:\*\*")
FECHADO = ("fechado", "corrigido", "resolvido", "morto", "refutado")


# ★ FECHO NAO E "TUDO QUE NAO E todo" (corrigido em 2026-08-30).
#
# A primeira versao classificava com `status == "todo"` de um lado e TODO O
# RESTO do outro. O frontboard usa treze status distintos, e `parcial`,
# `in_progress`, `queued`, `open` e `bloqueado` sao trabalho ABERTO. O efeito
# apareceu na primeira vez que o gerador rodou contra bug parcial: ele queria
# reescrever "aberto quanto a lentidao — 611 s continua caro" como "fechado",
# apagando a divida do registro. Gate que escreve mentira no registro e pior que
# gate nenhum, porque a mentira fica assinada.
STATUS_DE_FECHO = {"done", "closed", "fechado", "refutado", "derrubado", "superseded"}


def fechado_no_board(registro):
    return (registro.get("status") or "").strip().lower() in STATUS_DE_FECHO


def main():
    if not os.path.isfile(BUGLOG) or not os.path.isfile(FRONTBOARD):
        print("buglog_status_fonte_ausente", file=sys.stderr)
        return 1
    estado = {}
    with io.open(FRONTBOARD, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except ValueError:
                continue
            bug = registro.get("bug")
            if bug and str(bug).startswith("BUG-"):
                estado[bug] = registro

    with io.open(BUGLOG, encoding="utf-8") as f:
        linhas = f.read().split("\n")

    divergentes = []
    atual = None
    for numero, linha in enumerate(linhas, start=1):
        cabecalho = CABECALHO.match(linha)
        if cabecalho:
            atual = cabecalho.group(1)
            continue
        if not (atual and STATUS.match(linha)):
            continue
        registro = estado.get(atual)
        bug, atual = atual, None
        if not registro:
            continue
        texto = linha.lower()
        diz_fechado = any(p in texto for p in FECHADO)
        diz_aberto = re.search(r"\baberto\b|\bparcial(?:mente)?\b|\bsegue\s+aberta\b|\bem\s+curso\b", texto) is not None
        aberto_no_board = not fechado_no_board(registro)
        if aberto_no_board and diz_fechado and not diz_aberto:
            divergentes.append((numero, bug, "BUGLOG diz fechado, frontboard diz ABERTO"))
        elif not aberto_no_board and diz_aberto and not diz_fechado:
            divergentes.append((numero, bug, "BUGLOG diz aberto, frontboard diz %s" % (registro.get("desfecho") or "fechado")))

    # ★ Bug do frontboard SEM secao no BUGLOG tambem e divergencia.
    #
    # A primeira versao deste gate so comparava o STATUS de secoes existentes —
    # e por isso nao via o BUG-183, que estava no frontboard e nao tinha secao
    # nenhuma. Um gate que reconcilia o que existe e nao acusa o que falta cobre
    # metade do problema, e a metade que ele nao cobre e a que apaga o registro
    # de um defeito inteiro.
    documentados = set(re.findall(r"^##\s+(BUG-[A-Za-z0-9]+)\b", "\n".join(linhas), re.M))
    # ordem_de_bug tolera id NAO-NUMERICO. A primeira versao fazia
    # int(b.split("-")[1]) e QUEBROU COM TRACEBACK quando o frontboard passou a
    # ter BUG-C4/C5/C6/C7 (os criticos do goal, que nao tem numero). Gate que
    # levanta excecao nao reprova: ele ABORTA o commit com stack trace, e o
    # operador nao consegue distinguir "achei divergencia" de "eu quebrei".
    def ordem_de_bug(b):
        sufixo = b.split("-", 1)[1] if "-" in b else b
        return (0, int(sufixo), "") if sufixo.isdigit() else (1, 0, sufixo)

    ausentes = sorted(set(estado) - documentados, key=ordem_de_bug)
    for bug in ausentes:
        divergentes.append((0, bug, "esta no frontboard e NAO TEM SECAO no BUGLOG"))

    if divergentes:
        print("buglog_status_divergente total=%d" % len(divergentes), file=sys.stderr)
        for numero, bug, motivo in divergentes[:20]:
            print("  BUGLOG.md:%d %s — %s" % (numero, bug, motivo), file=sys.stderr)
        if len(divergentes) > 20:
            print("  ... e mais %d" % (len(divergentes) - 20), file=sys.stderr)
        print("", file=sys.stderr)
        print("Conserto: ./tools/generate-buglog-status  (veja antes com --seco)", file=sys.stderr)
        return 1
    print("check-buglog-status-coerente: pass — %d bugs, nenhum estado contraditorio" % len(estado))
    return 0


if __name__ == "__main__":
    sys.exit(main())
