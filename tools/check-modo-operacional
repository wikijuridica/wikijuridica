# AS DUAS FORMAS DO PAYLOAD, e por que o gate cobra as duas.
#
# O harness serializa o JSON do hook, e nada no contrato diz se sai compacto
# (`"command":"x"`) ou espacado (`"command": "x"`, o default do json.dumps).
# Em 2026-09-16 um hook recortava o comando so da forma COMPACTA; com a
# espacada ele caia no JSON inteiro e a analise posicional passava a procurar
# posicao de comando dentro de `{"tool_name": "Bash", ...`, onde ela nao existe.
# Os tres casos perigosos sairam com exit 0 — a guarda da VM com o token de
# assinatura falhando ABERTA, em silencio, por um espaco.
#
# Por isso cada fixture roda nas DUAS formas e elas tem de CONCORDAR: um hook
# cujo veredito depende do espacamento do serializador e um hook quebrado,
# mesmo que a forma testada por acaso esteja certa.
FORMATOS = (("compacto", (",", ":")), ("espacado", None))


def payload(entrada, separators=None, ferramenta: str = "Bash", agent_type: str | None = None) -> bytes:
    # entrada e um comando Bash (str) ou um tool_input ja montado (dict), para os hooks que
    # julgam a ferramenta Agent (subagent_type/model) ou a escrita de arquivo (file_path).
    tool_input = {"command": entrada} if isinstance(entrada, str) else dict(entrada)
    d = {"tool_name": ferramenta, "tool_input": tool_input}
    if agent_type is not None:
        d["agent_type"] = agent_type
    return json.dumps(d, separators=separators).encode()


def roda_hook(caminho: str, entrada, ferramenta: str = "Bash", agent_type: str | None = None,
              cwd: str | None = None) -> tuple[int, str, str]:
    """Roda nas duas formas. Divergencia entre elas ja e falha, e e reportada
    como exit -1 para o chamador distinguir. Com cwd, fixa a raiz e exporta
    CLAUDE_PROJECT_DIR, porque o hook de Agent le o roster e o de escrita
    resolve o destino contra a raiz."""
    env = None
    if cwd is not None:
        env = os.environ.copy()
        env["CLAUDE_PROJECT_DIR"] = cwd
    vistos = []
    for _, sep in FORMATOS:
        p = subprocess.run(["bash", caminho], input=payload(entrada, sep, ferramenta, agent_type),
                           capture_output=True, cwd=cwd, env=env)
        vistos.append((p.returncode,
                       p.stdout.decode("utf-8", "replace"),
                       p.stderr.decode("utf-8", "replace")))
    if vistos[0][0] != vistos[1][0]:
        aviso = (f"veredito DEPENDE do espacamento do JSON: compacto exit="
                 f"{vistos[0][0]}, espacado exit={vistos[1][0]}")
        return -1, "", aviso
    return vistos[1]


def mensagem_do_hook(saida: str, erro: str) -> str:
    """O texto que chega ao modelo, pelas duas rotas que o hook emite."""
    texto = erro
    try:
        j = json.loads(saida) if saida.strip() else {}
        h = j.get("hookSpecificOutput", {})
        texto += "\n" + h.get("permissionDecisionReason", "") + "\n" + h.get("additionalContext", "")
    except json.JSONDecodeError:
        pass
    return texto


