def medir_tokens(dados: dict) -> None:
    """Item 8 do §P0a: custo comparativo `CLAUDE.md` longo x skill+rules.

    MÉTODO, DECLARADO (a documentação oficial NÃO cobre este número):

    A  bytes ÷ 3,5 — a mesma regra que o plano usou para PT-BR, mantida aqui
       para que os dois números sejam comparáveis. É ESTIMATIVA, não contagem.
    B  tiktoken `cl100k_base` — contagem real de um tokenizador, de FAMÍLIA
       DIFERENTE da do Claude. Serve como piso/teto independente da estimativa,
       não como verdade sobre o tokenizador deste modelo.

    O que se compara, e por quê: o conteúdo que este P0a escreveu em skills e
    rules É conteúdo que, na arquitetura anterior, teria virado prosa no
    `CLAUDE.md`. Então o custo contrafactual é "esse mesmo texto dentro do
    CLAUDE.md", que a doc oficial diz entrar INTEIRO em TODA requisição
    (context-window). O custo real é:

      FIXO      só o frontmatter das skills entra no launch (descrição, cortada
                em 1.536 caracteres). Rule e corpo de skill NÃO entram.
      SOB DEMANDA  corpo da rule carrega quando um arquivo casado é lido; corpo
                da skill carrega quando ela é invocada; hook só custa quando
                emite additionalContext.

    A economia não é o ganho principal — o ganho é o retrabalho evitado. Mas o
    número tem de existir, porque o plano o pediu e ninguém o mediu.
    """
    def bytes_de(caminho: str) -> int:
        try:
            return os.path.getsize(caminho)
        except OSError:
            return 0

    try:
        import tiktoken
        enc = tiktoken.get_encoding("cl100k_base")
        conta = lambda t: len(enc.encode(t))
        tem_b = True
    except Exception:
        conta = lambda t: 0
        tem_b = False

    skills_dir = os.path.join(CLAUDE, "skills")
    rules_dir = os.path.join(CLAUDE, "rules")

    # SOMENTE as 8 skills que ESTA frente escreveu entram no contrafactual. As 5
    # anteriores (estado-real, ler-gigante, medir-bots, publicar-lote,
    # verificar-citacao-legal) ja eram skills — nunca foram prosa de CLAUDE.md, e
    # conta-las inflaria o numero que se afirma. Medir o que se afirma, nao o que
    # esta por perto.
    NOVAS_DO_P0A = {
        "deploy-publico", "ordem-derivados-editoriais", "verificar-producao-viva",
        "commit-v2", "commit-go", "rodar-gate", "purgar-e-aquecer-borda",
        "deploy-binario-go",
    }
    corpo_total = 0
    frontmatter_total = 0
    corpo_tk = 0
    fm_tk = 0
    por_skill = {}
    preexistentes_bytes = 0
    for d in sorted(os.listdir(skills_dir)):
        sm = os.path.join(skills_dir, d, "SKILL.md")
        if not os.path.exists(sm):
            continue
        texto = open(sm, encoding="utf-8").read()
        if d not in NOVAS_DO_P0A:
            preexistentes_bytes += len(texto.encode("utf-8"))
            continue
        m = re.match(r"---\n(.*?)\n---\n", texto, re.S)
        fm = m.group(1) if m else ""
        corpo = texto[m.end():] if m else texto
        frontmatter_total += len(fm.encode("utf-8"))
        corpo_total += len(corpo.encode("utf-8"))
        fm_tk += conta(fm)
        corpo_tk += conta(corpo)
        por_skill[d] = len(texto.encode("utf-8"))

    rules_bytes = 0
    rules_tk = 0
    for r in sorted(os.listdir(rules_dir)) if os.path.isdir(rules_dir) else []:
        if not r.endswith(".md"):
            continue
        texto = open(os.path.join(rules_dir, r), encoding="utf-8").read()
        rules_bytes += len(texto.encode("utf-8"))
        rules_tk += conta(texto)

    total_bytes = frontmatter_total + corpo_total + rules_bytes
    est = lambda b: round(b / 3.5)

    dados["tokens"] = {
        "metodo_A": "bytes / 3,5 (PT-BR), a mesma regra do plano",
        "metodo_B": ("tiktoken cl100k_base — tokenizador de OUTRA familia, "
                     "cross-check, nao verdade sobre o tokenizador do Claude")
                    if tem_b else "tiktoken indisponivel",
        "contrafactual_no_claude_md": {
            "bytes": total_bytes, "A": est(total_bytes),
            "B": (fm_tk + corpo_tk + rules_tk) if tem_b else None,
            "quando": "TODA requisicao de TODA sessao",
        },
        "custo_fixo_real": {
            "bytes": frontmatter_total, "A": est(frontmatter_total),
            "B": fm_tk if tem_b else None,
            "quando": "so o frontmatter das skills, no launch",
        },
        "sob_demanda": {
            "corpo_das_skills_bytes": corpo_total, "A": est(corpo_total),
            "regras_bytes": rules_bytes, "A_regras": est(rules_bytes),
            "quando": "corpo da skill ao invocar; rule ao ler arquivo casado",
        },
        "skills_bytes": por_skill,
        "fora_da_conta": {
            "skills_preexistentes_bytes": preexistentes_bytes,
            "porque": "ja eram skills antes do P0a; nunca foram prosa de CLAUDE.md",
        },
    }
    fixo = frontmatter_total
    dados["tokens"]["reducao_do_custo_fixo"] = {
        "de_A": est(total_bytes), "para_A": est(fixo),
        "fator": round(total_bytes / fixo, 1) if fixo else None,
    }


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--max-ms", type=float, default=300.0)
    ap.add_argument("--repeticoes", type=int, default=20)
    ap.add_argument("--provar-mutacao", action="store_true")
    ap.add_argument("--medir-tokens", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    falhas: list[str] = []
    dados: dict = {}
    t1_inventario(falhas, dados)
    t2_t3_disparo(falhas, dados)
    t4_custo(falhas, dados, args.max_ms, args.repeticoes)
    t5_registro(falhas, dados)
    if args.provar_mutacao:
        falhas += prova_por_mutacao(dados)
    if args.medir_tokens:
        medir_tokens(dados)

    if args.json:
        print(json.dumps({"falhas": falhas, "dados": dados}, ensure_ascii=False, indent=2))
        return 1 if falhas else 0

    print(f"hooks registrados : {len(dados.get('hooks_registrados', []))}")
    print(f"regras por caminho: {len(dados.get('rules', []))}")
    print(f"skills            : {len(dados.get('skills', []))}")
    print(f"agentes           : {len(dados.get('agents', []))}")
    if "custo_ms" in dados:
        print(f"\n{'hook':<42}{'disparo p50/p95':>18}{'frio p50/p95':>18}")
        for nome, m in dados["custo_ms"].items():
            print(f"{nome:<42}{m['disparo']['p50']:>8.1f}/{m['disparo']['p95']:<9.1f}"
                  f"{m['frio']['p50']:>8.1f}/{m['frio']['p95']:<9.1f}")
        print(f"\npior p95 no caminho frio: {dados['pior_p95_frio_ms']} ms (teto {args.max_ms} ms)")
    if args.medir_tokens:
        t = dados["tokens"]
        print(f"\nCUSTO EM TOKENS — método A: {t['metodo_A']}")
        print(f"                  método B: {t['metodo_B']}")
        cf, fx, sd = t["contrafactual_no_claude_md"], t["custo_fixo_real"], t["sob_demanda"]
        print(f"\n  se esse texto vivesse no CLAUDE.md : {cf['bytes']:>7} B  A={cf['A']:>6}  B={cf['B']}  ({cf['quando']})")
        print(f"  custo FIXO como skill+rules       : {fx['bytes']:>7} B  A={fx['A']:>6}  B={fx['B']}  ({fx['quando']})")
        print(f"  corpo das skills (sob demanda)    : {sd['corpo_das_skills_bytes']:>7} B  A={sd['A']:>6}")
        print(f"  regras por caminho (sob demanda)  : {sd['regras_bytes']:>7} B  A={sd['A_regras']:>6}")
        fc = t["fora_da_conta"]
        print(f"  FORA da conta: 5 skills anteriores: {fc['skills_preexistentes_bytes']:>7} B  ({fc['porque']})")
        r = t["reducao_do_custo_fixo"]
        print(f"\n  custo fixo por sessão: {r['de_A']} -> {r['para_A']} tokens (fator {r['fator']}x)")
    if args.provar_mutacao:
        print(f"\nprova por mutação: {len(dados.get('mutacao', {}))} hooks provados "
              f"(desligar cada um deixa o T2 vermelho nomeando-o)")
    if falhas:
        print(f"\nVERMELHO — {len(falhas)} falha(s):")
        for f in falhas:
            print(f"  {f}")
        return 1
    print("\nVERDE — mecanismos existem, disparam, ensinam, custam dentro do teto e estão registrados.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
