def frontmatter_valido(caminho: str) -> str | None:
    """Devolve a mensagem de erro se o frontmatter nao for YAML valido.

    POR QUE ISTO E UM TESTE. Em 2026-09-16 `.claude/agents/investigador.md`
    estava com YAML invalido em HEAD -- a description continha "Read-only: NAO
    edita", e o ": " em escalar simples faz o parser ler aquilo como mapeamento
    aninhado. Um frontmatter que nao parseia e a falha SILENCIOSA que esta
    frente existe para eliminar: os campos `memory:` e `skills:` acrescentados
    logo abaixo poderiam ser ignorados sem uma linha de aviso, e a correcao da
    causa-raiz (levar a licao ao subagente) nao valeria para aquele agente.
    Aspas duplas na description resolvem sem mudar uma palavra do texto.
    """
    try:
        import yaml
    except ImportError:
        return None  # sem o modulo, nao se inventa veredito
    with open(caminho, encoding="utf-8") as fh:
        texto = fh.read()
    m = re.match(r"---\n(.*?)\n---", texto, re.S)
    if not m:
        return "sem frontmatter"
    try:
        dados = yaml.safe_load(m.group(1))
    except Exception as exc:  # noqa: BLE001 - a mensagem do parser e o valor
        return f"YAML invalido: {exc}"
    if not isinstance(dados, dict):
        return "frontmatter nao e um mapeamento"
    return None


def t1_inventario(falhas: list[str], dados: dict) -> None:
    cfg_path = os.path.join(CLAUDE, "settings.json")
    if not os.path.exists(cfg_path):
        falhas.append("T1 .claude/settings.json ausente")
        return
    with open(cfg_path, encoding="utf-8") as fh:
        cfg = json.load(fh)

    registrados = set()
    for _evento, blocos in cfg.get("hooks", {}).items():
        for bloco in blocos:
            for h in bloco.get("hooks", []):
                for nome in re.findall(r"\.claude/hooks/([\w.-]+)", h.get("command", "")):
                    registrados.add(nome)
    dados["hooks_registrados"] = sorted(registrados)

    for nome in registrados:
        alvo = os.path.join(HOOKS, nome)
        if not os.path.exists(alvo):
            falhas.append(f"T1 hook registrado no settings.json mas ausente do disco: {nome}")
        elif not os.access(alvo, os.X_OK):
            falhas.append(f"T1 hook sem bit de execução: {nome}")

    # Rules: frontmatter com `paths:` e cada glob casando arquivo real.
    rules_dir = os.path.join(CLAUDE, "rules")
    regras = sorted(f for f in os.listdir(rules_dir) if f.endswith(".md")) if os.path.isdir(rules_dir) else []
    dados["rules"] = regras
    if len(regras) < 6:
        falhas.append(f"T1 esperadas >= 6 regras por caminho, encontradas {len(regras)}")
    import glob as _glob
    for r in regras:
        if erro := frontmatter_valido(os.path.join(rules_dir, r)):
            falhas.append(f"T1 rule {r}: {erro}")
        with open(os.path.join(rules_dir, r), encoding="utf-8") as fh:
            texto = fh.read()
        m = re.match(r"---\n(.*?)\n---", texto, re.S)
        if not m:
            falhas.append(f"T1 rule sem frontmatter: {r}")
            continue
        globs = re.findall(r"-\s+\"([^\"]+)\"", m.group(1))
        if not globs:
            falhas.append(f"T1 rule sem paths: {r}")
        for g in globs:
            # `**` devolve o PRÓPRIO diretório-base: no Python 3.11.2 deste host,
            # glob.glob('/opt/wiki/naoexiste-xyz/**', recursive=True) devolve
            # ['/opt/wiki/naoexiste-xyz/'] com o diretório AUSENTE (o 3.12 devolve []),
            # e diretório que só tem subdiretório "casa" em qualquer versão. Contar
            # esses itens deixava passar glob que nunca carrega a rule. A rule carrega
            # quando um ARQUIVO casado é lido: conta só o que existe e é arquivo.
            arquivos = [p for p in _glob.glob(os.path.join(RAIZ, g), recursive=True) if os.path.isfile(p)]
            if not arquivos:
                falhas.append(f"T1 rule {r}: glob não casa nenhum arquivo real: {g}")
        # len() conta CARACTERES, não bytes: com acento, `wc -c` dá mais que isto (antes
        # do corte de 2026-09-23, fila-do-cerebro.md tinha 25206 B e 25087 caracteres).
        # Corte por `wc -m`.
        if len(texto) > 6000:
            falhas.append(f"T1 rule longa demais ({len(texto)} caracteres, teto 6000): {r}")

    # Skills: SKILL.md com name e description.
    skills_dir = os.path.join(CLAUDE, "skills")
    skills = sorted(d for d in os.listdir(skills_dir) if os.path.isdir(os.path.join(skills_dir, d))) if os.path.isdir(skills_dir) else []
    dados["skills"] = skills
    if len(skills) < 13:
        falhas.append(f"T1 esperadas >= 13 skills (5 antigas + 8 do P0a), encontradas {len(skills)}")
    for s in skills:
        sm = os.path.join(skills_dir, s, "SKILL.md")
        if not os.path.exists(sm):
            falhas.append(f"T1 skill sem SKILL.md: {s}")
            continue
        if erro := frontmatter_valido(sm):
            falhas.append(f"T1 skill {s}: {erro}")
        with open(sm, encoding="utf-8") as fh:
            texto = fh.read()
        m = re.match(r"---\n(.*?)\n---", texto, re.S)
        if not m or "description:" not in m.group(1):
            falhas.append(f"T1 skill sem description no frontmatter: {s}")
        elif len(m.group(1)) > 1536:
            falhas.append(f"T1 frontmatter de skill acima do corte de 1536 chars: {s}")

    # Agents: memory: e skills: — a correção da causa-raiz. A doc oficial diz que
    # a auto memory da conversa principal NÃO é carregada em subagente (só o fork
    # herda), e é por isso que o mesmo erro volta: a lição não chega ao próximo.
    agents_dir = os.path.join(CLAUDE, "agents")
    agentes = sorted(f for f in os.listdir(agents_dir) if f.endswith(".md")) if os.path.isdir(agents_dir) else []
    dados["agents"] = agentes
    for a in agentes:
        if erro := frontmatter_valido(os.path.join(agents_dir, a)):
            falhas.append(f"T1 agent {a}: {erro} — os campos memory/skills abaixo podem ser ignorados em silencio")
        with open(os.path.join(agents_dir, a), encoding="utf-8") as fh:
            texto = fh.read()
        m = re.match(r"---\n(.*?)\n---", texto, re.S)
        if not m:
            falhas.append(f"T1 agent sem frontmatter: {a}")
            continue
        fm = m.group(1)
        if not re.search(r"^memory:\s*(user|project|local)\s*$", fm, re.M):
            falhas.append(f"T1 agent sem `memory:` (user|project|local): {a}")
        nomes = re.findall(r"^\s+-\s+([\w-]+)\s*$", fm, re.M)
        if "skills:" not in fm or not nomes:
            falhas.append(f"T1 agent sem `skills:` no frontmatter: {a}")
        for n in nomes:
            if n not in skills:
                falhas.append(f"T1 agent {a} declara skill inexistente: {n}")


def _desmonta(caso: dict, item):
    """Item de bloqueia/permite: str (comando Bash), tupla (cmd, ensina) ou dict
    ({tool_input, agent_type?, ensina?}). Item dict roda com cwd=RAIZ, porque o hook de
    Agent le o roster e o de escrita resolve o destino contra a raiz."""
    if isinstance(item, dict):
        return item["tool_input"], item.get("ensina", caso.get("ensina", [])), item.get("agent_type"), RAIZ
    if isinstance(item, tuple):
        return item[0], item[1], None, None
    return item, caso.get("ensina", []), None, None


def t2_t3_disparo(falhas: list[str], dados: dict, dir_hooks: str = HOOKS, so: str | None = None) -> None:
    for nome, caso in CASOS.items():
        if so and nome != so:
            continue
        alvo = os.path.join(dir_hooks, nome)
        if not os.path.exists(alvo):
            falhas.append(f"T2 hook ausente: {nome}")
            continue
        injetor = caso.get("injetor", False)
        ferramenta = caso.get("ferramenta", "Bash")
        for item in caso["bloqueia"]:
            cmd, ensina, agent_type, cwd = _desmonta(caso, item)
            rc, out, err = roda_hook(alvo, cmd, ferramenta, agent_type, cwd)
            if rc == -1:
                falhas.append(f"T2 {nome} {err}: {cmd!r}")
                continue
            agiu = (out.strip() != "") if injetor else (rc == 2)
            if not agiu:
                rotulo = "não injetou contexto" if injetor else f"não bloqueou (exit={rc})"
                falhas.append(f"T2 {nome} {rotulo}: {cmd!r}")
                continue
            msg = mensagem_do_hook(out, err)
            for trecho in ensina:
                if trecho not in msg:
                    falhas.append(f"T2 {nome} agiu mas a mensagem não ensina {trecho!r}: {cmd!r}")
        for item in caso["permite"]:
            cmd, _ensina, agent_type, cwd = _desmonta(caso, item)
            rc, out, err = roda_hook(alvo, cmd, ferramenta, agent_type, cwd)
            if rc == -1:
                falhas.append(f"T3 {nome} {err}: {cmd!r}")
                continue
            agiu = (out.strip() != "") if injetor else (rc != 0)
            if agiu:
                rotulo = "injetou em" if injetor else f"bloqueou (exit={rc})"
                falhas.append(f"T3 falso-positivo — {nome} {rotulo}: {cmd!r}")


def t4_custo(falhas: list[str], dados: dict, max_ms: float, n: int) -> None:
    medidas = {}
    for nome, caso in CASOS.items():
        alvo = os.path.join(HOOKS, nome)
        if not os.path.exists(alvo):
            continue
        ferramenta = caso.get("ferramenta", "Bash")
        # frio: um payload que o hook NAO casa, para medir a saida rapida. O default e um
        # Bash inocuo; hook de outra ferramenta pode declarar o seu (sempre nao-casante).
        frio = caso.get("frio", "ls -la tools/")
        disparo_in, _e, disparo_at, disparo_cwd = _desmonta(caso, caso["bloqueia"][0])
        linha = {}
        for rotulo, (entrada, ferr, at, cwd) in (("disparo", (disparo_in, ferramenta, disparo_at, disparo_cwd)),
                                                 ("frio", (frio, "Bash", None, None))):
            ts = []
            dados_in = payload(entrada, None, ferr, at)
            env = None
            if cwd is not None:
                env = os.environ.copy()
                env["CLAUDE_PROJECT_DIR"] = cwd
            for _ in range(n):
                t0 = time.perf_counter()
                subprocess.run(["bash", alvo], input=dados_in, capture_output=True, cwd=cwd, env=env)
                ts.append((time.perf_counter() - t0) * 1000)
            ts.sort()
            linha[rotulo] = {"p50": round(statistics.median(ts), 1),
                             "p95": round(ts[max(0, int(0.95 * len(ts)) - 1)], 1)}
        medidas[nome] = linha
        if linha["frio"]["p95"] > max_ms:
            falhas.append(f"T4 {nome} p95 no caminho frio {linha['frio']['p95']} ms > teto {max_ms} ms")
    dados["custo_ms"] = medidas
    if medidas:
        dados["pior_p95_frio_ms"] = max(v["frio"]["p95"] for v in medidas.values())


def t5_registro(falhas: list[str], dados: dict) -> None:
    registrados = set(dados.get("hooks_registrados", []))
    for nome in CASOS:
        if nome not in registrados:
            falhas.append(f"T5 hook existe no disco mas NÃO está em .claude/settings.json: {nome}")


def prova_por_mutacao(dados: dict) -> list[str]:
    """Desligar um hook tem de deixar o T2 VERMELHO nomeando aquele hook."""
    problemas = []
    for nome in CASOS:
        origem = os.path.join(HOOKS, nome)
        if not os.path.exists(origem):
            continue
        with tempfile.TemporaryDirectory(prefix="modo-operacional-mut-") as tmp:
            destino = os.path.join(tmp, "hooks")
            shutil.copytree(HOOKS, destino)
            # Neutraliza SOMENTE este hook; os demais ficam intactos.
            with open(os.path.join(destino, nome), "w", encoding="utf-8") as fh:
                fh.write("#!/usr/bin/env bash\nexit 0\n")
            falhas_mut: list[str] = []
            t2_t3_disparo(falhas_mut, {}, dir_hooks=destino, so=nome)
            nomeia = [f for f in falhas_mut if nome in f and f.startswith("T2")]
            if not nomeia:
                problemas.append(f"MUTAÇÃO {nome}: desligar o hook NÃO deixou o T2 vermelho — o teste não o cobre")
            else:
                dados.setdefault("mutacao", {})[nome] = nomeia[0]
    return problemas


