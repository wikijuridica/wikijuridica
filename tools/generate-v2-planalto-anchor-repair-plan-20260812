#!/usr/bin/env python3
"""generate-v2-planalto-anchor-repair-plan-20260812 — monta o plano de correção das citações.

Produz `tools/generate-v2-planalto-anchor-repair-20260812.data.json`: para cada
combinação `URL#âncora` do acervo, o que fazer e POR QUÊ, com a evidência do
documento oficial baixado (status, sha256, número de âncoras, normas
alteradoras). Quem aplica é o gerador de mesmo nome sem `-plan`.

Separar plano de aplicação existe por um motivo: o plano nasce da conferência da
FONTE (rede, HTML oficial, comparação entre versões) e o aplicador só toca o
acervo. Assim a decisão pode ser reconferida sem risco de escrita, e reexecutar
o plano sobre o mesmo cache dá exatamente o mesmo arquivo.

O plano é montado sobre o ACERVO PRESERVADO em
`.agents/runtime/backup-paginas-20260812-planalto-ancoras/v2_pages/` (o estado
anterior à correção), não sobre o acervo já corrigido: é ele que descreve a
frente inteira. Com `--acervo <dir>` mede-se qualquer outro estado.

Uso:
    tools/generate-v2-planalto-anchor-repair-plan-20260812
    tools/generate-v2-planalto-anchor-repair-plan-20260812 --acervo data/editorial/v2_pages
"""
from __future__ import annotations

import argparse
import collections
import importlib.machinery
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DESTINO = ROOT / "tools/generate-v2-planalto-anchor-repair-20260812.data.json"
BACKUP = ROOT / ".agents/runtime/backup-paginas-20260812-planalto-ancoras/v2_pages"

_MEDIDOR = ROOT / "tools/measure-planalto-anchor-coverage-20260812"
# A ferramenta de medição não tem extensão .py (é um executável do tools/), e
# sem loader explícito o importlib devolve spec sem loader.
_spec = importlib.util.spec_from_file_location(
    "medicao", _MEDIDOR,
    loader=importlib.machinery.SourceFileLoader("medicao", os.fspath(_MEDIDOR)))
medicao = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(medicao)

# Alternativa de CAMINHO, conferida uma a uma por download — não é regra de
# nome: a Lei 10.666/2003 estava citada em /_ato2004-2006/2003/lei/, caminho que
# responde 404; o documento oficial vive em /leis/2003/ e tem as âncoras.
ALTERNATIVAS_CONFERIDAS = {
    "https://www.planalto.gov.br/ccivil_03/_ato2004-2006/2003/lei/l10.666.htm":
        "https://www.planalto.gov.br/ccivil_03/leis/2003/l10.666.htm",
}

CRITERIO = (
    "Cada URL-base citada e as variantes do mesmo documento oficial (sufixo "
    "compilado/compilada/cons removido ou acrescentado) foram baixadas em "
    "2026-08-12. De cada HTML extraiu-se, com html.parser, o conjunto real de "
    "atributos id/name (as âncoras) e, das notas entre parênteses do corpo "
    "(\"Redação dada pela Lei nº X, de ANO\", \"Incluído pela...\"), o conjunto "
    "de normas alteradoras. TROCA-SE a URL apenas quando a variante responde "
    "200, contém a âncora exata e não perde nenhuma norma alteradora do "
    "documento citado — assim o leitor cai no artigo sem trocar texto "
    "atualizado por texto velho. Quando nenhuma variante satisfaz esse teste, "
    "REMOVE-SE o fragmento e mantém-se o documento consolidado: o leitor cai "
    "onde já caía, e a citação deixa de prometer precisão que não entrega. "
    "Grava-se sempre a grafia REAL da âncora. Fragmento #page=N em PDF é "
    "parâmetro de abertura válido e não se toca. Documento inacessível não é "
    "alterado.")


def conferir(urls: list[str], sem_rede: bool) -> dict[str, dict]:
    conferencia: dict[str, dict] = {}
    for indice, url in enumerate(urls, 1):
        bruto, status = medicao.baixa(url, sem_rede)
        registro = {"url": url, "consultado_em": medicao.HOJE,
                    "http_status": status}
        if bruto:
            texto, codificacao = medicao.decodifica(bruto)
            coletor = medicao.ColetorDeAncoras()
            try:
                coletor.feed(texto)
            except Exception:
                pass
            leis, ano = medicao.normas_alteradoras(texto)
            registro |= {
                "sha256": medicao.hashlib.sha256(bruto).hexdigest(),
                "encoding": codificacao, "ancoras": sorted(coletor.ids),
                "n_ancoras": len(coletor.ids), "leis_alteradoras": leis,
                "ano_max_alteracao": ano,
            }
        conferencia[url] = registro
        if indice % 100 == 0:
            print(f"  [{indice}/{len(urls)}]", flush=True)
    return conferencia


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--acervo", default=os.fspath(BACKUP))
    parser.add_argument("--sem-rede", action="store_true")
    args = parser.parse_args()

    medicao.PAGES = Path(args.acervo)
    combinacoes, paginas = medicao.varre_acervo()
    bases = sorted({u.split("#", 1)[0] for u in combinacoes})
    alvos: list[str] = []
    for base in bases:
        candidatas = [base] + medicao.variantes(base)
        if base in ALTERNATIVAS_CONFERIDAS:
            candidatas.insert(1, ALTERNATIVAS_CONFERIDAS[base])
        for candidata in candidatas:
            if candidata not in alvos:
                alvos.append(candidata)
    print(f"acervo {args.acervo}: {sum(combinacoes.values())} ocorrência(s), "
          f"{len(combinacoes)} combinação(ões); conferindo {len(alvos)} documento(s)")
    conferencia = conferir(alvos, args.sem_rede)

    def ok(url: str) -> dict | None:
        registro = conferencia.get(url) or {}
        return registro if registro.get("ancoras") is not None else None

    classe: collections.Counter = collections.Counter()
    correcoes: list[dict] = []
    for combinacao, quantas in combinacoes.items():
        base, _, fragmento = combinacao.partition("#")
        if base.lower().endswith(".pdf") and fragmento.startswith("page="):
            classe["fragmento_pdf_valido"] += quantas
            continue
        documento = ok(base)
        formas = medicao.formas_do_fragmento(fragmento)
        if documento is None:
            alternativa = ok(ALTERNATIVAS_CONFERIDAS.get(base, ""))
            exatas = ([f for f in formas if f in set(alternativa["ancoras"])]
                      if alternativa else [])
            if exatas:
                classe["url_404_com_alternativa"] += quantas
                novo = ALTERNATIVAS_CONFERIDAS[base]
                correcoes.append({
                    "classe": "troca_url", "url_antiga": combinacao,
                    "url_nova": f"{novo}#{exatas[0]}", "ocorrencias": quantas,
                    "porque": (f"O caminho citado responde 404. O mesmo "
                               f"documento oficial responde 200 em {novo}, com "
                               f"{alternativa['n_ancoras']} âncoras, inclusive "
                               f"#{exatas[0]}."),
                    "leis_perdidas": [], "ancora_conferida": exatas[0],
                    "ancoras_documento_antigo": 0,
                    "ancoras_documento_novo": alternativa["n_ancoras"]})
                continue
            classe["documento_inacessivel"] += quantas
            continue
        ancoras = set(documento["ancoras"])
        exatas = [f for f in formas if f in ancoras]
        if exatas and exatas[0] == fragmento:
            classe["ancora_existe"] += quantas
            continue
        if exatas:
            classe["corrige_grafia_ancora"] += quantas
            correcoes.append({
                "classe": "troca_url", "url_antiga": combinacao,
                "url_nova": f"{base}#{exatas[0]}", "ocorrencias": quantas,
                "porque": (f"O documento citado tem a âncora #{exatas[0]}, não "
                           f"#{fragmento}: fragmento não casa sem diferenciar "
                           f"maiúscula de minúscula. Mesmo documento, grafia "
                           f"corrigida."),
                "leis_perdidas": [], "ancora_conferida": exatas[0],
                "ancoras_documento_antigo": documento["n_ancoras"],
                "ancoras_documento_novo": documento["n_ancoras"]})
            continue
        leis_citado = set(documento.get("leis_alteradoras") or [])
        escolhida = None
        motivos: list[str] = []
        for variante in medicao.variantes(base):
            candidato = ok(variante)
            if candidato is None:
                motivos.append(f"{variante}: sem resposta")
                continue
            presentes = [f for f in formas if f in set(candidato["ancoras"])]
            if not presentes:
                motivos.append(f"{variante}: 200, {candidato['n_ancoras']} "
                               f"âncoras, sem {fragmento}")
                continue
            perdidas = sorted(leis_citado
                              - set(candidato.get("leis_alteradoras") or []))
            if perdidas:
                motivos.append(f"{variante}: tem a âncora mas perderia "
                               f"{len(perdidas)} norma(s) alteradora(s): "
                               f"{perdidas[:3]}")
                continue
            escolhida = (variante, candidato, presentes[0])
            break
        if escolhida:
            variante, candidato, ancora = escolhida
            classe["troca_url"] += quantas
            correcoes.append({
                "classe": "troca_url", "url_antiga": combinacao,
                "url_nova": f"{variante}#{ancora}", "ocorrencias": quantas,
                "porque": (f"O documento citado tem {documento['n_ancoras']} "
                           f"âncora(s) e não a #{fragmento}; a variante do mesmo "
                           f"documento oficial tem {candidato['n_ancoras']} "
                           f"âncoras, inclui #{ancora} e não perde nenhuma das "
                           f"{len(leis_citado)} norma(s) alteradora(s) anotadas "
                           f"no documento citado."),
                "leis_perdidas": [], "ancora_conferida": ancora,
                "ancoras_documento_antigo": documento["n_ancoras"],
                "ancoras_documento_novo": candidato["n_ancoras"],
                "ano_max_alteracao_antigo": documento.get("ano_max_alteracao"),
                "ano_max_alteracao_novo": candidato.get("ano_max_alteracao")})
        else:
            classe["remove_fragmento"] += quantas
            correcoes.append({
                "classe": "remove_fragmento", "url_antiga": combinacao,
                "url_nova": base, "ocorrencias": quantas,
                "porque": (f"O documento citado tem {documento['n_ancoras']} "
                           f"âncora(s) e não a #{fragmento}, e nenhuma variante "
                           f"do mesmo documento oficial serve sem prejuízo de "
                           f"atualização: " + "; ".join(motivos[:3]) +
                           ". Mantém-se o documento consolidado, sem o fragmento."),
                "ancoras_documento_antigo": documento["n_ancoras"]})

    for nome, quantas in classe.most_common():
        print(f"{quantas:6d}  {nome}")

    # De cada documento fica no plano só a âncora que alguma correção usa como
    # destino: é o que o preflight do aplicador confere, e a lista inteira
    # (centenas por norma) inflaria o arquivo sem acrescentar prova.
    precisa: dict[str, set[str]] = collections.defaultdict(set)
    usados: set[str] = set()
    for correcao in correcoes:
        usados.add(correcao["url_antiga"].split("#", 1)[0])
        usados.add(correcao["url_nova"].split("#", 1)[0])
        if correcao.get("ancora_conferida"):
            precisa[correcao["url_nova"].split("#", 1)[0]].add(
                correcao["ancora_conferida"])
    documentos = {}
    for url in sorted(usados):
        registro = conferencia.get(url)
        if not registro:
            continue
        copia = dict(registro)
        copia["ancoras"] = sorted(precisa[url] & set(registro.get("ancoras") or []))
        copia["ancoras_listadas"] = "apenas as usadas como destino de correção"
        documentos[url] = copia

    DESTINO.write_text(json.dumps(
        {"criterio": CRITERIO, "gerado_em": medicao.HOJE,
         "acervo_medido": args.acervo, "documentos": documentos,
         "correcoes": sorted(correcoes, key=lambda c: c["url_antiga"])},
        ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    print(f"plano: {len(correcoes)} correção(ões) em "
          f"{os.path.relpath(DESTINO, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
