#!/bin/bash
# check-claude-idle-cpu — quanto CPU um Claude Code OCIOSO queima por segundo?
#
# O `ai-session-reaper` usa ΔCPU da árvore como um dos sinais de "esta sessão
# ainda trabalha". O limiar inicial era absoluto (2 jiffies entre observações) e
# acusava vida sempre: um TUI parado no prompt mantém event loop, timers e hooks,
# e queima bem mais que 20 ms em qualquer intervalo real.
#
# O limiar tem que ser uma TAXA, e a taxa tem que sair de medição. Este script
# mede o piso: uma sessão detached com Claude ocioso, jiffies por segundo ao
# longo de uma janela. O reaper deve usar um múltiplo confortável desse piso.
#
# Sessão própria com prefixo `cpuprobe-`, removida ao sair.

set -uo pipefail
JANELA="${1:-60}"
S="cpuprobe-$$"

limpar() { tmux kill-session -t "=$S" 2>/dev/null; }
trap limpar EXIT INT TERM

descendants() {
	ps -eo pid,ppid --no-headers 2>/dev/null | awk -v r="$1" '
    {p[$1]=$2} END{ n=1; q[1]=r; seen[r]=1
      for(i=1;i<=n;i++){ for(k in p){ if(p[k]==q[i] && !(k in seen)){ seen[k]=1; q[++n]=k } } }
      for(i=2;i<=n;i++) print q[i] }'
}
cpu_arvore() {
	local root="$1" p total=0 u s
	for p in "$root" $(descendants "$root"); do
		read -r u s < <(awk '{print $14, $15}' "/proc/$p/stat" 2>/dev/null) || continue
		total=$((total + ${u:-0} + ${s:-0}))
	done
	echo "$total"
}

tmux new-session -d -s "$S" -x 120 -y 40 \
	'cd /opt/wiki && claude --permission-mode bypassPermissions' 2>/dev/null || {
	echo "não foi possível criar a sessão"
	exit 2
}

PP=""
for _ in $(seq 1 20); do
	command sleep 1
	PP=$(tmux list-panes -t "=$S" -F '#{pane_pid}' 2>/dev/null | head -1)
	[ -n "$PP" ] && pgrep -P "$PP" >/dev/null 2>&1 && break
done
[ -n "$PP" ] || {
	echo "pane não subiu"
	exit 2
}

echo "aguardando o startup assentar (hooks, indexação)..."
command sleep 45

echo "medindo ${JANELA}s de Claude OCIOSO na sessão $S"
c0=$(cpu_arvore "$PP")
t0=$(date +%s)
for _ in $(seq 1 $((JANELA / 15))); do
	command sleep 15
	c=$(cpu_arvore "$PP")
	dt=$(($(date +%s) - t0))
	dc=$((c - c0))
	printf '  t=%3ss  Δjiffies=%-6s  taxa=%s jiffies/s\n' "$dt" "$dc" "$(awk -v a="$dc" -v b="$dt" 'BEGIN{printf "%.2f", a/b}')"
done
c=$(cpu_arvore "$PP")
dt=$(($(date +%s) - t0))
dc=$((c - c0))
taxa=$(awk -v a="$dc" -v b="$dt" 'BEGIN{printf "%.2f", a/b}')
echo
echo "  piso do ocioso: ${taxa} jiffies/s (~$(awk -v t="$taxa" 'BEGIN{printf "%.1f", t}')% de um núcleo)"
echo "  o reaper deve tratar como 'parado' qualquer taxa até um múltiplo disso;"
echo "  limiar absoluto entre observações não funciona — acusa vida sempre."
exit 0
