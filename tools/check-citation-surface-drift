#!/usr/bin/env bash
# check-citation-surface-drift — a página SERVIDA cita dispositivo que o acervo
# canônico não afirma mais? READ-ONLY: não escreve em data/, content/ nem public/.
#
# POR QUE EXISTE (BUG-116, 2026-08-29). Os outros gates de citação leem o shard
# JSONL. Depois que o shard é consertado eles ficam verdes — e o verde passa a
# dizer "o dado está certo", nunca "o público está lendo o dado certo". Entre as
# duas coisas existe uma publicação, que pode demorar dias.
#
# Foi o que houve com a Lei 8.213/1991: o "art. 24-A" (dispositivo inexistente;
# o correto é o 27-A) foi corrigido no shard às 08:07 e às 12:47 as duas rotas
# continuavam servindo o erro, porque o public/ era das 04:55. A coerência de
# artefato não denuncia isso: o html_sha256 do manifesto bate com o HTML velho.
#
# ATENÇÃO ao diagnosticar por conta própria: o autolinker PARTE a citação —
# `grep 'art. 24-A' public/` devolve ZERO com o defeito no ar, porque o HTML traz
# `<a href="...#art24">art. 24</a>-A`. Ausência no public/ não é ausência do erro.
#
# VERDE AQUI NÃO É PROVA DE CITAÇÃO CORRETA. Se shard e HTML concordarem num
# artigo que não existe na lei, este gate cala: a classe segue P1 permanente e
# segue exigindo conferência contra a fonte oficial.
#
# O motor é internal/citationsurfacedrift e é o MESMO que o gate
# "citation-surface-drift" de internal/checks executa.
#
#   tools/check-citation-surface-drift
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e nao `go-modern run ./cmd/check` direto: e por ele que passam
# o cache do binario, o teto de tempo, o orcamento e a politica de argumentos.
# Chamar o binario de gates por fora recompila a cada invocacao e escapa do teto —
# com 330 gates, e a diferenca entre 2,6 s e 5,2 s por chamada.
exec "$ROOT/tools/run-check" citation-surface-drift --timings "$@"
