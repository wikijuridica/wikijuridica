#!/usr/bin/env python3
"""medir-ancoras-de-dispositivo — conta, no HTML servido, o que cada link para o
Planalto consegue apontar: o artigo, o parágrafo ou nada além do topo.

POR QUE EXISTE. Em 2026-09-11 duas sessões mediram "o mesmo" antes da publicação
que levaria as âncoras profundas ao ar e chegaram a números diferentes para os
links de artigo letrado — 341 de um lado, 299 do outro. Nenhuma das duas estava
errada sobre o próprio recorte: uma contava LINKS cujo `href` não tem fragmento
nenhum e cujo texto cita `art. N-A`; a outra contava outra população com o mesmo
nome. Contagem sem definição publicada não se reconcilia, e comparar dois números
de instrumentos diferentes é o defeito que este arquivo existe para fechar: o
antes e o depois passam a sair do MESMO código, com as classes escritas.

AS CLASSES, e o que separa cada uma da vizinha:

  `paragrafo_resolvido`  o `href` já traz `#artN§K` — o link cai no parágrafo.
                         As duas grafias contam: `§` literal e `%C2%A7`. Medido
                         em 2026-09-11, antes da publicação: 91 links já saíam
                         com o `§` LITERAL e nenhum percent-encoded. Não é
                         defeito — o fragmento nunca chega ao servidor, o
                         navegador resolve contra os ids do documento, e o id do
                         Planalto É `art37§6`. O `%C2%A7` aparece do lado do
                         JSON-LD, onde o consumidor é máquina e o campo tem de
                         ser URI válida.
  `raso`                 o `href` traz `#artN` puro. Pode ser a âncora certa (o
                         texto fala do artigo) ou um recuo (o texto fala de um
                         parágrafo que o documento não ancora).
  `sem_fragmento`        o `href` não tem `#` nenhum — o link cai no TOPO de um
                         documento que costuma ter centenas de artigos.
  `fragmento_de_outra_forma`
                         tem `#`, não traz marca de parágrafo e não tem forma de
                         artigo. Conta à parte para não inflar `raso` com o que
                         não é dele.

E dentro das duas últimas, o que o registry de âncoras permitiria emitir:

  `paragrafo_emitivel`   `href` é `#artN`, o texto cita `§ K` e o registry tem
                         `artN§K` — este link VAI ganhar o fragmento de parágrafo.
  `paragrafo_sem_ancora` idem, e o registry NÃO tem — continua recuando para o
                         artigo, que é a degradação correta.
  `letrado_emitivel`     `href` sem fragmento, o texto cita `art. N-A` e o
                         registry tem `artNa` — vai ganhar fragmento.
  `letrado_sem_ancora`   idem, e o registry não tem — continua no topo.

`fora_do_registry` conta o link cujo documento o registry não cobre. Ele não
entra em classe nenhuma e é publicado à parte, porque "não sei" somado a "não
muda" seria aceitar no veredito o que não foi medido.

O QUE ESTE INSTRUMENTO NÃO VÊ, escrito para ninguém inferir o contrário:
  - a gêmea Markdown, que é rota dinâmica e não mora em `public/` — ela se mede
    pelo nginx, com sonda própria;
  - link para o Planalto que não seja `.htm` (as páginas `.asp` e os PDFs);
  - o que o texto do link QUER dizer além do artigo e do parágrafo (inciso,
    alínea): não há âncora para isso no Planalto, e fingir que há seria inventar.

Uso:
    tools/medir-ancoras-de-dispositivo                       # JSON no stdout
    tools/medir-ancoras-de-dispositivo --json-para <arquivo>
    tools/medir-ancoras-de-dispositivo --registry <caminho>

Testes: python3 tools/test_medir_ancoras_de_dispositivo.py
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import re
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
PUBLIC = os.path.join(ROOT, "public")
REGISTRY = os.path.join(ROOT, "data", "source-audit", "planalto_anchor_registry_20260911.jsonl")

# UM SÓ PADRÃO, e a lista de atributos entre o href e o `>` é livre — medido em
# 2026-09-11, e o número é o argumento. Exigindo a forma literal
# `" rel="external">`, a varredura devolvia 8.034 links com fragmento; aceitando
# qualquer atributo, 16.530. Os 8.496 perdidos estavam todos no bloco de
# Proveniência, que sai com `target="_blank" rel="external noopener"` — metade
# exata do acervo de links, invisível para um instrumento que casava a forma de
# um dos dois produtores. O fragmento é OPCIONAL no padrão para que a mesma
# passada classifique "com" e "sem" sobre o MESMO conjunto de links: dois
# padrões com recortes diferentes foi como as duas contagens divergiram.
LINK_PARA_O_PLANALTO = re.compile(
    r'<a\s+href="(https://www\.planalto\.gov\.br/[^"#]+\.htm)(?:#([^"]*))?"[^>]*>([^<]*)</a>')
# "§ 2º", "&#167; 2" — o texto servido usa o caractere, o HTML antigo usa a entidade.
PARAGRAFO_NO_TEXTO = re.compile(r"(?:§|&#167;)\s*(\d+)")
# "art. 1.015-A", "artigo 5º-B" — o ponto do milhar cai, a letra vira minúscula.
ARTIGO_LETRADO_NO_TEXTO = re.compile(
    r"art(?:igo)?\.?\s*([0-9][0-9.]*)\s*(?:[ºo°]\s*)?-\s*([A-Za-z])\b", re.I)
# A MARCA DE PARÁGRAFO BASTA, e a forma exata NÃO se exige — medido em
# 2026-09-11. Um padrão `^art[0-9a-z]+(§|%C2%A7)\d+$` deixava 7 dos 91 links já
# resolvidos caírem no balde `raso`, que é a classe ERRADA e não reduz total
# nenhum: `adctart10§1` (o ADCT tem prefixo próprio e numeração dentro da
# CF/88), `art16§5.0` e `art77§2.0` (o sufixo `.0` vem do documento do Planalto,
# que passou a marcar assim), e `art225§1iv` (o inciso entra colado ao
# parágrafo). Os quatro apontam para parágrafo de verdade; o que variava era a
# forma, não o fato. Classificar pela marca — e não pela forma que eu imaginei —
# é o que impede o instrumento de medir o produtor que eu conheço em vez do
# acervo que existe.
MARCA_DE_PARAGRAFO = re.compile(r"(?:%C2%A7|§)")
# `adct` é o único prefixo de corpo dentro de uma norma que o acervo usa hoje
# (5 links). Sem ele, `adctart10` não é nem raso nem resolvido — some. O hífen
# entra porque o fragmento do artigo letrado pode vir assim do documento:
# `art391-a` é a CLT art. 391-A, âncora legítima e resolvida. Sobram em
# `fragmento_de_outra_forma` os 7 links de ANEXO (`anexoiv`, `anexoiart36iii`),
# que não são artigo e não têm classe própria — contá-los em `raso` diria que um
# anexo é um artigo raso.
FRAGMENTO_RASO = re.compile(r"^(?:adct)?art[0-9a-z.\-]+$")


def le_registry(caminho):
    """url -> {"artigo", "letrado", "paragrafo"}, cada um um conjunto de âncoras."""
    por_url = {}
    with open(caminho, encoding="utf-8") as arquivo:
        for linha in arquivo:
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            url = registro.get("url")
            if not url:
                continue
            por_url[url] = {
                "artigo": set(registro.get("ancoras_de_artigo") or ()),
                "letrado": set(registro.get("ancoras_de_artigo_letrado") or ()),
                "paragrafo": set(registro.get("ancoras_de_paragrafo") or ()),
            }
    return por_url


def ancora_de_paragrafo_pretendida(fragmento, texto):
    """`artN§K` quando o href é raso e o texto cita um parágrafo; senão None."""
    if not FRAGMENTO_RASO.match(fragmento):
        return None
    achado = PARAGRAFO_NO_TEXTO.search(texto)
    if not achado:
        return None
    return fragmento + "§" + achado.group(1)


def ancora_letrada_pretendida(texto):
    """`artNa` quando o texto cita um artigo letrado; senão None."""
    achado = ARTIGO_LETRADO_NO_TEXTO.search(texto)
    if not achado:
        return None
    return "art" + achado.group(1).replace(".", "") + achado.group(2).lower()


def classifica(html, registry):
    """Conta as classes de um documento HTML. Devolve (contagens, paginas_tocadas)."""
    contagens = collections.Counter()
    tocada = set()
    for documento, fragmento, texto in LINK_PARA_O_PLANALTO.findall(html):
        ancoras = registry.get(documento)
        if fragmento:
            if MARCA_DE_PARAGRAFO.search(fragmento):
                contagens["paragrafo_resolvido"] += 1
                continue
            if not FRAGMENTO_RASO.match(fragmento):
                # Fragmento que não é nem parágrafo nem artigo: conta à parte em
                # vez de entrar em `raso` e inflar a classe com o que não é dela.
                contagens["fragmento_de_outra_forma"] += 1
                continue
            contagens["raso"] += 1
            if ancoras is None:
                contagens["fora_do_registry"] += 1
                continue
            pretendida = ancora_de_paragrafo_pretendida(fragmento, texto)
            if pretendida is None:
                continue
            if pretendida in ancoras["paragrafo"]:
                contagens["paragrafo_emitivel"] += 1
                tocada.add("paragrafo")
            else:
                contagens["paragrafo_sem_ancora"] += 1
            continue
        contagens["sem_fragmento"] += 1
        if ancoras is None:
            contagens["fora_do_registry"] += 1
            continue
        pretendida = ancora_letrada_pretendida(texto)
        if pretendida is None:
            continue
        if pretendida in ancoras["letrado"] or pretendida in ancoras["artigo"]:
            contagens["letrado_emitivel"] += 1
            tocada.add("letrado")
        else:
            contagens["letrado_sem_ancora"] += 1
    return contagens, tocada


def varre(raiz, registry):
    total = collections.Counter()
    paginas = collections.Counter()
    arquivos = 0
    for pasta, _, nomes in os.walk(raiz):
        if "index.html" not in nomes:
            continue
        caminho = os.path.join(pasta, "index.html")
        try:
            with open(caminho, encoding="utf-8") as arquivo:
                html = arquivo.read()
        except OSError:
            continue
        arquivos += 1
        contagens, tocada = classifica(html, registry)
        total.update(contagens)
        for classe in tocada:
            paginas[classe] += 1
    return arquivos, total, paginas


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("--raiz", default=PUBLIC, help="árvore de HTML a varrer (padrão public/)")
    parser.add_argument("--registry", default=REGISTRY, help="registry de âncoras do Planalto")
    parser.add_argument("--json-para", help="grava o JSON aqui além de imprimi-lo")
    args = parser.parse_args(argv)

    try:
        registry = le_registry(args.registry)
    except (OSError, ValueError) as erro:
        print("medir-ancoras-de-dispositivo: registry ilegível: %s" % erro, file=sys.stderr)
        return 2
    if not registry:
        print("medir-ancoras-de-dispositivo: registry vazio — nada a comparar", file=sys.stderr)
        return 2

    arquivos, total, paginas = varre(args.raiz, registry)
    if not arquivos:
        print("medir-ancoras-de-dispositivo: nenhum index.html em %s" % args.raiz, file=sys.stderr)
        return 2

    saida = {
        "arquivos_lidos": arquivos,
        "documentos_no_registry": len(registry),
        "links": {classe: total.get(classe, 0) for classe in (
            "paragrafo_resolvido", "raso", "sem_fragmento",
            "paragrafo_emitivel", "paragrafo_sem_ancora",
            "letrado_emitivel", "letrado_sem_ancora", "fora_do_registry",
            "fragmento_de_outra_forma")},
        "paginas_com_paragrafo_emitivel": paginas.get("paragrafo", 0),
        "paginas_com_letrado_emitivel": paginas.get("letrado", 0),
    }
    texto = json.dumps(saida, ensure_ascii=False, sort_keys=True, indent=1)
    print(texto)
    if args.json_para:
        try:
            with open(args.json_para, "w", encoding="utf-8") as arquivo:
                arquivo.write(texto + "\n")
        except OSError as erro:
            print("medir-ancoras-de-dispositivo: falha gravando %s: %s" % (args.json_para, erro),
                  file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
