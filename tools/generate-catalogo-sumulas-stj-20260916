#!/usr/bin/env python3
"""generate-catalogo-sumulas-stj-20260916 — catálogo de existência das súmulas
do STJ, de fonte oficial, com URL, data e hash.

POR QUE EXISTE. `internal/cerebro` aceita `sumula:STJ:5` porque o TEXTO do
acórdão diz isso, e nada confere se a súmula existe: as súmulas contornam o
`internal/lexml` inteiro (`extracao.go`, `urnBrutaDaCitacao`). Medido em
2026-09-16 sobre o snapshot datado de `data/ai/extracoes_dispositivos.jsonl`
(45.089 linhas, sha256 f689279c…): 61.187 itens de súmula no recorte, e 18 deles
citam número que não existe em tribunal nenhum ("Súmula 735 do STJ" — 735 é do
STF; "Súmula 831 do STJ", que não existe). Sem catálogo, alucinação de número
vira nó do grafo e sai na página.

A FONTE. O PDF consolidado que o próprio STJ publica:

    https://www.stj.jus.br/docs_internet/SumulasSTJ.pdf

Ele traz, por súmula, o enunciado, o órgão julgador e a data da decisão. Medido
em 2026-09-16: 7.814.927 bytes, 649 súmulas, numeração 1..649 SEM buraco, a
última de 28/04/2021.

O TETO É DECLARADO, NUNCA ESCONDIDO. O arquivo oficial para em 649, e o STJ já
editou súmulas acima disso. Este catálogo prova EXISTÊNCIA até 649 e NÃO fala
sobre 650+. Quem consome decide o que fazer com o que está acima do teto, mas
tem de saber que está — a alternativa (tratar silêncio da fonte como prova de
inexistência) é o defeito que este repositório já catalogou: ausência de sinal
não é evidência.

POR QUE SÓ O STJ. O STF não serve fonte oficial alcançável ao WikijuridicaBot,
e isso foi medido em 2026-09-16, não suposto:

    portal.stf.jus.br/jurisprudencia/sumariosumulas.asp   -> HTTP 403
    www.stf.jus.br/arquivo/cms/.../Enunciados_Sumulas_STF -> HTTP 403
    jurisprudencia.stf.jus.br/api/search/search           -> HTTP 202, corpo vazio
    www.lexml.gov.br/busca/SRU                            -> página de verificação
                                                             de segurança do Senado

A cadeia TLS do STF também é incompleta no servidor (`Verify return code: 21`,
ele não envia o intermediário); isso se resolve baixando o intermediário pela
própria AIA do certificado — o que um navegador faz — e NÃO com `-k`, que
desligaria a verificação. Mesmo com a cadeia correta, a resposta é 403.
Portanto: súmula do STF fica FORA DO ALCANCE deste catálogo, declarada, e não
se afirma nada sobre ela.

O QUE ELE ESCREVE.
  1. data/source-audit/sumulas_stj_20260916.jsonl — uma linha por súmula
     (número, enunciado, data da decisão, órgão) mais uma linha `_meta` com a
     URL, os bytes, o sha256 do PDF e o sha256 do texto extraído.
  2. internal/sumulas/catalogo_stj_generated.go — a tabela em FONTE GO, pelo
     mesmo motivo de `internal/lexml/norm_registry_generated.go`: o grafo de
     atestação de ingestão só aceita `.go` no snapshot de código.

O Go guarda número, data e o sha256 do enunciado — não o texto. O texto mora na
evidência, e `TestCatalogoSTJBateComEvidencia` falha se os dois divergirem: é a
mesma forma de `TestNormasDatadasBateComEvidencia`.

Uso:
    tools/generate-catalogo-sumulas-stj-20260916            # baixa, extrai, grava
    tools/generate-catalogo-sumulas-stj-20260916 --pdf ARQ  # usa um PDF já baixado
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from datetime import date

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
URL = "https://www.stj.jus.br/docs_internet/SumulasSTJ.pdf"
EVIDENCIA = "data/source-audit/sumulas_stj_20260916.jsonl"
TABELA_GO = "internal/sumulas/catalogo_stj_generated.go"

# A identidade de saída é a do portal, nunca um User-Agent de terceiro nem de
# navegador: internal/wikijuridicabot.Nome é a fonte desta string, e o prefixo
# "Mozilla/5.0 (compatible;" é medido, não disfarce (ver o pacote).
UA = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
      "+https://wikijuridica.com.br/bot/; catalogo-sumulas)")

RE_BLOCO = re.compile(r"^Súmula (\d+)\s*$", re.M)


def baixa_pdf(destino):
    req = urllib.request.Request(URL, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=180) as resp:
        if resp.status != 200:
            raise SystemExit(f"fonte oficial devolveu HTTP {resp.status}")
        dados = resp.read()
    with open(destino, "wb") as f:
        f.write(dados)
    return dados


def extrai_texto(pdf):
    saida = pdf + ".txt"
    subprocess.run(["pdftotext", "-layout", pdf, saida], check=True)
    with open(saida, encoding="utf-8") as f:
        return f.read()


def parseia(texto):
    """Devolve [(numero, enunciado, data_decisao, orgao)] na ordem do documento.

    Súmula sem enunciado legível NÃO entra: catálogo de existência que admite
    entrada sem prova não prova nada.
    """
    marcas = [(int(m.group(1)), m.start(), m.end()) for m in RE_BLOCO.finditer(texto)]
    saida = []
    for i, (numero, _, fim) in enumerate(marcas):
        corpo = texto[fim:marcas[i + 1][1]] if i + 1 < len(marcas) else texto[fim:]
        enunciado = re.search(r"\n\s*Enunciado\s*\n(.*?)(?=\n\s*(?:Órgão Julgador|Data da Decisão|Fonte)\s*\n)",
                              corpo, re.S)
        if not enunciado:
            continue
        texto_enunciado = " ".join(enunciado.group(1).split())
        if not texto_enunciado:
            continue
        data = re.search(r"\n\s*Data da Decisão\s*\n\s*(\d{2}/\d{2}/\d{4})", corpo)
        orgao = re.search(r"\n\s*Órgão Julgador\s*\n\s*(.+)", corpo)
        saida.append((numero, texto_enunciado,
                      iso(data.group(1)) if data else "",
                      orgao.group(1).strip() if orgao else ""))
    return saida


def iso(ddmmaaaa):
    d, m, a = ddmmaaaa.split("/")
    return f"{a}-{m}-{d}"


def grava_evidencia(caminho, itens, sha_pdf, bytes_pdf, sha_texto, consultado_em):
    linhas = [json.dumps({
        "_meta": ("Catalogo de EXISTENCIA das sumulas do STJ, de fonte oficial. Prova existencia de 1 a "
                  f"{max(n for n, _, _, _ in itens)}; NAO fala sobre numero acima disso (o PDF oficial para ai). "
                  "Sumula do STF esta FORA DO ALCANCE: medido em 2026-09-16, o STF devolve 403 ao "
                  "WikijuridicaBot no portal e no www, 202 com corpo vazio na API de jurisprudencia, e o "
                  "LexML/Senado responde com pagina de verificacao de seguranca."),
        "fonte_oficial_url": URL,
        "fonte_bytes": bytes_pdf,
        "fonte_sha256": sha_pdf,
        "texto_extraido_sha256": sha_texto,
        "extrator": "pdftotext -layout (poppler)",
        "consultado_em": consultado_em,
        "total": len(itens),
        "produzido_por": "tools/generate-catalogo-sumulas-stj-20260916",
    }, ensure_ascii=False)]
    for numero, enunciado, data, orgao in itens:
        linhas.append(json.dumps({
            "tribunal": "STJ",
            "sumula": numero,
            "enunciado": enunciado,
            "enunciado_sha256": hashlib.sha256(enunciado.encode("utf-8")).hexdigest(),
            "data_decisao": data,
            "orgao_julgador": orgao,
            "fonte_oficial_url": URL,
            "fonte_sha256": sha_pdf,
            "consultado_em": consultado_em,
        }, ensure_ascii=False))
    with open(caminho, "w", encoding="utf-8") as f:
        f.write("\n".join(linhas) + "\n")


CABECALHO_GO = '''// Code generated by tools/generate-catalogo-sumulas-stj-20260916; DO NOT EDIT.

package sumulas

// sumulasSTJ e o numero de cada sumula do STJ que a fonte oficial prova existir,
// com a data da decisao e o sha256 do enunciado. O enunciado em si fica na
// evidencia (data/source-audit/sumulas_stj_20260916.jsonl), e
// TestCatalogoSTJBateComEvidencia falha se os dois divergirem.
//
// Fonte: {url}
// Consultado em {data}; {bytes} bytes; sha256 do PDF {sha}.
var sumulasSTJ = []sumulaCatalogada{{
'''


def grava_tabela_go(caminho, itens, sha_pdf, bytes_pdf, consultado_em):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    partes = [CABECALHO_GO.format(url=URL, data=consultado_em, bytes=bytes_pdf, sha=sha_pdf)]
    for numero, enunciado, data, _ in itens:
        sha = hashlib.sha256(enunciado.encode("utf-8")).hexdigest()
        partes.append(f'\t{{Numero: {numero}, Data: "{data}", EnunciadoSHA256: "{sha}"}},\n')
    partes.append("}\n")
    with open(caminho, "w", encoding="utf-8") as f:
        f.write("".join(partes))


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--pdf", help="usa um PDF ja baixado em vez de ir a rede")
    args = p.parse_args()

    consultado_em = date.today().isoformat()
    if args.pdf:
        with open(args.pdf, "rb") as f:
            dados = f.read()
        pdf = args.pdf
    else:
        pdf = os.path.join(tempfile.gettempdir(), "SumulasSTJ.pdf")
        dados = baixa_pdf(pdf)
    sha_pdf = hashlib.sha256(dados).hexdigest()
    texto = extrai_texto(pdf)
    sha_texto = hashlib.sha256(texto.encode("utf-8")).hexdigest()
    itens = parseia(texto)
    if len(itens) < 600:
        raise SystemExit(f"so {len(itens)} sumulas extraidas: a fonte mudou de forma, nao se grava catalogo pela metade")
    numeros = [n for n, _, _, _ in itens]
    buracos = sorted(set(range(1, max(numeros) + 1)) - set(numeros))
    grava_evidencia(os.path.join(RAIZ, EVIDENCIA), itens, sha_pdf, len(dados), sha_texto, consultado_em)
    grava_tabela_go(os.path.join(RAIZ, TABELA_GO), itens, sha_pdf, len(dados), consultado_em)
    print(f"sumulas do STJ catalogadas: {len(itens)} (1..{max(numeros)}), buracos: {len(buracos)} {buracos[:10]}")
    print(f"  PDF {len(dados)} bytes sha256 {sha_pdf}")
    print(f"  evidencia: {EVIDENCIA}")
    print(f"  tabela Go: {TABELA_GO}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
