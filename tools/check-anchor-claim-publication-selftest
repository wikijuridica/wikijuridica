#!/usr/bin/env python3
"""check-anchor-claim-publication-selftest — prova que o gate de proveniencia
publicada NAO deixa o ruido de bookkeeping esconder defeito de conteudo.

Read-only: nao escreve nada. Executa o gate real como subprocesso e le o
relatorio dele -- reimplementar a formatacao aqui provaria a copia, nao o gate.

POR QUE ESTE ARQUIVO EXISTE. Ate 2026-08-29 o gate empilhava a divergencia de
`content_sha256` na MESMA lista das falhas substantivas e imprimia so as 40
primeiras. Como a divergencia aparece de uma vez em TODAS as rotas quando o
acervo e republicado (medido: 10.070 de 10.070), as 40 linhas exibidas eram
sempre bookkeeping das rotas iniciais e o gate escondia por completo o que ele
existe para achar. O que estava escondido, quando as listas foram separadas:

  * /glossario/qualidade-de-segurado/ publicando "art. 24-A" da Lei 8.213 --
    artigo que NAO EXISTE (o correto e 27-A);
  * dois titulos de fonte oficial com "no" corrompido em "nº";
  * duas afirmacoes publicadas sem acentuacao ("nao", "sao").

As tres propriedades abaixo impedem a volta do defeito. Nenhuma delas afrouxa o
gate: a divergencia continua reprovando e continua nomeada.

  A. AGREGACAO. A divergencia de versao aparece como UMA linha com a contagem,
     nunca uma linha por rota. Mais de uma = o ruido voltou a competir com o
     achado real pela cota de exibicao.
  B. PRODUTOR NOMEADO. A linha agregada diz qual ferramenta regenera o registro
     -- sem isso a leitura do gate termina em "e agora?".
  C. VEREDITO PRESERVADO. Com divergencia, o gate continua saindo 1. Separar
     listas nunca pode virar anistia.

Uso:
    tools/check-anchor-claim-publication-selftest
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
GATE = RAIZ / "tools" / "check-anchor-claim-publication"
PRODUTOR = "tools/generate-anchor-claim-publication-20260826"
LINHA_AGREGADA = "versão de conteúdo defasada"
FORMA_ANTIGA = re.compile(r"content_sha256 de \S+ não bate com o published_manifest")


def main() -> int:
    executado = subprocess.run(
        [sys.executable, str(GATE)],
        cwd=str(RAIZ),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=600,
    )
    saida = executado.stdout
    falhas: list[str] = []

    agregadas = saida.count(LINHA_AGREGADA)
    por_rota = len(FORMA_ANTIGA.findall(saida))

    if por_rota:
        falhas.append(
            f"A: o gate voltou a emitir {por_rota} linha(s) de divergência POR ROTA; "
            "com o acervo republicado isso consome a cota de exibição inteira e "
            "esconde afirmação fora da regra, afirmação ausente do estoque e molde"
        )
    if agregadas > 1:
        falhas.append(
            f"A: a divergência de versão apareceu {agregadas} vezes; ela é UM fato "
            "sobre o registro inteiro e tem de ser uma linha só"
        )
    if agregadas == 1 and PRODUTOR not in saida:
        falhas.append(f"B: a linha agregada não nomeia o produtor que regenera o registro ({PRODUTOR})")
    if agregadas and executado.returncode == 0:
        falhas.append("C: o gate encontrou divergência de versão e MESMO ASSIM saiu 0 — isso é anistia, não separação")
    if not agregadas and por_rota == 0 and executado.returncode not in (0, 1):
        falhas.append(f"C: exit inesperado {executado.returncode} sem divergência relatada")

    print("check-anchor-claim-publication-selftest — READ-ONLY\n")
    print(f"exit do gate: {executado.returncode}")
    print(f"linhas agregadas de versão defasada: {agregadas}")
    print(f"linhas de divergência por rota (forma antiga, tem de ser 0): {por_rota}")
    if agregadas == 0:
        print("\n(registro coerente com o manifesto nesta execução — "
              "as propriedades A/B foram verificadas na forma negativa: "
              "nenhuma linha por rota pode existir)")
    if falhas:
        print("\nREPROVADO:")
        for falha in falhas:
            print("  - " + falha)
        return 1
    print("\nOK: o ruído de versão não compete com o achado de conteúdo pela cota de exibição.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
