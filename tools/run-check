#!/usr/bin/env bash
set -euo pipefail

ROOT="$(
	unset CDPATH
	cd -- "$(dirname -- "$0")/.." && pwd
)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# Keep the compiled check scoped to this exact worktree. A shared HOME/tmp
# binary can be newer than another clone's sources and silently execute the
# wrong repository build even when ownership is correct.
CACHE_DIR="${WIKI_CHECK_BIN_CACHE:-$ROOT/.cache/check-bin}"
BIN="$CACHE_DIR/check"
LOCK_DIR="$CACHE_DIR/build.lock"
LOCK_META="$LOCK_DIR/meta"
LOCK_METADATA_TMP=""
BUILD_LOCK_OWNED=0
LOCK_WAIT_SECONDS="${WIKI_CHECK_BUILD_LOCK_WAIT_SECONDS:-300}"
LOCK_STALE_SECONDS="${WIKI_CHECK_BUILD_LOCK_STALE_SECONDS:-900}"
LOCK_META_INIT_GRACE_MS="${WIKI_CHECK_BUILD_LOCK_META_INIT_GRACE_MS:-500}"
RUN_TIMEOUT_GRACE_SECONDS="${WIKI_CHECK_RUN_TIMEOUT_GRACE_SECONDS:-5}"
if ! mkdir -p "$CACHE_DIR" 2>/dev/null; then
	echo "run-check: cannot create check cache directory: $CACHE_DIR" >&2
	exit 75
fi
cache_owner_uid="$(stat -c %u "$CACHE_DIR" 2>/dev/null || printf 'unknown')"
resolved_cache_dir="$(realpath -e -- "$CACHE_DIR" 2>/dev/null || true)"
if [[ ! "$CACHE_DIR" = /* || "$resolved_cache_dir" != "$CACHE_DIR" || ! -d "$CACHE_DIR" || -L "$CACHE_DIR" || ! -w "$CACHE_DIR" || "$cache_owner_uid" != "$(id -u)" ]]; then
	echo "run-check: check cache directory must be a writable non-symlink owned by uid=$(id -u): owner_uid=$cache_owner_uid path=$CACHE_DIR" >&2
	exit 75
fi

run_check_notice() {
	echo "run-check: $*" >&2
}

case "$LOCK_WAIT_SECONDS" in
'' | *[!0-9]*)
	echo "run-check: WIKI_CHECK_BUILD_LOCK_WAIT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
case "$LOCK_STALE_SECONDS" in
'' | *[!0-9]*)
	echo "run-check: WIKI_CHECK_BUILD_LOCK_STALE_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
case "$LOCK_META_INIT_GRACE_MS" in
'' | *[!0-9]*)
	echo "run-check: WIKI_CHECK_BUILD_LOCK_META_INIT_GRACE_MS must be numeric milliseconds" >&2
	exit 2
	;;
esac
if [[ "$LOCK_META_INIT_GRACE_MS" -gt 5000 ]]; then
	echo "run-check: WIKI_CHECK_BUILD_LOCK_META_INIT_GRACE_MS must not exceed 5000 milliseconds" >&2
	exit 2
fi
case "$RUN_TIMEOUT_GRACE_SECONDS" in
'' | *[!0-9]*)
	echo "run-check: WIKI_CHECK_RUN_TIMEOUT_GRACE_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
if [[ "$RUN_TIMEOUT_GRACE_SECONDS" -le 0 ]]; then
	echo "run-check: WIKI_CHECK_RUN_TIMEOUT_GRACE_SECONDS must be a positive integer seconds" >&2
	exit 2
fi

parse_duration_milliseconds() {
	local duration="$1"
	local total_ms=0
	local value unit rest
	if [[ -z "$duration" ]]; then
		return 1
	fi
	while [[ -n "$duration" ]]; do
		if [[ "$duration" =~ ^([0-9]+)(ms|s|m|h)(.*)$ ]]; then
			value="${BASH_REMATCH[1]}"
			unit="${BASH_REMATCH[2]}"
			rest="${BASH_REMATCH[3]}"
			case "$unit" in
			ms) total_ms=$((total_ms + value)) ;;
			s) total_ms=$((total_ms + value * 1000)) ;;
			m) total_ms=$((total_ms + value * 60 * 1000)) ;;
			h) total_ms=$((total_ms + value * 60 * 60 * 1000)) ;;
			esac
			duration="$rest"
			continue
		fi
		return 1
	done
	if [[ "$total_ms" -lt 1 ]]; then
		total_ms=1
	fi
	printf '%s' "$total_ms"
}

parse_duration_seconds() {
	local total_ms
	total_ms="$(parse_duration_milliseconds "$1")" || return 1
	local seconds=$(((total_ms + 999) / 1000))
	if [[ "$seconds" -lt 1 ]]; then
		seconds=1
	fi
	printf '%s' "$seconds"
}

timeout_ms_from_max_duration() {
	local parsed
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--max-duration)
			shift
			if [[ $# -eq 0 ]]; then
				printf '0'
				return 0
			fi
			parsed="$(parse_duration_milliseconds "$1" 2>/dev/null || true)"
			printf '%s' "${parsed:-0}"
			return 0
			;;
		--max-duration=*)
			parsed="$(parse_duration_milliseconds "${1#--max-duration=}" 2>/dev/null || true)"
			printf '%s' "${parsed:-0}"
			return 0
			;;
		esac
		shift
	done
	printf '0'
}

timeout_seconds_from_max_duration() {
	local parsed_ms
	parsed_ms="$(timeout_ms_from_max_duration "$@")"
	if [[ "$parsed_ms" =~ ^[0-9]+$ && "$parsed_ms" -gt 0 ]]; then
		printf '%s' "$(((parsed_ms + 999) / 1000))"
		return 0
	fi
	printf '0'
}

timeout_ms_from_budget_ms() {
	local value
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--budget-ms)
			shift
			if [[ $# -eq 0 ]]; then
				printf '0'
				return 0
			fi
			value="$1"
			;;
		--budget-ms=*)
			value="${1#--budget-ms=}"
			;;
		*)
			shift
			continue
			;;
		esac
		if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
			printf '%s' "$value"
			return 0
		fi
		printf '0'
		return 0
	done
	printf '0'
}

timeout_seconds_from_budget_ms() {
	local parsed_ms
	parsed_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$parsed_ms" =~ ^[0-9]+$ && "$parsed_ms" -gt 0 ]]; then
		printf '%s' "$(((parsed_ms + 999) / 1000))"
		return 0
	fi
	printf '0'
}

format_timeout_spec_from_ms() {
	local value="$1"
	local whole fractional
	if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
		whole=$((value / 1000))
		fractional=$((value % 1000))
		if [[ "$fractional" -eq 0 ]]; then
			printf '%ss' "$whole"
		else
			printf '%s.%03ds' "$whole" "$fractional"
		fi
		return 0
	fi
	return 1
}

timeout_spec_from_budget_ms() {
	local value
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--budget-ms)
			shift
			if [[ $# -eq 0 ]]; then
				return 1
			fi
			value="$1"
			;;
		--budget-ms=*)
			value="${1#--budget-ms=}"
			;;
		*)
			shift
			continue
			;;
		esac
		if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
			format_timeout_spec_from_ms "$value"
			return 0
		fi
		return 1
	done
	return 1
}

min_positive_timeout_seconds() {
	local left="$1"
	local right="$2"
	if [[ "$left" =~ ^[0-9]+$ && "$left" -gt 0 && "$right" =~ ^[0-9]+$ && "$right" -gt 0 ]]; then
		if [[ "$left" -lt "$right" ]]; then
			printf '%s' "$left"
		else
			printf '%s' "$right"
		fi
		return 0
	fi
	if [[ "$left" =~ ^[0-9]+$ && "$left" -gt 0 ]]; then
		printf '%s' "$left"
		return 0
	fi
	if [[ "$right" =~ ^[0-9]+$ && "$right" -gt 0 ]]; then
		printf '%s' "$right"
		return 0
	fi
	printf '0'
}

derive_run_timeout_seconds() {
	if [[ -n "${WIKI_CHECK_RUN_TIMEOUT_SECONDS:-}" ]]; then
		printf '%s' "$WIKI_CHECK_RUN_TIMEOUT_SECONDS"
		return 0
	fi
	local max_duration_seconds budget_seconds selected_seconds
	max_duration_seconds="$(timeout_seconds_from_max_duration "$@")"
	budget_seconds="$(timeout_seconds_from_budget_ms "$@")"
	selected_seconds="$(min_positive_timeout_seconds "$max_duration_seconds" "$budget_seconds")"
	if [[ "$selected_seconds" =~ ^[0-9]+$ && "$selected_seconds" -gt 0 ]]; then
		printf '%s' "$((selected_seconds + RUN_TIMEOUT_GRACE_SECONDS))"
		return 0
	fi
	printf '900'
}

derive_run_timeout_spec() {
	if [[ -n "${WIKI_CHECK_RUN_TIMEOUT_SECONDS:-}" ]]; then
		printf '%ss' "$WIKI_CHECK_RUN_TIMEOUT_SECONDS"
		return 0
	fi
	local max_duration_ms budget_ms max_with_grace_ms selected_ms
	max_duration_ms="$(timeout_ms_from_max_duration "$@")"
	budget_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$max_duration_ms" =~ ^[0-9]+$ && "$max_duration_ms" -gt 0 ]]; then
		max_with_grace_ms=$((max_duration_ms + RUN_TIMEOUT_GRACE_SECONDS * 1000))
	else
		max_with_grace_ms=0
	fi
	if [[ "$budget_ms" =~ ^[0-9]+$ && "$budget_ms" -gt 0 && "$max_with_grace_ms" -gt 0 ]]; then
		if [[ "$budget_ms" -lt "$max_with_grace_ms" ]]; then
			selected_ms="$budget_ms"
		else
			selected_ms="$max_with_grace_ms"
		fi
		format_timeout_spec_from_ms "$selected_ms"
		return 0
	fi
	if [[ "$budget_ms" =~ ^[0-9]+$ && "$budget_ms" -gt 0 ]]; then
		format_timeout_spec_from_ms "$budget_ms"
		return 0
	fi
	if [[ "$max_with_grace_ms" -gt 0 ]]; then
		format_timeout_spec_from_ms "$max_with_grace_ms"
		return 0
	fi
	printf '%ss' "$(derive_run_timeout_seconds "$@")"
}

strip_runner_budget_args() {
	local args=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--budget-ms)
			shift
			if [[ $# -gt 0 ]]; then
				shift
			fi
			;;
		--budget-ms=*)
			shift
			;;
		*)
			args+=("$1")
			shift
			;;
		esac
	done
	printf '%s\0' "${args[@]}"
}

RUN_TIMEOUT_SECONDS="$(derive_run_timeout_seconds "$@")"
RUN_TIMEOUT_SPEC="$(derive_run_timeout_spec "$@")"
CHECK_ARGS=()
while IFS= read -r -d '' arg; do
	CHECK_ARGS+=("$arg")
done < <(strip_runner_budget_args "$@")
case "$RUN_TIMEOUT_SECONDS" in
'' | *[!0-9]*)
	echo "run-check: WIKI_CHECK_RUN_TIMEOUT_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
if [[ "$RUN_TIMEOUT_SECONDS" -le 0 ]]; then
	echo "run-check: WIKI_CHECK_RUN_TIMEOUT_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if [[ -z "$RUN_TIMEOUT_SPEC" ]]; then
	echo "run-check: timeout specification must not be empty" >&2
	exit 2
fi

inline_token() {
	tr '\n' ' ' <<<"$1" | sed 's/[[:space:]][[:space:]]*/_/g'
}

run_command_with_timeout() {
	if ! command -v timeout >/dev/null 2>&1; then
		echo "run-check: timeout command is required for supervised P0 check execution" >&2
		exit 75
	fi
	if [[ "${WIKI_RUN_CHECK_UNDER_TIMEOUT:-}" != "1" ]]; then
		exec timeout "$RUN_TIMEOUT_SPEC" env WIKI_RUN_CHECK_UNDER_TIMEOUT=1 "$0" "$@"
	fi
}

run_command_with_timeout "$@"

# Medicao de fallback quando `go list -deps` nao responde: qualquer fonte .go de
# producao DO PROPRIO REPOSITORIO mais nova que o binario em cache. O conjunto
# varrido aqui CONTEM as dependencias internas do pacote, entao "nenhuma fonte
# mais nova" e prova suficiente de que o binario esta atual -- nunca se preserva
# binario velho por esta porta. Poda .git, .toolchains (toolchain baixada),
# var (runtime do nginx, modo 0700), .cache e .agents (artefato e ledger, que
# nao entram em build nenhum). Custo medido em 2026-08-29 com a maquina em
# load 25: 2,07 s.
repo_go_source_newer_than_bin() {
	local bin="$1"
	local found
	found="$(find "$ROOT" \
		-name .git -prune -o \
		-path "$ROOT/.toolchains" -prune -o \
		-path "$ROOT/var" -prune -o \
		-path "$ROOT/.cache" -prune -o \
		-path "$ROOT/.agents" -prune -o \
		-type f -name '*.go' ! -name '*_test.go' -newer "$bin" -print -quit 2>/dev/null)"
	[[ -n "$found" ]]
}

dependency_source_newer_than_bin() {
	local pkg="$1"
	local bin="$2"
	local deps dir
	if ! deps="$(cd "$ROOT" && timeout "${WIKI_CHECK_DEPENDENCY_LIST_TIMEOUT_SECONDS:-15}" go-modern list -deps -f '{{.Dir}}' "$pkg" 2>/dev/null)"; then
		# "Nao consegui medir" NAO e "mudou". Este `return 0` incondicional
		# reconstruia o binario de 247 MB a cada invocacao de gate sempre que a
		# maquina estivesse carregada o bastante para o `go list` estourar 15 s
		# -- medido em 2026-08-29 durante a remedicao do BUG-109: a varredura
		# da bateria virou uma fila de builds completos e o primeiro gate saiu
		# como falso EXIT=124. Antes de reconstruir, mede-se de outra forma.
		if repo_go_source_newer_than_bin "$bin"; then
			run_check_notice "dependency list timed out or failed for pkg=$pkg; repository Go source newer than cached binary; rebuilding"
			return 0
		fi
		run_check_notice "dependency list timed out or failed for pkg=$pkg; no repository Go source newer than cached binary; keeping it"
		return 1
	fi
	while IFS= read -r dir; do
		[[ -n "$dir" ]] || continue
		case "$dir" in
		"$ROOT/.toolchains" | "$ROOT/.toolchains"/*) continue ;;
		"$ROOT" | "$ROOT"/*) ;;
		*) continue ;;
		esac
		if find "$dir" -maxdepth 1 -type f -name '*.go' ! -name '*_test.go' -newer "$bin" -print -quit 2>/dev/null | grep -q .; then
			return 0
		fi
	done <<<"$deps"
	return 1
}

needs_build=0
if [[ ! -x "$BIN" ]]; then
	needs_build=1
elif [[ "$ROOT/go.mod" -nt "$BIN" || "$ROOT/go.sum" -nt "$BIN" ]]; then
	needs_build=1
elif dependency_source_newer_than_bin ./cmd/check "$BIN"; then
	needs_build=1
fi

lock_dir_mtime_epoch() {
	stat -c %Y "$LOCK_DIR" 2>/dev/null || printf '0'
}

process_exists() {
	local pid="$1"
	case "$pid" in
	'' | *[!0-9]*) return 1 ;;
	esac
	[[ "$pid" -gt 0 ]] || return 1
	ps -p "$pid" >/dev/null 2>&1
}

build_lock_scope() {
	printf 'build:./cmd/check'
}

build_lock_wait_budget_ms() {
	case "$LOCK_WAIT_SECONDS" in
	'' | *[!0-9]*) printf 'missing' ;;
	*) printf '%s' "$((LOCK_WAIT_SECONDS * 1000))" ;;
	esac
}

lock_meta_first() {
	local lock_meta_key="$1"
	sed -n "s/^${lock_meta_key}://p" "$LOCK_META" 2>/dev/null | sed -n '1p'
}

build_lock_holder_active_analysis() {
	local waiter_budget_ms holder_pid holder_started holder_command holder_timeout_seconds holder_budget_ms holder_stop_condition
	local owner_budget_ms now_epoch elapsed_ms cpu_percent
	waiter_budget_ms="$(build_lock_wait_budget_ms)"
	if [[ ! -f "$LOCK_META" ]]; then
		echo "run-check: analise_comando_ativo pid=unknown command=unknown artifact=$(inline_token "$BIN") lock_scope=$(inline_token "$(build_lock_scope)") elapsed_ms=0 cpu_percent=unknown throughput=absent owner_budget_ms=missing waiter_budget_ms=$waiter_budget_ms stop_condition=lock_wait_timeout_or_build_lock_released hypothesis=lock_metadata_missing next_action=reorient_to_independent_p0_or_wait_only_if_critical_dependency" >&2
		return 0
	fi
	holder_pid="$(lock_meta_first pid)"
	holder_started="$(lock_meta_first started_epoch)"
	holder_command="$(lock_meta_first command)"
	holder_timeout_seconds="$(lock_meta_first timeout_seconds)"
	holder_budget_ms="$(lock_meta_first budget_ms)"
	holder_stop_condition="$(lock_meta_first stop_condition)"
	case "$holder_pid" in
	'' | *[!0-9]*) holder_pid=unknown ;;
	esac
	case "$holder_started" in
	'' | *[!0-9]*) holder_started=0 ;;
	esac
	if [[ -z "$holder_command" ]]; then
		holder_command=unknown
	fi
	if [[ -z "$holder_timeout_seconds" ]]; then
		holder_timeout_seconds=missing
	fi
	case "$holder_budget_ms" in
	'' | *[!0-9]*) owner_budget_ms=missing ;;
	*) owner_budget_ms="$holder_budget_ms" ;;
	esac
	if [[ -z "$holder_stop_condition" ]]; then
		holder_stop_condition=missing
	fi
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	elapsed_ms=0
	if [[ "$holder_started" -gt 0 && "$now_epoch" -gt 0 && "$now_epoch" -ge "$holder_started" ]]; then
		elapsed_ms=$(((now_epoch - holder_started) * 1000))
	fi
	cpu_percent=unknown
	if [[ "$holder_pid" != "unknown" ]] && command -v ps >/dev/null 2>&1; then
		cpu_percent="$(ps -p "$holder_pid" -o pcpu= 2>/dev/null | awk 'NF {print $1; exit}')"
		if [[ -z "$cpu_percent" ]]; then
			cpu_percent=unknown
		fi
	fi
	echo "run-check: analise_comando_ativo pid=$holder_pid command=$(inline_token "$holder_command") artifact=$(inline_token "$BIN") lock_scope=$(inline_token "$(build_lock_scope)") elapsed_ms=$elapsed_ms cpu_percent=$cpu_percent throughput=absent owner_budget_ms=$owner_budget_ms owner_timeout_seconds=$(inline_token "$holder_timeout_seconds") waiter_budget_ms=$waiter_budget_ms stop_condition=$(inline_token "$holder_stop_condition") hypothesis=active_build_command_or_stale_lock next_action=reorient_to_independent_p0_or_wait_only_if_critical_dependency" >&2
}

validate_build_lock_wait_classification_or_exit() {
	local classification missing observed_owner_pid
	classification="${WIKI_CHECK_BUILD_LOCK_WAIT_CLASSIFICATION:-}"
	case "$classification" in
	non_critical_wait)
		echo "run-check: non_critical_wait forbids passive build lock sleep; reorient to independent P0 front lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-check ${CHECK_ARGS[*]}")" >&2
		exit 75
		;;
	critical_dependency)
		missing=""
		case "${WIKI_CHECK_BUILD_LOCK_DEPENDENCY_ID:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} dependency_id" ;; esac
		case "${WIKI_CHECK_BUILD_LOCK_OWNER_PID:-}" in '' | *[!0-9]*) missing="${missing} owner_pid" ;; esac
		observed_owner_pid="$(lock_meta_first pid)"
		if [[ "${WIKI_CHECK_BUILD_LOCK_OWNER_PID:-}" =~ ^[0-9]+$ && "$observed_owner_pid" != "$WIKI_CHECK_BUILD_LOCK_OWNER_PID" ]]; then
			missing="${missing} owner_pid_mismatch(observed=${observed_owner_pid:-missing})"
		fi
		case "${WIKI_CHECK_BUILD_LOCK_WAIT_TIMEOUT_MS:-}" in '' | *[!0-9]* | 0) missing="${missing} timeout_ms" ;; esac
		case "${WIKI_CHECK_BUILD_LOCK_LAST_EVIDENCE:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} ultima_evidencia" ;; esac
		case "${WIKI_CHECK_BUILD_LOCK_REORIENTATION_COMMAND:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} comando_reorientacao" ;; esac
		if [[ -n "$missing" ]]; then
			echo "run-check: critical_dependency build lock wait missing structured fields:$missing lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-check ${CHECK_ARGS[*]}")" >&2
			exit 75
		fi
		;;
	*)
		echo "run-check: active build lock requires WIKI_CHECK_BUILD_LOCK_WAIT_CLASSIFICATION=critical_dependency with dependency_id/owner_pid/timeout_ms/ultima_evidencia/comando_reorientacao or non_critical_wait reorientation; refusing passive sleep lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-check ${CHECK_ARGS[*]}")" >&2
		exit 75
		;;
	esac
}

critical_build_lock_wait_timeout_ms() {
	if [[ "${WIKI_CHECK_BUILD_LOCK_WAIT_CLASSIFICATION:-}" == "critical_dependency" ]]; then
		case "${WIKI_CHECK_BUILD_LOCK_WAIT_TIMEOUT_MS:-}" in
		'' | *[!0-9]*) printf '0' ;;
		*) printf '%s' "$WIKI_CHECK_BUILD_LOCK_WAIT_TIMEOUT_MS" ;;
		esac
		return 0
	fi
	printf '0'
}

reclaim_missing_meta_lock() {
	[[ -d "$LOCK_DIR" && ! -f "$LOCK_META" ]] || return 1
	local now_epoch mtime_epoch age
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	mtime_epoch="$(lock_dir_mtime_epoch)"
	[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
	age=$((now_epoch - mtime_epoch))
	[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
	rmdir "$LOCK_DIR" 2>/dev/null || return 1
	echo "run-check: reclaimed stale build lock with missing metadata age=${age}s" >&2
	return 0
}

# mkdir(2) is the atomic ownership step, but the owner can only publish its
# diagnostic metadata immediately afterwards.  Give that initialization
# handshake a small, explicit budget before classifying the lock as malformed.
# This is not permission to wait for the build itself: once meta exists, the
# normal critical/non-critical dependency policy applies without delay.
await_build_lock_metadata_initialization() {
	[[ -d "$LOCK_DIR" && ! -f "$LOCK_META" ]] || return 0
	local waited_ms=0
	while [[ -d "$LOCK_DIR" && ! -f "$LOCK_META" && "$waited_ms" -lt "$LOCK_META_INIT_GRACE_MS" ]]; do
		sleep 0.01
		waited_ms=$((waited_ms + 10))
	done
}

reclaim_stale_build_lock() {
	[[ -d "$LOCK_DIR" ]] || return 1
	if [[ ! -f "$LOCK_META" ]]; then
		reclaim_missing_meta_lock
		return $?
	fi
	local meta_pid now_epoch mtime_epoch age
	meta_pid="$(sed -n 's/^pid://p' "$LOCK_META" 2>/dev/null | sed -n '1p')"
	case "$meta_pid" in
	'' | *[!0-9]*)
		# A partially published or malformed metadata file is not proof that the
		# owner is dead. Reclaim only after the explicit stale budget; otherwise a
		# reader could remove an older wrapper's in-progress lock.
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		mtime_epoch="$(lock_dir_mtime_epoch)"
		[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
		age=$((now_epoch - mtime_epoch))
		[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
		rm -f -- "$LOCK_META" 2>/dev/null || return 1
		rmdir "$LOCK_DIR" 2>/dev/null || return 1
		echo "run-check: reclaimed stale build lock with malformed metadata age=${age}s" >&2
		return 0
		;;
	esac
	if process_exists "$meta_pid"; then
		return 1
	fi
	rm -f "$LOCK_META" 2>/dev/null || return 1
	rmdir "$LOCK_DIR" 2>/dev/null || return 1
	echo "run-check: reclaimed dead build lock pid=$meta_pid" >&2
	return 0
}

build_lock_identity() {
	stat -c '%d:%i:%Y:%s' "$LOCK_META" 2>/dev/null || stat -c 'missing:%d:%i:%Y' "$LOCK_DIR" 2>/dev/null || printf 'missing'
}

write_build_lock_metadata() {
	local started_epoch="$1"
	shift || true
	LOCK_METADATA_TMP="$(mktemp "$CACHE_DIR/.build-lock-meta.XXXXXX" 2>/dev/null || true)"
	if [[ -z "$LOCK_METADATA_TMP" ]]; then
		echo "run-check: failed to allocate build lock metadata temporary" >&2
		exit 75
	fi
	if ! {
		printf 'pid:%s\n' "$$"
		printf 'started_epoch:%s\n' "$started_epoch"
		printf 'command:%s\n' "run-check $*"
		printf 'timeout_seconds:%s\n' "$RUN_TIMEOUT_SECONDS"
		printf 'budget_ms:%s\n' "${WIKI_CHECK_BUDGET_MS:-$((RUN_TIMEOUT_SECONDS * 1000))}"
		printf 'stop_condition:%s\n' "$(printf '%s' "${WIKI_CHECK_STOP_CONDITION:-command_exits_or_build_lock_timeout_or_run_timeout}" | tr '\n' ' ')"
		printf 'lock_scope:%s\n' "$(build_lock_scope)"
	} >"$LOCK_METADATA_TMP" || ! mv -f -- "$LOCK_METADATA_TMP" "$LOCK_META"; then
		echo "run-check: failed to write build lock metadata" >&2
		exit 75
	fi
	LOCK_METADATA_TMP=""
}

acquire_build_lock() {
	local lock_owner_uid
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		BUILD_LOCK_OWNED=1
		return 0
	fi
	# mkdir is a lock-contention signal only when the lock directory exists.
	# Permission errors, a colliding regular file and other filesystem failures
	# must stop immediately instead of entering the passive-wait loop.
	if [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then
		lock_owner_uid="$(stat -c %u "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		if [[ "$lock_owner_uid" == "$(id -u)" ]]; then
			return 1
		fi
		echo "run-check: build lock directory is not owned by uid=$(id -u): owner_uid=$lock_owner_uid path=$LOCK_DIR" >&2
		exit 75
	fi
	# A holder can remove the lock immediately after our mkdir observed EEXIST.
	# Retry exactly once; persistent EACCES/collision still fails immediately.
	if [[ ! -e "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] && mkdir "$LOCK_DIR" 2>/dev/null; then
		BUILD_LOCK_OWNED=1
		return 0
	fi
	if [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then
		lock_owner_uid="$(stat -c %u "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		if [[ "$lock_owner_uid" == "$(id -u)" ]]; then
			return 1
		fi
	fi
	echo "run-check: cannot acquire build lock because mkdir failed without a valid same-user lock directory: $LOCK_DIR" >&2
	exit 75
}

if [[ "$needs_build" == "1" ]]; then
	start_epoch="$(date +%s 2>/dev/null || printf '0')"
	last_wait_notice=-5
	active_lock_identity=""
	cleanup() {
		if [[ "$BUILD_LOCK_OWNED" == "1" ]]; then
			if [[ -n "$LOCK_METADATA_TMP" ]]; then
				rm -f -- "$LOCK_METADATA_TMP" 2>/dev/null || true
				LOCK_METADATA_TMP=""
			fi
			rm -f -- "$LOCK_META" 2>/dev/null || true
			rmdir "$LOCK_DIR" 2>/dev/null || true
			BUILD_LOCK_OWNED=0
		fi
	}
	trap cleanup EXIT
	while ! acquire_build_lock; do
		await_build_lock_metadata_initialization
		# The owner may have completed and removed the lock during the bounded
		# metadata handshake. Retry acquisition instead of diagnosing a path
		# that no longer exists.
		if [[ ! -d "$LOCK_DIR" ]]; then
			continue
		fi
		if reclaim_stale_build_lock; then
			continue
		fi
		current_lock_identity="$(build_lock_identity)"
		if [[ "$current_lock_identity" != "$active_lock_identity" ]]; then
			build_lock_holder_active_analysis
			validate_build_lock_wait_classification_or_exit
			active_lock_identity="$current_lock_identity"
		fi
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		if [[ "$start_epoch" -gt 0 && "$now_epoch" -gt 0 ]]; then
			elapsed=$((now_epoch - start_epoch))
			critical_timeout_ms="$(critical_build_lock_wait_timeout_ms)"
			if [[ "$critical_timeout_ms" =~ ^[0-9]+$ && "$critical_timeout_ms" -gt 0 && $((elapsed * 1000)) -ge "$critical_timeout_ms" ]]; then
				build_lock_holder_active_analysis
				echo "run-check: critical_dependency build lock wait timeout_ms=$critical_timeout_ms elapsed_ms=$((elapsed * 1000)) lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-check ${CHECK_ARGS[*]}")" >&2
				exit 75
			fi
			if [[ "$elapsed" -ge "$LOCK_WAIT_SECONDS" ]]; then
				echo "run-check: build lock blocked after ${LOCK_WAIT_SECONDS}s: $LOCK_DIR" >&2
				exit 75
			fi
			if [[ "$((elapsed - last_wait_notice))" -ge 5 ]]; then
				run_check_notice "waiting for check build lock elapsed=${elapsed}s lock=$LOCK_DIR"
				last_wait_notice="$elapsed"
			fi
		fi
		sleep 0.1
	done
	write_build_lock_metadata "$start_epoch" "${CHECK_ARGS[@]}"
	if [[ ! -x "$BIN" || "$ROOT/go.mod" -nt "$BIN" || "$ROOT/go.sum" -nt "$BIN" ]] || dependency_source_newer_than_bin ./cmd/check "$BIN"; then
		tmp="$CACHE_DIR/check.$$"
		run_check_notice "building cached check binary bin=$BIN"
		go-modern build -o "$tmp" ./cmd/check
		mv "$tmp" "$BIN"
		run_check_notice "built cached check binary bin=$BIN"
	fi
	trap - EXIT
	cleanup
fi

cd "$ROOT"
timings_requested=0
for arg in "${CHECK_ARGS[@]}"; do
	if [[ "$arg" == "--timings" ]]; then
		timings_requested=1
		break
	fi
done
if [[ "$timings_requested" == "1" ]]; then
	run_check_notice "executing cached check binary timeout=$RUN_TIMEOUT_SPEC args=${CHECK_ARGS[*]}"
fi
"$BIN" "${CHECK_ARGS[@]}"
