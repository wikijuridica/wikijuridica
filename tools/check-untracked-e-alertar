#!/usr/bin/env bash
# Roda o inventario de untracked e ALERTA quando ha produto esquecido.
#
# POR QUE ISTO EXISTE (ordem do dono, 2026-08-27)
# ===============================================
# "sempre tem untracked e sempre investigar, pois pode ser algo valioso. E nao
# deixar os untrackeds cegos para os nossos agentes e claude code."
#
# O gate check-untracked-product-inventory JA EXISTIA e JA REPROVAVA — com idade
# em segundos e classificacao por tipo. So que nenhum hook, timer ou onda o
# invocava. Gate que existe e nao roda e igual a gate que nao existe.
#
# No dia da ordem havia cinco untracked, QUATRO deles produto: 20 prefixos IPv6
# de crawler do Google num arquivo chamado uta.json, 231 linhas de pesquisa
# diaria e a unica copia da config do nginx anterior a uma mudanca de producao.
# Um deles com 25 horas. Um agente de IA que le `git status` e ve uma pilha de
# `??` trata como ruido de fundo — e foi exatamente o que aconteceu.
#
# Este wrapper fecha a cegueira: roda o inventario e, se houver produto parado,
# abre alerta pelo canal do dono em vez de escrever num log que ninguem le.
set -uo pipefail
cd /opt/wiki || exit 2

# ---- PROTECAO CRASH->2 (2026-09-16). A unit que chama este script mascara
# exit 1 (`SuccessExitStatus=0 1`), porque 1 aqui e VEREDITO MEDIDO. Sem esta
# protecao, um script que MORRE com 1 — violacao de `set -u`, comando ausente —
# entrega o numero de quem mediu, a mascara o converte em `Result=success` e o
# OnFailure nunca dispara.
#
# `medidor_protege_exit` (e nao a trap ERR) porque este script NAO usa `set -e`:
# medido em 2026-09-16, a trap ERR nao dispara na violacao de `set -u`, e a trap
# EXIT dispara. Acrescentar `set -e` aqui mudaria a semantica de falha de todo
# comando do script, que e regressao proibida.
#
# Todo ponto de saida DELIBERADO com codigo 1 passa a chamar `medidor_sai 1`: e
# assim que a trap distingue "o autor decidiu sair com 1" de "o shell morreu".
. "$(dirname "${BASH_SOURCE[0]}")/lib/saida_de_medidor.sh"
medidor_protege_exit

saida="$(./tools/check-untracked-product-inventory 2>&1)"
codigo=$?

echo "$saida"

if [ "$codigo" -ne 0 ]; then
	resumo="$(echo "$saida" | grep -E '^PRODUTO_STALE|^PRODUTO' | head -5 | tr '\n' ' ')"
	contagem="$(echo "$saida" | grep -oE 'untracked_produto=[0-9]+' | head -1)"
	# A severidade e "media" e NAO um valor inventado: as validas sao
	# alta/baixa/critica/info/media (notify-owner:213). A primeira versao deste
	# wrapper passou "aviso", que nao existe, E engoliu o erro com
	# `>/dev/null 2>&1 || true` — o gate detectava e o alerta nunca saia, em
	# silencio. E o mesmo defeito que este repositorio passou o dia 27/08
	# corrigindo em outros lugares: mascarar a falha do proprio aviso.
	if ! ./tools/notify-owner \
		--chave untracked-produto-esquecido \
		--severidade media \
		--titulo "Produto untracked parado no repo" \
		--mensagem "O inventario reprovou: ${contagem:-produto untracked} alem de 24h. ${resumo:-}. Investigar cada um: pode ser dado valioso invisivel para os agentes. Commitar por pathspec ou classificar como efemero no .gitignore — nunca deletar."; then
		echo "ATENCAO: o inventario reprovou E o alerta ao dono FALHOU." >&2
	fi
elif [ "$codigo" -eq 0 ]; then
	# O VERDE RESOLVE. Sem este ramo o alerta fica aberto depois de o produto
	# untracked ser commitado ou classificado -- exatamente o defeito de classe
	# medido em 2026-09-16 em dois outros gates, um com 263 h de alerta aberto
	# sobre uma causa que ja tinha sumido.
	#
	# `codigo` 2 nao entra aqui de proposito: 2 e "nao medi", e nao medir nao
	# abre nem fecha veredito.
	if ! ./tools/notify-owner \
		--chave untracked-produto-esquecido \
		--resolvido \
		--titulo "Nenhum produto untracked parado" \
		--mensagem "O inventario voltou a passar: nada untracked alem de 24h."; then
		echo "ATENCAO: o inventario passou E o fechamento do alerta FALHOU." >&2
	fi
fi

medidor_sai "$codigo"
