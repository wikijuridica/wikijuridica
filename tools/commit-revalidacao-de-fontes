#!/usr/bin/env bash
# Commita a revalidacao diaria da evidencia de fonte oficial.
#
# POR QUE ISTO EXISTE (2026-08-27)
# ================================
# O timer wikijuridica-source-evidence-recheck reescreve TODO DIA um arquivo
# TRACKED (data/source-registry/official_source_url_live_evidence.jsonl). Sem
# alguem commitando, ele vira um "M" perpetuo no git status — e "M" perpetuo
# tem dois destinos, os dois ruins: ou outra sessao o engole dentro de um commit
# alheio, misturando frentes, ou algum agente o trata como ruido de fundo e
# ignora, que e o mesmo defeito de cegueira dos untracked.
#
# Commit de dado e LEVE neste repo (nao dispara build), entao committar todo dia
# custa quase nada e mantem o historico da vida das fontes auditavel: da para
# ver quando uma fonte oficial mudou de status e ha quanto tempo.
#
# ★ SAO DOIS ARQUIVOS DESDE 2026-09-05, E O PRIMEIRO E O QUE IMPORTA
# ==================================================================
# O recheck deixou de reescrever o arquivo DERIVADO a mao e passou a gravar na
# FONTE (official_source_url_live_metadata_attempts.jsonl), pelo gerador Go, e
# so depois regenerar o derivado. Commitar so o derivado, como este wrapper
# fazia, deixaria a fonte -- a camada que decide -- como "M" perpetuo: o mesmo
# defeito de cegueira que este arquivo existe para impedir, agora um nivel
# abaixo. A ordem dos alvos e proposital: fonte antes de derivado, igual a ordem
# em que eles sao escritos.
set -uo pipefail
# A raiz vem do lugar onde ESTE arquivo esta, nao de um caminho absoluto: o
# script mora em <raiz>/tools/, entao a producao continua em /opt/wiki e o
# comportamento de retry/exit passa a ser exercivel por teste numa copia. Sem
# isso, a unica forma de provar as duas correcoes de 2026-09-10 seria disputar
# o indice do repositorio real com as outras sessoes.
RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$RAIZ" || exit 2

ALVOS=(
	"data/source-registry/official_source_url_live_metadata_attempts.jsonl"
	"data/source-registry/official_source_url_live_evidence.jsonl"
)

if git diff --quiet -- "${ALVOS[@]}" 2>/dev/null; then
	echo "sem mudanca na evidencia de vida das fontes — nada a commitar"
	exit 0
fi

resumo="$(git diff --numstat -- "${ALVOS[@]}" | awk '{a+=$1; r+=$2} END {print "+"a" -"r}')"
mensagem="$(mktemp)"
cat >"$mensagem" <<MSG
chore(fontes): revalidacao diaria da evidencia de vida ($resumo)

Gravado por wikijuridica-source-evidence-recheck.timer, que sonda metadado
(HEAD, com GET de um byte quando o WAF recusa o metodo) e grava pela ferramenta
de tentativas: a FONTE
(official_source_url_live_metadata_attempts.jsonl) primeiro, o derivado
(official_source_url_live_evidence.jsonl) reconstruido dela em seguida.

Sonda so escreve campo de medicao; politica e aprovacao (blocks_publication,
approval, record_status) pertencem aos gates e sao regravadas pelo gerador Go a
partir do inventario, nunca por edicao de campo.
MSG
# SEM trailer de co-autoria de modelo desde 2026-09-23. O CLAUDE.md fixa que
# "nenhum commit leva co-autoria de modelo", e .githooks/commit-msg passou a
# REPROVAR a linha `Co-Authored-By: Claude ...`. Ate hoje esta mensagem a
# trazia: com o hook, o ExecStartPost do timer das 05:46 cairia no ramo
# "reprovou (exit 1) — nao e disputa de index.lock" abaixo, e a unit iria a
# `failed`, com OnFailure para o dono.

# O RETRY DE 10 s ERA CURTO DEMAIS, E O `if` MENTIA. Corrigido em 2026-09-10,
# depois de a unit ficar `failed` com "5 tentativas" no journal de 05:52.
#
# Dois defeitos, e o segundo e pior que o primeiro:
#
#  1. ORCAMENTO. O comentario anterior dizia "commit de dado dura ~1s" e dava
#     5 tentativas de 2 s = 10 s. O indice do git e COMPARTILHADO entre as
#     sessoes, e quem o segura nao e o commit de dado: e o pre-commit de quem
#     commita Go, que compila o INDICE (medido no proprio contrato: 14,9 s com
#     indice limpo, 77,6 s com indice sujo) e roda no mesmo lock. Dez segundos
#     nao atravessam nem uma compilacao limpa. O orcamento passa a ser de 10
#     min, com espera crescente (2, 4, 8, 16, 30, 30... s) — bem dentro do
#     TimeoutStartSec=30min da unit, e sem transformar commit leve de dado em
#     commit serializado, que e o que o CLAUDE.md secao 1 pede para NAO fazer.
#
#  2. A CAUSA ERA AFIRMADA SEM SER CONFERIDA. Qualquer falha virava
#     "provavelmente index.lock de outra sessao" e era repetida cinco vezes,
#     com a saida do git jogada fora. Pre-commit reprovando, marcador de
#     conflito ou hook quebrado nao se consertam repetindo: o operador so via
#     "5 tentativas" no journal e nunca a mensagem do git. Agora a saida e
#     capturada, a distincao e feita lendo "index.lock" nela, e falha que NAO e
#     disputa de indice sai na hora, com o texto do git no journal.
#
#     (Uma coisa que eu ia escrever aqui e que a mutacao derrubou: o `if
#     git add ... && git commit ... | tail -2` NAO descartava o exit do git.
#     `set -uo pipefail` esta na linha 26, entao o pipeline propaga a falha.
#     Provado por mutacao: reintroduzir o `| tail -2` mantem o teste verde.
#     Fica registrado para ninguem "consertar" de novo o que nao esta quebrado.)
#
# Nunca apagar lock alheio — outra sessao pode estar commitando agora.
espera=2
gasto=0
ORCAMENTO_S=600
tentativa=0
while :; do
	tentativa=$((tentativa + 1))
	saida_add="$(git add -- "${ALVOS[@]}" 2>&1)"
	rc_add=$?
	if [ $rc_add -eq 0 ]; then
		saida_commit="$(git commit -F "$mensagem" -- "${ALVOS[@]}" 2>&1)"
		rc_commit=$?
		if [ $rc_commit -eq 0 ]; then
			printf '%s\n' "$saida_commit" | tail -2
			rm -f "$mensagem"
			exit 0
		fi
		# Falha do COMMIT que nao e index.lock e defeito real (pre-commit
		# reprovou, marcador de conflito, hook): repetir nao conserta e
		# esconder e pior. Sai com a saida do git no journal.
		if ! printf '%s' "$saida_commit" | grep -q "index.lock"; then
			printf '%s\n' "$saida_commit" >&2
			rm -f "$mensagem"
			echo "ATENCAO: git commit reprovou (exit $rc_commit) — nao e disputa de index.lock." >&2
			exit 1
		fi
		saida_add="$saida_commit"
	fi
	if [ $gasto -ge $ORCAMENTO_S ]; then
		printf '%s\n' "$saida_add" >&2
		rm -f "$mensagem"
		echo "ATENCAO: nao consegui commitar a evidencia de vida das fontes em ${ORCAMENTO_S}s ($tentativa tentativas); o indice do git ficou ocupado o tempo todo." >&2
		exit 1
	fi
	echo "tentativa $tentativa falhou (indice ocupado por outra sessao); nova tentativa em ${espera}s (gasto ${gasto}s de ${ORCAMENTO_S}s)" >&2
	sleep "$espera"
	gasto=$((gasto + espera))
	espera=$((espera * 2))
	[ $espera -gt 30 ] && espera=30
done
