#!/usr/bin/env bash
# tools/go-build-check — caminho RAPIDO de "tudo compila?" sem linkar os
# ~257 binarios cmd/ main.
#
# PORQUE: `go build ./...` religa 257 executaveis cmd/ (254 sao dev-mains
# thin: toda a logica ja vive em internal/). So a fase de LINK custa ~128s;
# tocar 1 pacote-base compartilhado religa quase todos. Medido: `go build
# ./...` = ~5:16 wall / ~792s user-CPU / ~1.5GB RSS.
#
# ESTE SCRIPT: `go vet ./internal/... ./cmd/...` COMPILA e TYPE-CHECA os pacotes
# (inclusive os mains — vet carrega e type-checa cada main package), MAS NAO
# LINKA nenhum executavel. Depois LINKA apenas os 3 binarios de runtime que
# de fato embarcam (server, build, factory) para provar que ligam. Resultado:
# o mesmo "tudo compila + o runtime linka" numa fracao do custo do full build.
#
# NAO substitui `go build ./...` nem o pre-commit; e um caminho ADITIVO de
# verificacao rapida. Nao altera o comportamento/saida de nenhuma ferramenta.
#
# THROTTLE: aplica `nice` e capa GOMAXPROCS por conta propria (seguro
# standalone). Sob carga concorrente pesada, invoque envelopado para
# serializar com o lock compartilhado:
#   ./tools/run-heavy-throttled ./tools/go-build-check
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GO="$ROOT/tools/go-modern"
if [ ! -x "$GO" ]; then
	echo "go-build-check: tools/go-modern ausente ou nao executavel: $GO" >&2
	exit 127
fi

# GOMAXPROCS: respeita o valor exportado pelo run-heavy-throttled; caso
# contrario, capa em 4 (default) para nao saturar os 8 cores compartilhados.
if [ -z "${GOMAXPROCS:-}" ]; then
	export GOMAXPROCS="${WIKI_BUILD_CHECK_GOMAXPROCS:-4}"
fi
NICE_LEVEL="${WIKI_BUILD_CHECK_NICE:-18}"

# Os unicos binarios que embarcam em runtime/publicacao. Linkar so estes prova
# que a cadeia de release liga, sem religar os 254 dev-mains.
RUNTIME_CMDS="./cmd/server ./cmd/build ./cmd/factory"

echo "go-build-check: vet (type-check de TODOS os pacotes, sem linkar mains) GOMAXPROCS=${GOMAXPROCS} nice=${NICE_LEVEL}"
# ESCOPO (corrigido em 2026-08-29, BUG-057 da caca): o padrao ./... NAO
# EXPANDE neste repositorio. var/nginx/{body,fastcgi,proxy,scgi,uwsgi} pertence a
# `nobody` com modo 0700, o caminhador do go aborta o padrao INTEIRO com
# "open var/nginx/body: permission denied", e ZERO pacote e verificado. Este
# script — o unico do repo que roda `go vet` — passou a existencia inteira sem
# type-checar um pacote sequer. Nao encolhe escopo: as pastas com fonte Go do
# modulo vivem todas em internal/ e cmd/ (medido: 481 pacotes sem tag, 760 com
# -tags devcmds).
#
# CACHE-BUSTER (BUG-107): `go vet` reusa o resultado por pacote a partir do
# GOCACHE compartilhado, e o cache de vet deste repo devolve VERDE para pacote
# que tem diagnostico. Medido em 2026-08-29, mesmos arquivos, tres repeticoes:
#   vet ./internal/termpromotion/                    -> exit 0, saida vazia
#   vet -tags <nonce> ./internal/termpromotion/      -> exit 1, 2 diagnosticos
# A tag descartavel nao muda a selecao de arquivos (nenhum arquivo do repo a
# declara) — muda so a chave de cache, forcando o recomputo. Sem isso, verde
# aqui nao prova nada, que e a R2 do contrato de dado real aplicada ao
# detector do proprio Go.
# ATUALIZACAO 2026-08-29 (DEC-039): o padrao ./... passou a EXPANDIR — o go.mod
# raiz ganhou a diretiva `ignore ./var`, que tira a subarvore do runtime do nginx
# do alcance dos padroes. O escopo explicito abaixo CONTINUA certo, por outro
# motivo: ./... virou comando full-tree pesado (488 pacotes), proibido pelo
# AGENTS.md e guardado pelo hook block-heavy-go.sh. O texto acima descreve o
# estado ate aquela data e fica como registro do que a armadilha custou.
VET_NONCE="vetfrio$(date -u +%Y%m%d%H%M%S)"
echo "go-build-check: escopo=./internal/... ./cmd/... cache-buster=-tags ${VET_NONCE}"
nice -n "$NICE_LEVEL" "$GO" vet -tags "devcmds,${VET_NONCE}" ./internal/... ./cmd/...

echo "go-build-check: link apenas dos binarios de runtime (${RUNTIME_CMDS})"
for cmd in $RUNTIME_CMDS; do
	nice -n "$NICE_LEVEL" "$GO" build -o /dev/null "$cmd"
done

echo "go-build-check: OK — todos os pacotes type-checam e os binarios de runtime linkam"
