#!/usr/bin/env python3
"""Desfaz a ambiguidade de endereço que a página /bot/ criou ao citar o próprio User-Agent.

O DEFEITO, MEDIDO POR TestRenderNaoProduzEnderecoAmbiguo (2026-09-05)
---------------------------------------------------------------------
A página /bot/, criada horas antes por tools/generate-pagina-bot-20260905, exibe
o identificador do agente em prosa:

    Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/)

O endereço do portal termina colado no parêntese que fecha o User-Agent. Essa é
exatamente a terceira forma que internal/pagemarkdown/enderecos.go cataloga como
ambígua — "URL nua encostada em '.' ',' ';' ':' ou ')' antes de espaço/fim de
linha" — e a régua dele não é teórica: veio de 404 medidos no log de acesso, com
9.418 requisições numa das formas irmãs. Um extrator até-o-próximo-espaço levaria
`https://wikijuridica.com.br/bot/)` e receberia 404.

A ironia é o ponto: a página existe para ser a documentação que um agente
automatizado consulta, e citava o próprio endereço de um jeito que faria esse
agente errar o caminho de volta.

POR QUE NÃO SE CORRIGE NO GATE, NEM COM CRASE, NEM COM AUTOLINK
----------------------------------------------------------------
Crase não serve: a primeira forma catalogada é justamente "URL seguida
imediatamente de crase", a que fecha um span de código. O autolink <url> está
isento por medição (zero 404 em 22 dias), mas envolver a URL em <> mudaria o
texto do User-Agent exibido, e uma página cuja função é dizer o identificador
EXATO não pode exibi-lo alterado — o operador copia dali para o robots.txt e para
a regra de bloqueio dele.

A correção é de REDAÇÃO: o identificador aparece com um marcador no lugar do
endereço, e o endereço aparece em seguida, terminado por espaço. O leitor humano
e o agente continuam obtendo as duas informações exatas, sem que uma encoste na
outra.

    tools/repair-pagina-bot-endereco-20260905 --seco
    tools/repair-pagina-bot-endereco-20260905
"""

import argparse
import datetime
import json
import os
import pathlib
import shutil
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
PAGES = RAIZ / "content" / "pages.json"
GUARDA = RAIZ / ".agents" / "runtime" / "pages-json-antes"
CAMINHO = "/bot/"
HOJE = datetime.date.today().isoformat()

TRECHO_ANTIGO = (
    "Toda requisição feita por este portal a um site externo se apresenta com o "
    "seguinte identificador:\n\n"
    "Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/)\n\n"
)

TRECHO_NOVO = (
    "Toda requisição feita por este portal a um site externo se apresenta com o "
    "seguinte identificador, em que ENDEREÇO é substituído pelo endereço desta "
    "própria página:\n\n"
    "Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +ENDEREÇO)\n\n"
    "O endereço declarado é https://wikijuridica.com.br/bot/ — o mesmo desta "
    "página, e o parêntese apenas fecha o identificador, não faz parte dele.\n\n"
)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--seco", action="store_true", help="mostra o que faria, sem escrever")
    args = ap.parse_args()

    with PAGES.open(encoding="utf-8") as fh:
        dados = json.load(fh)
    if not isinstance(dados, list):
        print("ABORTADO: content/pages.json não é uma lista.", file=sys.stderr)
        return 2

    alvo = None
    for pagina in dados:
        if isinstance(pagina, dict) and pagina.get("path") == CAMINHO:
            alvo = pagina
            break
    if alvo is None:
        print(f"ABORTADO: {CAMINHO} não existe em content/pages.json.", file=sys.stderr)
        return 2

    secoes = alvo.get("body_sections") or []
    tocadas = 0
    for secao in secoes:
        corpo = secao.get("body") or ""
        if TRECHO_ANTIGO in corpo:
            secao["body"] = corpo.replace(TRECHO_ANTIGO, TRECHO_NOVO)
            tocadas += 1

    if tocadas == 0:
        alguma = any("+https://wikijuridica.com.br/bot/)" in (s.get("body") or "") for s in secoes)
        if not alguma:
            print("NADA A FAZER: a ambiguidade já não está no texto.")
            return 0
        print("ABORTADO: o endereço colado ainda existe, mas não no trecho esperado. "
              "O texto mudou desde que este reparo foi escrito — releia antes de forçar.",
              file=sys.stderr)
        return 2

    restante = [s for s in secoes if "wikijuridica.com.br/bot/)" in (s.get("body") or "")]
    print(f"seções corrigidas: {tocadas}")
    print(f"ocorrências ambíguas restantes na página: {len(restante)}")
    if args.seco:
        print("--seco: nada foi escrito.")
        return 0

    GUARDA.mkdir(parents=True, exist_ok=True)
    copia = GUARDA / f"pages.json.{HOJE}.antes-do-reparo-bot"
    shutil.copy2(PAGES, copia)
    modo = PAGES.stat().st_mode & 0o777
    tmp = PAGES.with_suffix(".json.tmp-reparo-bot")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(dados, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.chmod(tmp, modo)
    os.replace(tmp, PAGES)
    print(f"escrito. cópia do anterior em {copia.relative_to(RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
