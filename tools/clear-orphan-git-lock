#!/usr/bin/env bash
# clear-orphan-git-lock — remove index.lock ORFAO deixado por git morto
# (ex.: commit da VM Cowork que morre no rename EINVAL do mount virtiofs).
#
# Ordem do dono 2026-07-22: lock orfao nao trava a fabrica. Este utilitario
# remove APENAS locks com assinatura inequivoca de orfandade:
#   - arquivo com 0 bytes (git escreve o index novo antes do rename; 0 bytes
#     = nem chegou a escrever, ou morreu no inicio);
#   - nenhum processo git vivo no host;
#   - idade minima (default 60s) para nunca correr com um commit saudavel.
# Lock que nao cumpre TODAS as condicoes e preservado (exit 1).
set -euo pipefail
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
LOCK="$ROOT/.git/index.lock"

# Modo estendido (2026-07-31, frontboard clear-orphan-next-index + red-team Fable):
#   --allow-nonempty [min_age_s]  também aposenta locks NÃO-vazios (index.lock
#   parcial de commit morto e next-index-*.lock de partial commit morto).
#   Locks não-vazios NUNCA são deletados: são MOVIDOS (rename, mesmo FS) para
#   .git/cowork-dead-locks/<nome>.dead-<UTC>, preservando forense.
#   Evidência exigida: idade >= min_age (default 1800s) E zero processo git
#   VISÍVEL NESTE NAMESPACE. Limitação declarada: pgrep dentro de sandbox
#   Cowork NÃO enxerga o host — a autoridade final é a confirmação do dono de
#   que nenhuma outra sessão está ativa; sem ela, não use --allow-nonempty.
ALLOW_NONEMPTY=0
if [ "${1:-}" = "--allow-nonempty" ]; then
	ALLOW_NONEMPTY=1
	shift
	MIN_AGE="${1:-1800}"
else
	MIN_AGE="${1:-60}"
fi

live_git="$(pgrep -c -f '(^|/)git ' || true)"

retire_nonempty() {
	local lock="$1" size age name dest
	size="$(stat -c '%s' "$lock")"
	age=$(($(date +%s) - $(stat -c '%Y' "$lock")))
	if [ "$age" -lt "$MIN_AGE" ]; then
		echo "clear-orphan-git-lock: PRESERVADO $lock (age=${age}s < ${MIN_AGE}s)"
		return 1
	fi
	if [ "$live_git" != "0" ]; then
		echo "clear-orphan-git-lock: PRESERVADO $lock (git vivo neste namespace: $live_git)"
		return 1
	fi
	mkdir -p "$ROOT/.git/cowork-dead-locks"
	name="$(basename "$lock")"
	dest="$ROOT/.git/cowork-dead-locks/$name.dead-$(date -u +%Y%m%dT%H%M%SZ)"
	mv -n "$lock" "$dest"
	echo "clear-orphan-git-lock: MOVIDO $lock -> $dest (size=$size, age=${age}s, 0 git neste namespace; pgrep NÃO vê o host — remoção autorizada pelo dono)"
}

if [ "$ALLOW_NONEMPTY" = "1" ]; then
	rc=0
	found=0
	for lock in "$LOCK" "$ROOT"/.git/next-index-*.lock \
		"$ROOT/.git/HEAD.lock" "$ROOT"/.git/refs/heads/*.lock; do
		[ -e "$lock" ] || continue
		found=1
		retire_nonempty "$lock" || rc=1
	done
	[ "$found" = "1" ] || echo "clear-orphan-git-lock: sem lock"
	exit "$rc"
fi

# Modo default (estendido em 2026-08-04): varre TODOS os locks de transação do
# git, não apenas index.lock. Um HEAD.lock órfão de 0 bytes bloqueia o commit
# exatamente como um index.lock órfão ("fatal: cannot lock ref 'HEAD'"), e a
# resposta "sem lock" mandava o operador procurar o defeito no lugar errado —
# medido neste repo: HEAD.lock de 4 dias travando todo commit enquanto a
# ferramenta se declarava limpa. As guardas NÃO mudam: aqui só sai lock de
# 0 bytes; lock com conteúdo continua exigindo --allow-nonempty e pouso
# forense.
retire_empty() {
	local lock="$1" size age
	size="$(stat -c '%s' "$lock")"
	age=$(($(date +%s) - $(stat -c '%Y' "$lock")))
	if [ "$size" != "0" ]; then
		echo "clear-orphan-git-lock: PRESERVADO $lock (size=$size != 0; para lock órfão de commit morto use --allow-nonempty)"
		return 1
	fi
	if [ "$age" -lt "$MIN_AGE" ]; then
		echo "clear-orphan-git-lock: PRESERVADO $lock (age=${age}s < ${MIN_AGE}s)"
		return 1
	fi
	if [ "$live_git" != "0" ]; then
		echo "clear-orphan-git-lock: PRESERVADO $lock (git vivo no host: $live_git)"
		return 1
	fi
	if rm -f "$lock" 2>/dev/null; then
		echo "clear-orphan-git-lock: REMOVIDO $lock (0 bytes, ${age}s, sem git vivo)"
		return 0
	fi
	# Sandbox Cowork: unlink EPERM no mount (medido 2026-07-31). Degrada para o
	# mesmo pouso forense do --allow-nonempty: mv p/ cowork-dead-locks (rename
	# funciona onde unlink não funciona), preservando idade/guards já checados.
	retire_nonempty "$lock"
}

rc=0
found=0
for lock in "$LOCK" "$ROOT"/.git/next-index-*.lock \
	"$ROOT/.git/HEAD.lock" "$ROOT"/.git/refs/heads/*.lock; do
	[ -e "$lock" ] || continue
	found=1
	retire_empty "$lock" || rc=1
done
[ "$found" = "1" ] || echo "clear-orphan-git-lock: sem lock"
exit "$rc"
