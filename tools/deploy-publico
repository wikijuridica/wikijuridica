if [ "$REPUBLICAR" = "1" ]; then
	step "0.5/7 censo de severidade (o publicador so ve pagina que o censo viu)"
	if ! nice -n 19 ./tools/generate-censo-acompanha-estoque; then
		fail "o censo de severidade nao pode ser posto em dia. Publicar assim recusaria com 'sem_linha_no_censo' justamente as paginas novas — as que motivaram o deploy. NADA foi para o ar. Rode ./tools/check-censo-acompanha-estoque para ver quais shards estao a frente do censo."
