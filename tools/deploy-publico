#!/usr/bin/env bash
# deploy-publico — poe no ar o estado atual do repo, sem sobra de cache.
#
# POR QUE EXISTE: em 2026-08-06, depois de publicar 9.400 paginas e adicionar o
# botao flutuante de WhatsApp, o site continuou servindo o HTML ANTIGO. O
# binario era novo, o public/ era novo, o manifesto era novo — e mesmo assim o
# visitante via a versao velha, porque var/on-demand-cache guardava 108 MB de
# respostas geradas antes da mudanca. Reiniciar o servico nao limpa esse cache.
#
# Um deploy pela metade e pior que nenhum: o repo diz uma coisa, o mundo externo
# ve outra, e a diferenca nao aparece em nenhum check. Este script existe para
# que a ordem correta nao dependa de alguem lembrar dela.
#
# ORDEM (cada passo depende do anterior):
#   1. republica     — o render mudou? entao os SHA-256 do manifesto mudaram.
#                      Publicar de novo nao e opcional: sem isso o Validate
#                      reprova no boot e o servidor NAO SOBE.
#   2. builda        — binario novo a partir do codigo atual
#   3. para          — trocar binario com o processo vivo da "Text file busy"
#   4. limpa cache   — o passo esquecido. Cache e reproduzivel; o servidor
#                      regenera sob demanda.
#   5. sobe          — servico de volta
#   6. confere       — smoke real contra o dominio publico; se falhar, avisa
#                      onde esta o snapshot de rollback
#
# Uso:
#   tools/deploy-publico                 # ciclo completo
#   tools/deploy-publico --sem-republicar # so binario + cache (mudou codigo que nao e render)
#   tools/deploy-publico --so-cache      # emergencia: limpa cache e reinicia
#   tools/deploy-publico --ressemear     # mudou markup/CSS servido, nao o texto:
#                                        # regrava a linha de base do ledger de
#                                        # data por conteudo SEM re-datar o acervo

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

SERVICE=wikijuridica-server
CACHE_DIR=var/on-demand-cache
PUBLIC_HOST=https://wikijuridica.com.br
LOCAL_ADDR=http://127.0.0.1:8089

# O SEGUNDO BINARIO (2026-09-05).
#
# Este deploy conhecia UM servico. A rede social subiu em 04/09 e ficou fora
# dele: quem publicasse o acervo deixava /redesocial/ rodando o binario da
# vespera, e a unica forma de atualiza-la era a mao -- foi assim que, em
# 05/09, doze rotas novas e a folha de estilo passaram horas respondendo 404
# em producao enquanto o codigo delas ja estava commitado.
#
# Ele NAO compartilha o caminho de parada do acervo, e a diferenca importa: o
# acervo faz stop/start porque o passo 4 apaga var/nginx/cache e o binario tem
# de estar trocado antes de o socket voltar. A rede social nao depende de
# nenhum desses passos, entao ela leva `restart` -- com Type=notify e o socket
# ativo, o systemd segura a conexao durante a troca e o visitante nao ve 502.
SERVICE_SOCIAL=wikijuridica-social
LOCAL_ADDR_SOCIAL=http://127.0.0.1:8091

# TOPOLOGIA DO INGRESS EM FONTE UNICA.
#
# Ate 2026-08-13 a unit do nginx e a porta da origem estavam escritas a mao em
# dez ferramentas diferentes. Duas consequencias medidas:
#
#   - o gate de disponibilidade lia `journalctl -u nginx`. Quando o wiki ganhar
#     instancia dedicada (wikijuridica-nginx), esse gate passa a vigiar um
#     servico que nao serve mais o site — e fica VERDE para sempre;
#   - durante a migracao, os checks sondariam a instancia VELHA e aprovariam uma
#     config que ja nao e a servida.
#
# `ops/ingress.env` e a fonte unica: trocar la muda deploy, gates e sondas ao
# mesmo tempo, que e a unica forma de o flip ser atomico.
INGRESS_ENV="ops/ingress.env"
# shellcheck source=/dev/null
[ -f "$INGRESS_ENV" ] && . "$INGRESS_ENV"
# A UNIT DEDICADA, nao a do sistema. Desde 2026-08-13 (commit dbaa3403) o wiki
# tem ingresso proprio: `wikijuridica-nginx.service`, rodando
# `nginx -c ops/nginx/standalone/nginx.conf -p var/nginx/`. O padrao antigo era
# `nginx`, a unit COMPARTILHADA com o outro projeto deste servidor -- e com ela o
# deploy recarregaria o servico errado: o do vizinho, que nem esta no ar. O
# resultado seria o pior tipo de falha, a silenciosa: exit code verde, smoke
# passando pelos workers que ninguem tocou, e a mudanca de ingresso nunca
# entrando.
NGINX_UNIT="${WIKI_NGINX_UNIT:-wikijuridica-nginx}"
# O `-t` tem de validar a MESMA config que a unit carrega. `nginx -t` sem
# argumento le /etc/nginx/nginx.conf -- o do vizinho -- e aprovaria uma config
# que o nosso ingresso nunca vai ler. Os caminhos saem da propria unit
# (ExecStartPre), nao de suposicao.
NGINX_CONF="${WIKI_NGINX_CONF:-/opt/wiki/ops/nginx/standalone/nginx.conf}"
NGINX_PREFIX="${WIKI_NGINX_PREFIX:-/opt/wiki/var/nginx/}"
ORIGIN_PORT="${WIKI_ORIGIN_PORT:-8088}"
# TODOS os arquivos que o ingress carrega, e nao so o vhost.
#
# O DEFEITO QUE ISTO FECHA, medido em producao em 2026-08-29: a lista tinha UM
# arquivo, e a CSP nao mora nele. Ela mora em `security-headers.conf`, que entra
# por `include`, e a config que a unit realmente carrega e `standalone/nginx.conf`.
# Mudar o hash da CSP nao mudava a impressao da camada, o deploy concluia
# "ingress intacto" e NAO recarregava o nginx: o acervo saiu com o script novo e o
# header vivo continuou autorizando o hash antigo. O navegador recusou o script
# inline em TODA pagina, EM SILENCIO — sem erro no log, sem 500, com o HTML
# perfeito. Quarenta minutos assim, e a purga seguinte cacheou a combinacao morta
# na borda por sete dias.
#
# `tools/check-ingress-fontes-completas` resolve os `include` de verdade e cobra
# esta lista, para que ela nao envelheca de novo.
# OS TRES .conf DA REDE SOCIAL E O DE OPERADORES ENTRARAM EM 2026-09-05, e o
# proprio passo 0a do deploy os cobrou -- ele varre o que o ingress inclui e
# reprova o que esta lista nao vigia. O gate estava certo e a lista, atrasada:
#
#   social-headers-{publico,privado}.conf  carregam a CSP da rede social, e ela
#     e emitida por more_set_headers, que SOBRESCREVE o cabecalho do upstream.
#     Sem reload, o navegador recusa o script em silencio -- e painel vazio e
#     indistinguivel de "nao ha visitantes".
#   bot-operators.conf  e gerado por tools/generate-nginx-bot-operators a partir
#     de data/ops/bot_ip_ranges/*.json (2.491 prefixos, 7 operadores). Ele
#     alimenta o `geo $wj_operador_do_ip` de que a chave do teto agregado
#     depende: sem reload, faixa de IP nova nao passa a valer.
NGINX_CONF_FONTES="${WIKI_NGINX_CONF_FONTES:-ops/nginx/wikijuridica.conf ops/nginx/security-headers.conf ops/nginx/standalone/nginx.conf ops/nginx/social-headers-publico.conf ops/nginx/social-headers-privado.conf ops/nginx/bot-operators.conf}"

# JANELA DE MANUTENCAO declarada para o vigia.
#
# O watchdog (ops/systemd/wikijuridica-watchdog.timer) roda a cada 2 min com
# --repair. Sem esta declaracao ele via o servico parado no meio do deploy, o
# reiniciava, e o `cp` do binario novo falhava com "Text file busy" — deploy
# abortado pelo proprio vigilante. Aconteceu em 2026-08-06.
#
# O lock e removido em qualquer saida (trap), e o vigia o ignora depois de 30
# min, para que um deploy interrompido nao desligue a vigilancia para sempre.
DEPLOY_LOCK=data/ops/.deploy-em-curso.lock
mkdir -p data/ops && : >"$DEPLOY_LOCK"
trap 'rm -f "$DEPLOY_LOCK"' EXIT INT TERM

# BATIDA NO LOCK — a idade dele passa a medir SINAL DE VIDA, nao tempo de vida.
#
# Os tres leitores deste arquivo (internal/checks/http_smoke_redesocial.go:264,
# tools/check-portal-health:431, tools/deploy-binario-go:628) calam a vigilancia
# enquanto o lock for novo e acusam ORFAO depois de 30 min, para que um deploy
# interrompido nao desligue o vigia para sempre. A regra estava certa; a medida
# estava errada.
#
# Medido em 2026-09-10: o deploy #3 levou 46 min porque o passo de reaquecimento
# sozinho custa 22.446 URLs a 12 r/s = 31 min. Aos 30 min de um deploy VIVO e
# saudavel, check-http-smoke passou a devolver
# `http_smoke_redesocial_lock_de_deploy_orfao=47min` — alarme falso, e alarme
# falso treina o operador a ignorar o verdadeiro. Com o acervo crescendo, todo
# deploy futuro cruzaria a janela.
#
# `com_batida_no_lock <comando...>` roda o comando em segundo plano e, em
# primeiro plano, toca o lock enquanto ele viver. Nao ha processo separado que
# possa sobreviver a morte do deploy: o laco mora no proprio shell do script,
# entao `kill -9` no deploy leva a batida junto e o lock envelhece de verdade —
# que e exatamente o que a deteccao de orfao existe para enxergar.
# orcamento_de_aquecimento devolve os segundos que a lista precisa a 12 r/s, com
# folga de 60%, ou 0 quando ela nao cabe na janela do deploy.
#
# POR QUE 0 EM VEZ DE 3600, medido em 2026-09-10: o passo dirigido tinha
# `timeout 1800` fixo; a purga do deploy #4 foi de 22.414 URLs e, a 12 r/s, isso
# custa 1.868 s. Estourou por 68 segundos e a borda ficou parcialmente fria com o
# acervo recem-purgado. Cortar o orcamento no teto so adiaria o mesmo desfecho
# para uma lista maior — e gastaria a hora inteira segurando o lock pesado antes
# de imprimir o mesmo aviso. Acima do teto, a resposta certa nao e um numero
# menor: e dizer que nao cabe e delegar ao timer, com o numero na tela.
#
# O piso de 300s cobre lista curta (uma lista de 12 URLs nao deve morrer num
# timeout de 1 segundo).
# segundos_de_aquecimento devolve o tempo ESTIMADO da passada, COM a folga de
# 1,6x sobre os 12 r/s nominais — a mesma folga que decide se o reaquecimento
# cabe na janela. Ela existe separada por um motivo medido em 2026-09-10: a
# mensagem do reaquecimento delegado calculava o tempo por conta propria, com
# outra variavel E outra formula, e saiu contraditoria na tela:
#
#     "27165 URLs a 12 r/s levariam 2263s, acima do teto de 3600s"
#
# 2.263 nao e acima de 3.600. O texto imprimia `TODOS_N / 12` (a lista de
# PURGA, sem folga) enquanto a decisao usava `AQUECER_N * 16 / 10 / 12` (a
# lista de AQUECIMENTO, com folga) — dois numeros para a mesma pergunta, e o
# que aparecia era o que nao decidia nada. Quem le a mensagem conclui que o
# deploy delegou sem motivo.
#
# Agora ha uma fonte so: quem decide e quem imprime chamam esta funcao.
segundos_de_aquecimento() {
	echo $(($1 * 16 / 10 / 12))
}

orcamento_de_aquecimento() {
	local urls="$1" orcamento
	orcamento=$(segundos_de_aquecimento "$urls")
	if [ "$orcamento" -gt 3600 ]; then
		echo 0
		return 0
	fi
	[ "$orcamento" -lt 300 ] && orcamento=300
	echo "$orcamento"
}

BATIDA_INTERVALO="${BATIDA_INTERVALO:-30}"
com_batida_no_lock() {
	"$@" &
	batida_filho=$!
	while kill -0 "$batida_filho" 2>/dev/null; do
		: >"$DEPLOY_LOCK" 2>/dev/null || true
		sleep "$BATIDA_INTERVALO"
	done
	wait "$batida_filho"
}

REPUBLICAR=1
REBUILD=1
# RESSEMEAR repassa --ressemear ao gerador de data por conteudo, no passo 6.
#
# POR QUE PRECISOU EXISTIR (2026-08-29): o gerador re-data toda rota cujo HTML
# SERVIDO mudou, e ele so isenta o que a neutralizacao cobre -- <script> sem
# atributo e datas. Mudanca ESTRUTURAL que nao e conteudo (um `target`, um
# `aria-label`, uma classe de CSS) escapa da neutralizacao e carimba as 10 mil
# rotas com a data de hoje, reanunciando o sitemap inteiro ao Googlebot como se
# o texto tivesse sido revisado. Isso e frescor fabricado, que e exatamente o que
# este ledger existe para impedir.
#
# Ate aqui o remedio existia (`--ressemear` regrava a linha de base sem carimbar
# data nova) mas era INALCANCAVEL de dentro do deploy: o operador teria de deixar
# o deploy re-datar e consertar depois, ou nao usar o deploy. O CLAUDE.md
# registrava a armadilha em vez de resolve-la.
#
# Quando usar: mudou o markup/CSS/atributo servido SEM mudar o texto editorial.
# Quando NAO usar: mudou o texto -- ai a re-datacao e verdadeira e devida.
RESSEMEAR=0
while [ $# -gt 0 ]; do
	case "$1" in
	--sem-republicar)
		REPUBLICAR=0
		shift
		;;
	--so-cache)
		REPUBLICAR=0
		REBUILD=0
		shift
		;;
	--ressemear)
		RESSEMEAR=1
		shift
		;;
	-h | --help)
		sed -n '2,32p' "$0"
		exit 0
		;;
	*)
		echo "opcao desconhecida: $1" >&2
		exit 2
		;;
	esac
done

step() { printf '\n\033[1m>> %s\033[0m\n' "$1"; }
fail() {
	printf '\n\033[31mFALHOU: %s\033[0m\n' "$1" >&2
	exit 1
}

# --- 0a. o ingress e o atestado, conferidos ANTES de qualquer minuto gasto ----
#
# Os dois checks abaixo custam segundos e evitam as duas falhas que mais
# custaram nesta fabrica: deploy que morre no meio (atestado do validador
# desatualizado — quatro incidentes) e deploy que "passa" servindo um script que
# o proprio header recusa (lista de fontes do ingress incompleta).
#
# Rodam ANTES do ingest de proposito. O ingest leva minutos; descobrir ali que o
# atestado nao bate e pagar esse tempo para nada.
if ! tools/check-validator-attestation >/dev/null 2>&1; then
	step "0a/7 atestado do validador"
	tools/check-validator-attestation 2>&1 | sed 's/^/  /'
	fail "o atestado do validador nao descreve o grafo de fonte: o ingest recusaria publicar"
fi
if ! tools/check-ingress-fontes-completas >/dev/null 2>&1; then
	step "0a/7 fontes do ingress"
	tools/check-ingress-fontes-completas 2>&1 | sed 's/^/  /'
	fail "a lista de fontes do ingress esta incompleta: mudanca de CSP nao dispararia reload"
fi
# O SYSTEMD HONRA O QUE ops/systemd DECLARA? (2026-09-02) Em 01/09 a unit do
# servico ganhou Requires=wikijuridica-server.socket sem a .socket instalada:
# o passo 3 abaixo morreria com exit 5 ("unit not found") lido como "sem sudo",
# DEPOIS de pagar reingest e build. Fail-fast aqui, antes de tudo; a cura
# (symlink + daemon-reload) e do vigia e do operador, nao deste passo.
if ! tools/check-units-instaladas >/dev/null 2>&1; then
	step "0a/7 units do systemd"
	tools/check-units-instaladas 2>&1 | sed 's/^/  /'
	fail "unit de ops/systemd que o systemd nao honra: o restart do passo 5 falharia. Remedio impresso acima."
fi

# --- 0a-bis. o estoque editorial esta commitado? ------------------------------
#
# O ACIDENTE QUE ISTO IMPEDE, e ele quase aconteceu em 2026-08-29. Este
# repositorio roda varias sessoes concorrentes. Na hora de publicar a frente de
# malha, `git status` mostrava 158 shards de data/editorial/v2_pages MODIFICADOS
# E NAO COMMITADOS por outra frente, no meio de uma correcao.
#
# O publicador le o estoque da WORKTREE, nao do indice. Publicar naquele momento
# teria levado ao ar 158 shards de trabalho em voo -- texto juridico a meio
# caminho, sem revisao fechada e sem existir no historico. Nenhum gate acusaria:
# cada lado esta coerente consigo mesmo, e o defeito so apareceria como pagina
# publicada com texto que ninguem aprovou e que nao da para rastrear nem reverter.
#
# A guarda e simples e a mensagem diz o que fazer. Ela NAO tenta commitar nada
# por conta propria: trabalho de outra sessao se commita por quem o escreveu.
#
# WIKI_DEPLOY_PERMITE_ESTOQUE_SUJO=1 libera, para o caso em que a propria sessao
# esta com uma correcao aberta e sabe o que esta fazendo. Existe porque guarda
# sem escape vira guarda que alguem desliga apagando a linha -- e ai ela some
# para sempre, em vez de aparecer no comando com o motivo declarado.
step "0a-bis/7 estoque editorial commitado"
ESTOQUE_SUJO="$(git status --porcelain -- data/editorial/v2_pages data/editorial/portfolio_v2 2>/dev/null | wc -l | tr -d ' ')"
if [ "${ESTOQUE_SUJO:-0}" -gt 0 ]; then
	if [ "${WIKI_DEPLOY_PERMITE_ESTOQUE_SUJO:-0}" = "1" ]; then
		echo "  $ESTOQUE_SUJO arquivo(s) de estoque nao-commitado(s) — liberado por WIKI_DEPLOY_PERMITE_ESTOQUE_SUJO=1"
	else
		git status --short -- data/editorial/v2_pages data/editorial/portfolio_v2 | head -8 | sed 's/^/    /'
		[ "$ESTOQUE_SUJO" -gt 8 ] && echo "    ... e mais $((ESTOQUE_SUJO - 8))"
		echo "  O publicador le o estoque da WORKTREE. Publicar agora levaria ao ar"
		echo "  trabalho editorial que nao existe no historico — sem rastreio e sem reversao."
		echo "  Remedio: quem escreveu commita. Se a correcao aberta e SUA e voce sabe"
		echo "  o que esta publicando: WIKI_DEPLOY_PERMITE_ESTOQUE_SUJO=1 ./tools/deploy-publico"
		fail "estoque editorial com $ESTOQUE_SUJO arquivo(s) nao-commitado(s)"
	fi
else
	echo "  limpo"
fi

# --- 0. reingerir o estoque, se ele mudou ------------------------------------
#
# O PASSO QUE FALTAVA, e a falha que ele corrige (2026-08-07): corrigi a citacao
# legal de 19 paginas no estoque (data/editorial/v2_pages/*.jsonl), commitei,
# rodei este deploy e conferi no ar — o visitante continuava lendo o texto
# ERRADO. O HTML publico nao nasce do JSONL: nasce do contentstore, que so muda
# quando ingest-v2-stock roda. Sem este passo o repo diz uma coisa e o mundo ve
# outra, e nenhum check acusa a diferenca, porque cada lado esta coerente
# consigo mesmo.
#
# Roda so quando algum shard esta mais novo que o stock_manifest.json — o ingest
# custa minutos e a maioria dos deploys nao toca conteudo. Se o estoque mudou e
# o ingest reprova, o deploy PARA: publicar com o contentstore velho e
# exatamente o defeito que este passo existe para impedir.
#
# ORCAMENTO DE TEMPO DIMENSIONADO PELO ACERVO, e nao por constante magica.
#
# tools/ingest-v2-stock chama run-go-cmd-cached, cujo derive_run_timeout_seconds
# (tools/run-go-cmd-cached:845) cai no DEFAULT de 300s quando ninguem declara
# WIKI_GO_CMD_TIMEOUT_SECONDS. Medicao real do ingest do acervo inteiro:
#   .agents/runtime/deploy-20260807b.log:59  ->  status=pass duration_ms=254174
# ou seja 254s para 9.771 paginas de shard = 26,0 ms por pagina. Com 300s de
# teto, a margem era de 13% — e na primeira execucao do dia, que ainda compila o
# cmd, ela nao coube: o processo foi morto sem TIMING e o deploy anunciou
# "reprovou" (diagnostico oposto ao verdadeiro; ver classificacao abaixo).
#
# RECALIBRADO EM 2026-08-13, DEPOIS DE A MARGEM ACABAR NA PRATICA.
#
# A calibracao anterior era 40 ms/pagina, derivada de 26 ms/pagina medidos em
# 2026-08-07, e o comentario aqui afirmava "2,01x o pior tempo ja medido". A
# afirmacao envelheceu sem que ninguem remedisse: os quatro ingests completos
# registrados em .agents/runtime/deploy-ingest-*.log levaram 461s, 467s, 476s e
# 482s — contra o orcamento de 513s que a formula produzia. A folga real era de
# 6%, nao de 101%, e hoje ela nao coube: o ingest foi morto por tempo (exit 124)
# com o host sob load 8-11 de agentes concorrentes, e a publicacao inteira
# reprovou. NADA foi ao ar, que e o comportamento correto — mas o motivo era uma
# constante mentindo sobre a propria medicao.
#
# O ingest passou de ~26 ms/pagina (08-07) para ~49 ms/pagina (08-13), quase o
# dobro, com o acervo praticamente do mesmo tamanho. ISSO E UM ACHADO ABERTO,
# registrado e nao resolvido aqui: pela regua do repo, lentidao que dobra e bug
# P0 e se corrige com incremental/shard/paralelismo no proprio cmd, nunca
# alargando o teto. O que este bloco conserta e outra coisa — a constante estava
# calibrada num numero que nao vale mais, e um orcamento derivado de medicao
# obsoleta nao e orcamento, e chute.
#
# Formula, com a folga justificada termo a termo:
#   segundos = paginas * 75ms/pagina / 1000 + 120s
#     75 ms/pagina  = 49 ms MEDIDOS HOJE (482s / 9.833 linhas de shard, o pior
#                     dos quatro registros) x 1,53 de folga para contencao de CPU
#                     (o host e compartilhado com agentes), cache frio e I/O.
#                     Mesmo criterio do autor original, sobre medicao atual.
#     120 s fixos   = custo que NAO escala com o acervo: compilacao do
#                     ./cmd/ingest-v2-stock na primeira execucao do dia mais a
#                     validacao de manifesto/recibo/transacao.
# Acervo de hoje: 9.833 * 75/1000 + 120 = 857s (aritmetica inteira do shell),
# 1,78x o pior tempo medido — de volta a ordem de folga que o desenho pedia.
#
# Clamps: piso 300s (nunca abaixo do default atual) e teto 1800s, que e o
# MAX_WRAPPER_TIMEOUT_SECONDS de tools/run-go-cmd-cached:39 — acima dele o
# wrapper RECUSA a rodar (linha 589) e o deploy morreria antes de comecar, que e
# justamente o defeito de mensagem que este bloco corrige. Um acervo que estourar
# 1800s nao se resolve alargando timeout: shard/paralelismo/incremental no
# proprio cmd. Valor vindo do ambiente e respeitado sem sobrescrita, e a variavel
# so vale para ESTA invocacao (nao vaza para o publish do passo 1).
orcamento_ingest_segundos() {
	local paginas segundos
	paginas="$(find data/editorial/v2_pages -name '*.jsonl' ! -name '*.partial.jsonl' -exec cat {} + 2>/dev/null | wc -l | tr -d ' ')"
	if ! [ "$paginas" -gt 0 ] 2>/dev/null; then
		echo "  AVISO: nao consegui contar as paginas do estoque; orcamento no piso de 300s" >&2
		printf '300'
		return 0
	fi
	segundos=$((paginas * 75 / 1000 + 120))
	[ "$segundos" -lt 300 ] && segundos=300
	[ "$segundos" -gt 1800 ] && segundos=1800
	printf '%s' "$segundos"
}

if [ "$REPUBLICAR" = "1" ] && [ "${WIKI_DEPLOY_SEM_INGEST:-}" != "1" ]; then
	# ★ O SHARD NAO E O UNICO GATILHO: O VALIDADOR TAMBEM CONTA (2026-08-30).
	#
	# Ate aqui a decisao era so `shard mais novo que o contentstore`. Medido na
	# mesma sessao: 30 requisitos de fonte foram corrigidos em
	# `internal/v2ingest` -- o gate exigia ancora que NAO EXISTE no documento e
	# recusava pagina correta (BUG-191) --, o estoque nao mudou uma virgula, e o
	# deploy imprimiu "ingest dispensado". O acervo seguiu servindo o veredito
	# do validador ANTIGO, e paginas que a correcao acabara de destravar
	# continuaram fora.
	#
	# O atestado do grafo e o discriminante certo, e ele ja existe: muda sempre
	# que o codigo do validador muda, e so entao. Comparar contra o mtime do
	# contentstore custa um stat.
	INGEST_POR_SHARD="$(find data/editorial/v2_pages -name '*.jsonl' -newer data/editorial/stock_manifest.json -print -quit 2>/dev/null)"
	INGEST_POR_VALIDADOR=""
	if [ internal/v2ingest/validator_fingerprint_attestation_generated.go -nt data/editorial/stock_manifest.json ]; then
		INGEST_POR_VALIDADOR="1"
	fi
	if [ -n "$INGEST_POR_SHARD" ] || [ -n "$INGEST_POR_VALIDADOR" ]; then
		if [ -n "$INGEST_POR_SHARD" ]; then
			step "0/7 reingerindo o estoque (shard mais novo que o contentstore)"
		else
			step "0/7 reingerindo o estoque (o VALIDADOR mudou desde o contentstore)"
		fi
		INGEST_TIMEOUT="${WIKI_GO_CMD_TIMEOUT_SECONDS:-$(orcamento_ingest_segundos)}"
		INGEST_LOG=".agents/runtime/deploy-ingest-$(date +%Y%m%d-%H%M%S).log"
		mkdir -p .agents/runtime
		echo "  orcamento: ${INGEST_TIMEOUT}s (dimensionado pelo tamanho do estoque); saida em $INGEST_LOG"
		nice -n 19 env WIKI_GO_CMD_TIMEOUT_SECONDS="$INGEST_TIMEOUT" ./tools/ingest-v2-stock 2>&1 | tee "$INGEST_LOG"
		INGEST_RC="${PIPESTATUS[0]}"
		# TRES DESFECHOS, TRES ACOES OPOSTAS.
		#
		# Ate 2026-08-12 qualquer saida != 0 virava "o ingest reprovou", o que
		# manda o operador investigar CONTEUDO quando o problema e ENVELOPE.
		# A linha TIMING (cmd/ingest-v2-stock/main.go:235) e o discriminante: ela
		# so existe se o comando chegou ao fim, e sai tanto em status=pass quanto
		# em status=fail. Sem ela, o comando nao terminou.
		#   124/137 -> morto pelo relogio (timeout / kill-after do supervisor)
		#   TIMING presente -> terminou e reprovou: a causa esta no log
		#   nem um nem outro -> nem chegou a rodar (recusa do run-go-cmd-cached,
		#                       exit 2 de validacao ou 75 de supervisao)
		if [ "$INGEST_RC" -ne 0 ]; then
			if [ "$INGEST_RC" = "124" ] || [ "$INGEST_RC" = "137" ]; then
				fail "o ingest NAO TERMINOU: foi morto pelo tempo (exit $INGEST_RC) com orcamento de ${INGEST_TIMEOUT}s. Isto NAO e reprovacao de conteudo — nao ha o que investigar no estoque. Meça o ingest isolado (tools/ingest-v2-stock imprime TIMING) e redimensione o orcamento em tools/deploy-publico, ou torne o ingest incremental se o acervo cresceu. NADA foi para o ar. Log: $INGEST_LOG"
			elif grep -q '^TIMING command=ingest-v2-stock' "$INGEST_LOG"; then
				fail "o ingest REPROVOU (exit $INGEST_RC; terminou e disse por que — veja $INGEST_LOG). NADA foi para o ar. O estoque mudou e o contentstore ficaria velho — o visitante leria o texto antigo. Transacao interrompida se recupera com --recover-transaction-id/--recover-commit-marker (veja data/ops/v2_ingest_transaction_journal.json)."
			else
				fail "o ingest NEM CHEGOU A RODAR (exit $INGEST_RC, sem linha TIMING e sem morte por tempo): o envelope recusou antes do comando. Causa tipica: validacao do tools/run-go-cmd-cached (orcamento acima do teto de 1800s, janela 00-03Z do ingest-v2-stock) — a mensagem exata esta em $INGEST_LOG. NADA foi para o ar."
			fi
		fi
	else
		step "0/7 ingest dispensado (contentstore mais novo que os shards)"
	fi
fi

