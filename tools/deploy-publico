# IMPRESSAO DIGITAL DA CAMADA — calculada AQUI, e nao no passo 6.
#
# Ela precisa existir antes do passo 4, que decide se o nginx e recarregado
# ou nao tocado. Depende do binario recem-compilado (passo 2), entao este e o
# primeiro ponto do script em que as duas fontes ja estao no disco.
CAMADA_ESTADO="data/ops/deploy_layer_fingerprint.json"
CAMADA_MUDOU=0
INGRESS_MUDOU=0

# HASH POR COMPONENTE, e nao um so combinado.
#
# O schema v1 guardava UM `layer_sha256` sobre [binario, vhost]. Um hash unico
# responde "mudou ou nao mudou" e nada mais — nunca QUAL dos dois mudou. Isso
# bastava enquanto a resposta era sempre a mesma (reiniciar o nginx), mas a
# decisao agora tem tres saidas diferentes:
#
#   binario mudou      -> o servico Go ja e reiniciado nos passos 3 e 5;
#                         o nginx nao tem nada com isso.
#   config do ingress  -> `nginx -t` + RELOAD, e o reload precisa ser provado.
#   nada da camada     -> NAO TOCAR no nginx. Deploy de conteudo e arquivo em
#                         disco; o nginx le por requisicao.
#
# Com um hash so, ou todo deploy de conteudo pagaria um reload, ou nenhum deploy
# de config pagaria — as duas erradas.
BIN_ATUAL="$([ -f bin/wikijuridica-server.next ] && sha256sum bin/wikijuridica-server.next 2>/dev/null | cut -d' ' -f1)"
INGRESS_ATUAL="$(
	for _conf in $NGINX_CONF_FONTES; do
		[ -f "$_conf" ] && sha256sum "$_conf"
	done 2>/dev/null | sha256sum | cut -d' ' -f1
)"
CAMADA_ATUAL="$(printf '%s\n%s\n' "$BIN_ATUAL" "$INGRESS_ATUAL" | sha256sum | cut -d' ' -f1)"
# O binario do social e outro processo e serve outro conjunto na borda
# (/redesocial/ e os temas, s-maxage=3600). Hash proprio, purga propria.
SOCIAL_ATUAL="$([ -f bin/wikijuridica-social.next ] && sha256sum bin/wikijuridica-social.next 2>/dev/null | cut -d' ' -f1)"

# OS ARTEFATOS DE DESCOBERTA TEM IMPRESSAO PROPRIA, e a razao e um buraco medido.
#
# A purga seletiva so acontece quando ALGUMA PAGINA muda de conteudo. Deploy que
# altera SOMENTE robots.txt (regenerar a politica de bots, por exemplo) sai com
# ALVOS_N=0, cai no ramo "nada a purgar" e nao purga coisa nenhuma — nem os
# artefatos. E `tools/generate-page-content-revision` hasheia apenas os campos
# autorais de content/pages.json, entao robots.txt nao entra naquela conta por
# construcao.
#
# O prejuizo nao e hipotetico. Em 2026-08-12 a borda serviu por DIAS um
# robots.txt de 2.818 bytes contra 1.670 do disco, com a diretiva nao-padrao
# Content-Signal que o Bing Webmaster acusava como erro de sintaxe e que deixava
# a URL em "Discovered but not crawled". So uma purga manual resolveu.
#
# POR QUE HASH E NAO TTL CURTO NA BORDA: encurtar o edge TTL do robots.txt seria
# a correcao obvia e seria pior. HIT nao renova TTL nesta zona; com 300 s o
# arquivo ficaria expirado a maior parte do tempo e cada requisicao atravessaria
# o tunel — e robots.txt respondendo 530 numa oscilacao de tunel faz o Googlebot
# parar de rastrear o site INTEIRO, que e exatamente o colapso de 2026-08-11. Os
# sete dias de TTL sao o que mantem robots e sitemap servives durante queda de
# origem; o que faltava era propagar a mudanca em segundos quando ela ocorre.
ARTEFATOS_ATUAL="$(
	{
		for _art in public/robots.txt public/sitemap.xml public/feed.xml \
			public/llms.txt public/.well-known/security.txt; do
			[ -f "$_art" ] && sha256sum "$_art"
		done
		for _shard in public/sitemaps/*.xml; do
			[ -f "$_shard" ] && sha256sum "$_shard"
		done
	} 2>/dev/null | sha256sum | cut -d' ' -f1
)"

_le_hash() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([0-9a-f]*\)\".*/\1/p" "$CAMADA_ESTADO" 2>/dev/null | head -1; }
CAMADA_ANTERIOR="$(_le_hash layer_sha256)"
BIN_ANTERIOR="$(_le_hash bin_sha256)"
INGRESS_ANTERIOR="$(_le_hash ingress_sha256)"
ARTEFATOS_ANTERIOR="$(_le_hash artefatos_sha256)"
SOCIAL_ANTERIOR="$(_le_hash social_sha256)"

# Estado gravado por schema anterior (v1/v2) nao tem o campo. Nesse caso o
# artefato e tratado como MUDADO: errar para o lado de purgar custa um
# reaquecimento; errar para o outro deixa robots.txt velho na borda por sete
# dias, que foi o incidente.
ARTEFATOS_MUDOU=0
if [ -z "$ARTEFATOS_ANTERIOR" ] || [ "$ARTEFATOS_ATUAL" != "$ARTEFATOS_ANTERIOR" ]; then
	ARTEFATOS_MUDOU=1
fi

if [ -z "$CAMADA_ANTERIOR" ]; then
	CAMADA_MUDOU=1
	INGRESS_MUDOU=1
	echo "  camada de servico sem registro anterior — purga total e reload por precaucao"
else
	[ "$CAMADA_ATUAL" != "$CAMADA_ANTERIOR" ] && CAMADA_MUDOU=1
	# Estado gravado pelo schema v1 nao tem os campos por componente. Nesse caso
	# o ingress e tratado como MUDADO: errar para o lado de recarregar custa um
	# reload; errar para o outro deixa config nova fora do ar.
	if [ -z "$INGRESS_ANTERIOR" ] || [ "$INGRESS_ATUAL" != "$INGRESS_ANTERIOR" ]; then
		INGRESS_MUDOU=1
	fi
	if [ "$CAMADA_MUDOU" -eq 1 ]; then
		if [ "$INGRESS_MUDOU" -eq 1 ]; then
			echo "  config do ingress mudou desde o ultimo deploy — a RESPOSTA muda sem o conteudo mudar"
		else
			echo "  binario mudou desde o ultimo deploy (ingress intacto) — purga do conjunto dinamico (o que o Go serve), sem tocar no nginx"
		fi
	fi
fi
# Binario por binario (2026-09-09): cada um entra na purga com o conjunto que
# serve. Sem registro anterior (schema antigo) conta como mudado -- errar para
# o lado de purgar. Sem .next (deploy sem rebuild) nao mudou.
BIN_MUDOU=0
SOCIAL_MUDOU=0
if [ -n "$BIN_ATUAL" ] && [ "$BIN_ATUAL" != "$BIN_ANTERIOR" ]; then BIN_MUDOU=1; fi
if [ -n "$SOCIAL_ATUAL" ] && [ "$SOCIAL_ATUAL" != "$SOCIAL_ANTERIOR" ]; then SOCIAL_MUDOU=1; fi

# --- 3. parar ----------------------------------------------------------------
# --- 2.5. brotli estatico ------------------------------------------------------
#
# POR QUE AQUI, entre o build e a parada do servico: os .br derivam de public/,
# entao precisam vir DEPOIS da republicacao (passo 1) e ANTES de o servico voltar
# a atender (passo 5). Rodar com o servico de pe e seguro -- a ferramenta escreve
# em arquivo temporario e faz os.replace atomico.
#
# O DEFEITO QUE ISTO FECHA, medido em 2026-08-26: o nginx declara
# `brotli_static on` e NAO EXISTIA UM UNICO arquivo .br em disco -- zero, contra
# 10.298 HTMLs. A diretiva manda servir a versao pre-comprimida quando ela
# existe; sem nenhuma, o nginx recomprimia CADA resposta a cada requisicao.
#
# Tres ganhos medidos: 9,0% menos bytes na rede (q11 da 6.972 contra 7.665 do q5
# dinamico numa pagina de 25.319); CPU por requisicao vai a zero; e -- o que mais
# importa para bot -- o ETag VOLTA A SER FORTE. Com brotli dinamico o nginx serve
# `ETag: W/"..."`, validador FRACO, porque o filtro de compressao alterou o corpo
# depois de o ETag ter sido calculado. Servindo o .br de disco, o ETag e do
# arquivo servido: medido em 5 de 5 rotas, ETag sem W/ e If-None-Match devolvendo
# 304.
#
# IDEMPOTENTE: so recomprime o que ficou mais novo que o proprio .br, entao o
# custo em deploy sem mudanca de conteudo e proximo de zero. Lote completo
# (10.370 arquivos) leva 3m20s com 4 jobs.
step "2.5/7 pre-comprimindo o acervo (brotli estatico)"
if [ -x tools/generate-brotli-static ]; then
	tools/generate-brotli-static --jobs 4 2>&1 | tail -3 | sed 's/^/  /' ||
		echo "  ATENCAO: pre-compressao falhou; o nginx cai na compressao dinamica (mais lenta, ETag fraco)"
else
	echo "  tools/generate-brotli-static ausente — pulado"
fi

