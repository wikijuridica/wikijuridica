step "2.6/7 regenerando o indice de percursos por fundamento legal"
if percursos_saida=$(./tools/go-modern run ./cmd/generate-legal-cocitation 2>&1); then
	printf '%s\n' "$percursos_saida" | tail -3 | sed 's/^/  /'
else
	printf '%s\n' "$percursos_saida" | tail -5 | sed 's/^/  /'
	echo "  AVISO: indice de percursos nao regenerado; a gemea .md serve o indice anterior"
	echo "  (o filtro anti-404 do servidor descarta destino nao-servivel, entao nao ha link morto)"
fi

# --- 2.7. espelho de temas da rede social --------------------------------------
#
# POR QUE AQUI: toda pagina publicada sai com a ancora do seu tema
# (`/redesocial/tema/{area}/{slug}/`, cobrada por check-ancora-redesocial), e o
# link e derivado da ROTA. O tema so passa a existir quando este comando espelha
# o published_manifest no banco social. Publicar sem semear anuncia ao crawler
# uma URL que devolve 404 -- e o proprio portal manda o bot para o vazio.
#
# MEDIDO EM 2026-09-10, e foi o que trouxe este passo para ca: o banco tinha
# 10.141 temas para 11.039 paginas publicadas. As 898 paginas sem tema geraram
# 1.161 requisicoes 404 de bots valiosos em 10 dias (GPTBot 817, PerplexityBot
# 339, em 817 caminhos distintos de /redesocial/tema/jurisprudencia/), lidas em
# data/ops/access/nginx-2026-09-*.jsonl. Nao era rota privada nem scanner.
#
# O COMANDO NAO REMOVE NADA: `PlanejaEspelho` so tem Inserir e Atualizar, e tema
# orfao (pagina supersedida) e RELATADO, nunca apagado -- ele guarda respostas e
# follows. Ordem do dono de 2026-09-10: se tem URL, tem conteudo; nunca excluir.
#
# POR QUE ANTES DO PASSO 3: o cmd/social le a tabela ao vivo (medido: URL nova
# responde 200 sem restart), entao o tema fica de pe antes de a borda ser
# aquecida no passo 6 -- se fosse depois, a borda cachearia o 404 por ate 1 h.
#
# NAO ABORTA O DEPLOY, e a degradacao e honesta: sem semeadura as paginas novas
# ficam com a ancora apontando para 404 ate a proxima passada, que e exatamente
# o estado anterior a este passo. Derrubar uma publicacao inteira por isso
# trocaria um problema pequeno por um grande. O gate abaixo deixa o numero no
# log para quem le o deploy.
step "2.7/7 espelhando os temas da rede social"
if temas_saida=$(./tools/go-modern run ./cmd/generate-social-temas --aplicar 2>&1); then
	printf '%s\n' "$temas_saida" | tail -3 | sed 's/^/  /'
else
	printf '%s\n' "$temas_saida" | tail -5 | sed 's/^/  /'
	echo "  AVISO: espelho de temas NAO atualizado; paginas novas anunciam tema que devolve 404"
	echo "  (rode ./tools/go-modern run ./cmd/generate-social-temas --aplicar e confira com"
	echo "   ./tools/check-social-temas-espelhados)"
fi
if ! espelho_saida=$(./tools/check-social-temas-espelhados 2>&1); then
	printf '%s\n' "$espelho_saida" | tail -6 | sed 's/^/  /'
fi

step "3/7 parando o servico (e o socket)"
# O SOCKET PARA JUNTO, e a ordem nao e estilo. Desde 2026-09-01 o 127.0.0.1:8089
# pertence a wikijuridica-server.socket (ops/systemd/): e o systemd quem o
# mantem em LISTEN, e o servico so herda o descritor. E isso que fecha a janela
# de 502 dos restarts (1.435 respostas em 26-28/08, 12 s de ECONNREFUSED por
# restart) — mas tem um preco exatamente AQUI: `systemctl stop $SERVICE`
# sozinho deixa o socket aceitando, e a PRIMEIRA conexao que chegar durante os
# passos 3-5 reativa o servico com o binario que estiver em bin/ naquele
# instante — o VELHO, antes do cp abaixo. Ai o cp falha com "Text file busy",
# que e o defeito que este passo existe para evitar. Parar o socket derruba os
# dois (Requires= na unit do servico) e fecha a porta ate o passo 5; a janela
# do deploy fica como sempre foi, a dos restarts some.
sudo -n systemctl stop "$SERVICE.socket" "$SERVICE" 2>/dev/null || {
	echo "  sem sudo nao-interativo. Rode voce mesmo, nesta ordem:"
	echo "     sudo systemctl stop $SERVICE.socket $SERVICE"
	echo "     rm -rf $CACHE_DIR && mkdir -p $CACHE_DIR"
	echo "     mv bin/wikijuridica-server.next bin/wikijuridica-server"
	echo "     sudo systemctl start $SERVICE.socket $SERVICE"
	exit 1
}

# --- 4. cache ----------------------------------------------------------------
step "4/7 limpando os caches (Go e nginx)"
CACHE_ANTES=$(du -sh "$CACHE_DIR" 2>/dev/null | cut -f1 || echo 0)
rm -rf "$CACHE_DIR" && mkdir -p "$CACHE_DIR"
echo "  descartados: ${CACHE_ANTES:-0} de respostas geradas antes desta versao"
# CACHE DE ORIGEM DO NGINX (2026-09-02): var/nginx/cache guarda a ultima resposta
# boa de cada rota dinamica (proxy_cache wj_dyn em @markdown/@fallback) para
# servir STALE quando o Go cai. Depois de republicar, o objeto guardado e a
# versao ANTERIOR do texto — precisa sair junto com o cache do Go, senao a
# gemea Markdown serviria texto velho ate o TTL. Os workers do nginx rodam
# como o usuario da unit; a limpeza e por conteudo, o diretorio fica.
NGINX_CACHE_DIR="${WIKI_NGINX_CACHE_DIR:-var/nginx/cache}" # relativo: o script ja fez cd para a raiz
# So quando o TEXTO pode ter mudado (republicacao). Num deploy --sem-republicar
# o objeto guardado continua correto, e e exatamente ele que serve STALE aos
# bots durante a troca do binario (passos 3-5): apagar aqui devolveria o 503
# que o cache existe para evitar.
if [ "$REPUBLICAR" = "1" ] && [ -d "$NGINX_CACHE_DIR" ]; then
	NGINX_CACHE_ANTES=$(find "$NGINX_CACHE_DIR" -type f 2>/dev/null | wc -l)
	find "$NGINX_CACHE_DIR" -mindepth 1 -delete 2>/dev/null || sudo -n find "$NGINX_CACHE_DIR" -mindepth 1 -delete 2>/dev/null || true
	echo "  cache de origem do nginx: ${NGINX_CACHE_ANTES:-0} objeto(s) descartado(s)"
fi

# O SEGUNDO cache, descoberto em 2026-08-06 e tao invisivel quanto o primeiro.
#
# O nginx.conf global deste host declara `open_file_cache max=900000
# inactive=900s` (linha 1944, herdado do hardening do projeto vizinho). O cache
# e renovado a cada acesso: pagina com trafego continuo mantem indefinidamente o
# descritor e o tamanho ANTIGOS. Medido logo apos uma republicacao: arquivo em
# disco com 19.855 bytes, nginx entregando 19.639 — o HTML da versao anterior,
# nas paginas mais acessadas, que sao as que mais importam.
#
# CORRIGIDO EM 2026-08-13. O paragrafo acima justificava um `systemctl restart
# nginx` a cada deploy com a frase "o restart do nginx e instantaneo". MEDIDO:
# nao e. `systemctl show nginx` -> ExecStop=start-stop-daemon --retry QUIT/5 e
# TimeoutStopUSec=5s; o journal de 12/08 registra OITO restarts, cada um com 8 a
# 9 SEGUNDOS entre "Stopping" e "Started", dois deles terminando em "Stopping
# timed out. Terminating." + "Failed with result 'timeout'". Durante a janela o
# cloudflared devolve 502 sem retry por requisicao:
#
#   17:43:27 ERR failed to serve incoming request ... dial tcp 127.0.0.1:8088:
#            connect: connection refused
#
# E a premissa tambem caiu: `open_file_cache_valid 5s` (wikijuridica.conf:334) ja
# limita a janela de HTML velho a ~5 s, contra os 900 s do default herdado do
# host. Nao ha frescor a "garantir" que justifique derrubar o ingress.
#
# TRES SAIDAS, decididas pelo fingerprint POR COMPONENTE calculado adiante:
#
#   ingress mudou     -> `nginx -t` + RELOAD, com a aplicacao PROVADA (ver abaixo).
#   ingress intacto   -> NAO TOCAR. Deploy de conteudo e arquivo em disco; o
#                        nginx le por requisicao e revalida em 5 s.
#   (binario Go)      -> tratado nos passos 3 e 5; nada a ver com o nginx.
#
# E POR QUE ISTO E O PRIMEIRO ITEM DA ORDEM DE EXECUCAO: `systemctl restart`
# INICIA uma unit `disabled` (disable != mask). Enquanto esta linha existir,
# desativar o nginx do host faz o proximo deploy RESSUSCITA-LO — ou colidir na
# porta com a instancia dedicada — e o smoke passaria mentindo nos dois casos.
if [ "$INGRESS_MUDOU" -eq 1 ] && { command -v nginx >/dev/null 2>&1 || [ -d /etc/nginx ]; }; then
	# GATE, e nao aviso. Ate 2026-08-12 este bloco tratava falha como AVISO e
	# seguia — o modo de falha mais traicoeiro que um deploy pode ter: os
	# workers ANTIGOS continuam atendendo com a config velha, entao o smoke do
	# passo 7/7 passa (o site esta no ar!) e o deploy anuncia NO AR uma mudanca
	# que nunca entrou.
	#
	# `nginx -t` vem ANTES porque config invalida derruba o ingress (o vhost e
	# symlink para dentro deste repo, entao salvar o arquivo ja muda o que o
	# nginx le). Abortar o deploy e sempre melhor que recarregar com sintaxe
	# quebrada.
	# SEM sudo, de proposito (2026-09-02): o `-t` como root cria/re-atribui os
	# diretorios de temp e cache do prefixo ao usuario da diretiva `user` — foi
	# assim que var/nginx/cache voltou a nobody e o canal de maquina respondeu
	# 500 por 12 min. A unit roda como rafael e o ExecStartPre dela ja faz o
	# `-t` sem privilegio: e o mesmo teste, com o mesmo usuario.
	/usr/sbin/nginx -c "$NGINX_CONF" -p "$NGINX_PREFIX" -t >/dev/null 2>&1 ||
		fail "'nginx -t' reprovou $NGINX_CONF. NADA foi recarregado. Rode: /usr/sbin/nginx -c $NGINX_CONF -p $NGINX_PREFIX -t"

	# RELOAD PROVADO, nao presumido. `nginx -s reload` manda SIGHUP e sai 0
	# ANTES de o master aceitar a config: uma config que passa no `-t` isolado e
	# e recusada em runtime (mudar o tamanho de um limit_req_zone, por exemplo)
	# deixaria os workers antigos servindo, com exit code verde. A prova e a
	# ausencia de [emerg]/[alert] no error log DEPOIS do sinal.
	# O ERROR LOG DO NOSSO INGRESSO, nao o do vizinho. O standalone declara
	# `error_log /var/log/nginx/wikijuridica/error.log` (linha 31), e a prova de
	# que o reload foi ACEITO e a ausencia de [emerg]/[alert] ali. Vigiar
	# /var/log/nginx/error.log -- o do sistema -- deixaria a prova sempre verde,
	# porque nada nosso escreve nele.
	ERRO_LOG="${WIKI_NGINX_ERROR_LOG:-/var/log/nginx/wikijuridica/error.log}"
	MARCA_ANTES=$([ -r "$ERRO_LOG" ] && wc -c <"$ERRO_LOG" 2>/dev/null || echo 0)
	sudo -n systemctl reload "$NGINX_UNIT" 2>/dev/null ||
		fail "nginx nao recarregou (unit $NGINX_UNIT). Os workers antigos seguem com a config VELHA e o smoke passaria mentindo. Ver: journalctl -u $NGINX_UNIT -n 30"
	if [ -r "$ERRO_LOG" ]; then
		NOVOS_ERROS=$(sudo -n tail -c +$((MARCA_ANTES + 1)) "$ERRO_LOG" 2>/dev/null | grep -cE '\[(emerg|alert)\]' || true)
		[ "${NOVOS_ERROS:-0}" -gt 0 ] &&
			fail "reload aceito pelo systemd mas RECUSADO pelo nginx ($NOVOS_ERROS erro(s) [emerg]/[alert] em $ERRO_LOG). Os workers antigos seguem com a config VELHA."
	fi
	echo "  ingress mudou: nginx validado (nginx -t) e RECARREGADO sem downtime (unit $NGINX_UNIT)"
else
	echo "  ingress intacto: nginx NAO foi tocado (arquivo estatico e lido por requisicao)"
fi

if [ "$REBUILD" = "1" ] && [ -f bin/wikijuridica-server.next ]; then
	# A TROCA E POR `mv`, NAO POR `cp` — e a diferenca derrubou um deploy.
	#
	# ★ MEDIDO EM 2026-09-16
	#
	# `cp` abre o DESTINO para escrita e escreve no lugar. Sobre um binario que
	# algum processo esta EXECUTANDO, o kernel devolve ETXTBSY: "Area de texto
	# ocupada". Foi o que aconteceu: o passo 3/7 para o servico, o passo 4/7
	# limpa 41 MB de cache e 22.691 objetos do nginx — e nessa janela a unit,
	# que e ATIVADA POR SOCKET, volta sozinha na primeira requisicao. No passo
	# 5/7 o binario ja estava em execucao de novo e o `cp` falhou, abortando o
	# deploy DEPOIS de republicar o acervo.
	#
	# `mv` dentro do mesmo sistema de arquivos e `rename(2)`: troca a entrada de
	# diretorio e nao toca no inode antigo. O processo que ja esta rodando segue
	# com o inode velho ate ser reiniciado — que e exatamente o que o passo
	# seguinte faz — e a troca nunca da ETXTBSY.
	#
	# A prova de que isto e assimetria e nao escolha: a troca do binario da rede
	# social, 17 linhas abaixo, sempre usou `mv`. Duas linhas, o mesmo ato, dois
	# comportamentos sob carga.
	#
	# O backup continua por `cp`, e esta certo: ali o binario velho e a ORIGEM
	# da copia, nao o destino.
	cp bin/wikijuridica-server bin/wikijuridica-server.anterior 2>/dev/null
	mv bin/wikijuridica-server.next bin/wikijuridica-server || fail "troca do binario"
	echo "  binario trocado (anterior preservado em bin/wikijuridica-server.anterior)"
fi

# TROCA E RESTART DA REDE SOCIAL.
#
# A ORDEM E binario -> socket -> servico, e ela nao se inverte: socket
# `Type=notify` reativado com binario que ignora LISTEN_FDS faz bind proprio,
# toma EADDRINUSE e entra em laco de 5 s com a porta em LISTEN -- 504 para
# quem estiver na pagina. Aqui o socket ja esta ativo, entao a ordem se cumpre
# trocando o arquivo ANTES do restart.
#
# `mv` e nao `cp`: sobrescrever binario em execucao devolve ETXTBSY ("Text file
# busy"), que ja abortou um deploy em 06/08. O rename troca o inode e o
# processo vivo segue com o antigo ate o restart.
if [ "$REBUILD" = "1" ] && [ -f bin/wikijuridica-social.next ]; then
	cp bin/wikijuridica-social bin/wikijuridica-social.anterior 2>/dev/null
	mv bin/wikijuridica-social.next bin/wikijuridica-social || fail "troca do binario da rede social"
	sudo -n systemctl restart "$SERVICE_SOCIAL.service" ||
		fail "restart da rede social (rode: sudo systemctl restart $SERVICE_SOCIAL.service)"
	# PROVA, e nao espera: /readyz do social confere as dependencias dele.
	timeout 30 bash -c "until curl -s -o /dev/null --max-time 2 \
        -A 'wikijuridica-superficie-probe/1.0' -H 'X-Warming-Request: true' \
        $LOCAL_ADDR_SOCIAL/readyz; do sleep 0.5; done" ||
		fail "a rede social nao respondeu em 30s: journalctl -u $SERVICE_SOCIAL -n 40"
	echo "  rede social trocada e reiniciada (anterior em bin/wikijuridica-social.anterior)"
fi

# --- 5. subir ----------------------------------------------------------------
step "5/7 subindo o socket e o servico"
# Socket primeiro (Requires= ja o subiria; explicito e legivel). Com Type=notify
# o `start` so retorna depois do READY=1 que o binario manda APOS o listen
# (cmd/server/main.go, notificaPronto) — ate 600 s (TimeoutStartSec) —, entao o
# laco de curl abaixo passou a ser PROVA, nao espera: ele confirma que o que
# atende e HTTP, nao so um READY.
sudo -n systemctl start "$SERVICE.socket" "$SERVICE" || fail "start do socket/servico"
timeout 30 bash -c "until curl -s -o /dev/null --max-time 2 $LOCAL_ADDR/; do sleep 0.5; done" ||
	fail "o servidor nao respondeu em 30s. Provavel reprovacao do publishedmanifest.Validate no boot: journalctl -u $SERVICE -n 40"

# AQUECIMENTO DO CACHE DE ORIGEM (2026-09-03). O passo 4 apagou var/nginx/cache
# quando houve republicacao, e a zona `wj_dyn` so protege o canal de maquina
# contra queda do Go se tiver objeto guardado. Aqui ele volta a ficar cheio, com
# trafego de loopback marcado como aquecimento — antes de a borda ser purgada
# (passo 6), para que o reaquecimento de borda ja encontre a origem quente.
# Falha aqui NAO derruba o deploy: o portal esta no ar e o cache se enche sozinho
# sob demanda; o aviso fica no log e o timer proprio tenta de novo em ate 3 h.
step "5b/7 aquecendo o cache de origem (gemeas e descritores)"
if com_batida_no_lock tools/warm-origin-cache --rps 80 --concorrencia 8 2>&1 | sed 's/^/  /'; then
	:
else
	echo "  AVISO: aquecimento do cache de origem nao concluiu (exit $?); o timer wikijuridica-origin-warm tenta de novo"
fi
# --- 6. cache de borda -------------------------------------------------------
step "6/7 descartando o cache de borda (Cloudflare)"
# PURGA SELETIVA, a partir do MESMO diff que data as paginas.
#
# Ate 2026-08-07 este passo mandava purge_everything a cada publicacao: para
# corrigir 20 paginas, jogava fora o cache das outras 9.602 que nao mudaram, e
# o acervo inteiro voltava frio para o crawler. tools/generate-page-content-
# revision compara o hash do CONTEUDO de cada rota com o registro anterior e
# imprime so o que mudou; purge-edge-cache lote de 100 em 100 e cai para purga
# total sozinho acima do teto, quando enumerar sai mais caro. Lista vazia
# significa que nenhuma pagina mudou — nao ha o que purgar, e purgar assim
# mesmo seria so desperdicio.
#
# O NUMERO ERA 30 E ESTAVA ERRADO, com "limite duro da API" escrito ao lado.
# A doc da Cloudflare (developers.cloudflare.com/cache/how-to/purge-cache/,
# secao "Availability and limits", lida em 2026-08-19) da "Max operations per
# request" = 100 para single-file purge em TODOS os planos menos Enterprise,
# que tem 500. Purgar de 30 em 30 nao quebrava nada — so gastava 4 requisicoes
# onde 2 bastavam, e o comentario transformava um chute em fato citavel, que e
# a parte cara: o proximo a ler acreditaria no numero em vez de conferir.
# purge-edge-cache foi corrigido para 100 no mesmo dia.
PURGE_ALVOS="$(mktemp)"
# Lista SEPARADA para a purga: paginas alteradas MAIS os artefatos de
# descoberta. O PURGE_ALVOS continua sendo so as paginas porque o IndexNow, mais
# abaixo, le esse mesmo arquivo — e submeter /robots.txt ou /sitemap.xml ao
# protocolo gastaria cota anunciando o que nao e conteudo.
PURGE_TODOS="$(mktemp)"
trap 'rm -f "$DEPLOY_LOCK" "$PURGE_ALVOS" "$PURGE_TODOS" "${AQUECER_LISTA:-}"' EXIT INT TERM
if tools/generate-page-content-revision --purge-targets >"$PURGE_ALVOS" 2>/dev/null; then
	ALVOS_N="$(wc -l <"$PURGE_ALVOS" | tr -d ' ')"
else
	ALVOS_N=""
fi

# MUDANCA DE CAMADA TAMBEM EXIGE PURGA — e ela nao aparece no diff de conteudo.
#
# A purga seletiva acima e decidida pelo hash do CONTEUDO de cada rota. Isso
# cobre "a pagina mudou" e nao cobre "a RESPOSTA mudou": corrigir um redirect,
# um header, uma politica de cache ou o proprio render altera o que o visitante
# recebe sem alterar uma linha de conteudo, entao ALVOS_N sai zero e nada e
# purgado.
#
# Medido em 2026-08-12, depois de corrigir a barra final: a origem ja devolvia
# 301 em /familia e /previdenciario e a borda continuava servindo 200 HIT do
# corpo antigo. Ate 08-12 isso durava no maximo 12h; com o Edge TTL agora em 7
# DIAS, uma correcao de rota podia ficar invisivel por uma semana.
#
# O detector e o hash das duas fontes que decidem a resposta sem passar pelo
# conteudo: o binario que sera instalado e o vhost do nginx. O estado fica em
# data/ops/, e a PRIMEIRA execucao (sem estado anterior) purga tudo de
# proposito — nao ha como saber o que mudou desde um passado que nao foi
# registrado, e supor que nada mudou seria a suposicao errada.
# --- purga por camada: o que um binario novo muda, e so isso -----------------
#
# ATE 2026-09-09 "binario mudou (ingress intacto)" purgava TUDO: tres purgas
# totais num dia, cada uma jogando fora 1.644 s de reaquecimento de 12.331
# URLs, para uma mudanca que nao toca o HTML estatico de public/. Binario novo
# do servidor muda o que o GO SERVE: descritores, lote, texto integral, gemeas
# (inclusive /index.md e /{area}/index.md, s-maxage de 7 dias) — o conjunto
# que tools/warm-origin-cache --listar-rotas imprime e que deploy-binario-go ja
# purga em producao ("purgar tudo jogaria fora o cache das ~10 mil paginas HTML
# que este deploy nao mudou"). Binario novo do social muda o HTML de
# /redesocial/ e dos temas (s-maxage=3600), que tambem nao existem em public/.
#
# "Tudo" fica para o que muda a RESPOSTA de toda rota sem mudar conteudo:
# config do ingress, camada sem registro anterior e revisao indisponivel.
# Excecao conhecida, para ninguem redescobrir: o HTML sob demanda do @fallback
# (rota conhecida sem arquivo em public/) so existe em buraco de release e nao
# entra na lista. /painel/ e 404 pelo tunel e nunca esta na borda.
#
# modo_de_purga_da_camada ALVOS_N INGRESS_MUDOU CAMADA_ANTERIOR
#   imprime "tudo:<motivo>" ou "lista".
modo_de_purga_da_camada() {
	local alvos_n="$1" ingress_mudou="$2" camada_anterior="$3"
	if [ -z "$alvos_n" ]; then
		echo "tudo:registro de revisao indisponivel"
	elif [ -z "$camada_anterior" ]; then
		echo "tudo:camada de servico sem registro anterior"
	elif [ "$ingress_mudou" -eq 1 ]; then
		echo "tudo:config do ingress mudou — a RESPOSTA muda sem o conteudo mudar"
	else
		echo "lista"
	fi
}

# As duas fontes da lista dinamica, uma por binario. Funcoes de uma linha para
# o teste substituir por dubles sem tocar na rede.
rotas_dinamicas_do_servidor() { tools/warm-origin-cache --listar-rotas; }
# INVALIDAR A ORIGEM ANTES DE PURGAR A BORDA — a ordem e o produto (2026-09-16).
#
# Ate hoje esta transacao purgava a borda e NUNCA tocava no cache de origem do
# nginx (zona wj_dyn: gemea, /api/v1/*, descritores, s-maxage de SETE DIAS). O
# passo 5 AQUECE a origem, e aquecer e um GET que recebe HIT do objeto anterior:
# nada se renova. O efeito e pior que nao purgar -- a borda purgada vai a origem
# no primeiro MISS e volta com o corpo de ANTES da publicacao, agora com sete
# dias de vida pela frente.
#
# MEDIDO EM 2026-09-16, nas 129 rotas carimbadas nas 24 h: 125 gemeas velhas na
# borda contra 0 no HTML, todas com `age` ~12,2 ks -- a idade da propria
# publicacao. O controle, numa rota nomeada: purgar so a borda de
# /noticias/index.md devolveu MISS em 1,11 s com o corpo ANTIGO; invalidar a
# origem primeiro e purgar devolveu MISS em 1,03 s com o corpo do Go.
#
# A lista INTEIRA vai para a ferramenta: rota sem objeto na zona e no-op, e
# /api/v1/citar/<rota>, /llms.txt e as gemeas estao todos la. A varredura da
# zona e UMA por chamada (1,35 s para 24.933 objetos, medido em modo seco),
# nao uma por rota.
#
# ALCANCE, PARA QUEM FOR MEXER: no ramo em que o BINARIO mudou, PURGE_TODOS
# carrega as ~11.268 rotas dinamicas, e a invalidacao tira ~22.409 objetos de
# uma zona de ~25.000 (medido em seco, 2026-09-16). Ate o reaquecimento
# dirigido terminar (12 r/s), o `use_stale` do canal de maquina fica sem
# lastro -- a MESMA janela que `deploy-binario-go` ja abre por desenho entre
# os passos 6 e 8. E uma troca deliberada: a alternativa medida e a borda
# servir o corpo de antes da publicacao por ate sete dias.
invalida_origem_da_lista() { # $1 = arquivo com uma rota por linha
	tools/purge-origin-cache --de-arquivo "$1"
}
# Chamada com relatorio indentado e sem engolir o exit real (o `cmd | sed` do
# passo 5 le o exit do sed, nao o do comando).
invalida_origem_relatando() { # $1 = arquivo com uma rota por linha
	local saida codigo
	saida="$(invalida_origem_da_lista "$1" 2>&1)"
	codigo=$?
	printf '%s\n' "$saida" | sed 's/^/  /'
	if [ "$codigo" -ne 0 ]; then
		echo "  AVISO: invalidacao do cache de ORIGEM saiu $codigo -- objeto que resistiu na zona"
		echo "         ou varredura que nao fechou. A purga da borda segue, mas o primeiro MISS"
		echo "         pode trazer o corpo anterior de volta: rode"
		echo "         tools/purge-origin-cache --de-arquivo <lista> e confira restantes=0."
	fi
	return 0
}
# O sitemap do social e um INDICE (sitemapindex -> /redesocial/sitemap/superficie.xml,
# 37 rotas de superficie em 2026-09-09) e os 10.141 temas NAO estao nele: vem do
# banco. Ler so o indice devolveria 2 linhas e passaria na guarda -- sub-purga
# em silencio, apanhada na revisao do 829805e9.
baixa_sitemap_social() { # $1 = caminho absoluto do XML
	curl -sf -A 'wikijuridica-superficie-probe/1.0' -H 'X-Warming-Request: true' \
		"http://127.0.0.1:${SOCIAL_PORT:-8091}$1"
}
locs_do_xml() { grep -o '<loc>[^<]*' | sed 's|<loc>https\{0,1\}://[^/]*||'; }
rotas_de_superficie_do_social() {
	local loc
	for loc in $(baixa_sitemap_social /redesocial/sitemap.xml | locs_do_xml); do
		case "$loc" in
		*.xml) baixa_sitemap_social "$loc" | locs_do_xml ;;
		*) echo "$loc" ;;
		esac
	done
}
temas_do_social() {
	sqlite3 -readonly var/social/social.db "select '/redesocial/tema' || caminho from temas order by caminho;" 2>/dev/null
}
rotas_dinamicas_do_social() {
	local superficie temas
	superficie="$(rotas_de_superficie_do_social)"
	temas="$(temas_do_social)"
	# Guarda por TAMANHO, nao por "nao vazio": superficie tem dezenas, temas tem milhares.
	[ "$(printf '%s\n' "$superficie" | grep -c .)" -ge 10 ] || return 1
	[ "$(printf '%s\n' "$temas" | grep -c .)" -ge 100 ] || return 1
	printf '%s\n' "/redesocial/" "$superficie" "$temas" | grep . | sort -u
}

# lista_dinamica_da_camada BIN_MUDOU SOCIAL_MUDOU
#   imprime as rotas que o(s) binario(s) novo(s) mudam na borda; vazio quando
#   nenhum binario mudou. Falha (exit 1) se um lister nao devolver nada: purgar
#   sem a lista deixaria rota dinamica velha por ate 7 dias.
lista_dinamica_da_camada() {
	local bin_mudou="$1" social_mudou="$2" lista
	if [ "$bin_mudou" -eq 1 ]; then
		lista="$(rotas_dinamicas_do_servidor)"
		[ -n "$lista" ] || return 1
		printf '%s\n' "$lista"
	fi
	if [ "$social_mudou" -eq 1 ]; then
		lista="$(rotas_dinamicas_do_social)" || return 1
		[ "$(printf '%s\n' "$lista" | grep -c .)" -ge 100 ] || return 1
		printf '%s\n' "$lista"
	fi
	return 0
}
# --- fim da purga por camada ---

# O TERCEIRO cache da cadeia. Republicar deixa o disco certo, mas o visitante
# continua recebendo a versao anterior enquanto a borda guardar a resposta
# antiga: em 2026-08-06 a home consertada so apareceu depois que o titular
# purgou a mao. Passo manual esquecido e deploy pela metade.
MODO_DE_PURGA="$(modo_de_purga_da_camada "$ALVOS_N" "$INGRESS_MUDOU" "$CAMADA_ANTERIOR")"
if [ "${MODO_DE_PURGA%%:*}" = "tudo" ]; then
	echo "  purgando tudo: ${MODO_DE_PURGA#*:}${ALVOS_N:+ (nao so as $ALVOS_N que mudaram de conteudo)}"
	if tools/purge-edge-cache; then
		# REAQUECER AQUI, e nao esperar o timer. A purga total deixa as 9.835
		# URLs frias de uma vez, e o timer do aquecedor roda de doze em doze
		# horas desde 2026-09-09 (04:20 e 16:20 UTC; antes, de quatro em quatro,
		# e cinco das seis passadas achavam menos de 50 frios em ~10.300 HEADs).
		# O pior caso medido era 4 h de espera
		# mais 20,5 min de varredura: quatro horas e meia com o acervo INTEIRO
		# exposto a 530 se o tunel oscilar, porque URL fora do cache nao tem de
		# onde ser servida quando a origem nao responde.
		#
		# A 25 r/s (padrao novo, metade do teto de 50/s da zona) a varredura leva
		# ~6,6 min, e comeca agora em vez de daqui a ate quatro horas.
		#
		# Falha aqui NAO derruba o deploy: a publicacao ja esta correta no disco
		# e na borda; cache frio e degradacao de resiliencia, nao corrupcao. O
		# timer reaquece na proxima janela de qualquer forma.
		# --rps EXPLICITO, e nao o default da ferramenta.
		#
		# Esta chamada nao passava ritmo nenhum e herdava o default de 25 r/s,
		# QUATRO VEZES o ritmo do timer (ops/systemd/wikijuridica-edge-warm.service
		# usa `--rps 6 --concorrencia 4`). Duas consequencias medidas em 08-12:
		# 16 varreduras num dia, 98.884 requisicoes, e o acervo inteiro entrando
		# e saindo do cache EM BLOCO — a amostra de borda daquele dia mostrava
		# `Age` identico em todas as paginas conferidas.
		#
		# Cache que expira em bloco produz tempestade de MISS na origem quando o
		# TTL vence, exatamente o oposto do que o aquecimento existe para evitar.
		# 12 r/s e o meio-termo declarado: metade do default antigo, o dobro do
		# timer, varredura completa em ~14 min.
		# ORCAMENTO DERIVADO DO TRABALHO, nao constante magica. O teto de 900s
		# foi escolhido quando o ritmo era outro; com os 12 r/s declarados acima e
		# o acervo de hoje ele passou a encostar: medido em 13/08, a varredura
		# levou 829s de 900 -- 92% do orcamento, 71 segundos de folga. Uma
		# oscilacao de latencia mata o aquecimento no meio, e o deploy so emite um
		# aviso; o acervo fica frio e ninguem fica sabendo.
		#
		# A conta e a mesma que este script ja faz para o ingest: URLs / ritmo,
		# com margem explicita. 1,6x cobre a subida do pacer, o HEAD do --so-frios
		# e a variacao de latencia da travessia; o piso de 300s protege o acervo
		# pequeno e o teto de 3600s impede que um erro de conta trave o deploy
		# para sempre.
		AQUECER_URLS="$(grep -ho '<loc>' public/sitemaps/*.xml 2>/dev/null | wc -l | tr -d ' ')"
		[ "${AQUECER_URLS:-0}" -gt 0 ] 2>/dev/null || AQUECER_URLS=10000
		AQUECER_ORCAMENTO=$((AQUECER_URLS * 16 / 10 / 12))
		[ "$AQUECER_ORCAMENTO" -lt 300 ] && AQUECER_ORCAMENTO=300
		[ "$AQUECER_ORCAMENTO" -gt 3600 ] && AQUECER_ORCAMENTO=3600
		echo "  reaquecendo a borda a 12 r/s ($AQUECER_URLS URLs, orcamento ${AQUECER_ORCAMENTO}s)"
		if com_batida_no_lock timeout "$AQUECER_ORCAMENTO" tools/warm-edge-cache --rps 12 --concorrencia 4; then
			:
		else
			echo "  AVISO: reaquecimento nao concluiu; o acervo fica frio ate o proximo timer."
		fi
	else
		echo "  AVISO: cache de borda NAO foi purgado — o dominio publico pode servir a versao anterior."
		echo "         a purga usa CLOUDFLARE_ZONE_TOKEN (Bearer de zona); confira-o em .env.local,"
		echo "         com CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN (Global API Key) como fallback."
	fi
elif [ "$ALVOS_N" = "0" ] && [ "$BIN_MUDOU" -eq 0 ] && [ "$SOCIAL_MUDOU" -eq 0 ]; then
	# A mensagem NAO afirma mais que "o cache das N rotas foi preservado".
	#
	# Medido em 2026-08-07: a zona nao tem regra de cache (o phase
	# http_request_cache_settings nao tem entrypoint) e todo HTML volta com
	# cf-cache-status: DYNAMIC. Nao ha cache de HTML na borda para preservar, e
	# dizer que ha e afirmar sucesso sobre algo que nao aconteceu — a mesma
	# classe de defeito que o registro de purga com scope "tudo" e success true
	# ja produzia. A purga segue existindo e sendo correta para o que a borda de
	# fato guarda (estatico), so nao promete o que nao entrega.
	#
	# MAS "nenhuma pagina mudou" NAO QUER DIZER "nada mudou". Ate 2026-08-13
	# este ramo saia sem purgar coisa nenhuma, e por isso um deploy que altera
	# SOMENTE robots.txt ou o sitemap deixava a borda servindo a copia anterior
	# ate o TTL de sete dias virar. Foi assim que o robots.txt com Content-Signal
	# sobreviveu dias a propria correcao, com o Bing acusando erro de sintaxe o
	# tempo todo. Os artefatos de descoberta tem impressao propria agora, e
	# quando ela muda eles sao purgados mesmo sem uma unica pagina ter mudado.
	if [ "$ARTEFATOS_MUDOU" -eq 1 ]; then
		ARTEFATOS_DESCOBERTA="$(tools/warm-edge-cache --listar-artefatos 2>/dev/null)"
		[ -n "$ARTEFATOS_DESCOBERTA" ] ||
			fail "nao consegui ler a lista de artefatos de descoberta (tools/warm-edge-cache --listar-artefatos). Purgar sem ela deixaria artefato velho quente na borda."
		: >"$PURGE_TODOS"
		for artefato in $ARTEFATOS_DESCOBERTA; do
			echo "$artefato" >>"$PURGE_TODOS"
		done
		for shard in public/sitemaps/*.xml; do
			[ -e "$shard" ] && echo "/sitemaps/$(basename "$shard")" >>"$PURGE_TODOS"
		done
		tools/check-sitemap-shard-grace --listar-removidos >>"$PURGE_TODOS" 2>/dev/null || true
		ARTEFATOS_N="$(wc -l <"$PURGE_TODOS" | tr -d ' ')"
		echo "  nenhuma pagina mudou, mas os artefatos de descoberta mudaram — purgando $ARTEFATOS_N"
		invalida_origem_relatando "$PURGE_TODOS"
		tools/purge-edge-cache --de-arquivo "$PURGE_TODOS" || {
			echo "  AVISO: cache de borda NAO foi purgado — robots.txt/sitemap podem ficar ate 7 dias defasados na borda."
			echo "         a purga usa CLOUDFLARE_ZONE_TOKEN (Bearer de zona); confira-o em .env.local,"
			echo "         com CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN (Global API Key) como fallback."
		}
	else
		echo "  nenhuma pagina mudou de conteudo — nada a purgar"
	fi
else
	# OS ARTEFATOS DE DESCOBERTA VAO JUNTO DAS PAGINAS.
	#
	# Ate 2026-08-12 a purga seletiva mandava so as ROTAS que mudaram de
	# conteudo, e nenhum dos artefatos entrava. Medido no dominio vivo neste
	# dia: /feed.xml, /sitemap.xml, /robots.txt e /llms.txt responderam os
	# quatro cf-cache-status: HIT com age de 11.942s (~3h19) — a borda guardava
	# a versao anterior de todos eles.
	#
	# O PREJUIZO NAO E COSMETICO: o hub WebSub busca /feed.xml quando e avisado.
	# Com o feed velho na borda, o hub le a versao sem os itens novos, e a
	# publicacao so chega aos assinantes quando o TTL virar — horas depois, em
	# vez de minutos. O sitemap tem o mesmo defeito para o crawler: anunciar
	# lastmod novo e servir XML velho ensina o buscador a nao confiar no aviso.
	#
	# Eles mudam a CADA publicacao que altera pagina (o feed lista os itens, o
	# sitemap e os shards as datas, o llms.txt o acervo), entao pertencem a
	# toda purga que ja tem pagina alterada. A lista espelha ARTEFATOS de
	# tools/warm-edge-cache, que ja os aquecia — aquecer e nao purgar era
	# justamente o que mantinha a copia velha quente.
	cat "$PURGE_ALVOS" >"$PURGE_TODOS"
	# FONTE UNICA, nao copia. Ate 2026-08-12 esta era uma lista literal, e o
	# comentario acima ja afirmava espelhar o aquecedor — mas nao espelhava:
	# /.well-known/security.txt estava so la. E ele e justamente o UNICO
	# artefato que muda em TODA publicacao (o Expires e recomputado por
	# transacao), entao a borda mantinha quente, indefinidamente, a copia velha
	# de quem mais muda. Duas listas paralelas divergem; agora ha uma so.
	ARTEFATOS_DESCOBERTA="$(tools/warm-edge-cache --listar-artefatos 2>/dev/null)"
	[ -n "$ARTEFATOS_DESCOBERTA" ] ||
		fail "nao consegui ler a lista de artefatos de descoberta (tools/warm-edge-cache --listar-artefatos). Purgar sem ela deixaria artefato velho quente na borda."
	# SEM FILTRO DE DISCO, e a remocao dele conserta um defeito que a lista nova
	# criou: `[ -e "public$artefato" ]` so deixava passar artefato que existe como
	# ARQUIVO. As seis rotas da superficie de agente (/openapi.json,
	# /.well-known/api-catalog, o indice de habilidades, os dois SKILL.md e a
	# prova de posse do dominio) sao servidas pelo BINARIO -- nao existem em
	# public/ por desenho, porque arquivo homonimo sombrearia a rota. Elas
	# entravam no aquecimento e sumiam da purga, que e exatamente o par que
	# mantem copia velha quente na borda.
	#
	# Purgar URL que nao existe e inofensivo: a Cloudflare aceita e ignora. O
	# risco assimetrico esta do outro lado.
	for artefato in $ARTEFATOS_DESCOBERTA; do
		echo "$artefato" >>"$PURGE_TODOS"
	done
	# AS GEMEAS EM MARKDOWN DE CADA PAGINA QUE MUDOU.
	#
	# /rota/ e /rota/index.md sao DUAS entradas na borda, com chaves distintas
	# por construcao -- e so a primeira estava sendo purgada. O efeito medido em
	# cima do que este projeto mais persegue: corrigida uma citacao legal, o HTML
	# sai certo e o Markdown continua servindo o texto ERRADO por ate sete dias,
	# justamente no canal de quem cita. O plano 2.1-ii mandava purgar as duas e a
	# implementacao ficou pela metade.
	#
	# So paginas de acervo tem gemea (duas secoes, ou uma das institucionais);
	# hub e paginacao nao tem, e pedir a purga delas seria pedir o que nao existe.
	while IFS= read -r rota; do
		case "$rota" in
		*/pagina/*) continue ;;
		/fontes/* | /contato/*) continue ;;
		esac
		# Conta as barras: duas secoes terminam com tres ("/a/b/").
		case "$rota" in
		/*/*/)
			echo "${rota}index.md" >>"$PURGE_TODOS"
			# E OS DOIS ITENS DA API POR CAMINHO (2026-09-09). Desde a Cache
			# Rule 3 (versao 18 da zona) a borda respeita o s-maxage=3600 de
			# /api/v1/pages/<rota> e /api/v1/citar/<rota>; o segundo carrega o
			# html_sha256 da pagina, que o agente usa para conferir integridade.
			# Sem esta purga, hash VELHO por ate uma hora depois de cada
			# republicacao, no canal de quem cita. Hub, paginacao, /fontes/ e
			# institucionais nao tem item na API (404 medido): nao entram.
			echo "/api/v1/pages${rota}" >>"$PURGE_TODOS"
			echo "/api/v1/citar${rota}" >>"$PURGE_TODOS"
			;;
		/privacidade/ | /sobre/ | /metodologia/ | /aviso-legal/ | /termos/ | /fontes/)
			echo "${rota}index.md" >>"$PURGE_TODOS"
			;;
		esac
	done <"$PURGE_ALVOS"
	# E A GEMEA DO HUB DE CADA AREA TOCADA (2026-09-16).
	#
	# O comentario acima diz que "hub e paginacao nao tem [gemea]" -- e o disco
	# desmente a primeira metade: /noticias/index.md, /administrativo/index.md e
	# os demais /{area}/index.md existem na zona wj_dyn e respondem 200, e e para
	# eles que `tools/purge-origin-cache --gemeas-de-area` foi escrito. O hub
	# lista o que a area tem, entao ele muda na publicacao que acrescenta pagina
	# a area -- e so o HTML dele estava sendo alcancado. Medido em 2026-09-16,
	# com o HTML dos cinco hubs conferidos frescos na borda:
	#     /jurisprudencia/index.md   borda != Go, HIT age 12.730 s
	# A area sai do PRIMEIRO segmento das rotas que mudaram (duas secoes, sem
	# paginacao): purgar hub que esta publicacao nao tocou seria jogar fora
	# aquecimento alheio.
	awk -F/ 'NF==4 && $4=="" && $2!="" && $3!="" {print "/" $2 "/index.md"}' "$PURGE_ALVOS" |
		sort -u >>"$PURGE_TODOS"
	# --- fim da expansao por pagina ---
	#
	# O MARCADOR ACIMA E CONTRATO COM A BANCADA, nao enfeite.
	# tools/test_deploy_publico_purga_api.sh extrai este bloco por `sed` e o
	# executa com dubles. Ate 2026-09-16 ele o procurava por
	# `/^    done < "$PURGE_ALVOS"$/` -- quatro espacos e um espaco depois do
	# `<`. O shfmt converteu a indentacao em TAB e colou o `<"`, o casamento
	# passou a devolver bloco VAZIO, e o teste reprovava com "bloco da expansao
	# nao encontrado" sem que nada da purga tivesse mudado: guarda morta,
	# vermelha por motivo errado. Marcador em comentario nao depende de
	# formatacao.
	# Os shards sao enumerados do disco, nao fixos: o numero deles acompanha o
	# acervo, e um shard velho na borda entrega ao crawler uma lista de URLs
	# desatualizada. Em 2026-08-11 um shard fora do ar devolveu 530.
	for shard in public/sitemaps/*.xml; do
		[ -e "$shard" ] && echo "/sitemaps/$(basename "$shard")" >>"$PURGE_TODOS"
	done
	# E OS QUE SAIRAM DO DISCO, que o glob acima nao alcanca por definicao.
	#
	# Um shard removido ao fim da carencia (internal/sitemapgrace) some do
	# diretorio e, com ele, da purga — enquanto a borda segue com a copia 200
	# QUENTE dele, que tools/warm-edge-cache manteve aquecida durante os oito
	# dias. Resultado: a origem responde 410 e a borda entrega 200 de um shard
	# que nao existe mais, por ate sete dias. O fingerprint agregado dos
	# artefatos nao resolve: ele guarda um hash, nao a lista de nomes.
	tools/check-sitemap-shard-grace --listar-removidos >>"$PURGE_TODOS" 2>/dev/null || true
	DINAMICAS_N=0
	if [ "$BIN_MUDOU" -eq 1 ] || [ "$SOCIAL_MUDOU" -eq 1 ]; then
		DINAMICAS="$(mktemp)"
		lista_dinamica_da_camada "$BIN_MUDOU" "$SOCIAL_MUDOU" >"$DINAMICAS" ||
			fail "binario novo (server=$BIN_MUDOU social=$SOCIAL_MUDOU) e a lista dinamica veio vazia ou curta (tools/warm-origin-cache --listar-rotas / sitemap do social em $LOCAL_ADDR_SOCIAL/redesocial/sitemap.xml). Purgar sem ela deixaria rota dinamica velha na borda por ate 7 dias. SAIDA: corrija a fonte da lista e relance, ou rode a purga total a mao (tools/purge-edge-cache, depois tools/warm-edge-cache --rps 12) e retome do passo seguinte — NUNCA desligue esta guarda nem purgue a lista curta."
		cat "$DINAMICAS" >>"$PURGE_TODOS"
		sort -u -o "$PURGE_TODOS" "$PURGE_TODOS"
		DINAMICAS_N="$(wc -l <"$DINAMICAS" | tr -d ' ')"
		echo "  binario mudou (server=$BIN_MUDOU social=$SOCIAL_MUDOU): + $DINAMICAS_N rota(s) dinamica(s); o HTML estatico de public/ fica quente na borda"
	fi
	TODOS_N="$(wc -l <"$PURGE_TODOS" | tr -d ' ')"
	echo "  $ALVOS_N pagina(s) mudaram de conteudo; purgando elas + $((TODOS_N - ALVOS_N)) artefato(s) de descoberta e rota(s) dinamica(s)"
	# O TETO VAI EXPLICITO: acima de --teto-por-url (3000) purge-edge-cache
	# degrada para purge_everything -- e a lista dinamica tem ~11 mil rotas.
	PURGE_TETO="$TODOS_N"
	[ "$PURGE_TETO" -lt 3000 ] && PURGE_TETO=3000
	PURGE_TETO=$((PURGE_TETO + 1))
	invalida_origem_relatando "$PURGE_TODOS"
	tools/purge-edge-cache --de-arquivo "$PURGE_TODOS" --teto-por-url "$PURGE_TETO" || {
		echo "  AVISO: cache de borda NAO foi purgado — o dominio publico pode servir a versao anterior."
		echo "         a purga usa CLOUDFLARE_ZONE_TOKEN (Bearer de zona); confira-o em .env.local,"
		echo "         com CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN (Global API Key) como fallback."
	}
	# REAQUECIMENTO DIRIGIDO (2026-09-09): exatamente o que acabou de ser purgado
	# -- HTML, gemea e itens da API das paginas que mudaram, mais a lista
	# dinamica quando o binario mudou -- em vez de esperar o timer. Foi isso que
	# permitiu o timer cair de seis para duas varreduras por dia (a passada das
	# 08:20 achava 750-970 frios: eram estas paginas). Falha nao derruba o
	# deploy: cache frio e degradacao, nao corrupcao.
	if [ "$TODOS_N" -gt 0 ]; then
		# O ORCAMENTO SAI DA LISTA, NAO DE UMA CONSTANTE — a mesma formula da
		# linha 1028, e por que ela precisou chegar aqui tambem.
		#
		# Ate 2026-09-10 este passo tinha `timeout 1800` fixo. No deploy #4 a
		# purga foi de 22.414 URLs e, a 12 r/s, isso custa 1.868 s: o teto
		# estourou por 68 segundos e o deploy imprimiu "reaquecimento dirigido
		# nao concluiu; o timer completa na proxima janela" — com o timer so
		# passando as 04:20 e 16:20 UTC, ou seja, a borda fria por horas logo
		# depois de purgar o acervo inteiro.
		#
		# Nao era carga: e aritmetica, e vai estourar em TODO deploy que troque
		# binario (a troca purga as ~22 mil rotas dinamicas), cada vez mais cedo
		# conforme o acervo cresce. Teto fixo contra lista que cresce e a mesma
		# familia do gate que compara por igualdade exata o tamanho de um
		# diretorio vivo: mede a passagem do tempo, nao o que diz medir.
		#
		# 16/10 e a folga sobre o tempo teorico (N/12), a mesma que o aquecimento
		# amplo usa; o piso de 300s cobre lista curta e o teto de 3600s existe
		# para que uma lista absurda pare o passo em vez de segurar o lock.
		# O QUE FOI RETIRADO NAO SE AQUECE, e o deploy mesmo o pos na lista.
		#
		# `check-sitemap-shard-grace --listar-removidos` entra em $PURGE_TODOS de
		# proposito: shard retirado ao fim da carencia sai do disco e a borda
		# seguiria servindo a copia 200 dele por ate sete dias. Purgar e certo.
		# AQUECER e o oposto: a origem responde 410, e 410 nunca esquenta.
		#
		# Medido no #5 (2026-09-10): `aquecidas: 22392 em 1866s`, `status: {200:
		# 22364, 410: 28}` — as 28 falhas eram exatamente os shards que este
		# script tinha acabado de remover. Como `warm-edge-cache` sai com codigo
		# de erro em QUALQUER falha, o deploy imprimiu "reaquecimento dirigido
		# nao concluiu em 2985s" sobre uma passada que concluiu em 1.866 s.
		# Diagnostico falso no fecho do deploy, produzido pelo proprio deploy.
		AQUECER_LISTA="$(mktemp)"
		REMOVIDOS="$(mktemp)"
		tools/check-sitemap-shard-grace --listar-removidos >"$REMOVIDOS" 2>/dev/null || true
		if [ -s "$REMOVIDOS" ]; then
			grep -F -x -v -f "$REMOVIDOS" "$PURGE_TODOS" >"$AQUECER_LISTA" || true
		else
			cp "$PURGE_TODOS" "$AQUECER_LISTA"
		fi
		AQUECER_N="$(wc -l <"$AQUECER_LISTA" | tr -d ' ')"
		REMOVIDOS_N="$(wc -l <"$REMOVIDOS" | tr -d ' ')"
		rm -f "$REMOVIDOS"
		DIRIGIDO_ORCAMENTO=$(orcamento_de_aquecimento "$AQUECER_N")
		if [ "$DIRIGIDO_ORCAMENTO" -eq 0 ]; then
			# NAO CABE NA JANELA, e dizer isso vale mais que tentar uma hora.
			#
			# Acima de ~27 mil URLs o aquecimento a 12 r/s passa do teto de uma
			# hora. Rodar assim gastaria a hora inteira segurando o lock pesado e
			# terminaria com a mesma borda parcialmente fria — pagando o custo e
			# entregando o aviso do mesmo jeito. Delegar ao timer de proposito,
			# com o numero na tela, e a decisao honesta.
			echo "  reaquecimento dirigido DELEGADO ao timer: $AQUECER_N URLs a 12 r/s levariam $(segundos_de_aquecimento "$AQUECER_N")s com a folga de 1,6x para latencia e falha, acima do teto de 3600s da janela de deploy."
			echo "  A borda esquenta em 04:20 e 16:20 UTC. Para antecipar: tools/warm-edge-cache --rps 12 --concorrencia 4"
		else
			if [ "$REMOVIDOS_N" -gt 0 ]; then
				echo "  reaquecendo na borda o que foi purgado ($AQUECER_N URLs, 12 r/s, orcamento ${DIRIGIDO_ORCAMENTO}s; $REMOVIDOS_N shard(s) retirado(s) ficam de fora — a origem responde 410)"
			else
				echo "  reaquecendo na borda o que foi purgado ($AQUECER_N URLs, 12 r/s, orcamento ${DIRIGIDO_ORCAMENTO}s)"
			fi
			com_batida_no_lock timeout "$DIRIGIDO_ORCAMENTO" tools/warm-edge-cache --de-arquivo "$AQUECER_LISTA" --rps 12 --concorrencia 4
			AQUECER_RC=$?
			# O AVISO TEM DE DIZER QUAL DOS DOIS ACONTECEU.
			#
			# `timeout` devolve 124 quando mata o comando; qualquer outro codigo
			# nao-zero veio do proprio aquecedor, que sai com erro em qualquer
			# URL falha. Tratar os dois como "nao concluiu" foi o que fez o #5
			# anunciar estouro de orcamento numa passada que terminou em 63% do
			# tempo dele.
			if [ "$AQUECER_RC" -eq 124 ]; then
				echo "  AVISO: reaquecimento dirigido ESTOUROU o orcamento de ${DIRIGIDO_ORCAMENTO}s; o timer completa na proxima janela."
			elif [ "$AQUECER_RC" -ne 0 ]; then
				echo "  AVISO: reaquecimento dirigido CONCLUIU com falhas (exit $AQUECER_RC); veja status e amostra acima. O acervo esta no ar."
			fi
		fi
	fi
fi

# INDEXNOW INCREMENTAL — avisa o buscador SO do que mudou, na mesma janela.
#
# A submissao completa das 9.835 URLs e util no comeco e cara de repetir: o
# protocolo existe justamente para dizer "esta URL mudou AGORA", e mandar o
# acervo inteiro a cada deploy desperdicia a cota e dilui o sinal.
#
# O gancho entra AQUI, e o lugar importa: depois da purga, que ja calculou o que
# mudou, e ANTES de o registro de revisao avancar na linha abaixo — depois dele,
# a memoria do que mudou nesta publicacao deixa de existir. Roda so no ramo em
# que houve mudanca; deploy que nao mexeu em conteudo nao avisa nada.
#
# --purge-targets imprime CAMINHO (/familia/x/), nao URL absoluta, entao o
# prefixo da base entra aqui.
# SOB --ressemear O INDEXNOW FICA CALADO (2026-09-08). Desde que --purge-targets
# deixou de cair no teto de churn, um deploy de markup lista milhares de rotas
# (4.259 no do JSON-LD do LexML) e este ramo as mandaria todas ao IndexNow —
# mas --ressemear existe para NAO avancar o lastmod, entao o sitemap diria
# "nada mudou" enquanto o IndexNow diria "tudo mudou". Aviso e sitemap tem de
# contar a mesma historia; bytes servidos que mudaram sem texto novo sao caso
# da purga, nao do anuncio ao buscador.
if [ -n "$ALVOS_N" ] && [ "$ALVOS_N" != "0" ] && [ "$RESSEMEAR" -eq 0 ]; then
	BASE_URL="$(python3 -c "import json;print(json.load(open('content/site.json'))['base_url'].rstrip('/'))" 2>/dev/null || echo "")"
	if [ -n "$BASE_URL" ]; then
		INDEXNOW_ALVOS="$(mktemp)"
		# A GEMEA MARKDOWN SAI DO PAYLOAD, E O NUMERO IMPRESSO E O DO PAYLOAD
		# (2026-09-16). `--purge-targets` emite DUAS linhas por rota, `/x/` e
		# `/x/index.md`, e esta certo: sao duas CHAVES DE CACHE na borda. Mas o
		# indice de um buscador tem uma entrada por DOCUMENTO CANONICO, e a
		# gemea declara o proprio veredito no cabecalho que a origem serve:
		#
		#   link: <https://wikijuridica.com.br/sumulas/stj-409/>; rel="canonical"
		#
		# Anuncia-la e pedir indexacao de um endereco que se autodeclara
		# duplicata. Medido: 2.422 de 13.941 eventos por URL desde 2026-09-04
		# (17,4%) em 1.968 URLs `.md` distintas, todas HTTP 200; nos lotes
		# vindos de deploy desde 09-10, 127 de 254 = 50,0%, com as 127 maes no
		# mesmo lote. `tools/generate-indexnow-direct-submit` ja particiona a
		# lista por conta propria; este filtro e o cinto sobre o suspensorio, e
		# existe tambem para que `$ALVOS_N` pare de mentir -- ele e a contagem
		# do PURGE (o dobro), e o operador lia um numero que nunca foi enviado.
		sed "s|^|$BASE_URL|" "$PURGE_ALVOS" | grep -v '/index\.md$' >"$INDEXNOW_ALVOS"
		INDEXNOW_N="$(grep -c "" "$INDEXNOW_ALVOS" 2>/dev/null || echo 0)"
		if tools/generate-indexnow-direct-submit --de-arquivo "$INDEXNOW_ALVOS" >/dev/null 2>&1; then
			echo "  IndexNow avisado das $INDEXNOW_N pagina(s) que mudaram (de $ALVOS_N alvo(s) de purga)"
		else
			echo "  AVISO: IndexNow nao aceitou a submissao incremental; o sitemap segue como canal."
		fi
		rm -f "$INDEXNOW_ALVOS"
	fi
fi

# O registro so avanca DEPOIS da purga: ele e a memoria de "o que ja foi ao ar
# com esta versao". Atualizar antes apagaria justamente a lista do que precisa
# sair do cache.
# A SAIDA NAO E ENGOLIDA, e a diferenca e o operador saber o que fazer.
#
# Ate 2026-08-28 esta chamada era `> /dev/null 2>&1 || echo AVISO`. O gerador tem
# uma guarda, `confere_formula`, que RECUSA rodar quando a formula do
# served_sha256 mudou sem ressemeadura -- porque rodar assim carimbaria a data de
# hoje em todas as rotas e reanunciaria o sitemap inteiro ao Googlebot. A recusa
# vem com dez linhas explicando o remedio exato (`--ressemear`, e por que nao usar
# `--desde-commit` na mesma passada).
#
# Tudo isso ia para /dev/null. O que sobrava era uma linha dizendo "AVISO:
# registro nao pode ser atualizado", que nao diz nem o motivo nem a saida.
#
# Agora a saida e preservada e o veredito e classificado: RECUSADO e bloqueio
# deliberado da guarda e para o deploy; qualquer outra falha continua sendo aviso,
# porque pode ser transitoria e o acervo ja esta no ar. Abortar em toda falha
# seria largo demais -- a guarda e um caso, nao a regra.
revisao_args=()
if [[ $RESSEMEAR -eq 1 ]]; then
	revisao_args+=(--ressemear)
	echo "  --ressemear: a linha de base sera regravada SEM carimbar data nova"
fi
revisao_saida=$(tools/generate-page-content-revision "${revisao_args[@]}" 2>&1)
revisao_codigo=$?
if [[ $revisao_codigo -ne 0 ]]; then
	printf '%s\n' "$revisao_saida" | sed 's/^/  /'
	if printf '%s' "$revisao_saida" | grep -q 'RECUSADO'; then
		echo "  A guarda do gerador recusou deliberadamente. Deploy interrompido: siga o remedio acima." >&2
		exit 1
	fi
	echo "  AVISO: registro de data por conteudo nao pode ser atualizado; a proxima purga sera mais larga."
fi

# --- 7. conferir -------------------------------------------------------------
# ROBOTS CONFERIDO POR PARSER, e o episodio que obrigou: em 2026-08-12 uma
# diretiva nao-padrao (`Content-Signal:`) foi acrescentada aos 28 grupos com o
# risco declarado como "aproximadamente zero" -- porque a RFC 9309 manda o parser
# IGNORAR linha desconhecida. O Bing Webmaster passou a acusar ERRO DE SINTAXE e a
# URL foi para "Discovered but not crawled". Ignorar a linha e nao acusar erro por
# causa dela sao coisas diferentes.
#
# Roda DEPOIS da publicacao e ANTES do smoke: e aqui que o robots ja esta no disco
# com o conteudo que vai ao ar. Nao aborta o deploy -- o acervo publicado nao fica
# refem de uma verificacao de robots --, mas grita alto, porque robots quebrado
# custa rastreamento e ninguem percebe olhando o arquivo.
if ! tools/check-robots-parser-real >/dev/null 2>&1; then
	echo ""
	echo "  AVISO: o robots.txt publicado REPROVOU na conferencia por parser."
	tools/check-robots-parser-real 2>&1 | sed 's/^/    /'
fi

# COERENCIA DE public/sitemaps/, pelo mesmo motivo e no mesmo lugar.
#
# publishedmanifest recusa shard fora do indice e <loc> repetida, e essa recusa
# roda no BOOT do servidor (httpserver.go:479-482): descoberta la, ela nao e
# aviso, e portal fora do ar no proximo restart. Aqui o estado acabou de ser
# escrito e da tempo de consertar antes de alguem reiniciar qualquer coisa.
# Tambem pega carencia vencida que a limpeza da publicacao nao levou.
if ! tools/check-sitemap-shard-grace >/dev/null 2>&1; then
	echo ""
	echo "  AVISO: public/sitemaps/ esta INCOERENTE — isso derruba o boot no proximo restart."
	tools/check-sitemap-shard-grace 2>&1 | sed 's/^/    /'
fi

# E O ESTADO MEDIDO VIRA SERIE, aqui, que e o instante em que ele acabou de mudar.
#
# `data/ops/sitemap_shard_grace.jsonl` so tinha escritor para o shard que SAI da
# carencia (registrarEventoDeCarencia, chamado de dentro do `remover()` do
# publicador). O que ENTRA nao deixava rastro nenhum: em 2026-08-29 o ledger
# afirmava "35 shards, 35 no indice, 0 em carencia" enquanto o disco tinha 62,
# 34 e 28. Vinte e oito shards entraram em carencia sem uma linha sequer.
#
# O gerador e append-only e nao anexa quando o estado nao mudou, entao chama-lo a
# cada deploy — sete por dia na media medida aqui — nao incha o ledger: registra
# exatamente as transicoes. Falhar aqui NAO derruba o deploy: o artefato publico
# ja esta correto neste ponto, e trocar uma publicacao boa por um erro de ledger
# seria pior que o defeito, que e a mesma escolha que o publicador faz em Go.
# A saida e CAPTURADA antes de ser indentada, e nao encanada direto no sed: com
# `cmd | sed || aviso` quem responde pelo `||` e o sed, entao o `set -o pipefail`
# la em cima (:34) e o unico motivo de a falha nao se perder. Guarda que depende
# de uma opcao declarada 900 linhas antes e guarda por acidente.
if ! SERIE_CARENCIA_SAIDA="$(tools/generate-sitemap-shard-grace-series 2>&1)"; then
	echo "  AVISO: a serie de carencia de sitemap nao foi atualizada (o deploy segue)."
fi
printf '%s\n' "$SERIE_CARENCIA_SAIDA" | sed 's/^/  /'

# O REGISTRY TEM DE COBRIR TODA COORTE DO PLANO VIVO, e este e o gate que impede
# a unica forma de o registry derrubar o portal.
#
# O servidor e o build sao produtores SOMENTE-LEITURA do registry: coorte que ele
# nao conhece vira ERRO, nao numero inventado -- e sem isso a disciplina "so o
# publicador aloca" viveria apenas em comentario, que foi a critica adversarial
# ao primeiro desenho. O preco e que um registry incompleto faria o servidor
# recusar subir no proximo restart. Descobrir isso no boot e descobrir com o
# portal fora do ar; descobrir aqui custa um segundo.
#
# Registry ausente devolve OK: sem ele o plano volta a ser o posicional de
# sempre, que e a rota de recuo desta mudanca inteira.
if ! ./tools/go-modern run ./cmd/seed-sitemap-registry --root . --verificar 2>&1 | sed 's/^/  /'; then
	echo ""
	echo "  AVISO: o registry de shard NAO cobre o plano vivo — o servidor recusaria subir." >&2
	echo "  Remedio: ./tools/go-modern run ./cmd/seed-sitemap-registry --root . --escrever" >&2
fi

# OS TRES GATES DE CUSTO DE SITEMAP, que existiam e NAO RODAVAM EM LUGAR NENHUM.
#
# Levantado em 2026-08-28: `check-sitemap-shard-churn`, `check-sitemap-fidelity` e
# `check-sitemap-discovery-cost` estao escritos no repo, tem criterio proprio e
# nao apareciam em deploy, systemd nem cron. Gate que ninguem chama e documentacao
# executavel, nao guarda -- e o que eles medem e exatamente o defeito que custa
# rastreio: 36,5% do que o Googlebot faz neste site e sitemap, e uma onda que
# revise 45 paginas de uma area troca os bytes de 32 dos 35 shards.
#
# NAO ABORTAM O DEPLOY, pela mesma razao do robots logo acima: o acervo publicado
# nao fica refem de uma medicao de custo. Gritam alto, com a saida preservada --
# engolir veredito em /dev/null foi o defeito de deploy-publico:741, corrigido
# nesta mesma sessao, e nao se repete tres linhas abaixo.
#
# `--data-revisao` do churn nao e passado de proposito: sem ele o gate usa o
# proprio estado publicado, que e o que acabou de ir ao ar.
for gate_sitemap in check-sitemap-churn:check-sitemap-shard-churn \
	check-sitemap-fidelidade:check-sitemap-fidelity \
	check-sitemap-custo-de-descoberta:check-sitemap-discovery-cost \
	check-sitemap-dispersao-de-lastmod:check-sitemap-lastmod-dispersion; do
	rotulo="${gate_sitemap%%:*}"
	ferramenta="${gate_sitemap##*:}"
	[ -x "tools/$ferramenta" ] || continue
	saida_gate=$(tools/"$ferramenta" 2>&1)
	codigo_gate=$?
	if [ $codigo_gate -ne 0 ]; then
		echo ""
		echo "  AVISO ($rotulo): o custo de sitemap para o crawler REPROVOU (exit $codigo_gate)."
		printf '%s\n' "$saida_gate" | tail -20 | sed 's/^/    /'
	fi
done

# A SEGUNDA passada do gate, agora com --gravar: a serie diaria so registra o
# que de fato foi publicado, e o baseline da queda relativa nasce do estado
# final, nunca do intermediario.
if [ -x tools/check-jsonld-cobertura ]; then
	step "7/7 dado estruturado publicado (serie)"
	tools/check-jsonld-cobertura --gravar || fail "o JSON-LD publicado regrediu depois da troca de binario"
fi

step "7/7 conferindo no ar"
ROTAS=$(
	python3 - <<'PY'
import json, random
random.seed()
try:
    pages = [p for p in json.load(open("content/pages.json", encoding="utf-8"))
             if p.get("unique_intent_id")]
    amostra = random.sample(pages, min(6, len(pages)))
    print("\n".join(p["path"] for p in amostra))
except Exception:
    pass
PY
)
# O smoke bate na BORDA e na ORIGEM, e o motivo e um buraco medido em 2026-08-12:
# batendo so em $PUBLIC_HOST, uma resposta em HIT passa o smoke ainda que a
# origem esteja quebrada — o Edge TTL e de 7 dias. No deploy daquele dia isso nao
# enganou por acidente feliz: a purga total antecedeu o smoke e o reaquecimento
# registrou 9.902 MISS de 9.909, entao a origem serviu quase tudo. Um deploy com
# purga parcial, ou nenhuma, nao teria essa sorte, e o "NO AR" seria uma
# afirmacao sobre o cache, nao sobre o servidor.
#
# A origem se consulta pelo nginx em 127.0.0.1:8088 com o Host do dominio: e ele
# que serve o acervo de disco (o binario Go em :8089 atende so as rotas
# dinamicas, entao bater nele daria 404 na maioria das paginas e seria um falso
# vermelho). As duas pernas precisam responder 200: a borda prova o que o
# visitante recebe, a origem prova o que o servidor tem.
ORIGIN_ADDR=http://127.0.0.1:${ORIGIN_PORT}
FALHAS=0

# A REDE SOCIAL ENTRA NA CONFERENCIA, pelo gate proprio dela.
#
# Ele sonda a PORTA -- as treze rotas, a folha de estilo com o hash extraido do
# HTML servido, o 404 honesto e a CSP nomeando a folha exata. Nao ha caminho
# fixo de CSS aqui: o nome carrega o hash do conteudo e mudaria a cada commit
# de design, e o gate passaria a medir uma folha morta.
#
# Reprovar aqui CONTA como falha do deploy: o acervo e a rede social saem do
# mesmo `git push` e do mesmo binario compilado no passo 2 -- anunciar "NO AR"
# com /redesocial/ quebrado seria a afirmacao silenciosamente falsa que o
# passo 7 existe para impedir.
if [ -x tools/check-social-http-smoke ]; then
	if tools/check-social-http-smoke >/dev/null 2>&1; then
		printf '  \033[32mok\033[0m  rede social (13 rotas, folha e CSP)\n'
	else
		printf '  \033[31mFALHOU\033[0m  rede social — rode: tools/check-social-http-smoke\n'
		FALHAS=$((FALHAS + 1))
	fi
fi
for rota in / /sitemap.xml /robots.txt $ROTAS; do
	code_origem=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
		-H "Host: wikijuridica.com.br" "$ORIGIN_ADDR$rota")
	if [ "$code_origem" != "200" ]; then
		printf '  \033[31m%s\033[0m  %s  (ORIGEM — a borda pode estar mascarando com HIT)\n' \
			"$code_origem" "$rota"
		FALHAS=$((FALHAS + 1))
	fi
	code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_HOST$rota")
	if [ "$code" = "200" ]; then
		printf '  \033[32m%s\033[0m  %s\n' "$code" "$rota"
	else
		printf '  \033[31m%s\033[0m  %s\n' "$code" "$rota"
		FALHAS=$((FALHAS + 1))
	fi
done

if [ "$FALHAS" -gt 0 ]; then
	echo
	echo "$FALHAS rota(s) fora do ar. Rollback mais recente:"
	ls -1dt data/ops/publish-rollback-* 2>/dev/null | head -1
	exit 1
fi

# Registra a impressao digital da camada SO no fim, e so quando o smoke passou.
# Gravar antes marcaria como "ja publicado" um binario que talvez nao tenha
# subido — e o proximo deploy, achando que nada mudou, deixaria a borda servindo
# a resposta antiga sem purgar. Erra-se para o lado de purgar demais, que custa
# um reaquecimento; nunca para o lado de purgar de menos, que custa dias de
# conteudo errado no ar.
CAMADA_INPUTS_JSON="$(
	{
		printf '"bin/wikijuridica-server.next", "bin/wikijuridica-social.next"'
		for _conf in $NGINX_CONF_FONTES; do printf ', "%s"' "$_conf"; done
	}
)"
printf '{\n  "schema_version": "deploy_layer_fingerprint_v4",\n  "layer_sha256": "%s",\n  "bin_sha256": "%s",\n  "social_sha256": "%s",\n  "ingress_sha256": "%s",\n  "artefatos_sha256": "%s",\n  "nginx_unit": "%s",\n  "origin_port": "%s",\n  "recorded_at": "%s",\n  "inputs": [%s]\n}\n' \
	"$CAMADA_ATUAL" "$BIN_ATUAL" "$SOCIAL_ATUAL" "$INGRESS_ATUAL" "$ARTEFATOS_ATUAL" "$NGINX_UNIT" "$ORIGIN_PORT" \
	"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CAMADA_INPUTS_JSON" >"$CAMADA_ESTADO"

echo
printf '\033[32mNO AR\033[0m — %s paginas, cache limpo, %s\n' \
	"$(python3 -c "import json;print(len(json.load(open('content/pages.json',encoding='utf-8'))))" 2>/dev/null)" \
	"$PUBLIC_HOST"
