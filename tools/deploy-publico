# --- 2. build ----------------------------------------------------------------
if [ "$REBUILD" = "1" ]; then
	step "2/7 compilando o servidor"
	nice -n 10 ./tools/go-modern build -o bin/wikijuridica-server.next ./cmd/server ||
		fail "build do servidor"
	# A REDE SOCIAL COMPILA JUNTO, e falha aqui aborta o deploy inteiro de
