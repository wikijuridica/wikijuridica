#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-goal-baseline}"
export WIKI_FACTORY_WORKQUEUE_DB="${WIKI_FACTORY_WORKQUEUE_DB:-$ROOT/.cache/factory-workqueue/goal-baseline.pebble}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate-goal-baseline "$@"
