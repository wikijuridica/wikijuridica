#!/usr/bin/env bash
# pre-voo — a sequência canônica ANTES de commitar, em ordem de custo crescente.
#
# Para no primeiro erro e imprime o conserto. Cada passo só roda se o anterior
# passou: o caro nunca paga pelo barato.
#
# ★ POR QUE ISTO EXISTE (ordem do dono, 2026-08-29).
#
#   "Tem que deixar explícito no plano que você deve GRAVAR esses comandos e
#    fazer TESTES e TESTES DE REGRESSÃO e evitar loopings desnecessários. Tem
#    que gastar tokens do que importa, e isso deve ser OPERACIONAL e não
#    conversa de chat em terminal."
#
# A sequência existia em prosa, espalhada por CLAUDE.md, AGENTS.md e corpo de
# commit. O levantamento desta sessão mediu o resultado disso: as lições que
# viraram gate não voltaram; as que ficaram em prosa voltaram NO MESMO DIA — o
# caso do SHA fantasma reincidiu três horas depois de ter sido diagnosticado,
# corrigido e escrito.
#
# Uso:
#   ./tools/pre-voo                 # confere a árvore inteira
#   ./tools/pre-voo <arquivo>...    # confere só os caminhos dados (mais rápido)
#
# READ-ONLY: não escreve, não commita, não instala. Sai 0 quando está livre para
# commitar, 1 quando há conserto a fazer — e o conserto vem impresso.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

ALVOS=("$@")
FALHOU=0

titulo() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
erro() {
	printf '   \033[31mREPROVOU\033[0m %s\n' "$1"
	FALHOU=1
}
ok() { printf '   ok  %s\n' "$1"; }
conserto() { printf '   \033[33mconserto:\033[0m %s\n' "$1"; }

# ---------------------------------------------------------------------------
titulo "1. gofmt — ~1 s, e é cobrado DENTRO do compile closure"
# Reprovar por formatação depois de 30 s de compilação é puro desperdício, e
# aconteceu duas vezes hoje.
if [ ${#ALVOS[@]} -gt 0 ]; then
	GO_ALVOS=()
	for a in "${ALVOS[@]}"; do [[ "$a" == *.go ]] && [ -f "$a" ] && GO_ALVOS+=("$a"); done
else
	mapfile -t GO_ALVOS < <(
		git diff --name-only --diff-filter=ACM -- '*.go'
		git diff --cached --name-only --diff-filter=ACM -- '*.go'
	)
fi
if [ ${#GO_ALVOS[@]} -eq 0 ]; then
	ok "nenhum .go modificado"
else
	DESFORMATADOS="$(gofmt -l "${GO_ALVOS[@]}" 2>/dev/null)"
	if [ -n "$DESFORMATADOS" ]; then
		erro "fonte Go não formatada:"
		printf '        %s\n' $DESFORMATADOS
		conserto "gofmt -w $DESFORMATADOS"
	else
		ok "${#GO_ALVOS[@]} arquivo(s) Go formatado(s)"
	fi
fi

# ---------------------------------------------------------------------------
titulo "2. guard de git destrutivo — 41 vereditos, sem build"
# Um guard que não roda é pior que guard nenhum: dá segurança falsa. Hoje ele
# tinha quatro furos, entre eles `git cherry-pick` e `git checkout <sha> -- x`.
if [ -x "$ROOT/tools/check-git-guard-regressao" ]; then
	if SAIDA="$("$ROOT/tools/check-git-guard-regressao" 2>&1)"; then
		ok "$(printf '%s' "$SAIDA" | tail -1)"
	else
		erro "guard de git com furo ou ausente:"
		printf '        %s\n' "$SAIDA"
		conserto "acrescentar o padrão faltante em ~/.claude/hooks/git-guard.sh"
	fi
else
	erro "tools/check-git-guard-regressao ausente"
fi

# ---------------------------------------------------------------------------
titulo "2-bis. invocação de git sem saneamento de ambiente"
# `git -C <root>` não obedece ao -C quando GIT_DIR está no ambiente: responde
# sobre OUTRO repositório, com exit 0 e saída plausível. Sob o pre-commit isso
# faz todo gate que descobre seu universo por `git ls-files` medir o recorte do
# commit — e universo que encolhe não fica vermelho, fica VERDE.
if [ -x "$ROOT/tools/check-git-invocacao-saneada" ]; then
	if SAIDA="$("$ROOT/tools/check-git-invocacao-saneada" 2>&1)"; then
		ok "$(printf '%s' "$SAIDA" | tail -1)"
	else
		erro "invocação de git herdando o ambiente do chamador:"
		printf '%s\n' "$SAIDA" | head -8 | sed 's/^/        /'
		conserto "gitenv.Command(root, ...) em produção, gittestenv.Environment() em teste, ou //gitenv:deliberado com a razão"
	fi
else
	erro "tools/check-git-invocacao-saneada ausente"
fi

# ---------------------------------------------------------------------------
titulo "3. index.lock e concorrência — corrida, não defeito"
if [ -f "$ROOT/.git/index.lock" ]; then
	IDADE=$(($(date +%s) - $(stat -c %Y "$ROOT/.git/index.lock" 2>/dev/null || date +%s)))
	if pgrep -x git >/dev/null 2>&1; then
		erro "index.lock com git vivo (idade ${IDADE}s) — outra frente está commitando"
		conserto "aguardar e repetir; NUNCA remover o lock com git vivo"
	elif [ "$IDADE" -gt 60 ] && [ ! -s "$ROOT/.git/index.lock" ]; then
		erro "index.lock ÓRFÃO: ${IDADE}s, 0 bytes, sem git vivo"
		conserto "./tools/clear-orphan-git-lock"
	else
		erro "index.lock presente (idade ${IDADE}s), sem git vivo mas com conteúdo"
		conserto "investigar antes de remover — lock com bytes pode ser escrita em curso"
	fi
else
	ok "sem index.lock"
fi

# ---------------------------------------------------------------------------
titulo "4. produto untracked — todo ?? é produto até prova em contrário"
# "Produto não fica untracked" (CLAUDE.md). Hoje o manifesto RASTREADO da malha
# temática apontava para 7 shards que não estavam no git: em clone limpo, a
# malha não existia.
UNTRACKED="$(git status --porcelain | grep '^??' | awk '{print $2}')"
QUANTOS_UNTRACKED="$(printf '%s' "$UNTRACKED" | grep -c . || true)"
if [ "$QUANTOS_UNTRACKED" -eq 0 ]; then
	ok "nenhum untracked"
else
	printf '   %s caminho(s) untracked — classifique cada um (produto ou ruído):\n' "$QUANTOS_UNTRACKED"
	printf '%s' "$UNTRACKED" | head -12 | sed 's/^/        /'
	[ "$QUANTOS_UNTRACKED" -gt 12 ] && printf '        ... e mais %s\n' "$((QUANTOS_UNTRACKED - 12))"
	conserto "produto -> git add na frente que o criou; ruído -> classificar no .gitignore, NUNCA deletar"
fi

# ---------------------------------------------------------------------------
titulo "4-bis. BUGLOG × frontboard — o registro não pode mentir sobre o estado"
# 31 linhas do BUGLOG diziam "aberto" para bug já fechado, incluindo dez
# derrubados por medição e seis fechados por refutação. Registro que mente faz o
# próximo agente reabrir investigação encerrada — e uma delegação inteira já foi
# gasta hoje para descobrir que não havia bug.
if [ -x "$ROOT/tools/check-buglog-status-coerente" ]; then
	if SAIDA="$("$ROOT/tools/check-buglog-status-coerente" 2>&1)"; then
		ok "$(printf '%s' "$SAIDA" | tail -1)"
	else
		erro "BUGLOG contradiz o frontboard:"
		printf '%s\n' "$SAIDA" | head -8 | sed 's/^/        /'
		conserto "./tools/generate-buglog-status  (veja antes com --seco)"
	fi
fi

# ---------------------------------------------------------------------------
titulo "4-ter. exceções de CVE × alcançabilidade medida"
# Exceção sustentada por MEDIÇÃO (govulncheck diz que o código não é chamado)
# não precisa de prazo. Exceção sustentada por ARGUMENTO precisa. E CVE ignorada
# que passe a ser alcançável reprova na hora, sem esperar o prazo vencer.
if [ -x "$ROOT/tools/check-sca-alcancabilidade" ]; then
	if SAIDA="$("$ROOT/tools/check-sca-alcancabilidade" 2>&1)"; then
		ok "$(printf '%s' "$SAIDA" | tail -1)"
	else
		erro "exceção de CVE em desacordo com a alcançabilidade medida:"
		printf '%s\n' "$SAIDA" | head -6 | sed 's/^/        /'
		conserto "CVE alcançável: corrigir ou subir versão. Sem medição: manter ignoreUntil."
	fi
fi

# ---------------------------------------------------------------------------
titulo "4-quater. os nove críticos do briefing, re-medidos"
# ★ POR QUE ISTO É UM PASSO, e não uma nota no BUGLOG.
#
# O briefing da caça lista nove "CRÍTICOS VIVOS" medidos em 2026-08-29. Quando
# foram re-triados em 2026-08-30, NENHUM sobreviveu à medição — uns já tinham
# sido corrigidos, outros eram enunciado errado, e um só caiu depois de a
# causa-raiz real aparecer. Esse veredito ficou escrito em prosa, e prosa não se
# verifica: qualquer leitor tinha de acreditar no relato.
#
# O gate transforma cada um em COMANDO. Aqui roda o modo LEITURA (~5 s); o modo
# `--completo` acrescenta `cmd/build public` e `public-release-transaction`, que
# levam cerca de um minuto cada e não cabem num pré-voo.
if [ -x "$ROOT/tools/check-criticos-do-briefing-20260829" ]; then
	if SAIDA="$("$ROOT/tools/check-criticos-do-briefing-20260829" 2>&1)"; then
		ok "$(printf '%s' "$SAIDA" | tail -1)"
	else
		erro "algum enunciado do briefing voltou a se reproduzir:"
		printf '%s\n' "$SAIDA" | grep -a 'VIVO' | head -6 | sed 's/^/        /'
		conserto "leia o detalhe ao lado do VIVO: ele traz o número medido agora."
	fi
fi

# ---------------------------------------------------------------------------
titulo "5. pares v2 — < 1 s, sem build"
# Intenção e página v2 são DOIS commits, portfolio_v2 antes. Cada tentativa cega
# custa um ciclo inteiro de pre-commit.
TOCA_V2=0
if [ ${#ALVOS[@]} -gt 0 ]; then
	for a in "${ALVOS[@]}"; do [[ "$a" == *v2_pages* || "$a" == *portfolio_v2* ]] && TOCA_V2=1; done
else
	git status --porcelain | grep -qE 'v2_pages|portfolio_v2' && TOCA_V2=1
fi
if [ "$TOCA_V2" -eq 0 ]; then
	ok "nada de v2 nesta passada"
else
	for gate in check-v2-portfolio-pairing check-v2-semantic-pins-fresh; do
		if [ -x "$ROOT/tools/$gate" ]; then
			if SAIDA="$("$ROOT/tools/$gate" 2>&1)"; then
				ok "$gate"
			else
				erro "$gate:"
				printf '%s\n' "$SAIDA" | tail -8 | sed 's/^/        /'
				conserto "o próprio gate imprime o comando; refresh de pino e commit são a MESMA transação"
			fi
		fi
	done
fi

# ---------------------------------------------------------------------------
printf '\n'
if [ "$FALHOU" -ne 0 ]; then
	printf '\033[31mpre-voo: NÃO commite ainda.\033[0m Conserte o que está acima e repita.\n'
	exit 1
fi
printf '\033[32mpre-voo: livre para commitar.\033[0m\n'
printf 'Lembre: `git add` e `git commit` em invocações SEPARADAS (juntas, o hook\n'
printf 'reprova com "índice mudou durante compilação"); mensagem por -F <arquivo>;\n'
printf 'commit que toca Go serializado com `flock /tmp/opt-wiki-agent-heavy.lock`.\n'
