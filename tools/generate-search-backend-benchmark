#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:search-backend-benchmark:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-300000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-180000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=30}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/search_backend_benchmark.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-search-backend-benchmark}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/search_backend_benchmark.jsonl}"
export WIKI_OSS_INSTALL_MATRIX_TARGETS="${WIKI_OSS_INSTALL_MATRIX_TARGETS:-search-backend-binaries}"
export WIKI_OSS_INSTALL_MATRIX_NO_INSTALL="${WIKI_OSS_INSTALL_MATRIX_NO_INSTALL:-0}"
export WIKI_GO_CMD_ENV_WRAPPER="${WIKI_GO_CMD_ENV_WRAPPER:-$ROOT/tools/oss-install-matrix-env}"
cd "$ROOT"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-search-backend-benchmark --timings "$@"
