#!/usr/bin/env python3
"""Reprova chave de array associativo com espaco em script shell do repo.

POR QUE ESTA GUARDA EXISTE, com o caso que a originou
-----------------------------------------------------
O commit d4c942f2 (2026-09-11, "style(shell): 108 scripts formatados pelo shfmt,
com bash -n antes e depois") espacou o hifen dentro das chaves dos arrays
associativos de tools/run-daily-content:

    [stj - precedentes]="./cmd/collect-stj-precedentes"

O shfmt le `[stj-precedentes]` como expressao aritmetica e reescreve com
espacos. Em array ASSOCIATIVO o subscript e string literal, entao a chave passa
a ser "stj - precedentes" -- diferente de "stj-precedentes".

`bash -n` APROVA: e sintaticamente valido. Por isso a guarda tem de ser
semantica, e por isso este arquivo existe em vez de uma linha no pre-commit.

O PREJUIZO, MEDIDO (2026-09-11 a 2026-09-16, cinco dias):
  - 8 chaves corrompidas (run-daily-content:337,338,345,346,347,369,370,371);
  - o filtro `[ "$chave" = "noticias-oficiais" ]` casava ZERO chaves, entao a
    passada --somente-noticias das 12:20 desligava TODOS os coletores;
  - data/ops/daily_content_collect.jsonl partiu a serie: chaves antigas param em
    09-10, chaves novas (com espaco) nascem em 09-11;
  - tools/check-frescor-canal-diario casa fontes por string exata e tem os nomes
    certos no codigo, entao passou a ler {} para 4 dos 5 canais e a julgar o
    ultimo registro nao corrompido, de 2026-09-10. Por cinco dias o alerta
    nomeou a causa errada -- acusava "diarios: 0 de 166 coletada(s), marca
    d'agua 2026-08-29" enquanto o log real dizia `tls: handshake failure`.

Gate cego com confianca e pior que gate vazio.

READ-ONLY: este comando nao escreve nada. Sai 0 se nao ha chave com espaco,
1 se ha (nomeando arquivo:linha), 2 em erro de uso.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

# Abre um array associativo: `declare -A NOME=(` ou `typeset -A NOME=(`.
RE_ABRE = re.compile(r"^\s*(?:declare|typeset)\s+-[A-Za-z]*A[A-Za-z]*\s+\w+=\(")
# Fecha na primeira linha que e so `)` -- e como todos os arrays do repo fecham.
RE_FECHA = re.compile(r"^\s*\)\s*$")
# Uma entrada `[chave]=valor`. A chave e capturada crua, com o que houver dentro.
RE_ENTRADA = re.compile(r"^\s*\[([^\]]*)\]=")


def scripts_do_repo(raiz: Path) -> list[Path]:
    """Scripts shell rastreados pelo git, por caminho exato.

    Usa `git ls-files` para nao varrer os clones untracked da raiz -- uma
    varredura ingenua ali ja custou 96 GB de leitura a uma sessao.
    """
    saida = subprocess.run(
        ["git", "-C", str(raiz), "ls-files", "-z", "tools", "ops", "scripts", ".githooks"],
        capture_output=True,
        text=True,
        check=False,
    )
    if saida.returncode != 0:
        print(f"check-chaves-de-array-shell: git ls-files falhou: {saida.stderr.strip()}", file=sys.stderr)
        sys.exit(2)

    encontrados = []
    for rel in saida.stdout.split("\0"):
        if not rel:
            continue
        caminho = raiz / rel
        if not caminho.is_file():
            continue
        if caminho.suffix in {".sh", ".bash"}:
            encontrados.append(caminho)
            continue
        if caminho.suffix:
            continue
        try:
            primeira = caminho.open("rb").readline()
        except OSError:
            continue
        if primeira.startswith(b"#!") and (b"bash" in primeira or b"/sh" in primeira):
            encontrados.append(caminho)
    return sorted(encontrados)


def achados_no_arquivo(caminho: Path) -> list[tuple[int, str, str]]:
    """Devolve (linha, nome_do_array, chave_crua) para cada chave com espaco."""
    try:
        linhas = caminho.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []

    achados: list[tuple[int, str, str]] = []
    array_atual = ""
    for numero, linha in enumerate(linhas, start=1):
        if not array_atual:
            abertura = RE_ABRE.match(linha)
            if abertura:
                array_atual = linha.strip().split("=", 1)[0].split()[-1]
            continue
        if RE_FECHA.match(linha):
            array_atual = ""
            continue
        entrada = RE_ENTRADA.match(linha)
        if entrada and " " in entrada.group(1):
            achados.append((numero, array_atual, entrada.group(1)))
    return achados


def main() -> int:
    raiz = Path(__file__).resolve().parent.parent
    total = 0
    for caminho in scripts_do_repo(raiz):
        for numero, array, chave in achados_no_arquivo(caminho):
            total += 1
            rel = caminho.relative_to(raiz)
            sugerida = chave.replace(" ", "")
            print(
                f"{rel}:{numero}: chave de array associativo com espaco em {array}: "
                f"[{chave}] -- comparacao por string exata nunca casa. Provavel: [{sugerida}]"
            )

    if total:
        print(
            f"\ncheck-chaves-de-array-shell: {total} chave(s) com espaco.\n"
            "bash -n aprova isto: e sintaticamente valido e semanticamente errado.\n"
            "Causa provavel: shfmt leu o hifen como operador aritmetico. Reescreva\n"
            "a chave sem espaco e confira quem a compara por string exata.",
            file=sys.stderr,
        )
        return 1

    print("check-chaves-de-array-shell: nenhuma chave de array associativo com espaco")
    return 0


if __name__ == "__main__":
    sys.exit(main())
