#!/usr/bin/env python3
"""check-contrato-vs-medicao — reprova quando o contrato afirma um volume que a medição desmente.

★ POR QUE EXISTE (2026-08-19)

O `CLAUDE.md` é lido por toda sessão e por todo agente antes de agir. Em 2026-08-19 ele
afirmava, em negrito, **"Estado atual: publicação zero"** e **"nenhuma página jurídica
pública"** — enquanto o `published_manifest.jsonl` tinha **9.710** linhas, `public/` tinha
9.930 HTMLs e o portal respondia 200 em produção desde 13/08. Seis dias de descompasso.

O custo disso não é estético. Um contrato que mente faz o agente decidir errado: o plano
de trabalho daquela sessão chegou a propor "publicar as ~104 páginas prontas" porque a
documentação induzia a existir estoque parado — quando os 104 registros são tombstones
sem corpo. A regra R1 do `docs/CONTRATO_DADO_REAL.md` já dizia que comentário que mente é
bug a corrigir; faltava o detector.

★ O QUE ELE CHECA, E POR QUE ASSIM

Ancora em NÚMERO, não em prosa. Procurar a frase "publicação zero" seria frágil nos dois
sentidos: some quando alguém reescreve o texto, e dispara falso positivo quando a frase
aparece num registro histórico ("este arquivo afirmou X até tal data"). O check extrai o
volume que o contrato DECLARA e compara com o volume MEDIDO no manifest.

Tolerância: publicação acontece em lote e o contrato não é reescrito a cada página. O
limite é 5% ou 200 páginas, o que for maior — o suficiente para não reprovar por um lote
do dia, e apertado o bastante para pegar "zero contra 9.710".

Saída: exit 0 quando fecha, exit 1 quando diverge (o exit code é o produto — este arquivo
é `check-*`, portanto READ-ONLY: não escreve nada em disco).
"""

from __future__ import annotations

import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
CONTRATO = RAIZ / "CLAUDE.md"
MANIFEST = RAIZ / "data" / "editorial" / "published_manifest.jsonl"

# Frases de volume-zero que não podem coexistir com manifest povoado. Cada uma só conta
# quando NÃO está num contexto de registro histórico (ver `_e_registro_historico`).
FRASES_ZERO = (
    "publicação zero",
    "nenhuma página jurídica pública",
    "publicacao zero",
)

# "Estado atual (medido em AAAA-MM-DD): N.NNN páginas públicas no ar."
# APONTA_INSTRUMENTO: a alternativa de nao declarar numero. O contrato tem de
# nomear onde o estado se mede -- CHECKPOINT.md, este proprio gate, ou o
# manifesto. Basta uma ocorrencia.
APONTA_INSTRUMENTO = re.compile(
    r"(CHECKPOINT\.md|check-contrato-vs-medicao|published_manifest)", re.IGNORECASE
)

DECLARACAO = re.compile(
    r"Estado atual[^:]*:\s*\*{0,2}([\d.  ]+)\s*páginas? públicas?", re.IGNORECASE
)


def _inteiro(texto: str) -> int:
    return int(re.sub(r"[^\d]", "", texto))


def _e_registro_historico(linha: str) -> bool:
    """Distingue AFIRMAR de REGISTRAR que a afirmação era falsa.

    Uma linha que diz «este parágrafo afirmou "publicação zero" até 2026-08-19» é a
    correção, não o defeito — reprovar nela seria punir exatamente a honestidade que o
    contrato pede. O sinal é o verbo no passado junto de uma data.
    """
    marcas = ("afirmou", "trazia até", "até 2026-", "foi superada", "regra antiga")
    if any(m in linha for m in marcas):
        return True
    # AMPLIADO EM 2026-08-29 (BUG-106): o GOAL.md e o AGENTS.md registram estado
    # por CICLO, e a própria linha se anuncia como tal — "Registro histórico do
    # ciclo 376 em 2026-06-19", "Atualização viva do ciclo 393 em 2026-06-21".
    # Essas linhas SÃO o registro datado que o projeto quer preservar; apagá-las
    # seria reescrever a história, e acusá-las seria punir o registro.
    #
    # O que continua sendo acusado é o contador que se apresenta como estado
    # ATUAL sem data de ciclo — que é o caso perigoso, porque o leitor não tem
    # como saber que está lendo junho.
    #
    # A data no rótulo é obrigatória de propósito: "registro histórico" sem data
    # é rótulo que qualquer parágrafo pode vestir para escapar do gate.
    if re.search(r"(registro histórico|atualização viva|estado operacional).{0,80}\d{4}-\d{2}-\d{2}", linha, re.IGNORECASE):
        return True
    if re.search(r"ciclo\s+\d+\s+em\s+\d{4}-\d{2}-\d{2}", linha, re.IGNORECASE):
        return True
    return False


def medir_manifest() -> tuple[int, int]:
    if not MANIFEST.exists():
        return 0, 0
    linhas = 0
    ids: set[str] = set()
    with MANIFEST.open(encoding="utf-8") as fh:
        for linha in fh:
            linha = linha.strip()
            if not linha:
                continue
            linhas += 1
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            # A chave é unique_intent_id, NÃO intent_id — armadilha catalogada em
            # docs/ARQUITETURA_FIEL.md que já custou um erro jurídico quase enterrado.
            uid = registro.get("unique_intent_id")
            if uid:
                ids.add(uid)
    return linhas, len(ids)


# CONTADOR EM FORMA DE CHAVE=VALOR (2026-08-29, BUG-106 da caça).
#
# As FRASES_ZERO acima cobrem prosa ("publicação zero"). O GOAL.md declara o
# mesmo fato em outra forma, que passava batido: `published_manifest=0`,
# `deficit_to_10000=10000`, `publication_allowed=0`. E o faz em quatro
# parágrafos, três deles se autodeclarando como atualização que "prevalece sobre
# qualquer parágrafo histórico abaixo".
#
# Isso importa porque o GOAL.md é o PRIMEIRO na cadeia de precedência do
# projeto, e agente lê por grep: quem casar aquele parágrafo conclui que o
# portal nunca publicou nada e planeja em cima disso. Já aconteceu — uma sessão
# propôs "publicar as ~104 páginas prontas" porque a documentação induzia a
# existir estoque parado.
CONTADORES_ZERO = (
    re.compile(r"`?published_manifest\s*=\s*0`?"),
    re.compile(r"`?deficit_to_10000\s*=\s*10000`?"),
    re.compile(r"`?publication_allowed\s*=\s*0`?"),
)

# Contratos que um agente lê ANTES de agir. CLAUDE.md é o principal; GOAL.md e
# AGENTS.md vêm antes dele na precedência declarada do projeto.
CONTRATOS_EXTRA = ("GOAL.md", "AGENTS.md")


def varre_contrato_extra(nome: str, publicadas: int) -> list[str]:
    """Acusa contador de volume-zero que se apresenta como ESTADO, não como registro."""
    caminho = RAIZ / nome
    if not caminho.exists() or publicadas <= 0:
        return []
    achados: list[str] = []
    for numero, linha in enumerate(caminho.read_text(encoding="utf-8").splitlines(), start=1):
        if _e_registro_historico(linha):
            continue
        # Linha que já se declara vencida (o aviso do topo, por exemplo) não é
        # afirmação de estado: é a correção do problema, e acusá-la seria
        # transformar o remédio em doença.
        baixa = linha.lower()
        if "vencido" in baixa or "fotografia de junho" in baixa or "caça aos bugs" in baixa:
            continue
        # BLOCO DE CITAÇÃO markdown (linha iniciada por ">") é meta-comentário:
        # o aviso que DESCREVE o contador vencido precisa citá-lo para explicar
        # onde ele está. Acusar o aviso transformaria o remédio em doença — e foi
        # exatamente o que aconteceu na primeira execução deste gate estendido,
        # que reprovou a própria nota de correção que acabara de ser escrita.
        if linha.lstrip().startswith(">"):
            continue
        for padrao in CONTADORES_ZERO:
            if padrao.search(linha):
                achados.append(
                    "%s:%d declara %s como estado, mas o published_manifest tem %d páginas"
                    % (nome, numero, padrao.pattern.strip("`?"), publicadas)
                )
                break
    return achados


def main() -> int:
    if not CONTRATO.exists():
        print("check-contrato-vs-medicao: CLAUDE.md não encontrado", file=sys.stderr)
        return 1

    texto = CONTRATO.read_text(encoding="utf-8")
    linhas_manifest, publicadas = medir_manifest()
    problemas: list[str] = []

    for numero, linha in enumerate(texto.splitlines(), start=1):
        if _e_registro_historico(linha):
            continue
        for frase in FRASES_ZERO:
            if frase in linha.lower() and publicadas > 0:
                problemas.append(
                    "CLAUDE.md:%d afirma %r, mas o published_manifest tem %d páginas"
                    % (numero, frase, publicadas)
                )

    declarado = None
    achado = DECLARACAO.search(texto)
    if achado:
        declarado = _inteiro(achado.group(1))
        folga = max(200, int(publicadas * 0.05))
        if abs(declarado - publicadas) > folga:
            problemas.append(
                "CLAUDE.md declara %d páginas públicas; o manifest mede %d "
                "(diferença %d, tolerância %d)"
                % (declarado, publicadas, abs(declarado - publicadas), folga)
            )
    elif publicadas > 0:
        # NAO DECLARAR E' ROTA VALIDA desde 2026-09-16 -- e a regra 19 do contrato:
        # numero de estado envelhece por construcao, entao o contrato diz ONDE
        # MEDIR e nunca QUANTO E. Contrato que nao afirma volume nao pode mentir
        # sobre ele, que e a unica coisa que este gate existe para impedir.
        #
        # O que ele NAO pode e' ficar mudo: sem a declaracao, tem de apontar o
        # instrumento, senao "nao declarar" vira desculpa para o contrato nao
        # responder por nada. As duas rotas sao aceitas e o gate diz qual valeu.
        if not APONTA_INSTRUMENTO.search(texto):
            problemas.append(
                "CLAUDE.md não declara volume publicado NEM aponta onde medi-lo. "
                'Escolha uma: declare "Estado atual (medido em AAAA-MM-DD): N páginas '
                'públicas no ar", ou aponte o instrumento (CHECKPOINT.md, '
                "./tools/check-contrato-vs-medicao, published_manifest)."
            )

    for nome in CONTRATOS_EXTRA:
        problemas.extend(varre_contrato_extra(nome, publicadas))

    print("published_manifest : %d linhas, %d unique_intent_id" % (linhas_manifest, publicadas))
    if declarado is not None:
        print("CLAUDE.md declara  : %d páginas" % declarado)
    elif APONTA_INSTRUMENTO.search(texto):
        print("CLAUDE.md declara  : (não declara número — aponta o instrumento, regra 19)")
    else:
        print("CLAUDE.md declara  : (não declarado e sem instrumento apontado)")

    if problemas:
        print()
        for p in problemas:
            print("REPROVADO: %s" % p)
        print()
        print("O contrato é lido por toda sessão e por todo agente antes de agir.")
        print("Número errado ali não é detalhe de documentação: é decisão errada a jusante.")
        return 1

    print("OK: o que o contrato afirma bate com o que o manifest mede.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
