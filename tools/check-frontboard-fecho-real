#!/usr/bin/env python3
"""Todo SHA de fecho do frontboard aponta para um commit que EXISTE.

★ POR QUE ISTO E UM GATE, E NAO UM CONSELHO

A licao "SHA de fecho so existe depois do commit" foi escrita em prosa em
2026-08-29, no corpo do commit `54cb3856`, que corrigiu quatro fechos apontando
para nada. Entre 13:24 e 14:33 do MESMO DIA foram escritos mais quatro. Prosa
nao segurou; por isso ela vira comando.

Medido em 2026-08-30, antes deste gate existir: quatro fechos do
`p0_frontboard.jsonl` citavam commits inexistentes —

    BUG-048 -> 47db4fb1     BUG-134 -> 47db4fb1
    BUG-079 -> 1d9b0a94     BUG-147 -> a2d63d0e

— e a cadeia de prova de cada um estava quebrada de forma PERMANENTE: o SHA foi
digitado, nao lido de `git rev-parse`, entao nao ha o que consertar sem
reabrir o log e procurar o commit que de fato fez o trabalho.

O campo aceita LISTA separada por espaco (o BUG-174 fecha em tres commits), e
cada elemento e verificado separadamente — foi essa forma que fez uma verificacao
anterior acusar o BUG-174 de fantasma sendo que os tres existiam.

Uso:
    ./tools/check-frontboard-fecho-real [caminho-do-jsonl]
"""
import json
import pathlib
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
PADRAO = RAIZ / ".agents/runtime/p0_frontboard.jsonl"


def commit_existe(sha):
    resultado = subprocess.run(
        ["git", "-C", str(RAIZ), "cat-file", "-t", sha],
        capture_output=True, text=True)
    return resultado.returncode == 0 and resultado.stdout.strip() == "commit"


def main(argv):
    caminho = pathlib.Path(argv[0]) if argv else PADRAO
    if not caminho.is_absolute():
        caminho = RAIZ / caminho
    if not caminho.is_file():
        print(f"REPROVADO: placar ausente: {caminho}")
        return 1
    fantasmas = []
    verificados = 0
    linhas = 0
    for numero, linha in enumerate(
            caminho.read_text(encoding="utf-8").splitlines(), start=1):
        if not linha.strip():
            continue
        linhas += 1
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError as erro:
            print(f"REPROVADO: linha {numero} nao e JSON: {erro}")
            return 1
        bruto = str(registro.get("commit") or "").strip()
        if not bruto:
            continue
        for sha in bruto.split():
            verificados += 1
            if not commit_existe(sha):
                fantasmas.append(
                    (numero, registro.get("id") or registro.get("bug") or "?",
                     sha))
    if fantasmas:
        print(f"REPROVADO: {len(fantasmas)} fecho(s) apontando para commit "
              f"inexistente — SHA se le de `git rev-parse HEAD` DEPOIS do "
              f"commit, nunca se digita:")
        for numero, identificador, sha in fantasmas:
            print(f"    linha {numero}  {identificador}  {sha}")
        return 1
    print(f"check-frontboard-fecho-real: pass — {linhas} registro(s), "
          f"{verificados} SHA(s) de fecho, todos existem")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
