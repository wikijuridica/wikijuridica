RAIZ = os.environ.get("WIKI_ROOT", os.path.dirname(os.path.abspath(os.path.dirname(__file__))))
ENV_PADRAO = os.path.join(RAIZ, ".env.local")
FAIXAS_PADRAO = os.path.join(RAIZ, "data/ops/bot_ip_ranges")
LOG_PADRAO = "/var/log/nginx/wikijuridica"
