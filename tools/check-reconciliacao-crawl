#   faixas     — arquivos de data/ops/bot_ip_ranges/ cujo `prefixes` autentica
#                esse agente (campo `authenticates_agents` do próprio arquivo).
CRAWLERS = {
    # Googlebot/2.1 exclui de propósito GoogleOther e Googlebot-Image, que têm
    # token próprio de User-Agent e são outro crawler, com outro orçamento.
    "googlebot": {"ua_like": "%Googlebot/2.1%", "ua_marca": "Googlebot/2.1",
                  "faixas": ["googlebot.json"]},
    "bingbot": {"ua_like": "%bingbot%", "ua_marca": "bingbot",
                "faixas": ["bingbot.json"]},
    "gptbot": {"ua_like": "%GPTBot%", "ua_marca": "GPTBot",
               "faixas": ["openai-gptbot.json"]},
    "oai-searchbot": {"ua_like": "%OAI-SearchBot%", "ua_marca": "OAI-SearchBot",
                      "faixas": ["openai-searchbot.json"]},
    "chatgpt-user": {"ua_like": "%ChatGPT-User%", "ua_marca": "ChatGPT-User",
                     "faixas": ["openai-chatgpt-user.json"]},
    "claudebot": {"ua_like": "%ClaudeBot%", "ua_marca": "ClaudeBot",
                  "faixas": ["anthropic.json"]},
    "perplexitybot": {"ua_like": "%PerplexityBot%", "ua_marca": "PerplexityBot",
                      "faixas": ["perplexitybot.json"]},
    "duckduckbot": {"ua_like": "%DuckDuckBot%", "ua_marca": "DuckDuckBot",
                    "faixas": ["duckduckbot.json"]},
}

CONSULTA = """
query($zone: String!, $since: Time!, $until: Time!, $limite: Int!, $ua: String!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: $limite,
        filter: {datetime_geq: $since, datetime_leq: $until, userAgent_like: $ua},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      dimensions { cacheStatus verifiedBotCategory }
    }
  } }
}
"""

# Formato `log_format wj_main` do vhost vivo (ops/nginx/standalone/nginx.conf):
#
#   IP - [data] host=H "GET /path HTTP/1.1" STATUS BYTES "UA" allow=1 bot_sim=- ...
#
# Só os quatro campos que a reconciliação usa saem capturados. O resto da linha
# (allow=, bot_sim=, rt=, cf_ray=, inm=, ims=) é deliberadamente ignorado: a
# população da borda não conhece nenhum deles, e filtrar por um campo que só a
# origem enxerga faria os dois lados contarem coisas diferentes — que é
# precisamente o defeito auditado aqui.
LINHA = re.compile(
    r'^(?P<ip>\S+) \S+ \[(?P<data>[^\]]+)\] host=\S+ '
    r'"(?P<req>[^"]*)" (?P<status>\d{3}) \S+ "(?P<ua>[^"]*)"')

# Três sigma sobre a contagem da borda.
#
# QUANDO O DATASET É AMOSTRADO (sampleInterval s > 1) este é o erro de
# amostragem próprio: uma contagem estimada como k×s, a partir de k grupos
# sorteados com probabilidade 1/s, tem desvio-padrão ~ s·sqrt(k). Três desvios
# é o envelope.
#
# QUANDO s = 1 a borda é censo e o erro de amostragem é ZERO — o termo continua
# valendo, mas como envelope proporcional ao volume para as divergências
# LEGÍTIMAS que não são amostragem, listadas no PISO abaixo. Chamar isso de
# "erro de amostragem" com s=1 seria comentário que mente.
SIGMAS = 3.0

# Piso absoluto da tolerância.
#
# Existem três classes de divergência legítima que não escalam com sqrt(k) e
# que apareceriam como falso positivo num volume baixo como o medido hoje
# (13 requisições/dia):
#
#   1. FRONTEIRA DO DIA. Requisição carimbada 23:59:59,7 UTC na borda chega à
#      origem em 00:00:00,1 do dia seguinte. Cai em (c) de um dia e em (a) do
#      outro. Nos volumes medidos é <= 1 evento/dia.
#   2. REQUISIÇÃO QUE A BORDA TERMINA SOZINHA. Bloqueio de WAF, 403/429 de
#      borda, redirecionamento e HTTP->HTTPS entram em (c) e NUNCA chegam à
#      origem. É por isso que (c) > (a) é o desvio esperado, não anomalia.
#   3. `stale` e `updating`. A borda serve do cache e revalida à parte; contam
#      como não-hit e podem produzir a linha de origem em outro instante.
#
# 5 cobre as três com folga no volume medido e ainda REPROVA o caso que
# originou a ferramenta: origem 13 contra borda 0 dá |13-0| = 13 > 5. Se o
# piso fosse generoso a ponto de absorver 13, a ferramenta nasceria cega para
# o próprio defeito que veio apanhar.
PISO_TOLERANCIA = 5.0


