ZONE_TAG = "b2e1366a94c5dcac97f2fc264f18928f"

# Retenção do httpRequestsAdaptiveGroups, medida contra a própria API por
# tools/generate-bot-agents-daily e tools/measure-crawl-coverage: pedir dia mais
# velho devolve `code: quota`, "cannot request data older than 1w1d". Recusar
