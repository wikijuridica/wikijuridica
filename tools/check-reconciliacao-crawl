# truncamento fica de pé mesmo assim, porque grupo cortado subestimaria (c) e
# faria a ferramenta acusar divergência que não existe.
LIMITE_GRUPOS = 1000

# Registry dos crawlers reconciliáveis: só entra quem tem faixa de IP publicada
# pelo operador em data/ops/bot_ip_ranges/. Sem faixa oficial não existe
# contagem de origem confiável (ver o bloco sobre a inflação de 177x), e um
# crawler sem faixa aqui seria um número inventado com cara de medição.
#
#   ua_like    — o filtro `userAgent_like` do GraphQL da borda.
#   ua_marca   — a subcadeia que identifica o mesmo agente na linha do log de
#                origem. TEM de selecionar a MESMA população que `ua_like`,
