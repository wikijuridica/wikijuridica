#!/usr/bin/env python3
"""check-rollback-retention — quanto disco os snapshots de rollback ocupam, e
quais deles ainda servem para alguma coisa.

O PROBLEMA, medido em 2026-08-20: 74 snapshots ocupando 7,2 GB, a 101 MB cada.
Com a publicacao diaria que entrou hoje, isso passa a crescer ~101 MB POR DIA --
cerca de 36 GB por ano para preservar um delta que, na cadencia do plano, e de
13 a 20 paginas. O contraste que dimensiona: public/ inteiro ocupa 296 MB para
10 mil paginas.

A compressao aplicada no publicador (gzip, medido 4,3x no pages.json) leva o
snapshot novo de 101 MB para ~20 MB. Isto aqui trata do que JA existe.

A POLITICA, e por que ela nao apaga nada sozinha:

  - mantem os N ULTIMOS (padrao 10): rollback de verdade e sempre para tras
    poucos passos; ninguem restaura a publicacao de duas semanas atras, porque
    o conteudo mudou inteiro desde entao;
  - mantem O ULTIMO DE CADA DIA nos ultimos D dias (padrao 14): cobre o caso
    "algo quebrou e so notamos depois";
  - o resto e CANDIDATO a remocao, e a ferramenta apenas LISTA.

Ela nao apaga porque snapshot e o unico caminho de volta de uma publicacao, e o
contrato deste repositorio e explicito sobre nao reverter nem destruir estado. A
decisao de remover e de quem opera, com o numero na frente -- e por isso o
relatorio traz o numero.

Read-only. Uso:
    tools/check-rollback-retention
    tools/check-rollback-retention --manter 10 --dias 14 --json
    tools/check-rollback-retention --imprimir-comando
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
BASE = RAIZ / "data/ops"
PADRAO = re.compile(r"^publish-rollback-(\d{8})-(\d{6})$")


def tamanho(caminho: Path) -> int:
    total = 0
    for item in caminho.rglob("*"):
        if item.is_file():
            total += item.stat().st_size
    return total


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--manter", type=int, default=10,
                            help="quantos snapshots mais recentes preservar")
    analisador.add_argument("--dias", type=int, default=14,
                            help="por quantos dias preservar o último de cada dia")
    analisador.add_argument("--json", action="store_true")
    analisador.add_argument("--imprimir-comando", action="store_true",
                            help="imprime o comando de remoção, sem executá-lo")
    argumentos = analisador.parse_args()

    snapshots = []
    for item in sorted(BASE.iterdir()):
        if not item.is_dir():
            continue
        casa = PADRAO.match(item.name)
        if not casa:
            continue
        snapshots.append({"nome": item.name, "dia": casa.group(1),
                          "caminho": item, "bytes": tamanho(item)})
    if not snapshots:
        print("nenhum snapshot de rollback")
        return 0

    snapshots.sort(key=lambda s: s["nome"])
    total = sum(s["bytes"] for s in snapshots)

    manter = {s["nome"] for s in snapshots[-argumentos.manter:]}
    ultimo_do_dia: dict[str, str] = {}
    for s in snapshots:
        ultimo_do_dia[s["dia"]] = s["nome"]
    dias_recentes = sorted(ultimo_do_dia)[-argumentos.dias:]
    for dia in dias_recentes:
        manter.add(ultimo_do_dia[dia])

    candidatos = [s for s in snapshots if s["nome"] not in manter]
    liberavel = sum(s["bytes"] for s in candidatos)

    if argumentos.json:
        print(json.dumps({
            "total": len(snapshots), "bytes_total": total,
            "manter": sorted(manter), "candidatos": [s["nome"] for s in candidatos],
            "bytes_liberaveis": liberavel,
        }, ensure_ascii=False, indent=1))
    else:
        print(f"snapshots de rollback : {len(snapshots)}")
        print(f"ocupacao total        : {total/1073741824:.2f} GB "
              f"(media {total/len(snapshots)/1048576:.0f} MB cada)")
        print(f"politica              : os {argumentos.manter} ultimos + "
              f"o ultimo de cada dia nos ultimos {argumentos.dias} dias")
        print(f"preservados           : {len(manter)}")
        print(f"candidatos a remocao  : {len(candidatos)} "
              f"({liberavel/1073741824:.2f} GB)")
        if candidatos:
            print(f"  mais antigo: {candidatos[0]['nome']}")
            print(f"  mais novo  : {candidatos[-1]['nome']}")

    if argumentos.imprimir_comando and candidatos:
        print("\n# Remocao — CONFIRA antes de rodar. Snapshot e o unico caminho de")
        print("# volta de uma publicacao, e esta ferramenta nunca apaga sozinha.")
        for s in candidatos:
            print(f"rm -rf {s['caminho'].relative_to(RAIZ)}")

    # Exit 1 quando ha o que liberar E o volume passou de 2 GB: abaixo disso o
    # desperdicio nao justifica interromper nada.
    if liberavel > 2 * 1073741824:
        print(f"\nATENCAO: {liberavel/1073741824:.1f} GB em snapshots que a politica "
              "considera dispensaveis.", file=sys.stderr)
        print("  Rode com --imprimir-comando para ver a lista de remocao.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
