#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:authorial-mass-controlled-promotion:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=167}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/editorial/authorial_mass_controlled_promotion_rehearsal.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-authorial-mass-controlled-promotion}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/editorial/authorial_mass_controlled_promotion_rehearsal.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-900}"
exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-authorial-mass-controlled-promotion --timings "$@"
