#!/usr/bin/env python3
"""Desativa os plugins de MCP que custam RAM sem servir a este projeto.

Critérios (documentados em docs/ops/CLAUDE_CODE_MCP_FOOTPRINT.md):
  1. transporte  — só MCP stdio sobe processo local; http/remoto custa contexto, não RAM
  2. contrato    — CLAUDE.md proíbe SaaS proprietário e nuvem de terceiros
  3. redundância — capacidade já coberta por ferramenta nativa ou outro plugin
  4. uso medido  — CPU acumulado e data de instalacao; o toolUsage de ~/.claude.json
                   NAO serve: parou de gravar em 2026-02-26, para todas as ferramentas

Marca como `false` em vez de remover a chave: o registro de que foi desativado, e por quê,
fica auditável, e reverter é trocar uma palavra. Preserva o estado anterior antes de escrever.

Uso:  tools/generate-claude-mcp-trim [--apply]     (sem --apply só mostra o que faria)
"""
import json
import os
import shutil
import sys
import datetime

PROJETO = "/opt/wiki/.claude/settings.json"
GLOBAL = os.path.expanduser("~/.claude/settings.json")
BACKUP_DIR = "/opt/wiki/.agents/runtime/claude-settings-backup"

# plugin -> (RAM medida em MB, motivo)
CORTAR = {
    "chrome-devtools-mcp": (688, "4a pilha de browser da maquina; claude-in-chrome ja e nativo"),
    "aikido": (406, "SaaS de seguranca; semgrep local ja faz SAST, instalado hoje"),
    "convex": (367, "BaaS proprietario; o portal serve estatico com banco JSONL"),
    "playwright": (365, "redundante com claude-in-chrome, que e nativo; sem uso registrado"),
    "desktop-commander": (348, "duplica Bash/Read/Write/Edit nativos; instalado hoje"),
    "browser-use": (308, "3a pilha de browser; instalado hoje"),
    "data-agent-kit-starter-pack": (154, "13 servidores stdio, todos GCP — proibicao explicita do CLAUDE.md"),
    "terraform": (96, "IaC de nuvem que o projeto nao usa; sem TFE_TOKEN entra em churn"),
    "codspeed": (0, "benchmark SaaS; instalado hoje"),
    "fakechat": (0, "plugin de demonstracao"),
    "laravel-boost": (0, "roda `php artisan` — o projeto e Go, nao PHP"),
}

SUFIXO = "@claude-plugins-official"


def carregar(caminho):
    with open(caminho, encoding="utf-8") as fh:
        return json.load(fh)


def preservar(caminho):
    """Copia o settings antes de escrever nele.

    O nome leva a ORIGEM, não só o basename: os dois arquivos se chamam `settings.json`,
    e um carimbo com resolução de segundo os fazia colidir no mesmo destino — o segundo
    backup sobrescrevia o primeiro, e a ferramenta prometia preservação sem cumprir.
    """
    os.makedirs(BACKUP_DIR, exist_ok=True)
    origem = "projeto" if caminho == PROJETO else "global"
    carimbo = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    destino = os.path.join(BACKUP_DIR, f"{origem}-settings.json.{carimbo}")
    if os.path.exists(destino):  # duas execuções no mesmo segundo
        destino = f"{destino}.{os.getpid()}"
    shutil.copy2(caminho, destino)
    return destino


def trim(caminho, aplicar):
    dados = carregar(caminho)
    plugins = dados.get("enabledPlugins", {})
    tocados = []
    for nome, (ram, motivo) in CORTAR.items():
        chave = nome + SUFIXO
        if plugins.get(chave) is True:
            tocados.append((nome, ram, motivo))
            if aplicar:
                plugins[chave] = False
    if tocados and aplicar:
        origem = preservar(caminho)
        tmp = caminho + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(dados, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        json.load(open(tmp, encoding="utf-8"))  # valida antes de trocar
        os.replace(tmp, caminho)
        print(f"  estado anterior preservado em {origem}")
    return tocados


def main():
    aplicar = "--apply" in sys.argv
    total = 0
    for caminho in (PROJETO, GLOBAL):
        if not os.path.exists(caminho):
            continue
        print(f"\n{caminho}")
        tocados = trim(caminho, aplicar)
        if not tocados:
            print("  nada a desativar")
            continue
        for nome, ram, motivo in sorted(tocados, key=lambda t: -t[1]):
            peso = f"{ram} MB" if ram else "stdio"
            print(f"  {'desativado' if aplicar else 'desativaria'}  {nome:<30} {peso:>7}  {motivo}")
            total += ram
    # `total` soma o RSS agregado de TODAS as instancias vivas de cada servidor na maquina —
    # nao e o ganho de uma sessao.
    print(f"\nRSS agregado hoje na maquina, nos servidores desativados: ~{total} MB")
    print("Por sessao nova, medido com tools/measure-mcp-session-footprint:")
    print("  antes 1.883 MB em 24 processos -> depois 28 MB em 2 (lumen + hook do semgrep).")
    if not aplicar:
        print("(simulacao — repita com --apply para gravar)")


if __name__ == "__main__":
    main()
