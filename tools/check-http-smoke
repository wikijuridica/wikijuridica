#!/usr/bin/env bash
# Smoke HTTP do portal. A IMPLEMENTACAO E GO: internal/checks/checks.go, funcao
# checkHTTPSmoke. Este arquivo so' chama o runner -- procurar defeito aqui e'
# procurar no lugar errado.
#
# O QUE ELE COBRE, e por que a lista importa para quem faz deploy:
#   - o ACERVO, montando httpserver.New em processo e exercitando as rotas do
#     content/ e do published_manifest contra o handler;
#   - a REDE SOCIAL viva em 127.0.0.1:8091 (cmd/social), sondada pela PORTA --
#     ver internal/checks/http_smoke_redesocial.go.
#
# A rede social entrou em 2026-09-05. Ate esse dia `grep 8091` neste arquivo e
# na implementacao dele devolvia ZERO, e o smoke passava verde com /redesocial/
# inteira fora do ar: cego justamente para a superficie que o deploy do binario
# social acabara de mudar. Smoke que nao olha o que mudou da' confianca falsa no
# momento em que a confianca importa.
#
# Durante um deploy o :8091 fica fora DE PROPOSITO, e o gate cala nessa janela
# (lock data/ops/.deploy-em-curso.lock, ate 30 min) -- a mesma disciplina de
# tools/check-portal-health:441. A linha de aprovacao DIZ qual dos dois casos
# ocorreu: `redesocial=sondada base=... rotas=6` ou
# `redesocial=nao_sondada motivo=deploy_em_curso`.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
exec "$ROOT/tools/run-check" http-smoke "$@"
