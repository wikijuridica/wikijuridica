# Identificacao propria, pela mesma razao medida em 2026-09-05 e registrada no
# CLAUDE.md §11: sem o prefixo "Mozilla/5.0 (compatible;" o WAF do Planalto
# (F5 BIG-IP) devolve `Recv failure`. Nome e URL de documentacao ficam dentro do
# parentese, que e onde o operador do site olha.
UA = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
      "+https://wikijuridica.com.br/bot/; coleta-oficial)")

# As tres formas que o renderizador SABE construir a partir do componente da URN
# LexML. Inciso e alinea ficam de fora porque `lexml.normalizaDispositivo` falha
# fechado neles: o componente nunca os carrega, entao nao ha o que casar.
FORMA_ARTIGO_PURO = re.compile(r"^art(\d+)$")
FORMA_ARTIGO_LETRADO = re.compile(r"^art(\d+)([a-z]{1,2})$")
FORMA_PARAGRAFO = re.compile(r"^art(\d+[a-z]{0,2})§(\d+)$")
# O INCISO tem a MESMA forma do artigo letrado e significado oposto — `art19ii` e
# o art. 19, inciso II, nao o "art. 19-II". Quem desempata e o TEXTO, nunca a
# forma, e por isso esta constante nao chega a ser consultada antes de o ramo
# letrado falhar. Medido em 2026-09-11 no `amostra_recusada` do proprio registry:
# 1.862 ancoras com esta forma foram recusadas, e 1.722 (92,5%) tem, logo depois
# de si, o texto do proprio inciso ("I - a denominacao...", "IV - a modalidade").
# O grupo do artigo e `\d+` PURO, sem sufixo de letra: com `[a-z]{0,2}` ali, o
# backtracking parte "art19ii" em ("19i", "i") e o oraculo passa a esperar o
# inciso I onde o documento diz II — a ancora legitima seria recusada por uma
# ambiguidade que a propria regex criou. Artigo letrado COM inciso colado
# (`art54aii`) fica de fora por enquanto, e fica de fora declarado.
FORMA_INCISO = re.compile(r"^art(\d+)([ivxlcdm]{1,6})$")

# Um link inline para o Planalto no HTML servido, com ou sem fragmento. O
# fragmento sai da contagem: o que interessa e QUAL documento o acervo alcanca.
RE_LINK_INLINE = re.compile(
    r'href="(https://www\.planalto\.gov\.br/[^"#]+\.htm)(?:#[^"]*)?"')


class ColetorDeAncorasComTexto(HTMLParser):
    """Guarda cada id/name na ORDEM em que aparece e o texto que vem depois.

    O texto e o que decide se `art54a` e o "Art. 54-A" ou o inciso de um artigo
    letrado. Sem ele a classificacao seria palpite por forma.
    """

    JANELA = 160

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.eventos: list[tuple[str, str]] = []
        self.ids: list[str] = []

    def handle_starttag(self, tag, attrs):
        for nome, valor in attrs:
            if nome in ("id", "name") and valor and valor.strip():
                limpo = valor.strip()
                self.eventos.append(("ancora", limpo))
                self.ids.append(limpo)

    def handle_data(self, data):
        if data.strip():
            self.eventos.append(("texto", data))

    def texto_apos_cada_ancora(self) -> dict[str, list[str]]:
        """Para cada id, TODOS os textos seguintes (um por ocorrencia), ate `JANELA`.

        Nao e a primeira ocorrencia que vence: sao todas. O mesmo id aparece mais
        de uma vez em documento do Planalto (sumario e corpo), e ha o caso que a
        sessao par nomeou — `art104a` pode ser a ancora do "Art. 104-A" NUMA
        ocorrencia e a da "alinea a" do art. 104 em OUTRA. As duas existem, as
        duas levam a lugares diferentes, e emitir a chave seria um link que
        funciona e mente. Quem classifica precisa ver as duas para recusar.

        Ocorrencia sem texto seguinte (ancora vazia de sumario) nao entra: ela nao
        afirma nada e recusar por causa dela seria perder ancora boa.
        """
        resultado: dict[str, list[str]] = {}
        for indice, (tipo, valor) in enumerate(self.eventos):
            if tipo != "ancora":
                continue
            pedacos: list[str] = []
            tamanho = 0
            for tipo_seguinte, texto in self.eventos[indice + 1:]:
                if tipo_seguinte == "ancora":
                    if tamanho == 0:
                        continue
                    break
                pedacos.append(texto)
                tamanho += len(texto)
                if tamanho >= self.JANELA:
                    break
            junto = normaliza_espaco(" ".join(pedacos))[: self.JANELA]
            resultado.setdefault(valor, [])
            if junto:
                resultado[valor].append(junto)
        return resultado


def normaliza_espaco(texto: str) -> str:
    return re.sub(r"\s+", " ", texto.replace("\xa0", " ")).strip()


def numero_do_artigo_no_texto(texto: str) -> str | None:
    """"Art. 54-A. Os contratos..." -> "54a"; "Art. 1.789." -> "1789"."""
    casa = re.match(r"^\s*Art(?:igo)?\s*\.?\s*([0-9][0-9.]*)\s*(?:[ºo°]\s*)?(?:-\s*([A-Za-z])\s*)?",
                    texto, re.IGNORECASE)
    if not casa:
        return None
    numero = casa.group(1).replace(".", "").rstrip("-")
    sufixo = (casa.group(2) or "").lower()
    return numero + sufixo


def numero_do_paragrafo_no_texto(texto: str) -> str | None:
    """"§ 3º Prescreve em..." -> "3". Paragrafo unico nao tem numero e sai."""
    casa = re.match(r"^\s*(?:§|&#167;)\s*([0-9]+)", texto)
    return casa.group(1) if casa else None


def numero_do_inciso_no_texto(texto: str) -> str | None:
    """"II - o nome, a qualificacao..." -> "ii"; "IV. a modalidade" -> "iv".

    O SEPARADOR E OBRIGATORIO, e e ele que separa o inciso de uma palavra que
    comeca por letra romana. Sem ele, "Ivo" viraria o inciso IV e "Cidade"
    viraria o inciso C — e o teste `test_palavra_que_comeca_por_romano_nao_vira_inciso`
    existe exatamente para isso.
    """
    casa = re.match(r"^\s*([IVXLCDM]{1,6})\s*[-–—.)]", texto)
    return casa.group(1).lower() if casa else None


def classifica(ancora: str, textos_seguintes: list[str]) -> tuple[str, str]:
    """Devolve (classe, motivo). So `artigo_*` e `paragrafo` entram na tabela.

    UMA ocorrencia que confirma NAO basta: todas as ocorrencias com texto tem de
    concordar. Se uma diz "Art. 104-A" e outra diz "a)", a chave e ambigua DENTRO
    do mesmo documento e nao se emite nenhuma das duas. Recusar custa um link
    raso; emitir custa um link que funciona e leva ao dispositivo errado, que e a
    classe P1 permanente sob a OAB.
    """
    if FORMA_ARTIGO_PURO.match(ancora):
        return "artigo_puro", "forma provada em producao desde 2026-08-26"

    letrado = FORMA_ARTIGO_LETRADO.match(ancora)
    if letrado:
        esperado = letrado.group(1) + letrado.group(2)
        vistos = [numero_do_artigo_no_texto(t) for t in textos_seguintes]
        classe, motivo = veredito_unanime(vistos, esperado, "artigo_letrado",
                                          f"artigo {esperado}")
        if classe != "indeterminado":
            return classe, motivo
        # SEGUNDA PERGUNTA, e so depois de a primeira falhar.
        #
        # O sufixo pode nao ser letra: pode ser algarismo romano. `art19ii` e
        # art. 19, INCISO II, e o texto ao lado diz "II - o nome...", nunca
        # "artigo 19ii". Ate 2026-09-11 o validador so fazia a primeira pergunta
        # e gravava a recusa com o motivo certo para a pergunta errada:
        # "0 ocorrencia(s) dizem artigo 19ii e 1 nao".
        #
        # A ORDEM IMPORTA e nao se inverte: quando o texto diz "Art. 19-I", a
        # ancora E o artigo letrado, e perguntar pelo inciso primeiro roubaria o
        # caso. Quando o texto diz "I - ", a primeira pergunta ja falhou e a
        # segunda e a unica que resta. E quando as ocorrencias discordam entre
        # si, as DUAS falham e a ancora continua fora — que e o desenho original
        # e nao muda.
        indeterminado = (classe, motivo)
        inciso = FORMA_INCISO.match(ancora)
        if inciso:
            vistos_inciso = [numero_do_inciso_no_texto(t) for t in textos_seguintes]
            classe_inciso, motivo_inciso = veredito_unanime(
                vistos_inciso, inciso.group(2), "inciso",
                f"inciso {inciso.group(2).upper()}")
            if classe_inciso != "indeterminado":
                return classe_inciso, motivo_inciso
        return indeterminado

    paragrafo = FORMA_PARAGRAFO.match(ancora)
    if paragrafo:
        esperado = paragrafo.group(2)
        vistos = [numero_do_paragrafo_no_texto(t) for t in textos_seguintes]
        return veredito_unanime(vistos, esperado, "paragrafo",
                                f"§ {esperado}")

    return "fora_do_vocabulario", "forma que o renderizador nao constroi"


def veredito_unanime(vistos: list[str | None], esperado: str, classe: str,
                     rotulo: str) -> tuple[str, str]:
    """`classe` so quando TODA ocorrencia com texto confirma.

    `None` NAO E NEUTRO. `numero_do_artigo_no_texto` devolve None para qualquer
    texto que nao comece por "Art. N" — e o texto de um INCISO ("I - a saude e
    direito...") e exatamente isso. Se None nao contasse como discordancia,
    `art19i` com duas ocorrencias, uma "Art. 19-I" e outra "I - ...", passaria
    como artigo letrado: a ancora existiria, o link funcionaria, e levaria ao
    inciso. Link que funciona e mente e pior que link raso, e e a classe P1
    permanente sob a OAB.

    Ocorrencia com texto VAZIO ja foi descartada antes (ancora de sumario nao
    afirma nada); o que chega aqui e texto que existe e nao casa.
    """
    confirmam = [v for v in vistos if v == esperado]
    discordam = [v for v in vistos if v != esperado]
    if discordam:
        return "indeterminado", (
            f"ambigua no proprio documento: {len(confirmam)} ocorrencia(s) dizem "
            f"{rotulo} e {len(discordam)} nao ({discordam[:3]!r})")
    if not confirmam:
        return "indeterminado", (
            f"nenhuma ocorrencia comeca por {rotulo}; textos vistos: {vistos[:3]!r}")
    return classe, f"{len(confirmam)} ocorrencia(s) comecam por {rotulo}, nenhuma discorda"


def decodifica(bruto: bytes) -> tuple[str, str]:
    for codificacao in ("utf-8", "latin-1"):
        try:
            return bruto.decode(codificacao), codificacao
        except UnicodeDecodeError:
            continue
    return bruto.decode("latin-1", "replace"), "latin-1"


def baixa(url: str, pausa: float, cache: Path | None) -> tuple[bytes, int, str]:
    """Devolve (bytes, status, origem). O cache evita repetir o download do
    mesmo documento quando a ferramenta roda duas vezes no mesmo dia."""
    if cache is not None:
        arquivo = cache / (hashlib.sha256(url.encode("utf-8")).hexdigest() + ".html")
        if arquivo.exists() and arquivo.stat().st_size > 0:
            return arquivo.read_bytes(), 200, "cache"
    pedido = urllib.request.Request(
        url, headers={"User-Agent": UA, "Accept": "text/html,*/*"})
    for tentativa in range(3):
        try:
            with urllib.request.urlopen(pedido, timeout=90) as resposta:
                bruto = resposta.read()
            time.sleep(pausa)
            if cache is not None and bruto:
                cache.mkdir(parents=True, exist_ok=True)
                escreve_atomico(cache / (hashlib.sha256(url.encode("utf-8")).hexdigest() + ".html"), bruto)
            return bruto, 200, "rede"
        except urllib.error.HTTPError as erro:
            time.sleep(pausa)
            return b"", erro.code, "rede"
        except Exception:
            time.sleep(pausa * (tentativa + 2))
    return b"", 0, "rede"


def escreve_atomico(caminho: Path, carga: bytes) -> None:
    caminho.parent.mkdir(parents=True, exist_ok=True)
    fd, temporario = tempfile.mkstemp(prefix=f".{caminho.name}.", dir=caminho.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as arquivo:
            arquivo.write(carga)
            arquivo.flush()
            os.fsync(arquivo.fileno())
        os.replace(temporario, caminho)
    finally:
        if os.path.exists(temporario):
            os.unlink(temporario)


def links_inline_por_url() -> dict[str, int]:
    """Quantos links inline do HTML SERVIDO alcancam cada documento oficial.

    Derivado do dado, nunca escrito a mao — e mais atual que o relatorio do
    `cmd/measure-graph-authority` de 2026-08-26, que nao conhecia
    `del2848compilado.htm` (o Codigo Penal, alvo de 119 links hoje).
    """
    contagem: Counter[str] = Counter()
    arquivos = 0
    for caminho in PUBLIC.rglob("index.html"):
        try:
            html = caminho.read_text(encoding="utf-8")
        except Exception:
            continue
        arquivos += 1
        for casa in RE_LINK_INLINE.finditer(html):
            contagem[casa.group(1)] += 1
    if arquivos == 0:
        raise SystemExit("public/ nao tem index.html: nada a medir")
    print(f"varredura de public/: {arquivos} arquivo(s), "
          f"{sum(contagem.values())} link(s) inline em {len(contagem)} documento(s)")
    return dict(contagem)


def carrega_evidencia(caminho: Path) -> dict[str, dict]:
    if not caminho.exists():
        return {}
    registros = {}
    for linha in caminho.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        registro = json.loads(linha)
        registros[registro["url"]] = registro
    return registros


def emitiveis(registro: dict) -> list[str]:
    """As ancoras que o renderizador pode emitir, ja classificadas."""
    return sorted(set(registro.get("ancoras_de_artigo") or [])
                  | set(registro.get("ancoras_de_artigo_letrado") or [])
                  | set(registro.get("ancoras_de_paragrafo") or [])
                  | set(registro.get("ancoras_de_inciso") or []))


def escreve_tabela(registros: list[dict]) -> None:
    linhas = [
        "// Code generated by tools/generate-planalto-anchor-registry-20260911; DO NOT EDIT.",
        "",
        "package structureddata",
        "",
        "// ancorasDeArtigoPorDocumento e o conjunto REAL de ancoras que o",
        "// renderizador pode emitir para cada documento oficial alcancado pelo",
        "// hiperlink inline. Medido baixando o proprio documento do Planalto e",
        "// lendo os atributos id/name -- nunca deduzido de padrao de URL.",
        "//",
        "// TRES FORMAS, e cada uma entrou por uma prova diferente:",
        "//",
        "//\tartN       artigo puro. Forma medida em 2026-08-26 e em producao",
        "//\t           desde entao; nao passa pela conferencia de texto, porque",
        "//\t           exigi-la agora poderia ENCOLHER a tabela.",
        "//\tartNx      artigo com sufixo de letra (`art54a` = art. 54-A). So",
        "//\t           entra quando o TEXTO logo depois da ancora, no proprio",
        "//\t           documento, comeca por \"Art. 54-A\". A conferencia existe",
        "//\t           porque a letra sozinha e ambigua: `art101p` e o paragrafo",
        "//\t           unico do art. 101 e `art10i` e o inciso I do art. 10.",
        "//\tartN§K     paragrafo numerado (`art206§3` = art. 206, § 3º). So entra",
        "//\t           quando o texto seguinte comeca por \"§ 3\".",
        "//",
        "// O fragmento NUNCA e enviado ao servidor: a URL responde 200 com ancora",
        "// inexistente, nenhum verificador de link acusa, e o leitor cai no topo",
        "// achando que o portal errou o artigo. Por isso vale exato ou nada.",
        "//",
        "// A evidencia por documento (sha256, bytes, data, classificacao de cada",
        "// ancora) esta em data/source-audit/planalto_anchor_registry_20260911.jsonl.",
        "var ancorasDeArtigoPorDocumento = map[string]map[string]struct{}{",
    ]
    for registro in sorted(registros, key=lambda r: r["url"]):
        ancoras = emitiveis(registro)
        if not ancoras:
            continue
        linhas.append(f"\t{go_string(registro['url'])}: {{")
        linha = "\t\t"
        for ancora in ancoras:
            pedaco = f"{go_string(ancora)}: {{}}, "
            if len(linha) + len(pedaco) > 100:
                linhas.append(linha.rstrip())
                linha = "\t\t"
            linha += pedaco
        if linha.strip():
            linhas.append(linha.rstrip())
        linhas.append("\t},")
    linhas.append("}")
    linhas.append("")
    escreve_atomico(TABELA, ("\n".join(linhas)).encode("utf-8"))


def go_string(valor: str) -> str:
    """Literal Go de uma string que pode ter `§` (U+00A7) e acento.

    `json.dumps` escapa como JSON, e JSON e Go coincidem nas sequencias que
    importam aqui (\\u00a7, \\", \\\\). Escrever o § cru tambem compilaria, mas o
    arquivo gerado fica ASCII puro, que e o que o resto de `internal/` faz.
    """
    return json.dumps(valor, ensure_ascii=True)


def mede_documento(url: str, bruto: bytes) -> dict:
    texto, codificacao = decodifica(bruto)
    coletor = ColetorDeAncorasComTexto()
    try:
        coletor.feed(texto)
    except Exception as erro:  # HTML de 3,5 MB com markup antigo interrompe o parser
        print(f"    parser interrompido em {url}: {erro}", file=sys.stderr)
    seguinte = coletor.texto_apos_cada_ancora()
    puros: list[str] = []
    letrados: list[str] = []
    paragrafos: list[str] = []
    incisos: list[str] = []
    recusados: list[dict] = []
    classes: Counter[str] = Counter()
    for ancora in sorted(set(coletor.ids)):
        classe, motivo = classifica(ancora, seguinte.get(ancora, []))
        classes[classe] += 1
        if classe == "artigo_puro":
            puros.append(ancora)
        elif classe == "artigo_letrado":
            letrados.append(ancora)
        elif classe == "paragrafo":
            paragrafos.append(ancora)
        elif classe == "inciso":
            incisos.append(ancora)
        elif classe == "indeterminado" and len(recusados) < 40:
            recusados.append({"ancora": ancora, "motivo": motivo,
                              "texto_seguinte": (seguinte.get(ancora) or [""])[0][:80]})
    return {
        "sha256_documento": hashlib.sha256(bruto).hexdigest(),
        "bytes": len(bruto),
        "encoding": codificacao,
        "ancoras_no_documento": len(set(coletor.ids)),
        "ancoras_de_artigo": puros,
        "ancoras_de_artigo_letrado": letrados,
        "ancoras_de_paragrafo": paragrafos,
        "ancoras_de_inciso": incisos,
        "classes": dict(classes),
        "amostra_recusada": recusados,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pausa", type=float, default=3.5,
                        help="segundos entre downloads (ritmo humano)")
    # PISO DE LINKS, medido em 2026-09-11 no proprio public/: o HTML servido
    # alcanca 699 documentos oficiais com 40.406 links, e a cauda e longa — os
    # 50 primeiros concentram 37.074 links (91,8%) e os 649 restantes dividem
    # ~3.300, media de 5 cada. Baixar os 649 custaria ~48 min de banda do
    # Planalto para links que a tabela nao vai emitir, e cada documento a mais
    # engorda o `.go` gerado, que entra na compilacao de TODA sessao que
    # commitar Go. O piso e explicito e se abaixa de proposito quando a cauda
    # valer a pena — nunca em silencio.
    parser.add_argument("--minimo-de-links", type=int, default=10,
                        help="so confere documento com pelo menos N links no acervo")
    parser.add_argument("--cache", type=Path,
                        default=ROOT / ".cache" / "planalto-anchor-20260911",
                        help="diretorio de cache do HTML baixado")
    parser.add_argument("--sem-cache", action="store_true")
    parser.add_argument("--tabela", action="store_true",
                        help="regrava internal/structureddata/planalto_anchors_generated.go")
    parser.add_argument("--so-tabela", action="store_true",
                        help="nao baixa nada; regrava a tabela a partir da evidencia")
    parser.add_argument("--so-relatorio", action="store_true",
                        help="mede e imprime, sem gravar evidencia nem tabela")
    args = parser.parse_args()

    if args.so_tabela:
        registros = list(carrega_evidencia(EVIDENCIA).values())
        if not registros:
            print(f"{EVIDENCIA} vazio: rode a medicao antes", file=sys.stderr)
            return 2
        escreve_tabela(registros)
        total = sum(len(emitiveis(r)) for r in registros)
        print(f"tabela regerada: {len(registros)} documento(s), {total} ancora(s)")
        return 0

    alvos = links_inline_por_url()
    if not alvos:
        print("nenhum documento oficial alcancado pelo link inline", file=sys.stderr)
        return 2
    ordem = [u for u in sorted(alvos, key=lambda u: -alvos[u])
             if alvos[u] >= args.minimo_de_links]
    fora = len(alvos) - len(ordem)
    links_fora = sum(v for u, v in alvos.items() if v < args.minimo_de_links)
    if fora:
        print(f"piso de {args.minimo_de_links} link(s): {fora} documento(s) de fora, "
              f"{links_fora} link(s) ({links_fora * 100.0 / sum(alvos.values()):.1f}% do total)")
    cache = None if args.sem_cache else args.cache
    print(f"conferindo {len(ordem)} documento(s) oficial(is)")

    # RODADA PARCIAL FUNDE, NAO SUBSTITUI. Herdado do incidente de 2026-08-30
    # (BUGLOG): gravar so os documentos da rodada apagou 9 dos 11 ja medidos, e
    # a tabela Go perdeu 708 linhas — inclusive o documento mais citado de todos.
    acumulado = carrega_evidencia(EVIDENCIA)
    hoje = time.strftime("%Y-%m-%d")
    for indice, url in enumerate(ordem, 1):
        bruto, status, origem = baixa(url, args.pausa, cache)
        registro = {
            "url": url,
            "ocorrencias_no_acervo": alvos[url],
            "consultado_em": hoje,
            "http_status": status,
            "origem_do_corpo": origem,
        }
        if bruto:
            registro |= mede_documento(url, bruto)
        print(f"  [{indice}/{len(ordem)}] {status} {origem} "
              f"puros={len(registro.get('ancoras_de_artigo') or [])} "
              f"letrados={len(registro.get('ancoras_de_artigo_letrado') or [])} "
              f"paragrafos={len(registro.get('ancoras_de_paragrafo') or [])} "
              f"({alvos[url]} links) {url}", flush=True)
        acumulado[url] = registro

    if args.so_relatorio:
        print("\n--so-relatorio: nada gravado")
        return 0

    linhas = [json.dumps(acumulado[u], ensure_ascii=False, sort_keys=True)
              for u in sorted(acumulado)]
    escreve_atomico(EVIDENCIA, ("\n".join(linhas) + "\n").encode("utf-8"))
    print(f"\nevidencia: {EVIDENCIA.relative_to(ROOT)} ({len(acumulado)} documento(s))")

    com_ancora = [r for r in acumulado.values() if emitiveis(r)]
    total = sum(len(emitiveis(r)) for r in com_ancora)
    antes = carrega_evidencia(EVIDENCIA_ANTERIOR)
    total_antes = sum(len(r.get("ancoras_de_artigo") or []) for r in antes.values())
    print(f"documentos com ancora emitivel: {len(com_ancora)}/{len(acumulado)}")
    print(f"ancoras emitiveis: {total} (registry de 2026-08-26: {total_antes})")

    if args.tabela:
        if not conferencia_de_regressao(acumulado, antes):
            return 1
        escreve_tabela(list(acumulado.values()))
        print(f"tabela: {TABELA.relative_to(ROOT)}")
    else:
        print("tabela NAO regravada (use --tabela)")
    return 0


def conferencia_de_regressao(acumulado: dict, antes: dict) -> bool:
    """Ancora que o registry de 2026-08-26 tinha e este nao tem: erro ou noticia?

    A distincao e o sha256 do DOCUMENTO, e ela e o oposto de uma regra so:

      sha IGUAL e menos ancoras  -> REGRESSAO DO PARSER. O documento nao mudou,
        entao quem mudou fui eu, e encolher a tabela tira link profundo que
        funciona hoje. Recusa, exit 1.

      sha DIFERENTE e menos ancoras -> O DOCUMENTO MUDOU. Aqui "nunca encolher"
        perde para "exato ou nada": manter a ancora velha seria emitir fragmento
        que NAO existe mais no HTML do Planalto, e a URL responde 200 com
        fragmento inexistente. A perda se imprime, nomeada, e a rodada segue.

    Medido em 2026-09-11: `l13105.htm` (CPC) perdeu `art1042` com sha diferente e
    1.673.573 -> 1.691.158 bytes. Conferido no documento baixado: `name="art1042"`
    nao existe mais; o Planalto agora marca `art1042.0`, `art1042i`, `art1042ii`,
    `art1042iii`. O registry em producao desde 2026-08-26 emitiria `#art1042`
    para uma ancora ausente — nenhum link do acervo aponta para ela hoje (medido:
    zero em public/), mas a tabela estava errada e a regeneracao conserta.
    """
    regressoes = 0
    noticias = 0
    for url, registro in acumulado.items():
        anterior = set(antes.get(url, {}).get("ancoras_de_artigo") or [])
        if not anterior:
            continue
        perdidas = anterior - set(emitiveis(registro))
        if not perdidas:
            continue
        sha_igual = (antes[url].get("sha256_documento")
                     == registro.get("sha256_documento"))
        if sha_igual:
            regressoes += 1
            print(f"RECUSADO: {url} perderia {len(perdidas)} ancora(s) com o "
                  f"documento INALTERADO (sha256 igual): {sorted(perdidas)[:5]}. "
                  f"Isso e defeito do classificador, nao noticia do Planalto.",
                  file=sys.stderr)
        else:
            noticias += 1
            print(f"  documento mudou: {url} perdeu {len(perdidas)} ancora(s) "
                  f"({sorted(perdidas)[:5]}), bytes "
                  f"{antes[url].get('bytes')} -> {registro.get('bytes')}")
    if noticias:
        print(f"{noticias} documento(s) com ancora a menos por mudanca no proprio "
              f"documento oficial — gravado, nao e regressao")
    return regressoes == 0


if __name__ == "__main__":
    raise SystemExit(main())
