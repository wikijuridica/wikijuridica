#!/usr/bin/env bash
# check-v2-internal-link-graph — diagnóstico READ-ONLY do estoque de tópicos v2.
#
# Resolve internal_link_topics no estoque e imprime apenas o resumo agregado.
# NÃO observa hrefs no HTML, NÃO está integrado ao release e NÃO é evidência de
# publicação/indexação/crawl. O comando não oferece saída em arquivo.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
export PATH="$ROOT/tools:$PATH"
set -euo pipefail

if [[ $# -ne 0 ]]; then
	echo "uso: tools/check-v2-internal-link-graph (sem argumentos; diagnóstico read-only canônico)" >&2
	exit 2
fi

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-check:v2-internal-link-graph:canonical-stock}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-summary_emitted_with_closed_publication_flags_or_failed_explicitly}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"
cd "$ROOT"

# Sempre modo diagnóstico read-only no snapshot canônico. O runner cacheado
# evita recompilação cega; o throttle aplica budget, timeout, lock e nice.
exec "$ROOT/tools/run-heavy-throttled" \
	"$ROOT/tools/run-go-cmd-cached" ./cmd/v2-internal-link-graph --timings -summary
