#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""check-sitemap-lastmod-dispersion-selftest — prova que o gate de dispersao
distingue CARIMBO EM MASSA de concentracao LEGITIMA, e reprova se confundir os dois.

Read-only sobre o repositorio: as arvores de teste nascem em tempfile e somem no
fim. O gate e IMPORTADO e o `main()` REAL e executado com `--raiz` apontando para
a arvore de teste — reimplementar a leitura aqui provaria a copia, nao o detector,
e o codigo de saida (0/1/2) so se prova executando quem o devolve.

CADA PROPRIEDADE ABAIXO REPROVA UM COMPORTAMENTO ERRADO CONCRETO, nao so confirma
o certo. Se o gate for "simplificado" para qualquer uma das versoes ingenuas que
ja pareceram razoaveis nesta frente, um destes testes fica vermelho:

  A. DISPERSAO QUE ACOMPANHA O LEDGER PASSA.
     Reprova o gate que dispara por concentracao alta em si.

  B. 99% NUMA DATA COM O LEDGER DISPERSO REPROVA (exit 1, e so 1).
     E o defeito que o gate existe para pegar: o fallback de
     `content.FreshnessDate` (ContentRevisedAt -> ReviewedAt -> PublicationDate)
     carimbando o acervo inteiro com a data de execucao. Reprova o gate que so
     avisa em vez de reprovar.

  C. FALSO POSITIVO 1 — LANCAMENTO GENUINO NUM DIA SO.
     Acervo 100% numa data E ledger 100% na MESMA data. Concentracao maxima,
     causa legitima. Tem de PASSAR. Reprova qualquer limite absoluto de
     concentracao ("acima de X% reprova"), que e a versao ingenua do gate.

  D. FALSO POSITIVO 2 — SITEMAP PEQUENO.
     Poucas URLs, todas numa data, ledger disperso. NAO pode reprovar: abaixo do
     piso de lote (LOTE_MINIMO = 50, de generate-page-content-revision:114) o que
     se ve e movimentacao editorial individual, e a fracao e dominada por um
     punhado de rotas. Veredito INCONCLUSIVO (exit 2), nunca 1.

  E. A ESTATISTICA NAO PODE SER CEGA A DATA.
     Ledger 100% na data A, sitemap 100% na data B. Se o gate comparasse o MAXIMO
     do sitemap contra o MAXIMO do ledger, os dois valeriam 1,0, a diferenca daria
     zero e trocar a data de todo o acervo passaria em silencio. Tem de REPROVAR.

  F. DERIVA DE UMA PUBLICACAO NAO E FRAUDE.
     O ledger e regravado DEPOIS do deploy, entao ele fica uma publicacao a frente
     do XML. Rotas que o ledger ja moveu e o sitemap ainda nao INFLAM a
     concentracao do sitemap na data antiga. Tem de PASSAR. Reprova o gate que
     esquece o termo de deriva.

  G. SHARD EM CARENCIA NAO ENTRA NA CONTA.
     public/sitemaps/ guarda shards aposentados fora do indice (internal/sitemapgrace
     os serve 200 por 8 dias). Ler o diretorio por glob ja produziu 365 divergencias
     FALSAS (commit 1dc09fd2). O teste planta um shard fora do indice cujas datas,
     se lidas, reprovariam — e exige PASS. Reprova a volta do glob.

  H. INSUMO AUSENTE E INCONCLUSIVO, NUNCA REPROVACAO.
     Sem ledger o gate nao pode afirmar nada. Exit 2. Reprovar por indisponibilidade
     de arquivo ja foi defeito medido neste repositorio.

Uso:
    tools/check-sitemap-lastmod-dispersion-selftest
    tools/check-sitemap-lastmod-dispersion-selftest -v
"""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import sys
import tempfile
from contextlib import redirect_stdout
from typing import Dict, List, Tuple

GATE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "check-sitemap-lastmod-dispersion")

VERBOSO = "-v" in sys.argv or "--verbose" in sys.argv


def carrega_gate():
    """Importa o gate sem executar o main() dele."""
    loader = importlib.machinery.SourceFileLoader("gate_dispersion", str(GATE))
    modulo = importlib.util.module_from_spec(importlib.util.spec_from_loader("gate_dispersion", loader))
    argv = sys.argv
    sys.argv = ["gate_dispersion"]
    try:
        loader.exec_module(modulo)
    finally:
        sys.argv = argv
    return modulo


GATEM = carrega_gate()


# ---------------------------------------------------------------- fixtures

def escreve_arvore(raiz: str,
                   sitemap: Dict[str, str],
                   ledger: Dict[str, str],
                   por_shard: int = 200,
                   shard_orfao: Dict[str, str] = None,
                   sem_ledger: bool = False) -> None:
    """Materializa public/sitemap.xml, os shards e o ledger de revisao.

    `shard_orfao`, quando dado, vira um arquivo em public/sitemaps/ que o indice
    NAO referencia — o estado legitimo de carencia, e a armadilha do glob.
    """
    dir_shards = os.path.join(raiz, "public", "sitemaps")
    os.makedirs(dir_shards, exist_ok=True)
    os.makedirs(os.path.join(raiz, "data", "ops"), exist_ok=True)

    rotas = sorted(sitemap)
    nomes: List[str] = []
    for i in range(0, len(rotas), por_shard):
        nome = f"pages-{len(nomes) + 1:04d}.xml"
        nomes.append(nome)
        corpo = "".join(
            f"<url><loc>https://wikijuridica.com.br{r}</loc>"
            f"<lastmod>{sitemap[r]}</lastmod></url>\n"
            for r in rotas[i:i + por_shard])
        with open(os.path.join(dir_shards, nome), "w", encoding="utf-8") as fh:
            fh.write('<?xml version="1.0" encoding="UTF-8"?>\n'
                     '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
                     f"{corpo}</urlset>\n")

    if shard_orfao:
        corpo = "".join(
            f"<url><loc>https://wikijuridica.com.br{r}</loc>"
            f"<lastmod>{d}</lastmod></url>\n" for r, d in sorted(shard_orfao.items()))
        with open(os.path.join(dir_shards, "pages-9999.xml"), "w", encoding="utf-8") as fh:
            fh.write('<?xml version="1.0" encoding="UTF-8"?>\n'
                     "<!-- sitemap-shard-em-carencia retirado-em=2026-08-27T00:00:00Z -->\n"
                     '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
                     f"{corpo}</urlset>\n")

    entradas = "".join(
        f"  <sitemap><loc>https://wikijuridica.com.br/sitemaps/{n}</loc></sitemap>\n"
        for n in nomes)
    with open(os.path.join(raiz, "public", "sitemap.xml"), "w", encoding="utf-8") as fh:
        fh.write('<?xml version="1.0" encoding="UTF-8"?>\n'
                 '<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
                 f"{entradas}</sitemapindex>\n")

    if sem_ledger:
        return
    with open(os.path.join(raiz, "data", "ops", "page_content_revision.jsonl"),
              "w", encoding="utf-8") as fh:
        for rota in sorted(ledger):
            # hashlib, nunca hash() do Python: o built-in e semeado por processo e
            # devolve valor diferente a cada execucao (R3 do contrato de dado real).
            # Estes campos o gate nao le, mas fixture nao-determinista e a semente
            # de teste que passa hoje e falha amanha sem ninguem saber por que.
            fh.write(json.dumps({
                "content_sha256": hashlib.sha256(rota.encode()).hexdigest(),
                "path": rota,
                "revised_on": ledger[rota],
                "served_sha256": hashlib.sha256((rota + "!").encode()).hexdigest(),
            }) + "\n")


def roda(**kwargs) -> Tuple[int, dict]:
    """Executa o main() REAL do gate sobre uma arvore temporaria."""
    raiz = tempfile.mkdtemp(prefix="dispersion-selftest-")
    try:
        escreve_arvore(raiz, **kwargs)
        captura = io.StringIO()
        with redirect_stdout(captura):
            codigo = GATEM.main(["--json", "--listar", "50", "--raiz", raiz])
        saida = captura.getvalue()
        try:
            dados = json.loads(saida)
        except ValueError:
            dados = {"saida_bruta": saida}
        return codigo, dados
    finally:
        shutil.rmtree(raiz, ignore_errors=True)


def rotas(n: int, prefixo: str = "p") -> List[str]:
    return [f"/{prefixo}/{i:05d}/" for i in range(n)]


# ---------------------------------------------------------------- propriedades

FALHAS: List[str] = []


def exige(condicao: bool, rotulo: str, detalhe: str) -> None:
    if condicao:
        if VERBOSO:
            print(f"  ok   {rotulo}")
        return
    FALHAS.append(f"{rotulo}: {detalhe}")
    print(f"  FALHA {rotulo}: {detalhe}")


def prop_a_dispersao_acompanha_o_ledger() -> None:
    """A. o sitemap espelha o ledger, com 3 rotas divergindo (edicao individual)."""
    todas = rotas(400)
    datas = ["2026-08-20", "2026-08-22", "2026-08-24", "2026-08-26"]
    ledger = {r: datas[i % 4] for i, r in enumerate(todas)}
    sitemap = dict(ledger)
    for r in todas[:3]:                       # tres paginas editadas de verdade
        sitemap[r] = "2026-08-27"
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo == 0, "A dispersao que acompanha o ledger passa",
          f"exit={codigo} veredito={d.get('veredito')} excesso={d.get('excesso')} "
          f"tolerancia={d.get('tolerancia')}")


def prop_b_carimbo_em_massa_reprova() -> None:
    """B. 99% numa data com o ledger disperso: o defeito que o gate existe para pegar."""
    todas = rotas(400)
    datas = ["2026-08-20", "2026-08-22", "2026-08-24", "2026-08-26", "2026-08-27"]
    ledger = {r: datas[i % 5] for i, r in enumerate(todas)}
    sitemap = {r: "2026-08-28" for r in todas}
    for r in todas[:4]:
        sitemap[r] = ledger[r]                # 396/400 = 99,0% numa data unica
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo == 1, "B carimbo em massa reprova com exit 1",
          f"exit={codigo} veredito={d.get('veredito')} excesso={d.get('excesso')} "
          f"tolerancia={d.get('tolerancia')} b={d.get('so_no_sitemap')}")
    exige(d.get("data_de_maior_excesso") == "2026-08-28",
          "B a data acusada e a carimbada",
          f"acusou {d.get('data_de_maior_excesso')}")


def prop_c_lancamento_num_dia_so_passa() -> None:
    """FALSO POSITIVO 1. Concentracao total com causa legitima nao pode reprovar."""
    todas = rotas(400)
    ledger = {r: "2026-08-28" for r in todas}
    sitemap = {r: "2026-08-28" for r in todas}
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo == 0, "C lancamento num dia so (100% numa data) passa",
          f"exit={codigo} veredito={d.get('veredito')} excesso={d.get('excesso')}")
    # Prova que a concentracao E maxima: se o teste passasse com um acervo disperso
    # ele nao estaria testando nada.
    exige(d.get("por_data", {}).get("2026-08-28", {}).get("sitemap") == 400,
          "C a fixture realmente concentra 400/400 numa data",
          f"por_data={d.get('por_data')}")


def prop_d_sitemap_pequeno_nao_reprova() -> None:
    """FALSO POSITIVO 2. Amostra abaixo do piso de lote: inconclusivo, nunca fail."""
    todas = rotas(30)
    datas = ["2026-08-20", "2026-08-24", "2026-08-26"]
    ledger = {r: datas[i % 3] for i, r in enumerate(todas)}
    sitemap = {r: "2026-08-28" for r in todas}
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo != 1, "D sitemap pequeno NAO reprova",
          f"exit={codigo} veredito={d.get('veredito')} — 30 URLs viraram acusacao")
    exige(codigo == 2, "D sitemap pequeno e inconclusivo (exit 2)",
          f"exit={codigo} veredito={d.get('veredito')}")
    exige((d.get("so_no_sitemap") or 0) < GATEM.LOTE_MINIMO,
          "D a discordancia fica abaixo do piso de lote",
          f"b={d.get('so_no_sitemap')} piso={GATEM.LOTE_MINIMO}")
    # E a MESMA forma acima do piso tem de reprovar: se nao reprovar, o gate nao
    # esta protegendo o pequeno, esta cego.
    grandes = rotas(400)
    ledger_g = {r: datas[i % 3] for i, r in enumerate(grandes)}
    sitemap_g = {r: "2026-08-28" for r in grandes}
    codigo_g, dg = roda(sitemap=sitemap_g, ledger=ledger_g)
    exige(codigo_g == 1, "D a mesma forma acima do piso reprova",
          f"exit={codigo_g} veredito={dg.get('veredito')} b={dg.get('so_no_sitemap')}")


def prop_e_estatistica_nao_e_cega_a_data() -> None:
    """E. Ledger 100% em A, sitemap 100% em B: maximo x maximo daria zero."""
    todas = rotas(400)
    ledger = {r: "2026-08-20" for r in todas}
    sitemap = {r: "2026-08-28" for r in todas}
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo == 1, "E troca de data do acervo inteiro reprova",
          f"exit={codigo} veredito={d.get('veredito')} excesso={d.get('excesso')} — "
          "comparar maximo contra maximo daria excesso 0 e passaria em silencio")
    exige(abs((d.get("excesso") or 0) - 1.0) < 1e-9,
          "E o excesso medido e 100% do acervo",
          f"excesso={d.get('excesso')}")


def prop_f_deriva_de_uma_publicacao_passa() -> None:
    """F. Ledger uma publicacao a frente do XML: folga legitima, contada."""
    todas = rotas(400)
    ledger = {r: "2026-08-26" for r in todas}
    sitemap = {r: "2026-08-26" for r in todas}
    for r in todas[:60]:                      # o deploy ja regravou o ledger
        ledger[r] = "2026-08-28"              # e o XML ainda nao acompanhou
    codigo, d = roda(sitemap=sitemap, ledger=ledger)
    exige(codigo == 0, "F deriva de uma publicacao nao vira fraude",
          f"exit={codigo} veredito={d.get('veredito')} excesso={d.get('excesso')} "
          f"deriva={d.get('deriva')}")
    exige(d.get("rotas_com_ledger_mais_novo") == 60,
          "F a deriva foi contada, nao estimada",
          f"contou {d.get('rotas_com_ledger_mais_novo')}, esperado 60")


def prop_g_shard_em_carencia_fica_fora() -> None:
    """G. A armadilha do glob: shard fora do indice nao pode entrar na conta."""
    todas = rotas(400)
    datas = ["2026-08-20", "2026-08-22", "2026-08-24", "2026-08-26"]
    ledger = {r: datas[i % 4] for i, r in enumerate(todas)}
    sitemap = dict(ledger)
    # 300 rotas aposentadas, todas carimbadas numa data unica que o ledger nao tem.
    # Lidas por glob, reprovariam. Lidas pelo indice, nem existem.
    orfao = {r: "2026-08-28" for r in rotas(300, prefixo="aposentada")}
    for r in orfao:
        ledger[r] = "2026-08-01"
    codigo, d = roda(sitemap=sitemap, ledger=ledger, shard_orfao=orfao)
    exige(codigo == 0, "G shard em carencia nao entra na conta (leitura pelo indice)",
          f"exit={codigo} veredito={d.get('veredito')} casadas={d.get('rotas_casadas')} — "
          "leitura por glob traria as 300 aposentadas e reprovaria")
    exige(d.get("rotas_no_sitemap") == 400,
          "G so as URLs do indice foram lidas",
          f"leu {d.get('rotas_no_sitemap')} URLs, esperado 400")


def prop_h_insumo_ausente_e_inconclusivo() -> None:
    """H. Sem ledger nao ha veredito. Exit 2, jamais 1."""
    todas = rotas(400)
    sitemap = {r: "2026-08-28" for r in todas}
    codigo, d = roda(sitemap=sitemap, ledger={}, sem_ledger=True)
    exige(codigo == 2, "H ledger ausente e inconclusivo (exit 2), nao reprovacao",
          f"exit={codigo} dados={d}")
    exige(d.get("veredito") == "inconclusivo",
          "H o veredito de insumo ausente se declara",
          f"veredito={d.get('veredito')}")


def prop_i_espelho_do_piso_confere() -> None:
    """O piso de lote e copia do gerador. Copia divergente mente."""
    avisos = GATEM.confere_espelho()
    exige(avisos == [], "I LOTE_MINIMO ainda bate com generate-page-content-revision",
          f"avisos={avisos}")


def main() -> int:
    print("check-sitemap-lastmod-dispersion-selftest")
    for prop in (prop_a_dispersao_acompanha_o_ledger,
                 prop_b_carimbo_em_massa_reprova,
                 prop_c_lancamento_num_dia_so_passa,
                 prop_d_sitemap_pequeno_nao_reprova,
                 prop_e_estatistica_nao_e_cega_a_data,
                 prop_f_deriva_de_uma_publicacao_passa,
                 prop_g_shard_em_carencia_fica_fora,
                 prop_h_insumo_ausente_e_inconclusivo,
                 prop_i_espelho_do_piso_confere):
        prop()
    if FALHAS:
        print(f"check-sitemap-lastmod-dispersion-selftest: FAIL ({len(FALHAS)})")
        return 1
    print("check-sitemap-lastmod-dispersion-selftest: pass (9 propriedades, "
          "2 falsos positivos cobertos)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
