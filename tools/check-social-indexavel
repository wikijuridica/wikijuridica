#!/usr/bin/env python3
"""check-social-indexavel — a rede social é de fato indexável, e o sitemap não mente?

READ-ONLY. Não escreve arquivo nenhum, não toca em content/, data/, public/ nem
em serviço. Toda asserção sai de medição própria sobre o HTML SERVIDO agora e
sobre config versionada.

POR QUE ELE EXISTE. `content/redesocial_entregas.json`, entrega `F2-indexacao`,
declara como prova os gates `social-indexavel` e `social-bots`. Nenhum dos dois
existia: a superfície nasceu com sitemap próprio, gêmea Markdown e canonical, e
NENHUM instrumento media se essas três coisas continuavam de pé. Entrega sem
gate é entrega que só se sabe quebrada quando o buscador avisa — e ele avisa em
semanas, pelo relatório de cobertura.

★ COMO O CENSO DE ROTAS É MONTADO, E POR QUE NÃO É UMA LISTA FIXA

Lista fixa de rota envelhece no primeiro commit, exatamente como caminho fixo de
folha CSS. O censo é a UNIÃO de três fontes, e cada uma cobre o ponto cego das
outras duas:

  1. literais `"/redesocial/..."` do fonte que serve (cmd/social/*.go e
     internal/socialrender/*.go, fora dos _test.go) — pega rota que existe e
     ninguém linka;
  2. rastreio dos links internos a partir de `/redesocial/` — pega rota que
     nasceu sem constante própria e que o visitante alcança;
  3. os `<loc>` do próprio `/redesocial/sitemap.xml` — pega rota anunciada ao
     Googlebot que talvez nem responda.

Medido em 2026-09-05: `/redesocial/` NÃO linka `/redesocial/perguntas/`, e
`/redesocial/perguntas/` está no sitemap. Só o rastreio teria perdido a rota; só
o sitemap teria perdido `/redesocial/consulta/`. A união acha as duas.

Literal que não responde 200 NÃO reprova: constante de PREFIXO (o
`caminhoDasTelasDeConta`, que é `/redesocial/conta/` e não é rota) é
indistinguível estaticamente de rota morta. Esses casos saem na seção de achados
para leitura humana, e as asserções de veredito rodam sobre o que responde 200.

★ O QUE É ASSERÇÃO DURA

  - canonical absoluto em HTTPS, com o host de `content/site.json` e o caminho
    EXATO da URL servida;
  - rota indexável carrega `max-snippet:-1`. Limitar o snippet reduz a chance de
    citação por IA, e o contrato do projeto exige o `-1` explícito;
  - rota noindex de CONTEÚDO preserva `follow`. `/redesocial/consulta/` é
    noindex por decisão registrada em cmd/social/consulta.go:57 — parâmetro que
    altera o corpo — e o `follow` é o que mantém vivos os links para o acervo e
    para a fonte oficial. Tela de conta é a exceção legítima: `nofollow` ali é
    privacidade, não SEO;
  - parâmetro de rastreamento (`utm_*`) serve o MESMO HTML, com canonical para a
    URL limpa e SEM noindex — o canonical consolida, o noindex destrói;
  - `<title>` de 20 a 65 caracteres e único; meta description de 70 a 160 e
    única. A faixa da description é regra de snippet de SERP, então vale como
    veredito nas indexáveis e como achado nas noindex;
  - teto de bytes lido de `internal/htmlcontract.HTMLBudgetBytes`, e não digitado
    aqui;
  - gêmea Markdown em 200 para toda rota indexável — canal de máquina é
    contrato, não cortesia;
  - o sitemap social lista EXATAMENTE as indexáveis. Indexável fora dele é
    descoberta perdida; não-indexável dentro dele é contradição que o buscador
    registra na cobertura;
  - o sitemap social é DESCOBERTO: o robots.txt servido traz a segunda diretiva
    `Sitemap:` que `content/crawl_policy.json` declara em
    `additional_sitemap_paths`. Sitemap sem descoberta é sitemap que ninguém lê;
  - e ele fica FORA de `public/sitemap.xml`: um `<loc>` social ali faz
    `publishedmanifest` reprovar no boot e derruba o cmd/server inteiro.

★ TRÊS DESFECHOS

    0  medido e correto
    1  medido e ERRADO
    2  NÃO deu para medir (serviço fora do ar, fonte ilegível). Indisponibilidade
       nunca é reprovação.

Sondagem sem fraude: User-Agent próprio e `X-Warming-Request: true`, contra
127.0.0.1. Nenhuma requisição daqui forja User-Agent de bot real.
"""
import html
import http.client
import importlib.util
import json
import os
import re
import sys
import xml.etree.ElementTree as ET

NOME = "check-social-indexavel"

# Faixas do contrato de indexação, em CARACTERES (runas), não em bytes.
TITULO_MIN, TITULO_MAX = 20, 65
DESCRICAO_MIN, DESCRICAO_MAX = 70, 160

# Tetos do rastreio de links. Existem para que o gate não vire carga: a
# superfície tem uma dezena de rotas, e um teto folgado que nunca é atingido
# ainda impede que uma paginação nova transforme o gate em crawler.
TETO_DE_ROTAS = 60
PROFUNDIDADE_MAXIMA = 3

# Parâmetro de rastreamento usado na sonda. Ele é NOSSO e identificável: se
# aparecer em qualquer relatório, sabe-se de onde veio.
UTM_DE_SONDA = "utm_source=check-social-indexavel"

ESPACO_SITEMAP = "{http://www.sitemaps.org/schemas/sitemap/0.9}"


def carrega_base():
    """Carrega tools/social_borda_probe.py por caminho explícito.

    O idioma usual (`sys.path.insert` + import) obrigaria a suprimir o
    diagnóstico do lint sobre import fora de ordem, e mascarar diagnóstico é
    proibido neste repositório. Carregar por caminho resolve a causa.
    """
    caminho = os.path.join(os.path.dirname(os.path.abspath(__file__)), "social_borda_probe.py")
    spec = importlib.util.spec_from_file_location("social_borda_probe", caminho)
    if spec is None or spec.loader is None:
        raise ImportError(f"não consegui carregar {caminho}")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


base = carrega_base()


def requisita_corpo(porta, caminho, timeout=10):
    """Devolve (status, cabecalhos, corpo, erro) de uma requisição a 127.0.0.1.

    `social_borda_probe.requisita` descarta o corpo, e este gate mede o HTML.
    A duplicação é de oito linhas e fica aqui de propósito: promover a função
    para o módulo compartilhado é mudança em arquivo que outras frentes usam, e
    vai como sugestão ao maestro em vez de edição por conta própria.

    O `Host` vai como o domínio público porque o nginx casa server_name e monta
    a chave de cache com `$host`.
    """
    cabecalhos = dict(base.CABECALHOS_BASE)
    cabecalhos["Host"] = base.HOST_PUBLICO
    conexao = None
    try:
        conexao = http.client.HTTPConnection("127.0.0.1", porta, timeout=timeout)
        conexao.request("GET", caminho, headers=cabecalhos)
        resposta = conexao.getresponse()
        corpo = resposta.read()
        return resposta.status, dict(resposta.getheaders()), corpo, None
    except (OSError, http.client.HTTPException) as erro:
        return None, {}, b"", f"{type(erro).__name__}: {erro}"
    finally:
        if conexao is not None:
            conexao.close()


def base_publica(raiz):
    """Lê a URL pública de content/site.json. Ela é travada lá, nunca aqui."""
    caminho = os.path.join(raiz, "content", "site.json")
    with open(caminho, encoding="utf-8") as f:
        site = json.load(f)
    url = str(site.get("base_url", "")).strip().rstrip("/")
    if not url.startswith("https://"):
        raise ValueError(f"content/site.json tem base_url={url!r}, que não é HTTPS absoluto")
    return url


def teto_de_bytes(raiz):
    """Lê HTMLBudgetBytes do fonte Go em vez de repetir o número aqui.

    `cmd/social/rotas_test.go:15` fixa `50 * 1024` = 51.200, e o contrato é
    50.000: um gate que copiasse o número errado toleraria 1.200 bytes a mais
    para sempre. Ler a constante é o que impede a terceira cópia divergente.
    """
    caminho = os.path.join(raiz, "internal", "htmlcontract", "htmlcontract.go")
    with open(caminho, encoding="utf-8") as f:
        texto = f.read()
    achado = re.search(r"\bHTMLBudgetBytes\s*=\s*(\d+)", texto)
    if not achado:
        raise ValueError("internal/htmlcontract/htmlcontract.go não declara HTMLBudgetBytes")
    return int(achado.group(1))


RE_LITERAL = re.compile(r'"(/redesocial/[^"{}\s]*)"')


def literais_de_rota(raiz):
    """Extrai os caminhos literais que o fonte servidor declara.

    Só arquivos que SERVEM: os _test.go trazem fixture (`/redesocial/perfil/...`,
    `/redesocial/advogados/`) que não é rota deste processo, e incluí-los faria o
    gate cobrar rota que ninguém prometeu.
    """
    achados = set()
    for pasta in (os.path.join(raiz, "cmd", "social"), os.path.join(raiz, "internal", "socialrender")):
        if not os.path.isdir(pasta):
            continue
        for arquivo in sorted(os.listdir(pasta)):
            if not arquivo.endswith(".go") or arquivo.endswith("_test.go"):
                continue
            with open(os.path.join(pasta, arquivo), encoding="utf-8") as f:
                for literal in RE_LITERAL.findall(f.read()):
                    achados.add(literal)
    return achados


def so_html(caminhos):
    """Fica com os caminhos de tela: terminam em barra e não são asset."""
    return {c for c in caminhos if c.endswith("/") and "/assets/" not in c}


RE_HREF = re.compile(r'href="([^"]+)"')


def rastreia(porta, inicio, teto=TETO_DE_ROTAS, profundidade=PROFUNDIDADE_MAXIMA):
    """Descobre rotas de tela seguindo os links internos, em largura.

    Devolve (rotas, erro). Um link que não responde não interrompe o rastreio: a
    conferência de status é das asserções, não da descoberta.
    """
    vistos = {inicio}
    fila = [(inicio, 0)]
    while fila and len(vistos) < teto:
        caminho, nivel = fila.pop(0)
        if nivel >= profundidade:
            continue
        status, _, corpo, erro = requisita_corpo(porta, caminho)
        if erro is not None:
            return vistos, erro
        if status != 200:
            continue
        for bruto in RE_HREF.findall(corpo.decode("utf-8", "replace")):
            alvo = html.unescape(bruto).split("#")[0].split("?")[0]
            if not alvo.startswith("/redesocial/"):
                continue
            # Só tela: asset e documento de máquina têm asserção própria, e
            # segui-los aqui encheria o censo de coisa que não tem <title>.
            if "/assets/" in alvo or not alvo.endswith("/"):
                continue
            if alvo not in vistos and len(vistos) < teto:
                vistos.add(alvo)
                fila.append((alvo, nivel + 1))
    return vistos, None


RE_TITULO = re.compile(r"(?s)<title>(.*?)</title>")
RE_DESCRICAO = re.compile(r'<meta name="description" content="([^"]*)"')
RE_CANONICAL = re.compile(r'<link rel="canonical" href="([^"]*)"')
RE_ROBOTS = re.compile(r'<meta name="robots" content="([^"]*)"')


def le_marcacao(corpo):
    """Extrai do HTML os quatro sinais de indexação, já sem entidade."""
    texto = corpo.decode("utf-8", "replace")

    def um(expressao):
        achado = expressao.search(texto)
        return html.unescape(achado.group(1)).strip() if achado else None

    return {
        "titulo": um(RE_TITULO),
        "descricao": um(RE_DESCRICAO),
        "canonical": um(RE_CANONICAL),
        "robots": um(RE_ROBOTS),
    }


def indexavel(robots):
    """Uma rota é indexável quando NADA a proíbe.

    Ausência de meta robots é indexação por padrão — é assim que o buscador lê,
    e tratar ausência como noindex esconderia rota que de fato entra no índice.
    """
    if robots is None:
        return True
    return "noindex" not in robots.lower().replace(" ", "")


def diretivas(robots):
    """Quebra o conteúdo da meta robots em tokens comparáveis."""
    if not robots:
        return set()
    return {parte.strip().lower() for parte in robots.split(",") if parte.strip()}


def e_tela_de_conta(caminho):
    """Tela de conta é a única em que `nofollow` é legítimo: ali o motivo é
    privacidade de área autenticada, não política de indexação de conteúdo."""
    return caminho.startswith("/redesocial/conta/")


def locs_do_sitemap(porta, caminho_do_indice):
    """Devolve (locs, erro) percorrendo índice e shards do sitemap social."""
    status, _, corpo, erro = requisita_corpo(porta, caminho_do_indice)
    if erro is not None:
        return None, erro
    if status != 200:
        return None, f"{caminho_do_indice} respondeu {status}"
    try:
        raiz = ET.fromstring(corpo)
    except ET.ParseError as falha:
        return None, f"{caminho_do_indice} não é XML válido: {falha}"

    def texto_dos_locs(elemento):
        return [(n.text or "").strip() for n in elemento.iter(ESPACO_SITEMAP + "loc")]

    if raiz.tag == ESPACO_SITEMAP + "urlset":
        return texto_dos_locs(raiz), None
    if raiz.tag != ESPACO_SITEMAP + "sitemapindex":
        return None, f"{caminho_do_indice} tem raiz {raiz.tag!r}, que não é do protocolo de sitemap"

    todos = []
    for shard in texto_dos_locs(raiz):
        caminho = caminho_do_shard(shard)
        if caminho is None:
            return None, f"o índice aponta {shard!r}, que não é um caminho deste host"
        status, _, corpo_shard, erro = requisita_corpo(porta, caminho)
        if erro is not None:
            return None, erro
        if status != 200:
            return None, f"o shard {caminho} respondeu {status}: o índice anuncia documento que não existe"
        try:
            todos.extend(texto_dos_locs(ET.fromstring(corpo_shard)))
        except ET.ParseError as falha:
            return None, f"{caminho} não é XML válido: {falha}"
    return todos, None


def caminho_do_shard(loc):
    """Converte um <loc> absoluto no caminho a sondar. None se não for URL."""
    marca = "://"
    if marca not in loc:
        return None
    resto = loc.split(marca, 1)[1]
    corte = resto.find("/")
    return resto[corte:] if corte >= 0 else "/"


def caminho_de(loc, base_url):
    """Caminho de um <loc> que pertence à base pública. None se for de outro host."""
    if not loc.startswith(base_url + "/"):
        return None
    return loc[len(base_url):]


def sitemaps_declarados(raiz):
    """Lê sitemap_path e additional_sitemap_paths de content/crawl_policy.json."""
    caminho = os.path.join(raiz, "content", "crawl_policy.json")
    with open(caminho, encoding="utf-8") as f:
        politica = json.load(f)
    principal = str(politica.get("sitemap_path", "")).strip()
    adicionais = [str(p).strip() for p in politica.get("additional_sitemap_paths", []) if str(p).strip()]
    return principal, adicionais


def robots_servido(raiz):
    """Devolve (texto, origem) do robots.txt que o visitante realmente recebe.

    Preferência pelo nginx: é o que responde na porta 80 do túnel. Sem nginx no
    ar, cai para o arquivo estático de public/, que é o que o nginx serviria —
    a asserção continua sobre o artefato servido, nunca sobre o gerador.
    """
    if base.escuta(base.PORTA_NGINX):
        status, _, corpo, erro = requisita_corpo(base.PORTA_NGINX, "/robots.txt")
        if erro is None and status == 200:
            return corpo.decode("utf-8", "replace"), f"nginx 127.0.0.1:{base.PORTA_NGINX}"
    caminho = os.path.join(raiz, "public", "robots.txt")
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read(), "public/robots.txt"
    except OSError as erro:
        return None, f"não consegui ler public/robots.txt: {erro}"


def x_robots(cabecalhos):
    """Valor do X-Robots-Tag, se houver. Cabeçalho vence a meta para o bot."""
    for chave, valor in cabecalhos.items():
        if chave.lower() == "x-robots-tag":
            return valor
    return None


def avalia(porta, censo):
    """Sonda cada rota do censo e devolve (paginas, nao_servidas, erro).

    `paginas` mapeia caminho -> dicionário com marcação, bytes e cabeçalhos.
    """
    paginas = {}
    nao_servidas = {}
    for caminho in sorted(censo):
        status, cabecalhos, corpo, erro = requisita_corpo(porta, caminho)
        if erro is not None:
            return None, None, f"{caminho}: {erro}"
        if status != 200:
            nao_servidas[caminho] = status
            continue
        tipo = str(cabecalhos.get("Content-Type", ""))
        if "text/html" not in tipo:
            nao_servidas[caminho] = f"200 {tipo}"
            continue
        dados = le_marcacao(corpo)
        dados["bytes"] = len(corpo)
        dados["x_robots"] = x_robots(cabecalhos)
        dados["indexavel"] = indexavel(dados["robots"])
        paginas[caminho] = dados
    return paginas, nao_servidas, None


def falhas_de_marcacao(paginas, base_url, teto):
    """Aplica as asserções de página. Devolve a lista de falhas."""
    falhas = []
    titulos = {}
    descricoes = {}
    for caminho, dados in sorted(paginas.items()):
        canonical = dados["canonical"]
        esperado = base_url + caminho
        if not canonical:
            falhas.append(f"{caminho}: sem <link rel=\"canonical\">")
        elif canonical != esperado:
            falhas.append(f"{caminho}: canonical {canonical!r}, esperado {esperado!r}")

        tokens = diretivas(dados["robots"])
        if dados["indexavel"]:
            if "max-snippet:-1" not in tokens:
                falhas.append(
                    f"{caminho}: rota indexável sem `max-snippet:-1` (meta robots = {dados['robots']!r}); "
                    "limitar o snippet reduz a chance de citação por IA")
        elif not e_tela_de_conta(caminho) and "follow" not in tokens:
            falhas.append(
                f"{caminho}: rota de conteúdo noindex sem `follow` (meta robots = {dados['robots']!r}); "
                "o noindex aqui é por parâmetro que altera o corpo, e retirar o follow mataria os links "
                "para o acervo e para a fonte oficial")

        cabecalho = dados["x_robots"]
        if cabecalho and dados["indexavel"] and "noindex" in cabecalho.lower():
            falhas.append(
                f"{caminho}: a meta robots manda indexar e o cabeçalho X-Robots-Tag manda {cabecalho!r}; "
                "o cabeçalho vence, e a página está fora do índice sem que o HTML diga isso")

        titulo = dados["titulo"]
        if not titulo:
            falhas.append(f"{caminho}: sem <title>")
        else:
            n = len(titulo)
            if n < TITULO_MIN or n > TITULO_MAX:
                falhas.append(f"{caminho}: <title> com {n} caracteres; o contrato exige de {TITULO_MIN} a {TITULO_MAX}")
            titulos.setdefault(titulo, []).append(caminho)

        descricao = dados["descricao"]
        if not descricao:
            falhas.append(f"{caminho}: sem meta description")
        else:
            n = len(descricao)
            if dados["indexavel"] and (n < DESCRICAO_MIN or n > DESCRICAO_MAX):
                falhas.append(
                    f"{caminho}: meta description com {n} caracteres; "
                    f"o contrato exige de {DESCRICAO_MIN} a {DESCRICAO_MAX} na rota indexável")
            descricoes.setdefault(descricao, []).append(caminho)

        if dados["bytes"] > teto:
            falhas.append(f"{caminho}: {dados['bytes']} bytes servidos; o teto de htmlcontract.HTMLBudgetBytes é {teto}")

    for titulo, rotas in sorted(titulos.items()):
        if len(rotas) > 1:
            falhas.append(f"<title> repetido em {', '.join(rotas)}: {titulo!r}")
    for descricao, rotas in sorted(descricoes.items()):
        if len(rotas) > 1:
            falhas.append(f"meta description repetida em {', '.join(rotas)}: {descricao[:60]!r}...")
    return falhas


def falhas_de_sitemap(locs, paginas, base_url):
    """Compara, nos dois sentidos, o sitemap com o conjunto indexável medido."""
    falhas = []
    anunciadas = set()
    for loc in locs:
        caminho = caminho_de(loc, base_url)
        if caminho is None:
            falhas.append(f"o sitemap anuncia {loc!r}, que não pertence à base pública {base_url}")
            continue
        anunciadas.add(caminho)

    indexaveis = {c for c, d in paginas.items() if d["indexavel"]}
    for caminho in sorted(indexaveis - anunciadas):
        falhas.append(f"{caminho} é indexável e NÃO está no sitemap social: descoberta perdida")
    for caminho in sorted(anunciadas - indexaveis):
        dados = paginas.get(caminho)
        if dados is None:
            falhas.append(f"o sitemap anuncia {caminho}, que não responde 200 em HTML: 404 entregue ao Googlebot pela nossa mão")
        else:
            falhas.append(f"o sitemap anuncia {caminho}, cuja meta robots é {dados['robots']!r}: contradição que o buscador registra na cobertura")
    return falhas


def falhas_de_descoberta(texto_do_robots, origem, base_url, principal, adicionais, caminho_do_indice):
    """O sitemap social é anunciado ao crawler? Sitemap sem descoberta não é lido."""
    falhas = []
    if caminho_do_indice == principal:
        falhas.append(
            f"content/crawl_policy.json declara {caminho_do_indice} como `sitemap_path` do acervo: "
            "o sitemap social tem de ser diretiva ADICIONAL, senão o índice do acervo some do robots.txt")
    if texto_do_robots is None:
        return falhas + [f"não consegui ler o robots.txt servido ({origem})"]
    if caminho_do_indice not in adicionais:
        falhas.append(
            f"content/crawl_policy.json não declara {caminho_do_indice} em additional_sitemap_paths "
            f"(declarados: {adicionais or 'nenhum'})")
    for caminho in adicionais:
        linha = f"Sitemap: {base_url}{caminho}"
        if linha not in texto_do_robots:
            falhas.append(
                f"o robots.txt servido ({origem}) não traz `{linha}`, que content/crawl_policy.json declara: "
                "o sitemap social existe e nenhum crawler tem como descobri-lo")
    return falhas


def falhas_de_parametro(porta, paginas, base_url):
    """Mede o contrato de parâmetro de URL nas duas classes.

    Rastreamento (`utm_*`) serve o MESMO HTML, com canonical para a URL limpa e
    SEM noindex — o canonical consolida e o noindex destruiria. Parâmetro que
    ALTERA O CORPO continua noindex.
    """
    falhas = []
    indexaveis = sorted(c for c, d in paginas.items() if d["indexavel"])
    if indexaveis:
        alvo = indexaveis[0]
        status, _, corpo, erro = requisita_corpo(porta, alvo + "?" + UTM_DE_SONDA)
        if erro is not None:
            falhas.append(f"{alvo}?{UTM_DE_SONDA}: {erro}")
        elif status != 200:
            falhas.append(f"{alvo}?{UTM_DE_SONDA} respondeu {status}: parâmetro de rastreamento não pode mudar a resposta")
        else:
            marcacao = le_marcacao(corpo)
            if not indexavel(marcacao["robots"]):
                falhas.append(
                    f"{alvo}?{UTM_DE_SONDA} veio com robots {marcacao['robots']!r}: parâmetro de RASTREAMENTO "
                    "não leva noindex — o canonical consolida, o noindex destrói")
            if marcacao["canonical"] != base_url + alvo:
                falhas.append(
                    f"{alvo}?{UTM_DE_SONDA} veio com canonical {marcacao['canonical']!r}, "
                    f"esperado {base_url + alvo!r}: sem isso a URL com utm vira URL própria no índice")

    nao_indexaveis = sorted(c for c, d in paginas.items() if not d["indexavel"] and not e_tela_de_conta(c))
    if nao_indexaveis:
        alvo = nao_indexaveis[0]
        status, _, corpo, erro = requisita_corpo(porta, alvo + "?termo=usucapiao")
        if erro is not None:
            falhas.append(f"{alvo}?termo=usucapiao: {erro}")
        elif status == 200:
            marcacao = le_marcacao(corpo)
            if indexavel(marcacao["robots"]):
                falhas.append(
                    f"{alvo}?termo=usucapiao veio indexável (robots {marcacao['robots']!r}): parâmetro que ALTERA O CORPO "
                    "é noindex, senão dez mil variações da mesma página se canibalizam")
    return falhas


def falhas_de_gemea(porta, paginas):
    """Toda rota indexável tem gêmea Markdown em 200."""
    falhas = []
    for caminho in sorted(c for c, d in paginas.items() if d["indexavel"]):
        gemea = caminho + "index.md"
        status, cabecalhos, _, erro = requisita_corpo(porta, gemea)
        if erro is not None:
            falhas.append(f"{gemea}: {erro}")
        elif status != 200:
            falhas.append(f"{gemea} respondeu {status}: rota indexável sem gêmea Markdown quebra MCP, A2A e /api/v1/lote")
        elif "text/markdown" not in str(cabecalhos.get("Content-Type", "")):
            falhas.append(f"{gemea} respondeu 200 com Content-Type {cabecalhos.get('Content-Type')!r}, esperado text/markdown")
    return falhas


def falhas_de_isolamento(raiz):
    """O sitemap social NUNCA aparece em public/sitemap.xml.

    Um <loc> social ali dispara `published_manifest_sitemap_missing`, que é
    fatal no boot: o cmd/server não sobe e caem junto o MCP, o A2A, as gêmeas do
    acervo e /api/v1/*.
    """
    caminho = os.path.join(raiz, "public", "sitemap.xml")
    try:
        with open(caminho, encoding="utf-8") as f:
            texto = f.read()
    except OSError:
        return []
    if "/redesocial/" in texto:
        return ["public/sitemap.xml menciona /redesocial/: um <loc> social no índice do acervo impede o cmd/server de subir"]
    return []


def main():
    raiz = base.RAIZ
    try:
        base_url = base_publica(raiz)
        teto = teto_de_bytes(raiz)
        principal, adicionais = sitemaps_declarados(raiz)
    except (OSError, ValueError, json.JSONDecodeError) as erro:
        return base.relata(NOME, base.INCONCLUSIVO, [f"não consegui ler a configuração versionada: {erro}"])

    porta = base.PORTA_SOCIAL
    if not base.escuta(porta):
        return base.relata(NOME, base.INCONCLUSIVO, [
            f"nada escutando em 127.0.0.1:{porta}: o cmd/social está parado, e indisponibilidade nunca é reprovação"])

    caminho_do_indice = "/redesocial/sitemap.xml"
    locs, erro = locs_do_sitemap(porta, caminho_do_indice)
    if erro is not None:
        return base.relata(NOME, base.ERRADO, [f"o sitemap social não pôde ser lido: {erro}"])

    rastreadas, erro = rastreia(porta, "/redesocial/")
    if erro is not None:
        return base.relata(NOME, base.INCONCLUSIVO, [f"o rastreio de links falhou: {erro}"])

    do_sitemap = set()
    for loc in locs:
        caminho = caminho_de(loc, base_url)
        if caminho:
            do_sitemap.add(caminho)

    censo = so_html(literais_de_rota(raiz) | rastreadas | do_sitemap)
    paginas, nao_servidas, erro = avalia(porta, censo)
    if erro is not None:
        return base.relata(NOME, base.INCONCLUSIVO, [f"a sondagem falhou no meio: {erro}"])
    if not paginas:
        return base.relata(NOME, base.ERRADO, ["nenhuma rota do censo respondeu 200 em HTML"])

    texto_do_robots, origem = robots_servido(raiz)

    falhas = []
    falhas += falhas_de_marcacao(paginas, base_url, teto)
    falhas += falhas_de_gemea(porta, paginas)
    falhas += falhas_de_parametro(porta, paginas, base_url)
    falhas += falhas_de_sitemap(locs, paginas, base_url)
    falhas += falhas_de_descoberta(texto_do_robots, origem, base_url, principal, adicionais, caminho_do_indice)
    falhas += falhas_de_isolamento(raiz)

    indexaveis = sorted(c for c, d in paginas.items() if d["indexavel"])
    achados = [
        f"censo: {len(censo)} caminho(s) candidatos; {len(paginas)} responderam 200 em HTML; "
        f"{len(indexaveis)} indexável(is): {', '.join(indexaveis) or 'nenhuma'}",
        f"teto de bytes lido de htmlcontract.HTMLBudgetBytes = {teto}",
    ]
    if nao_servidas:
        achados.append(
            "declarado no fonte e NÃO servido (prefixo de constante ou rota morta, leitura humana): "
            + ", ".join(f"{c} -> {s}" for c, s in sorted(nao_servidas.items())))
    fora_de_faixa = [
        f"{c} ({len(d['descricao'])})"
        for c, d in sorted(paginas.items())
        if d["descricao"] and not d["indexavel"] and not DESCRICAO_MIN <= len(d["descricao"]) <= DESCRICAO_MAX
    ]
    if fora_de_faixa:
        achados.append(
            "meta description fora de 70-160 em rota NÃO indexável (não é veredito: a faixa é regra de snippet de SERP): "
            + ", ".join(fora_de_faixa))

    if falhas:
        return base.relata(NOME, base.ERRADO, falhas + ["--- medido junto ---"] + achados)
    return base.relata(NOME, base.OK, achados)


if __name__ == "__main__":
    sys.exit(main())
