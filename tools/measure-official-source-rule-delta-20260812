#!/usr/bin/env python3
"""measure-official-source-rule-delta-20260812 — quanto a escrita de fonte moveu, regra a regra.

Mede, regra a regra (internal/v2ingest/validate.go:665-733), o efeito da escrita.

Não substitui a reingestão: reproduz APENAS as regras de fonte oficial que a
escrita tocou, e reaproveita, para todas as demais, o veredito do último run
autoritativo (v2-ingest-20260812T100000Z). Onde o word_count mudou, a regra de
faixa é reconferida.
"""
import json, glob, os, re, datetime, collections
from urllib.parse import urlparse

ROOT = "/opt/wiki"
BACKUP = ROOT + "/.agents/runtime/backup-v2_pages-20260812-fonte-status"
SUFIXOS = ("gov.br", "jus.br", "leg.br", "mp.br")
HOJE = datetime.date(2026, 8, 12)

def fonte_valida(s):
    u = (s.get("url") or "").strip()
    if not u: return False
    p = urlparse(u)
    if p.scheme.lower() != "https" or not p.hostname: return False
    h = p.hostname.lower()
    return any(h == b or h.endswith("." + b) for b in SUFIXOS) or h in ("planalto.gov.br", "bcb.gov.br")

def razoes_de_fonte(r):
    """Só as classes que a escrita pode alterar."""
    out = set()
    validas = 0
    for s in r.get("official_sources") or []:
        if s.get("http_status") not in (200, 203, 206):
            out.add("official_source_http_status_invalid")
        v = (s.get("verified_at") or "").strip()
        m = re.match(r"^(\d{4})-(\d{2})-(\d{2})", v)
        if not m:
            out.add("official_source_verified_at_invalid")
        else:
            d = datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
            if d > HOJE: out.add("official_source_verified_at_future")
            elif d < HOJE - datetime.timedelta(days=90): out.add("official_source_verified_at_stale")
        if fonte_valida(s): validas += 1
    if validas < 2: out.add("official_sources_insufficient")
    return out

def carregar(dirpath):
    reg = {}
    for p in sorted(glob.glob(dirpath + "/*.jsonl")):
        for l in open(p, encoding="utf-8"):
            if l.strip():
                r = json.loads(l); reg[r["intent_id"]] = r
    return reg

antes, depois = carregar(BACKUP), carregar(ROOT + "/data/editorial/v2_pages")
relatorio = {}
for l in open(ROOT + "/data/ops/v2_ingest_report.jsonl", encoding="utf-8"):
    r = json.loads(l); relatorio[r["intent_id"]] = r

TOCADAS = {"official_source_http_status_invalid", "official_source_verified_at_invalid",
           "official_source_verified_at_future", "official_source_verified_at_stale",
           "official_sources_insufficient"}

def classes_do_relatorio(iid):
    r = relatorio.get(iid)
    return {x.split(":")[0] for x in (r.get("reasons") or [])} if r else set()

def veredito(reg, iid):
    """Classes do último run, com as regras de fonte recalculadas sobre o registro."""
    outras = classes_do_relatorio(iid) - TOCADAS
    return outras | razoes_de_fonte(reg[iid])

conta = collections.Counter()
saiu_insuf = []
virou_limpa = []
for iid in depois:
    if iid not in antes or antes[iid] == depois[iid]: continue
    a, d = veredito(antes, iid), veredito(depois, iid)
    if a == d: conta["sem_mudanca_de_classe"] += 1; continue
    conta["mudou_de_classe"] += 1
    if "official_sources_insufficient" in a and "official_sources_insufficient" not in d:
        saiu_insuf.append(iid)
    if a and not d:
        virou_limpa.append(iid)
    elif d:
        conta["ainda_rejeitada_por_outra_classe"] += 1

for rot, reg in (("ANTES", antes), ("DEPOIS", depois)):
    c = collections.Counter()
    for iid in reg:
        for k in veredito(reg, iid): c[k] += 1
    print("=== %s (classes por página, %d páginas) ===" % (rot, len(reg)))
    for k, v in c.most_common(12): print("  %-42s %d" % (k, v))
    limpas = sum(1 for iid in reg if not veredito(reg, iid))
    print("  >> páginas sem NENHUMA classe de rejeição: %d" % limpas)
    print()

print("páginas que EU alterei:", sum(1 for i in depois if i in antes and antes[i] != depois[i]))
print(conta)
print("saíram de official_sources_insufficient:", len(saiu_insuf))
print("ficaram sem nenhuma classe de rejeição :", len(virou_limpa))
destino = ROOT + "/data/source-audit/official_source_rule_delta_20260812.json"
json.dump({"gerado_em": HOJE.isoformat(),
           "criterio": ("classes de rejeicao do ultimo run autoritativo, com as regras de fonte "
                        "oficial recalculadas sobre o registro vivo; nao substitui a reingestao"),
           "saiu_de_official_sources_insufficient": saiu_insuf,
           "ficou_sem_nenhuma_classe": virou_limpa},
          open(destino, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
print("gravado", os.path.relpath(destino, ROOT))
