#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""generate-social-tasklist — a tasklist operacional da rede social, DERIVADA do
manifesto.

★ POR QUE ELA É DERIVADA, E NÃO ESCRITA À MÃO
`content/redesocial_entregas.json` já é a lista de tarefas: 163 itens com id,
fase, onda, estado e prova conferível. Uma segunda lista mantida à mão divergiria
da primeira em uma semana — é o mesmo defeito que fez a contagem fixa de linhas
do PRECEDENTES_DAS_ORDENS envelhecer e virar commit de correção. Aqui o painel de
execução e o gate terminal leem a MESMA fonte de verdade.

★ A DIVISÃO ENTRE OS DOIS ARQUIVOS, que é o que evita a divergência
O manifesto guarda o estado DURÁVEL e com prova (`entregue`, `pendente`,
`suspenso` — é o que o gate cobra). A tasklist acrescenta a leitura de EXECUÇÃO:
agrupamento por onda, a prova resolvida em uma linha legível, e o corte entre o
que falta por engenharia e o que falta por evento do mundo. Os estados efêmeros
de execução (`fazendo`, `bloqueado`) pertencem a quem está executando, não a um
artefato versionado de contrato.

★ NUNCA SE EDITA O .md À MÃO. Rodar de novo regenera. Edição manual seria
exatamente a segunda fonte de verdade que este comando existe para não criar.

★ SEPARAÇÃO DE PAPÉIS — este é um `generate-*`: ele ESCREVE
docs/goal/TASKLIST_REDE_SOCIAL.md. Quem julga e reprova é o par
redesocial-completude / redesocial-entrega-final.

    tools/generate-social-tasklist
    tools/generate-social-tasklist --conferir   # não escreve; sai 1 se desatualizada
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from collections import OrderedDict, defaultdict
from datetime import date
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
MANIFESTO = RAIZ / "content" / "redesocial_entregas.json"
SAIDA = RAIZ / "docs" / "goal" / "TASKLIST_REDE_SOCIAL.md"

# A ordem das ondas é a do plano de execução, e ela NÃO é alfabética: 1'' vem
# depois de 1', e 2''''' depois de 2''''. Ordenar por string poria "1'''" antes
# de "1'", e a tasklist mentiria sobre a sequência.
ORDEM_DAS_ONDAS = ["0", "1", "1'", "1''", "1'''", "2", "2'", "2''", "2'''", "2''''",
                   "2'''''", "3", "3'", "3''", "4", "5", "5'", "6", "6'", "7", "8"]


def commit_atual() -> str:
    try:
        r = subprocess.run(["git", "-C", str(RAIZ), "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, timeout=15)
        return r.stdout.strip() or "desconhecido"
    except Exception:
        return "desconhecido"


def prova_legivel(prova: dict) -> str:
    """A prova do manifesto resolvida numa linha — é o TESTE da task.

    O padrão que esta tasklist herda (docs/goal/TASKLIST_PLANO_20260819.md) fixa
    a regra: toda task tem TESTE, e sem teste verificado não vira `feito`.
    """
    partes: list[str] = []
    for pacote in prova.get("pacotes_go", []):
        partes.append(f"pacote `{pacote}`")
    for par in prova.get("simbolos_go", []):
        partes.append(f"símbolo `{par[1]}` em `{par[0]}`")
    for par in prova.get("textos_em_arquivo", []):
        partes.append(f"`{par[0]}` contém `{par[1]}`")
    for arquivo in prova.get("arquivos", []):
        partes.append(f"arquivo `{arquivo}`")
    for gate in prova.get("gates", []):
        partes.append(f"gate `{gate}` verde")
    minimos = prova.get("testes_minimos", 0)
    if minimos:
        partes.append(f"≥{minimos} testes que assertam")
    cobertura = prova.get("cobertura_de_teste", 0)
    if cobertura:
        partes.append(f"cobertura {cobertura:g}× as exportadas")
    return " · ".join(partes) if partes else "**sem prova declarada**"


def escapa(texto: str) -> str:
    """Pipe dentro de célula quebraria a tabela Markdown."""
    return texto.replace("|", "\\|").replace("\n", " ").strip()


def monta(manifesto: dict) -> str:
    entregas = manifesto["entregas"]
    por_onda: dict[str, list[dict]] = defaultdict(list)
    for entrega in entregas:
        por_onda[entrega.get("onda") or "sem onda"].append(entrega)

    entregues = [e for e in entregas if e["estado"] == "entregue"]
    suspensas = [e for e in entregas if e["estado"] == "suspenso"]
    pendentes = [e for e in entregas if e["estado"] == "pendente"]
    aguardam = [e for e in pendentes if (e.get("depende_de_evento_externo") or "").strip()]
    por_engenharia = len(pendentes) - len(aguardam)

    linhas = [
        "# Tasklist — rede social jurídica (modo `/goal`)",
        "",
        "> **Arquivo DERIVADO. Não edite à mão.** Ele é gerado por",
        "> `tools/generate-social-tasklist` a partir de `content/redesocial_entregas.json`,",
        "> que é a única fonte de verdade — editar aqui cria a segunda fonte que este",
        "> comando existe para não criar. Rodar de novo regenera.",
        "",
        f"Gerada em {date.today().isoformat()}, sobre o commit `{commit_atual()}`.",
        f"Plano de execução: `{manifesto.get('plano', '')}`.",
        "",
        "Estados do manifesto: `pendente` · `entregue` · `suspenso` (com motivo obrigatório).",
        "Os estados efêmeros de execução (`fazendo`, `bloqueado`) pertencem a quem está",
        "executando e não a um artefato versionado de contrato.",
        "",
        "**Toda task tem TESTE — sem teste verificado, não vira `feito`.**",
        "",
        "## O placar",
        "",
        "| | |",
        "|---|---|",
        f"| entregues | **{len(entregues)}** de {len(entregas)} |",
        f"| a fazer | **{len(pendentes)}** |",
        f"| — por engenharia | **{por_engenharia}** ← é o que o goal cobra |",
        f"| — aguardando evento do mundo | {len(aguardam)} |",
        f"| suspensas por decisão | {len(suspensas)} |",
        "",
        "A condição de encerramento do goal é literal: `check-redesocial-entrega-final`",
        "reprovando **apenas** por `redesocial_entrega_aguarda_evento`. Enquanto houver",
        "`redesocial_entrega_pendente`, há trabalho de engenharia.",
        "",
    ]

    if aguardam:
        linhas += [
            "## O que não fecha por engenharia nenhuma",
            "",
            "Estas dependem de evento do mundo. Elas **continuam reprovando** o gate",
            "terminal — a entrega não está feita —, e o que muda é que quem lê sabe que não",
            "há o que codificar. Fabricar o evento é a fraude que o contrato proíbe.",
            "",
            "| id | falta acontecer |",
            "|---|---|",
        ]
        for e in sorted(aguardam, key=lambda x: x["id"]):
            linhas.append(f"| `{e['id']}` | {escapa(e['depende_de_evento_externo'])} |")
        linhas.append("")

    if suspensas:
        linhas += [
            "## Suspensas por decisão registrada",
            "",
            "Não são trabalho pendente e não reprovam o gate terminal. O requisito segue",
            "rastreado pelo motivo, que diz sob que condição a entrega volta.",
            "",
            "| id | motivo e condição de volta |",
            "|---|---|",
        ]
        for e in sorted(suspensas, key=lambda x: x["id"]):
            linhas.append(f"| `{e['id']}` | {escapa(e.get('motivo', ''))} |")
        linhas.append("")

    linhas += ["## As ondas", ""]
    conhecidas = [o for o in ORDEM_DAS_ONDAS if o in por_onda]
    restantes = sorted(o for o in por_onda if o not in ORDEM_DAS_ONDAS)
    for onda in conhecidas + restantes:
        itens = sorted(por_onda[onda], key=lambda x: x["id"])
        faltam = sum(1 for e in itens if e["estado"] == "pendente")
        linhas += [
            f"### Onda {onda} — {len(itens)} entregas, {faltam} a fazer",
            "",
            "| id | task | estado | teste (a prova do manifesto) |",
            "|---|---|---|---|",
        ]
        for e in itens:
            estado = e["estado"]
            if estado == "pendente" and (e.get("depende_de_evento_externo") or "").strip():
                estado = "pendente *(evento)*"
            elif estado == "entregue":
                estado = "**feito**"
            linhas.append(
                f"| `{e['id']}` | {escapa(e['titulo'])} | {estado} | {escapa(prova_legivel(e['prova']))} |"
            )
        linhas.append("")

    return "\n".join(linhas)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--conferir", action="store_true",
                        help="não escreve; sai 1 se o arquivo no disco estiver desatualizado")
    args = parser.parse_args()

    manifesto = json.loads(MANIFESTO.read_text(encoding="utf-8"))
    texto = monta(manifesto)

    if args.conferir:
        atual = SAIDA.read_text(encoding="utf-8") if SAIDA.exists() else ""
        # A data e o commit mudam a cada execução e não são divergência de
        # conteúdo: comparar o corpo depois delas é o que torna --conferir útil
        # dentro de um gate, em vez de acusar todo dia.
        # O rstrip final NÃO é cosmético: monta() devolve o corpo e a escrita
        # acrescenta o "\n" terminal, então comparar os dois crus acusa
        # divergência em toda execução — um --conferir que sempre reprova é um
        # --conferir que ninguém usa.
        def corpo(t: str) -> str:
            return "\n".join(l for l in t.split("\n")
                             if not l.startswith("Gerada em ")).rstrip("\n")
        if corpo(atual) != corpo(texto):
            print(f"{SAIDA.relative_to(RAIZ)} está desatualizada; rode tools/generate-social-tasklist",
                  file=sys.stderr)
            return 1
        print(f"{SAIDA.relative_to(RAIZ)}: em dia")
        return 0

    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    SAIDA.write_text(texto + "\n", encoding="utf-8")
    entregas = manifesto["entregas"]
    print(f"{SAIDA.relative_to(RAIZ)}: {len(entregas)} entregas em "
          f"{len({e.get('onda') or 'sem onda' for e in entregas})} ondas")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
