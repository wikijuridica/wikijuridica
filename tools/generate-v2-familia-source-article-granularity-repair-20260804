#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""generate-v2-familia-source-article-granularity-repair-20260804.

Corrige o defeito `public_source_label_missing_article_granularity` nas 96
paginas de practice_area=familia listadas em
`data/ops/source_label_article_granularity_queue_20260804.jsonl`: a pagina
fixa um artigo especifico do Codigo Civil como fonte oficial, mas o corpo
publico nunca nomeia esse artigo (ou nomeia sem o formato que o detector
reconhece).

## Causa raiz confirmada (nao suposta)

O detector (`internal/publicproselanguagepatterns` .
officialSourceGranularityCodesFromNormalizedText / hasOfficialArticleReference)
roda sobre o texto que SOBREVIVE ao corte de secoes do candidato publico
(`internal/publicprosecandidate.buildPublicSections`, tabuado por
`publicSourceSectionLimit` — 3 ou 4 secoes de 6, deterministico por hash do
registro) MAIS os campos sempre presentes (title/meta/h1/opening). Ele exige
o artigo escrito com o separador de milhar ("art. 1.658"), porque a
normalizacao do Go (`FieldsFunc` sobre nao-alfanumerico) so separa "1" e
"658" em dois tokens quando ha um separador entre eles; "art. 1658" vira um
UNICO token "1658" e nao bate com o padrao "1 658" que o detector monta a
partir da URL da fonte. Confirmado consultando o codigo-fonte em
internal/publicproselanguagepatterns/patterns.go:4948-5151 e reproduzindo a
tokenizacao em Python contra os registros reais.

Duas categorias, ambas auditadas manualmente contra o Codigo Civil local
(`data/source-snapshots/`, blobs `art_<numero>`, canal
`senado_legis_dados_abertos_json` / camara.leg.br normaatualizada, HTTP 200):

1. **format_fix_articles** (91 paginas / 129 instancias): o artigo certo ja
   esta citado no envelope que sobrevive, mas sem o ponto de milhar
   ("art. 1658") ou com a palavra "dispositivo" em vez de "art."/"artigo"
   ("dispositivo 1584"). Correcao puramente MECANICA: insere o separador de
   milhar (forma exigida pela ABNT/pratica juridica brasileira de citacao,
   mais correta que a grafia sem ponto) e normaliza "dispositivo N" para
   "art. N". Nao adiciona nem remove nenhuma afirmacao juridica.

2. **content_addition** (5 paginas): o artigo certo aparece corretamente
   citado em SECAO QUE NAO SOBREVIVE ao corte do candidato (indice >= limite
   de 3/4), ou (so em fam-casamento-putativo) nunca e discutido no corpo.
   Cada uma recebe UMA frase nova, integrada ao fim da ultima secao que
   sobrevive, reaproveitando a MESMA proposicao juridica que ja constava
   (corretamente) em secao mais adiante da propria pagina, ou (no caso de
   casamento putativo) a extensao doutrinaria reconhecida — uniao estavel
   putativa por analogia ao casamento putativo, ancorada na definicao do
   art. 1.723 do Codigo Civil — sem inventar decisao, sumula ou numero de
   processo.

## Por que gerador, e nao edicao manual

Contrato do repo: JSONL editorial so muda por gerador. Mesmo padrao de
`generate-v2-oab-phrase-repair-20260805`: lease de epoca, lock exclusivo, CAS
pelo sha256 da LINHA atual (aborta se outra frente tocou o registro), demais
linhas preservadas byte a byte, escrita atomica com fsync, idempotente,
word_count recalculado pela formula de internal/v2ingest/validate.go:984
(bodyWordCount: opening + heading E texto de cada secao + Q e A de cada FAQ,
acentos removidos). NAO committa.

A especificacao completa (por intent_id: shard, sha256 esperado, lista de
artigos a formatar, e a insercao de conteudo quando aplicavel) vive em
`tools/generate-v2-familia-source-article-granularity-repair-20260804.data.json`,
irmao deste script, produzido por auditoria da fila real + leitura das 96
paginas + confirmacao do teor de 64 artigos do Codigo Civil contra o
snapshot local verificado.
"""

from __future__ import annotations

from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.familia-article-granularity-repair-20260804.lock"
SPEC_PATH = Path(__file__).resolve().parent / "generate-v2-familia-source-article-granularity-repair-20260804.data.json"


def load_spec() -> dict:
    with open(SPEC_PATH, "r", encoding="utf-8") as handle:
        return json.load(handle)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def punctuate(article: str) -> str:
    return article[:-3] + "." + article[-3:] if len(article) > 3 else article


def apply_format_fix(text: str, article: str) -> str:
    punctuated = punctuate(article)
    text = re.sub(r"\bdispositivo\s+" + re.escape(article) + r"\b", "art. " + punctuated, text)

    def repl(match: re.Match) -> str:
        return match.group(1) + ". " + punctuated

    text = re.sub(r"\b(art|artigo)\.?\s*" + re.escape(article) + r"\b", repl, text, flags=re.I)
    return text


def word_count(record: dict) -> int:
    """Reproduz `bodyWordCount` de internal/v2ingest/validate.go:984."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def preflight(spec: dict) -> None:
    problems: list[str] = []
    for intent, entry in sorted(spec.items()):
        addition = entry.get("content_addition")
        if addition:
            appended = addition["append"]
            if len(appended.split()) < 8:
                problems.append(f"{intent}: sentenca nova curta demais")
            if appended.strip() == "":
                problems.append(f"{intent}: sentenca nova vazia")
        if not entry.get("format_fix_articles") and not addition:
            problems.append(f"{intent}: sem correcao definida")
    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(spec)} pagina(s) de familia")


def apply_repair(intent: str, entry: dict) -> int:
    shard = ROOT / entry["shard"]
    digest = entry["sha256"]
    lines = shard.read_bytes().decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    output: list[str] = []
    changed = 0
    already = 0
    found = False
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{shard}: linha em branco {number}")
        record = json.loads(raw)
        if record.get("intent_id") != intent:
            output.append(raw)
            continue
        found = True

        current = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        if current == digest:
            new_record = _rewrite_record(record, entry)
            new_record["word_count"] = word_count(new_record)
            output.append(json.dumps(new_record, ensure_ascii=False, sort_keys=True))
            changed += 1
            continue

        # Ja aplicado por execucao anterior? Confere se o resultado esperado
        # ja esta presente; se sim, idempotente (so acerta word_count se
        # necessario). Caso contrario, outra frente tocou o registro: aborta.
        expected_record = _rewrite_record(record, entry)
        if json.dumps(record, ensure_ascii=False, sort_keys=True) == json.dumps(
            expected_record, ensure_ascii=False, sort_keys=True
        ):
            already += 1
            output.append(raw)
            continue
        # Pode ja ter sido corrigido mas com word_count desatualizado.
        if _record_body_matches(record, expected_record):
            expected = word_count(record)
            if record.get("word_count") != expected:
                record["word_count"] = expected
                output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
                changed += 1
                print(f"  word_count corrigido: {intent} -> {expected}")
                continue
            already += 1
            output.append(raw)
            continue

        raise SystemExit(
            f"CAS FALHOU em {shard}:{number} ({intent}): linha atual nao e a esperada.\n"
            f"  esperado sha256: {digest}\n  atual sha256:    {current}\n"
            "Outra frente tocou este registro. Reler o conteudo vivo antes de reaplicar."
        )

    if not found:
        raise SystemExit(f"{shard}: intent {intent} nao encontrado")

    if changed:
        payload = "\n".join(output)
        if trailing_newline:
            payload += "\n"
        atomic_write(shard, payload.encode("utf-8"))

    print(f"{shard} ({intent}): reescritos={changed} ja_aplicados={already}")
    return changed


def _record_body_matches(record: dict, expected: dict) -> bool:
    return record.get("opening") == expected.get("opening") and record.get("sections") == expected.get(
        "sections"
    )


def _rewrite_record(record: dict, entry: dict) -> dict:
    new_record = json.loads(json.dumps(record, ensure_ascii=False))
    articles = entry.get("format_fix_articles") or []
    for field in ("title", "meta_description", "h1", "opening"):
        value = new_record.get(field)
        if not value:
            continue
        for article in articles:
            value = apply_format_fix(value, article)
        new_record[field] = value
    for section in new_record.get("sections") or []:
        for article in articles:
            section["heading"] = apply_format_fix(section["heading"], article)
            section["text"] = apply_format_fix(section["text"], article)

    addition = entry.get("content_addition")
    if addition:
        index = addition["section_index"]
        sections = new_record.get("sections") or []
        if index >= len(sections):
            raise SystemExit(f"content_addition: indice {index} fora do range de secoes")
        section = sections[index]
        before_suffix = addition["before_suffix"]
        append_text = addition["append"]
        if append_text in section["text"]:
            pass  # ja aplicado
        elif section["text"].rstrip().endswith(before_suffix):
            section["text"] = section["text"] + append_text
        else:
            raise SystemExit(
                f"content_addition: secao {index} nao termina com o trecho esperado.\n"
                f"  esperado sufixo: {before_suffix!r}\n  atual (200 chars): {section['text'][-200:]!r}"
            )
    return new_record


def main() -> int:
    spec = load_spec()
    preflight(spec)
    total = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for intent, entry in sorted(spec.items()):
                    total += apply_repair(intent, entry)
    except StockEpochBusy as error:
        print(
            f"generate-v2-familia-source-article-granularity-repair-20260804: estoque ocupado: {error}",
            file=sys.stderr,
        )
        return 75
    if total:
        print("OK. Reingerir o estoque para o espelho refletir a correcao.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
