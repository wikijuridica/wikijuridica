#!/bin/sh
# Gate da superfície Agent Skills Discovery: valida o acervo publicado em
# content/agent-skills/, confere os archives contra o manifesto nos dois níveis
# (pacote e cada arquivo-fonte) e prova que o digest do índice bate com o byte
# que a rota serve.
#
# Alcance declarado: roda sobre o repositório e sobre o índice montado em
# memória. NÃO abre socket e NÃO mede a borda. Para o que o mundo recebe, use
# `go run ./cmd/agent-skills verify https://wikijuridica.com.br`.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "$ROOT/tools/run-check" agent-skills-discovery --timings "$@"
