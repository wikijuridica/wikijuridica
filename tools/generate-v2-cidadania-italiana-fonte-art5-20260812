@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def forma(linha: str):
    original = json.loads(linha)
    for separadores in ((", ", ": "), (",", ":")):
        if json.dumps(original, ensure_ascii=False, separators=separadores) == linha:
            return separadores
    return (", ", ": ")


def palavras(valor: str) -> list[str]:
    """Réplica de normalizedWords (validate.go:997): fold PT-BR (minúsculas, sem
    marcas de acento) e tokens de letra/dígito Unicode."""
    texto = unicodedata.normalize("NFD", (valor or "").strip().lower())
    texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
    return re.findall(r"[^\W_]+", unicodedata.normalize("NFC", texto), re.UNICODE)


def body_word_count(registro: dict) -> int:
    """Réplica de bodyWordCount (validate.go:984): opening + headings + textos das
    seções + FAQ. title, meta_description e h1 ficam FORA."""
    total = len(palavras(registro.get("opening", "")))
    for secao in registro.get("sections", []):
        total += len(palavras(secao.get("h2") or ""))
        total += len(palavras(secao.get("text", "")))
    for item in registro.get("faq", []):
        total += len(palavras(item.get("q", "")))
        total += len(palavras(item.get("a", "")))
    return total


