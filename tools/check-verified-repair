#!/usr/bin/env python3
"""check-verified-repair — o reparo continua valendo, ou o defeito voltou?

POR QUE ESTA FERRAMENTA PRECISA EXISTIR, e por que a ausência dela era um bug.

`tools/generate-v2-verified-repair` grava que o defeito apontado por um auditor
sumiu do conteúdo, e o censo de severidade usa esse registro para deixar a
página voltar ao ar. A docstring daquela ferramenta afirma, literalmente, que o
predicado é "reavaliado por `tools/check-verified-repair` a cada verificação: se
alguém reintroduzir o defeito, o reparo deixa de valer sozinho".

Só que este arquivo NÃO EXISTIA. A afirmação era falsa, e a consequência é
concreta: um reparo gravado valia para sempre. Bastava um gerador datado
reintroduzir o trecho — ou uma regeneração trazer de volta o texto antigo — para
a página seguir publicada sob um reparo que já não descrevia a realidade.

Reparo sem reavaliação é auto-perdão com data.

O QUE ELE FAZ: para cada registro, recompõe o corpo da página no estoque v2 e
reavalia o `forbidden_pattern`. O predicado é uma expressão que NÃO PODE casar.
Se casar, o defeito voltou e o reparo perdeu a validade — e isso é reprovação,
não aviso.

O QUE ELE NÃO FAZ, escrito porque verde daqui não é aprovação da página: ele
verifica UM defeito, o que o auditor apontou. A página pode ter outros. Um
reparo cobre um defeito, nunca a página inteira — é essa a distinção que impede
o mecanismo de virar botão de anular auditoria.

Read-only. Uso:
    tools/check-verified-repair
    tools/check-verified-repair --json
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
REGISTRO = RAIZ / "data/ops/v2_verified_repairs.jsonl"
SHARDS = RAIZ / "data/editorial/v2_pages"


def corpo_das_paginas() -> dict[str, str]:
    """Indexa o corpo de cada página do estoque, por intent_id.

    O corpo é opening + seções + FAQ. Não existe chave "text" com a página
    inteira — quem a procura mede zero e conclui que está tudo limpo, que é uma
    das armadilhas catalogadas deste repositório.
    """
    corpos: dict[str, str] = {}
    for arquivo in sorted(SHARDS.glob("*.jsonl")):
        for linha in arquivo.read_text(encoding="utf-8").splitlines():
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            intent = registro.get("intent_id")
            if not isinstance(intent, str) or not intent:
                continue
            partes = [registro.get("opening") or ""]
            for secao in registro.get("sections") or []:
                partes.append(secao.get("heading") or "")
                partes.append(secao.get("text") or "")
            for par in registro.get("faq") or []:
                partes.append(par.get("q") or "")
                partes.append(par.get("a") or "")
            corpos[intent] = " ".join(p for p in partes if p)
    return corpos


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--json", action="store_true")
    argumentos = analisador.parse_args()

    if not REGISTRO.exists():
        print("nenhum reparo registrado — nada a reavaliar")
        return 0

    corpos = corpo_das_paginas()
    validos, quebrados, orfaos = [], [], []
    for linha in REGISTRO.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            reparo = json.loads(linha)
        except json.JSONDecodeError:
            continue
        intent = reparo.get("intent_id")
        padrao = reparo.get("forbidden_pattern")
        if not intent or not padrao:
            continue
        corpo = corpos.get(intent)
        if corpo is None:
            # Página que saiu do estoque: o reparo não tem mais objeto. Não é
            # defeito por si — supersessão é caminho legítimo —, mas fica
            # registrado, porque reparo apontando para o vazio é ruído que
            # esconde o que importa.
            orfaos.append(intent)
            continue
        if re.search(padrao, corpo):
            quebrados.append({
                "intent_id": intent,
                "defect_class": reparo.get("defect_class", ""),
                "pattern": padrao,
                "trecho": (re.search(padrao, corpo).group(0) or "")[:120],
            })
        else:
            validos.append(intent)

    if argumentos.json:
        print(json.dumps({"validos": validos, "quebrados": quebrados,
                          "orfaos": orfaos}, ensure_ascii=False, indent=1))
    else:
        print(f"reparos reavaliados: {len(validos) + len(quebrados) + len(orfaos)}")
        print(f"  ainda válidos : {len(validos)}")
        print(f"  QUEBRADOS     : {len(quebrados)}")
        print(f"  sem página    : {len(orfaos)}")
        for intent in validos:
            print(f"     ok  {intent}")
        for intent in orfaos:
            print(f"     --  {intent} (não está mais no estoque)")

    if quebrados:
        print("\nDEFEITO REINTRODUZIDO — o reparo destas páginas não vale mais:",
              file=sys.stderr)
        for item in quebrados:
            print(f"  {item['intent_id']} ({item['defect_class']})", file=sys.stderr)
            print(f"     o padrão proibido voltou a casar: {item['trecho']!r}", file=sys.stderr)
        print("\n  Corrija o conteúdo pelo gerador datado do reparo. Enquanto o",
              file=sys.stderr)
        print("  padrão casar, a página está publicada sob um reparo que não",
              file=sys.stderr)
        print("  descreve mais a realidade.", file=sys.stderr)
        return 1

    print("\nOK: nenhum defeito reparado voltou ao conteúdo.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
