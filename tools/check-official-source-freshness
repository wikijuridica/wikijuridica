#!/usr/bin/env python3
"""check-official-source-freshness — quais fontes oficiais merecem reconferência.

POR QUE ISTO É RELATÓRIO E NÃO GATE: até 2026-08-12 a idade da fonte REPROVAVA a
validação semântica, e o hook de integridade recusava qualquer commit de
`data/editorial/v2_pages/` quando alguma fonte do estoque passasse de 30 dias.
Como o prazo corre sozinho, o gate vencia sem que ninguém mudasse nada — 12.287
fontes (52%) e 4.413 páginas já estavam reprovadas por decurso de tempo, e
crescendo. Pior: recusava a correção de uma página por causa da data de outra.

A idade importa e continua medida — mas cobrar higiene BLOQUEANDO o conserto é
inverter a prioridade. O que bloqueia agora é o que é falsificável (data futura)
ou corrompido (data malformada); o que envelheceu aparece aqui, nomeado, para
ser reconferido de verdade por `tools/verify-official-sources`.

Exit 1 apenas quando há fonte com data INVÁLIDA ou FUTURA — os mesmos critérios
que o gate Go aplica. Idade, por si, nunca reprova este check.

Uso:
    tools/check-official-source-freshness
    tools/check-official-source-freshness --dias 30
    tools/check-official-source-freshness --json
"""
import argparse
import collections
import datetime
import glob
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
ESTOQUE = os.path.join(ROOT, "data", "editorial", "v2_pages", "*.jsonl")
MATERIAL_GO = os.path.join(ROOT, "internal", "v2writingsemantic", "material.go")


def prazo_do_contrato(padrao=30):
    """Lê OfficialSourceStaleAfterDays do Go para não haver dois números."""
    try:
        with open(MATERIAL_GO, encoding="utf-8") as arquivo:
            achado = re.search(r"OfficialSourceStaleAfterDays\s*=\s*(\d+)", arquivo.read())
        if achado:
            return int(achado.group(1))
    except OSError:
        pass
    return padrao


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dias", type=int, default=0, help="prazo de higiene (padrão: o do contrato Go)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    dias = args.dias or prazo_do_contrato()
    hoje = datetime.date.today()
    limite = hoje - datetime.timedelta(days=dias)

    total = 0
    velhas = collections.Counter()      # url -> ocorrências
    invalidas = []                      # (intent, url, valor) — estas reprovam
    futuras = []
    paginas_com_velha = set()

    for caminho in sorted(glob.glob(ESTOQUE)):
        with open(caminho, encoding="utf-8") as arquivo:
            for linha in arquivo:
                try:
                    registro = json.loads(linha)
                except ValueError:
                    continue
                intent = registro.get("intent_id") or "?"
                for fonte in registro.get("official_sources") or []:
                    url = fonte.get("url") or ""
                    valor = fonte.get("verified_at")
                    if not url:
                        continue
                    total += 1
                    if not valor:
                        invalidas.append((intent, url, "(ausente)"))
                        continue
                    try:
                        data = datetime.date.fromisoformat(valor)
                    except ValueError:
                        invalidas.append((intent, url, valor))
                        continue
                    if data > hoje:
                        futuras.append((intent, url, valor))
                    elif data < limite:
                        velhas[url] += 1
                        paginas_com_velha.add(intent)

    problemas = len(invalidas) + len(futuras)
    resumo = {
        "fontes_total": total,
        "prazo_higiene_dias": dias,
        "urls_distintas_para_reconferir": len(velhas),
        "ocorrencias_para_reconferir": sum(velhas.values()),
        "paginas_afetadas": len(paginas_com_velha),
        "datas_invalidas": len(invalidas),
        "datas_futuras": len(futuras),
    }

    if args.json:
        print(json.dumps(resumo, ensure_ascii=False, sort_keys=True))
    else:
        print("check-official-source-freshness (prazo de higiene: %d dias)" % dias)
        print("  fontes citadas          : %d" % total)
        print("  a reconferir            : %d ocorrência(s) em %d URL(s) distinta(s), %d página(s)"
              % (resumo["ocorrencias_para_reconferir"], len(velhas), len(paginas_com_velha)))
        if velhas:
            print("  URLs mais citadas entre as velhas:")
            for url, quantas in velhas.most_common(5):
                print("     %4dx %s" % (quantas, url[:88]))
            print("  reconferir de verdade: tools/verify-official-sources")
        if invalidas:
            print("  REPROVA — data inválida (%d):" % len(invalidas))
            for intent, url, valor in invalidas[:5]:
                print("     %s %s %s" % (intent, valor, url[:60]))
        if futuras:
            print("  REPROVA — data no futuro (%d): conferência que não pode ter acontecido" % len(futuras))
            for intent, url, valor in futuras[:5]:
                print("     %s %s %s" % (intent, valor, url[:60]))
        if not problemas:
            print("  OK — nenhuma data inválida ou futura. Idade, por si, não reprova.")

    return 1 if problemas else 0


if __name__ == "__main__":
    sys.exit(main())
