#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
ARTIFACT_LOCK_FILE="${WIKI_JSONL_STREAM_BENCHMARK_ARTIFACT_LOCK:-/tmp/opt-wiki-jsonl-stream-benchmark-artifact.lock}"
ARTIFACT_LOCK_WAIT_SECONDS="${WIKI_JSONL_STREAM_BENCHMARK_ARTIFACT_LOCK_WAIT_SECONDS:-300}"
cd "$ROOT"

case "$ARTIFACT_LOCK_WAIT_SECONDS" in
'' | *[!0-9]*)
	echo "generate-jsonl-stream-benchmark: WIKI_JSONL_STREAM_BENCHMARK_ARTIFACT_LOCK_WAIT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
if [[ "$ARTIFACT_LOCK_WAIT_SECONDS" -le 0 ]]; then
	echo "generate-jsonl-stream-benchmark: WIKI_JSONL_STREAM_BENCHMARK_ARTIFACT_LOCK_WAIT_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if ! command -v flock >/dev/null 2>&1; then
	echo "generate-jsonl-stream-benchmark: flock command is required for evidence artifact lock" >&2
	exit 75
fi
exec 9>"$ARTIFACT_LOCK_FILE"
if ! flock -w "$ARTIFACT_LOCK_WAIT_SECONDS" 9; then
	echo "generate-jsonl-stream-benchmark: artifact lock blocked after ${ARTIFACT_LOCK_WAIT_SECONDS}s: $ARTIFACT_LOCK_FILE" >&2
	exit 75
fi
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate-jsonl-stream-benchmark:data/ops/jsonl_stream_benchmark_evidence.jsonl}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-30000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-10000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=4000}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-jsonl stream evidence written or validation failure}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/jsonl_stream_benchmark_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-jsonl-stream-benchmark}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-jsonl_stream_benchmark_evidence_current_sha256_after_write}"
exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-jsonl-stream-benchmark --timings "$@"
