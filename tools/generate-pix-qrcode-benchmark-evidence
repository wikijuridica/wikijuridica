#!/usr/bin/env bash
# generate-pix-qrcode-benchmark-evidence -- roda os benchmarks REAIS de
# internal/pixqrcode nas duas escalas que o contrato deste repositorio cobra de
# toda dependencia nova (10k e 100k) e grava a evidencia versionada em
# data/ops/pix_qrcode_benchmark_evidence.jsonl.
#
# Por que existe. `github.com/yeqown/go-qrcode/v2` entra como dependencia de
# runtime, e o CLAUDE.md exige ADR, licenca revisada, versao fixada e benchmark
# de escala. Benchmark que mora na mensagem de um commit nao e prova: esta
# sessao ja mediu mensagem de commit mentir. A linha deste ledger corresponde a
# UMA execucao real dos benchmarks neste host -- se `go test -bench` falhar, o
# script sai != 0 e NAO grava nada.
#
# Divisao de papeis do repositorio: `check-*` e read-only e `generate-*` escreve.
# Por isso a medicao nasce aqui, e quem a le e o gate
# `codex2-policy-enforcement` (ValidateApprovedEvidencePaths), que confere se a
# linha descreve o modulo e a versao que o go.mod carrega hoje.
#
# ANTI-FRAUDE: nao ha caminho neste script que escreva numero que o benchmark
# nao tenha produzido. Os ns/op saem do stdout do proprio `go test`, e a escala
# e forcada por -benchtime=<N>x, que fixa o numero de iteracoes em vez de
# deixar o Go escolher -- sem isso, "10k" seria um rotulo sobre uma amostra
# que o runtime dimensionou sozinho.
set -euo pipefail
ROOT="$(
	unset CDPATH
	cd -- "$(dirname -- "$0")/.." && pwd
)"
PATH="$ROOT/tools:$PATH"
export PATH
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

PACOTE="./internal/pixqrcode/"
MODULO="github.com/yeqown/go-qrcode/v2"
EVIDENCIA="data/ops/pix_qrcode_benchmark_evidence.jsonl"

VERSAO_FIXADA="$(awk -v m="$MODULO" '$1 == m {print $2; exit}' "$ROOT/go.mod")"
if [[ -z "${VERSAO_FIXADA:-}" ]]; then
	echo "generate-pix-qrcode-benchmark-evidence: $MODULO nao esta no go.mod" >&2
	exit 1
fi
VERSAO_INDIRETA="$(awk '$1 == "github.com/yeqown/reedsolomon" {print $2; exit}' "$ROOT/go.mod")"
TOOLCHAIN="$(awk '/^[[:space:]]*toolchain[[:space:]]+go/{print $2; exit}' "$ROOT/go.mod")"
GO_MOD_SHA="$(sha256sum "$ROOT/go.mod" | cut -d' ' -f1)"
GO_SUM_SHA="$(sha256sum "$ROOT/go.sum" | cut -d' ' -f1)"

SAIDA="$(mktemp -t wiki-pixqrcode-bench-XXXXXX.txt)"
trap 'rm -f "$SAIDA"' EXIT

# nsPorOperacao <arquivo> <nome do benchmark>
# Le a coluna ns/op da linha daquele benchmark. A linha tem a forma
#   BenchmarkGeraCobranca-8   10000   4274715 ns/op   264578 B/op   3577 allocs/op
# e a busca e pelo rotulo "ns/op", nunca por posicao fixa: o numero de colunas
# muda com -benchmem e com o nome do benchmark.
nsPorOperacao() {
	awk -v alvo="$2" '
		$1 ~ "^"alvo"(-[0-9]+)?$" {
			for (i = 1; i <= NF; i++) {
				if ($i == "ns/op") { print $(i-1); exit }
			}
		}
	' "$1"
}

# linhaDaEscala <iteracoes> <rotulo> <regex dos benchmarks>
#
# O TETO DE TEMPO DO `go test` E EXPLICITO, e nao um detalhe: o padrao e 10
# minutos, e 100.000 iteracoes dos tres benchmarks passam disso com folga. Sem
# `-timeout`, a passada de 100k morre com panic no meio e a evidencia da maior
# escala -- justamente a que o contrato cobra -- nunca e gravada. Medido em
# 2026-09-05: a primeira execucao deste script perdeu a passada de 100k por
# exatamente isso.
linhaDaEscala() {
	local iteracoes="$1"
	local rotulo="$2"
	local alvos="$3"

	if ! ./tools/go-modern test -run '^$' -bench "$alvos" -timeout=90m \
		-benchtime="${iteracoes}x" -count=1 "$PACOTE" >"$SAIDA" 2>&1; then
		echo "generate-pix-qrcode-benchmark-evidence: benchmark falhou na escala $rotulo" >&2
		cat "$SAIDA" >&2
		return 1
	fi

	# ns/op ausente nao e erro quando o benchmark nao estava no escopo daquela
	# passada: a de 100k mede so o caminho completo. O gravador abaixo omite o
	# campo em vez de escrever zero -- zero seria um numero falso num ledger.
	local gera png decodifica
	gera="$(nsPorOperacao "$SAIDA" BenchmarkGeraCobranca)"
	png="$(nsPorOperacao "$SAIDA" BenchmarkPNGDaCobranca)"
	decodifica="$(nsPorOperacao "$SAIDA" BenchmarkDecodifica)"
	if [[ -z "$gera" ]]; then
		echo "generate-pix-qrcode-benchmark-evidence: saida do benchmark sem ns/op na escala $rotulo" >&2
		cat "$SAIDA" >&2
		return 1
	fi

	# A CARGA DO HOST ENTRA NA EVIDENCIA. Este host roda varias frentes ao
	# mesmo tempo, e ns/op medido com o load em 10 nao e o mesmo numero que com
	# o load em 1. Guardar a carga do minuto e do quarto de hora deixa quem le a
	# linha saber se compara maca com maca -- sem isso, uma regressao aparente
	# seria indistinguivel de um vizinho barulhento.
	local carga
	carga="$(cut -d' ' -f1-3 /proc/loadavg)"

	MODULO="$MODULO" VERSAO="$VERSAO_FIXADA" INDIRETA="$VERSAO_INDIRETA" CARGA="$carga" \
		TOOLCHAIN="$TOOLCHAIN" GOMOD="$GO_MOD_SHA" GOSUM="$GO_SUM_SHA" \
		ITERACOES="$iteracoes" ROTULO="$rotulo" \
		GERA="$gera" PNG="$png" DECODIFICA="$decodifica" \
		nice -n 19 python3 - <<'PY' >>"$EVIDENCIA"
import datetime
import json
import os

iteracoes = int(os.environ["ITERACOES"])
gera = float(os.environ["GERA"])


def medido(variavel):
    """Devolve o ns/op quando aquele benchmark rodou nesta passada.

    Campo ausente e ausente: escrever zero para o que nao foi medido poria um
    numero falso num ledger que existe justamente para nao depender de memoria.
    """
    bruto = os.environ.get(variavel, "").strip()
    if not bruto:
        return None
    return float(bruto)


png = medido("PNG")
decodifica = medido("DECODIFICA")

registro = {
    "checked_at": datetime.datetime.now(datetime.timezone.utc)
    .replace(microsecond=0)
    .isoformat()
    .replace("+00:00", "Z"),
    "module_path": os.environ["MODULO"],
    "module_version_pinned": os.environ["VERSAO"],
    "indirect_module_path": "github.com/yeqown/reedsolomon",
    "indirect_module_version_pinned": os.environ["INDIRETA"],
    "toolchain": os.environ["TOOLCHAIN"],
    "go_mod_sha256": os.environ["GOMOD"],
    "go_sum_sha256": os.environ["GOSUM"],
    "scale_label": os.environ["ROTULO"],
    "iterations": iteracoes,
    "host_loadavg": os.environ["CARGA"],
    "host_cpus": os.cpu_count(),
    "gera_cobranca_ns_per_op": gera,
    # O total e o produto EXATO da medicao pelo numero de iteracoes que o
    # -benchtime=<N>x fixou -- nao ha extrapolacao de amostra menor aqui.
    "gera_cobranca_total_seconds": round(gera * iteracoes / 1e9, 3),
    "cobrancas_por_segundo": round(1e9 / gera, 2),
    "use_policy": "approved_internal_runtime_dependency",
    "content_use": "pix_brcode_qr_symbol_rendering_no_publication",
    "approval": False,
    "publication_allowed": False,
    "render_allowed": False,
    "sitemap_allowed": False,
    "scraping_allowed": False,
    "ingestion_allowed": False,
    "raw_text_stored": False,
    "full_text_stored": False,
}
if png is not None:
    registro["png_ns_per_op"] = png
    registro["png_total_seconds"] = round(png * iteracoes / 1e9, 3)
if decodifica is not None:
    registro["decodifica_ns_per_op"] = decodifica
    registro["decodifica_total_seconds"] = round(decodifica * iteracoes / 1e9, 3)
print(json.dumps(registro, ensure_ascii=False, sort_keys=True))
PY
}

# A ESCALA DE 10k MEDE OS TRES CAMINHOS; a de 100k mede o COMPLETO.
#
# O corte e deliberado e nao e economia de rigor. O que a escala responde e "o
# custo por cobranca aguenta volume", e quem responde isso e `Gera` -- payload,
# simbolo e a volta obrigatoria, tudo. O desenho do PNG e a leitura de volta
# entram nele; medi-los TAMBEM 100.000 vezes gastaria mais dez minutos de CPU
# num host compartilhado para reconfirmar, na segunda casa, dois numeros que a
# passada de 10k ja separou. Se algum dia o desenho virar o gargalo, e a
# separacao de 10k que vai mostrar.
linhaDaEscala 10000 "10k" '^Benchmark(GeraCobranca|PNGDaCobranca|Decodifica)$'
linhaDaEscala 100000 "100k" '^BenchmarkGeraCobranca$'

echo "generate-pix-qrcode-benchmark-evidence: duas linhas gravadas em $EVIDENCIA"
