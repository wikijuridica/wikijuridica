#!/usr/bin/env python3
"""generate-medicao-artefato — declara quais sessoes do dia sao SONDA, nao publico.

POR QUE ESTE LEDGER EXISTE. Diagnosticar medicao exige carregar a pagina num
navegador de verdade e deixar o upload subir ate o Clarity e o GA4 — e cada
execucao dessas vira UMA SESSAO REAL no painel do dono. Com o portal em ~25
sessoes humanas por dia, uma tarde de diagnostico distorce a leitura da semana.

O contrato do projeto proibe requisicao com User-Agent de bot real e exige que
aquecimento entre marcado e fora da contagem. A sonda de navegador nao pode ser
marcada por header — o navegador e que emite o UA, e um UA proprio faria o
proprio Loader barrar a sonda (`/bot\\/|crawler|.../i`), tornando o teste inutil.
A saida honesta e a CONTRARIA: nao esconder a sonda, e sim DECLARAR a janela em
que ela rodou, com a apuracao vinda do access.log, para que a leitura do painel
possa descontar.

O QUE CONTA COMO SONDA, e por que estes tres filtros bastam:

  UA de Chrome  — o navegador de verdade que a sonda dirige;
  `cf_ray=-`    — a requisicao NAO passou pela borda; visitante real sempre
                  chega com cf_ray preenchido, porque so ha um caminho publico;
  sem `warm=true` — o aquecimento ja e marcado e ja fica fora da contagem.

Os tres juntos isolam exatamente "navegador dirigido contra 127.0.0.1", que e o
que a sonda faz e o que nenhum visitante faz. Favicon nao entra: e ruido de
carregamento, nao pagina medida.

Uso:
    tools/generate-medicao-artefato --motivo "texto" [--log CAMINHO] [--data AAAA-MM-DD]
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
LEDGER = RAIZ / "data" / "ops" / "medicao_sessoes_artefato.jsonl"
LOG_PADRAO = Path("/var/log/nginx/wikijuridica/access.log")

# O formato e o `wj_main` de ops/nginx/wikijuridica.conf. Casar campo a campo, e
# nao por posicao, porque a linha ganhou campos novos duas vezes (inm/ims em
# 2026-08-28) e um parser posicional teria passado a ler a coluna errada em
# silencio.
LINHA = re.compile(
    r"\[(?P<dia>\d{2})/(?P<mes>\w{3})/(?P<ano>\d{4}):(?P<hora>\d{2}:\d{2}:\d{2}) "
    r"(?P<fuso>[-+]\d{4})\] .*?\"(?:GET|HEAD) (?P<rota>[^ ?]+)[^\"]*\" "
    r"(?P<status>\d{3}) \d+ \"(?P<ua>[^\"]*)\".*?cf_ray=(?P<ray>\S+)"
)
MESES = {m: i for i, m in enumerate(
    "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(), start=1)}


def le_log(caminho: Path) -> list[str]:
    """Le o access.log, com sudo quando o arquivo nao for legivel pelo usuario.

    O log do nginx e 0640 root:adm. Tentar abrir direto e cair no except e mais
    barato que checar permissao, e nao esconde erro: se o sudo tambem falhar, a
    excecao sobe com a mensagem real.
    """
    try:
        return caminho.read_text(encoding="utf-8", errors="replace").splitlines()
    except PermissionError:
        saida = subprocess.run(
            ["sudo", "cat", str(caminho)], capture_output=True, text=True, check=True)
        return saida.stdout.splitlines()


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--motivo", required=True,
                    help="por que a sonda rodou; entra no ledger e e o que o leitor do painel vai ler")
    ap.add_argument("--log", default=str(LOG_PADRAO))
    ap.add_argument("--data", default="", help="AAAA-MM-DD; padrao: o dia mais recente do log")
    args = ap.parse_args()

    linhas = le_log(Path(args.log))
    achados = []
    for linha in linhas:
        casado = LINHA.search(linha)
        if not casado:
            continue
        if "Chrome/" not in casado["ua"]:
            continue
        if casado["ray"] != "-":
            continue          # veio pela borda: e visitante
        if "warm=true" in linha:
            continue          # aquecimento, ja marcado e ja fora da contagem
        if casado["rota"].startswith("/favicon"):
            continue
        data = f"{casado['ano']}-{MESES[casado['mes']]:02d}-{int(casado['dia']):02d}"
        achados.append((data, casado["hora"], casado["fuso"], casado["rota"]))

    if not achados:
        print("nenhuma requisicao de sonda no log: nada a declarar", file=sys.stderr)
        return 0

    dia = args.data or max(a[0] for a in achados)
    doDia = [a for a in achados if a[0] == dia]
    if not doDia:
        print(f"nenhuma requisicao de sonda em {dia}", file=sys.stderr)
        return 1
    doDia.sort(key=lambda a: a[1])

    rotas = Counter(a[3] for a in doDia)
    registro = {
        "data": dia,
        "janela_inicio": f"{doDia[0][1]}{doDia[0][2]}",
        "janela_fim": f"{doDia[-1][1]}{doDia[-1][2]}",
        "requisicoes_de_pagina": len(doDia),
        "rotas": dict(rotas.most_common()),
        "motivo": args.motivo,
        "criterio": "UA de Chrome + cf_ray=- (nao passou pela borda) + sem warm=true, favicon excluido",
        "alcanca_o_painel": True,
        "observacao": (
            "Sessoes de sonda alcancam Clarity e GA4 como qualquer navegador. "
            "Descontar esta janela ao ler o painel do dia; no Clarity, as sondas "
            "que subiram payload carregam a etiqueta diagnostico=gate."
        ),
        "fonte": str(args.log),
    }
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as saida:
        saida.write(json.dumps(registro, ensure_ascii=False) + "\n")
    print(f"declarado: {len(doDia)} requisicao(oes) de sonda em {dia} "
          f"({registro['janela_inicio']} a {registro['janela_fim']}) -> {LEDGER}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
