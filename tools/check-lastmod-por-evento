#!/usr/bin/env python3
"""Reprova lastmod que nao corresponde a evento de revisao real — a trava anti-date-bumping.

POR QUE ESTE CHECK EXISTE (2026-08-13)
--------------------------------------
O acervo tem 9.873 URLs com 99,1% no mesmo `lastmod 2026-08-06`, imovel desde a
publicacao inicial. A tentacao obvia, diante de um Googlebot que parou de voltar,
e "atualizar as datas". Isso e date-bumping, e falha por dois motivos
independentes:

  1. E fraude pelo contrato deste repositorio: metrica e sinal so refletem o que
     aconteceu de verdade.
  2. NAO FUNCIONA. A documentacao do Google e explicita
     (developers.google.com/search/docs/crawling-indexing/sitemaps/build-sitemap,
     consultada em 13/08/2026): o `<lastmod>` so e usado se for "consistently and
     verifiably accurate", e "an update to the copyright date is NOT" considerado
     significativo. Carimbar data sem mudanca ensina o Google a ignorar o campo —
     e o dano e permanente, porque a confianca no sinal nao volta com um commit.

O QUE CONTA COMO MUDANCA SIGNIFICATIVA, segundo a mesma fonte: conteudo
principal, structured data e LINKS DA PAGINA. As tres sao verificaveis no
artefato, e e nelas que o frescor legitimo deste acervo nasce — os links
relacionados, por exemplo, sao recalculados a cada republicacao a partir da
malha real (internal/v2publish/relatedlinks.go).

O QUE ESTE CHECK COBRA
----------------------
Para cada pagina publicada, o `lastmod` declarado no sitemap tem de ser
consistente com o artefato em disco: uma data NOVA exige que o HTML tenha
mudado. Data nova com HTML intocado e exatamente o padrao do date-bumping.

O inverso — HTML novo com data antiga — NAO e reprovado aqui: e o caso legitimo
de mudanca estrutural (malha de links) sem revisao editorial, e o sinal honesto
para ele e o Last-Modified HTTP, que o publicador ja emite.

★ O ORACULO ORIGINAL ERA CEGO POR CONSTRUCAO, e isto foi medido em 2026-09-01
--------------------------------------------------------------------------
Ate hoje este check comparava o `lastmod` do sitemap com o **mtime** do HTML. Mas
`gravaDatado` (cmd/publish-v2-direct) escreve o mtime A PARTIR da propria data
editorial quando os bytes nao mudam: medido em public/familia/index.html, mtime =
2026-08-26 00:00:00 UTC exato enquanto o ctime real era 2026-09-01 16:05:59. O
gate comparava a data com ela mesma.

Consequencia medida sobre as 18.921 entradas servidas: `adiante_max` = 0,316 h
contra tolerancia de 36 h — 114x abaixo do limiar. **O ramo de reprovacao era
matematicamente inalcancavel**, e foi por isso que este gate ficou VERDE durante
os quatro eventos de re-datacao em massa de 26 a 28/08, incluindo a ida-e-volta
de 8.245 URLs disparada por uma <meta> de analytics. Quem desfez aquilo foi uma
pessoa que reparou, nao um gate.

O oraculo agora e INDEPENDENTE: comparar versoes commitadas do proprio ledger
data/ops/page_content_revision.jsonl e reprovar quando `revised_on` AVANCOU com
`content_sha256` E `served_sha256` INALTERADOS. Isso e date-bumping por definicao,
e nao depende de nenhum metadado que o publicador escreva.

A checagem por mtime continua, porque ainda apanha o caso de arquivo AUSENTE e
custa quase nada — mas ela nao e mais a unica, e o cabecalho agora diz o que ela
nao consegue ver.

READ-ONLY.
"""

from __future__ import annotations

import argparse
import datetime
import subprocess
import glob
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
SHARDS = RAIZ / "public" / "sitemaps"
PUBLICO = RAIZ / "public"
LEDGER_REL = "data/ops/page_content_revision.jsonl"


def _ledger_em(commit: str) -> dict[str, dict]:
    """Le o ledger como estava num commit. Devolve {} se o arquivo nao existia la."""
    try:
        bruto = subprocess.run(["git", "show", f"{commit}:{LEDGER_REL}"],
                               capture_output=True, text=True, cwd=str(RAIZ), timeout=120)
    except (OSError, subprocess.SubprocessError):
        return {}
    if bruto.returncode != 0:
        return {}
    fora = {}
    for linha in bruto.stdout.splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            obj = json.loads(linha)
        except json.JSONDecodeError:
            continue
        caminho = obj.get("path")
        if caminho:
            fora[caminho] = obj
    return fora


def date_bumping_no_ledger(quantas_versoes: int, desde_dias: int) -> list[tuple]:
    """O oraculo INDEPENDENTE: data que avancou com os dois hashes parados.

    Compara PAR A PAR, nunca so contra HEAD. O motivo e concreto: em 28/08 uma
    re-datacao de 8.642 rotas foi revertida 1h03 depois, e no saldo contra HEAD as
    duas se anulam — o evento sumiria de qualquer medicao que olhasse so as pontas.
    """
    try:
        log = subprocess.run(
            ["git", "log", "--format=%H %cI", f"-{max(quantas_versoes, 2)}", "--", LEDGER_REL],
            capture_output=True, text=True, cwd=str(RAIZ), timeout=120)
    except (OSError, subprocess.SubprocessError):
        return []
    if log.returncode != 0:
        return []
    datado: dict[str, str] = {}
    for linha in log.stdout.splitlines():
        partes = linha.split()
        if len(partes) >= 2:
            datado[partes[0]] = partes[1]
    commits = list(datado)
    commits.reverse()  # do mais antigo para o mais novo
    corte = None
    if desde_dias > 0:
        corte = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=desde_dias)
    if len(commits) < 2:
        return []

    achados: list[tuple[str, str, str, int]] = []
    anterior = _ledger_em(commits[0])
    for commit in commits[1:]:
        atual = _ledger_em(commit)
        if not atual:
            continue
        quantas = 0
        exemplo = ("", "", "")
        for caminho, novo in atual.items():
            velho = anterior.get(caminho)
            if not velho:
                continue
            data_velha, data_nova = str(velho.get("revised_on", "")), str(novo.get("revised_on", ""))
            if not data_velha or not data_nova or data_nova <= data_velha:
                continue
            # A data avancou. Algum dos dois hashes justifica?
            if velho.get("content_sha256") != novo.get("content_sha256"):
                continue
            velho_servido, novo_servido = velho.get("served_sha256"), novo.get("served_sha256")
            if velho_servido is not None and novo_servido is not None and velho_servido != novo_servido:
                continue
            # SEMEADURA NAO E BUMPING: served_sha256 que nasce (None -> hash) e o
            # campo sendo gravado pela primeira vez, nao evidencia de mudanca.
            if velho_servido is None and novo_servido is not None:
                continue
            quantas += 1
            if not exemplo[0]:
                exemplo = (caminho, data_velha, data_nova)
        if quantas:
            dentro = True
            if corte is not None:
                try:
                    quando = datetime.datetime.fromisoformat(datado.get(commit, ""))
                    dentro = quando >= corte
                except ValueError:
                    dentro = True
            achados.append((commit[:8], f"{exemplo[1]} -> {exemplo[2]}", exemplo[0], quantas,
                            datado.get(commit, "")[:10], dentro))
        anterior = atual
    return achados


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tolerancia-horas", type=int, default=36,
                    help="folga entre o lastmod e o mtime do artefato (default 36h: publicacao e "
                         "carimbo editorial nao acontecem no mesmo instante)")
    ap.add_argument("--desde-dias", type=int, default=3,
                    help="janela de REPROVACAO, em dias (default 3). Evento anterior a ela "
                         "continua sendo MEDIDO e IMPRESSO, mas nao reprova: gate existe para "
                         "barrar regressao nova, e re-datar de volta o que ja passou seria "
                         "fabricar outra data. Use --desde-dias 0 para auditar tudo.")
    ap.add_argument("--versoes-do-ledger", type=int, default=40,
                    help="quantas versoes commitadas do ledger comparar par a par (default 12). "
                         "A JANELA IMPORTA: um par re-datacao+rollback dentro da mesma janela se "
                         "anula no saldo contra HEAD, e so aparece na comparacao par a par.")
    args = ap.parse_args()

    bumping = date_bumping_no_ledger(args.versoes_do_ledger, args.desde_dias)

    suspeitas, conferidas, sem_arquivo = [], 0, 0
    for arq in sorted(glob.glob(str(SHARDS / "pages-*.xml"))):
        texto = pathlib.Path(arq).read_text(encoding="utf-8")
        for loc, data in re.findall(r"<url>\s*<loc>([^<]+)</loc>\s*<lastmod>([^<]+)</lastmod>", texto):
            caminho = loc.replace("https://wikijuridica.com.br", "").strip("/")
            html = PUBLICO / caminho / "index.html" if caminho else PUBLICO / "index.html"
            if not html.is_file():
                sem_arquivo += 1
                continue
            conferidas += 1
            try:
                declarada = datetime.datetime.fromisoformat(data.replace("Z", "+00:00"))
            except ValueError:
                suspeitas.append((loc, data, "lastmod ilegivel"))
                continue
            if declarada.tzinfo is None:
                declarada = declarada.replace(tzinfo=datetime.timezone.utc)
            mtime = datetime.datetime.fromtimestamp(html.stat().st_mtime, datetime.timezone.utc)

            # Data declarada MUITO a frente do artefato = carimbo sem mudanca.
            # A folga cobre o intervalo normal entre revisao editorial e
            # publicacao; o que ela nao cobre e data nova sobre arquivo velho.
            adiante = (declarada - mtime).total_seconds() / 3600.0
            if adiante > args.tolerancia_horas:
                suspeitas.append((loc, data, f"lastmod {adiante:.0f}h a frente do artefato"))

    print(f"  URLs conferidas: {conferidas} | sem arquivo em disco: {sem_arquivo}")
    if suspeitas:
        print("check-lastmod-por-evento: FAIL")
        print(f"  - {len(suspeitas)} pagina(s) com lastmod sem mudanca correspondente no artefato:")
        for loc, data, motivo in suspeitas[:12]:
            print(f"      {loc} lastmod={data} ({motivo})")
        if len(suspeitas) > 12:
            print(f"      ... e mais {len(suspeitas) - 12}")
        print("  Date-bumping nao so e proibido pelo contrato: o Google ignora lastmod impreciso,")
        print("  e a confianca no sinal nao volta. Frescor se cria mudando conteudo, structured")
        print("  data ou links — as tres que a documentacao dele nomeia como significativas.")
        return 1

    dentro = [b for b in bumping if b[5]]
    fora = [b for b in bumping if not b[5]]

    # NADA FICA ESCONDIDO: o que esta fora da janela e impresso do mesmo jeito,
    # so nao reprova. Silenciar dívida seria a versao ruim de "baseline".
    if fora:
        print(f"  historico fora da janela de {args.desde_dias}d (medido, NAO reprova):")
        for commit, salto, exemplo, quantas, quando, _ in fora[:8]:
            print(f"      {quando} {commit}: {quantas} rota(s), ex. {exemplo} ({salto})")
        if len(fora) > 8:
            print(f"      ... e mais {len(fora) - 8} versao(oes)")

    if dentro:
        total = sum(q for _, _, _, q, _, _ in dentro)
        print("check-lastmod-por-evento: FAIL")
        print(f"  - date-bumping no ledger: {total} re-datacao(oes) sem nenhum hash mudar,")
        print(f"    em {len(dentro)} versao(oes) dentro da janela de {args.desde_dias} dia(s):")
        for commit, salto, exemplo, quantas, quando, _ in dentro[:12]:
            print(f"      {quando} {commit}: {quantas} rota(s), ex. {exemplo} ({salto})")
        if len(dentro) > 12:
            print(f"      ... e mais {len(dentro) - 12} versao(oes)")
        print("  Data que avanca com content_sha256 E served_sha256 parados e carimbo sem evento.")
        print("  Se a mudanca foi de MARKUP, o certo e --ressemear (nao re-data ninguem).")
        print("  Se foi editorial de verdade, o gerador exige --redatacao-em-massa='<motivo>'.")
        return 1

    print("check-lastmod-por-evento: pass")
    print(f"  {conferidas} URLs conferidas contra o artefato, e ate {args.versoes_do_ledger} versoes")
    print(f"  do ledger comparadas par a par: nenhuma data avancou com os dois hashes parados")
    print(f"  dentro da janela de {args.desde_dias} dia(s).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
