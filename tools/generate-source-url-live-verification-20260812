#!/usr/bin/env python3
"""generate-source-url-live-verification-20260812 — o código HTTP das fontes que foram gravadas sem ele.

O DEFEITO. 305 fontes oficiais do estoque v2 foram gravadas sem `http_status`, e
135 delas também sem `verified_at`. O ingest exige os dois (internal/v2ingest/
validate.go:674 e :686) e rejeita a página com `official_source_http_status_
invalid:status=0` e `official_source_verified_at_invalid`. São 283 páginas
paradas por campo faltando, não por defeito de conteúdo.

O CAMPO SÓ PODE SER PREENCHIDO POR OBSERVAÇÃO. Deduzir 200 porque a URL parece
boa é escrever evidência que ninguém colheu. Este gerador faz uma requisição GET
por URL distinta, com pausa POR HOST (órgão público não é banco de teste), e
grava o código real, a data real, o tamanho e o SHA-256 do que respondeu.

O QUE `verified_at` PASSA A SIGNIFICAR, dito sem eufemismo: a data em que a URL
foi requisitada e respondeu com o código registrado — verificação de
disponibilidade da referência, não auditoria do conteúdo. É o mesmo par
(`http_status`, `verified_at`) que as 21.039 fontes já aceitas carregam. A
conferência do texto do dispositivo, quando a fonte é lei do corpus, é feita
separadamente por `generate-legal-corpus-live-verification-20260812`.

Complementa aquele gerador: ali vão os diplomas do corpus legal; aqui, qualquer
URL de fonte já gravada no estoque.

Uso:
    tools/generate-source-url-live-verification-20260812 --urls-de arquivo.txt --dry-run
    tools/generate-source-url-live-verification-20260812 --urls-de arquivo.txt
"""
from __future__ import annotations

import argparse
import collections
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
SAIDA = os.path.join(ROOT, "data/source-audit/source_url_live_verification_20260812.json")


def carregar_modulo(nome, caminho):
    spec = importlib.util.spec_from_loader(
        nome, importlib.machinery.SourceFileLoader(nome, caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


GLC = carregar_modulo("glc", os.path.join(ROOT, "tools/generate-legal-corpus"))
GLV = carregar_modulo("glv", os.path.join(
    ROOT, "tools/generate-legal-corpus-live-verification-20260812"))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--urls-de", required=True,
                        help="arquivo com uma URL por linha")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--pausa", type=float, default=3.0,
                        help="segundos entre requisições AO MESMO host")
    args = parser.parse_args()

    with open(args.urls_de, encoding="utf-8") as handle:
        urls = [linha.strip() for linha in handle if linha.strip()]
    urls = sorted(dict.fromkeys(urls))
    hosts = collections.Counter(urllib.parse.urlparse(u).hostname for u in urls)
    print("=== CONFERÊNCIA VIVA DE URL DE FONTE ===")
    print("URLs distintas : %d" % len(urls))
    print("hosts          : %s" % ", ".join("%s(%d)" % (h, n) for h, n in hosts.most_common()))
    if args.dry_run:
        for u in urls:
            print("  %s" % u)
        print("--dry-run: nenhuma requisição feita.")
        return 0

    hoje = datetime.date.today().isoformat()
    ultimo_no_host = {}
    registros = {}
    for url in urls:
        host = urllib.parse.urlparse(url).hostname
        espera = args.pausa - (time.monotonic() - ultimo_no_host.get(host, -1e9))
        if espera > 0:
            time.sleep(espera)
        try:
            status, bruto = GLV.observar(url, GLC.NAVEGADOR)
            registro = {
                "url": url, "consultado_em": hoje, "http_status": status,
                "document_bytes": len(bruto),
                "document_sha256": hashlib.sha256(bruto).hexdigest(),
            }
        except Exception as erro:
            registro = {"url": url, "consultado_em": hoje, "http_status": 0,
                        "erro": str(erro)[:140]}
        ultimo_no_host[host] = time.monotonic()
        registros[url] = registro
        print("  HTTP %-3s  %s" % (registro["http_status"], url[:100]))

    payload = {
        "gerado_em": hoje,
        "criterio": ("Um GET real por URL distinta, com pausa de %.1fs entre requisições ao "
                     "MESMO host e cabeçalhos de navegador (o WAF do Planalto recusa sem "
                     "eles). Grava-se o código HTTP observado — jamais inferido — a data da "
                     "requisição, o tamanho e o SHA-256 do que respondeu. Erro de rede vira "
                     "status 0 com a mensagem, nunca 200." % args.pausa),
        "significado_de_verified_at": ("data em que a URL respondeu o código registrado; "
                                       "é verificação de disponibilidade da referência, "
                                       "não auditoria do conteúdo citado"),
        "urls": registros,
    }
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    with open(SAIDA, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=1, sort_keys=True)
        handle.write("\n")
    ok = sum(1 for r in registros.values() if r["http_status"] in (200, 203, 206))
    print("\naceitos pelo ingest (200/203/206): %d de %d" % (ok, len(registros)))
    print("gravado %s" % os.path.relpath(SAIDA, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
