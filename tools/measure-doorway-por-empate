#!/usr/bin/env python3
"""measure-doorway-por-empate — mede quanto do doorway da malha nasce de EMPATE
de score, e não de afinidade real.

O DEFEITO, MEDIDO EM 2026-09-06. `check-internal-link-block` reprovou com
doorway (Jaccard > 0,50 entre páginas da MESMA área) subindo de 106 para 478 —
337 pares em `/jurisprudencia/stf-adi-*` (35 páginas) e 126 em `/noticias/*`
(19). Duas famílias concentram 96,9% dos pares.

A CAUSA NÃO É O RESOLVEDOR ESCOLHER MAL: é ele desempatar por ordem alfabética.
`internal/v2publish.ResolveRelatedContent` monta o bag de assunto de
`title + h1 + internal_link_topics` e pontua por sobreposição de termos
significativos (`count*10`, mais 15 se a área for a mesma). As 43 ADIs do shard
`stf-informativo-derivado-01` carregam `internal_link_topics` IDÊNTICOS e
taxonômicos — `['constitucional', 'jurisprudencia-stf', 'adi']` — herdados do
coletor, que descrevem o TIPO do documento e não o assunto dele.

Desses três rótulos sobram dois tokens ('adi' cai no piso de 4 caracteres):
`constitucional` e `jurisprudencia`. Como `minTopicOverlap` é 2, esses dois
sozinhos já qualificam qualquer ADI como vizinha de qualquer outra — e todas com
o MESMO score, 35. O desempate então é `intent_id` alfabético, e 43 páginas
copiam o mesmo prefixo da mesma fila.

PROVA POR MUTAÇÃO (o que este medidor imprime): removidos apenas os dois tokens
taxonômicos, as ADIs caem de mediana 32 candidatas para 7 páginas com 1 ou 2.
Ou seja, ~97% da "afinidade" que produz os doorways é vocabulário de catálogo,
não tema. É o mesmo achado de `generate-v2-link-topics-ponte-cross-area-20260829`
("rótulos de taxonomia herdados do coletor"), medido agora pelo outro lado: lá
faltava ponte cross-área, aqui sobra bloco idêntico — mesma raiz.

O CONTRAFACTUAL, e é o que decide a correção: mantendo o critério de afinidade
INTACTO e trocando só o desempate de empates por uma rotação determinística
(sha256 de origem+destino), o doorway da família cai de 448 para 4, os destinos
distintos sobem de 25 para 42 e a maior concentração de entradas cai de 36 para
10. Nada é inventado — as candidatas empatadas já são igualmente afins pelo
critério vigente; o alfabeto é que as concentrava.

O DESEMPATE AQUI É O MESMO DO GO, byte a byte: FNV-1a 64 sobre
`origem + 0x1f + destino`, seguido do finalizador do SplitMix64. Reproduzi-lo em
vez de usar sha256 não é preciosismo — um medidor que simula OUTRO resolvedor
prevê um resultado que a publicação não entrega, e essa é a classe de defeito
que esta sessão vem perseguindo. O finalizador é obrigatório: FNV-1a sozinho tem
avalanche fraca no último byte, e com intent_id sequencial os vizinhos
consecutivos saíam agrupados aos pares (medido na bancada de
internal/v2publish/desempate_estavel_test.go).

E NUNCA `hash()` do Python, que é salgado por processo e daria bloco diferente a
cada execução; o manifesto exige o mesmo HTML em duas passadas.

Read-only (contrato tools/*): não escreve nada, não toca o estoque.
"""
import collections
import itertools
import json
import re
import unicodedata
import os
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STOCK = os.path.join(RAIZ, "data", "editorial", "v2_pages")

# Espelham internal/v2publish/relatedlinks.go. Divergir aqui é medir outro
# resolvedor: qualquer mudança lá tem de ser refletida aqui, e é por isso que o
# medidor imprime os valores que usou.
STOPWORDS = set(
    "a o as os de da do das dos e em no na nos nas para por com sem que ao aos "
    "um uma se ou ate pelo pela direito juridico juridica lei legal processo "
    "acao caso sobre como quando onde qual quais meu minha seu sua nao".split()
)
MIN_TOPIC_OVERLAP = 2
BONUS_MESMA_AREA = 15
TETO_PADRAO = 4


def normaliza(valor: str) -> str:
    decomposto = unicodedata.normalize("NFD", valor.lower())
    return "".join(c for c in decomposto if c.isalnum() and ord(c) < 128)


def tokens_significativos(texto: str) -> list:
    saida, vistos = [], set()
    for campo in re.split(r"[^0-9A-Za-zÀ-ÿ]+", texto):
        token = normaliza(campo)
        if len(token) < 4 or token in STOPWORDS or token in vistos:
            continue
        vistos.add(token)
        saida.append(token)
    return saida


def carrega_familia(prefixo_intent: str) -> dict:
    """Bag de assunto por intent_id, para os registros cujo intent casa o prefixo."""
    familia = {}
    for nome in sorted(os.listdir(STOCK)):
        if not nome.endswith(".jsonl"):
            continue
        with open(os.path.join(STOCK, nome), encoding="utf-8") as fh:
            for linha in fh:
                linha = linha.strip()
                if not linha:
                    continue
                reg = json.loads(linha)
                intent = str(reg.get("intent_id", ""))
                if prefixo_intent not in intent:
                    continue
                assunto = " ".join([
                    str(reg.get("title", "")),
                    str(reg.get("h1", "")),
                    " ".join(reg.get("internal_link_topics") or []),
                ])
                familia[intent] = set(tokens_significativos(assunto))
    return familia


def candidatos(familia: dict, origem: str, descartar: set) -> dict:
    """Score pelo MESMO critério do Go. A família inteira é da mesma área, então
    o bônus entra como constante — o que importa aqui é o empate que ele preserva."""
    saida = {}
    meus = familia[origem] - descartar
    for outro, seus in familia.items():
        if outro == origem:
            continue
        comuns = len(meus & (seus - descartar))
        if comuns < MIN_TOPIC_OVERLAP:
            continue
        saida[outro] = comuns * 10 + BONUS_MESMA_AREA
    return saida


def monta_blocos(familia: dict, desempate, teto: int, descartar: set) -> dict:
    blocos = {}
    for origem in sorted(familia):
        score = candidatos(familia, origem, descartar)
        ordem = sorted(score, key=lambda alvo: (-score[alvo], desempate(origem, alvo)))
        blocos[origem] = ordem[:teto]
    return blocos


def jaccard(a, b) -> float:
    A, B = set(a), set(b)
    return len(A & B) / len(A | B) if A | B else 0.0


def resume(blocos: dict) -> dict:
    ids = sorted(blocos)
    pares = [
        (a, b, jaccard(blocos[a], blocos[b]))
        for a, b in itertools.combinations(ids, 2)
    ]
    altos = [p for p in pares if p[2] > 0.50]
    envolvidas = set()
    for a, b, _ in altos:
        envolvidas.update((a, b))
    entradas = collections.Counter()
    for destinos in blocos.values():
        for destino in destinos:
            entradas[destino] += 1
    return {
        "doorway_pares": len(altos),
        "paginas_envolvidas": len(envolvidas),
        "destinos_distintos": len(entradas),
        "maior_concentracao": max(entradas.values()) if entradas else 0,
        "sem_bloco": sum(1 for v in blocos.values() if not v),
    }


MASCARA_64 = 0xFFFFFFFFFFFFFFFF
FNV_OFFSET_BASIS = 14695981039346656037
FNV_PRIME = 1099511628211


def rotacao(origem: str, alvo: str) -> int:
    """Desempate determinístico e não-concentrador — a MESMA construção de
    internal/v2publish.desempateEstavel.

    O separador 0x1f impede que (a+b) colida com (a'+b') por concatenação
    ambígua; o finalizador do SplitMix64 corrige a avalanche fraca do FNV-1a no
    último byte, sem a qual intent_id sequenciais saem agrupados aos pares."""
    h = FNV_OFFSET_BASIS
    for byte in origem.encode("utf-8") + b"\x1f" + alvo.encode("utf-8"):
        h = ((h ^ byte) * FNV_PRIME) & MASCARA_64
    h ^= h >> 30
    h = (h * 0xBF58476D1CE4E5B9) & MASCARA_64
    h ^= h >> 27
    h = (h * 0x94D049BB133111EB) & MASCARA_64
    h ^= h >> 31
    return h


def main() -> int:
    prefixo = sys.argv[1] if len(sys.argv) > 1 else "stf-adi"
    teto = int(sys.argv[2]) if len(sys.argv) > 2 else TETO_PADRAO
    familia = carrega_familia(prefixo)
    if not familia:
        print(f"nenhum registro com intent contendo {prefixo!r} em {os.path.relpath(STOCK, RAIZ)}",
              file=sys.stderr)
        return 2

    print(f"familia .............. intent contendo {prefixo!r}")
    print(f"paginas .............. {len(familia)}")
    print(f"teto do bloco ........ {teto}   (minTopicOverlap={MIN_TOPIC_OVERLAP})")

    tam = sorted(len(v) for v in familia.values())
    print(f"tokens por pagina .... min {tam[0]}  mediana {tam[len(tam) // 2]}  max {tam[-1]}")

    # Quais tokens são compartilhados por quase toda a família: é o vocabulário
    # de catálogo que cria o empate.
    freq = collections.Counter()
    for toks in familia.values():
        for t in toks:
            freq[t] += 1
    catalogo = {t for t, n in freq.items() if n >= max(2, int(len(familia) * 0.8))}
    print(f"tokens em >=80% da familia (vocabulario de catalogo): {sorted(catalogo) or 'nenhum'}")

    print()
    print(f"{'cenario':<38}{'doorway':>9}{'paginas':>9}{'destinos':>10}{'max_ent':>9}{'sem_bloco':>11}")
    cenarios = [
        ("HOJE (desempate alfabetico)", lambda o, a: a, set()),
        ("CONTRAFACTUAL rotacao FNV-1a+SplitMix", rotacao, set()),
        ("MUTACAO sem o vocab. de catalogo", lambda o, a: a, catalogo),
    ]
    for nome, desempate, descartar in cenarios:
        r = resume(monta_blocos(familia, desempate, teto, descartar))
        print(f"{nome:<38}{r['doorway_pares']:>9}{r['paginas_envolvidas']:>9}"
              f"{r['destinos_distintos']:>10}{r['maior_concentracao']:>9}{r['sem_bloco']:>11}")

    print()
    print("A linha MUTACAO e a prova da causa: sem os rotulos de catalogo a familia")
    print("perde quase toda candidata, o que mede quanto da afinidade vinha deles.")
    print("A linha CONTRAFACTUAL e o efeito de trocar SO o desempate, preservando")
    print("intacto o criterio de afinidade -- nenhuma aresta nova e' inventada.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
