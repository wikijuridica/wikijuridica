#!/usr/bin/env python3
"""check-social-csp — a CSP SERVIDA é, byte a byte, a que a constante Go governa?

READ-ONLY. Não escreve arquivo nenhum.

DUAS METADES:

  ESTRUTURAL  `cmd/check social-csp` (internal/socialborda) prova que cada .conf
              de ops/nginx declara exatamente a constante de
              internal/socialheaders que o governa, que o cmd/social emite a
              CONSTANTE (nunca um literal irmão) e que a location social inclui
              esse .conf.
  SERVIDA     esta sonda lê o cabeçalho que o nginx e o processo social de fato
              devolvem e o compara byte a byte.

A CADEIA DE IGUALDADE, e por que a sonda não precisa reimplementar a constante
Go. O gate estrutural já provou `.conf == constante Go`. Esta sonda prova
`servido == .conf`. Por transitividade, `servido == constante Go` — e o valor de
referência é lido do .conf, no disco, em vez de copiado para dentro deste script.
Uma terceira cópia da política aqui seria mais uma fonte a divergir, que é
exatamente a classe de defeito que os dois gates existem para impedir. Por isso a
sonda só roda depois de o estrutural passar: sem ele, o .conf não é referência
confiável.

REPETIÇÃO CONTA COMO DEFEITO. Duas CSPs na mesma resposta são aplicadas como
INTERSEÇÃO pelo navegador, então a sonda lê TODOS os valores do cabeçalho, e não
só o último — `dict(getheaders())` colapsaria a repetição e aprovaria o defeito.

exit 0 medido e correto · exit 1 medido e errado (ou gate estrutural reprovado)
· exit 2 não foi possível medir.
"""
import importlib.util
import os
import re
import secrets
import sys


def carrega_sonda():
    """Carrega tools/social_borda_probe.py sem mexer no sys.path.

    O idioma usual aqui seria `sys.path.insert(...)` seguido de import, que
    obriga a um `# noqa: E402` — e suprimir o diagnostico em vez de resolver a
    causa e proibido neste repositorio. Carregar por caminho explicito resolve a
    causa: nao ha import fora de ordem para o lint reclamar.
    """
    caminho = os.path.join(os.path.dirname(os.path.abspath(__file__)), "social_borda_probe.py")
    spec = importlib.util.spec_from_file_location("social_borda_probe", caminho)
    if spec is None or spec.loader is None:
        raise ImportError(f"nao consegui carregar {caminho}")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


sonda = carrega_sonda()

NOME = "check-social-csp"
CONF_PUBLICO = "ops/nginx/social-headers-publico.conf"
CONF_PRIVADO = "ops/nginx/social-headers-privado.conf"
RE_CSP = re.compile(r'more_set_headers\s+"Content-Security-Policy:[ ]?([^"]*)"\s*;')


def politica_do_conf(relativo):
    """Lê a CSP de referência do .conf que o gate estrutural já validou."""
    caminho = os.path.join(sonda.RAIZ, relativo)
    try:
        with open(caminho, encoding="utf-8") as f:
            conteudo = f.read()
    except OSError as erro:
        return None, f"nao consegui ler {relativo}: {erro}"
    achados = RE_CSP.findall(conteudo)
    if len(achados) != 1:
        return None, f"{relativo} declara Content-Security-Policy {len(achados)} vez(es); esperava exatamente 1"
    return achados[0], None


def compara(rotulo, valores, esperada, problemas):
    if not valores:
        problemas.append(f"{rotulo}: a resposta nao trouxe Content-Security-Policy nenhuma")
        return
    if len(valores) > 1:
        problemas.append(
            f"{rotulo}: a resposta trouxe {len(valores)} cabecalhos Content-Security-Policy; "
            "o navegador aplicaria a INTERSECAO das politicas")
        return
    servida = valores[0]
    if servida == esperada:
        return
    for i, (a, b) in enumerate(zip(esperada, servida)):
        if a != b:
            problemas.append(
                f"{rotulo}: a politica servida diverge da versionada no byte {i}: "
                f"esperava {esperada[max(0, i - 20):i + 40]!r}, veio {servida[max(0, i - 20):i + 40]!r}")
            return
    problemas.append(
        f"{rotulo}: a politica servida tem {len(servida)} bytes e a versionada tem {len(esperada)}; "
        f"a diferenca esta no fim: {servida[len(esperada):]!r}")


def main():
    codigo, saida = sonda.gate_estrutural("social-csp")
    if codigo == sonda.ERRADO:
        print(saida.rstrip())
        return sonda.relata(NOME, sonda.ERRADO, [
            "o gate estrutural social-csp reprovou: a politica versionada, o codigo que a emite e a location "
            "que a serve nao estao alinhados. A sonda nao roda porque o .conf ainda nao e referencia confiavel."])
    if codigo == sonda.INCONCLUSIVO:
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [saida.strip()])

    publica, erro = politica_do_conf(CONF_PUBLICO)
    if erro:
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [erro])
    privada, erro = politica_do_conf(CONF_PRIVADO)
    if erro:
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [erro])

    if not sonda.escuta(sonda.PORTA_SOCIAL):
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [
            f"nada escutando em 127.0.0.1:{sonda.PORTA_SOCIAL} (cmd/social): "
            "a politica versionada esta coerente e o cabecalho servido nao pode ser medido agora"])

    nonce = secrets.token_hex(8)
    # `problemas` sao defeitos MEDIDOS; `impedimentos` sao camadas que nao deu
    # para medir. A separacao decide o codigo de saida, e junta-las ja seria o
    # defeito: um cabecalho divergente medido no 8091 sairia como INCONCLUSIVO
    # so porque o nginx estava fora do ar, e um FAIL real viraria "nao deu para
    # medir".
    problemas = []
    impedimentos = []
    medidos = 0

    # O processo social direto: prova o que o Go emite, sem a camada do nginx.
    for rotulo, cookie, esperada in (
        ("8091 anonimo", None, publica),
        ("8091 com sessao", f"wjsession={nonce}", privada),
    ):
        cabecalhos = {"Cookie": cookie} if cookie else None
        status, headers, erro = sonda.requisita_bruto(sonda.PORTA_SOCIAL, "/redesocial/", cabecalhos=cabecalhos)
        if erro:
            return sonda.relata(NOME, sonda.INCONCLUSIVO, [f"{rotulo}: {erro}"])
        medidos += 1
        compara(f"{rotulo} (HTTP {status})", sonda.cabecalhos_repetidos(headers, "Content-Security-Policy"), esperada, problemas)

    # Pelo nginx: prova o que o visitante recebe, com more_set_headers aplicado.
    if sonda.escuta(sonda.PORTA_NGINX):
        for rotulo, cookie, esperada in (
            ("8088 anonimo", None, publica),
            ("8088 com sessao", f"wjsession={nonce}", privada),
        ):
            cabecalhos = {"Cookie": cookie} if cookie else None
            status, headers, erro = sonda.requisita_bruto(sonda.PORTA_NGINX, "/redesocial/", cabecalhos=cabecalhos)
            if erro:
                impedimentos.append(f"{rotulo}: {erro}")
                continue
            medidos += 1
            compara(f"{rotulo} (HTTP {status})", sonda.cabecalhos_repetidos(headers, "Content-Security-Policy"), esperada, problemas)
    else:
        impedimentos.append(
            f"nada escutando em 127.0.0.1:{sonda.PORTA_NGINX}: medi o cabecalho no processo social, "
            "mas nao o que o nginx entrega ao visitante")

    # Defeito medido vence impedimento: o que ja foi visto errado nao vira
    # duvida por causa da camada que faltou medir.
    if problemas:
        return sonda.relata(NOME, sonda.ERRADO, problemas + impedimentos)
    if impedimentos:
        return sonda.relata(NOME, sonda.INCONCLUSIVO, impedimentos)
    return sonda.relata(NOME, sonda.OK, [
        f"{medidos} resposta(s) medida(s) no 8091 e no 8088: CSP servida igual, byte a byte, a versionada "
        "(publica para anonimo, privada para quem tem cookie de sessao)"])


if __name__ == "__main__":
    sys.exit(main())
