#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_OSS_INSTALL_MATRIX_NO_INSTALL=1
cd "$ROOT"
exec "$ROOT/tools/oss-install-matrix-env" "$ROOT/tools/run-check" oss-integration-decisions --timings "$@"
