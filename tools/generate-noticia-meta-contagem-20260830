#!/usr/bin/env python3
"""Corrige a contagem colada na meta description de /noticias/, num registro só.

POR QUE UM GERADOR DATADO, E NAO UMA REGERACAO

O defeito ja foi corrigido no PRODUTOR: cmd/generate-noticia-pages usa
`concordanciaDeDecisao(len(ordenados))` e o comentario de :669 registra a medicao
que motivou a troca -- `plural` prefixava a contagem numa frase que ja comeca em
maiuscula, e saia `content="5 As decisoes que o STJ divulgou..."`.

O que sobrou e ESTOQUE publicado antes da correcao. Regerar o shard inteiro nao
serve: medido em 2026-08-30, o gerador monta 31 paginas e o shard tem 32, entao
uma pagina PUBLICADA sairia -- e o contrato e explicito em que gerador nao apaga
pagina publicada, porque URL que existe tem de ter conteudo.

Por isso a correcao e datada e pontual: um campo, de um registro, com escrita
atomica, e recusando-se a rodar se encontrar qualquer outra diferenca.

    tools/generate-noticia-meta-contagem-20260830 --seco
    tools/generate-noticia-meta-contagem-20260830
"""
import argparse
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SHARD = os.path.join(RAIZ, "data/editorial/v2_pages/noticias-oficiais-01.jsonl")

# A contagem colada: digitos seguidos de espaco, antes de "A decisao"/"As decisoes".
# Ancorado no INICIO e exigindo a frase conhecida -- assim o padrao nao alcanca
# meta legitima que por acaso comece com numero.
CONTAGEM_COLADA = re.compile(r"^\d+\s+(?=(?:As decisões|A decisão)\b)")


def corrige(caminho, seco):
    linhas = []
    corrigidos = []
    with open(caminho, encoding="utf-8") as arquivo:
        for numero, linha in enumerate(arquivo, 1):
            crua = linha.rstrip("\n")
            if not crua.strip():
                linhas.append(crua)
                continue
            registro = json.loads(crua)
            meta = registro.get("meta_description") or ""
            novo = CONTAGEM_COLADA.sub("", meta, count=1)
            if novo != meta:
                registro["meta_description"] = novo
                corrigidos.append((numero, registro.get("unique_intent_id") or registro.get("intent_id"), meta, novo))
                crua = json.dumps(registro, ensure_ascii=False)
            linhas.append(crua)
    return linhas, corrigidos


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--seco", action="store_true", help="mostra sem gravar")
    opcoes = parser.parse_args()

    linhas, corrigidos = corrige(SHARD, opcoes.seco)
    if not corrigidos:
        print("nenhuma meta com contagem colada; nada a fazer")
        return 0

    for numero, intent, antes, depois in corrigidos:
        print(f"linha {numero}  {intent}")
        print(f"  antes : {antes[:110]}")
        print(f"  depois: {depois[:110]}")

    if opcoes.seco:
        print("--seco: nada gravado.")
        return 0

    temporario = SHARD + ".tmp-meta-contagem"
    with open(temporario, "w", encoding="utf-8") as saida:
        for linha in linhas:
            saida.write(linha + "\n")
    # Escrita atomica: o shard nunca fica pela metade se o processo morrer aqui.
    os.replace(temporario, SHARD)
    print(f"gravado: {len(corrigidos)} registro(s) corrigido(s) em {os.path.relpath(SHARD, RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
