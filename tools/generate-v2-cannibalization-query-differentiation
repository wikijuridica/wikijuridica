# residuo declarado, nao como defeito silencioso.

FIELD = "long_tail_query"


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def by_file() -> dict[str, dict[str, tuple[str, str, str]]]:
    grouped: dict[str, dict[str, tuple[str, str, str]]] = {}
    for intent, (rel, old, new, anchor) in DIFFERENTIATIONS.items():
        grouped.setdefault(rel, {})[intent] = (old, new, anchor)
    return grouped


def apply_file(rel: str, wanted: dict[str, tuple[str, str, str]]) -> tuple[int, int]:
    path = ROOT / rel
    payload = path.read_bytes()
    lines = payload.decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    changed = 0
    already = 0
    seen: set[str] = set()
    output: list[str] = []
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{rel}: linha em branco {number}")
        record = json.loads(raw)
        intent = record.get("intent_id")
        if intent not in wanted:
            output.append(raw)
            continue
        if intent in seen:
            raise SystemExit(f"{rel}: intent_id duplicado no portfolio: {intent}")
        seen.add(intent)
        old, new, _anchor = wanted[intent]
        current = record.get(FIELD)
        if current == new:
            already += 1
            output.append(raw)
            continue
        if current != old:
            raise SystemExit(
                f"CAS de campo falhou {rel}:{number} intent={intent} "
                f"{FIELD} esperado={old!r} atual={current!r}"
            )
        record[FIELD] = new
        output.append(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
        changed += 1

    missing = sorted(set(wanted) - seen)
    if missing:
        raise SystemExit(f"{rel}: intents nao encontrados no portfolio: {missing}")
    if changed == 0:
        return 0, already

    rewritten = "\n".join(output)
    if trailing_newline:
        rewritten += "\n"
    encoded = rewritten.encode("utf-8")
    if path.read_bytes() != payload:
        raise SystemExit(f"{rel}: mudou durante a transacao - abortado")
    atomic_write(path, encoded)
    return changed, already


def main() -> int:
    total_changed = 0
    total_already = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for rel, wanted in sorted(by_file().items()):
                    changed, already = apply_file(rel, wanted)
                    total_changed += changed
                    total_already += already
                    print(f"portfolio={rel} diferenciadas={changed} ja_aplicadas={already}")
    except StockEpochBusy as error:
        print(f"cannibalization-query-differentiation: canonical stock busy: {error}", file=sys.stderr)
        return 75
    print(f"total diferenciadas={total_changed} ja_aplicadas={total_already} "
          f"alvo={len(DIFFERENTIATIONS)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
