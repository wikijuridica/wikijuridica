#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"

parallel_codex_operational_preflight() {
	python3 - <<'PY'
from __future__ import annotations

import datetime as _dt
import json
import os
import re
import sys
from pathlib import Path

LEDGER = Path(".agents/runtime/command-ledger.jsonl")
SHA256_RE = re.compile(r"^sha256:[0-9a-f]{64}$")
GENERATE_CMD_PREFIX = "cmd/" + "generate-"
DIRECT_GENERATE_RE = re.compile(r"(?:^|\s)(?:go|go-modern)\s+run\s+(?:\./)?" + re.escape(GENERATE_CMD_PREFIX))
SHARED_PREFIXES = ("data/", "content/", "public/", ".agents/", ".release-staging/")
CURRENT_HEAD_REFRESH_ARTIFACTS = {
    ".agents/contracts/p0-work-reuse-command-ledger.md",
}
ABSENT_THROUGHPUT = (
    "absent",
    "ausente",
    "unavailable",
    "indisponivel",
    "unknown",
    "desconhecido",
    "missing",
    "sem throughput",
    "initializing_before_first_timing_sample",
    "initializing before first timing sample",
)
MATERIAL_ACTION = (
    "patch",
    "profile",
    "pprof",
    "probe",
    "cache",
    "shard",
    "indice",
    "index",
    "paralel",
    "incremental",
    "timings",
    "medir",
    "medido",
    "materializ",
    "adapter",
)
PASSIVE_ACTION = (
    "continuar aguardando",
    "aguardar ate terminar",
    "wait until done",
    "sleep",
)


def parse_now() -> _dt.datetime:
    raw = os.environ.get("WIKI_PARALLEL_CODEX_PREFLIGHT_NOW", "").strip()
    if not raw:
        return _dt.datetime.now(_dt.timezone.utc)
    raw = raw.replace("Z", "+00:00")
    return _dt.datetime.fromisoformat(raw).astimezone(_dt.timezone.utc)


def parse_time(raw: str) -> _dt.datetime | None:
    raw = str(raw or "").strip()
    if not raw:
        return None
    try:
        return _dt.datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone(_dt.timezone.utc)
    except ValueError:
        return None


def normalized_status(record: dict) -> str:
    status = str(record.get("status") or "").strip()
    return "running" if status == "in_progress" else status


def placeholder(value: object) -> bool:
    text = str(value or "").strip().lower()
    if not text:
        return True
    return any(marker in text for marker in ("placeholder", "later", "todo", "maybe", "n/a", "same as code", "if needed", "missing", "unknown"))


def concrete_path(path: object) -> bool:
    text = str(path or "").strip()
    return bool(text) and not any(sep in text for sep in ",;\r\n")


def repo_relative(path: object) -> str:
    text = str(path or "").strip()
    if not text:
        return ""
    p = Path(text)
    if p.is_absolute():
        try:
            return p.resolve().relative_to(Path.cwd().resolve()).as_posix()
        except ValueError:
            return text
    normalized = os.path.normpath(text.replace("\\", "/")).replace("\\", "/")
    return "" if normalized == "." else normalized


def shared_path(path: object) -> bool:
    rel = repo_relative(path)
    return concrete_path(rel) and rel.startswith(SHARED_PREFIXES)


def direct_generate(command: object) -> bool:
    text = str(command or "")
    return bool(DIRECT_GENERATE_RE.search(text))


def current_head_refresh(record: dict) -> bool:
    if str(record.get("command_kind") or "").strip() != "ledger_current_head_refresh":
        return False
    command = str(record.get("command") or "")
    normalized = command.lower()
    material_command_prefixes = (
        "run-heavy" + "-throttled ",
        "./tools/run-heavy" + "-throttled ",
        "tools/run-heavy" + "-throttled ",
        "run-go-cmd-cached ",
        "./tools/run-go-cmd-cached ",
        "tools/run-go-cmd-cached ",
        "./" + GENERATE_CMD_PREFIX,
    )
    if direct_generate(command) or any(normalized.startswith(prefix) for prefix in material_command_prefixes):
        return False
    artifact_paths = [
        repo_relative(item.get("path"))
        for item in record.get("artifacts") or []
        if isinstance(item, dict)
    ]
    if any(path and path not in CURRENT_HEAD_REFRESH_ARTIFACTS for path in artifact_paths):
        return False
    allowed_markers = (
        "append-work-reuse-ledger-current-head",
        "work reuse ledger current head",
        "append current-head",
        "running-command-current-head-context",
        "git commit -m",
    )
    return (
        ("repair-work-reuse-ledger-fingerprints" in normalized and "--append-current-head" in normalized)
        or any(marker in normalized for marker in allowed_markers)
    )


def artifact_claim_complete(claim: dict) -> bool:
    return (
        concrete_path(claim.get("path"))
        and not placeholder(claim.get("producer"))
        and bool(SHA256_RE.match(str(claim.get("input_fingerprint") or "")))
        and bool(SHA256_RE.match(str(claim.get("output_fingerprint_esperado") or "")))
        and not placeholder(claim.get("lock_scope"))
        and int(claim.get("budget_ms") or 0) > 0
        and not placeholder(claim.get("stop_condition"))
    )


def analysis_missing_fields(analysis: dict) -> list[str]:
    missing: list[str] = []
    if int(analysis.get("pid") or 0) <= 0:
        missing.append("pid")
    if placeholder(analysis.get("comando")):
        missing.append("comando")
    if placeholder(analysis.get("artefato")):
        missing.append("artefato")
    if placeholder(analysis.get("lock_scope")):
        missing.append("lock_scope")
    if int(analysis.get("elapsed_ms") or 0) <= 0:
        missing.append("elapsed_ms")
    if "cpu_percent" not in analysis:
        missing.append("cpu_percent")
    if placeholder(analysis.get("throughput")):
        missing.append("throughput")
    if placeholder(analysis.get("hipotese_de_gargalo")):
        missing.append("hipotese_de_gargalo")
    if placeholder(analysis.get("proxima_acao")):
        missing.append("proxima_acao")
    return missing


def absent_throughput(value: object) -> bool:
    text = str(value or "").strip().lower()
    return any(marker in text for marker in ABSENT_THROUGHPUT)


def absent_throughput_has_action(record: dict, analysis: dict) -> bool:
    text = " ".join(
        str(part or "").lower()
        for part in (
            analysis.get("hipotese_de_gargalo"),
            analysis.get("proxima_acao"),
            record.get("hypothesis"),
            record.get("stop_condition"),
            record.get("reuse_decision"),
            record.get("rerun_reason"),
        )
    )
    return any(marker in text for marker in MATERIAL_ACTION) and not any(marker in text for marker in PASSIVE_ACTION)


def iter_recent_records() -> list[tuple[int, dict]]:
    if not LEDGER.exists():
        return []
    default_tail_bytes = 64 * 1024 * 1024
    min_tail_bytes = 1024 * 1024
    try:
        tail_bytes = int(os.environ.get("WIKI_PARALLEL_CODEX_PREFLIGHT_TAIL_BYTES", str(default_tail_bytes)))
    except ValueError:
        tail_bytes = default_tail_bytes
    tail_bytes = max(min_tail_bytes, tail_bytes)
    records: list[tuple[int, dict]] = []
    with LEDGER.open("rb") as fh:
        fh.seek(0, os.SEEK_END)
        size = fh.tell()
        start = max(0, size - tail_bytes)
        fh.seek(start)
        if start > 0:
            fh.readline()
        line_no = 0
        for raw in fh:
            line_no += 1
            raw = raw.strip()
            if not raw:
                continue
            try:
                decoded = json.loads(raw.decode("utf-8", "replace"))
            except json.JSONDecodeError:
                continue
            if isinstance(decoded, dict):
                records.append((line_no, decoded))
    return records


def main() -> int:
    now = parse_now()
    issues: list[str] = []
    for line_no, record in iter_recent_records():
        command_id = str(record.get("command_id") or f"tail_line_{line_no}")
        command = str(record.get("command") or "")
        status = normalized_status(record)
        claim = record.get("artifact_claim") if isinstance(record.get("artifact_claim"), dict) else {}
        analysis = record.get("analise_comando_ativo") if isinstance(record.get("analise_comando_ativo"), dict) else {}
        if direct_generate(command):
            issues.append(f"work_reuse_direct_generate_command_without_artifact_claim: command_id={command_id}")
        if status == "running":
            lease = parse_time(str(record.get("lease_expires_at") or ""))
            if lease is not None and lease <= now:
                continue
            if not artifact_claim_complete(claim):
                issues.append(f"work_reuse_artifact_claim_missing: command_id={command_id}")
            missing = analysis_missing_fields(analysis)
            if missing:
                issues.append(f"work_reuse_active_command_analysis_missing: command_id={command_id} missing={','.join(missing)}")
            elif absent_throughput(analysis.get("throughput")) and not absent_throughput_has_action(record, analysis):
                issues.append(f"work_reuse_active_command_throughput_absent_requires_root_cause_action: command_id={command_id}")
            if claim.get("path") and analysis.get("artefato") and str(claim.get("path")).strip() != str(analysis.get("artefato")).strip():
                issues.append(f"work_reuse_active_command_analysis_artifact_mismatch: command_id={command_id}")
            if claim.get("lock_scope") and analysis.get("lock_scope") and str(claim.get("lock_scope")).strip() != str(analysis.get("lock_scope")).strip():
                issues.append(f"work_reuse_active_command_analysis_lock_scope_mismatch: command_id={command_id}")
        if status in {"completed", "reused", "failed"}:
            artifact_paths = [item.get("path") for item in record.get("artifacts") or [] if isinstance(item, dict)]
            if (
                not current_head_refresh(record)
                and any(shared_path(path) for path in artifact_paths)
                and not concrete_path(claim.get("path"))
            ):
                issues.append(f"work_reuse_artifact_claim_missing: command_id={command_id} missing=path")
            if shared_path(claim.get("path")) and not (Path.cwd() / repo_relative(claim.get("path"))).exists():
                issues.append(f"work_reuse_artifact_claim_path_missing: command_id={command_id} path={claim.get('path')}")
    if issues:
        for issue in issues:
            print(f"parallel-codex-operational-contract preflight: {issue}", file=sys.stderr)
        return 1
    return 0


raise SystemExit(main())
PY
}

parallel_codex_operational_preflight
exec "$ROOT/tools/run-check" parallel-codex-operational-contract --timings "$@"
