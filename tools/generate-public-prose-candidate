#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-public-prose-candidate [flags]

Runs cmd/generate-public-prose-candidate through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:public-prose-candidate:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-90000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=55}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/editorial/public_prose_candidate.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-public-prose-candidate}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/editorial/public_prose_candidate.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-900}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-public-prose-candidate --timings "$@"
