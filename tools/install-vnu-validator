#!/bin/sh
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
VERSION="26.6.24"
JAR_DIR="$ROOT/.cache/vnu/$VERSION"
JAR="$JAR_DIR/vnu.jar"
URL="${VNU_VALIDATOR_URL:-https://github.com/validator/validator/releases/download/latest/vnu.jar}"

# AO SAIR PARA A REDE, O PORTAL E O WikijuridicaBot (CLAUDE.md secao 11, ordem do
# dono de 2026-09-05). Ate 2026-09-10 este download saia como `curl/8.x` ou
# `Wget/1.x` para github.com — anonimo para quem serve o artefato e para o nosso
# proprio registro de o que baixamos de onde. O proposito e' proprio: aqui nao se
# coleta fonte juridica nem se pede rastreio, e sim se INSTALA uma ferramenta de
# validacao. A forma e' a que `internal/wikijuridicabot.UserAgentComProposito`
# produziria.
UA_SAIDA="Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/; instalacao-de-ferramenta)"

need() {
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "missing required command: $1" >&2
		exit 1
	fi
}

jar_version() {
	java -jar "$1" --version 2>/dev/null | tr -d '\r'
}

validate_jar() {
	test -s "$1" || return 1
	version_output="$(jar_version "$1")" || return 1
	case "$version_output" in
	"$VERSION" | "${VERSION} "*)
		return 0
		;;
	esac
	echo "unexpected v.Nu version in $1: $version_output (expected $VERSION)" >&2
	return 1
}

need java

if validate_jar "$JAR"; then
	echo "v.Nu $VERSION already installed at $JAR"
	exit 0
fi

if command -v curl >/dev/null 2>&1; then
	fetch() {
		curl -fL --retry 3 --connect-timeout 20 -A "$UA_SAIDA" --output "$1" "$URL"
	}
elif command -v wget >/dev/null 2>&1; then
	fetch() {
		wget --user-agent="$UA_SAIDA" -O "$1" "$URL"
	}
else
	echo "missing required command: curl or wget" >&2
	exit 1
fi

mkdir -p "$JAR_DIR"
tmp="$(mktemp "$JAR_DIR/vnu.jar.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

echo "downloading v.Nu $VERSION from $URL"
fetch "$tmp"
validate_jar "$tmp"
chmod 0644 "$tmp"
mv "$tmp" "$JAR"
trap - EXIT HUP INT TERM

echo "installed v.Nu $VERSION at $JAR"
