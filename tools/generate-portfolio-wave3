#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"

# O wrapper operacional reivindica artefatos do repositório real. Fixtures e
# roots alternativos devem chamar o pacote/command diretamente; aceitá-los
# aqui produziria um artifact_claim falso. --timings também é reservado para
# que o chamador não possa desativar a telemetria obrigatória do supervisor.
expect_root_value=0
for arg in "$@"; do
	if [[ "$expect_root_value" == "1" ]]; then
		requested_root="$(CDPATH='' cd -- "$arg" 2>/dev/null && pwd -P)" || {
			echo "generate-portfolio-wave3: --root must resolve to the repository root when invoked through tools/" >&2
			exit 2
		}
		if [[ "$requested_root" != "$ROOT" ]]; then
			echo "generate-portfolio-wave3: alternate --root is only supported by ./cmd/generate-portfolio-wave3 or the Go API" >&2
			exit 2
		fi
		expect_root_value=0
		continue
	fi
	case "$arg" in
	-root | --root)
		expect_root_value=1
		;;
	-root=* | --root=*)
		root_value="${arg#*=}"
		requested_root="$(CDPATH='' cd -- "$root_value" 2>/dev/null && pwd -P)" || {
			echo "generate-portfolio-wave3: --root must resolve to the repository root when invoked through tools/" >&2
			exit 2
		}
		if [[ "$requested_root" != "$ROOT" ]]; then
			echo "generate-portfolio-wave3: alternate --root is only supported by ./cmd/generate-portfolio-wave3 or the Go API" >&2
			exit 2
		fi
		;;
	-timings | --timings | -timings=* | --timings=*)
		echo "generate-portfolio-wave3: --timings is managed by the tools wrapper" >&2
		exit 2
		;;
	esac
done
if [[ "$expect_root_value" == "1" ]]; then
	echo "generate-portfolio-wave3: --root requires a value" >&2
	exit 2
fi

# Identidade, escopo e artefato do claim pertencem ao wrapper. Permitir que o
# ambiente os sobrescreva deixaria a mesma escrita escapar do lock/claim real.
export WIKI_HEAVY_LOCK_SCOPE="generate:portfolio-wave3:portfolio-and-workflow"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-5000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=1000}"
export WIKI_HEAVY_STOP_CONDITION="transaction_committed_reused_or_failed_without_partial_state"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="data/editorial/portfolio_v2"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="tools/generate-portfolio-wave3"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="transactionally_updated_or_stable:portfolio_v2+writing-mass-full"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"
exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-portfolio-wave3 --timings "$@"
