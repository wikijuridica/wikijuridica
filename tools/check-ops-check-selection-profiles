#!/usr/bin/env bash
ROOT="$(
	unset CDPATH
	cd -- "$(dirname -- "$0")/.." && pwd
)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$(dirname "$0")/.."
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
if [[ "${OPS_CHECK_SELFTEST:-0}" == "1" ]]; then
	"$ROOT/tools/go-modern" test -count=1 ./internal/checkselection ./internal/contract/checkmeta -run TestOpsCheckSelection
fi
exec "$ROOT/tools/run-check" ops-check-selection-profiles "$@"
