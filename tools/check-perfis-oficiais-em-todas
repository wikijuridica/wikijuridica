#!/usr/bin/env bash
# check-perfis-oficiais-em-todas — os perfis declarados aparecem em TODA página
# indexável, ou em nenhuma?
#
# READ-ONLY. Não escreve nada.
#
# POR QUE ELE EXISTE, com a medição de 2026-09-09. content/site.json declara
# três perfis oficiais — o LinkedIn do responsável técnico (`same_as`) e o
# Instagram e o Facebook da marca (`organization_same_as`). Eles saíam em DUAS
# páginas de 10.371:
#
#   grep -rl "linkedin.com" public/ --include=index.html | wc -l   ->  2
#   grep -rl '"sameAs"'    public/ --include=index.html | wc -l    ->  1
#
# E o portal tinha DEZ gates com "redesocial" no nome, todos verdes. Nenhum
# deles media isto: `check-redesocial-completude` reprova entrega declarada sem
# prova no disco, `check-redesocial-entrega-final` reprova entrega pendente, e o
# registro que os dois leem (content/redesocial_entregas.json, 164 entregas)
# descreve o plano de PUBLICAR posts em rede social — não a presença dos perfis
# nas páginas do portal. Verde verdadeiro sobre outra coisa: é o padrão que este
# repositório já catalogou como "detector que conta em vez de comparar
# conjunto".
#
# O QUE ELE MEDE: cobertura, que é a única pergunta que faltava. Para cada perfil
# declarado em content/site.json, quantas das páginas indexáveis de public/ o
# trazem — no HTML visível e no JSON-LD (`sameAs`).
#
# EXIT: 0 cobertura total (ou nenhum perfil declarado); 1 cobertura parcial.
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

python3 - "$ROOT" <<'PY'
import json
import os
import sys

raiz = sys.argv[1]

with open(os.path.join(raiz, "content", "site.json"), encoding="utf-8") as fh:
    identidade = json.load(fh).get("editorial_identity", {})

perfis = list(identidade.get("same_as", [])) + list(identidade.get("organization_same_as", []))
perfis = [p.strip() for p in perfis if p.strip()]
if not perfis:
    # Sem perfil declarado não há cobertura a exigir — e emitir bloco vazio
    # seria placeholder, que o contrato proíbe.
    print("check-perfis-oficiais-em-todas: nenhum perfil declarado em content/site.json — nada a exigir")
    raise SystemExit(0)

publico = os.path.join(raiz, "public")
paginas = []
for pasta, _, arquivos in os.walk(publico):
    if "index.html" in arquivos:
        paginas.append(os.path.join(pasta, "index.html"))
paginas.sort()

if not paginas:
    print("check-perfis-oficiais-em-todas: public/ sem página — rode a publicação antes", file=sys.stderr)
    raise SystemExit(1)

# Página não indexável não declara autoria nem perfil, por desenho: o rodapé
# dela traz estado editorial em vez de assinatura. Contá-la como falta seria
# medir o que o render nunca emite.
def indexavel(html: str) -> bool:
    return 'name="robots" content="noindex' not in html

faltando = {perfil: [] for perfil in perfis}
sem_samesas = []
avaliadas = 0

for caminho in paginas:
    with open(caminho, encoding="utf-8", errors="replace") as fh:
        html = fh.read()
    if not indexavel(html):
        continue
    avaliadas += 1
    rota = "/" + os.path.relpath(os.path.dirname(caminho), publico).replace(os.sep, "/").strip("/") + "/"
    for perfil in perfis:
        if perfil not in html:
            faltando[perfil].append(rota)
    if '"sameAs"' not in html:
        sem_samesas.append(rota)

problemas = False
print(f"check-perfis-oficiais-em-todas: {avaliadas} página(s) indexável(is) avaliada(s)")
for perfil in perfis:
    ausentes = faltando[perfil]
    cobertura = avaliadas - len(ausentes)
    print(f"  {perfil}: {cobertura}/{avaliadas}")
    if ausentes:
        problemas = True
        for rota in ausentes[:5]:
            print(f"      falta em {rota}")
        if len(ausentes) > 5:
            print(f"      … e mais {len(ausentes) - 5} rota(s)")

print(f"  JSON-LD com sameAs: {avaliadas - len(sem_samesas)}/{avaliadas}")
if sem_samesas:
    problemas = True
    for rota in sem_samesas[:5]:
        print(f"      sem sameAs em {rota}")
    if len(sem_samesas) > 5:
        print(f"      … e mais {len(sem_samesas) - 5} rota(s)")

if problemas:
    print("check-perfis-oficiais-em-todas: FAIL — perfil declarado que não aparece na página é")
    print("  vínculo de identidade que o buscador não enxerga. Republique com --ressemear.")
    raise SystemExit(1)

print("check-perfis-oficiais-em-todas: pass — todo perfil declarado aparece em toda página indexável")
PY
