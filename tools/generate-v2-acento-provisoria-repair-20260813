#!/usr/bin/env python3
"""generate-v2-acento-provisoria-repair-20260813 — devolve o acento que barrava uma página inteira.

O DEFEITO. `/imobiliario/imob-acao-revisional-aluguel/` (701 palavras, 6 seções,
escrita e pronta) está FORA do ar por uma letra: a frase

    "A decisão provisoria produz efeitos a partir da citação conforme o rito legal."

grafa "provisoria" sem acento. `tools/generate-v2-publication-severity` classifica
acento perdido como defeito de ENCODING, e encoding é a única classe da lista de
críticos do dono (CLAUDE.md, política de 2026-08-06) que essa página viola — as
outras 700 palavras passam. Uma página jurídica útil, já paga, não vai ao ar por
causa de um "ó".

O erro é isolado e o próprio texto prova: o heading da MESMA seção escreve
"aluguel provisório" corretamente, e "provisoria" como palavra isolada aparece
UMA vez no registro inteiro. (O advérbio "provisoriamente", que aparece adiante,
está certo e não é tocado: em português ele perde o acento, e o detector usa
`\\bprovisoria\\b`, que não casa dentro de "provisoriamente" — conferido antes de
escrever este reparo, para não "corrigir" o que está certo.)

POR QUE UM GERADOR, E NÃO UM EDITOR DE TEXTO. Editar JSONL do estoque na mão é
proibido (CLAUDE.md). A correção pontual de trecho tem caminho sancionado desde
`generate-v2-citation-attribution-repair-20260807`, e este arquivo replica o
mesmo contrato de escrita: lease de época, lock exclusivo próprio, CAS pelo
sha256 da LINHA viva, CAS por TRECHO (exatamente uma ocorrência), demais linhas
preservadas byte a byte, word_count recalculado pela fórmula do ingest, forma de
serialização da linha preservada, escrita atômica com fsync, idempotente. NÃO
commita e NÃO republica.

O texto anterior é preservado em `.agents/runtime/backup-paginas-<data>-acento/`
antes de qualquer escrita — página redigida nunca se perde.

A CORREÇÃO NÃO MEXE NO word_count, e isso é verificável: a fórmula do ingest
normaliza por NFKD e descarta os diacríticos antes de contar, então "provisoria"
e "provisória" contam igual. O recálculo continua sendo feito e conferido, porque
declarar sem recalcular derruba a página no ingest.

Uso:
    tools/generate-v2-acento-provisoria-repair-20260813 --dry-run
    tools/generate-v2-acento-provisoria-repair-20260813
"""
from __future__ import annotations

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import unicodedata
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.acento-provisoria-repair-20260813.lock"
SHARD_REL = "data/editorial/v2_pages/imobiliario-02.jsonl"
BACKUP = ROOT / ".agents/runtime/backup-paginas-20260813-acento"

# A correção vive AQUI e não num .data.json ao lado: é UM trecho de UMA página, e
# um segundo arquivo para carregar uma linha esconderia o conteúdo do reparo de
# quem lê o reparo. Os geradores com dezenas de correções separam por volume.
CORRECOES = [
    {
        "intent_id": "imob-acao-revisional-aluguel",
        "campo": "sections[2].text",
        "old": "A decisão provisoria produz efeitos a partir da citação conforme o rito legal.",
        "new": "A decisão provisória produz efeitos a partir da citação conforme o rito legal.",
        "porque": (
            "'provisoria' sem acento é erro de digitação, não variante: o heading da "
            "mesma seção grafa 'aluguel provisório' corretamente. O detector de "
            "acento perdido de generate-v2-publication-severity marca a página como "
            "defeito CRÍTICO de encoding, e é o único motivo que a mantém fora do ar."
        ),
    },
]

# Nenhum texto novo pode prometer resultado (Provimento OAB 205/2021) nem afirmar
# mais do que a fonte sustenta. A correção aqui é ortográfica, mas o guarda fica:
# gerador de reparo que não checa o que escreve é o caminho por onde promessa
# entra no acervo.
TEXTOS_PROIBIDOS = (
    "jurisprudência pacífica", "entendimento pacificado", "com certeza",
    "sempre ganha", "garantimos", "asseguramos o êxito", "êxito garantido",
    "certeza de ganho", "resultado garantido",
)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(handle)
        raise SystemExit(f"outro processo detém {path}; nada foi escrito")
    try:
        yield
    finally:
        fcntl.flock(handle, fcntl.LOCK_UN)
        os.close(handle)


def atomic_write(path: Path, payload: bytes) -> None:
    handle, tmp = tempfile.mkstemp(dir=os.fspath(path.parent), prefix=".tmp-repair-")
    try:
        with os.fdopen(handle, "wb") as saida:
            saida.write(payload)
            saida.flush()
            os.fsync(saida.fileno())
        os.replace(tmp, path)
        dir_fd = os.open(os.fspath(path.parent), os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def dump_como_a_linha(record: dict, linha_viva: str) -> str:
    """Reemite na MESMA forma de serialização da linha viva."""
    original = json.loads(linha_viva)
    for separadores in ((", ", ": "), (",", ":")):
        if json.dumps(original, ensure_ascii=False, separators=separadores) == linha_viva:
            return json.dumps(record, ensure_ascii=False, separators=separadores)
    print(f"  aviso: forma de serialização não reconhecida em {record.get('intent_id')};"
          " reemitindo na forma padrão", file=sys.stderr)
    return json.dumps(record, ensure_ascii=False)


def _campos(record: dict):
    """(getter, setter) de cada campo textual do registro."""
    yield (lambda: record.get("opening") or "",
           lambda v: record.__setitem__("opening", v))
    for section in record.get("sections") or []:
        yield (lambda s=section: s.get("heading") or "",
               lambda v, s=section: s.__setitem__("heading", v))
        yield (lambda s=section: s.get("text") or "",
               lambda v, s=section: s.__setitem__("text", v))
    for item in record.get("faq") or []:
        for chave in ("q", "a"):
            yield (lambda i=item, k=chave: i.get(k) or "",
                   lambda v, i=item, k=chave: i.__setitem__(k, v))


def _contar(record: dict, trecho: str) -> int:
    return sum(ler().count(trecho) for ler, _ in _campos(record))


def _substituir(record: dict, antes: str, depois: str) -> None:
    for ler, gravar in _campos(record):
        atual = ler()
        if antes in atual:
            gravar(atual.replace(antes, depois, 1))
            return


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    for correcao in CORRECOES:
        baixo = correcao["new"].lower()
        for proibido in TEXTOS_PROIBIDOS:
            if proibido in baixo:
                raise SystemExit(f"texto novo contém expressão proibida: {proibido!r}")

    path = ROOT / SHARD_REL
    if not path.is_file():
        raise SystemExit(f"shard ausente: {SHARD_REL}")

    try:
        with canonical_stock_write_lease(ROOT), exclusive_lock(LOCK):
            bruto = path.read_bytes().decode("utf-8")
            linhas = bruto.split("\n")
            termina_com_newline = bool(linhas) and linhas[-1] == ""
            if termina_com_newline:
                linhas = linhas[:-1]

            por_intent = {c["intent_id"]: c for c in CORRECOES}
            saida: list[str] = []
            aplicadas = 0
            ja_feitas = 0
            backup_feito = False

            for numero, raw in enumerate(linhas, 1):
                if not raw.strip():
                    raise SystemExit(f"{SHARD_REL}: linha em branco {numero}")
                registro = json.loads(raw)
                intent = registro.get("intent_id")
                correcao = por_intent.get(intent)
                if correcao is None:
                    saida.append(raw)
                    continue

                antes, depois = correcao["old"], correcao["new"]
                # IDEMPOTÊNCIA antes de CAS: rodar duas vezes não pode falhar.
                if _contar(registro, depois) >= 1 and _contar(registro, antes) == 0:
                    ja_feitas += 1
                    saida.append(raw)
                    continue

                ocorrencias = _contar(registro, antes)
                if ocorrencias != 1:
                    raise SystemExit(
                        f"CAS DE TRECHO FALHOU em {SHARD_REL}:{numero} ({intent}): "
                        f"o trecho aparece {ocorrencias} vez(es), esperado exatamente 1. "
                        "O estoque mudou desde a medição; nada foi escrito.")

                if not backup_feito and not args.dry_run:
                    BACKUP.mkdir(parents=True, exist_ok=True)
                    carimbo = datetime.datetime.now().strftime("%H%M%S")
                    shutil.copy2(path, BACKUP / f"{path.name}.{carimbo}.antes")
                    backup_feito = True

                digest_antes = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
                _substituir(registro, antes, depois)
                if _contar(registro, antes) != 0:
                    raise SystemExit(f"substituição não removeu o trecho em {intent}")

                declarado = registro.get("word_count")
                recalculado = word_count(registro)
                registro["word_count"] = recalculado
                if declarado is not None and declarado != recalculado:
                    print(f"  word_count de {intent}: {declarado} -> {recalculado}")

                nova = dump_como_a_linha(registro, raw.strip())
                # CAS DA LINHA: a linha reemitida tem de diferir da viva, e diferir
                # SÓ pelo que o reparo mudou. Digest igual = nada mudou de fato.
                if hashlib.sha256(nova.encode("utf-8")).hexdigest() == digest_antes:
                    raise SystemExit(f"linha de {intent} não mudou; abortado")
                saida.append(nova)
                aplicadas += 1
                print(f"  {intent}: {correcao['campo']} corrigido")

            if aplicadas == 0:
                print(f"nada a fazer ({ja_feitas} correção(ões) já aplicada(s))")
                return 0

            payload = "\n".join(saida) + ("\n" if termina_com_newline else "")
            if args.dry_run:
                print(f"ENSAIO — {aplicadas} correção(ões) seriam aplicadas em {SHARD_REL}")
                return 0
            atomic_write(path, payload.encode("utf-8"))
            print(f"{aplicadas} correção(ões) aplicada(s) em {SHARD_REL}")
            print(f"texto anterior preservado em {BACKUP.relative_to(ROOT)}/")
            return 0
    except StockEpochBusy as erro:
        raise SystemExit(f"estoque canônico ocupado: {erro}")


if __name__ == "__main__":
    sys.exit(main())
