#!/usr/bin/env python3
"""generate-review-wave-args-from-payload — converte o payload consolidado de
fixes editoriais (data/ops/review_wave_payload_20260722.jsonl, linhas
{"intent_id","shard","fix_kind","instrucao","fonte_da_instrucao"}) no array de
args que scripts/workflows/writing-review.js espera: [{slug,n,area,defeitos,
alvos}]. Agrupa por shard; defeitos carrega as instruções por intent (o redator
do review lê e aplica); alvos lista os intent_ids do lote.

Papel generate-*: escreve APENAS o arquivo de args derivado (data/ops/), nunca
toca data/editorial/. A onda de review NÃO roda em paralelo com escrita — o
maestro dispara o workflow só com a fila de escrita seca.
"""
import argparse
import collections
import json
import pathlib
import sys


def area_of(shard: str) -> str:
    base = shard.rsplit("/", 1)[-1]
    if base.endswith(".jsonl"):
        base = base[: -len(".jsonl")]
    for marker in ("-r", "-d", "-p", "-inf", "-0", "-1", "-2", "-3"):
        idx = base.find(marker)
        if idx > 0 and idx + len(marker) < len(base) and base[idx + len(marker)].isdigit():
            return base[:idx]
    return base.rsplit("-", 1)[0] if "-" in base else base


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--payload", default="data/ops/review_wave_payload_20260722.jsonl")
    parser.add_argument(
        "--out", default="data/ops/review_wave_args_20260722.json")
    ns = parser.parse_args()

    payload_path = pathlib.Path(ns.payload)
    if not payload_path.is_file():
        print(f"payload ausente: {payload_path}", file=sys.stderr)
        return 2

    by_shard: dict[str, list[dict]] = collections.defaultdict(list)
    total = 0
    for lineno, raw in enumerate(payload_path.read_text(encoding="utf-8").splitlines(), 1):
        raw = raw.strip()
        if not raw:
            continue
        row = json.loads(raw)
        for key in ("intent_id", "shard", "fix_kind", "instrucao"):
            if not row.get(key):
                print(f"linha {lineno}: campo obrigatório ausente: {key}",
                      file=sys.stderr)
                return 2
        by_shard[row["shard"]].append(row)
        total += 1

    args_array = []
    for shard in sorted(by_shard):
        rows = by_shard[shard]
        slug = shard.rsplit("/", 1)[-1]
        if slug.endswith(".jsonl"):
            slug = slug[: -len(".jsonl")]
        defeitos = [
            {
                "intent_id": r["intent_id"],
                "classe": r["fix_kind"],
                "instrucao": r["instrucao"],
                "fonte": r.get("fonte_da_instrucao", ""),
            }
            for r in rows
        ]
        args_array.append({
            "slug": slug,
            "n": len(rows),
            "area": area_of(shard),
            "defeitos": defeitos,
            "alvos": [r["intent_id"] for r in rows],
        })

    out_path = pathlib.Path(ns.out)
    out_path.write_text(
        json.dumps(args_array, ensure_ascii=False, indent=1) + "\n",
        encoding="utf-8")
    print(
        f"review-wave-args: lotes={len(args_array)} fixes={total} out={out_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
