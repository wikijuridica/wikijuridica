#!/usr/bin/env python3
"""generate-legal-corpus-live-verification-20260812 — o status HTTP que faltava, observado de verdade.

O DEFEITO QUE ELE ATENDE. O ingest exige `http_status` em toda fonte oficial
(internal/v2ingest/validate.go:686 -> `officialSourceHTTPStatusAllowed`, que só
aceita 200, 203 ou 206). O corpus legal (`data/legal-corpus/*.json`) grava URL,
data de coleta, bytes e SHA-256 do documento, mas NÃO grava o código HTTP da
resposta. Quem monta fonte a partir do corpus escreve uma fonte sem esse campo,
e o ingest a rejeita com `official_source_http_status_invalid:status=0`.

Inferir 200 porque a coleta devolveu bytes seria gravar evidência não observada.
Este gerador OBSERVA: uma requisição por URL, com pausa entre elas, cabeçalhos
de navegador (o WAF do Planalto recusa requisição sem eles) e User-Agent que
identifica o projeto. Grava o código real, a data real, o SHA-256 do documento
de hoje e a comparação com o SHA-256 que o corpus indexou.

A COMPARAÇÃO IMPORTA. O `anchor_claim` de uma fonte montada a partir do corpus é
o texto do dispositivo lido na coleta anterior. Se o documento de hoje é
byte-a-byte o mesmo, o texto ancorado está provadamente intacto. Se mudou, o
artigo é reindexado do documento de hoje e comparado artigo a artigo: quem
consome esta evidência sabe exatamente quais dispositivos mudaram de redação e
deve pular esses, não "consertá-los" às cegas.

LICENÇA: texto de lei é domínio público (Lei 9.610/1998, art. 8º, IV). Esta
coleta é proveniência — conferência de disponibilidade e integridade —, nunca
corpo de página.

Uso:
    tools/generate-legal-corpus-live-verification-20260812 --dry-run
    tools/generate-legal-corpus-live-verification-20260812
    tools/generate-legal-corpus-live-verification-20260812 --apenas lei_8036_1990
"""
from __future__ import annotations

import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import sys
import time
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
CORPUS = os.path.join(ROOT, "data/legal-corpus")
SAIDA = os.path.join(ROOT, "data/source-audit/legal_corpus_live_verification_20260812.json")


def carregar_gerador_corpus():
    caminho = os.path.join(ROOT, "tools/generate-legal-corpus")
    spec = importlib.util.spec_from_loader(
        "glc", importlib.machinery.SourceFileLoader("glc", caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def cabecalhos_de_saida(glc):
    """Os cabeçalhos desta verificação, com a identidade vinda da fonte única.

    Quem DEFINE o User-Agent canônico deste caminho é `tools/generate-legal-corpus`
    (`NAVEGADOR`), medido em 2026-09-05 contra o WAF do Planalto: 200 e 3.531.201
    bytes com o prefixo `Mozilla/5.0 (compatible;`. Copiar o literal para cá
    criaria a segunda cópia da verdade — foi assim que `bot_registry` e
    `access_rules` passaram a discordar sobre GPTBot.

    A GUARDA NÃO É DECORAÇÃO. Se um dia aquele dicionário perder a chave
    `User-Agent`, o `urllib` manda `Python-urllib/3.x` e esta conferência sai
    anônima para o gov.br sem ninguém notar — a mesma falha que deixou
    `collect-bing-webmaster` anônimo por doze dias. Aqui ela para o programa.
    """
    cabecalhos = dict(glc.NAVEGADOR)
    identidade = cabecalhos.get("User-Agent", "")
    if "WikijuridicaBot" not in identidade:
        raise SystemExit(
            "tools/generate-legal-corpus perdeu o User-Agent canonico "
            "(NAVEGADOR['User-Agent'] = %r): esta verificacao sairia anonima "
            "para a fonte oficial, e o contrato (CLAUDE.md secao 11) proibe."
            % identidade)
    return cabecalhos


def observar(url, cabecalhos, timeout=45.0):
    """Devolve (status, bytes). Erro HTTP também é observação: o código é o dado."""
    pedido = urllib.request.Request(url, headers=cabecalhos)
    try:
        with urllib.request.urlopen(pedido, timeout=timeout) as resposta:
            bruto = resposta.read()
            if resposta.headers.get("Content-Encoding") == "gzip":
                import gzip
                bruto = gzip.decompress(bruto)
            return resposta.status, bruto
    except urllib.error.HTTPError as erro:
        return erro.code, erro.read()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--apenas", default="")
    parser.add_argument("--pausa", type=float, default=2.5,
                        help="segundos entre requisições ao mesmo host")
    args = parser.parse_args()

    glc = carregar_gerador_corpus()
    identidade = cabecalhos_de_saida(glc)
    diplomas = []
    for nome_arquivo in sorted(os.listdir(CORPUS)):
        if not nome_arquivo.endswith(".json"):
            continue
        with open(os.path.join(CORPUS, nome_arquivo), encoding="utf-8") as handle:
            dados = json.load(handle)
        if not dados.get("confiavel_para_acusar_divergencia"):
            continue
        if args.apenas and dados.get("slug") != args.apenas:
            continue
        diplomas.append(dados)

    print("=== CONFERÊNCIA VIVA DO CORPUS LEGAL ===")
    print("diplomas confiáveis a conferir: %d" % len(diplomas))
    if args.dry_run:
        for dados in diplomas:
            print("  %-16s %s" % (dados["slug"], dados["source_url"]))
        print("--dry-run: nenhuma requisição feita.")
        return 0

    hoje = datetime.date.today().isoformat()
    registros = {}
    for indice, dados in enumerate(diplomas):
        if indice:
            time.sleep(args.pausa)
        url = dados["source_url"]
        try:
            status, bruto = observar(url, identidade)
        except Exception as erro:  # rede/timeout: também é resultado, e não vira 200
            registros[dados["slug"]] = {
                "slug": dados["slug"], "url": url, "consultado_em": hoje,
                "http_status": 0, "erro": str(erro)[:120],
            }
            print("  %-16s FALHOU  %s" % (dados["slug"], str(erro)[:70]))
            continue

        sha_hoje = hashlib.sha256(bruto).hexdigest()
        identico = sha_hoje == dados.get("document_sha256")

        # A URL QUE A PÁGINA RECEBE NÃO É, NECESSARIAMENTE, A QUE FOI CONFERIDA.
        # Desde o corpus v2 o registro tem dois endereços: `source_url`/
        # `conference_url` é o texto consolidado de onde saem os `articles`, e
        # `citation_url` é o documento cujas âncoras resolvem no artigo (o Código
        # Civil compilado tem 5 âncoras; o simples, 4.030). Quem escreve fonte na
        # página grava a de CITAÇÃO — então é ela que precisa ter status
        # observado, senão o ingest recusa por `http_status_invalid`.
        url_citacao = dados.get("citation_url") or url
        status_citacao, sha_citacao = status, sha_hoje
        if url_citacao != url:
            time.sleep(args.pausa)
            try:
                status_citacao, bruto_citacao = observar(url_citacao, identidade)
                sha_citacao = hashlib.sha256(bruto_citacao).hexdigest()
            except Exception as erro:
                status_citacao, sha_citacao = 0, ""
                print("  %-16s citação FALHOU  %s" % (dados["slug"], str(erro)[:60]))

        registro = {
            "slug": dados["slug"],
            # `url` é a que vai para a página — é dela que o consumidor a jusante
            # exige status 200.
            "url": url_citacao,
            "conference_url": url,
            "citation_url": url_citacao,
            "conference_http_status": status,
            "citation_http_status": status_citacao,
            "citation_document_sha256_hoje": sha_citacao,
            "consultado_em": hoje,
            # Só é 200 quando as DUAS pontas respondem: o texto que autoriza a
            # afirmação e o link que o leitor recebe.
            "http_status": status if status != 200 else status_citacao,
            "document_sha256_hoje": sha_hoje,
            "document_sha256_no_corpus": dados.get("document_sha256"),
            "document_bytes_hoje": len(bruto),
            "documento_identico_ao_corpus": identico,
            "artigos_com_texto_alterado": [],
            "artigos_no_corpus": len(dados.get("articles") or {}),
        }
        if not identico and status == 200:
            artigos_hoje = glc.indexar_artigos(glc.texto_limpo(bruto))
            alterados = []
            for numero, texto in (dados.get("articles") or {}).items():
                atual = artigos_hoje.get(numero)
                if atual is None or " ".join(atual.split()) != " ".join(texto.split()):
                    alterados.append(numero)
            registro["artigos_com_texto_alterado"] = sorted(alterados)
            registro["artigos_reindexados_hoje"] = len(artigos_hoje)
        registros[dados["slug"]] = registro
        marca = "idêntico" if identico else ("%d artigos diferentes"
                                             % len(registro["artigos_com_texto_alterado"]))
        print("  %-16s HTTP %s  %s" % (dados["slug"], status, marca))

    payload = {
        "gerado_em": hoje,
        "criterio": ("Uma requisição GET por diploma confiável do corpus, com pausa de "
                     "%.1fs entre elas e os cabeçalhos de navegador que o WAF do Planalto "
                     "exige. Grava-se o código HTTP REAL da resposta — nunca inferido do "
                     "fato de a coleta anterior ter devolvido bytes — o SHA-256 do "
                     "documento de hoje e, quando ele difere do indexado, a lista dos "
                     "artigos cuja redação mudou." % args.pausa),
        "licenca": "dominio_publico_lei_9610_1998_art_8_IV",
        "uso": "proveniencia_e_conferencia_nunca_corpo_de_pagina",
        "diplomas": registros,
    }
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    with open(SAIDA, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=1, sort_keys=True)
        handle.write("\n")
    print("\ngravado %s" % os.path.relpath(SAIDA, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
