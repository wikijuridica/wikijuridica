#!/usr/bin/env python3
"""Corrige os dois subtitulos que terminam em "para" sem fechar a frase.

OS DEFEITOS, medidos em 2026-09-10 por `./tools/go-modern run ./cmd/check
public-html-shape` sobre os 11.288 HTML de public/.

1) `tra-ipva-divida-ativa-protestado-impede-transferencia`

    heading: "Por que a transferencia para"
    texto  : "O inciso VIII do art. 124 do CTB condiciona a emissao do novo
              certificado a demonstracao de que nada resta em aberto [...]"

   O subtitulo termina numa preposicao e a frase nao fecha. Fragmento truncado
   em texto visivel ao visitante e falha P0 pelo §8 do contrato, antes de ser
   questao de estilo: o leitor que passa os olhos nos subtitulos le meia
   oracao, e o crawler indexa o mesmo fragmento.

2) `dig-clone-anuncio-pesquisa-paga-google`

    heading: "Recuperar o valor e onde a responsabilidade do buscador para"

   Aqui "para" e o VERBO parar, e a frase esta gramaticalmente completa — o que
   nao a torna boa. Lida na velocidade em que se le um subtitulo, ela dispara a
   leitura preposicional ("do buscador para [quem?]") e so se resolve na
   releitura. O corpo diz exatamente o ponto: ha um limite ate onde a
   responsabilidade do buscador vai, e e isso que o subtitulo passa a dizer.

COMO FORAM ACHADOS. O eixo `heading_terminal_preposition` acusava 9 arquivos.
Lidos um a um, SETE sao falso positivo do detector — "cobranca recorrente que
nao para" e "o financiamento nao para" usam o verbo parar depois de negacao;
"o que ela nao da" e "os requisitos de IP ou DO" so viram preposicao depois do
dobramento de acento e de caixa (`da`, `do`). Essas tres causas foram
corrigidas no detector, em internal/publichtmlshape. Os dois casos abaixo sao
os que sobraram, e sao de redacao.

A CORRECAO nao inventa conteudo: cada novo subtitulo diz o que o proprio texto
da secao ja afirma — o Detran nao emite o certificado enquanto houver debito; a
responsabilidade do buscador tem um alcance definido. Nenhum numero, nenhuma
norma nova, nenhuma promessa.

Escrita atomica (temp no mesmo diretorio + fsync + rename) e idempotente: rodar
duas vezes nao muda nada na segunda.

Uso:
    tools/generate-v2-heading-transito-transferencia-20260910 --dry-run
    tools/generate-v2-heading-transito-transferencia-20260910
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
# (shard, intent_id, heading antigo, heading novo)
CORRECOES = (
    ("data/editorial/v2_pages/transito-w3-02.jsonl",
     "tra-ipva-divida-ativa-protestado-impede-transferencia",
     "Por que a transferência para",
     "Por que o Detran não emite o novo certificado"),
    ("data/editorial/v2_pages/digital-w3-02.jsonl",
     "dig-clone-anuncio-pesquisa-paga-google",
     "Recuperar o valor e onde a responsabilidade do buscador para",
     "Recuperar o valor e até onde vai a responsabilidade do buscador"),
)


def corrige(shard_rel, intent, antigo, novo, dry_run):
    shard = RAIZ / shard_rel
    if not shard.exists():
        print(f"shard ausente: {shard}", file=sys.stderr)
        return 2

    saida: list[str] = []
    trocados = 0
    encontrado = False
    for linha in shard.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") != intent:
            saida.append(json.dumps(registro, ensure_ascii=False))
            continue
        encontrado = True
        for secao in registro.get("sections", []):
            if secao.get("heading") == antigo:
                secao["heading"] = novo
                trocados += 1
        saida.append(json.dumps(registro, ensure_ascii=False))

    if not encontrado:
        print(f"intent {intent} nao esta em {shard.name}", file=sys.stderr)
        return 1
    if trocados == 0:
        print(f"{intent}: nada a fazer (idempotente)")
        return 0

    print(f"{intent}: subtitulo trocado em {trocados} secao(oes)")
    print(f"  de  : {antigo!r}")
    print(f"  para: {novo!r}")
    if dry_run:
        return 0

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=shard.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write("\n".join(saida) + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        caminho = temporario.name
    os.replace(caminho, shard)
    print(f"  gravado: {shard.relative_to(RAIZ)}")
    return 0


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    pior = 0
    for shard_rel, intent, antigo, novo in CORRECOES:
        codigo = corrige(shard_rel, intent, antigo, novo, argumentos.dry_run)
        pior = max(pior, codigo)
    if argumentos.dry_run:
        print("\n--dry-run: nada gravado")
    return pior


if __name__ == "__main__":
    sys.exit(main())
