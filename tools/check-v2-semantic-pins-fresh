#!/usr/bin/env python3
"""check-v2-semantic-pins-fresh — avisa ANTES que o commit morra no gate.

POR QUE EXISTE, com o custo medido: em 2026-08-12 um gerador datado corrigiu
4.028 referências de citação (`l8078compilado.htm#art14`, que não tem essa
âncora, virou `l8078.htm#art14`, que tem) em 475 shards de
`data/editorial/v2_pages/`. Três desses registros estavam PINADOS pelo contrato
semântico (`data/editorial/v2_writing_semantic_contract.json`), que fixa o
sha256 exato da linha da página. Os bytes mudaram, o SENTIDO não — e mesmo
assim o gate `check-v2-supersession-integrity` passou a recusar todo commit
com:

    semantic resolution does not authenticate exact unique page: gloss-dissolucao-parcial

O gerador não tinha como saber: ele conserta citação, não conhece o contrato.
Este check fecha essa distância. Ele responde a UMA pergunta barata — "a linha
viva de cada intent pinado ainda tem o hash que o contrato pinou?" — a um custo
de um sha256 por resolução (8 no acervo atual). Não compila nada, não valida o
contrato inteiro, não abre snapshot: é um alarme, não o gate.

QUANDO REPROVA, o remédio é nominal e vem impresso: se a mudança foi
NÃO-SEMÂNTICA (fonte oficial, tópico de link interno, word_count), rode

    tools/refresh-v2-semantic-pins --intent <INTENT> \\
        --refreshed-by <operador> --refreshed-at <YYYY-MM-DD> --refresh-stale-pins

que re-autentica o pino com quatro guardas (texto visível idêntico, allowlist
de campos, trilha de auditoria, preflight parcial). Se o TEXTO VISÍVEL mudou, o
refresh recusa — e recusa certo: página nova exige revisão nova, pelo fluxo de
recut (`tools/finalize-v2-semantic-recut`).

Cobre as TRÊS famílias que pinam bytes de página — `resolutions`,
`adopt_existing_targets` e `forward_candidates` —, porque o censo do mesmo dia
mostrou que a única causa (o gerador de citações) atingiu as três: 3 + 1 + 6 =
10 pinos desatualizados. Um check que olhasse só uma delas daria VERDE com o
gate vermelho. O que o check NÃO faz é decidir se a mudança foi semântica —
isso é do comando de refresh, que tem a preimagem para provar.

Uso:
    tools/check-v2-semantic-pins-fresh
    tools/check-v2-semantic-pins-fresh --json
"""
import argparse
import hashlib
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
CONTRATO = os.path.join(ROOT, "data", "editorial", "v2_writing_semantic_contract.json")

# (chave da lista no contrato, campo do pino, campo do caminho vivo)
#
# As TRES familias pinam o sha256 exato de uma linha viva e tem exatamente o
# mesmo modo de falha. Deixar qualquer uma de fora daria verde com o gate
# vermelho — o falso-negativo que este check existe para impedir. O censo de
# 2026-08-12 achou 10 pinos desatualizados de uma unica causa: 3 resolutions,
# 1 adopt_existing_target e 6 forward_candidates.
FAMILIAS = (
    ("resolutions", "page_record_sha256", "target_rel_path"),
    ("adopt_existing_targets", "target_page_record_sha256", "target_rel_path"),
    ("forward_candidates", "current_source_record_sha256", "current_source_rel_path"),
)


def linhas_por_intent(caminho):
    """Devolve {intent_id: [(sha256, ...)]} lendo o shard uma única vez."""
    indice = {}
    with open(caminho, "rb") as arquivo:
        for linha in arquivo.read().split(b"\n"):
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except ValueError:
                continue
            intent = registro.get("intent_id")
            if not isinstance(intent, str):
                continue
            indice.setdefault(intent, []).append(hashlib.sha256(linha).hexdigest())
    return indice


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    args = parser.parse_args()

    try:
        with open(CONTRATO, encoding="utf-8") as arquivo:
            contrato = json.load(arquivo)
    except (OSError, ValueError) as erro:
        print("check-v2-semantic-pins-fresh: contrato ilegivel (%s)" % erro, file=sys.stderr)
        return 2

    cache = {}
    exatos, desatualizados, ausentes = [], [], []
    for chave, campo_pino, campo_caminho in FAMILIAS:
        for item in contrato.get(chave) or []:
            intent = item.get("intent_id")
            alvo = item.get(campo_caminho)
            pino = item.get(campo_pino)
            if not (isinstance(intent, str) and isinstance(alvo, str) and isinstance(pino, str)):
                ausentes.append({"intent_id": intent, "familia": chave, "motivo": "campo_ausente"})
                continue
            caminho = os.path.join(ROOT, alvo)
            if caminho not in cache:
                if not os.path.isfile(caminho):
                    cache[caminho] = {}
                else:
                    try:
                        cache[caminho] = linhas_por_intent(caminho)
                    except OSError as erro:
                        print("check-v2-semantic-pins-fresh: %s ilegivel (%s)" % (alvo, erro),
                              file=sys.stderr)
                        return 2
            vivos = cache[caminho].get(intent) or []
            registro = {"intent_id": intent, "familia": chave, "target_rel_path": alvo,
                        "pinned_sha256": pino}
            if len(vivos) != 1:
                registro["motivo"] = "linhas_vivas=%d" % len(vivos)
                ausentes.append(registro)
            elif vivos[0] == pino:
                exatos.append(registro)
            else:
                registro["live_sha256"] = vivos[0]
                desatualizados.append(registro)

    resultado = {
        "schema_version": "v2_semantic_pins_fresh_v1",
        "contract_rel_path": os.path.relpath(CONTRATO, ROOT),
        "exact": exatos, "stale": desatualizados, "unresolvable": ausentes,
    }
    if args.json:
        print(json.dumps(resultado, sort_keys=True, ensure_ascii=False, indent=1))
    else:
        print("check-v2-semantic-pins-fresh (%d pino(s))" % (
            len(exatos) + len(desatualizados) + len(ausentes)))
        for registro in exatos:
            print("  %-38s %s… exato" % (registro["intent_id"], registro["pinned_sha256"][:12]))
        for registro in desatualizados:
            print("  %-38s %s… DESATUALIZADO (vivo %s…)" % (
                registro["intent_id"], registro["pinned_sha256"][:12], registro["live_sha256"][:12]))
        for registro in ausentes:
            print("  %-38s SEM LINHA VIVA UNICA (%s)" % (
                registro.get("intent_id"), registro.get("motivo")))
        if desatualizados or ausentes:
            print("\ncheck-v2-semantic-pins-fresh: REPROVOU — check-v2-supersession-integrity")
            print("vai recusar o proximo commit. Remedio por intent:")
            print("\n  tools/refresh-v2-semantic-pins \\")
            for registro in desatualizados:
                print("      --intent %s \\" % registro["intent_id"])
            print("      --refreshed-by <operador> --refreshed-at <YYYY-MM-DD> --refresh-stale-pins")
            for registro in ausentes:
                print("\n  %s: %s em %s — nao ha linha viva unica para autenticar" % (
                    registro.get("intent_id"), registro.get("motivo"), registro.get("target_rel_path")))
            print("\nSe o TEXTO VISIVEL da pagina mudou, o refresh recusa (e recusa certo):")
            print("pagina nova exige revisao nova, por tools/finalize-v2-semantic-recut.")
        else:
            print("\ncheck-v2-semantic-pins-fresh: OK — todo pino semantico autentica a linha viva")
    return 1 if (desatualizados or ausentes) else 0


if __name__ == "__main__":
    sys.exit(main())
