#!/usr/bin/env bash
# check-djen-coleta-heartbeat — READ-ONLY. O vigia da coleta do diário.
#
# ★ POR QUE ELE EXISTE, medido em 2026-09-05:
#
#   internal/djen  → 12 arquivos, 9 pacotes o importam, teste completo
#   data/ops/djen_coleta_heartbeat.jsonl → NÃO EXISTIA
#   systemctl list-timers | grep -i djen → nada
#
# Coletor parado e "não houve intimação" produzem A MESMA TELA VAZIA. Num painel
# de prazos, essa é a pior falha silenciosa possível: o advogado só descobre
# quando o prazo já passou.
#
# O julgamento é de djen.AvaliaHeartbeat e FALHA FECHADA — ausência de dado é
# "atrasada", nunca "saudável". Ele acusa quatro coisas, e cada uma tem causa
# própria: batimento ausente (coletor nunca rodou ou o timer não foi instalado),
# última coleta acima da cadência de 24 h, coleta que não chegou à página vazia
# (abortou no meio), e coleta de UMA página com registro cheio — que é o sintoma
# clássico do cliente que confiou no campo `count` da API do CNJ.
#
# Ficar VERMELHO enquanto o timer não estiver instalado é o comportamento certo:
# ele mede um elo que existe pela metade, e é assim que se sabe disso.
#
# Quem escreve o batimento é ./tools/collect-djen --aplicar. Este comando só lê.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
exec "$ROOT/tools/run-check" djen-coleta-heartbeat "$@"
