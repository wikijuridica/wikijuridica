#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-content-inventory-arrow [flags]

Runs cmd/generate-content-inventory-arrow through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
ARTIFACT_LOCK_FILE="${WIKI_CONTENT_INVENTORY_ARROW_ARTIFACT_LOCK:-/tmp/opt-wiki-content-inventory-arrow-artifact.lock}"
ARTIFACT_LOCK_WAIT_SECONDS="${WIKI_CONTENT_INVENTORY_ARROW_ARTIFACT_LOCK_WAIT_SECONDS:-300}"
cd "$ROOT"

case "$ARTIFACT_LOCK_WAIT_SECONDS" in
'' | *[!0-9]*)
	echo "generate-content-inventory-arrow: WIKI_CONTENT_INVENTORY_ARROW_ARTIFACT_LOCK_WAIT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
if [[ "$ARTIFACT_LOCK_WAIT_SECONDS" -le 0 ]]; then
	echo "generate-content-inventory-arrow: WIKI_CONTENT_INVENTORY_ARROW_ARTIFACT_LOCK_WAIT_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if ! command -v flock >/dev/null 2>&1; then
	echo "generate-content-inventory-arrow: flock command is required for sidecar/evidence artifact lock" >&2
	exit 75
fi
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:content-inventory-arrow:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-60000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-15000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=1000}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-content inventory Arrow evidence written or validation failure}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/content_inventory_arrow_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_RELATED_PATHS="${WIKI_HEAVY_ARTIFACT_CLAIM_RELATED_PATHS:-data/ops/content_inventory.arrow}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-content-inventory-arrow}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/content_inventory_arrow_evidence.jsonl+data/ops/content_inventory.arrow}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
exec 9>"$ARTIFACT_LOCK_FILE"
if ! flock -n 9; then
	echo "generate-content-inventory-arrow: non_critical_wait artifact lock busy; reorient to independent P0 front instead of passive wait: $ARTIFACT_LOCK_FILE" >&2
	exit 75
fi

CLAIM_PATH="data/ops/content_inventory_arrow_evidence.jsonl"
if [ ! -e "$CLAIM_PATH" ]; then
	mkdir -p "$(dirname "$CLAIM_PATH")"
	checked_at="$(date -u +%F 2>/dev/null || printf 'unknown')"
	tmp="$(mktemp "data/ops/.content_inventory_arrow_evidence_bootstrap_XXXXXX.tmp")"
	printf '{"evidence_id":"content-inventory-arrow-bootstrap","record_status":"content_inventory_arrow_bootstrap_pending_overwrite","publication_allowed":false,"render_allowed":false,"sitemap_allowed":false,"approval":false,"public_path":"","index_policy":"noindex","checked_at":"%s"}\n' "$checked_at" >"$tmp"
	mv "$tmp" "$CLAIM_PATH"
fi

exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-content-inventory-arrow --timings "$@"
