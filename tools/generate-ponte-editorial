#!/usr/bin/env bash
# tools/generate-ponte-editorial — ESCREVE (não é read-only).
#
# Leva UMA thread da rede social ao acervo: ou ela vira candidata a página v2,
# em data/editorial/v2_candidates/, ou o comando recusa e imprime as citações
# que o acervo pode usar sem autorização de ninguém. A prosa completa — por que
# o candidato nasce fora do glob do acervo, por que o aceite é por obra e por
# que `conta_id` não atravessa — está no cabeçalho de
# cmd/generate-ponte-editorial/main.go, que é onde o código mora.
#
#   ./tools/generate-ponte-editorial --thread <slug> --dossie <arquivo.json>
#   ./tools/generate-ponte-editorial --thread <slug> --dossie <arquivo.json> --aplicar
#
# ★ ENSAIO É O PADRÃO. Sem `--aplicar` nada é escrito: nem o shard, nem o
# diretório data/editorial/v2_candidates/, nem a trilha. O diretório só passa a
# existir quando uma thread REAL for promovida — semeá-lo com exemplo seria o
# dado inventado que o contrato deste repositório proíbe.
#
# ★ O BANCO DA REDE SOCIAL É SEMPRE SOMENTE LEITURA, inclusive com `--aplicar`:
# `mode=ro` + `_pragma=query_only(1)`, com a trava conferida DEPOIS de aberta.
# O que esta ferramenta escreve mora em data/, nunca em var/social/social.db.
#
# ★ O ACEITE É A CONDIÇÃO, e não uma formalidade. Sem aceite explícito e datado
# de CADA autor cujo texto entra, o comando recusa a promoção e devolve as
# citações com nome do autor e origem (Lei 9.610/98, art. 46, III). Publicar sob
# CC BY 4.0 texto que ninguém licenciou seria afirmar autorização inexistente.
#
# ★ UM SHARD POR THREAD (`cand-<slug>.jsonl`): `ponteeditorial.Grava` substitui
# o arquivo inteiro por rename atômico, então shard compartilhado perderia os
# outros candidatos. Reexecutar a mesma thread substitui só o registro dela — e
# o índice ignora o próprio candidato para não medi-lo contra a versão anterior
# de si mesmo.
#
# ★ O ENVELOPE. `run-heavy-throttled` exige de todo `./cmd/generate-*` o
# contrato de custo (orçamento, duração esperada, throughput e condição de
# parada) e evidência de tempo do próprio filho, por isso o `--timings` vai
# sempre. O throughput declarado é de UMA thread por execução: o custo real
# desta ferramenta é o carregamento do índice (acervo publicado + candidatos +
# artefato de co-citação), não a thread. A trilha reivindicada só nasce na
# primeira promoção real — o envelope trata isso como cold start, porque o
# produtor do artefato é este próprio comando.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:ponte-editorial:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=0.05}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/ponte_editorial.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-ponte-editorial}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/ponte_editorial.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-300}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-ponte-editorial --timings "$@"
