#!/usr/bin/env python3
"""Sorteia, por stride deterministico, os itens do parser para leitura humana.

POR QUE ELE EXISTE. `f1870995` gravou ~98.800 itens com URN por regex sobre
ementa. A ancora e literal e a URN e validada pelo lexml, mas nada disso mede
ATRIBUICAO: o trecho pode ocorrer no texto e a URN apontar outro dispositivo.
A unica coisa que mede isso e leitura humana, e leitura humana so vale se a
amostra for da populacao e o criterio for anterior ao numero. A regua esta em
.agents/runtime/regua/20260911-taxa-residual-do-parser.md.

READ-ONLY POR CONTRATO: nao escreve JSONL, manifesto nem dado permanente. O
exit code nao e veredito de qualidade — e 0 quando conseguiu sortear e 1 quando
o estado nao permite sortear. Quem da veredito de ATRIBUICAO e quem le.

O QUE O VERMELHO DELE SIGNIFICA NA BANCADA (registrado em 2026-09-16, §P10 §1)
Ele entrou em `tools/run-qualidade-diaria` com `--so-cardinalidade`, e o que a
etapa mede e UMA coisa so, estreita e util: **o artefato do parser existe e nao
esta vazio**. Vermelho ali le-se "data/ai/extracoes_dispositivos.jsonl sumiu, ou
nenhuma linha dele e do executor `parser` com URN LexML" — ou seja, o produtor
que ancora 100% e nao custa LLM parou de aparecer no arquivo. Vermelho ali NAO
se le "a atribuicao esta errada": isso so se descobre lendo a amostra, e nenhum
exit code deste programa jamais vai dize-lo.

Ate 2026-09-16 `--so-cardinalidade` devolvia 0 ANTES de olhar se a populacao era
vazia, entao registra-lo assim teria criado uma etapa que nunca podia ficar
vermelha — gate decorativo, que e pior que gate nenhum. A ordem das duas
verificacoes foi invertida no `main`, com o motivo escrito la.

Uso:
    tools/check-extracao-por-parser-amostra                  # n=40, stride
    tools/check-extracao-por-parser-amostra --n 60
    tools/check-extracao-por-parser-amostra --so-cardinalidade
"""
from __future__ import annotations

import argparse
import json
import re
import sqlite3
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
EXTRACOES = RAIZ / "data/ai/extracoes_dispositivos.jsonl"
FILA = RAIZ / "data/ai/fila.sqlite"
CORPUS = RAIZ / "data/corpus/jurisprudencia/stj-espelhos"
CONTEXTO = 220
RE_ESPACOS = re.compile(r"\s+")


def ultima_linha_por_chave(caminho: Path) -> dict:
    """O arquivo e append-only e o leitor toma a ULTIMA linha da chave."""
    ultima = {}
    with caminho.open(encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            ultima[registro["chave"]] = registro
    return ultima


def textos_disponiveis() -> dict:
    """Texto por chave, da fila e do corpus. A fila e a fonte do parser."""
    textos = {}
    if CORPUS.is_dir():
        for arquivo in sorted(CORPUS.glob("registros-*.jsonl")):
            with arquivo.open(encoding="utf-8") as f:
                for linha in f:
                    linha = linha.strip()
                    if not linha:
                        continue
                    registro = json.loads(linha)
                    ementa = (registro.get("ementa") or "").strip()
                    if ementa:
                        textos["acordao:STJ:" + str(registro.get("id_fonte"))] = ementa
    if FILA.exists():
        banco = sqlite3.connect(f"file:{FILA}?mode=ro", uri=True)
        try:
            for chave, payload in banco.execute(
                    "select chave, payload from tarefa where tipo = 'extrair_dispositivos'"):
                try:
                    texto = (json.loads(payload).get("texto") or "").strip()
                except (ValueError, TypeError):
                    continue
                if texto:
                    textos[chave] = texto
        finally:
            banco.close()
    return textos


def itens_do_parser(ultima: dict) -> list:
    """Itens com URN LexML das linhas do parser, em ordem estavel por chave.

    Sumula fica de fora: outro produtor (`SumulasDoTexto`), outra taxa. Ordenar
    por (chave, indice) e o que torna o stride reprodutivel entre execucoes.
    """
    saida = []
    for chave in sorted(ultima):
        registro = ultima[chave]
        if registro.get("executor") != "parser":
            continue
        for indice, item in enumerate(registro.get("dispositivos") or []):
            urn = str(item.get("urn") or "")
            if not urn.startswith("urn:lex:"):
                continue
            saida.append((chave, indice, item))
    return saida


def recorte(texto: str, ancora: str) -> str:
    if not ancora:
        return "(sem ancora gravada) " + RE_ESPACOS.sub(" ", texto[:300])
    posicao = texto.find(ancora)
    if posicao < 0:
        alvo = RE_ESPACOS.sub(" ", ancora)
        posicao = RE_ESPACOS.sub(" ", texto).find(alvo)
        if posicao < 0:
            return "ANCORA NAO OCORRE NO TEXTO ATUAL: " + RE_ESPACOS.sub(" ", texto[:300])
        texto = RE_ESPACOS.sub(" ", texto)
        ancora = alvo
    inicio = max(0, posicao - CONTEXTO)
    fim = posicao + len(ancora) + CONTEXTO
    return RE_ESPACOS.sub(" ", texto[inicio:fim])


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__,
                                         formatter_class=argparse.RawDescriptionHelpFormatter)
    analisador.add_argument("--n", type=int, default=40, help="tamanho da amostra (padrão 40)")
    analisador.add_argument("--so-cardinalidade", action="store_true",
                            help="imprime o tamanho da população e sai")
    argumentos = analisador.parse_args()

    if not EXTRACOES.exists():
        print(f"ausente: {EXTRACOES}", file=sys.stderr)
        return 1
    ultima = ultima_linha_por_chave(EXTRACOES)
    populacao = itens_do_parser(ultima)
    chaves = {chave for chave, _, _ in populacao}
    print(f"CARDINALIDADE ANTES DA AMOSTRA: {len(populacao)} itens com URN LexML "
          f"do executor parser, em {len(chaves)} acórdãos "
          f"(linhas lidas: {len(ultima)})")
    # A POPULACAO VAZIA E JULGADA ANTES DO --so-cardinalidade, e ate 2026-09-16
    # era depois. Com a ordem antiga, `--so-cardinalidade` devolvia 0 mesmo com
    # ZERO itens do parser — bastava o arquivo existir. Como e essa a forma
    # registrada na bancada diaria (a que NAO abre a fila de 133 MB nem o
    # corpus), a etapa nunca poderia ficar vermelha: gate decorativo. Invertida,
    # ela reprova exatamente no caso que importa — o artefato do parser sumiu ou
    # zerou —, e continua sem opinar sobre atribuicao, que so a leitura decide.
    if not populacao:
        print("nada a sortear: zero itens com URN LexML do executor `parser` em "
              f"{EXTRACOES}", file=sys.stderr)
        return 1
    if argumentos.so_cardinalidade:
        return 0
    if argumentos.n < 1:
        print("--n tem de ser >= 1", file=sys.stderr)
        return 1

    passo = max(1, len(populacao) // argumentos.n)
    sorteados = populacao[::passo][:argumentos.n]
    textos = textos_disponiveis()
    print(f"stride={passo} · sorteados={len(sorteados)} · "
          f"regua: .agents/runtime/regua/20260911-taxa-residual-do-parser.md")
    print()
    for ordem, (chave, indice, item) in enumerate(sorteados, start=1):
        texto = textos.get(chave, "")
        print(f"=== [{ordem:02d}] {chave}#{indice}")
        print(f"    norma={item.get('norma')!r} artigo={item.get('artigo')!r}")
        print(f"    urn={item.get('urn')}")
        if not texto:
            print("    ctx: (texto indisponível na fila e no corpus)")
        else:
            print(f"    ctx: ...{recorte(texto, str(item.get('texto_citado') or ''))}...")
        print()
    return 0


if __name__ == "__main__":
    # PROTECAO CRASH->2 (2026-09-16). Sem ela, uma excecao nao tratada faz o
    # interpretador sair com 1 — o MESMO codigo que este programa usa para
    # "o estado nao permite sortear". Na bancada diaria, e nas units que
    # mascaram `SuccessExitStatus=0 1`, a queda viraria `Result=success` e o
    # `OnFailure` nunca dispararia: um JSONL que mudou de forma, um sqlite
    # corrompido ou um PermissionError entregariam o numero de quem MEDIU.
    # Ver tools/lib/saida_de_medidor.py.
    sys.path.insert(0, str(RAIZ / "tools" / "lib"))
    from saida_de_medidor import main_protegido

    main_protegido(main)
