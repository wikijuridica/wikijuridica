#!/usr/bin/env python3
"""generate-planalto-anchor-registry-20260826 — quais ancoras EXISTEM mesmo no
documento oficial.

SUPERSEDIDO EM 2026-09-11 por tools/generate-planalto-anchor-registry-20260911,
que NAO se apaga daqui: esta ferramenta foi quem mediu em 2026-08-26 e quem
escreve data/source-audit/planalto_anchor_registry_20260826.jsonl, a evidencia
que sustenta o BUG-214. O que ela NAO pode mais fazer e gerar a tabela Go: o
`ANCORA_ARTIGO = ^art\d+$` abaixo descarta as ancoras de artigo LETRADO
(`art54a`) e de PARAGRAFO (`art1010§1`), que existem no HTML do Planalto e que o
registry de 2026-09-11 mede. Rodar `--so-tabela` por aqui desfaz 33.688 ancoras
de volta para 6.838. A afirmacao "o Planalto nao ancora paragrafo", que este
arquivo ajudou a espalhar, esta medida e e falsa.

POR QUE EXISTE. O corpo das paginas hiperliga a citacao legal a fonte oficial,
e ate 2026-08-26 esse link apontava sempre a LEI INTEIRA: 17.050 links inline
medidos, ZERO com fragmento, 5.884 deles citando um dispositivo especifico. O
leitor (humano ou agente) cai no topo de uma lei de 2.000 artigos e tem de
procurar o artigo na mao.

O CUIDADO QUE ESTA FERRAMENTA EXISTE PARA TER: a URL responde 200 mesmo quando a
ancora nao existe -- o fragmento nao e enviado ao servidor. Nenhum verificador
de link acusa o defeito. E a ancora NAO esta sempre la: medicao propria de
2026-08-26 mostra que
`https://www.planalto.gov.br/ccivil_03/leis/l8078compilado.htm` -- o documento
MAIS citado do acervo, 4.059 links inline -- tem DUAS ancoras no HTML inteiro, e
nenhuma delas e de artigo. Acrescentar `#art14` ali seria inventar. Por isso o
registro guarda o CONJUNTO REAL de ancoras de cada documento, e o renderizador
so emite o fragmento quando a ancora esta provada.

O QUE ELE FAZ. Le a lista de documentos que o hiperlink inline realmente alcanca
(medida por `cmd/measure-graph-authority`, campo `links_inline_por_url` --
derivada do dado, nunca escrita a mao), baixa cada um com identificacao propria
e ritmo humano, extrai os atributos `id`/`name` com html.parser e guarda os que
tem a forma de artigo (`artN`, que e a forma que a URN de componente do LexML
produz). Grava a evidencia (sha256, bytes, data da consulta) e a tabela em FONTE
GO -- fonte Go e nao `//go:embed` pelo mesmo motivo de
`tools/generate-siteicon-source`: o grafo autenticado do fingerprint de ingestao
so aceita `.go` no snapshot de codigo.

Uso:
    tools/generate-planalto-anchor-registry-20260826 --relatorio <arquivo.json>
    tools/generate-planalto-anchor-registry-20260826 --so-tabela
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
EVIDENCIA = ROOT / "data/source-audit/planalto_anchor_registry_20260826.jsonl"
TABELA = ROOT / "internal/structureddata/planalto_anchors_generated.go"
# Identidade canonica (CLAUDE.md secao 11). Medido em 2026-09-05 contra
# www.planalto.gov.br: 200/194.129 B (l8906.htm), 200/230.913 B
# (l13709compilado.htm).
UA = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
      "+https://wikijuridica.com.br/bot/; coleta-oficial)")
# Forma de ancora que a URN de componente do LexML produz: "art" seguido de
# digitos. Nada de tolerancia por caixa ou por sufixo -- o renderizador so pode
# emitir o que casa EXATAMENTE, senao volta a ser palpite.
ANCORA_ARTIGO = re.compile(r"^art\d+$")


class ColetorDeAncoras(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.ids: set[str] = set()

    def handle_starttag(self, tag, attrs):
        for nome, valor in attrs:
            if nome in ("id", "name") and valor:
                self.ids.add(valor.strip())


def decodifica(bruto: bytes) -> tuple[str, str]:
    for codificacao in ("utf-8", "latin-1"):
        try:
            return bruto.decode(codificacao), codificacao
        except UnicodeDecodeError:
            continue
    return bruto.decode("latin-1", "replace"), "latin-1"


def baixa(url: str, pausa: float) -> tuple[bytes, int]:
    pedido = urllib.request.Request(
        url, headers={"User-Agent": UA, "Accept": "text/html,*/*"})
    for tentativa in range(3):
        try:
            with urllib.request.urlopen(pedido, timeout=60) as resposta:
                bruto = resposta.read()
            time.sleep(pausa)
            return bruto, 200
        except urllib.error.HTTPError as erro:
            time.sleep(pausa)
            return b"", erro.code
        except Exception:
            time.sleep(pausa * (tentativa + 2))
    return b"", 0


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporario = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporario, path)
    finally:
        if os.path.exists(temporario):
            os.unlink(temporario)


# ★ ZERO ANCORA E DIFERENTE DE ANCORA NAO MEDIDA, e so uma das duas entra na
# tabela (corrigido em 2026-08-30).
#
# A tabela Go e a lista de documentos que PODEM receber fragmento; a evidencia
# JSONL e o que a coleta mediu. Confundi as duas ao acrescentar `l6015compilada`
# e `l5172compilado`, que respondem 200 e tem ZERO ancora de artigo: eles entraram
# na tabela com lista vazia e `TestInlineLinkLevaAoDispositivoQuandoAAncoraExiste`
# reprovou, com razao — "documento sem ancora de artigo ficou no registro e nao
# deveria receber fragmento nenhum".
#
# O filtro passou de `is not None` para veracidade da lista. A evidencia CONTINUA
# guardando o zero, que e medicao valiosa: e ela que prova, no BUG-214, que a
# regra do detector pedia `#art213` de um documento que nao tem ancora nenhuma.
def escreve_tabela(registros: list[dict]) -> None:
    registros = sorted(registros, key=lambda r: r["url"])
    linhas = [
        "// Code generated by tools/generate-planalto-anchor-registry-20260826; DO NOT EDIT.",
        "",
        "package structureddata",
        "",
        "// ancorasDeArtigoPorDocumento e o conjunto REAL de ancoras de artigo",
        "// (`artN`) presentes no HTML de cada documento oficial que o hiperlink",
        "// inline alcanca. Medido em 2026-08-26 baixando o proprio documento do",
        "// Planalto e lendo os atributos id/name -- nunca deduzido de padrao de",
        "// URL.",
        "//",
        "// Existe porque a URL responde 200 mesmo quando a ancora NAO existe: o",
        "// fragmento nao e enviado ao servidor, e nenhum verificador de link",
        "// acusa. E a ancora frequentemente nao esta la -- o documento mais",
        "// citado do acervo (l8078compilado.htm, o CDC, 4.059 links inline) tem",
        "// duas ancoras no HTML inteiro e nenhuma de artigo. Emitir `#art14` ali",
        "// seria inventar.",
        "//",
        "// A evidencia por documento (sha256, bytes, data da consulta) esta em",
        "// data/source-audit/planalto_anchor_registry_20260826.jsonl.",
        "var ancorasDeArtigoPorDocumento = map[string]map[string]struct{}{",
    ]
    for registro in registros:
        ancoras = sorted(registro["ancoras_de_artigo"])
        if not ancoras:
            linhas.append(f'\t{json.dumps(registro["url"])}: {{}},')
            continue
        linhas.append(f'\t{json.dumps(registro["url"])}: {{')
        linha = "\t\t"
        for ancora in ancoras:
            pedaco = f'"{ancora}": {{}}, '
            if len(linha) + len(pedaco) > 100:
                linhas.append(linha.rstrip())
                linha = "\t\t"
            linha += pedaco
        if linha.strip():
            linhas.append(linha.rstrip())
        linhas.append("\t},")
    linhas.append("}")
    linhas.append("")
    atomic_write(TABELA, ("\n".join(linhas)).encode("utf-8"))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--relatorio", type=Path,
                        help="JSON de cmd/measure-graph-authority (campo links_inline_por_url)")
    parser.add_argument("--pausa", type=float, default=3.5)
    parser.add_argument("--so-tabela", action="store_true")
    args = parser.parse_args()

    if args.so_tabela:
        registros = [json.loads(l) for l in EVIDENCIA.read_text(encoding="utf-8").splitlines() if l.strip()]
        escreve_tabela([r for r in registros if r.get("ancoras_de_artigo")])
        print(f"tabela regenerada com {len(registros)} documento(s)")
        return 0

    if not args.relatorio:
        print("--relatorio e obrigatorio (ou use --so-tabela)", file=sys.stderr)
        return 2
    relatorio = json.loads(args.relatorio.read_text(encoding="utf-8"))
    alvos = sorted(relatorio.get("links_inline_por_url") or {},
                   key=lambda u: -relatorio["links_inline_por_url"][u])
    if not alvos:
        print("o relatorio nao lista nenhum documento alcancado pelo link inline",
              file=sys.stderr)
        return 2
    print(f"conferindo {len(alvos)} documento(s) oficial(is)")

    registros = []
    for indice, url in enumerate(alvos, 1):
        bruto, status = baixa(url, args.pausa)
        registro = {
            "url": url,
            "ocorrencias_no_acervo": relatorio["links_inline_por_url"][url],
            "consultado_em": time.strftime("%Y-%m-%d"),
            "http_status": status,
        }
        if bruto:
            texto, codificacao = decodifica(bruto)
            coletor = ColetorDeAncoras()
            try:
                coletor.feed(texto)
            except Exception:
                pass
            artigos = sorted(a for a in coletor.ids if ANCORA_ARTIGO.match(a))
            registro |= {
                "sha256_documento": hashlib.sha256(bruto).hexdigest(),
                "bytes": len(bruto),
                "encoding": codificacao,
                "ancoras_no_documento": len(coletor.ids),
                "ancoras_de_artigo": artigos,
            }
        print(f"  [{indice}/{len(alvos)}] {status} "
              f"ancoras_de_artigo={len(registro.get('ancoras_de_artigo') or [])} "
              f"({registro['ocorrencias_no_acervo']} links) {url}", flush=True)
        registros.append(registro)

    # ★ RODADA PARCIAL FUNDE, NAO SUBSTITUI (corrigido em 2026-08-30).
    #
    # Antes, o `atomic_write` gravava SO os documentos desta rodada, e a tabela
    # Go era regerada a partir deles. Medido no proprio corpo: uma rodada com
    # `--relatorio` de DOIS documentos (as variantes do CPP) apagou os ONZE ja
    # registrados — inclusive `l10406.htm`, com 4.346 ocorrencias no acervo, o
    # mais citado de todos — e a tabela
    # `internal/structureddata/planalto_anchors_generated.go` perdeu 708 linhas.
    #
    # O estrago e SILENCIOSO: a saida dizia "documentos com ancora de artigo:
    # 2/2", que soa como sucesso. E o renderizador so emite fragmento quando a
    # ancora esta provada na tabela — entao apagar a tabela nao quebra nada
    # visivelmente; ele apenas para de ancorar milhares de links, que e o
    # defeito que esta ferramenta existe para corrigir.
    #
    # A medicao NOVA prevalece para a mesma URL (re-conferir e o proposito), e o
    # que nao foi conferido nesta rodada permanece intacto.
    preexistentes = {}
    if EVIDENCIA.is_file():
        for linha in EVIDENCIA.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            anterior = json.loads(linha)
            preexistentes[anterior["url"]] = anterior
    for registro in registros:
        preexistentes[registro["url"]] = registro
    fundidos = sorted(preexistentes.values(),
                      key=lambda r: -int(r.get("ocorrencias_no_acervo") or 0))
    preservados = len(fundidos) - len(registros)
    if preservados > 0:
        print(f"  {preservados} documento(s) de rodadas anteriores preservados")
    linhas = [json.dumps(r, ensure_ascii=False) for r in fundidos]
    atomic_write(EVIDENCIA, ("\n".join(linhas) + "\n").encode("utf-8"))
    escreve_tabela([r for r in fundidos if r.get("ancoras_de_artigo")])
    registros = fundidos

    cobertos = sum(r["ocorrencias_no_acervo"] for r in registros if r.get("ancoras_de_artigo"))
    total = sum(r["ocorrencias_no_acervo"] for r in registros)
    print(f"\ndocumentos com ancora de artigo: "
          f"{sum(1 for r in registros if r.get('ancoras_de_artigo'))}/{len(registros)}")
    print(f"links inline em documento ancoravel: {cobertos}/{total}")
    print(f"evidencia: {os.path.relpath(EVIDENCIA, ROOT)}")
    print(f"tabela:    {os.path.relpath(TABELA, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
