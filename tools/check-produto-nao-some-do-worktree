#!/usr/bin/env python3
"""check-produto-nao-some-do-worktree — READ-ONLY.

Arquivo RASTREADO de produto que sumiu da worktree e nao tem copia preservada ao
lado e' perda pendente: basta um `git add` por diretorio para ela virar commit.

POR QUE ESTE GATE NASCEU (2026-09-10). A cadeia editorial preserva antes de mutar
— `tools/bootstrap-chain` move o canonico para `<nome>.stale-resume-<passo>-<hash>`
e so o repoe quando o passo fecha. Um passo que para no meio (no caso medido, o
passo 1 no orfao de refinamento pago) deixa a worktree com os canonicos AUSENTES
por horas:

    git status --short | grep '^ D' | wc -l   ->  48
    data/editorial/refined_public_prose.jsonl        (86 MB)
    data/editorial/public_prose_candidate.jsonl      (77 MB)
    data/editorial/authorial_mass_scale_shards.jsonl
    ...

Os 48 tinham copia — conferido um a um. Mas o INDICE do git e' compartilhado entre
as sessoes deste repositorio, e a memoria `git-add-por-diretorio-varre-outra-sessao`
registra tres varreduras acidentais. Com 48 delecoes pendentes, um `git add data/`
de qualquer sessao apaga a cadeia editorial inteira de HEAD.

EXISTIR COPIA NAO E' EXISTIR **A** COPIA (acrescentado em 2026-09-10, depois de a
sessao par pedir a data junto da contagem). "48 de 48 tem copia" e' o numero certo
com a conclusao errada: naquele caso 37 das 48 copias mais novas eram de 30 de
AGOSTO, ou seja, o passo que preservou morreu ha onze dias e o que estava na
worktree nao era transacao em curso — era amputacao. Por isso este gate passou a
imprimir, junto da contagem:

  * a IDADE da preservacao mais nova (ctime: quando a copia passou a existir
    naquele caminho; `rename(2)` a atualiza, e e' isso que separa "a cadeia esta
    rodando agora" de "o passo morreu e deixou o buraco");
  * quantas copias sao IDENTICAS ao HEAD (blob id do git, sem materializar o
    conteudo do HEAD), porque restaurar copia que difere do HEAD nao devolve o
    HEAD — e o HEAD e' de onde a recuperacao sai, ja que o arquivo e' rastreado.

E passou a REPROVAR a preservacao abandonada: canonico ausente com a copia mais
nova acima de `--idade-maxima-horas` (24 por padrao) nao e' transacao em curso.
A cadeia tem teto DURO de 600 s por passo (`cadeia-aquecimento-standalone`), entao
24 h nao e' passo lento: e' passo morto.

O QUE ELE **NAO** FAZ. Nao reprova delecao preservada dentro da janela: preservar-
antes-de-mutar e' o comportamento CORRETO da cadeia e acusa-lo seria o falso
positivo que faz gate deixar de ser lido. Nao reprova copia que difere do HEAD —
diferenca e' o esperado no meio de um passo vivo, e o numero sai como diagnostico.
Nao restaura nada, nao commita, nao toca a worktree.

CARDINALIDADE ANTES DA AMOSTRA. A primeira linha diz quantos sumiram e quantos
estao preservados, ANTES de listar qualquer caminho — a lista pode ser cortada, o
total nunca. Tres instrumentos deste repositorio erraram nisso em 2026-09-10
(`max_errors=200`, `tail -4000`, `--cobertura` invertido) e a regra saiu dai.

Uso:
    tools/check-produto-nao-some-do-worktree
    tools/check-produto-nao-some-do-worktree --raiz /caminho   (bancada)
    tools/check-produto-nao-some-do-worktree --idade-maxima-horas 6
"""
from __future__ import annotations

import argparse
import datetime
import subprocess
import sys
import time
from pathlib import Path

# Arvores em que um arquivo rastreado que some e' PRODUTO, nao ruido de execucao.
# `.agents/runtime/` fica de fora de proposito: e' scratch declarado.
CAMINHOS_DE_PRODUTO = ("data/", "content/", "public/", "ops/", "docs/", "tools/",
                       "internal/", "cmd/")

# Sufixos com que a casa preserva antes de mutar. `.stale-resume-*` e' o da
# cadeia; `.poisoned*` e `.stale-<carimbo>` aparecem em reparos mais antigos.
MARCAS_DE_PRESERVACAO = (".stale", ".poisoned", ".bak", ".pre-")

TETO_DE_LISTA = 40

# Teto DURO de um passo da cadeia e' 600 s. 24 h nao e' passo lento, e' passo morto.
IDADE_MAXIMA_HORAS_PADRAO = 24.0


def git(raiz: Path, *argumentos: str) -> str:
    resultado = subprocess.run(["git", "-C", str(raiz), *argumentos],
                               capture_output=True, text=True, check=False)
    if resultado.returncode != 0:
        raise SystemExit("check-produto-nao-some-do-worktree: git "
                         + " ".join(argumentos) + " falhou: "
                         + resultado.stderr.strip())
    return resultado.stdout


def git_opcional(raiz: Path, *argumentos: str) -> str | None:
    """Como `git`, mas devolve None em vez de abortar.

    Usado nas consultas de identidade: um caminho que nao esteja em HEAD nao e'
    motivo para derrubar o gate inteiro — e' so um diagnostico a menos.
    """
    resultado = subprocess.run(["git", "-C", str(raiz), *argumentos],
                               capture_output=True, text=True, check=False)
    if resultado.returncode != 0:
        return None
    return resultado.stdout.strip()


def apagados_rastreados(raiz: Path) -> list[str]:
    """Somente ` D` — deletado na WORKTREE e ainda rastreado no HEAD.

    `D ` (deletado e ja estagiado) fica de fora: ali a decisao ja foi tomada e o
    lugar de discuti-la e' a revisao do commit, nao este gate.
    """
    saida = git(raiz, "status", "--porcelain")
    caminhos = []
    for linha in saida.splitlines():
        if len(linha) < 4:
            continue
        if linha[0] == " " and linha[1] == "D":
            caminhos.append(linha[3:].strip().strip('"'))
    return caminhos


def copias_preservadas(raiz: Path, relativo: str) -> list[Path]:
    alvo = raiz / relativo
    diretorio = alvo.parent
    if not diretorio.is_dir():
        return []
    prefixo = alvo.name + "."
    achadas = []
    for vizinho in diretorio.iterdir():
        if not vizinho.name.startswith(prefixo):
            continue
        sufixo = vizinho.name[len(alvo.name):]
        if sufixo.startswith(MARCAS_DE_PRESERVACAO):
            achadas.append(vizinho)
    return achadas


def copia_mais_nova(copias: list[Path]) -> Path:
    """A mais nova por ctime — quando a copia passou a existir NAQUELE caminho.

    Nao e' mtime: `rename(2)` preserva o mtime do canonico, que e' a data em que
    o PRODUTOR escreveu o conteudo. Um passo vivo pode mover arquivo cujo
    conteudo e' de semanas atras, e julgar isso por mtime reprovaria transacao
    legitima. ctime responde a pergunta certa: quando o buraco foi aberto.
    """
    return max(copias, key=lambda c: c.stat().st_ctime)


def identica_ao_head(raiz: Path, relativo: str, copia: Path) -> bool | None:
    """A copia tem o mesmo conteudo que o HEAD tem para o caminho canonico?

    Compara blob id contra blob id, sem materializar o conteudo do HEAD. O
    tamanho e' o pre-filtro: `git cat-file -s` e' consulta de arvore (instantanea)
    e tamanho diferente ja decide, o que evita hashear 86 MB a toa.
    """
    esperado = git_opcional(raiz, "rev-parse", "HEAD:" + relativo)
    if not esperado:
        return None
    tamanho_head = git_opcional(raiz, "cat-file", "-s", "HEAD:" + relativo)
    try:
        if tamanho_head is not None and int(tamanho_head) != copia.stat().st_size:
            return False
    except (ValueError, OSError):
        return None
    obtido = git_opcional(raiz, "hash-object", "--path=" + relativo, str(copia))
    if not obtido:
        return None
    return obtido == esperado


def carimbo(epoca: float) -> str:
    return datetime.datetime.fromtimestamp(epoca).strftime("%Y-%m-%d %H:%M")


def main(argv: list[str]) -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--raiz", default=None)
    analisador.add_argument("--idade-maxima-horas", type=float,
                            default=IDADE_MAXIMA_HORAS_PADRAO,
                            help="acima disto, preservacao sem canonico e' passo "
                                 "morto, nao transacao em curso")
    argumentos = analisador.parse_args(argv)

    raiz = Path(argumentos.raiz).resolve() if argumentos.raiz \
        else Path(__file__).resolve().parent.parent

    apagados = [c for c in apagados_rastreados(raiz) if e_produto(c)]
    desprotegidos = []
    preservados = []          # (relativo, copia mais nova, idade em horas)
    agora = time.time()
    for relativo in apagados:
        copias = copias_preservadas(raiz, relativo)
        if not copias:
            desprotegidos.append(relativo)
            continue
        nova = copia_mais_nova(copias)
        preservados.append((relativo, nova, (agora - nova.stat().st_ctime) / 3600.0))

    print("produto rastreado ausente da worktree: %d | com copia preservada: %d "
          "| SEM copia: %d" % (len(apagados), len(preservados), len(desprotegidos)))

    abandonados = []
    if preservados:
        mais_nova = min(preservados, key=lambda p: p[2])
        mais_velha = max(preservados, key=lambda p: p[2])
        print("  preservacao mais recente: %.1f h (criada %s) | a mais ANTIGA: "
              "%.1f h (criada %s, conteudo de %s)"
              % (mais_nova[2], carimbo(mais_nova[1].stat().st_ctime),
                 mais_velha[2], carimbo(mais_velha[1].stat().st_ctime),
                 carimbo(mais_velha[1].stat().st_mtime)))
        iguais = sum(1 for r, c, _ in preservados
                     if identica_ao_head(raiz, r, c) is True)
        print("  copias identicas ao HEAD: %d de %d — nas outras %d, restaurar a "
              "copia NAO devolve o HEAD" % (iguais, len(preservados),
                                            len(preservados) - iguais))
        abandonados = [p for p in preservados if p[2] > argumentos.idade_maxima_horas]

    if not desprotegidos and not abandonados:
        if apagados:
            print("  preservacao-antes-de-mutacao em curso; nenhuma perda pendente")
        return 0

    if desprotegidos:
        print("REPROVADO: arquivo de produto sumiu da worktree sem copia ao lado.")
        print("  Um `git add` por diretorio transforma isto em commit — o indice e "
              "compartilhado entre as sessoes.")
        for caminho in desprotegidos[:TETO_DE_LISTA]:
            print("   ", caminho)
        if len(desprotegidos) > TETO_DE_LISTA:
            print("    ... e mais %d (total ja declarado na primeira linha)"
                  % (len(desprotegidos) - TETO_DE_LISTA))

    if abandonados:
        print("REPROVADO: preservacao ABANDONADA em %d arquivo(s) — copia mais "
              "nova acima de %.1f h e canonico ainda ausente."
              % (len(abandonados), argumentos.idade_maxima_horas))
        print("  Passo da cadeia tem teto duro de 600 s: isto nao e' transacao em "
              "curso, e' buraco na worktree.")
        print("  O arquivo e' RASTREADO — o HEAD tem o conteudo. Reponha lendo "
              "(nao reverte worktree, nao apaga a copia):")
        for relativo, _, horas in abandonados[:TETO_DE_LISTA]:
            print("    git show HEAD:%s > %s   (%.1f h)" % (relativo, relativo, horas))
        if len(abandonados) > TETO_DE_LISTA:
            print("    ... e mais %d (total ja declarado acima)"
                  % (len(abandonados) - TETO_DE_LISTA))
    return 1


def e_produto(relativo: str) -> bool:
    return relativo.startswith(CAMINHOS_DE_PRODUTO)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
