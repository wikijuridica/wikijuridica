    ),
}


def carrega():
    with PAGES.open(encoding="utf-8") as fh:
        return json.load(fh)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--seco", action="store_true", help="mostra o que faria, sem escrever")
    args = ap.parse_args()

    dados = carrega()
    if not isinstance(dados, list):
        print("ABORTADO: content/pages.json não é uma lista; o formato mudou e este "
              "gerador foi escrito para o formato antigo. Releia antes de forçar.", file=sys.stderr)
        return 2

    caminhos = [p.get("path") for p in dados if isinstance(p, dict)]
    if CAMINHO in caminhos:
        print(f"NADA A FAZER: {CAMINHO} já existe em content/pages.json ({len(dados)} páginas).")
        return 0

    faltando = [c for c in PAGINA["internal_links"] if c not in caminhos]
    if faltando:
        print(f"ABORTADO: a página nova aponta para rota(s) que não existem: {faltando}. "
              "Link interno morto é defeito de indexação, não detalhe.", file=sys.stderr)
        return 2

    novo = list(dados)
    novo.append(PAGINA)

    print(f"páginas antes: {len(dados)}  depois: {len(novo)}")
    print(f"acrescenta: {CAMINHO}  ({PAGINA['title']})")
    print(f"seções de corpo: {len(PAGINA['body_sections'])}  "
          f"palavras: {sum(len(s['body'].split()) for s in PAGINA['body_sections'])}")
    if args.seco:
        print("--seco: nada foi escrito.")
        return 0

    GUARDA.mkdir(parents=True, exist_ok=True)
    copia = GUARDA / f"pages.json.{HOJE}.antes-de-bot"
    shutil.copy2(PAGES, copia)

    modo = PAGES.stat().st_mode & 0o777
    tmp = PAGES.with_suffix(".json.tmp-bot")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(novo, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.chmod(tmp, modo)
    os.replace(tmp, PAGES)
    print(f"escrito. cópia do anterior em {copia.relative_to(RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
