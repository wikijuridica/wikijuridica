#!/usr/bin/env bash
# repair-brotli-cobertura — mantem as gemeas .br completas e frescas, sem
# depender de alguem publicar. ESTA FERRAMENTA ESCREVE: ela invoca
# `tools/generate-brotli-static`, que reescreve as gemeas `.br` do acervo
# SERVIDO, e emite/resolve alerta em `data/ops/owner_alerts*`.
#
# POR QUE ELA NAO SE CHAMA MAIS `check-brotli-e-recomprimir` (2026-08-29)
# ======================================================================
# `CLAUDE.md` declara que `tools/check-*` e read-only e `tools/generate-*`
# escreve; misturar os papeis e bug. O nome antigo confessava a mistura no
# proprio nome: quem rodava para VERIFICAR a cobertura acabava RECOMPRIMINDO o
# acervo servido. O lado read-only ja existia e e mais forte que a medicao
# interna daqui — `tools/check-brotli-static-fresco` afere o mesmo piso de 90%
# e ainda acusa gemea STALE e gemea ORFA. Entao nao houve check novo: o miolo
# de verificacao e aquele gate, e a ACAO ficou aqui, com o prefixo `repair-`.
#
# O timer horario (`wikijuridica-brotli-cobertura.timer`) aponta para ESTE
# arquivo, e tem de continuar apontando: se ele passar a chamar o lado
# read-only, as gemeas `.br` apodrecem servindo corpo velho em silencio — que e
# exatamente o defeito que a unit existe para impedir.
#
# POR QUE ISTO EXISTE (ordem do dono, 2026-08-27)
# ===============================================
# "A recompressão tem que rodar no automático, se não vai ter o mesmo problema."
#
# O problema, medido no mesmo dia: a recompressao so rodava DENTRO do
# cmd/publish-v2-direct. Uma publicacao cortada no meio (o harness matou o
# comando por timeout) deixou o acervo com 265 gemeas de 10.402 — 2,5% de
# cobertura — e nada no sistema notou. Quem pede `Accept-Encoding: br`, que
# inclui a Cloudflare e todo bot moderno, passou a receber o HTML cru.
#
# E a TERCEIRA instancia da mesma familia num dia so: shard de sitemap em
# carencia, evidencia de fonte oficial e agora as gemeas. Sempre o mesmo
# desenho — a entrada e automatica, a saida depende de alguem lembrar.
#
# `brotli_static on` serve `$uri.br` SEM comparar frescor com o fonte, entao
# gemea velha e pior que gemea ausente: ausente faz o nginx comprimir na hora
# (mais lento, correto); velha serve CORPO ANTIGO com 200 e ETag valido.
set -uo pipefail
cd /opt/wiki || exit 2

# ---- PROTECAO CRASH->2 (2026-09-16). A unit que chama este script mascara
# exit 1 (`SuccessExitStatus=0 1`), porque 1 aqui e VEREDITO MEDIDO. Sem esta
# protecao, um script que MORRE com 1 — violacao de `set -u`, comando ausente —
# entrega o numero de quem mediu, a mascara o converte em `Result=success` e o
# OnFailure nunca dispara.
#
# `medidor_protege_exit` (e nao a trap ERR) porque este script NAO usa `set -e`:
# medido em 2026-09-16, a trap ERR nao dispara na violacao de `set -u`, e a trap
# EXIT dispara. Acrescentar `set -e` aqui mudaria a semantica de falha de todo
# comando do script, que e regressao proibida.
#
# Todo ponto de saida DELIBERADO com codigo 1 passa a chamar `medidor_sai 1`: e
# assim que a trap distingue "o autor decidiu sair com 1" de "o shell morreu".
. "$(dirname "${BASH_SOURCE[0]}")/lib/saida_de_medidor.sh"
medidor_protege_exit

PISO_COBERTURA=90

antes_gemeas=$(find public -name '*.br' ! -name '*.tmp' | wc -l)
comprimiveis=$(find public -type f \( -name '*.html' -o -name '*.xml' -o -name '*.txt' -o -name '*.json' \) | wc -l)
velhas=$(
	python3 - <<'PY'
import os, glob
print(sum(1 for br in glob.glob('public/**/*.br', recursive=True)
          if os.path.exists(br[:-3]) and os.path.getmtime(br) < os.path.getmtime(br[:-3])))
PY
)

cobertura=$(python3 -c "print(int($antes_gemeas / max($comprimiveis,1) * 100))")
echo "antes: $antes_gemeas gemeas de $comprimiveis comprimiveis (${cobertura}%), $velhas velha(s)"

if [ "$cobertura" -ge "$PISO_COBERTURA" ] && [ "$velhas" -eq 0 ]; then
	echo "acervo comprimido e fresco — nada a fazer"
	exit 0
fi

echo "abaixo do piso de ${PISO_COBERTURA}% ou com gemea velha; recomprimindo"
# O gerador ESPERA a trava (corrigido hoje) em vez de sair fingindo que fez.
nice -n 19 ./tools/generate-brotli-static --jobs 4
codigo=$?

depois=$(find public -name '*.br' ! -name '*.tmp' | wc -l)
cobertura_depois=$(python3 -c "print(int($depois / max($comprimiveis,1) * 100))")
echo "depois: $depois gemeas (${cobertura_depois}%)"

# O GERADOR TER QUEBRADO E O PISO TER SIDO FURADO SAO COISAS DIFERENTES, e ate
# 2026-08-28 as duas saiam com o mesmo exit 1 -- que a unit mascarava. Resultado:
# `generate-brotli-static` podia falhar todos os dias sem que ninguem soubesse,
# e as gemeas .br do acervo inteiro envelheceriam em silencio, servindo corpo
# ANTIGO a quem pede Accept-Encoding: br (inclusive a Cloudflare).
if [ "$codigo" -ne 0 ]; then
	echo "FALHA DE FERRAMENTA: generate-brotli-static saiu com $codigo — nao houve medicao de cobertura." >&2
	./tools/notify-owner \
		--chave brotli-gerador-quebrado \
		--severidade alta \
		--titulo "O gerador das gemeas .br quebrou" \
		--mensagem "generate-brotli-static saiu com codigo $codigo. Enquanto isso durar, as gemeas .br nao sao atualizadas e quem pede Accept-Encoding: br pode receber corpo ANTIGO — o caminho que o Googlebot usa." >/dev/null 2>&1 ||
		echo "ATENCAO: o gerador quebrou E o alerta ao dono falhou." >&2
	exit 2
fi

if [ "$cobertura_depois" -lt "$PISO_COBERTURA" ]; then
	if ! ./tools/notify-owner \
		--chave brotli-cobertura-abaixo-do-piso \
		--severidade media \
		--titulo "Acervo sem as gemeas .br" \
		--mensagem "Cobertura em ${cobertura_depois}% (piso ${PISO_COBERTURA}%), $velhas gemea(s) velha(s). Quem pede Accept-Encoding: br — inclusive a Cloudflare — recebe HTML cru, ou pior, corpo ANTIGO se a gemea estiver velha. Rode ./tools/generate-brotli-static."; then
		echo "ATENCAO: cobertura abaixo do piso E o alerta ao dono falhou." >&2
	fi
	medidor_sai 1
fi

# Resolve os DOIS alertas quando volta ao normal, senao eles ficam abertos para
# sempre. Alerta que ninguem fecha deixa de ser sinal e vira ruido que se aprende
# a ignorar -- o pior estado possivel de um canal de alarme, e um defeito que
# este repositorio ja pagou para aprender.
for chave_brotli in brotli-cobertura-abaixo-do-piso brotli-gerador-quebrado; do
	./tools/notify-owner --chave "$chave_brotli" --resolvido \
		--titulo "Compressao normalizada" \
		--mensagem "Gerador rodou com exit 0 e a cobertura esta em ${cobertura_depois}%." >/dev/null 2>&1 || true
done
exit 0
