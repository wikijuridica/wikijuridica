#!/usr/bin/env python3
"""generate-deploy-marco — grava o instante em que uma correção chegou ao ar.

Sem marco não há efeito medível. A série `bot_return_daily.jsonl` diz o que cada
bot fez em cada dia, mas nada nela sabe QUANDO o portal mudou — e comparar "antes
e depois" sem saber onde fica o meio é o tipo de número que parece medição e não é.

Este produtor existe para responder à pergunta que o dono fez ao autorizar o
deploy: *"ver o comportamento dos bots, após as correções, para ver se tá fazendo
efeito e se não, onde melhorar o plano"*. O marco é o eixo dessa comparação, e
`tools/check-efeito-deploy-bots` é quem a faz.

O QUE ELE GRAVA, e por que cada campo:

  commit          — o `vcs.revision` do binário que passou a rodar. É o que
                    permite dizer DEPOIS de qual código o comportamento mudou.
  mudou           — a lista do que aquele deploy carregou, em uma linha cada.
                    Sem isso, um efeito medido não tem causa candidata.
  linha_de_base   — o estado das métricas de retorno NO INSTANTE do deploy,
                    congelado. A série continua crescendo; o marco não.

O marco é APPEND-ONLY e nunca é reescrito: um deploy que aconteceu não deixa de
ter acontecido porque o seguinte foi melhor. Ler é sempre pela ÚLTIMA linha, ou
por `--commit`.

Uso:
    tools/generate-deploy-marco --mudou "Vary no erro negociado" --mudou "/changes.json"
    tools/generate-deploy-marco --dry-run
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
MARCOS = os.path.join(RAIZ, "data", "ops", "deploy_marcos.jsonl")
SERIE = os.path.join(RAIZ, "data", "ops", "bot_return_daily.jsonl")
BINARIO = os.path.join(RAIZ, "bin", "wikijuridica-server")


def commit_do_binario() -> str:
    """O commit que o binário EM EXECUÇÃO carrega, lido dele mesmo.

    Não é `git rev-parse HEAD`: o HEAD anda enquanto o binário fica. Perguntar ao
    git qual código está no ar é a confusão entre fonte e ar que este repositório
    já catalogou como armadilha A4.
    """
    try:
        saida = subprocess.run(
            [os.path.join(RAIZ, "tools", "go-modern"), "version", "-m", BINARIO],
            capture_output=True, text=True, timeout=60).stdout
    except Exception as e:
        return f"indisponivel: {e}"[:80]
    for linha in saida.split("\n"):
        if "vcs.revision=" in linha:
            return linha.split("vcs.revision=")[1].strip()
    return "sem_vcs_revision"


def linha_de_base() -> dict:
    """Congela o estado por bot no dia do deploy, direto da série canônica."""
    if not os.path.isfile(SERIE):
        return {}
    por_agente: dict[str, dict] = {}
    for linha in open(SERIE, encoding="utf-8"):
        linha = linha.strip()
        if not linha:
            continue
        registro = json.loads(linha)
        chave = registro.get("agent_key")
        # Última linha por (agente) na ordem do arquivo: a série é diária e
        # append-only, então a última é a mais recente.
        por_agente[chave] = registro
    return {
        chave: {
            "date": r.get("date"),
            "requisicoes": r.get("requisicoes", 0),
            "urls_novas_no_dia": r.get("urls_novas_no_dia", 0),
            "dias_desde_visita_anterior": r.get("dias_desde_visita_anterior"),
            "cobertura_acumulada_pct": r.get("cobertura_acumulada_pct"),
            "valioso": r.get("valioso", False),
            "funcao": r.get("funcao"),
        }
        for chave, r in sorted(por_agente.items())
    }


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--mudou", action="append", default=[],
                   help="uma linha por correção que este deploy carregou")
    p.add_argument("--rotulo", default="deploy do servidor Go")
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args()

    if not args.mudou and not args.dry_run:
        print("ERRO: --mudou e obrigatorio. Marco sem o que mudou nao serve para nada:\n"
              "  um efeito medido depois nao teria causa candidata a examinar.",
              file=sys.stderr)
        return 2

    base = linha_de_base()
    marco = {
        "schema_version": "deploy_marco_v1",
        "rotulo": args.rotulo,
        "gravado_em": datetime.now(timezone.utc).isoformat(),
        "commit": commit_do_binario(),
        "mudou": args.mudou,
        "agentes_na_base": len(base),
        "linha_de_base": base,
    }

    print(f"rotulo : {marco['rotulo']}")
    print(f"commit : {marco['commit'][:12]}")
    print(f"mudou  : {len(args.mudou)} item(ns)")
    for item in args.mudou:
        print(f"         - {item}")
    print(f"base   : {len(base)} agente(s) congelados")
    valiosos = [k for k, v in base.items() if v.get("valioso")]
    print(f"         dos quais {len(valiosos)} classificados como valiosos")

    if args.dry_run:
        print("\n--dry-run: nada gravado")
        return 0

    os.makedirs(os.path.dirname(MARCOS), exist_ok=True)
    with open(MARCOS, "a", encoding="utf-8") as f:
        f.write(json.dumps(marco, ensure_ascii=False) + "\n")
    print(f"\ngravado em {os.path.relpath(MARCOS, RAIZ)}")
    print("Compare depois com: tools/check-efeito-deploy-bots")
    return 0


if __name__ == "__main__":
    sys.exit(main())
