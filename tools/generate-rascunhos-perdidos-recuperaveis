#!/usr/bin/env python3
"""Indexa os rascunhos autorais que sumiram do corpus vivo e continuam publicados.

POR QUE ESTE ARTEFATO EXISTE (2026-09-10, §38/§39/§42 do dossie de deploy).

`cmd/ingest-v2-stock/main.go:436` fixa `Mode: v2ingest.ModeRewrite`, sem flag. Em
rewrite, `internal/v2ingest/v2ingest.go:415-418` zera o conteudo anterior do
arquivo canonico de rascunhos: so o que ESTE lote aceitou e regravado. Logo todo
rascunho de pagina REPROVADA e descartado no instante do deploy, ainda que a
pagina continue publicada, no sitemap e no `published_manifest`.

O §8 do contrato diz "Pagina escrita nunca e descartada: texto redigido foi pago
pelo dono". Medido em 2026-09-10: 231 intents publicados perderam o rascunho, e
os 231 estao integros no historico do git — 115.199 palavras.

O QUE ELE FAZ. Percorre TODAS as revisoes de
`data/editorial/authorial_mass_drafts.jsonl` (da mais nova para a mais antiga),
descobre quais `unique_intent_id` ja estiveram no arquivo e nao estao mais,
cruza com o `published_manifest` e grava, para cada um, a revisao mais recente
que ainda o continha.

CONJUNTOS, NAO LINHAS. `internal/v2ingest/v2ingest.go:592` ordena o arquivo por
`SourceSelectionRank` antes de gravar, entao ele e REORDENADO a cada execucao e
um diff de linhas mede a ordem, nao o conteudo. Toda comparacao aqui e entre
conjuntos de `unique_intent_id`.

O HORIZONTE E FECHADO. `git log --diff-filter=A` mostra que a revisao mais antiga
do arquivo (`e1028afc`, 2026-06-14) e a criacao dele. A uniao cobre a vida
inteira, entao a contagem e o numero e nao "o numero dentro do que ficou
registrado".

NAO RESTAURA NADA. Este e o indice; a restauracao depende de fechar antes a
valvula do `ModeRewrite` (senao o proximo passo 0/7 do deploy apaga de novo) e de
decidir o que fazer com `drafts_expected`, que alimenta
`authorialmassstock.EffectiveReleaseMinimum` em quatro pacotes de producao.

Uso:
    tools/generate-rascunhos-perdidos-recuperaveis            # grava o indice
    tools/generate-rascunhos-perdidos-recuperaveis --resumo   # so o resumo
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
RASCUNHOS = "data/editorial/authorial_mass_drafts.jsonl"
MANIFESTO = "data/editorial/published_manifest.jsonl"
SAIDA = "data/editorial/rascunhos_perdidos_recuperaveis.jsonl"

PADRAO_INTENT = re.compile(r'"unique_intent_id":"([^"]+)"')


def git(*argumentos: str) -> str:
    resultado = subprocess.run(
        ["git", "-C", str(RAIZ), *argumentos],
        capture_output=True, text=True, check=False)
    if resultado.returncode != 0:
        raise SystemExit(
            "generate-rascunhos-perdidos-recuperaveis: git "
            + " ".join(argumentos) + " falhou: " + resultado.stderr.strip())
    return resultado.stdout


def revisoes() -> list[str]:
    saida = git("log", "--format=%h", "--", RASCUNHOS)
    lista = [linha.strip() for linha in saida.splitlines() if linha.strip()]
    if not lista:
        raise SystemExit(
            "generate-rascunhos-perdidos-recuperaveis: o arquivo de rascunhos "
            "nao tem historico em git; sem historico nao ha o que indexar")
    return lista


def horizonte_fechado(mais_antiga: str) -> bool:
    """A revisao mais antiga do log e a criacao do arquivo?"""
    saida = git("log", "--diff-filter=A", "--format=%h", "--", RASCUNHOS)
    criacoes = [linha.strip() for linha in saida.splitlines() if linha.strip()]
    return bool(criacoes) and criacoes[-1] == mais_antiga


def publicados() -> dict[str, str]:
    """intent publicado -> caminho publico REAL, lido do manifesto.

    O `public_path` do proprio rascunho e "" por construcao: o registro nasce
    `authorial_mass_draft_blocked` e o campo e zerado sem condicional. Quem sabe
    onde a pagina esta no ar e o manifesto, e e dele que a rota tem de vir —
    senao o indice apontaria para lugar nenhum justamente nas 231 paginas que
    estao no ar.
    """
    caminho = RAIZ / MANIFESTO
    if not caminho.exists():
        raise SystemExit(
            f"generate-rascunhos-perdidos-recuperaveis: {MANIFESTO} ausente")
    rotas: dict[str, str] = {}
    with caminho.open(encoding="utf-8") as arquivo:
        for linha in arquivo:
            if not linha.strip():
                continue
            registro = json.loads(linha)
            chave = registro.get("unique_intent_id") or registro.get("intent_id")
            if chave:
                rotas[chave] = (registro.get("public_path")
                                or registro.get("path") or "")
    return rotas


def palavras_do_corpo(registro: dict) -> int:
    secoes = registro.get("body_sections") or []
    texto = " ".join((secao.get("text") or "") for secao in secoes)
    return len(texto.split())


def grava_atomico(caminho: Path, linhas: list[str]) -> None:
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=caminho.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        for linha in linhas:
            temporario.write(linha + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        provisorio = temporario.name
    os.replace(provisorio, caminho)


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--resumo", action="store_true",
                            help="imprime o resumo e nao grava o indice")
    argumentos = analisador.parse_args()

    lista_revisoes = revisoes()
    conteudo = {revisao: git("show", f"{revisao}:{RASCUNHOS}")
                for revisao in lista_revisoes}

    hoje = set(PADRAO_INTENT.findall((RAIZ / RASCUNHOS).read_text(encoding="utf-8")))
    uniao: set[str] = set()
    for revisao in lista_revisoes:
        uniao |= set(PADRAO_INTENT.findall(conteudo[revisao]))
    perdidos = uniao - hoje
    rotas_publicadas = publicados()
    alvo = perdidos & rotas_publicadas.keys()

    encontrados: dict[str, tuple[str, dict]] = {}
    for revisao in lista_revisoes:          # da mais nova para a mais antiga
        faltam = alvo - encontrados.keys()
        if not faltam:
            break
        for linha in conteudo[revisao].splitlines():
            if not linha.strip():
                continue
            achado = PADRAO_INTENT.search(linha)
            if not achado or achado.group(1) not in faltam:
                continue
            encontrados[achado.group(1)] = (revisao, json.loads(linha))

    ausentes = sorted(alvo - encontrados.keys())
    if ausentes:
        raise SystemExit(
            "generate-rascunhos-perdidos-recuperaveis: "
            f"{len(ausentes)} intents estao na uniao das revisoes mas nao foram "
            "relidos de nenhuma delas — a varredura esta errada, nao o dado: "
            + ", ".join(ausentes[:5]))

    linhas = []
    total_palavras = 0
    sem_corpo = []
    for intent in sorted(encontrados):
        revisao, registro = encontrados[intent]
        palavras = palavras_do_corpo(registro)
        total_palavras += palavras
        if palavras == 0:
            sem_corpo.append(intent)
        linhas.append(json.dumps({
            "unique_intent_id": intent,
            "draft_id": registro.get("draft_id", ""),
            "public_path": rotas_publicadas.get(intent, ""),
            "page_type": registro.get("page_type", ""),
            "practice_area": registro.get("practice_area", ""),
            "revisao_git": revisao,
            "palavras_do_corpo": palavras,
            "secoes": len(registro.get("body_sections") or []),
        }, ensure_ascii=False, separators=(",", ":"), sort_keys=True))

    print(f"revisoes do arquivo de rascunhos : {len(lista_revisoes)}")
    print(f"horizonte fechado (rev mais antiga e a criacao): "
          f"{horizonte_fechado(lista_revisoes[-1])}")
    print(f"intents que ja tiveram rascunho  : {len(uniao)}")
    print(f"perdidos                         : {len(perdidos)}")
    print(f"perdidos E publicados            : {len(alvo)}")
    print(f"recuperados do git               : {len(encontrados)}")
    print(f"sem corpo                        : {len(sem_corpo)}")
    print(f"palavras recuperaveis            : {total_palavras}")

    if argumentos.resumo:
        print("--resumo: nada gravado")
        return 0

    grava_atomico(RAIZ / SAIDA, linhas)
    print(f"gravado: {SAIDA} ({len(linhas)} linhas)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
