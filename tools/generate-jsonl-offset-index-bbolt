#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:jsonl-offset-index-bbolt:data/ops/refined_public_prose_source_content_id.bbolt}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-60000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-15000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=10000}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-bbolt_sidecar_and_evidence_written_or_validation_failure}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/refined_public_prose_source_content_id.bbolt}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-jsonl-offset-index-bbolt}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/refined_public_prose_source_content_id.bbolt}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"

if [[ "${WIKI_JSONL_OFFSET_INDEX_BBOLT_NO_LEDGER:-0}" != "1" ]]; then
	exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-jsonl-offset-index-bbolt --timings "$@"
fi

lock_key="$(printf '%s' "$WIKI_HEAVY_LOCK_SCOPE" | cksum | awk '{print $1 "-" $2}')"
lock_dir="${TMPDIR:-/tmp}/wiki-heavy-command-locks/generate-jsonl-offset-index-bbolt-$lock_key.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
	echo "generate-jsonl-offset-index-bbolt: lock active scope=$WIKI_HEAVY_LOCK_SCOPE path=$lock_dir" >&2
	exit 75
fi
cleanup_lock() {
	rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup_lock EXIT INT TERM

input_fingerprint="missing:data/editorial/refined_public_prose.jsonl"
if [[ -f data/editorial/refined_public_prose.jsonl ]]; then
	input_fingerprint="sha256:$(sha256sum data/editorial/refined_public_prose.jsonl | awk '{print $1}')"
fi
printf 'generate-jsonl-offset-index-bbolt: artifact_claim path=%s producer=%s input_fingerprint=%s output_fingerprint_expected=%s lock_scope=%s budget_ms=%s stop_condition=%s\n' \
	"$WIKI_HEAVY_ARTIFACT_CLAIM_PATH" \
	"$WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER" \
	"$input_fingerprint" \
	"$WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED" \
	"$WIKI_HEAVY_LOCK_SCOPE" \
	"$WIKI_HEAVY_BUDGET_MS" \
	"$WIKI_HEAVY_STOP_CONDITION" >&2

export WIKI_RUN_GO_CMD_CACHED_UNDER_HEAVY=1
"$ROOT/tools/run-go-cmd-cached" ./cmd/generate-jsonl-offset-index-bbolt --timings "$@"
