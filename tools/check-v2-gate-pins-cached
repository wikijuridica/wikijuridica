#!/usr/bin/env python3
"""check-v2-gate-pins-cached — avisa antes que o commit de conteúdo fique lento.

POR QUE EXISTE, com o custo medido: em 2026-08-12 três commits de CONTEÚDO PURO
foram recusados por timeout do hook. A causa não era o hook: era que
`tools/v2-gate-binary-pins.json` registrava hashes de um estado anterior do
código. O cache de binário dos gates é endereçado por CONTEÚDO — o lookup
procura o arquivo cujo nome É o pin —, então pin velho significa **miss
garantido**, e o hook recompila dois comandos Go do zero dentro de um orçamento
de 90 segundos. Com a máquina ocupada, ele não termina, e o commit é recusado.

O contrato do projeto declara commit de conteúdo LEVE por definição. Este check
existe para que a condição que o torna pesado seja detectável ANTES de custar
um commit — e a detecção é barata: basta perguntar se o arquivo de nome igual a
cada pin existe no cache. Não compila nada.

QUANDO ELE REPROVA, o remédio é de dois minutos:

    OID=$(git rev-parse HEAD)
    tools/run-v2-index-product-gates --root /opt/wiki --old "$OID" --emit-pins

Isso reconstrói, GUARDA no cache (comportamento corrigido no mesmo dia) e
imprime os hashes; grave-os em `tools/v2-gate-binary-pins.json` e commite os
dois juntos. **Faça isso ao fim de todo lote de commits Go**, porque é o lote Go
que muda o fecho de dependência dos dois binários e invalida os pins.

Uso:
    tools/check-v2-gate-pins-cached
    tools/check-v2-gate-pins-cached --json
"""
import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
PINS = os.path.join(ROOT, "tools", "v2-gate-binary-pins.json")

# O mesmo diretório que `run-v2-index-product-gates` usa (GATE_BIN_CACHE_DIR).
# Duplicar o caminho é aceitável aqui e a alternativa seria pior: extrair a
# variável de um script `sh` autenticado, que é fronteira de segurança do
# commit e não deve ganhar leitor externo. Se ele mudar de lugar, este check
# reprova ruidosamente — que é o comportamento certo para um caminho divergente.
CACHE = os.path.expanduser("~/.cache/wiki-v2-gate-bin")
CACHE_FALLBACK = os.path.join(ROOT, ".cache", "wiki-v2-gate-bin")


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    args = parser.parse_args()

    diretorio = CACHE if os.path.isdir(CACHE) else CACHE_FALLBACK

    try:
        with open(PINS, encoding="utf-8") as arquivo:
            pins = json.load(arquivo)
    except (OSError, ValueError) as erro:
        print("check-v2-gate-pins-cached: %s ilegivel (%s)" % (
            os.path.relpath(PINS, ROOT), erro), file=sys.stderr)
        return 2

    gates = pins.get("gates") or {}
    if not gates:
        print("check-v2-gate-pins-cached: nenhum pin declarado", file=sys.stderr)
        return 2

    faltando = []
    presentes = []
    for nome in sorted(gates):
        pin = gates[nome]
        caminho = os.path.join(diretorio, pin)
        if os.path.isfile(caminho) and not os.path.islink(caminho):
            presentes.append((nome, pin))
        else:
            faltando.append((nome, pin))

    resultado = {
        "cache_dir": diretorio,
        "cached": [{"gate": n, "pin": p} for n, p in presentes],
        "missing": [{"gate": n, "pin": p} for n, p in faltando],
        "schema_version": "v2_gate_pins_cached_v1",
    }

    if args.json:
        print(json.dumps(resultado, sort_keys=True, ensure_ascii=False, indent=1))
    else:
        print("check-v2-gate-pins-cached (cache: %s)" % diretorio)
        for nome, pin in presentes:
            print("  %-14s %s… em cache" % (nome, pin[:16]))
        for nome, pin in faltando:
            print("  %-14s %s… AUSENTE do cache" % (nome, pin[:16]))
        if faltando:
            print("\ncheck-v2-gate-pins-cached: REPROVOU — o proximo commit que tocar")
            print("data/editorial/v2_pages/ vai recompilar %d comando(s) Go do zero," % len(faltando))
            print("dentro do orcamento de 90s do hook, e provavelmente ser recusado.")
            print("\n  OID=$(git rev-parse HEAD)")
            print("  tools/run-v2-index-product-gates --root %s --old \"$OID\" --emit-pins" % ROOT)
            print("\ne grave os hashes impressos em tools/v2-gate-binary-pins.json.")
        else:
            print("\ncheck-v2-gate-pins-cached: OK — commit de conteudo continua leve")
    return 1 if faltando else 0


if __name__ == "__main__":
    sys.exit(main())
