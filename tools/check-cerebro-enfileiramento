#!/usr/bin/env python3
"""check-cerebro-enfileiramento — canario de regressao algoritmica do enfileiramento.

POR QUE EXISTE (2026-09-17). O cerebro ficou com producao ZERO por 40 minutos
com o processo `active (running)`. Quem segurava a fila era
`cerebro enfileirar-extracoes`, disparado pelo `.path` a cada deploy: um
UPDATE por candidato passou a varrer a faixa pendente inteira do modelo depois
que o commit 408dd997 criou `idx_tarefa_estado_modelo`, e o enfileiramento foi
de 38 s a 1.367 s na execucao seguinte -- 18 min de CPU disputando o lock de
escrita para `novas=0`. O worker perdia a corrida e pausava.

Nenhum instrumento acusou a REGRESSAO: o ledger `data/ops/cerebro_enfileirar.jsonl`
registrava a duracao a cada execucao, 38 -> 1.367 -> 1.370 -> 1.461 -> 1.846 s,
e ninguem o lia. So a CONSEQUENCIA (o worker pausado) chegou ao alerta, 25 min
depois, e o dono percebeu antes.

Este canario le a CAUSA: a duracao da ultima execucao. Com o algoritmo de delta
(internal/cerebro/enfileirar_lote.go) o enfileiramento le a faixa uma vez e
escreve so o que muda; voltar a minutos e sinal de que um indice sequestrou o
planejador de novo, ou de que alguem religou a escrita por candidato.

CONVENCAO (tools/lib/saida_de_medidor.py): 0 mediu e esta sao; 1 mediu e esta
lento; 2 nao mediu. Roda na unit wikijuridica-cerebro-saude, que NAO mascara o 1:
regressao aqui e o aviso que faltou em 2026-09-17.
"""
from __future__ import annotations

import argparse
import json
import os
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LEDGER_PADRAO = os.path.join(RAIZ, "data", "ops", "cerebro_enfileirar.jsonl")

# LIMIAR, calibrado por medicao e nao por prudencia. Medido em 2026-09-17:
#   antes do indice que sequestrou o planejador ... 38 s    (17.939 candidatos)
#   com a regressao ................................ 1.078 a 1.846 s
#   com o algoritmo de delta, em producao ........... 33 s     (30.468 candidatos,
#                                                     33,8 s de CPU contra 22 min 46 s
#                                                     da execucao anterior, 0 pausa no
#                                                     worker durante)
# 300 s e 9x o custo medido do algoritmo novo -- folga para o corpus crescer, porque
# LER o corpus e custo legitimo -- e 3,6x abaixo da execucao regressiva mais curta
# (1.078 s). As duas distancias sao medidas, nao estimadas.
LIMIAR_S_PADRAO = 300


def ultima_execucao(caminho):
    """Devolve (registro, erro). Erro != None significa NAO MEDI."""
    try:
        with open(caminho, encoding="utf-8") as fh:
            linhas = [l for l in fh if l.strip()]
    except OSError as erro:
        return None, "nao consegui ler %s: %s" % (caminho, erro)
    if not linhas:
        return None, "%s vazio: nenhuma execucao registrada" % caminho
    try:
        return json.loads(linhas[-1]), None
    except json.JSONDecodeError as erro:
        return None, "ultima linha de %s nao e JSON: %s" % (caminho, erro)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--ledger", default=LEDGER_PADRAO)
    ap.add_argument("--limiar-s", type=int, default=LIMIAR_S_PADRAO,
                    help="duracao acima da qual reprova (padrao: %d s)" % LIMIAR_S_PADRAO)
    args = ap.parse_args()

    reg, erro = ultima_execucao(args.ledger)
    if erro:
        print("NAO MEDIDO: %s" % erro, file=sys.stderr)
        return 2
    dur = reg.get("duracao_s")
    if not isinstance(dur, (int, float)):
        print("NAO MEDIDO: ultima execucao sem duracao_s numerica: %r" % dur, file=sys.stderr)
        return 2

    inicio, gatilho = reg.get("inicio", "?"), reg.get("gatilho", "?")
    print("wikijuridica-cerebro-enfileirar: ultima execucao %s (gatilho %s) levou %d s (limiar %d s)"
          % (inicio, gatilho, dur, args.limiar_s))
    if dur > args.limiar_s:
        print("\ncheck-cerebro-enfileiramento: FAIL")
        print("  O enfileiramento levou %d s. Com o algoritmo de delta ele le a faixa uma vez e" % dur)
        print("  escreve so o que muda; minutos de duracao sao a assinatura da regressao de")
        print("  2026-09-17 -- UPDATE varrendo a faixa do modelo por candidato --, e enquanto")
        print("  ele roda o worker disputa o lock da fila. Rode EXPLAIN QUERY PLAN nas constantes")
        print("  sql* de internal/cerebro/fila.go e o TestPlanoDoCaminhoQuenteBuscaPorChave.")
        return 1
    print("\ncheck-cerebro-enfileiramento: OK")
    return 0


if __name__ == "__main__":
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
    from saida_de_medidor import main_protegido

    main_protegido(main)
