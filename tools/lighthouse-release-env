#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
# BUG-098: prefixo npm persistente no repo. O /tmp e limpo no boot e o
# lighthouse@13 leva um `npm install --global` inteiro para voltar; .cache/
# sobrevive e esta no .gitignore. O prefixo legado em /tmp continua valendo
# enquanto tiver o binario, e WIKI_LIGHTHOUSE_NPM_PREFIX vence os dois.
PREFIX_PERSISTENT_DEFAULT="$ROOT/.cache/lighthouse-npm"
PREFIX_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-lighthouse-npm"
if [[ -n "${WIKI_LIGHTHOUSE_NPM_PREFIX:-}" ]]; then
	PREFIX="$WIKI_LIGHTHOUSE_NPM_PREFIX"
elif [[ -x "$PREFIX_LEGACY_DEFAULT/bin/lighthouse" ]]; then
	PREFIX="$PREFIX_LEGACY_DEFAULT"
else
	PREFIX="$PREFIX_PERSISTENT_DEFAULT"
fi
BIN="$PREFIX/bin/lighthouse"
VERSION="${WIKI_LIGHTHOUSE_VERSION:-13.4.0}"
if [[ "${WIKI_LIGHTHOUSE_NO_INSTALL:-}" != "1" && ! -x "$BIN" ]]; then
	mkdir -p "$PREFIX"
	npm install --global --prefix "$PREFIX" "lighthouse@$VERSION"
fi
export PATH="$PREFIX/bin:$PATH"
export WIKI_LIGHTHOUSE_BIN="${WIKI_LIGHTHOUSE_BIN:-$BIN}"
if [[ "$#" -eq 0 ]]; then
	exec "$WIKI_LIGHTHOUSE_BIN" --version
fi
cd "$ROOT"
exec "$@"
