#!/usr/bin/env bash
# check-redesocial-entrega-final — o gate que se roda ao declarar pronto.
#
# Irmao de check-redesocial-completude, com a assimetria invertida: este REPROVA
# enquanto houver qualquer entrega "pendente" em content/redesocial_entregas.json,
# nomeando uma a uma. Ele nao entra no pre-commit nem na suite diaria de
# proposito -- ficaria vermelho de F0 ate F6, e gate permanentemente vermelho e
# gate que ninguem le (DEC-045).
#
# Rode-o quando for afirmar que o PLANO_REDE_SOCIAL esta implementado. Se ele
# passar, nao ha entrega pendente E nenhuma das entregues esta sem prova.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# A TERCEIRA CLAUSULA NAO E MEDIDA AQUI, e quem declara pronto precisa saber.
# A condicao de encerramento do goal tem tres partes: (1) reprovar apenas pelas
# entregas que dependem de evento do mundo, (2) zero `suspenso` sem motivo e
# (3) todo gate citado por entrega `entregue` executado e VERDE. Este gate mede
# as duas primeiras. A terceira ele nem tenta: o guardiao confere que o gate
# citado EXISTE, nunca que ele PASSA -- e executar 23 gates aqui faria deste
# comando uma passada de minutos.
#
# Quem mede a terceira e' `tools/check-redesocial-gates-citados`. Rode os dois.
if [ "${1:-}" = "--ajuda" ] || [ "${1:-}" = "-h" ]; then
	echo "check-redesocial-entrega-final: mede as clausulas 1 e 2 da condicao do goal."
	echo "A clausula 3 (gates citados por entrega entregue) e' medida por:"
	echo "  ./tools/check-redesocial-gates-citados"
	exit 0
fi

exec "$ROOT/tools/run-check" redesocial-entrega-final "$@"
