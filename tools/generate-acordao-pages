#!/usr/bin/env bash
# tools/generate-acordao-pages — wrapper sancionado do motor de paginas de
# acordao do STJ.
#
# POR QUE ELE EXISTE. `tools/run-generate-supervised` recusa qualquer
# `./cmd/generate-*` que escreva artefato material sem declarar QUAL artefato —
# a claim tem de apontar para o arquivo de dado, nunca para o proprio log de
# claims. Os cinco geradores irmaos tem esse wrapper; este nao tinha, e sem ele
# a unica forma de rodar o motor era exportar as variaveis na mao a cada
# execucao. Isso e a mesma familia do produtor orfao do P3: o que nao tem
# invocacao declarada nao tem invocacao reproduzivel.
#
# A CLAIM SEGUE A ROTACAO. O shard rotaciona a cada 1.000 linhas
# (stj-acordao-derivado-01, -02, ...), e a claim tem de nomear o arquivo que a
# execucao vai de fato tocar — declarar sempre o `-01` faria a claim mentir a
# partir da milesima pagina. O ordinal ativo e o MAIOR existente, que e a mesma
# regra que `arquivosDaFamilia` aplica no Go; sem nenhum, e o `-01`, que e o que
# a proxima execucao cria.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
cd "$ROOT"

shard_ativo() {
	local diretorio="data/editorial/v2_pages"
	local ativo=""
	local caminho
	for caminho in "$diretorio"/stj-acordao-derivado-[0-9][0-9].jsonl; do
		[ -e "$caminho" ] || continue
		ativo="$caminho"
	done
	if [ -z "$ativo" ]; then
		ativo="$diretorio/stj-acordao-derivado-01.jsonl"
	fi
	printf '%s\n' "$ativo"
}

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:generate-acordao-pages:gocache:${GOCACHE}}"
# Medido em 2026-09-16 sobre o corpus de 78.791 registros: a passada exaustiva
# (7.503 paginas) levou 451 s, e a leitura do corpus sozinha domina qualquer
# passada com `-limite` baixo. O teto de 30 min cobre a drenagem do poco
# inteiro; a duracao esperada de 10 min cobre a passada exaustiva com folga.
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-1800000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-600000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-pages_per_second=16}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-$(shard_ativo)}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-acordao-pages}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:$WIKI_HEAVY_ARTIFACT_CLAIM_PATH}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-1800}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate-acordao-pages "$@"
