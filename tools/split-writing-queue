#!/usr/bin/env python3
"""split-writing-queue — fatia a fila de escrita em N workflows independentes.

POR QUE EXISTE (ordem do dono, 2026-07-29): "nao e para ficar fazendo dezenas ou
centenas de paginas num unico workflow, isso e contraproducente. Ve quantas
faltam e divide entre os agentes e workflows."

O teto de concorrencia do harness e POR WORKFLOW. Um workflow so, por mais que o
despacho interno nao tenha barreira, esbarra nesse teto. N workflows simultaneos
multiplicam a concorrencia efetiva por N. Este script produz as N filas.

O QUE FAZ: le scripts/workflows/writing-mass-todo.js (gerado por
ops/relaunch-writing.sh), extrai o array de lotes e emite N arquivos de workflow
validos, cada um com uma fatia disjunta. Nao reimplementa criterio nenhum — o
conteudo dos lotes e o despacho vem intactos do arquivo-base.

BALANCEAMENTO: distribui por PAGINAS (campo n), nao por numero de lotes, com
greedy no menor acumulado. Um lote de 22 paginas nao equivale a um de 1, e
fatiar por contagem de lotes deixaria fatias muito desiguais.

DISJUNCAO: cada lote entra em exatamente uma fatia. Dois workflows nunca escrevem
o mesmo shard — o writer CAS e por shard e escrita concorrente no mesmo alvo
falharia por CASMismatch, desperdicando o redator.

Uso:
  tools/split-writing-queue --parts 8
  tools/split-writing-queue --parts 8 --out-dir scripts/workflows/slices
"""
import argparse
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SOURCE = os.path.join(ROOT, "scripts/workflows/writing-mass-todo.js")
ANCHOR = re.compile(r"^const batches = (\[.*\])\s*$", re.MULTILINE | re.DOTALL)


def load_queue(path):
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    # O gerador emite exatamente uma linha "const batches = [...]" com JSON puro.
    for line in text.splitlines():
        if line.startswith("const batches = ["):
            payload = line[len("const batches = "):]
            return text, json.loads(payload), line
    raise SystemExit(f"split-writing-queue: nao achei 'const batches = [' em {path}")


def balance(batches, parts):
    """Greedy por paginas: cada lote vai para a fatia com menor carga atual."""
    order = sorted(batches, key=lambda b: -(b.get("n") or 0))
    slices = [[] for _ in range(parts)]
    load = [0] * parts
    for batch in order:
        target = load.index(min(load))
        slices[target].append(batch)
        load[target] += batch.get("n") or 0
    return slices, load


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--parts", type=int, required=True)
    parser.add_argument("--source", default=SOURCE)
    parser.add_argument("--out-dir", default=os.path.join(ROOT, "scripts/workflows/slices"))
    args = parser.parse_args()

    if args.parts < 1:
        raise SystemExit("split-writing-queue: --parts deve ser >= 1")

    text, batches, anchor_line = load_queue(args.source)
    if not batches:
        print("split-writing-queue: fila vazia — nada a fatiar")
        return 0

    parts = min(args.parts, len(batches))
    slices, load = balance(batches, parts)

    os.makedirs(args.out_dir, exist_ok=True)
    written = []
    for index, (chunk, pages) in enumerate(zip(slices, load), start=1):
        if not chunk:
            continue
        name = f"writing-slice-{index:02d}"
        body = text.replace(anchor_line, "const batches = " + json.dumps(chunk, ensure_ascii=False))
        # Nome unico por fatia: o harness identifica o workflow pelo meta.name, e
        # nomes repetidos confundem o acompanhamento de N execucoes simultaneas.
        body = body.replace("name: 'writing-mass-todo'", f"name: '{name}'")
        out = os.path.join(args.out_dir, f"{name}.js")
        with open(out, "w", encoding="utf-8") as handle:
            handle.write(body)
        written.append((out, len(chunk), pages))

    total_pages = sum(pages for _, _, pages in written)
    total_batches = sum(count for _, count, _ in written)
    print(f"fila original: {len(batches)} lotes / {sum(b.get('n') or 0 for b in batches)} paginas")
    print(f"fatias emitidas: {len(written)} (disjuntas, balanceadas por paginas)")
    for out, count, pages in written:
        print(f"  {os.path.relpath(out, ROOT):46s} {count:4d} lotes {pages:5d} paginas")
    print(f"conferencia: {total_batches} lotes / {total_pages} paginas somados")

    slugs = [b.get("slug") for chunk in slices for b in chunk]
    if len(slugs) != len(set(slugs)):
        raise SystemExit("split-writing-queue: FALHA — slug repetido entre fatias")
    if total_batches != len(batches):
        raise SystemExit("split-writing-queue: FALHA — lote perdido no fatiamento")
    print("disjuncao e completude verificadas: nenhum lote perdido, nenhum slug repetido")
    return 0


if __name__ == "__main__":
    sys.exit(main())
