#!/usr/bin/env python3
"""listar-produtores-de-pagina — le ops/produtores-de-pagina.jsonl e imprime,
em TSV, os produtores de pagina de um gatilho.

POR QUE ELE EXISTE. O mapa de geradores da onda diaria vivia num `declare -A`
literal dentro de `tools/run-daily-content`, com cinco entradas. Dois motores
commitados e funcionais ficavam de fora e nao rodavam em runner nenhum —
`cmd/generate-acordao-pages` (shard nunca gerado) e
`cmd/generate-lei-artigo-pages` (uma execucao a mao em 2026-09-10, 38 paginas,
e nunca mais). Com o mapa derivado do registro, "esquecer de acrescentar no
runner" deixa de ser uma possibilidade: quem nao esta no registro nao roda, e
quem esta no registro e nao roda em lugar nenhum e reprovado pelo gate
`produtor-orfao` (internal/checks/produtor_orfao.go).

READ-ONLY: nao escreve nada, nem ledger, nem cache.

SAIDA (TSV, uma linha por produtor, na ordem do arquivo):

    canal \t cmd \t shard \t portfolio \t limite_env \t limite_padrao

FALHA RUIDOSA, DE PROPOSITO. Linha malformada faz o comando sair 2 com a causa
no stderr, e nao imprimir um mapa PARCIAL. Mapa parcial e canal que para de
publicar em silencio — foi assim que a corrupcao das chaves pelo shfmt deixou a
passada --somente-noticias sem coletor nenhum por cinco dias.

Uso:
    tools/listar-produtores-de-pagina --gatilho onda-diaria
    tools/listar-produtores-de-pagina --gatilho publicador-cerebro
    tools/listar-produtores-de-pagina --todos --json
"""
from __future__ import annotations

import argparse
import json
import os
import sys

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
REGISTRO_RELATIVO = os.path.join("ops", "produtores-de-pagina.jsonl")

# Conjunto FECHADO, espelhando gatilhosDeProdutor em
# internal/checks/produtor_orfao.go. Divergencia entre os dois e reprovada la:
# gatilho que o gate aceita e este comando ignora seria um produtor registrado
# que nunca roda.
GATILHOS = {
    "onda-diaria": "tools/run-daily-content, etapa 2/9",
    "publicador-cerebro": "timer proprio do publicador autonomo do cerebro (P6)",
}

CAMPOS_OBRIGATORIOS = ("canal", "cmd", "shard", "portfolio", "gatilho", "limite_env", "limite_padrao")
CAMPOS_CONHECIDOS = set(CAMPOS_OBRIGATORIOS) | {"nota"}


def le_registro(caminho: str) -> list[dict]:
    if not os.path.isfile(caminho):
        raise SystemExit(f"listar-produtores-de-pagina: registro ausente: {caminho}")
    entradas: list[dict] = []
    canais: dict[str, int] = {}
    with open(caminho, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            linha = bruto.strip()
            # Linha em branco e linha iniciada por `#` sao COMENTARIO e nao
            # registram nada. Citar um comando ali o deixa tao orfao quanto
            # antes -- e a mesma fronteira que o gate cobra.
            if not linha or linha.startswith("#"):
                continue
            try:
                entrada = json.loads(linha)
            except json.JSONDecodeError as erro:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: JSON invalido ({erro})")
            if not isinstance(entrada, dict):
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: a linha tem de ser um objeto JSON")
            desconhecidos = sorted(set(entrada) - CAMPOS_CONHECIDOS)
            if desconhecidos:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: campo(s) fora do contrato: "
                    f"{', '.join(desconhecidos)}")
            faltando = [campo for campo in CAMPOS_OBRIGATORIOS if not str(entrada.get(campo, "")).strip()]
            if faltando:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: campo(s) obrigatorio(s) "
                    f"vazio(s): {', '.join(faltando)}")
            if entrada["gatilho"] not in GATILHOS:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: gatilho "
                    f"{entrada['gatilho']!r} fora do conjunto fechado {{{', '.join(sorted(GATILHOS))}}}")
            if not isinstance(entrada["limite_padrao"], int) or entrada["limite_padrao"] <= 0:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: limite_padrao tem de ser "
                    f"inteiro positivo, veio {entrada['limite_padrao']!r}")
            anterior = canais.get(entrada["canal"])
            if anterior is not None:
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: canal "
                    f"{entrada['canal']!r} ja declarado na linha {anterior}")
            canais[entrada["canal"]] = numero
            # Chave de array associativo do shell: tabulacao ou espaco na chave
            # quebraria o `read` do runner em silencio.
            if any(caractere.isspace() for caractere in entrada["canal"]):
                raise SystemExit(
                    f"listar-produtores-de-pagina: {REGISTRO_RELATIVO}:{numero}: canal "
                    f"{entrada['canal']!r} tem espaco — a chave do mapa de geradores nao pode ter")
            entradas.append(entrada)
    if not entradas:
        raise SystemExit(
            f"listar-produtores-de-pagina: {REGISTRO_RELATIVO} nao tem NENHUM produtor — "
            "registro so com comentario nao publica nada")
    return entradas


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    grupo = parser.add_mutually_exclusive_group(required=True)
    grupo.add_argument("--gatilho", choices=sorted(GATILHOS), help="so os produtores deste gatilho")
    grupo.add_argument("--todos", action="store_true", help="todos os produtores, de qualquer gatilho")
    parser.add_argument("--raiz", default=RAIZ, help="raiz do repositorio (default: a deste arquivo)")
    parser.add_argument("--json", action="store_true", help="imprime JSON em vez de TSV")
    args = parser.parse_args()

    entradas = le_registro(os.path.join(args.raiz, REGISTRO_RELATIVO))
    if not args.todos:
        entradas = [entrada for entrada in entradas if entrada["gatilho"] == args.gatilho]
        if not entradas:
            print(f"listar-produtores-de-pagina: nenhum produtor com gatilho {args.gatilho!r} "
                  f"em {REGISTRO_RELATIVO}", file=sys.stderr)
            return 1

    if args.json:
        print(json.dumps(entradas, ensure_ascii=False, sort_keys=True))
        return 0
    for entrada in entradas:
        print("\t".join((
            entrada["canal"], entrada["cmd"], entrada["shard"], entrada["portfolio"],
            entrada["limite_env"], str(entrada["limite_padrao"]))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
