#!/usr/bin/env python3
"""Verifica que o acervo continua citável por máquina — CSL-JSON e `cite-as`.

POR QUE ISTO EXISTE
===================
Um assistente de IA que use este portal como fonte precisa de duas coisas para
citar sem inventar: um registro estruturado (CSL-JSON, que processadores de
citação leem sem interpretar texto) e um `Link: rel="cite-as"` (RFC 8574), que
diz qual é a URL canônica para citação.

As duas foram construídas em 2026-08-27 e ficaram SEM GATE — a mesma condição
dos outros gates órfãos do repositório. Uma regressão silenciosa ali não quebra
página nenhuma para humano: só apaga a capacidade de a máquina citar direito,
que é justamente o que este portal quer ser.

O QUE ELE CONFERE, e por que cada coisa
=======================================
1. `Link: rel="cite-as"` na GÊMEA `/x/index.md`, e a AUSÊNCIA dele na URL que
   negocia por `Accept`. A ausência é tão importante quanto a presença: ali a URL
   é a mesma da página HTML e o `rel="canonical"` já diz tudo — um cite-as
   redundante seria ruído.
2. Bloco CSL-JSON no corpo do Markdown, com os campos que uma citação exige:
   título, autor, data, URL, idioma e a versão do conteúdo.
3. O JSON tem de PARSEAR. Bloco malformado é pior que ausente: quem consome
   confia no formato e engasga.
"""
import json
import re
import subprocess
import sys

BASE = "http://127.0.0.1:8089"
UA = "wikijuridica-superficie-probe/1.0"
# Páginas de ARTIGO, onde o contrato de citação é inteiro: cite-as na gêmea E
# registro CSL no corpo.
ROTAS = ("/glossario/intimacao/", "/glossario/citacao/")

# HUBS de área. Medido em 2026-08-27: eles emitem `cite-as` mas NÃO trazem
# CSL-JSON — dizem "cite-me por esta URL" e não entregam o registro estruturado
# que torna a citação processável. É inconsistência real, e está reportada como
# AVISO, não como reprovação: `pagemarkdown.CitacaoCSL` recusa emitir quando
# falta campo obrigatório, e "citação sem obra não é citação incompleta, é
# citação falsa" (comentário do próprio arquivo). Decidir se hub é obra citável
# — e então completá-lo — ou se não é — e então tirar o cite-as dele — é decisão
# editorial, não conserto mecânico. Reprovar aqui obrigaria alguém a escolher no
# susto; avisar mantém o achado vivo sem virar alarme diário.
HUBS = ("/familia/",)
CAMPOS = ("title", "author", "issued", "URL", "language", "type")


def pega(caminho, cabecalho_so=False, accept=None):
    cmd = ["curl", "-s", "--max-time", "15", "-A", UA, "-H", "X-Warming-Request: true"]
    if cabecalho_so:
        cmd.append("-I")
    if accept:
        cmd += ["-H", f"Accept: {accept}"]
    cmd.append(BASE + caminho)
    return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout


def main() -> int:
    falhas = []
    for rota in ROTAS:
        gemea = rota.rstrip("/") + "/index.md"

        cabecalhos = pega(gemea, cabecalho_so=True)
        if 'rel="cite-as"' not in cabecalhos:
            falhas.append(f"{gemea}: sem Link rel=\"cite-as\" (RFC 8574)")

        # Na URL que negocia, o cite-as seria redundante com o canonical.
        negociada = pega(rota, cabecalho_so=True, accept="text/markdown")
        if 'rel="cite-as"' in negociada:
            falhas.append(f"{rota} (Accept): tem cite-as e NAO deveria — ali a URL "
                          f"e a mesma do HTML e o canonical ja diz tudo")

        corpo = pega(rota, accept="text/markdown")
        blocos = re.findall(r"```json\s*(\{.*?\})\s*```", corpo, re.S)
        csl = None
        for bruto in blocos:
            try:
                candidato = json.loads(bruto)
            except ValueError:
                falhas.append(f"{rota}: bloco json no corpo NAO parseia — "
                              f"malformado e pior que ausente")
                continue
            if "type" in candidato and "URL" in candidato:
                csl = candidato
                break
        if csl is None:
            falhas.append(f"{rota}: sem bloco CSL-JSON valido no corpo do Markdown")
            continue
        faltando = [c for c in CAMPOS if not csl.get(c)]
        if faltando:
            falhas.append(f"{rota}: CSL-JSON sem {', '.join(faltando)}")

    for hub in HUBS:
        corpo = pega(hub, accept="text/markdown")
        tem_csl = bool(re.search(r"```json\s*\{.*?\}\s*```", corpo, re.S))
        cabecalhos = pega(hub.rstrip("/") + "/index.md", cabecalho_so=True)
        tem_citeas = 'rel="cite-as"' in cabecalhos
        if tem_citeas and not tem_csl:
            print(f"AVISO {hub}: emite cite-as mas nao traz CSL-JSON — anuncia "
                  f"que e citavel e nao entrega o registro estruturado. Decisao "
                  f"editorial pendente (completar o CSL do hub, ou retirar o "
                  f"cite-as dele).")

    if falhas:
        print("check-citacao-de-maquina: REPROVA", file=sys.stderr)
        for f in falhas:
            print(f"  {f}", file=sys.stderr)
        return 1
    print(f"check-citacao-de-maquina: pass — {len(ROTAS)} rota(s) citaveis por "
          f"maquina (cite-as na gemea, CSL-JSON completo no corpo)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
