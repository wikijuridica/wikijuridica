#!/usr/bin/env python3
"""measure-v2-approval-rate — taxa de aprovacao do estoque v2, medida no auditor canonico.

POR QUE EXISTE: a meta do projeto e 10.000 paginas APROVADAS. Ate hoje ninguem
sabia quantas passam de fato — as medicoes eram por amostra de 60 shards. Sem o
numero do corpus inteiro nao da para dizer quanto falta, nem quais defeitos
dominam o deficit.

O QUE FAZ: roda o auditor canonico (tools/audit_v2_pages.py --against-stock) shard
a shard e agrega. NAO reimplementa criterio nenhum — o veredito e do auditor.

IMPORTANTE: rode ./tools/ensure-audit-ready ANTES. Sem isso o auditor reprova por
AMBIENTE (indice/binario stale) e a medicao mede o ambiente, nao o conteudo.

SAIDA: JSON em data/ops/v2_approval_rate_<data>.json (dentro do repo, versionavel —
regra do dono 2026-07-29: produto nunca mora em /tmp).

Uso:
  tools/measure-v2-approval-rate [--sample N] [--seed S] [--out PATH] [--jobs J]
"""
import argparse
import collections
import concurrent.futures
import glob
import json
import os
import random
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
AUDITOR = os.path.join(ROOT, "tools", "audit_v2_pages.py")


def audit_one(path):
    """Devolve (path, ok, active_pages, defeitos) lendo SO o veredito do auditor."""
    try:
        with open(path, encoding="utf-8") as handle:
            lines = sum(1 for line in handle if line.strip())
    except OSError as exc:
        return path, None, 0, {"<ilegivel>": [str(exc)]}
    if lines == 0:
        return path, None, 0, {}
    # O auditor sai 1 quando o shard reprova — isso e um veredito legitimo, nao um
    # erro desta ferramenta. Capturamos a saida e ignoramos o codigo de propósito.
    proc = subprocess.run(
        ["nice", "-n", "19", "python3", AUDITOR, path,
         "--expect-n", str(lines), "--against-stock"],
        capture_output=True, text=True, cwd=ROOT,
    )
    try:
        payload = json.loads(proc.stdout)
    except Exception:
        return path, None, 0, {"<saida-nao-json>": [proc.stderr[-200:]]}
    return (path, bool(payload.get("ok")),
            payload.get("active_pages") or payload.get("pages") or 0,
            payload.get("defects") or {})


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--sample", type=int, default=0,
                        help="mede so N shards (0 = corpus inteiro)")
    parser.add_argument("--seed", type=int, default=20260728)
    parser.add_argument("--out", default="")
    parser.add_argument("--jobs", type=int, default=4)
    args = parser.parse_args()

    shards = sorted(glob.glob(os.path.join(ROOT, "data/editorial/v2_pages/*.jsonl")))
    if args.sample and args.sample < len(shards):
        random.seed(args.seed)
        shards = sorted(random.sample(shards, args.sample))

    started = time.monotonic()
    ok = fail = skipped = pages_ok = pages_total = 0
    defeitos = collections.Counter()
    shards_por_defeito = collections.defaultdict(list)

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        for path, verdict, active, defects in pool.map(audit_one, shards):
            rel = os.path.relpath(path, ROOT)
            pages_total += active
            if verdict is None:
                skipped += 1
                continue
            if verdict:
                ok += 1
                pages_ok += active
            else:
                fail += 1
                for code, items in defects.items():
                    defeitos[code] += len(items) if isinstance(items, list) else 1
                    # Lista COMPLETA por defeito: o relatorio alimenta a
                    # campanha de reparo (fila por familia), e um cap de 10
                    # escondia 90% do trabalho a fazer.
                    shards_por_defeito[code].append(rel)

    elapsed = time.monotonic() - started
    avaliados = ok + fail
    report = {
        "medido_em": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "escopo": "corpus_completo" if not args.sample else f"amostra_{args.sample}_semente_{args.seed}",
        "shards_avaliados": avaliados,
        "shards_ok": ok,
        "shards_reprovados": fail,
        "shards_vazios_ignorados": skipped,
        "taxa_aprovacao_shards": round(100.0 * ok / avaliados, 2) if avaliados else 0.0,
        "paginas_ativas_totais": pages_total,
        "paginas_em_shards_aprovados": pages_ok,
        "defeitos_por_frequencia": dict(defeitos.most_common()),
        "shards_exemplo_por_defeito": {k: v for k, v in shards_por_defeito.items()},
        "segundos": round(elapsed, 1),
        "nota": ("veredito do auditor canonico tools/audit_v2_pages.py --against-stock; "
                 "esta ferramenta nao reimplementa criterio. Rode ensure-audit-ready antes."),
    }

    out = args.out or os.path.join(
        ROOT, "data/ops", f"v2_approval_rate_{time.strftime('%Y%m%d')}.json")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as handle:
        json.dump(report, handle, ensure_ascii=False, indent=2)
        handle.write("\n")

    print(f"shards avaliados={avaliados} ok={ok} ({report['taxa_aprovacao_shards']}%) "
          f"reprovados={fail} vazios={skipped}")
    print(f"paginas ativas={pages_total} | em shards aprovados={pages_ok}")
    print("defeitos por frequencia:")
    for code, count in defeitos.most_common(15):
        print(f"  {count:6d}  {code}")
    print(f"relatorio: {os.path.relpath(out, ROOT)} ({elapsed:.0f}s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
