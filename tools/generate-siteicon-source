#!/usr/bin/env python3
"""Gera internal/siteicon/assets_generated.go a partir dos assets versionados.

POR QUE ESTE GERADOR EXISTE (nao e preferencia de estilo):

O favicon nasceu com //go:embed favicon.ico / favicon.svg. Isso quebrou o
fingerprint transacional do ingest v2. O grafo autenticado do validador
(internal/v2ingest/validator_fingerprint_graph.go) percorre os imports locais a
partir de internal/v2ingest e cmd/ingest-v2-stock, alcanca internal/httpserver e
portanto internal/siteicon, e REPROVA qualquer //go:embed que selecione um
arquivo nao-.go:

    //go:embed pattern "favicon.ico" selects unsupported non-Go asset
    "favicon.ico"; the authenticated code snapshot accepts only Go source

A restricao e dupla e deliberada: internal/v2readguard/guard.go:304-306 tambem
recusa qualquer caminho que nao seja .go/go.mod/go.sum no snapshot de codigo
(ErrUnsafePath). Afrouxar as duas guardas abriria buraco no snapshot que
autentica o binario que decide ingestao — e o proprio gerador da atestacao
(cmd/generate-validator-fingerprint-attestation) percorre o mesmo caminho, logo
nem seria possivel regenerar a constante.

A rota correta e a inversa: os bytes do icone viram FONTE GO. Assim eles entram
no hash do grafo pelo mecanismo que ja existe (todo .go de producao e lido e
hasheado), sem tocar em uma linha das guardas de seguranca.

Uso: ./tools/generate-siteicon-source
Depois de mudar o icone: ./tools/generate-site-favicon (redesenha o .ico) e
entao ./tools/go-modern generate ./internal/v2ingest (reancora a atestacao).
"""

from __future__ import annotations

import base64
import pathlib
import sys

# Largura da linha de base64 no arquivo gerado. 76 mantem a linha final abaixo
# de 80 colunas contando a indentacao e as aspas do literal Go.
WRAP = 76

HEADER = """// Code generated by tools/generate-siteicon-source; DO NOT EDIT.

package siteicon

// Os bytes do favicon moram em fonte Go, e nao em //go:embed, porque o grafo
// autenticado do fingerprint de ingestao (internal/v2ingest) so aceita .go no
// snapshot de codigo — ver tools/generate-siteicon-source para o motivo
// completo. Em Go source os mesmos bytes continuam autenticados, pelo caminho
// normal de hash de todo arquivo .go de producao.
//
// Fonte de verdade legivel: internal/siteicon/favicon.ico e favicon.svg,
// versionados ao lado. O teste TestGeneratedAssetsMatchVersionedFiles falha se
// este arquivo divergir deles.
"""


def const_block(name: str, comment: str, payload: bytes) -> str:
    encoded = base64.b64encode(payload).decode("ascii")
    lines = [encoded[i : i + WRAP] for i in range(0, len(encoded), WRAP)]
    body = " +\n\t".join(f'"{line}"' for line in lines)
    return f"\n{comment}\nconst {name} = {body}\n"


def main() -> int:
    package = pathlib.Path(__file__).resolve().parent.parent / "internal" / "siteicon"
    ico = (package / "favicon.ico").read_bytes()
    svg = (package / "favicon.svg").read_bytes()

    out = HEADER
    out += const_block(
        "icoBase64",
        "// icoBase64 e o favicon.ico multi-resolucao (16/32/48) em base64.",
        ico,
    )
    out += const_block(
        "svgBase64",
        "// svgBase64 e o favicon.svg vetorial em base64.",
        svg,
    )

    target = package / "assets_generated.go"
    target.write_text(out, encoding="utf-8")
    print(
        f"gravado {target} ({target.stat().st_size} bytes; "
        f"ico={len(ico)}B svg={len(svg)}B)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
