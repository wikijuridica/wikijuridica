#!/usr/bin/env python3
"""check-bot-ip-ranges-derivadas — o disco e a política têm de dizer a mesma coisa.

READ-ONLY. Sai != 0 quando `data/ops/bot_ip_ranges/` e o
`bot_ip_range_sources` de `content/crawl_policy.json` divergem, nos dois
sentidos.

O QUE ESTE GATE GUARDA.

Faixa de IP é a ÚNICA verificação de identidade que a origem tem: o log do nginx
não traz o `verifiedBotCategory` da borda. Quando o arquivo de faixas está errado,
o erro não aparece como erro — aparece como bot autêntico classificado
"não verificável", que é indistinguível de bot que ninguém tentou verificar.

MEDIDO EM 2026-08-26, e é o precedente que justifica o gate: o mapeamento
operador→agentes vivia como literal em `tools/generate-bot-ip-ranges` e colocava
`googleother`, `storebot-google` e `google-inspectiontool` em
`special-crawlers.json`. A doc oficial de crawlers de caso especial lista cinco
agentes e nenhum dos três — eles são crawlers COMUNS. O efeito no dado:
os três IPs reais de `Google-InspectionTool` no log desta casa
(66.249.73.97/.98/.99, **42 requisições**) davam **0/3** contra a faixa que o
projeto usava para autenticá-los, e **3/3** contra a faixa certa. Nada ficava
vermelho, porque nenhum gate comparava as duas pontas.

AS QUATRO DIVERGÊNCIAS QUE REPROVAM, e cada uma corresponde a um modo de falha:

  1. arquivo no disco sem fonte na política — coleta órfã. `botagents.ler_faixas`
     lê TODOS os arquivos do diretório, então um órfão continua autenticando pelo
     mapeamento velho mesmo depois de a política ser corrigida;
  2. fonte na política sem arquivo no disco — coleta que nunca rodou ou que
     falhou em silêncio;
  3. `authenticates_agents` do arquivo diferente do da política — é exatamente a
     forma do defeito medido acima;
  4. arquivo com zero prefixo — o verde por ausência de dado. Um coletor apontado
     para publicador de outro formato grava lista vazia, e lista vazia não
     reclama de nada.

E confere também que todo agente autenticado é um agente que a telemetria
IDENTIFICA (`tools/botagents.AGENTES`): faixa que autentica chave inexistente é
dado coletado à toa — foi o estado real de 1.056 prefixos oficiais do Google
enquanto a chave estava grafada errada.
"""

import argparse
import json
import os
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
sys.path.insert(0, os.path.join(RAIZ, "tools"))
import botagents  # noqa: E402

POLITICA = os.path.join(RAIZ, "content", "crawl_policy.json")
DIRETORIO = os.path.join(RAIZ, "data", "ops", "bot_ip_ranges")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    with open(POLITICA, encoding="utf-8") as handle:
        politica = json.load(handle)
    fontes = {f["operator"]: f for f in politica.get("bot_ip_range_sources", [])}
    if not fontes:
        print("check-bot-ip-ranges-derivadas: FAIL — política sem bot_ip_range_sources")
        return 1

    no_disco = {}
    if os.path.isdir(DIRETORIO):
        for nome in sorted(os.listdir(DIRETORIO)):
            if not nome.endswith(".json"):
                continue
            with open(os.path.join(DIRETORIO, nome), encoding="utf-8") as handle:
                no_disco[nome[:-len(".json")]] = json.load(handle)

    identificados = {chave for chave, _ in botagents.AGENTES}
    problemas = []

    for operador in sorted(set(no_disco) - set(fontes)):
        problemas.append(("arquivo_sem_fonte_na_politica", operador,
                          "autentica %s pelo mapeamento antigo" %
                          ",".join(no_disco[operador].get("authenticates_agents", [])) or "ninguem"))
    for operador in sorted(set(fontes) - set(no_disco)):
        problemas.append(("fonte_sem_arquivo_no_disco", operador, fontes[operador]["url"]))

    for operador in sorted(set(fontes) & set(no_disco)):
        arquivo = no_disco[operador]
        esperado = list(fontes[operador]["authenticates_agents"])
        obtido = list(arquivo.get("authenticates_agents", []))
        if esperado != obtido:
            problemas.append(("authenticates_agents_divergente", operador,
                              "politica=%s disco=%s" % (esperado, obtido)))
        if not arquivo.get("prefixes"):
            problemas.append(("zero_prefixo", operador,
                              "arquivo existe e nao autentica ninguem"))
        if arquivo.get("source_url") != fontes[operador]["url"]:
            problemas.append(("source_url_divergente", operador,
                              "politica=%s disco=%s" % (fontes[operador]["url"],
                                                        arquivo.get("source_url"))))

    for operador, fonte in sorted(fontes.items()):
        for agente in fonte["authenticates_agents"]:
            if agente not in identificados:
                problemas.append(("agente_que_a_telemetria_nao_identifica", operador, agente))

    autenticados = {}
    for operador, fonte in sorted(fontes.items()):
        for agente in fonte["authenticates_agents"]:
            autenticados.setdefault(agente, []).append(operador)
    for agente, operadores in sorted(autenticados.items()):
        if len(operadores) > 1:
            problemas.append(("agente_em_dois_operadores", agente, ",".join(operadores)))

    total_prefixos = sum(len(a.get("prefixes", [])) for a in no_disco.values())
    print("fontes na politica: %d | arquivos no disco: %d | agentes autenticados: %d | prefixos: %d"
          % (len(fontes), len(no_disco), len(autenticados), total_prefixos))
    for tipo, alvo, detalhe in problemas:
        print("  - %-42s %-26s %s" % (tipo, alvo, detalhe))
    if args.json:
        print(json.dumps({"fontes": len(fontes), "arquivos": len(no_disco),
                          "problemas": problemas}, ensure_ascii=False, indent=2))
    if problemas:
        print("check-bot-ip-ranges-derivadas: FAIL")
        return 1
    print("check-bot-ip-ranges-derivadas: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
