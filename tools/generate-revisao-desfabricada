#!/usr/bin/env python3
"""Desfaz a re-datacao que a MARCACAO da medicao provocou, e SO ela.

O DEFEITO QUE ESTA FERRAMENTA CONSERTA: instalar a API do Clarity acrescentou ao
HTML de toda pagina uma <meta name="wj-pagina"> e os atributos
data-clarity-unmask/mask. Nada disso e conteudo juridico — o leitor le exatamente
o mesmo texto —, mas nada disso e neutralizado por tools/generate-page-content-revision,
que so apaga <script> sem atributo e datas. Resultado: o served_sha256 mudou em
todo o acervo, ~8.600 rotas foram carimbadas com a data de hoje, e o sitemap
anunciou ao Googlebot que milhares de paginas mudaram quando nenhuma mudou. E o
bug do reviewed_at por outra porta, que o contrato registra como caro.

POR QUE NAO SE RESTAURA EM BLOCO: entre a linha de base e agora pode ter havido
mudanca LEGITIMA — texto editado, JSON-LD novo, og:image trocada. Restaurar tudo
apagaria a data dessas, que e o que o ledger existe para registrar. Entao a
restauracao e CONDICIONADA, rota a rota, a uma prova:

  1. le o HTML servido hoje;
  2. remove dele APENAS a marcacao da medicao (a meta e os dois atributos);
  3. aplica a MESMA neutralizacao do gerador oficial (importada dele, nunca
     reescrita: formula duplicada e formula que diverge);
  4. compara com o served_sha256 do ledger no commit de base.

So quando bate — ou seja, quando a UNICA diferenca era a marcacao — a data volta
ao que era. Onde nao bate, houve mudanca de verdade e a data de hoje fica.

O served_sha256 NAO e revertido: ele descreve o HTML de hoje, que de fato mudou.
O que se corrige e a DATA, que e o que o sitemap anuncia.

Uso:
  ./tools/generate-revisao-desfabricada --base <commit>            # ensaio
  ./tools/generate-revisao-desfabricada --base <commit> --aplicar
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
GERADOR = RAIZ / "tools" / "generate-page-content-revision"
LEDGER = RAIZ / "data" / "ops" / "page_content_revision.jsonl"
PUBLICO = RAIZ / "public"

# A marcacao que esta frente acrescentou, e SO ela. Qualquer outra diferenca no
# HTML e mudanca de verdade e tem de manter a data nova.
MARCACAO = [
    re.compile(r'\n?<meta name="wj-pagina" content="[^"]*">'),
    re.compile(r' data-clarity-unmask="true"'),
    re.compile(r' data-clarity-mask="true"'),
]


def carrega_gerador():
    """Importa o gerador oficial para reusar a NEUTRALIZACAO dele.

    Reescrever a formula aqui seria criar a segunda copia que diverge — e o
    proprio gerador guarda a assinatura dela em disco justamente porque
    divergencia de formula ja re-datou o acervo uma vez."""
    spec = importlib.util.spec_from_loader(
        "gerador_revisao", importlib.machinery.SourceFileLoader("gerador_revisao", str(GERADOR)))
    modulo = importlib.util.module_from_spec(spec)
    sys.modules["gerador_revisao"] = modulo
    spec.loader.exec_module(modulo)
    return modulo


def ledger_do_commit(ref):
    saida = subprocess.run(["git", "show", f"{ref}:data/ops/page_content_revision.jsonl"],
                           capture_output=True, text=True, cwd=str(RAIZ))
    if saida.returncode != 0:
        raise SystemExit(f"nao consegui ler o ledger em {ref}: {saida.stderr.strip()[:200]}")
    base = {}
    for linha in saida.stdout.splitlines():
        try:
            d = json.loads(linha)
        except ValueError:
            continue
        base[d["path"]] = d
    return base


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--base", required=True, help="commit cujo ledger e a linha de base")
    parser.add_argument("--aplicar", action="store_true", help="sem isto, so ensaia")
    args = parser.parse_args()

    gerador = carrega_gerador()
    base = ledger_do_commit(args.base)
    atual = {}
    ordem = []
    for linha in LEDGER.read_text(encoding="utf-8").splitlines():
        try:
            d = json.loads(linha)
        except ValueError:
            continue
        atual[d["path"]] = d
        ordem.append(d["path"])

    restauradas, legitimas, sem_base, sem_html = [], [], [], []
    for rota, registro in atura_items(atual):
        anterior = base.get(rota)
        if not anterior or anterior.get("revised_on") == registro.get("revised_on"):
            continue
        arquivo = PUBLICO / rota.strip("/") / "index.html" if rota != "/" else PUBLICO / "index.html"
        if not arquivo.is_file():
            sem_html.append(rota)
            continue
        html = arquivo.read_text(encoding="utf-8", errors="replace")
        for padrao in MARCACAO:
            html = padrao.sub("", html)
        texto = gerador.neutraliza_datas(html)
        for bloco in gerador.BLOCOS_DE_NAVEGACAO:
            texto = bloco.sub("@NAV@", texto)
        hash_sem_marcacao = gerador.sha256_texto(texto) if hasattr(gerador, "sha256_texto") else None
        if hash_sem_marcacao is None:
            import hashlib
            hash_sem_marcacao = hashlib.sha256(texto.encode("utf-8")).hexdigest()
        if hash_sem_marcacao == anterior.get("served_sha256"):
            restauradas.append((rota, anterior["revised_on"]))
        else:
            legitimas.append(rota)

    print(f"linha de base      : {args.base}")
    print(f"rotas com data nova: {len(restauradas) + len(legitimas) + len(sem_html)}")
    print(f"  so marcacao (restaurar) : {len(restauradas)}")
    print(f"  mudanca real (manter)   : {len(legitimas)}")
    print(f"  sem HTML no disco       : {len(sem_html)}")
    if legitimas[:3]:
        print(f"  exemplos de mudanca real: {legitimas[:3]}")

    if not args.aplicar:
        print("\nENSAIO: nada gravado. Repita com --aplicar.")
        return 0

    volta = dict(restauradas)
    saida = []
    for rota in ordem:
        registro = dict(atual[rota])
        if rota in volta:
            registro["revised_on"] = volta[rota]
        saida.append(json.dumps(registro, ensure_ascii=False, sort_keys=True))
    tmp = LEDGER.with_suffix(".jsonl.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(saida) + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, LEDGER)
    print(f"\ngravado: {LEDGER.relative_to(RAIZ)} — {len(restauradas)} data(s) devolvida(s) ao que eram")
    print("Rode agora a republicacao para que pages.json, sitemap e feed acompanhem.")
    return 0


def atura_items(d):
    return list(d.items())


if __name__ == "__main__":
    raise SystemExit(main())
