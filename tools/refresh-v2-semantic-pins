#!/usr/bin/env bash
# tools/refresh-v2-semantic-pins — ESCRITOR (wrapper de ./cmd/...).
#
# Re-autentica o pino de página de uma resolução semântica cujo registro mudou
# de BYTES sem mudar de SENTIDO (ex.: correção de URL de fonte oficial por
# gerador datado). Sem --refresh-stale-pins ele apenas PLANEJA e nada escreve.
#
# Uso:
#   tools/refresh-v2-semantic-pins --intent <ID> --refreshed-by <op> --refreshed-at <YYYY-MM-DD>
#   tools/refresh-v2-semantic-pins --intent <ID> ... --refresh-stale-pins
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
exec "$ROOT/tools/run-go-cmd-cached" ./cmd/refresh-v2-semantic-pins "$@"
