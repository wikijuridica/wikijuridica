#!/usr/bin/env python3
"""Radar de IA — o que os agentes de IA VERIFICADOS leem no portal, por dia, por area
e por pagina, sem IP e sem aquecimento. Saida publica em public/datasets/radar-ia.json
(ultimos 7 dias) e serie em data/ops/radar_ia_daily.jsonl.

POR QUE (2026-09-08, ordem do dono: "plataforma viva, que se comunica com humanos e com
bots de IA valiosos"): nenhum portal juridico brasileiro publica o que os assistentes de
IA leem nele. O dado ja existe no ledger do nginx (data/ops/access/nginx-<dia>.jsonl);
o que faltava era verificar a identidade (faixas publicadas em data/ops/bot_ip_ranges,
mesma regra de tres palavras do evento unificado), descontar aquecimento/simulacao/UA
forjado e agregar sem expor ninguem: so agent_key, area, path publico e contagens.

O QUE NAO ENTRA: linhas com warming/bot_simulation; agente forjado (IP fora da faixa);
agente sem faixa publicada (unverifiable) — e listado a parte, nunca somado aos
verificados; rotas que nao sao pagina/markdown do acervo (api, mcp, assets, 404).
"""
from __future__ import annotations

import argparse
import collections
import datetime as dt
import hashlib
import json
import os
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
import botagents  # noqa: E402

SCHEMA = "radar_ia_v1"
ROTAS_DE_LEITURA = ("page", "markdown")
TOP_PAGINAS = 20
TOP_AREAS = 12


def le_jsonl(caminho):
    if not os.path.isfile(caminho):
        return
    with open(caminho, encoding="utf-8") as h:
        for l in h:
            l = l.strip()
            if not l:
                continue
            try:
                yield json.loads(l)
            except json.JSONDecodeError:
                continue


def veredito(registro, faixas):
    """authentic / forged / unverifiable, na mesma regra do evento unificado."""
    v = registro.get("ip_verificacao")
    if v in ("authentic", "forged", "unverifiable"):
        return v
    agente = (registro.get("agent_key") or "").strip().lower()
    ip = registro.get("remote_addr") if registro.get("remote_addr_forma") == "ip" else None
    if not agente or not ip:
        return "unverifiable"
    redes = (faixas or {}).get(agente)
    if not redes:
        return "unverifiable"
    return "authentic" if botagents.em_faixa(ip, redes) else "forged"


def area_de(path):
    partes = [p for p in path.split("/") if p]
    return partes[0] if partes else "raiz"


def radar_do_dia(root, dia, faixas, titulos):
    caminho = os.path.join(root, "data", "ops", "access", "nginx-%s.jsonl" % dia)
    if not os.path.isfile(caminho):
        return None
    por_agente = collections.Counter()
    por_area = collections.defaultdict(collections.Counter)
    por_pagina = collections.defaultdict(collections.Counter)
    markdown = collections.Counter()
    descontos = collections.Counter()
    nao_verificados = collections.Counter()
    for r in le_jsonl(caminho):
        if r.get("warming") or r.get("bot_simulation"):
            descontos["aquecimento_ou_simulacao"] += 1
            continue
        agente = (r.get("agent_key") or "").strip().lower()
        if not agente:
            continue  # humano ou UA nao identificado: fora do radar por construcao
        if r.get("route_class") not in ROTAS_DE_LEITURA:
            continue
        v = veredito(r, faixas)
        if v == "forged":
            descontos["forjado"] += 1
            continue
        if v == "unverifiable":
            nao_verificados[agente] += 1
            continue
        path = (r.get("path") or "").split("?")[0]
        if path.endswith("index.md"):
            markdown[agente] += 1
            path = path[: -len("index.md")]
        por_agente[agente] += 1
        por_area[agente][area_de(path)] += 1
        por_pagina[agente][path] += 1
    if not por_agente and not nao_verificados:
        return {"date": dia, "verificados": {}, "descontos": dict(descontos), "nao_verificados": dict(nao_verificados)}
    saida = {"date": dia, "verificados": {}, "descontos": dict(descontos),
             "nao_verificados_sem_faixa_publicada": dict(sorted(nao_verificados.items()))}
    for agente in sorted(por_agente):
        areas = por_area[agente].most_common(TOP_AREAS)
        paginas = por_pagina[agente].most_common(TOP_PAGINAS)
        saida["verificados"][agente] = {
            "leituras": por_agente[agente],
            "markdown": markdown[agente],
            "areas": [{"area": a, "leituras": n} for a, n in areas],
            "paginas": [{"path": p, "leituras": n, "titulo": titulos.get(p, "")} for p, n in paginas],
        }
    return saida


def titulos_do_acervo(root):
    t = {}
    try:
        with open(os.path.join(root, "content", "pages.json"), encoding="utf-8") as h:
            for p in json.load(h):
                if p.get("path") and p.get("title"):
                    t[p["path"]] = p["title"]
    except (OSError, json.JSONDecodeError):
        pass
    return t


def escreve(caminho, texto):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=os.path.dirname(caminho))
    with os.fdopen(fd, "w", encoding="utf-8") as h:
        h.write(texto)
    os.chmod(tmp, 0o644)
    os.replace(tmp, caminho)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=ROOT)
    ap.add_argument("--dias", type=int, default=7)
    ap.add_argument("--ate", default=None, help="ultimo dia (AAAA-MM-DD, padrao: hoje UTC)")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    faixas = botagents.ler_faixas(args.root)
    titulos = titulos_do_acervo(args.root)
    ultimo = dt.date.fromisoformat(args.ate) if args.ate else dt.datetime.now(dt.timezone.utc).date()
    dias = []
    for i in range(args.dias):
        d = (ultimo - dt.timedelta(days=i)).isoformat()
        r = radar_do_dia(args.root, d, faixas, titulos)
        if r is not None:
            dias.append(r)
    dias.sort(key=lambda x: x["date"])
    total = collections.Counter()
    for d in dias:
        for a, v in d["verificados"].items():
            total[a] += v["leituras"]
    saida = {
        "schema_version": SCHEMA,
        "gerado_em": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "janela_dias": args.dias,
        "metodo": "ledger do nginx da origem; identidade por faixa de IP publicada pelo operador (authentic); aquecimento, simulacao e UA forjado descontados; so leituras de pagina e Markdown do acervo; sem IP.",
        "total_por_agente": dict(total.most_common()),
        "dias": dias,
    }
    texto = json.dumps(saida, ensure_ascii=False, indent=1, sort_keys=True) + "\n"
    print("radar-ia: %d dia(s), verificados %s" % (len(dias), dict(total.most_common(6))))
    if args.dry_run:
        return 0
    escreve(os.path.join(args.root, "public", "datasets", "radar-ia.json"), texto)
    with open(os.path.join(args.root, "data", "ops", "radar_ia_daily.jsonl"), "a", encoding="utf-8") as h:
        for d in dias[-1:]:
            h.write(json.dumps({"schema_version": SCHEMA, "date": d["date"], "gerado_em": saida["gerado_em"],
                                "leituras_por_agente": {a: v["leituras"] for a, v in d["verificados"].items()},
                                "markdown_por_agente": {a: v["markdown"] for a, v in d["verificados"].items()},
                                "descontos": d["descontos"], "sha256": hashlib.sha256(texto.encode("utf-8")).hexdigest()},
                               ensure_ascii=False, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
