#!/usr/bin/env bash
# tools/generate-social-temas — ESCREVE (não é read-only).
#
# Semeia a tabela `temas` da rede social com as rotas públicas do acervo, lidas
# de data/editorial/published_manifest.jsonl. A prosa completa — por que a
# chave é o par (área, slug), por que a ferramenta é aditiva e por que o ensaio
# abre o banco somente para leitura — está no cabeçalho de
# cmd/generate-social-temas/main.go, que é onde o código mora.
#
# ★ O QUE ELE RESOLVE, medido em 2026-09-05 contra o banco de produção:
#
#   sqlite3 "file:var/social/social.db?mode=ro" "SELECT count(*) FROM temas;" → 0
#   data/editorial/published_manifest.jsonl                                   → 10.141 linhas
#
# Rede social com motor, telas e zero conteúdo: o feed nasceria vazio,
# `socialconteudo.BandaDeTemas` não teria o que oferecer e a rota de feed por
# tema responderia 404 para os 10.141 temas que já são páginas no ar.
#
# ★ ENSAIO É O PADRÃO. Sem `--aplicar` nada é escrito — nem no banco, nem na
# trilha. O ensaio abre o arquivo com `mode=ro` + `query_only(1)` e confere a
# trava depois de abrir; trava presumida não é trava.
#
#   ./tools/generate-social-temas                      # ensaio sobre tudo
#   ./tools/generate-social-temas --amostra 20         # probe curto, por passo determinístico
#   ./tools/generate-social-temas --aplicar            # semeia de verdade
#
# ★ IDEMPOTENTE: a segunda execução sobre o mesmo manifesto escreve ZERO
# linhas. Ela compara o espelho do banco com o manifesto e só chama
# `RegistrarTema` para o que é novo ou mudou de título/caminho.
#
# ★ ADITIVO: tema que sumiu do manifesto é RELATADO, nunca removido — apagá-lo
# levaria junto os follows que apontam para ele.
#
# ★ CUSTO MEDIDO, e por que a escrita é em lote. Semear os 10.141 temas num
# laço de `RegistrarTema` — uma transação por tema, um fsync por commit — levou
# 43,7 s (232 temas/s), com 3,8 s de CPU: o resto era espera de disco. Pelo lote
# do domínio (`socialconteudo.EspelharTemas`, transação única) a mesma semeadura
# leva 217 ms (46.774 temas/s), 0,76 s de ponta a ponta com a leitura do
# manifesto. Medido em 2026-09-05 sobre cópia do banco de produção, e confirmado
# no banco de produção: 10.141 temas em 239 ms (42.400 temas/s). Lentidão em
# 10k é defeito P0 aqui, e a correção é a forma da escrita, nunca um prazo maior.
#
# ★ O ENVELOPE. `run-heavy-throttled` exige de todo `./cmd/generate-*` o
# contrato de custo (orçamento, duração esperada, throughput e condição de
# parada) e evidência de tempo do próprio filho, por isso o `--timings` vai
# sempre. O throughput declarado abaixo (2.000 registros/s) é PISO conservador
# contra os 13.291 registros/s medidos de ponta a ponta — contrato de custo não
# é recorde. O número real de cada execução sai na linha TIMING e na trilha.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:social-temas:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-30000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=2000}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/social_temas_semeadura.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-social-temas}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/social_temas_semeadura.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-300}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-social-temas --timings "$@"
