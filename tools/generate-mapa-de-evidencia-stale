#!/usr/bin/env python3
"""generate-mapa-de-evidencia-stale — de qual GERADOR cada evidencia velha
precisa, derivado da varredura da bateria.

POR QUE ELE EXISTE. A primeira varredura completa da bateria (2026-09-10,
tools/generate-varredura-bateria-gates) mediu 487 gates por exit code real e
achou 149 reprovacoes de conteudo. As mensagens sao quase todas distintas — 146
textos para 149 gates —, entao nao ha familia por TEXTO e triar pela mensagem
nao agrupa nada.

A familia aparece no CODIGO de erro, que esta casa escreve em snake_case. Pelo
sufixo:

    stale     30   evidencia cuja FONTE mudou e ninguem regenerou
    mismatch  15   fingerprint divergente
    failed     9
    (resto disperso, 1 a 4 cada)

Os 30 `*_stale` sao UMA causa operacional, nao trinta: cada gate de evidencia
tem um gerador irmao (`check-X` <-> `generate-X`), e o irmao nao roda quando a
fonte muda. O gate diz corretamente "esta velho" e nao diz QUEM o rejuvenesce —
quem le precisa descobrir o par toda vez.

Este comando faz o pareamento e imprime o comando exato. READ-ONLY: ele NAO
roda gerador nenhum. Regenerar evidencia e decisao de quem conhece o custo —
ha geradores aqui que levam minutos e tocam rede.

MEDIDO NA PRIMEIRA PASSADA: 21 dos 30 tem irmao exato; 9 nao tem, e esses sao
o achado. Gate de evidencia sem produtor e evidencia que so envelhece: ou o
produtor tem outro nome (e o pareamento por nome nao alcanca), ou nao existe e
alguem regenerou a mao uma vez.

Uso:
    tools/generate-mapa-de-evidencia-stale <varredura.jsonl>
    tools/generate-mapa-de-evidencia-stale <varredura.jsonl> --json
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

# O codigo de erro desta casa: snake_case com pelo menos tres segmentos.
# Dois segmentos casariam palavra comum ("no_such", "not_found") e o primeiro
# codigo da saida e sempre o que anuncia a causa.
CODIGO_DE_ERRO = re.compile(r"\b([a-z][a-z0-9]*(?:_[a-z0-9]+){2,})\b")


def familia_do_codigo(codigo: str) -> str:
    """O SUFIXO e a familia: `*_source_fingerprint_stale`, `*_input_stale` e
    `*_live_metrics_stale` sao o mesmo problema com nomes diferentes."""
    return codigo.rsplit("_", 1)[-1]


def codigo_da_cauda(cauda: str) -> str:
    achados = CODIGO_DE_ERRO.findall(cauda or "")
    return achados[0] if achados else ""


def candidatos_de_gerador(gate: str) -> list[str]:
    """Os nomes que o produtor pode ter, na ordem em que a casa os usa.

    `check-X` <-> `generate-X` e a convencao majoritaria, mas NAO e a unica, e
    supor que fosse produziu um falso negativo medido em 2026-09-10:

        check-html-minify  ->  tools/generate-html-minify-evidence   (existe)

    Classificar esse gate como "sem produtor" mandaria alguem escrever um
    gerador que ja existe. As tres formas abaixo cobrem o que o repositorio de
    fato faz; o pareamento continua sendo por NOME, e por isso a lista dos que
    nao casam sai impressa em vez de virar zero — nome nao e prova, e produtor
    com nome de terceira familia so aparece lendo quem escreve o artefato.
    """
    nome = gate[len("check-"):] if gate.startswith("check-") else gate
    formas = [nome]
    if nome.endswith("-evidence"):
        formas.append(nome[: -len("-evidence")])
    else:
        formas.append(nome + "-evidence")
    # QUARTA FORMA, medida em 2026-09-11: o gate nomeia a QUALIDADE que afere e
    # o produtor nomeia a EVIDENCIA que grava.
    #
    #     check-ptbr-confusables-quality -> tools/generate-ptbr-confusables-evidence
    #
    # As tres formas anteriores classificavam esse gate como "sem produtor", e
    # quem lesse o mapa escreveria um gerador que ja existe — o dano exato que
    # esta funcao existe para evitar, repetido numa familia que ela ainda nao
    # conhecia. O sufixo `-quality` sai e as duas formas com e sem `-evidence`
    # voltam a ser testadas.
    if nome.endswith("-quality"):
        base = nome[: -len("-quality")]
        formas.append(base + "-evidence")
        formas.append(base)
    return ["tools/generate-" + f for f in formas]


def gerador_irmao(gate: str) -> str:
    """O primeiro candidato que EXISTE no disco; se nenhum existe, o candidato
    canonico, para que a mensagem diga qual nome faltou."""
    candidatos = candidatos_de_gerador(gate)
    for candidato in candidatos:
        if (RAIZ / candidato).exists():
            return candidato
    return candidatos[0]


def monta(linhas: list, familia_alvo: str = "stale") -> dict:
    com, sem = [], []
    # codigo de erro -> gerador que ja foi pareado por nome para ele.
    produtor_do_codigo: dict[str, str] = {}
    reprovacoes = 0
    por_familia: dict[str, int] = {}
    for registro in linhas:
        if registro.get("exit") != 1:
            continue
        reprovacoes += 1
        codigo = codigo_da_cauda(registro.get("tail"))
        if not codigo:
            continue
        familia = familia_do_codigo(codigo)
        por_familia[familia] = por_familia.get(familia, 0) + 1
        if familia != familia_alvo:
            continue
        gate = registro["gate"]
        irmao = gerador_irmao(gate)
        if (RAIZ / irmao).exists():
            com.append({"gate": gate, "codigo": codigo, "gerador": irmao,
                        "pareado_por": "nome"})
            produtor_do_codigo.setdefault(codigo, irmao)
        else:
            sem.append({"gate": gate, "codigo": codigo, "gerador": irmao})
    # SEGUNDA PASSADA, POR CODIGO DE ERRO. Dois gates que reprovam pelo MESMO
    # codigo leem a MESMA evidencia, e quem a produz e um so — o par
    # `check-X` / `check-X-release` e o caso tipico. Parear por codigo alcanca
    # o que o nome nao alcanca, e nao e suposicao: o codigo identifica o
    # artefato, que e exatamente o que se quer rejuvenescer.
    #
    # A passada e SEGUNDA de proposito: o pareamento por nome e mais forte
    # (nomeia o produtor daquele gate), e so o que sobra dele e resolvido aqui.
    ainda_sem = []
    for item in sem:
        herdado = produtor_do_codigo.get(item["codigo"])
        if herdado:
            com.append({**item, "gerador": herdado, "pareado_por": "codigo"})
        else:
            ainda_sem.append(item)
    sem = ainda_sem
    return {
        "schema": "mapa_de_evidencia_stale_v1",
        "familia": familia_alvo,
        "gates_medidos": len(linhas),
        "reprovacoes_exit_1": reprovacoes,
        "por_familia": dict(sorted(por_familia.items(), key=lambda kv: -kv[1])),
        "com_gerador_irmao": com,
        "sem_gerador_irmao": sem,
    }


def main() -> int:
    interpretador = argparse.ArgumentParser(description=__doc__)
    interpretador.add_argument("varredura", help="JSONL de generate-varredura-bateria-gates")
    interpretador.add_argument("--familia", default="stale",
                               help="sufixo do codigo de erro a mapear (padrao: stale)")
    interpretador.add_argument("--json", action="store_true", help="saida em JSON")
    argumentos = interpretador.parse_args()

    caminho = Path(argumentos.varredura)
    if not caminho.exists():
        print("mapa-de-evidencia-stale: %s nao existe" % caminho, file=sys.stderr)
        return 2
    linhas = [json.loads(l) for l in caminho.read_text(encoding="utf-8").splitlines() if l.strip()]
    if not linhas:
        print("mapa-de-evidencia-stale: varredura vazia", file=sys.stderr)
        return 2

    mapa = monta(linhas, argumentos.familia)
    if argumentos.json:
        print(json.dumps(mapa, ensure_ascii=False, sort_keys=True))
        return 0

    # CARDINALIDADE ANTES DA AMOSTRA.
    print("varredura: %d gate(s) medido(s), %d reprovacao(oes) exit 1"
          % (mapa["gates_medidos"], mapa["reprovacoes_exit_1"]))
    print("familias (sufixo do codigo de erro): %s"
          % ", ".join("%s=%d" % (f, n) for f, n in list(mapa["por_familia"].items())[:6]))
    print()
    print("familia '%s': %d com gerador irmao, %d SEM"
          % (mapa["familia"], len(mapa["com_gerador_irmao"]), len(mapa["sem_gerador_irmao"])))
    print()
    if mapa["com_gerador_irmao"]:
        print("  rejuvenesce com o irmao:")
        for item in mapa["com_gerador_irmao"]:
            print("    %-46s ./%s" % (item["gate"][:46], item["gerador"]))
    if mapa["sem_gerador_irmao"]:
        print()
        print("  SEM PRODUTOR PAREADO — evidencia que so envelhece:")
        for item in mapa["sem_gerador_irmao"]:
            print("    %-46s (%s)" % (item["gate"][:46], item["codigo"][:40]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
