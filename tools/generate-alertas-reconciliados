LEDGER = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data/ops/owner_alerts.jsonl")


def ultima_linha_por_chave():
    """Estado por chave segundo o LEDGER — a ultima linha vence, nunca a contagem.

    Mesma leitura que tools/check-owner-alerts-abertos faz, e de proposito: o
    reconciliador tem de enxergar exatamente o conjunto que o consumidor cobra,
    senao um reprova pelo que o outro nao ve.
    """
    ultimo = {}
    try:
        with open(LEDGER, encoding="utf-8") as arquivo:
            for linha in arquivo:
                try:
                    evento = json.loads(linha)
                except ValueError:
                    continue
                chave = evento.get("chave")
                if chave:
                    ultimo[chave] = evento
    except OSError:
        return {}
    return ultimo


def verificador_de(chave):
    """Resolve o verificador da chave, DERIVANDO o das units pelo nome.

    O mapa acima listava `unit-falhou-*` uma a uma, e foi assim que o buraco
    apareceu: em 2026-09-03 as chaves de `wikijuridica-crawler-error-budget` e
    `wikijuridica-disk-headroom` estavam abertas ha 27 h e 44 h com as duas
    units OK — nenhuma das duas constava do mapa, entao o reconciliador as
    classificava como "sem criterio" e nao as tocava. Cada unit nova do
    repositorio abriria o mesmo buraco de novo.
    
    A chave `unit-falhou-<nome>` ja CARREGA a unit no proprio nome — quem a
    emite (tools/check-units-alarme) a monta assim. Derivar dai fecha a familia
    inteira de uma vez, e uma entrada explicita no mapa continua tendo
    precedencia, para o caso de alguma unit precisar de criterio proprio.
    """
    explicito = VERIFICADORES.get(chave)
    if explicito is not None:
        return explicito
    if chave.startswith("unit-falhou-"):
        nome = chave[len("unit-falhou-"):]
        if nome and "/" not in nome and ".." not in nome:
            return v_unit(nome if nome.endswith(".service") else nome + ".service")
    # A familia do tunel tem UM criterio para todas as classes: o vigia so abre
    # qualquer uma delas dentro de `if degradado:`, entao o inverso e o mesmo
    # para as quatro. Classe nova em check-tunnel-health ja nasce reconciliavel.
    if chave.startswith("tunel-"):
        return v_tunel
    return None


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--ensaio", action="store_true", help="mostra sem aplicar")
    args = ap.parse_args()

    try:
        with open(ESTADO, encoding="utf-8") as fh:
            estado = json.load(fh)
    except OSError as erro:
        # Ledger ausente é anomalia, não estado inicial: o canal grava desde
        # julho. Falhar alto, nunca aprovar por ausência de dado.
        print(f"estado de alertas ilegivel em {ESTADO}: {erro}", file=sys.stderr)
        return 2

    abertas = {k: v for k, v in estado.items() if isinstance(v, dict) and v.get("aberto")}
    # E TAMBEM as que o LEDGER mostra abertas, que e a fonte que o consumidor
    # cobra. Medido em 2026-09-03: o estado trazia 1 chave aberta e o ledger 7 —
    # `unit-falhou-wikijuridica-crawler-error-budget`,
    # `unit-falhou-wikijuridica-disk-headroom`, `onda-diaria`,
    # `untracked-produto-esquecido` e outras duas apareciam so no ledger. O
    # `check-owner-alerts-abertos` reprovava por elas e este reconciliador nem
    # as via, entao ninguem nunca as fechava: duas ficaram 27 h e 44 h abertas
    # com a condicao ja curada.
    #
    # A CAUSA e que as duas fontes tem durabilidades diferentes: o estado e um
    # JSON reescrito a cada envio (e chave podada some), o ledger e append-only.
    # Reconciliar contra a fonte mais fraca deixava a mais forte acumulando
    # divida. Aqui elas se juntam, e o estado tem precedencia quando as duas
    # conhecem a chave, porque ele carrega `ocorrencias` e `aberto_desde`.
    for chave, ultimo in ultima_linha_por_chave().items():
        if chave in abertas or ultimo.get("resolvido"):
            continue
        abertas[chave] = {
            "aberto": True,
            "aberto_desde": ultimo.get("aberto_desde") or ultimo.get("alertado_em"),
            "severidade": ultimo.get("severidade"),
            "ocorrencias": ultimo.get("ocorrencias", 0),
        }
    if not abertas:
        print("reconciliador: nenhuma chave aberta")
        return 0

    fechadas, mantidas, sem_criterio = [], [], []
    for chave, registro in sorted(abertas.items()):
        verificador = verificador_de(chave)
        if verificador is None:
            sem_criterio.append(chave)
            continue
        curada, evidencia = verificador()
        if curada is not True:
            mantidas.append((chave, evidencia))
            continue
        print(f"reconciliador: {chave} — condicao curada ({evidencia})")
        if not args.ensaio:
            subprocess.run(
                [NOTIFY, "--chave", chave, "--resolvido",
                 "--titulo", f"{chave}: condicao normalizada",
                 "--mensagem", f"fechado por reconciliacao com a serie viva: {evidencia}"[:400]],
                check=False, timeout=60,
            )
        fechadas.append(chave)

    print(f"reconciliador: fechadas={len(fechadas)} mantidas={len(mantidas)} sem_criterio={len(sem_criterio)}")
    for chave, evidencia in mantidas:
        print(f"  MANTIDA  {chave}: {evidencia}")
    for chave in sem_criterio:
        print(f"  SEM CRITERIO (intocada) {chave}")
    return 0


