RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ESTADO = os.path.join(RAIZ, "data/ops/owner_alerts_state.json")
NOTIFY = os.path.join(RAIZ, "tools/notify-owner")

AMOSTRAS_SAUDAVEIS = 3  # transitório não fecha alerta; três seguidas, sim


def ultimas_linhas(rel, n):
    caminho = os.path.join(RAIZ, rel)
    try:
        with open(caminho, encoding="utf-8") as fh:
            linhas = fh.readlines()
    except OSError:
        return []
    saida = []
    for linha in linhas[-n:]:
        linha = linha.strip()
        if not linha:
            continue
        try:
            saida.append(json.loads(linha))
        except ValueError:
            continue
    return saida


def unit_saudavel(unit):
    """Result=success e ActiveState fora de failed, lido do systemd."""
    try:
        saida = subprocess.run(
            ["systemctl", "show", unit, "-p", "Result", "-p", "ActiveState"],
            capture_output=True, text=True, timeout=20, check=False,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None, "systemctl indisponivel"
    campos = dict(l.split("=", 1) for l in saida.strip().splitlines() if "=" in l)
    ok = campos.get("Result") == "success" and campos.get("ActiveState") != "failed"
    return ok, f"Result={campos.get('Result')} ActiveState={campos.get('ActiveState')}"


def v_borda_origem():
    eventos = ultimas_linhas("data/ops/edge_live.jsonl", AMOSTRAS_SAUDAVEIS)
    if len(eventos) < AMOSTRAS_SAUDAVEIS:
        return None, "serie curta demais para concluir"
    ok = all(e.get("ok") is True for e in eventos)
    return ok, f"ultimos {len(eventos)} eventos de edge_live: ok={[e.get('ok') for e in eventos]}"


def v_portal_degradado():
    eventos = ultimas_linhas("data/ops/portal_health.jsonl", AMOSTRAS_SAUDAVEIS)
    if len(eventos) < AMOSTRAS_SAUDAVEIS:
        return None, "serie curta demais para concluir"
    ok = all(not e.get("problems") and not e.get("problemas") for e in eventos)
    return ok, f"ultimos {len(eventos)} de portal_health sem problemas: {ok}"


def v_untracked():
    exe = os.path.join(RAIZ, "tools/check-untracked-product-inventory")
    if not os.access(exe, os.X_OK):
        return None, "gate ausente"
    try:
        rc = subprocess.run([exe], capture_output=True, text=True, timeout=180, check=False).returncode
    except (OSError, subprocess.SubprocessError):
        return None, "gate nao executou"
    return rc == 0, f"check-untracked-product-inventory exit={rc}"


def v_unit(unit):
    return lambda: unit_saudavel(unit)


# ★ AS TRÊS CHAVES QUE FICAVAM ABERTAS PARA SEMPRE (2026-08-29, BUG-018)
#
# O reconciliador nasceu fechando o que tinha critério e deixando o resto
# INTOCADO — decisão certa, porque fechar sem critério é pior que não fechar.
# Mas três chaves nunca ganharam critério, e ficar aberto para sempre tem o
# mesmo efeito que o alerta falso: o dono aprende a ignorar o canal, e o alerta
# verdadeiro chega no meio do ruído. Cada uma abaixo fecha por evidência da
# série viva, nunca por tempo decorrido.


def v_onda_diaria():
    """Fecha quando a última execução COMPLETA da onda não reprovou etapa.

    A série `daily_content_runs.jsonl` grava uma linha por execução, com
    `resultado` e `falhas`. `resultado: "parcial"` com `falhas: ["publicacao"]`
    é exatamente o estado que abre o alerta — então o critério de fecho é o
    inverso, lido do mesmo campo que o abriu.

    ★ ENSAIO NÃO FECHA ALERTA (2026-08-29, achado do crítico adversarial).

    A primeira versão lia UMA linha, apoiada em "a onda roda uma vez por dia".
    Duas coisas derrubaram isso, e as duas foram medidas no dado vivo:

      - `--seco` sai no passo 2/9, ANTES de preservação, commit e publicação, e
        o trap grava a linha do mesmo jeito, com `resultado: "ok"`. Um ensaio
        rodado por qualquer motivo fecharia o alerta de uma publicação que nunca
        aconteceu.
      - "uma vez por dia" é falso: 2026-08-26 tem NOVE execuções, seis
        `parcial` com famílias de falha distintas e três `ok`.

    O produtor passou a declarar `escopo` (`completa`/`ensaio`), e este
    verificador só olha linha `completa`. Linha antiga não tem o campo — e
    ausência é tratada como "não sei", nunca como "completa": chave sem
    evidência fica ABERTA, que é o lado seguro para um canal de alerta.
    """
    linhas = ultimas_linhas("data/ops/daily_content_runs.jsonl", 40)
    if not linhas:
        return None, "serie de execucoes da onda ausente ou vazia"
    completas = [x for x in linhas if str(x.get("escopo") or "").lower() == "completa"]
    if not completas:
        return None, (
            "nenhuma execucao COMPLETA na serie recente; linha sem o campo `escopo` "
            "e anterior a 2026-08-29 e nao prova publicacao"
        )
    ultima = completas[-1]
    falhas = ultima.get("falhas")
    # `falhas` e uma lista JSON em todas as 100% das linhas do ledger vivo
    # (medido: `{type(json.loads(l)['falhas']).__name__}` devolve `{'list'}`),
    # e o produtor sempre serializa lista. O ramo de string abaixo NAO descreve
    # um formato observado -- ele existe porque tratar so a lista faria uma
    # string nao-vazia parecer ausencia de falha, e o custo de mante-lo e uma
    # linha. A primeira versao deste comentario afirmava que o produtor gravava
    # `str(lista)` "em algumas passadas": isso era afirmacao sem medicao, e o
    # dado a refuta.
    if isinstance(falhas, str):
        houve_falha = falhas.strip() not in ("", "[]", "None")
    else:
        houve_falha = bool(falhas)
    resultado = str(ultima.get("resultado") or "").lower()
    ok = not houve_falha and resultado not in ("parcial", "falha", "erro")
    return ok, (
        f"ultima onda COMPLETA {ultima.get('data')}: resultado={resultado!r} "
        f"falhas={falhas!r} (de {len(linhas)} execucoes recentes, {len(completas)} completas)"
    )


def serie_fresca(rel, horas):
    """A série foi atualizada nas últimas `horas`? (None quando não dá para saber)

    ★ POR QUE EXISTE (2026-08-29, achado do crítico adversarial).

    Verificador que só pergunta "o gate passou?" fecha alerta por DADO MORTO: se
    o produtor da série parar, o gate avalia um fóssil, passa, e a chave fecha
    justamente quando a observabilidade morreu. É o mesmo formato do gate que
    aprovava com o manifesto vazio — aprovar por ausência de evidência.
    """
    caminho = os.path.join(RAIZ, rel)
    try:
        idade_h = (time.time() - os.path.getmtime(caminho)) / 3600.0
    except OSError:
        return None, f"{rel} ausente"
    return idade_h <= horas, f"{rel} atualizada ha {idade_h:.1f}h (teto {horas}h)"


def v_bot_abandono():
    """Fecha quando o próprio gate de abandono volta a passar, com dado FRESCO.

    Mesmo padrão de `v_untracked`: quem decide se a condição se curou é o
    detector que a abriu, não uma segunda leitura da série que poderia
    divergir dele. `exit 1` significa "há bot valioso em queda" e mantém aberto.

    Duas guardas que a primeira versão não tinha, ambas fail-open apanhadas pelo
    crítico: o gate sai 0 com o estado PRESENTE E VAZIO (`agentes: {}`), isto é,
    fecha o alerta quando a observabilidade morreu; e nada exigia frescor, então
    série parada há uma semana fechava a chave.
    """
    fresca, motivo = serie_fresca("data/ops/bot_return_state.json", 48)
    if fresca is not True:
        return None, f"nao da para concluir: {motivo}"
    try:
        with open(os.path.join(RAIZ, "data/ops/bot_return_state.json"), encoding="utf-8") as fh:
            estado = json.load(fh)
    except (OSError, ValueError) as erro:
        return None, f"estado de retorno de bot ilegivel: {erro}"
    if not estado.get("agentes"):
        return None, "estado de retorno de bot PRESENTE e VAZIO — observabilidade morta, nao cura"
    exe = os.path.join(RAIZ, "tools/check-bot-abandonment")
    if not os.access(exe, os.X_OK):
        return None, "gate ausente"
    try:
        rc = subprocess.run([exe], capture_output=True, text=True, timeout=300, check=False).returncode
    except (OSError, subprocess.SubprocessError):
        return None, "gate nao executou"
    return rc == 0, f"check-bot-abandonment exit={rc}; {motivo}"


def v_rede():
    """Fecha quando a rede local sai de degradada em N amostras seguidas.

    Aqui N amostras importam, ao contrário da onda: a sonda de rede roda muitas
    vezes ao dia e um único ciclo bom pode ser trégua entre duas quedas. É a
    mesma régua de `v_borda_origem`.
    """
    fresca, motivo = serie_fresca("data/ops/network_health.jsonl", 6)
    if fresca is not True:
        # Sonda morta com tres linhas antigas e limpas fecharia a chave. Frescor
        # antes de conteudo: sem sonda viva nao ha o que concluir.
        return None, f"nao da para concluir: {motivo}"
    eventos = ultimas_linhas("data/ops/network_health.jsonl", AMOSTRAS_SAUDAVEIS)
    if len(eventos) < AMOSTRAS_SAUDAVEIS:
        return None, "serie curta demais para concluir"
    ok = all(not e.get("degradado") and not e.get("problemas") for e in eventos)
    return ok, f"ultimos {len(eventos)} de network_health sem degradacao: {ok}; {motivo}"


def v_tunel():
    """Fecha a família `tunel-*` quando a saúde viva diz que o túnel está inteiro.

    ★ POR QUE ESTAS CHAVES FICAVAM ABERTAS PARA SEMPRE (2026-09-05)

    `check-tunnel-health` resolve a chave num `elif anterior.get("degradado")`:
    só há resolução se a execução ANTERIOR tiver visto degradação. Basta o
    estado do vigia se perder (arquivo novo, reinício, ciclo pulado) entre o
    ciclo ruim e o bom para que a transição nunca seja observada — e a chave
    fica aberta com o túnel medido saudável no mesmo instante.

    Medido em 2026-09-05: `tunel-uplink`, severidade CRÍTICA, aberta desde
    2026-09-04T13:33 e sem um único envio novo desde então, enquanto
    `tunnel_health.jsonl` gravava a cada ~35 s `frota_vivas 5, frota_total 5,
    ha_connections 4, degradado false, problemas []`. Alerta stale, não
    incidente — exatamente o formato do `borda-origem` que fez este
    reconciliador existir.

    O CRITÉRIO É O INVERSO DO QUE ABRE, lido do mesmo campo: o vigia alerta
    dentro de `if degradado:`, e `degradado = bool(problemas)` na origem. Por
    isso aqui se exige `degradado is False` E `problemas` vazio — as duas
    leituras do mesmo fato, para que um produtor que gravasse uma sem a outra
    não fechasse a chave por meia evidência.

    Frescor de 1 h porque a série é escrita a cada ~35 s: mais que isso já é
    sonda morta, e gate que aprova fóssil fecha alerta justamente quando a
    observabilidade morreu.
    """
    fresca, motivo = serie_fresca("data/ops/tunnel_health.jsonl", 1)
    if fresca is not True:
        return None, f"nao da para concluir: {motivo}"
    eventos = ultimas_linhas("data/ops/tunnel_health.jsonl", AMOSTRAS_SAUDAVEIS)
    if len(eventos) < AMOSTRAS_SAUDAVEIS:
        return None, "serie curta demais para concluir"
    ok = all(e.get("degradado") is False and not e.get("problemas") for e in eventos)
    resumo = "; ".join(
        f"{e.get('checked_at')}: degradado={e.get('degradado')} "
        f"frota={e.get('frota_vivas')}/{e.get('frota_total')} "
        f"ha={e.get('ha_connections')} problemas={e.get('problemas')}"
        for e in eventos)
    return ok, f"ultimos {len(eventos)} de tunnel_health: {resumo}; {motivo}"


