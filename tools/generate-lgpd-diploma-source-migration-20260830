#!/usr/bin/env python3
"""generate-lgpd-diploma-source-migration-20260830 — migra ao texto COMPILADO só a
citação da LGPD que aponta para o diploma inteiro.

POR QUE ELE EXISTE, e por que ele NÃO migra tudo. Medido em 2026-08-30, baixando
os dois documentos do Planalto com os cabeçalhos que `tools/generate-legal-corpus`
já usa:

    l13709.htm          -> 357 âncoras, 351 de artigo (#art5, #art18, #art19, …)
    l13709compilado.htm ->   2 âncoras, ZERO de artigo

O estoque cita a LGPD 236 vezes: **175 com âncora de artigo** e **61 sem**. Migrar
em bloco — que era o remédio que o gate `lgpd_legacy_uncompiled_statute_path`
prescrevia — jogaria as 175 no topo de um documento de 230 KB e destruiria o
deep-link, que é o que dá precisão verificável à citação jurídica. Essas ficam
onde estão, e `internal/v2ingest` passou a aceitá-las.

As 61 sem âncora são outra história: ali não há o que perder, e o compilado É o
correto, porque a Lei 13.709/2018 foi alterada pela 13.853/2019 e seguintes e o
texto original não carrega essas alterações. São essas, e só essas, que este
gerador move.

O QUE ELE NÃO FAZ: não inventa verificação. O documento compilado é baixado UMA
vez, o sha256 dele entra na evidência, e `verified_at` recebe a data em que essa
requisição de fato aconteceu. Entrada que já esteja no compilado fica intacta.

Uso:
    ./tools/generate-lgpd-diploma-source-migration-20260830 --seco
    ./tools/generate-lgpd-diploma-source-migration-20260830
"""
from __future__ import annotations

import argparse
import datetime
import glob
import gzip
import hashlib
import json
import os
import urllib.parse
import urllib.request

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SUPERSEDED_DIR = "data/editorial/v2_superseded"
SUPERSESSION_RECORD_TYPE = "v2_duplicate_intent_supersession"
LEGADA_PATH = "/ccivil_03/_ato2015-2018/2018/lei/l13709.htm"
COMPILADA = "https://www.planalto.gov.br/ccivil_03/_ato2015-2018/2018/lei/l13709compilado.htm"
EVIDENCIA = os.path.join(RAIZ, "data/source-audit/lgpd_diploma_source_migration_20260830.jsonl")

NAVEGADOR = {
    # Os mesmos cabeçalhos de tools/generate-legal-corpus — inclusive o defeito,
    # que veio copiado junto e foi corrigido nos dois em 2026-09-05. O Planalto
    # rejeita requisição sem cabeçalhos, e isso é verdade; que ele exija um
    # DISFARCE de navegador não era: medido contra a URL exata que este arquivo
    # baixa, o UA canônico devolveu 200. Ao sair para a rede o portal é o
    # WikijuridicaBot, e o prefixo `Mozilla/5.0 (compatible;` é o que o WAF pede.
    "User-Agent": ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
                   "+https://wikijuridica.com.br/bot/; migracao de fonte de diploma)"),
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "pt-BR,pt;q=0.9",
    "Accept-Encoding": "gzip, deflate",
}


def ancora_de_artigo(fragmento: str) -> bool:
    """Espelha internal/v2ingest.lgpdFragmentoEAncoraDeArtigo, byte a byte."""
    f = fragmento.strip().lower()
    return f.startswith("art") and len(f) > 3 and f[3].isdigit()


def intencoes_congeladas() -> set[str]:
    """As intenções preservadas em archive de supersessão NÃO se tocam.

    O contrato está em `internal/v2officialsourcestamp/supersession_frozen.go:20`:
    toda linha de archive preserva os bytes exatos de um registro do estoque, e o
    audit exige do registro vivo igualdade byte a byte OU proveniência de sucessor
    durável. Um carimbo escrito por fora muda os bytes SEM criar proveniência, e o
    resultado é `active_source_changed_without_provenance` — o ingest inteiro
    aborta.

    Isto já aconteceu duas vezes: em 2026-08-04 com `gloss-dolo-eventual-culpa-consciente`
    e `gloss-certidao-onus-reais`, e AGORA, na primeira execução deste gerador, com
    `gloss-dados-de-criancas` — o `reference-transaction` recusou o commit e a
    linha foi restaurada byte a byte. Congelar demais é seguro: a fonte fica sem
    migrar e a página segue no estado que já tinha. Descongelar de menos é o bug.
    """
    congeladas: set[str] = set()
    diretorio = os.path.join(RAIZ, SUPERSEDED_DIR)
    if not os.path.isdir(diretorio):
        return congeladas
    for nome in sorted(os.listdir(diretorio)):
        if not nome.endswith(".jsonl"):
            continue
        for linha in open(os.path.join(diretorio, nome), encoding="utf-8"):
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            if registro.get("record_type") != SUPERSESSION_RECORD_TYPE:
                continue
            intent = registro.get("intent_id")
            original = registro.get("original_line")
            if not intent and isinstance(original, str):
                intent = json.loads(original).get("intent_id")
            elif not intent and isinstance(original, dict):
                intent = original.get("intent_id")
            if intent:
                congeladas.add(intent)
    return congeladas


def baixa_compilado() -> tuple[int, str, int]:
    pedido = urllib.request.Request(COMPILADA, headers=NAVEGADOR)
    with urllib.request.urlopen(pedido, timeout=45) as resposta:
        dados = resposta.read()
        if resposta.headers.get("Content-Encoding") == "gzip":
            dados = gzip.decompress(dados)
        return resposta.status, hashlib.sha256(dados).hexdigest(), len(dados)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--seco", action="store_true", help="mostra o que mudaria, sem escrever")
    args = parser.parse_args()

    status, sha, tamanho = baixa_compilado()
    if status != 200 or tamanho <= 0:
        print(f"REPROVADO: o compilado respondeu {status} com {tamanho} bytes; nada foi migrado")
        return 1
    agora = datetime.datetime.now(datetime.timezone.utc)
    hoje = agora.date().isoformat()
    print(f"compilado : HTTP {status}, {tamanho} bytes, sha256:{sha[:16]}…")

    congeladas = intencoes_congeladas()
    print(f"congeladas : {len(congeladas)} intencao(oes) em archive de supersessao, intocaveis")

    trocas: list[dict] = []
    puladas: list[str] = []
    por_arquivo: dict[str, list[str]] = {}
    for caminho in sorted(glob.glob(os.path.join(RAIZ, "data/editorial/v2_pages/*.jsonl"))):
        linhas = open(caminho, encoding="utf-8").read().splitlines()
        mudou = False
        for indice, linha in enumerate(linhas):
            if "l13709.htm" not in linha:
                continue
            registro = json.loads(linha)
            if registro.get("intent_id") in congeladas:
                puladas.append(registro.get("intent_id"))
                continue
            alterou_registro = False
            for fonte in registro.get("official_sources") or []:
                partes = urllib.parse.urlparse((fonte.get("url") or "").strip())
                if partes.path.lower() != LEGADA_PATH or ancora_de_artigo(partes.fragment):
                    continue
                antes = fonte["url"]
                fonte["url"] = COMPILADA + (("#" + partes.fragment) if partes.fragment else "")
                fonte["verified_at"] = hoje
                fonte["http_status"] = status
                alterou_registro = True
                trocas.append({
                    "intent_id": registro.get("intent_id"),
                    "arquivo": os.path.relpath(caminho, RAIZ),
                    "de": antes,
                    "para": fonte["url"],
                })
            if alterou_registro:
                linhas[indice] = json.dumps(registro, ensure_ascii=False)
                mudou = True
        if mudou:
            por_arquivo[caminho] = linhas

    if puladas:
        print(f"puladas por congelamento: {len(puladas)} -> {sorted(set(puladas))}")
    print(f"citacoes ao diploma a migrar: {len(trocas)} em {len(por_arquivo)} shard(s)")
    for t in trocas:
        print(f"  {t['intent_id']}: {t['de'].rsplit('/', 1)[-1]} -> {t['para'].rsplit('/', 1)[-1]}")
    if args.seco:
        print("(--seco: nada foi escrito)")
        return 0
    if not trocas:
        return 0

    for caminho, linhas in por_arquivo.items():
        with open(caminho, "w", encoding="utf-8") as fh:
            fh.write("\n".join(linhas) + "\n")
    os.makedirs(os.path.dirname(EVIDENCIA), exist_ok=True)
    with open(EVIDENCIA, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "schema_version": "lgpd_diploma_source_migration_v1",
            "ferramenta": "tools/generate-lgpd-diploma-source-migration-20260830",
            "migrado_em": agora.isoformat(),
            "compilado_url": COMPILADA,
            "compilado_http_status": status,
            "compilado_sha256": f"sha256:{sha}",
            "compilado_bytes": tamanho,
            "trocas": trocas,
        }, ensure_ascii=False) + "\n")
    print(f"evidencia: {os.path.relpath(EVIDENCIA, RAIZ)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
