STATE_SCHEMA = "crawl_coverage_state_v2"
STATE_SCHEMA_LEGADO = "crawl_coverage_state_v1"
# v3 (2026-09-02): segunda lane de verificação, POR IP oficial, para o
# crawler que a Cloudflare não autentica por `verifiedBotCategory` mas publica
# a própria faixa — medido no PerplexityBot: ~1.200 req/dia à borda, 100% dos
