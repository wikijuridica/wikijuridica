# populações diferentes sem dizer.
SERIE_SCHEMA = "crawl_coverage_daily_v3"
ZONE_TAG = "b2e1366a94c5dcac97f2fc264f18928f"

# Rótulo do método de identidade gravado em cada linha nova. É o vocabulário
# que `check-bot-telemetry-honesty` reconhece como "produtor corrigido rodou".
IDENTIDADE = "cloudflare_verified_bot_category"
IDENTIDADE_IP_RANGE = "ip_range_at_edge"
IDENTIDADE_CLOUDFLARE_E_IP_RANGE = "cloudflare_and_ip_range"
# Rótulo do que ficou para trás. O acumulado por UA NÃO é apagado (o ledger e o
# estado são registro de trabalho, não rascunho) — ele é CONGELADO e marcado,
# para servir de contraste ao número honesto.
IDENTIDADE_LEGADA = "user_agent_unverified"

# TETO DE ENDEREÇOS EXPANDIDOS POR CRAWLER, antes de montar `clientIP_in`. Sem
# ele, expandir a faixa oficial do Googlebot (317 prefixos, muitos /64 IPv6)
# tentaria iterar ~2,7×10^21 endereços — trava a ferramenta, não a API. Medido
