#!/usr/bin/env python3
"""measure-revogacao-expressa-nao-fechada — mede, sobre o corpus-oráculo REAL,
os dispositivos cuja cabeça textual declara revogação expressa e cujo registro
ainda afirma vigência, separando-os pela qualidade jurídica da data.

POR QUE ESTA MEDIÇÃO EXISTE (2026-09-05)

O gate `source-snapshot-corpus` acusa `source_snapshot_revoked_head_marked_vigente`
e devolve só a CONTAGEM. Contagem não sustenta decisão jurídica: para decidir é
preciso saber, dispositivo a dispositivo, o que o texto oficial diz — qual norma
revogou, em que data, e se a própria fonte declara efeito diferido.

A distinção que decide tudo, e que a política de `cmd/collect-oracle/revogacao.go`
já fixa:

  - marcador com data direta      -> a vigência pode ser fechada com a data que a
                                     consolidação oficial imprime;
  - marcador com vacatio declarada -> NÃO fecha. "Em vigor 90 dias após",
                                     "após 1 ano da publicação": a data do ato não
                                     é a data em que a revogação produziu efeito, e
                                     `ResolveAsOf` usa essa janela. Errar um dia é
                                     afirmar data falsa. Fail-closed, lacuna
                                     declarada em vez de data inventada.

FUNDAMENTO. LINDB (Decreto-Lei 4.657/1942), art. 2º, §1º: a lei posterior revoga a
anterior quando expressamente o declare. A nota de revogação no texto consolidado
publicado pela fonte oficial é o registro dessa revogação expressa — não há
inferência, há transcrição. Afirmar vigência de dispositivo revogado é o erro de
maior dano num acervo jurídico: leva o leitor a aplicar norma que não existe mais.

READ-ONLY: não escreve no corpus. Só lê o manifesto e os blobs.

Uso:
    ./tools/measure-revogacao-expressa-nao-fechada
    ./tools/measure-revogacao-expressa-nao-fechada --json
    ./tools/measure-revogacao-expressa-nao-fechada --root var/ensaio/corpus-oraculo-20260905
"""

from __future__ import annotations

import argparse
import collections
import json
import pathlib
import re
import sys

# Espelha internal/sourcesnapshotaudit.inspectDevice: o mesmo prefixo lexical é
# removido antes de olhar o corpo, para que medidor e auditor classifiquem o
# MESMO texto. Divergir daqui produziria um número que o gate não reconhece.
ART = re.compile(r"^\s*Art\.?\s*\d[\d\.]*(?:\s*[-–]\s*[A-Za-z])?\s*[ºo°]?\s*[\.\-–—]?\s*", re.I)
REVOG = re.compile(r"(?i)^\s*[\[(]?\s*revogad[oa]\b")
NORMA = re.compile(
    r"(?i)revogad[oa]\s+(?:pel[ao]\s+)?"
    r"((?:Lei|Decreto[-\s]?Lei|Decreto|Medida\s+Provis[oó]ria|Emenda\s+Constitucional"
    r"|Lei\s+Complementar)[^,;)\]]{0,40}?n?[ºo°]?\s*[\d\.]+)")
DATA = re.compile(r"(?i)n?[ºo°]?\s*[\d\.]+,\s*de\s+(\d{1,2}/\d{1,2}/\d{4})")
# "em vigor 90 dias após", "em vigor após 1 ano", "em vigor em 1º/1/2020": só a
# terceira forma dá dia certo; as duas primeiras são efeito diferido.
VACATIO = re.compile(r"(?i)em\s+vigor\s+(?:[^,;)]{0,24}?\s+)?(?:ap[oó]s|a\s+partir|em\s+\d)")


def medir(raiz: pathlib.Path) -> list[dict]:
    por_serie: dict[tuple[str, str], list[dict]] = collections.defaultdict(list)
    with (raiz / "manifest.jsonl").open(encoding="utf-8") as arquivo:
        for linha in arquivo:
            if not linha.strip():
                continue
            registro = json.loads(linha)
            por_serie[(registro["urn_lex"], registro.get("dispositivo", ""))].append(registro)

    achados: list[dict] = []
    for (urn, dispositivo), registros in por_serie.items():
        registros.sort(key=lambda r: (r.get("version_seq", 0), r.get("fetched_at", "")))
        cabeca = registros[-1]
        if cabeca.get("vigencia_status") != "vigente":
            continue
        blob = raiz / (cabeca.get("blob_ref") or "")
        if not blob.is_file():
            continue
        corpo = ART.sub("", blob.read_text(encoding="utf-8", errors="replace").strip()).strip()
        if not REVOG.match(corpo):
            continue
        norma, data, vacatio = NORMA.search(corpo), DATA.search(corpo), VACATIO.search(corpo)
        if not norma:
            classe = "sem_norma_identificavel"
        elif not data:
            classe = "norma_sem_data_direta"
        elif vacatio:
            classe = "vacatio_declarada_nao_fecha"
        else:
            classe = "data_direta_fechavel"
        achados.append({
            "urn_lex": urn,
            "dispositivo": dispositivo,
            "classe": classe,
            "norma_revogadora": norma.group(1).strip() if norma else "",
            "data_do_ato": data.group(1) if data else "",
            "vigencia_fim_gravada": cabeca.get("vigencia_fim", ""),
            "revogado_por_gravado": cabeca.get("revogado_por", ""),
            "marcador_verbatim": corpo[:300].replace("\n", " "),
            "blob_ref": cabeca.get("blob_ref", ""),
        })
    return achados


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", default="data/source-snapshots", help="raiz do corpus-oráculo")
    parser.add_argument("--json", action="store_true", help="despeja os achados em JSON")
    args = parser.parse_args()

    raiz = pathlib.Path(args.root)
    if not (raiz / "manifest.jsonl").is_file():
        print(f"NAO RODOU: {raiz}/manifest.jsonl ausente", file=sys.stderr)
        return 2

    achados = medir(raiz)
    if args.json:
        json.dump(achados, sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 0

    classes = collections.Counter(a["classe"] for a in achados)
    print(f"corpus: {raiz}")
    print(f"cabeça textual REVOGADA com registro 'vigente': {len(achados)}")
    for classe, n in classes.most_common():
        print(f"  {n:5d}  {classe}")
    for classe in ("data_direta_fechavel", "vacatio_declarada_nao_fecha"):
        exemplos = [a for a in achados if a["classe"] == classe][:3]
        if not exemplos:
            continue
        print(f"\n--- {classe}")
        for a in exemplos:
            print(f"  {a['urn_lex'].split(';')[-1]:>10s} {a['dispositivo']:<12s} "
                  f"norma={a['norma_revogadora'][:32]!r} data={a['data_do_ato']}")
            print(f"      {a['marcador_verbatim'][:100]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
