#!/usr/bin/env python3
"""build-link-topics-enrich-data-20260812 — monta o .data.json do gerador de tópicos.

Consolida os vereditos de revisão jurídica (um arquivo por lote em
.agents/runtime/link-mesh-tail-20260812/vereditos/) no arquivo de dados que
generate-v2-link-topics-enrich-20260812 consome. Só entra veredito
`verdadeiro` com trecho verbatim que CONFERE contra o texto vivo da página que
recebe o tópico — o revisor leu uma versão bounded do texto, e aqui a prova é
reconferida contra o registro real do acervo.

Dois formatos de veredito entram:
  - `lote_*.json`  — o tópico vai na página FONTE e nomeia o artigo nunca
    rastreado (motivo_da_cauda = "nunca_rastreado_sem_entrada_nova");
  - `famintos.json` — o tópico vai na PRÓPRIA página com slot vazio e nomeia o
    vizinho escolhido (motivo_da_cauda = "piso_real_de_afinidade").

Read-only sobre o estoque: escreve apenas o .data.json.
"""
from __future__ import annotations

import glob
import json
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VEREDITOS = ROOT / ".agents/runtime/link-mesh-tail-20260812/vereditos"
DESTINO = ROOT / "tools/generate-v2-link-topics-enrich-20260812.data.json"
PAGES = ROOT / "data/editorial/v2_pages"


def texto_visivel(record: dict) -> str:
    partes = [record.get("opening") or ""]
    for section in record.get("sections") or []:
        partes.append(section.get("heading") or "")
        partes.append(section.get("text") or "")
    for item in record.get("faq") or []:
        partes.append(item.get("q") or "")
        partes.append(item.get("a") or "")
    return "\n".join(partes)


def indexar() -> dict[str, dict]:
    registros: dict[str, dict] = {}
    for shard in sorted(PAGES.glob("*.jsonl")):
        for linha in shard.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            registro = json.loads(linha)
            intent = registro.get("intent_id")
            if intent and intent not in registros:
                registros[intent] = registro
    return registros


def main() -> int:
    registros = indexar()
    aceitos: list[dict] = []
    recusados = {"fraco": 0, "falso": 0, "sem_vizinho": 0}
    descartados_por_prova = []

    lotes = sorted(glob.glob(os.fspath(VEREDITOS / "lote_*.json")))
    # Repescagem: os alvos cuja PRIMEIRA fonte foi recusada foram reapresentados
    # com a segunda fonte afim mais forte. Mesmo critério, fonte diferente.
    lotes += sorted(glob.glob(os.fspath(VEREDITOS.parent / "vereditos2" / "r2_*.json")))
    for arquivo in lotes:
        for row in json.loads(Path(arquivo).read_text(encoding="utf-8")):
            veredito = row.get("veredito")
            if veredito != "verdadeiro":
                recusados[veredito] = recusados.get(veredito, 0) + 1
                continue
            pagina, topico = row["fonte_intent_id"], row["alvo_intent_id"]
            aceitos.append({
                "intent_id": pagina, "topico": topico,
                "motivo_da_cauda": "nunca_rastreado_sem_entrada_nova",
                "porque": row.get("porque", ""),
                "trecho_justificativa": row.get("trecho_justificativa", ""),
                "campo_do_trecho": row.get("campo_do_trecho", ""),
                "veredito": veredito,
                "verificado_por": "revisao-juridica-de-texto-20260812",
                "_lote": os.path.basename(arquivo),
            })

    famintos = VEREDITOS / "famintos.json"
    if famintos.is_file():
        for row in json.loads(famintos.read_text(encoding="utf-8")):
            escolhido = (row.get("escolhido") or "").strip()
            if not escolhido:
                recusados["sem_vizinho"] += 1
                continue
            aceitos.append({
                "intent_id": row["faminto_intent_id"], "topico": escolhido,
                "motivo_da_cauda": "piso_real_de_afinidade",
                "porque": row.get("porque", ""),
                "trecho_justificativa": row.get("trecho_justificativa", ""),
                "campo_do_trecho": row.get("campo_do_trecho", ""),
                "veredito": "verdadeiro",
                "verificado_por": "revisao-juridica-de-texto-20260812",
                "_lote": "famintos.json",
            })

    # PROVA RECONFERIDA contra o texto VIVO — o revisor leu um recorte bounded.
    finais: list[dict] = []
    vistos: set[tuple[str, str]] = set()
    for item in aceitos:
        pagina, topico = item["intent_id"], item["topico"]
        motivo = None
        if pagina not in registros:
            motivo = "página não existe no acervo vivo"
        elif topico not in registros:
            motivo = "tópico não é intent_id de página do acervo"
        elif pagina == topico:
            motivo = "auto-referência"
        elif topico in (registros[pagina].get("internal_link_topics") or []):
            motivo = "tópico já declarado (idempotente)"
        elif (pagina, topico) in vistos:
            motivo = "par repetido"
        else:
            trecho = item.get("trecho_justificativa") or ""
            if len(trecho) < 40:
                motivo = "trecho curto demais"
            elif trecho not in texto_visivel(registros[pagina]):
                motivo = "trecho não confere com o texto vivo"
        if motivo:
            descartados_por_prova.append((pagina, topico, motivo))
            continue
        vistos.add((pagina, topico))
        finais.append(item)

    payload = {
        "gerador": "generate-v2-link-topics-enrich-20260812",
        "gerado_em": "2026-08-12",
        "origem_da_verificacao":
            ".agents/runtime/link-mesh-tail-20260812/vereditos/",
        "criterio":
            "só veredito 'verdadeiro' de revisão jurídica de texto, com recorte "
            "verbatim reconferido contra o registro vivo do acervo",
        "topicos": sorted(finais, key=lambda t: (t["intent_id"], t["topico"])),
    }
    DESTINO.write_text(json.dumps(payload, ensure_ascii=False, indent=1) + "\n",
                       encoding="utf-8")

    print(f"aceitos           : {len(finais)} tópico(s) em "
          f"{len({t['intent_id'] for t in finais})} página(s)")
    print(f"recusados na revisão: {recusados}")
    if descartados_por_prova:
        print(f"descartados na reconferência: {len(descartados_por_prova)}")
        for pagina, topico, motivo in descartados_por_prova[:10]:
            print(f"  {pagina} += {topico}: {motivo}")
    print(f"escrito           : {os.path.relpath(DESTINO, ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
