            "de toda faixa oficial do operador declarado")
    if resumo["social_total"] == 0:
        notas.append(
            f"INCONCLUSIVO para requests_authentic da superfície social: zero requisição real a /redesocial/ no log "
            f"de origem desde {NASCIMENTO_DA_SUPERFICIE}. A borda absorve o que o cache guarda, então a origem é "
            "PISO de volume, nunca contador")
    elif autenticas <= 0:
        falhas.append(
            f"requests_authentic = {autenticas} para /redesocial/: as {resumo['social_total']} requisições reais "
            "medidas são todas forjadas")
    else:
        notas.append(
            f"requests_authentic = {autenticas} para /redesocial/ ({resumo['social_total']} requisição(ões) real(is), "
            f"{resumo['social_forjadas']} forjada(s)); por agente: "
            + ", ".join(f"{a}={n}" for a, n in sorted(resumo["social_por_agente"].items())))

    falha_do_tripwire, nota_do_tripwire = tripwire_do_acervo(resumo)
    if falha_do_tripwire:
        falhas.append(falha_do_tripwire)
    notas.append(nota_do_tripwire)

    horizonte, erro_do_horizonte = horizonte_do_log_bruto()
    if erro_do_horizonte:
        notas.append(f"horizonte do log rotacionado não medido: {erro_do_horizonte}")
    notas.append(veredito_de_crescimento(resumo, horizonte))

    if resumo["forjadas_acervo"]:
        total = sum(resumo["forjadas_acervo"].values())
        notas.append(
            f"ACHADO sem veredito — {total} requisição(ões) forjada(s) contra o ACERVO, de "
            f"{len(resumo['ips_forjados'])} IP(s) distintos: "
            + ", ".join(f"{a}={n} req/{len(resumo['ips_por_agente'].get(a, ()))} IP"
                        for a, n in sorted(resumo["forjadas_acervo"].items()))
            + ". A isenção do nginx é por User-Agent, então chave vazia por User-Agent é chave vazia para quem "
              "digitar o User-Agent. Reprovar por isso todo dia viraria ruído: a decisão é de arquitetura")
    if resumo["sem_ip"]:
        notas.append(
            f"{resumo['sem_ip']} linha(s) com bot_allow=1 e SEM remote_addr (schema antigo do access ledger): "
            "autenticidade não pode ser decidida nelas, e elas ficam fora da conta de forjadas")
    if resumo["prefixos_descartados"]:
        notas.append(f"{resumo['prefixos_descartados']} prefixo(s) malformado(s) em data/ops/bot_ip_ranges/, ignorados")
    notas.append(
        f"log de origem: {resumo['linhas']} linha(s); dias completos (24 h): "
        + ", ".join(dias_completos(resumo["horas_por_dia"])))

    if falhas:
        return base.relata(NOME, base.ERRADO, falhas + ["--- medido junto ---"] + notas)
    return base.relata(NOME, base.OK, notas)


if __name__ == "__main__":
    sys.exit(main())
