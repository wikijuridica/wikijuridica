def rotas_do_sitemap(porta, base_url):
    """Devolve (caminhos, erro): o que o sitemap social manda o bot rastrear."""
    status, _, corpo, erro = requisita_corpo(porta, "/redesocial/sitemap.xml")
    if erro is not None:
        return None, erro
    if status != 200:
        return None, f"/redesocial/sitemap.xml respondeu {status}"
    try:
        raiz = ET.fromstring(corpo)
    except ET.ParseError as falha:
        return None, f"/redesocial/sitemap.xml não é XML válido: {falha}"
    caminhos = set()
    pendentes = [(n.text or "").strip() for n in raiz.iter(ESPACO_SITEMAP + "loc")]
    if raiz.tag == ESPACO_SITEMAP + "sitemapindex":
        shards, pendentes = pendentes, []
        for shard in shards:
            if not shard.startswith(base_url):
                return None, f"o índice aponta {shard!r}, fora da base pública {base_url}"
            status, _, corpo_shard, erro = requisita_corpo(porta, shard[len(base_url):])
            if erro is not None:
                return None, erro
            if status != 200:
                return None, f"o shard {shard} respondeu {status}"
            try:
                no = ET.fromstring(corpo_shard)
            except ET.ParseError as falha:
                return None, f"{shard} não é XML válido: {falha}"
            pendentes += [(n.text or "").strip() for n in no.iter(ESPACO_SITEMAP + "loc")]
    for loc in pendentes:
        if loc.startswith(base_url):
            caminhos.add(loc[len(base_url):])
    return sorted(caminhos), None


def sonda_superficie(caminhos, teto):
    """Sonda cada rota pelo processo e pela borda. Devolve (falhas, notas)."""
    falhas, notas = [], []
    portas = [("processo cmd/social", base.PORTA_SOCIAL)]
    if base.escuta(base.PORTA_NGINX):
        portas.append(("borda nginx", base.PORTA_NGINX))
    else:
        notas.append(f"nginx 127.0.0.1:{base.PORTA_NGINX} fora do ar: só o processo foi sondado")
    for rotulo, porta in portas:
        for caminho in caminhos:
            status, cabecalhos, corpo, erro = requisita_corpo(porta, caminho)
            if erro is not None:
                falhas.append(f"{rotulo} {caminho}: {erro}")
                continue
            if status != 200:
                falhas.append(f"{rotulo} {caminho} respondeu {status}, e o sitemap manda o bot rastrear essa URL")
                continue
            texto = corpo.decode("utf-8", "replace")
            if "text/html" not in str(cabecalhos.get("Content-Type", "")):
                falhas.append(f"{rotulo} {caminho}: Content-Type {cabecalhos.get('Content-Type')!r}, esperado text/html")
            if "<script" in texto.lower():
                falhas.append(f"{rotulo} {caminho}: o HTML traz `<script`, proibido nesta superfície")
            if len(corpo) > teto:
                falhas.append(f"{rotulo} {caminho}: {len(corpo)} bytes, acima do teto {teto}")
            if "</html>" not in texto.lower() or "<h1" not in texto.lower():
                falhas.append(
                    f"{rotulo} {caminho}: o HTML não veio completo no primeiro response "
                    "(faltou </html> ou <h1>), e bot nenhum executa JS para completar")
            # O cabeçalho vence a meta para o bot, e o nginx pode acrescentar um
            # que o processo não emite: por isso a conferência é nas DUAS pontas.
            for chave, valor in cabecalhos.items():
                if chave.lower() == "x-robots-tag" and "noindex" in str(valor).lower():
                    falhas.append(
                        f"{rotulo} {caminho}: X-Robots-Tag {valor!r} numa URL que o sitemap manda indexar; "
                        "o cabeçalho vence a meta e tira a página do índice em silêncio")
            notas.append(f"{rotulo} {caminho}: 200, {len(corpo)} bytes")
    return falhas, notas


def teto_de_bytes(raiz):
    """Lê HTMLBudgetBytes do fonte Go: o número não se digita duas vezes."""
    caminho = os.path.join(raiz, "internal", "htmlcontract", "htmlcontract.go")
    with open(caminho, encoding="utf-8") as f:
        texto = f.read()
    achado = re.search(r"\bHTMLBudgetBytes\s*=\s*(\d+)", texto)
    if not achado:
        raise ValueError("internal/htmlcontract/htmlcontract.go não declara HTMLBudgetBytes")
    return int(achado.group(1))


def base_publica(raiz):
    """URL pública travada em content/site.json."""
    with open(os.path.join(raiz, "content", "site.json"), encoding="utf-8") as f:
        site = json.load(f)
    url = str(site.get("base_url", "")).strip().rstrip("/")
    if not url.startswith("https://"):
        raise ValueError(f"content/site.json tem base_url={url!r}, que não é HTTPS absoluto")
    return url


def main():
    raiz = base.RAIZ
    falhas, notas = [], []

    # ── (a) configuração ──
    caminho_nginx = os.path.join(raiz, NGINX_VIVO)
    try:
        with open(caminho_nginx, encoding="utf-8") as f:
            texto_nginx = f.read()
    except OSError as erro:
        return base.relata(NOME, base.INCONCLUSIVO, [f"não consegui ler {NGINX_VIVO}: {erro}"])
    if banner_de_nao_carregado(texto_nginx):
        return base.relata(NOME, base.INCONCLUSIVO, [
            f"{NGINX_VIVO} abre com o banner NAO-CARREGADO-EM-PRODUCAO: auditar config que ninguém carrega "
            "daria verde sobre nada"])

    preambulo, corpo_da_location = linhas_do_bloco(texto_nginx, LOCATION_DE_LEITURA)
    if corpo_da_location is None:
        falhas.append(f"{NGINX_VIVO} não declara `location ^~ {LOCATION_DE_LEITURA}`: a rede social não é proxiada")
    else:
        quantas = conta_limit_req(corpo_da_location)
        if quantas:
            falhas.append(
                f"o bloco `location ^~ {LOCATION_DE_LEITURA}` declara {quantas} `limit_req`: a herança do nginx é "
                "tudo-ou-nada, e uma diretiva local SUBSTITUI as cinco do server{} — inclusive a que isenta o bot valioso")
        else:
            notas.append(f"`location ^~ {LOCATION_DE_LEITURA}`: zero limit_req, e as cinco do server{{}} continuam herdadas")

    try:
        ilimitados, demais = agentes_da_politica(raiz)
        teto = teto_de_bytes(raiz)
        base_url = base_publica(raiz)
    except (OSError, ValueError, json.JSONDecodeError) as erro:
        return base.relata(NOME, base.INCONCLUSIVO, [f"não consegui ler a configuração versionada: {erro}"])

    tokens, tem_default_zero = tokens_do_mapa(texto_nginx)
    if tokens is None:
        falhas.append(f"{NGINX_VIVO} não declara o mapa `$wj_bot_allow`: sem ele nenhum bot fica isento de limite")
        tokens = []
    else:
        if not tem_default_zero:
            falhas.append("o mapa `$wj_bot_allow` não tem `default 0`: sem ele o padrão vira isenção para todo mundo")
        falhas_do_mapa = confere_mapa(tokens, ilimitados, demais)
        falhas += falhas_do_mapa
        if falhas_do_mapa:
            notas.append(f"mapa $wj_bot_allow: {len(tokens)} token(s) contra {len(ilimitados)} agente(s) ilimitado(s)")
        else:
            notas.append(
                f"mapa $wj_bot_allow: {len(tokens)} token(s) e {len(ilimitados)} agente(s) no tier ilimitado de "
                "content/crawl_policy.json, equivalentes nos dois sentidos")

    divergentes = divergencia_de_comentario(preambulo, corpo_da_location, tokens, ilimitados)
    if divergentes:
        falhas.append(
            "ACHADO — comentário que mente sobre o mapa: os comentários de `location ^~ /redesocial/` nomeiam "
            f"{', '.join(divergentes)} como isento(s), e nenhum token de $wj_bot_allow casa com esse(s) nome(s). "
            "A política os põe em tier finito, o que está certo: errado está o comentário, e quem o corrige é "
            "quem é dono do arquivo — este gate reporta, não edita")

    # ── (b) sonda ──
    if not base.escuta(base.PORTA_SOCIAL):
        return base.relata(NOME, base.INCONCLUSIVO, [
            f"nada escutando em 127.0.0.1:{base.PORTA_SOCIAL}: o cmd/social está parado, e indisponibilidade "
            "nunca é reprovação"] + falhas)
    caminhos, erro = rotas_do_sitemap(base.PORTA_SOCIAL, base_url)
    if erro is not None:
        falhas.append(f"não consegui derivar as rotas do sitemap social: {erro}")
        caminhos = ["/redesocial/"]
    if "/redesocial/" not in caminhos:
        caminhos = ["/redesocial/"] + list(caminhos)
    falhas_da_sonda, notas_da_sonda = sonda_superficie(caminhos, teto)
    falhas += falhas_da_sonda
    notas += notas_da_sonda

    # ── (c) log de origem ──
    resumo, erro = le_log_de_origem(raiz)
    if erro is not None:
        return base.relata(NOME, base.INCONCLUSIVO, [erro] + falhas)

    declarados, erro = metodos_declarados(raiz)
    if erro is not None:
