ESPACO_SITEMAP = "{http://www.sitemaps.org/schemas/sitemap/0.9}"

# Palavra com cara de token de User-Agent de bot. Serve para achar, nos
# COMENTÁRIOS, promessa que o mapa não cumpre.
RE_TOKEN_DE_BOT = re.compile(r"(?i)\b([a-z][a-z0-9_-]*(?:bot|-user|-searchbot|externalhit|externalfetcher))\b")

RE_ENTRADA_DO_MAPA = re.compile(r"^~\*(\S+)\s+1\s*;")


def carrega_base():
    """Carrega tools/social_borda_probe.py por caminho explícito.

    O idioma usual (`sys.path.insert` + import) obrigaria a suprimir o
    diagnóstico do lint sobre import fora de ordem, e mascarar diagnóstico é
    proibido neste repositório.
    """
    caminho = os.path.join(os.path.dirname(os.path.abspath(__file__)), "social_borda_probe.py")
    spec = importlib.util.spec_from_file_location("social_borda_probe", caminho)
    if spec is None or spec.loader is None:
        raise ImportError(f"não consegui carregar {caminho}")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


base = carrega_base()


def requisita_corpo(porta, caminho, timeout=10):
    """Devolve (status, cabecalhos, corpo, erro). O módulo compartilhado descarta
    o corpo, e este gate precisa medir o HTML servido."""
    cabecalhos = dict(base.CABECALHOS_BASE)
    cabecalhos["Host"] = base.HOST_PUBLICO
    conexao = None
    try:
        conexao = http.client.HTTPConnection("127.0.0.1", porta, timeout=timeout)
        conexao.request("GET", caminho, headers=cabecalhos)
        resposta = conexao.getresponse()
        corpo = resposta.read()
        return resposta.status, dict(resposta.getheaders()), corpo, None
    except (OSError, http.client.HTTPException) as erro:
        return None, {}, b"", f"{type(erro).__name__}: {erro}"
    finally:
        if conexao is not None:
            conexao.close()


# ─── (a) configuração ────────────────────────────────────────────────────────


def banner_de_nao_carregado(texto, linhas=5):
    """Diz se o arquivo se declara fora de produção nas primeiras linhas.

    A conferência é pelo CABEÇALHO, e não por busca no arquivo inteiro: o
    nginx vivo cita o banner do outro arquivo em prosa, na linha 232, e uma
    busca ingênua se recusaria a auditar justamente a config carregada.
    """
    cabeca = "\n".join(texto.splitlines()[:linhas])
    return "NAO-CARREGADO-EM-PRODUCAO" in cabeca or "NÃO-CARREGADO-EM-PRODUÇÃO" in cabeca


def linhas_do_bloco(texto, caminho):
    """Devolve (preambulo, corpo) da location, ou (None, None).

    O preâmbulo são os comentários contíguos ACIMA da diretiva — é lá que mora a
    promessa sobre quais bots ficam isentos, e ela não está dentro das chaves.
    """
    padrao = re.compile(r"^\s*location\s+(?:=|~\*?|\^~)?\s*" + re.escape(caminho) + r"\s*\{")
    linhas = texto.splitlines()
    for i, linha in enumerate(linhas):
        if not padrao.match(linha):
            continue
        j = i - 1
        preambulo = []
        while j >= 0 and linhas[j].lstrip().startswith("#"):
            preambulo.append(linhas[j])
            j -= 1
        preambulo.reverse()
        profundidade = linha.count("{") - linha.count("}")
        corpo = []
        k = i + 1
        while k < len(linhas) and profundidade > 0:
            profundidade += linhas[k].count("{") - linhas[k].count("}")
            if profundidade > 0:
                corpo.append(linhas[k])
            k += 1
        return "\n".join(preambulo), "\n".join(corpo)
    return None, None


def sem_comentario(texto):
    """Remove comentário de fim de linha. Diretiva comentada não é diretiva."""
    return re.sub(r"(?m)#[^\n]*$", "", texto)


def conta_limit_req(corpo):
    """Quantas `limit_req` VALEM no bloco. Comentário não conta como diretiva."""
    return len(re.findall(r"\blimit_req\s+zone=", sem_comentario(corpo)))


def tokens_do_mapa(texto):
    """Extrai os tokens que o mapa $wj_bot_allow marca com 1."""
    achado = re.search(r"map\s+\$http_user_agent\s+\$wj_bot_allow\s*\{(.*?)\n\}", texto, re.S)
    if not achado:
        return None, None
    corpo = achado.group(1)
    tokens = []
    tem_default_zero = False
    for linha in corpo.splitlines():
        limpa = linha.split("#")[0].strip()
        if re.match(r"^default\s+0\s*;", limpa):
            tem_default_zero = True
        entrada = RE_ENTRADA_DO_MAPA.match(limpa)
        if entrada:
            tokens.append(entrada.group(1))
    return tokens, tem_default_zero


def agentes_da_politica(raiz):
    """Devolve (ilimitados, demais) a partir de content/crawl_policy.json.

    O tier ilimitado é resolvido pelo NOME do tier declarado no registro, e não
    pela classe: é o campo que a política usa para decidir o limite, e é ele que
    o mapa do nginx materializa.
    """
    caminho = os.path.join(raiz, "content", "crawl_policy.json")
    with open(caminho, encoding="utf-8") as f:
        politica = json.load(f)
    tiers_ilimitados = {
        str(t.get("name")) for t in politica.get("rate_tiers", []) if t.get("unlimited") is True
    }
    ilimitados, demais = [], []
    for registro in politica.get("bot_registry", []):
        agente = str(registro.get("user_agent", "")).strip()
        if not agente:
            continue
        if str(registro.get("rate_tier")) in tiers_ilimitados:
            ilimitados.append(agente)
        else:
            demais.append(agente)
    return ilimitados, demais


def user_agent_sintetico(nome):
    """Monta a string de User-Agent na forma em que o bot se apresenta.

    Comparar o token do mapa com o NOME do registro daria falso alarme: o token
    `~*applebot/` existe justamente para casar `Applebot/0.1` e NÃO casar
    `Applebot-Extended`, que é treinamento e fica em tier finito. Sem a barra da
    versão a distinção some.
    """
    return f"Mozilla/5.0 (compatible; {nome}/1.0; +http://exemplo.invalido/bot)"


def casa(token, nome):
    """Reproduz o que o `~*` do nginx faz: busca de regex, sem diferenciar caixa."""
    try:
        return re.search(token, user_agent_sintetico(nome), re.I) is not None
    except re.error:
        return False


def confere_mapa(tokens, ilimitados, demais):
    """Compara mapa e política nos dois sentidos. Devolve a lista de falhas."""
    falhas = []
    for nome in sorted(ilimitados):
        if not any(casa(t, nome) for t in tokens):
            falhas.append(
                f"{nome} está no tier ilimitado de content/crawl_policy.json e NENHUM token do mapa "
                "$wj_bot_allow casa com ele: bot valioso rebaixado em silêncio")
    for token in tokens:
        casados = [n for n in ilimitados if casa(token, n)]
        indevidos = [n for n in demais if casa(token, n)]
        if not casados:
            falhas.append(f"o token `~*{token}` do mapa não casa com nenhum agente do tier ilimitado da política")
        if indevidos:
            falhas.append(
                f"o token `~*{token}` do mapa isenta também {', '.join(sorted(indevidos))}, "
                "que a política NÃO põe no tier ilimitado")
    return falhas


# Marcas de que a frase do comentário AFIRMA isenção. Sem elas o extrator
# acusaria qualquer bot citado em qualquer prosa — inclusive uma frase que diga,
# corretamente, que o SemrushBot fica em tier finito.
MARCAS_DE_ISENCAO = ("isent", "pista livre", "ilimitad", "sem limite", "nao e limitad", "não é limitad")

# Marcas cuja PROPRIA forma ja nega o limite. Negar de novo seria negacao
# dupla, que e ambigua o bastante para continuar merecendo o achado.
MARCAS_QUE_JA_SAO_NEGACAO = ("nao e limitad", "não é limitad")

NEGADORES = ("nao ", "não ", "nunca ", "jamais ", "deixou de ", "sem ")

# Janela curta de proposito, e a virgula a corta: assim "que, embora nao
# devesse, tem pista livre" continua sendo achado, e so a negacao colada na
# promessa a desarma.
JANELA_DO_NEGADOR = 28


def frases_de_comentario(preambulo, corpo):
    """Junta os comentários do bloco e devolve as frases, uma a uma.

    A junção vem antes do corte: a frase que interessa atravessa três linhas de
    comentário, e cortar por linha a partiria no meio de uma enumeração de bots.
    """
    linhas = [linha for linha in ((preambulo or "") + "\n" + (corpo or "")).splitlines()
              if linha.lstrip().startswith("#")]
    texto = " ".join(linha.lstrip().lstrip("#").strip() for linha in linhas)
    return [frase.strip() for frase in texto.split(".") if frase.strip()]


def marca_esta_negada(frase_baixa, marca, inicio):
    """Diz se ESTA ocorrencia da marca aparece negada.

    Um comentario que corrige a propria mentira -- "o GPTBot NAO tem pista
    livre" -- nomeia o bot ao lado da marca de isencao exatamente como o
    comentario mentiroso o nomeava. Sem esta distincao, o detector acusa a
    prosa que o desmente, que e o mesmo defeito de procurar o literal e achar
    o texto SOBRE o literal.
    """
    if marca in MARCAS_QUE_JA_SAO_NEGACAO:
        return False
    janela = frase_baixa[max(0, inicio - JANELA_DO_NEGADOR):inicio]
    if "," in janela:
        janela = janela[janela.rindex(",") + 1:]
    return any(negador in janela for negador in NEGADORES)


def frase_promete_isencao(frase_baixa):
    """A frase afirma que algum bot fica sem limite? Negacao nao conta."""
    for marca in MARCAS_DE_ISENCAO:
        inicio = frase_baixa.find(marca)
        while inicio != -1:
            if not marca_esta_negada(frase_baixa, marca, inicio):
                return True
            inicio = frase_baixa.find(marca, inicio + 1)
    return False


def divergencia_de_comentario(preambulo, corpo, tokens, ilimitados):
    """Acha bot que o comentário declara isento e que o mapa não isenta.

    Não é conserto: o arquivo é de outra frente. É achado, e sai no relatório
    com o nome do bot para quem edita o nginx resolver.
    """
    conhecidos = {n.lower() for n in ilimitados}
    divergentes = []
    for frase in frases_de_comentario(preambulo, corpo):
        if not frase_promete_isencao(frase.lower()):
            continue
        for bruto in RE_TOKEN_DE_BOT.findall(frase):
            nome = bruto.lower()
            if any(casa(t, nome) for t in tokens) or nome in conhecidos or nome in divergentes:
                continue
            divergentes.append(nome)
    return divergentes


# ─── (c) log de origem ───────────────────────────────────────────────────────


def faixas_oficiais(raiz):
    """Mapeia agente -> redes oficiais, a partir de data/ops/bot_ip_ranges/*.json.

    Prefixo malformado é ignorado individualmente e contado: um arquivo com uma
    linha ruim não pode apagar as outras duzentas.
    """
    por_agente = {}
    descartados = 0
    for caminho in sorted(glob.glob(os.path.join(raiz, "data", "ops", "bot_ip_ranges", "*.json"))):
        try:
            with open(caminho, encoding="utf-8") as f:
                dados = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        redes = []
        for prefixo in dados.get("prefixes", []):
            try:
                redes.append(ipaddress.ip_network(prefixo))
            except ValueError:
                descartados += 1
        for agente in dados.get("authenticates_agents", []):
            por_agente.setdefault(str(agente).lower(), []).extend(redes)
    return por_agente, descartados


def dentro_das_faixas(endereco, redes):
    """Diz se o IP está em alguma faixa. None quando o IP é ilegível."""
    try:
        ip = ipaddress.ip_address(endereco)
    except (ValueError, TypeError):
        return None
    return any(ip in rede for rede in redes)


def le_log_de_origem(raiz):
    """Percorre data/ops/access/nginx-*.jsonl e devolve o resumo medido.

    Só linhas reais entram: aquecimento marcado e simulação ficam de fora, e é
    isso que impede a sonda deste repositório de inflar a própria métrica.
    """
    por_agente, prefixos_descartados = faixas_oficiais(raiz)
    resumo = {
        "linhas": 0,
        "sem_ip": 0,
        "horas_por_dia": {},
        "bot_acervo_por_dia": {},
        # A ATRIBUICAO DO TRIPWIRE PRECISA DE SUBSTRATO, e ate 2026-09-05 ela
        # nao tinha: ele dizia "caiu DEPOIS do nascimento da rede social" sem
        # nunca ter olhado se algum bot pisou na rede social. Estes dois campos
        # sao o que permite dizer a verdade -- quanto foi para a superficie nova
        # (se zero, nao houve realocacao possivel) e quais agentes sairam.
        "bot_social_por_dia": {},
        "acervo_por_agente_dia": {},
        "social_total": 0,
        "social_forjadas": 0,
        "social_por_agente": {},
        "forjadas_acervo": {},
        "ips_forjados": set(),
        "ips_por_agente": {},
        "ultima_data": "",
        "prefixos_descartados": prefixos_descartados,
        "agentes_com_faixa": sorted(por_agente),
    }
    arquivos = sorted(glob.glob(os.path.join(raiz, "data", "ops", "access", "nginx-*.jsonl")))
    if not arquivos:
        return None, "não há data/ops/access/nginx-*.jsonl para ler"
    for caminho in arquivos:
        try:
            arquivo = open(caminho, encoding="utf-8")
        except OSError as erro:
            return None, f"não consegui ler {caminho}: {erro}"
        with arquivo:
            for linha in arquivo:
                try:
                    evento = json.loads(linha)
                except json.JSONDecodeError:
                    continue
                resumo["linhas"] += 1
                carimbo = str(evento.get("ts", ""))
                dia = carimbo[:10]
                if dia:
                    resumo["ultima_data"] = max(resumo["ultima_data"], dia)
                    resumo["horas_por_dia"].setdefault(dia, set()).add(carimbo[11:13])
                if evento.get("warming") or evento.get("bot_simulation"):
                    continue
                agente = str(evento.get("agent_key") or "").lower()
                social = str(evento.get("path", "")).startswith("/redesocial/")
                if agente and not social and dia:
                    resumo["bot_acervo_por_dia"][dia] = resumo["bot_acervo_por_dia"].get(dia, 0) + 1
                    porDia = resumo["acervo_por_agente_dia"].setdefault(dia, {})
                    porDia[agente] = porDia.get(agente, 0) + 1
                if agente and social and dia:
                    resumo["bot_social_por_dia"][dia] = resumo["bot_social_por_dia"].get(dia, 0) + 1

                forjada = False
                if str(evento.get("bot_allow")) == "1" and agente:
                    redes = por_agente.get(agente)
                    if redes:
                        if "remote_addr" not in evento:
                            resumo["sem_ip"] += 1
                        else:
                            veredito = dentro_das_faixas(evento.get("remote_addr"), redes)
                            if veredito is False:
                                forjada = True
                                resumo["ips_forjados"].add(str(evento.get("remote_addr")))
                                resumo["ips_por_agente"].setdefault(agente, set()).add(str(evento.get("remote_addr")))
                if social:
                    resumo["social_total"] += 1
                    chave = agente or "sem_agent_key"
                    resumo["social_por_agente"][chave] = resumo["social_por_agente"].get(chave, 0) + 1
                    if forjada:
                        resumo["social_forjadas"] += 1
                elif forjada:
                    resumo["forjadas_acervo"][agente] = resumo["forjadas_acervo"].get(agente, 0) + 1
    return resumo, None


def metodos_declarados(raiz, dias=DIAS_DE_METODO):
    """Método de verificação mais recente por agente, na janela dos últimos dias.

    O ledger grava INCREMENTOS por janela de cursor; aqui não se soma nada — só
    se lê o método declarado, que é atributo do agente, não do volume.
    """
    caminho = os.path.join(raiz, "data", "ops", "origin_bot_traffic_daily.jsonl")
    try:
        arquivo = open(caminho, encoding="utf-8")
    except OSError as erro:
        return None, f"não consegui ler o ledger da origem: {erro}"
    ultimo = {}
    ultima_data = ""
    with arquivo:
        for linha in arquivo:
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            agente = str(registro.get("agent_key") or "").lower()
            data = str(registro.get("date") or "")
            if not agente or not data:
                continue
            ultima_data = max(ultima_data, data)
            anterior = ultimo.get(agente)
            if anterior is None or data >= anterior[0]:
                ultimo[agente] = (data, registro.get("verification_method"))
    if not ultima_data:
        return None, "o ledger da origem não tem nenhuma linha com date e agent_key"
    corte = (datetime.date.fromisoformat(ultima_data) - datetime.timedelta(days=dias - 1)).isoformat()
    janela = {a: m for a, (d, m) in ultimo.items() if d >= corte}
    return {"ultima_data": ultima_data, "corte": corte, "metodos": janela}, None


def confere_metodos(declarados, agentes_com_faixa):
    """`verification_method` é POR AGENTE, nunca em bloco. Devolve falhas."""
    falhas = []
    com_faixa = set(agentes_com_faixa)
    for agente, metodo in sorted(declarados["metodos"].items()):
        if metodo == "ip_range" and agente not in com_faixa:
            falhas.append(
                f"o ledger declara verification_method=ip_range para {agente}, e não há faixa oficial dele em "
                "data/ops/bot_ip_ranges/: a métrica estaria mentindo a nosso favor")
    metodos = set(declarados["metodos"].values())
    tem_ambas_classes = any(a in com_faixa for a in declarados["metodos"]) and \
        any(a not in com_faixa for a in declarados["metodos"])
    if tem_ambas_classes and len(metodos) == 1:
        falhas.append(
            f"todos os {len(declarados['metodos'])} agentes da janela declaram o mesmo verification_method "
            f"({metodos.pop()!r}), e o disco distingue quem tem faixa oficial de quem não tem: "
            "método em bloco é métrica inventada")
    return falhas


def dias_completos(horas_por_dia):
    """Dia completo é dia com as 24 horas presentes no log.

    Comparar dia parcial com dia inteiro fabricaria queda onde há só o relógio.
    """
    return sorted(d for d, horas in horas_por_dia.items() if len(horas) >= 24)


def horizonte_do_log_bruto(access_log=None):
    """Até onde o log rotacionado do nginx ainda permite transcrever.

    Existe porque a janela ANTERIOR do método não se completa por espera: ela é
    passado. Ou o dia já foi transcrito para `data/ops/access/nginx-*.jsonl`, ou
    ele ainda está no arquivo rotacionado e entra por
    `tools/generate-origin-access-ledger --dia AAAA-MM-DD`, ou saiu do disco e
    não volta. Dizer "faltam 11 dias" sem essa distinção sugere uma contagem
    regressiva que nunca termina.

    Só o diretório é lido (nome e mtime), nunca o conteúdo: o gate não precisa
    do dado bruto para saber até onde ele vai.
    """
    pasta = os.path.dirname(access_log or base.ACCESS_LOG)
    try:
        entradas = [e for e in os.scandir(pasta) if e.is_file() and os.path.basename(e.path).startswith("access.log")]
    except OSError as erro:
        return None, f"não consegui listar {pasta}: {erro}"
    if not entradas:
        return None, f"nenhum arquivo access.log* em {pasta}"
    mais_antigo = min(e.stat().st_mtime for e in entradas)
    dia = datetime.date.fromtimestamp(mais_antigo).isoformat()
    return {"arquivos": len(entradas), "dia_mais_antigo": dia}, None


def veredito_de_crescimento(resumo, horizonte=None):
    """O veredito de crescimento, que hoje só pode ser INCONCLUSIVO.

    Devolve a linha do relatório. Ele NÃO reprova nem aprova: o método exige as
    duas janelas, e enquanto elas não existirem a única saída honesta é dizer
    quantos dias faltam E COMO cada janela se completa — a posterior por espera,
    a anterior por transcrição do log rotacionado. Um "passou" antes disso é
    verde por construção; uma contagem regressiva sobre janela que só o passado
    preenche é a mesma desonestidade ao contrário.
    """
    ultima = resumo["ultima_data"] or NASCIMENTO_DA_SUPERFICIE
    completos = dias_completos(resumo["horas_por_dia"])
    antes = [d for d in completos if d < NASCIMENTO_DA_SUPERFICIE]
    depois = [d for d in completos if d >= NASCIMENTO_DA_SUPERFICIE]
    faltam_antes = max(0, DIAS_POR_JANELA - len(antes))
    faltam_depois = max(0, DIAS_POR_JANELA - len(depois))
    if faltam_antes or faltam_depois:
        linha = (
            f"crescimento INCONCLUSIVO: a superfície social nasceu em {NASCIMENTO_DA_SUPERFICIE} "
            f"({FONTE_DO_NASCIMENTO}) e o log transcrito vai até {ultima}; há {len(antes)} dia(s) completo(s) "
            f"antes e {len(depois)} depois. O método exige {DIAS_POR_JANELA}+{DIAS_POR_JANELA} dias com "
            f"N>={N_MINIMO_POR_JANELA} em cada janela: faltam {faltam_antes} dia(s) na janela anterior e "
            f"{faltam_depois} na posterior")
        if faltam_depois:
            linha += f". A janela posterior se completa por espera: faltam {faltam_depois} dia(s) completo(s)"
        if faltam_antes:
            primeiro = antes[0] if antes else "nenhum dia transcrito"
            linha += (
                f". A janela ANTERIOR não se completa por espera — ela é passado. O log transcrito começa em "
                f"{primeiro}; os dias que faltam entram por `tools/generate-origin-access-ledger --dia AAAA-MM-DD` "
                "enquanto o log rotacionado do nginx ainda os guardar")
            if horizonte:
                linha += (f" (medido agora: {horizonte['arquivos']} arquivo(s) access.log* no disco, o mais antigo "
                          f"de {horizonte['dia_mais_antigo']})")
        return linha
    n_antes = sum(resumo["bot_acervo_por_dia"].get(d, 0) for d in antes[-DIAS_POR_JANELA:])
    n_depois = sum(resumo["bot_acervo_por_dia"].get(d, 0) for d in depois[:DIAS_POR_JANELA])
    if n_antes < N_MINIMO_POR_JANELA or n_depois < N_MINIMO_POR_JANELA:
        return (f"crescimento INCONCLUSIVO: as duas janelas de {DIAS_POR_JANELA} dias existem, mas N={n_antes} "
                f"antes e N={n_depois} depois, e o método exige N>={N_MINIMO_POR_JANELA} em cada uma")
    variacao = (n_depois - n_antes) / n_antes if n_antes else 0.0
    return (f"crescimento medido: {n_antes} requisições de bot nos {DIAS_POR_JANELA} dias completos antes de "
            f"{NASCIMENTO_DA_SUPERFICIE} e {n_depois} nos {DIAS_POR_JANELA} depois ({variacao * 100:+.1f}%)")


def tripwire_do_acervo(resumo):
    """Queda do rastreio do acervo depois do nascimento. Devolve (falha, nota)."""
    completos = dias_completos(resumo["horas_por_dia"])
    antes = [d for d in completos if d < NASCIMENTO_DA_SUPERFICIE]
    depois = [d for d in completos if d >= NASCIMENTO_DA_SUPERFICIE]
    if not antes:
        return None, "tripwire do acervo INCONCLUSIVO: nenhum dia completo anterior ao nascimento da superfície no log"
    valores_antes = sorted(resumo["bot_acervo_por_dia"].get(d, 0) for d in antes)
    meio = len(valores_antes) // 2
    referencia = valores_antes[meio] if len(valores_antes) % 2 else (valores_antes[meio - 1] + valores_antes[meio]) / 2
    if not depois:
        return None, (
            f"tripwire do acervo INCONCLUSIVO: nenhum dia COMPLETO após {NASCIMENTO_DA_SUPERFICIE}. "
            f"Referência já medida (mediana de {len(antes)} dia(s) completo(s) anteriores): {referencia:.0f} "
            "requisições de bot por dia. Atribuir à rede social uma queda anterior a ela seria falsa atribuição")
    ultimo = depois[-1]
    atual = resumo["bot_acervo_por_dia"].get(ultimo, 0)
    if referencia <= 0:
        return None, f"tripwire do acervo INCONCLUSIVO: a referência anterior é {referencia:.0f}, e não há do que cair"
    queda = (referencia - atual) / referencia
    nota = (f"tripwire do acervo: {atual} requisições de bot em {ultimo} contra referência {referencia:.0f} "
            f"({queda * 100:.1f}% de variação)")
    if queda > QUEDA_MAXIMA:
        return (agravo_da_queda(resumo, ultimo, atual, referencia, queda)), nota
    return None, nota


# Quantos agentes desaparecidos a mensagem nomeia. Três é o que cabe numa linha
# de relatório sem virar despejo; o resto vai no total.
AGENTES_NOMEADOS_NA_QUEDA = 3


def agravo_da_queda(resumo, dia, atual, referencia, queda):
    """A mensagem da queda, com a atribuição MEDIDA em vez de presumida.

    ★ POR QUE ESTA FUNÇÃO EXISTE

    Até 2026-09-05 o tripwire dizia, literalmente, "o rastreio do acervo caiu
    X% DEPOIS DO NASCIMENTO DA REDE SOCIAL" -- e nunca havia olhado para a rede
    social. Ele media uma queda real e lhe pendurava uma causa que não tinha
    medido: correlação temporal apresentada como atribuição.

    O caso concreto que expôs isso: em 2026-09-05 o gate acusou queda de 51,6%
    (2.106 contra 4.354) e culpou a rede social. Medido no mesmo ledger, no
    mesmo instante: `/redesocial/` recebeu ZERO requisições de bot nos três dias.
    Não há realocação possível para um destino que não recebeu nada. Quem saiu
    foram mj12bot (959 -> 0) e semrushbot (883 -> 47), dois crawlers de SEO
    comercial, ambos com 100% de HTTP 200 no último dia -- nem 429, nem bloqueio
    nosso: eles simplesmente pararam de vir.

    ★ O QUE ESTA FUNÇÃO NÃO FAZ, E É DELIBERADO

    Ela NÃO deixa de reprovar. Queda de 51% no rastreio é dado que alguém tem de
    olhar, e a R6 do contrato é explícita: queda de rastreio é defeito de
    engenharia até prova medida em contrário. Trocar o vermelho por verde porque
    a causa parece benigna seria exatamente o afrouxamento que o contrato chama
    de fraude de gate. O que muda é o gate parar de afirmar o que não mediu --
    e entregar, junto do vermelho, os nomes que apontam para onde investigar.
    """
    social = resumo.get("bot_social_por_dia", {}).get(dia, 0)
    if social > 0:
        atribuicao = (f"a rede social recebeu {social} requisição(ões) de bot em {dia}, "
                      "então realocação de orçamento de rastreio é hipótese VIVA e precisa ser medida "
                      "(o veredito de crescimento × canibalização exige as duas janelas de 14 dias)")
    else:
        atribuicao = ("NÃO é atribuível à rede social: ela recebeu ZERO requisição de bot em "
                      f"{dia}, e não há realocação possível para um destino que não recebeu nada")

    ontem_e_antes = sorted(d for d in resumo.get("acervo_por_agente_dia", {}) if d < dia)
    sumidos = []
    if ontem_e_antes:
        anterior = resumo["acervo_por_agente_dia"][ontem_e_antes[-1]]
        hoje = resumo["acervo_por_agente_dia"].get(dia, {})
        for agente, antes_n in sorted(anterior.items(), key=lambda par: -par[1]):
            depois_n = hoje.get(agente, 0)
            if antes_n > 0 and depois_n < antes_n / 2:
                sumidos.append(f"{agente} ({antes_n} -> {depois_n})")
    if sumidos:
        nomeados = ", ".join(sumidos[:AGENTES_NOMEADOS_NA_QUEDA])
        resto = len(sumidos) - AGENTES_NOMEADOS_NA_QUEDA
        quem = f"; agentes que caíram à metade ou menos: {nomeados}" + (f" e mais {resto}" if resto > 0 else "")
    else:
        quem = "; nenhum agente isolado explica a queda -- ela é difusa, o que aponta para causa comum (borda, robots, certificado)"

    return (f"o rastreio do acervo caiu {queda * 100:.1f}% ({atual} em {dia} contra referência "
            f"{referencia:.0f} dos dias completos anteriores; o teto do tripwire é "
            f"{QUEDA_MAXIMA * 100:.0f}%). {atribuicao}{quem}")


