# 3. Análise estática e cadeia de suprimento — os quatro que estavam vermelhos
#    e invisíveis há mais de um mês.
# ★ O NOME DO GATE E VALIDADO ANTES DE RODAR.
#
# `cmd/check` responde "unknown_check=<nome>" com exit 1 quando o nome nao
# existe -- e exit 1 e indistinguivel de "o gate reprovou". Medido em
# 2026-08-29: este proprio runner chamava `sca-osv-scan`, e o gate se chama
# `sca-osv`. Ele nunca rodou; aparecia como VERMELHO no ledger todo dia, e o
# vermelho era de nome errado, nao de vulnerabilidade. Um erro de digitacao
# virava relatorio de seguranca falso, nos dois sentidos: escondia o resultado
# real e enchia a serie de alarme que ninguem investigava.
#
# ★ A LISTA DE NOMES SE PEDE UMA VEZ, E PEDIR NUNCA EXECUTA GATE.
#
# Ate 2026-08-29 este bloco chamava `cmd/check <gate> --lista-nomes` por gate
# para validar o nome -- e a flag NAO EXISTIA: o parse devolvia exit 2, o `if`
# caia no fallback e o fallback rodava `cmd/check <gate>` INTEIRO so para ler a
# mensagem de erro. Os quatro gates de SCA (ate 900 s cada) eram executados DUAS
# VEZES por dia, e o dobro era invisivel porque a segunda execucao acontecia
# dentro de uma conferencia anunciada como "barata e nao roda o gate" (BUG-083
# da caca). A flag agora existe de verdade (cmd/check/main.go) e responde a lista
# completa, uma linha por nome, com exit 0 e sem executar check nenhum -- entao
# UMA invocacao valida os quatro nomes, em vez de quatro (ou oito) processos.
SCA_GATES="sca-govulncheck-evidence sca-staticcheck sca-gosec sca-osv"
NOMES_DE_GATE="$("$GO_MODERN" run ./cmd/check --lista-nomes 2>/dev/null || true)"
if [ -z "$NOMES_DE_GATE" ]; then
	# Sem a lista nao ha como distinguir "nome invalido" de "gate reprovou".
	# A degradacao correta e rodar cada gate UMA vez e dizer que a validacao de
	# nome nao aconteceu -- nunca rodar o gate duas vezes para descobrir.
	echo "qualidade-diaria: AVISO: cmd/check --lista-nomes nao respondeu; nomes de gate nao validados" >&2
fi
for gate in $SCA_GATES; do
	if [ -n "$NOMES_DE_GATE" ] && ! printf '%s\n' "$NOMES_DE_GATE" | grep -qx "$gate"; then
		echo "qualidade-diaria: NOME DE GATE INVALIDO: $gate (cmd/check nao o conhece)" >&2
		vermelhos="$vermelhos $gate(nome-invalido)"
		continue
	fi
	if [ "$gate" = "sca-staticcheck" ]; then
		roda_longa "$gate" 900 "$GO_MODERN" run ./cmd/check "$gate"
		continue
	fi
	roda "$gate" 900 "$GO_MODERN" run ./cmd/check "$gate"
done

