#!/usr/bin/env bash
# tools/run-qualidade-diaria — dá EXECUTOR à camada de qualidade do projeto.
#
# ★ POR QUE EXISTE (2026-08-29, BUG-066 e BUG-108 da caça)
#
# Medido: o projeto tem 23 timers systemd e NENHUM invoca gate de qualidade. O
# único arquivo do repo que menciona `cmd/check` fora de tools/ o faz num
# comentário. `grep -cE '\bgo test\b' .githooks/pre-commit` devolve 0. E o
# runner de suíte, tools/check-all, chamava `go test ./...` — padrão que NÃO
# EXPANDE aqui (var/nginx/* é 0700 e aborta o caminhador), logo testava ZERO
# pacote e reportava sucesso.
#
# Some-se a isso o que a mesma caça mediu: `sca-staticcheck` vermelho há 32
# dias, `sca-gosec` há 32 dias, `sca-osv` e `sca-sbom` há semanas — todos
# invisíveis, porque ninguém os executava. Gate que existe e não roda é igual a
# gate que não existe; este repositório já aprendeu isso com os 311 check-*
# órfãos, e a lição não tinha chegado à camada de qualidade do próprio código.
#
# ★ DESENHO
#
# Roda FORA do pre-commit, de propósito: a DEC-002 fixa o pré-commit leve, e
# encher o caminho do commit com suíte integral é o oposto do que ela decidiu.
# Aqui o custo cabe porque roda uma vez ao dia, em horário de baixa, com nice,
# ionice e flock — a mesma serialização que o repo já usa para comando pesado.
#
# NÃO aborta na primeira falha: o valor é o MAPA de quem está vermelho hoje, não
# o primeiro vermelho. Cada etapa tem timeout próprio e vira uma linha do ledger
# data/ops/qualidade_diaria.jsonl, para que a série mostre há quantos dias cada
# gate está caído — que é a informação que faltava para todos eles.
#
# Exit 0 = tudo verde. Exit 1 = há gate vermelho (o alerta ao dono sai pela
# unit, via OnFailure). Exit 2 = o próprio runner não conseguiu rodar.

set -u -o pipefail

# ---- PROTECAO CRASH->2 (2026-09-16). A unit que chama este script mascara
# exit 1 (`SuccessExitStatus=0 1`), porque 1 aqui e VEREDITO MEDIDO. Sem esta
# protecao, um script que MORRE com 1 — violacao de `set -u`, comando ausente —
# entrega o numero de quem mediu, a mascara o converte em `Result=success` e o
# OnFailure nunca dispara.
#
# `medidor_protege_exit` (e nao a trap ERR) porque este script NAO usa `set -e`:
# medido em 2026-09-16, a trap ERR nao dispara na violacao de `set -u`, e a trap
# EXIT dispara. Acrescentar `set -e` aqui mudaria a semantica de falha de todo
# comando do script, que e regressao proibida.
#
# Todo ponto de saida DELIBERADO com codigo 1 passa a chamar `medidor_sai 1`: e
# assim que a trap distingue "o autor decidiu sair com 1" de "o shell morreu".
. "$(dirname "${BASH_SOURCE[0]}")/lib/saida_de_medidor.sh"
medidor_protege_exit

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$RAIZ" || exit 2

LEDGER="$RAIZ/data/ops/qualidade_diaria.jsonl"
# ★ A SAIDA DO GATE VERMELHO PRECISA SOBREVIVER (2026-09-05).
#
# `roda` captura a saida inteira em $saida e o ledger guarda `tail -3` cortado em
# 300 chars. Medido: `journalctl -u wikijuridica-qualidade-diaria --since '8 days
# ago' | grep -c -- '--- FAIL'` devolve ZERO -- a saida nunca chegou ao journal,
# porque a substituicao de comando a desvia do stdout. Efeito: `suite-completa`
# esta vermelha em 7 de 7 execucoes e o detalhe registrado termina em "... ok
# portaljuridico/cmd/websub-ping 0.042s FAIL", sem o nome do pacote nem do teste.
# Sete dias de vermelho que ninguem consegue diagnosticar: o vigia media e jogava
# a prova fora, que e a mesma doenca dos 311 check-* orfaos que este arquivo
# existe para curar, agora sobre a propria evidencia.
GO_MODERN="$RAIZ/tools/go-modern"
NICE_LEVEL="${WIKI_QUALIDADE_NICE:-19}"
# ★ POR QUE NAO SE LIMITA O PARALELISMO DO `go test` AQUI (medido em 2026-09-05).
#
# A tentacao e' obvia: `go test` com varios pacotes executa GOMAXPROCS deles ao
# mesmo tempo (8 nesta maquina), e foi isso que levou o load a 24 na execucao de
# 01:43. `-p 4` pareceria a correcao cirurgica. NAO CABE, e a conta esta no
# proprio ledger data/ops/qualidade_diaria.jsonl:
#
#   suite-completa, com o -p padrao: 1.665 s (30/08), 1.612 s (01/09),
#   1.165 s (04/09), 1.134 s, 1.058 s, 844 s. PIOR CASO: 1.665 s.
#
# O `-timeout` interno desta etapa e' 1.800 s. A folga ja e' de 135 s -- 8%. Com
# -p 6 a estimativa vai a ~2.000 s e com -p 4 a ~2.500 s: as duas ESTOURAM, e
# estourar aqui e' pior que demorar, porque `roda()` classifica o estouro como
# "timeout", categoria que por desenho NAO entra na conta de vermelhos. Trocar
# pico de CPU por um gate que some do alerta e' o negocio errado, e afrouxar o
# `-timeout` para acomodar e' o que o contrato proibe.
#
# O mesmo raciocinio ja tinha derrubado `CPUQuota=` na unit, por simetria: la o
# estrangulado seria `checks-race-real-corpus` (1.301 s medidos contra teto de
# 1.650 s). As duas etapas mais caras desta varredura vivem perto do proprio
# teto; ela nao tem folga para ser estrangulada por nenhum instrumento.
#
# O QUE DE FATO RESOLVEU o incomodo do dono foi o HORARIO: o timer dizia
# `04:40 UTC` e rodava 01:40 local, em cima da madrugada de trabalho dele. Com
# `04:40` local (commit 3dd631b0) o pico acontece com a maquina ociosa, que e'
# a premissa sob a qual `nice -n 19` e `IOSchedulingClass=idle` funcionam.
AGORA="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
DIA="$(date -u +%Y-%m-%d)"
# DIA precisa nascer ANTES de ser usado abaixo: com `set -u` (linha 34), ler
# $DIA nesta mesma posição antes da atribuição original (medido nesta sessão,
# 2026-09-05) matava o script em "DIA: variável não associada" antes do
# primeiro gate — nenhuma linha no ledger, nenhum gate medido, o mesmo defeito
# que este arquivo inteiro existe para curar (gate que não roda = gate que não
# existe), agora dentro do próprio vigia.
DIAGNOSTICO="$RAIZ/.agents/runtime/qualidade-diaria/$DIA"

vermelhos=""
# Gate que ESTOUROU o relogio nao deu veredito nenhum. Ate 2026-09-04 ele saia
# da conta: `registra` so' somava a `vermelhos` o status "vermelho", entao um
# gate com status "timeout" desaparecia do alerta e o runner ainda imprimia
# "tudo verde" com exit 0. No limite, TODOS os 40+ gates podiam estourar e a
# saida seria "tudo verde" -- a mesma doenca dos 311 check-* orfaos que este
# arquivo inteiro existe para curar, agora por dentro do proprio vigia.
#
# Nao vira "vermelho" de proposito: o ramo do `panic: test timed out` acima
# documenta, com medicao, que relogio nao e' defeito, e chamar maquina lenta de
# pacote quebrado ja custou tres falsos vermelhos em internal/v2ingest. Entao
# ganha categoria propria: nao mede nada, nao acusa defeito, e IMPEDE que o
# runner afirme "tudo verde" sobre o que nao chegou a ser medido.
nao_medidos=""
etapas_json=""

# Pacotes-vitrine: os que servem a produção e os que guardam contrato. Rodam
# PRIMEIRO para que a falha mais cara apareça cedo — mas eles NÃO são o escopo,
# são a ordem.
LOTES_TESTE=(
	"./internal/render/ ./internal/seo/ ./internal/sitemap/ ./internal/htmlcontract/"
	"./internal/crawl/ ./internal/httpserver/ ./internal/publishedmanifest/"
	"./internal/checks/ ./internal/quality/ ./internal/publicrelease/"
	"./internal/webanalytics/ ./internal/pageinline/ ./internal/agentsurface/ ./internal/accessibilityaudit/"
)

# ★ POR QUE A SUÍTE COMPLETA VEM DEPOIS DOS LOTES (2026-08-29)
#
# A primeira versão deste script listava só os pacotes-vitrine, e essa lista
# envelheceu no MESMO DIA em que foi escrita: das dez áreas corrigidas na caça
# aos bugs, SEIS ficaram fora da lista — termpromotion, v2supersessionintegrity,
# legalsignature, proc, checkperformance e cmd/generate-noticia-pages. Teste
# escrito e não executado é exatamente o defeito que este repositório já
# catalogou nos 311 check-* órfãos: quem corrige um bug hoje deixa a prova
# cega para quem vier amanhã.
#
# Lista fixa de pacotes é dívida garantida. O escopo passa a ser DESCOBERTO:
# ./internal/... ./cmd/... cobre os 760 pacotes do módulo, e nenhum teste novo
# precisa ser inscrito à mão para ser executado. Os lotes acima continuam
# existindo pela ORDEM (falhar cedo no que mais dói), não pelo alcance.

registra() {
	local nome="$1" status="$2" exit_code="$3" ms="$4" detalhe="$5"
	[ "$status" = "vermelho" ] && vermelhos="$vermelhos $nome"
	[ "$status" = "timeout" ] && nao_medidos="$nao_medidos $nome"
	# `infra` (exit 75 = EX_TEMPFAIL) entra na MESMA coluna que timeout, e por
	# identidade de significado: nenhum dos dois mediu coisa alguma. Sem isto
	# um teste que sai 75 por falta de unit ou de rede vira etapa sem
	# categoria — nao conta como verde, nao aparece no alerta, nao entra em
	# nao_medidos: some. `cmd/wiki-ops` conta verdes e reconstroi nao_medidos
	# so quando o campo esta ausente, entao escrever a coluna aqui basta e o
	# leitor Go continua correto sem precisar aprender um status novo.
	[ "$status" = "infra" ] && nao_medidos="$nao_medidos $nome"
	local linha
	# O SANEAMENTO DO `detalhe` PRECISA COBRIR TODO BYTE DE CONTROLE, NAO SO' \n.
	#
	# Ate 2026-09-04 esta linha fazia `tr -d '"' | tr '\n' ' '`: tirava aspas e
	# quebra de linha, e deixava passar TAB (0x09) e os demais controles, que
	# `detalhe` recebe crus da saida do gate. Resultado medido: as SETE linhas
	# do ledger eram JSON INVALIDO -- `encoding/json` e `json.loads` recusam as
	# sete. A serie existe para responder "ha quantos dias este gate esta
	# caido", e um leitor honesto respondia "a serie esta vazia" sobre sete dias
	# de historia. O vigia registrava em cima do proprio ponto cego.
	#
	# Barra invertida tambem sai: `\` cru dentro de string JSON so' e' valido
	# como inicio de escape, e a saida de gate traz caminho do Windows e regex.
	# `tr '\000-\037' ' '` troca TODO controle por espaco -- inclusive \n, que
	# por isso nao precisa mais de regra propria.
	linha=$(printf '{"etapa":"%s","status":"%s","exit_code":%s,"duration_ms":%s,"detalhe":"%s"}' \
		"$nome" "$status" "$exit_code" "$ms" \
		"$(printf '%s' "$detalhe" | tr -d '"\\' | tr '\000-\037' ' ' | cut -c1-300)")
	etapas_json="${etapas_json:+$etapas_json,}$linha"
	printf 'qualidade-diaria: %-28s %-8s exit=%s %sms\n' "$nome" "$status" "$exit_code" "$ms"
}

# CARDINALIDADE ANTES DA AMOSTRA (2026-09-10). O teto de linhas por diagnostico
# existe para que uma saida degenerada nao encha o disco, e ate hoje o comentario
# de `roda()` afirmava que "o corte avisa que cortou". Ele nao avisava: `tail -N`
# imprime as ultimas N linhas em silencio, e o leitor do log nao tem como saber se
# esta vendo a saida inteira ou o rabo dela. Comentario que mente e bug (R1).
#
# E o corte e no COMECO, que e o pior lado para este runner: o `go test` despeja o
# stack de TODAS as goroutines quando o -timeout dispara, e a primeira falha — a
# que diz qual teste travou — fica no alto. Quem le 4000 linhas de stack sem saber
# que faltam 12.000 acima conclui sobre a amostra achando que e a populacao.
#
# Tres instrumentos deste repositorio erraram nisso no mesmo dia (`max_errors=200`,
# este `tail`, e o `--cobertura` invertido do rodizio de gates). A regra saiu dai:
# quem corta, declara quanto cortou, ANTES da amostra.
TETO_DE_DIAGNOSTICO=4000

corpo_com_corte() {
	# $1 = saida completa da etapa. Imprime a declaracao do corte e o rabo.
	local saida="$1" total omitidas
	total=$(printf '%s\n' "$saida" | wc -l)
	omitidas=0
	if [ "$total" -gt "$TETO_DE_DIAGNOSTICO" ]; then
		omitidas=$((total - TETO_DE_DIAGNOSTICO))
	fi
	printf '# linhas_totais=%s omitidas=%s (corte no COMECO, tail -%s)\n' \
		"$total" "$omitidas" "$TETO_DE_DIAGNOSTICO"
	printf '%s\n' "$saida" | tail -"$TETO_DE_DIAGNOSTICO"
}

roda() {
	local nome="$1" limite="$2"
	shift 2
	local inicio fim rc saida
	inicio=$(date +%s%3N)
	saida=$(timeout "$limite" nice -n "$NICE_LEVEL" ionice -c3 "$@" 2>&1)
	rc=$?
	fim=$(date +%s%3N)
	local ms=$((fim - inicio))
	# PROVA NO DISCO ANTES DE CLASSIFICAR. Vale para vermelho E para timeout: o
	# passo que estoura o relogio tambem deixa rastro (o `go test` despeja o stack
	# de todas as goroutines quando o -timeout dele dispara, e e' assim que se
	# descobre QUAL teste travou). Teto de 4000 linhas por etapa para que uma
	# saida degenerada nao encha o disco; `corpo_com_corte` declara quanto cortou.
	if [ "$rc" -ne 0 ]; then
		mkdir -p "$DIAGNOSTICO" 2>/dev/null
		{
			printf '# etapa=%s exit=%s duracao_ms=%s\n' "$nome" "$rc" "$ms"
			printf '# comando: %s\n' "$*"
			printf '# gravado em %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
			corpo_com_corte "$saida"
		} >"$DIAGNOSTICO/$nome.log" 2>/dev/null
	fi
	if [ "$rc" -eq 0 ]; then
		registra "$nome" verde 0 "$ms" ""
	elif [ "$rc" -eq 124 ]; then
		registra "$nome" timeout 124 "$ms" "estourou ${limite}"
	elif [ "$rc" -eq 75 ]; then
		# EX_TEMPFAIL: "nao consegui medir", nunca "o produto esta quebrado".
		# A convencao ja e usada no repositorio inteiro, e ate 2026-09-05 este
		# runner nao a conhecia: um gate sem cache, sem rede ou sem unit
		# instalada virava VERMELHO e ia para o alerta do dono como defeito.
		# Medido no mesmo dia: check-normative-fingerprint-selftest passa em 57
		# propriedades e nao exercita duas porque o cache do Planalto mora em
		# /tmp e nao sobrevive ao reboot — a "falha" era o disco vazio.
		#
		# Mesma categoria de timeout, e pelo mesmo motivo: nao mede nada, nao
		# acusa defeito, e IMPEDE que o runner afirme "tudo verde" sobre o que
		# nao chegou a ser medido.
		registra "$nome" infra 75 "$ms" "$(printf '%s' "$saida" | tail -2)"
	elif printf '%s' "$saida" | grep -q "panic: test timed out"; then
		# RELÓGIO NÃO É DEFEITO, e até 2026-08-29 este ledger não sabia disso.
		#
		# O `-timeout` do próprio `go test` é MENOR que a parede do `timeout`
		# (600s dentro de 900s; 1800s dentro de 2400s), de propósito: quando ele
		# dispara, o Go despeja o stack de todas as goroutines, que é como se
		# descobre QUAL teste travou. A parede não faz isso — ela mata e pronto.
		#
		# O preço era a classificação. O go test sai com rc=1 DENTRO da parede,
		# então o ramo de baixo registrava "vermelho" com as três últimas linhas
		# do stack como se fossem um defeito — e o ledger passava a acusar falha
		# onde só houve máquina lenta. Medido nesta sessão: internal/v2ingest
		# estourou 600s três vezes seguidas enquanto um deploy ocupava a máquina,
		# e as três apareceram como pacote quebrado.
		#
		# Agora o stack continua sendo produzido (o `-timeout` menor fica) e a
		# classificação passa a dizer a verdade: é tempo, não defeito. O nome do
		# teste travado entra na mensagem, porque é a única coisa acionável.
		local travado
		travado=$(printf '%s' "$saida" | grep -oE "^[a-zA-Z0-9_/.]+\.Test[A-Za-z0-9_]+" | head -1)
		registra "$nome" timeout 124 "$ms" "go test estourou o proprio -timeout (relogio, nao defeito)${travado:+; travado em $travado}"
	else
		registra "$nome" vermelho "$rc" "$ms" "$(printf '%s' "$saida" | tail -3)"
	fi
}

# `finaliza` PRECISA estar definida ANTES do branch `somente_longas` logo
# abaixo, que a chama em curto-circuito (`exit 0` no fim de si mesma). Bash
# não pré-varre definições de função: ele as declara na ordem em que as
# linhas são executadas. Até 2026-09-10 esta função vivia perto do fim do
# arquivo (seção 6f), e a chamada em `somente_longas` (escopo=longo, unit
# wikijuridica-qualidade-longa) rodava ANTES de a função existir —
# `linha 292: finaliza: comando não encontrado`, medido no journal de
# 2026-09-10 (execução das 02:10, PID 3211385). O erro não é fatal sob
# `set -u -o pipefail` sem `-e`, então o script seguia para o `exit 0` do
# próprio branch e mascarava dois defeitos de uma vez: nenhuma linha ia para
# o ledger na execução "longa" do dia, e o exit code ignorava
# suite-completa ter estourado o timeout (vermelho/nao_medido não
# classificado) — a unit reportava sucesso ao systemd mesmo com gate sem
# veredito. Definir aqui, logo após `roda()`/`registra()` e antes de
# qualquer chamador, é o que garante a função disponível nos três escopos
# (tudo, curto, longo) sem duplicar corpo nem reordenar por acaso de novo.
finaliza() {
	# 5. Ledger: a série é o produto. Sem ela não se sabe HÁ QUANTOS DIAS um gate
	#    está caído, que é exatamente a informação que faltava.
	mkdir -p "$(dirname "$LEDGER")"
	printf '{"data":"%s","checked_at":"%s","vermelhos":"%s","nao_medidos":"%s","etapas":[%s]}\n' \
		"$DIA" "$AGORA" "$(printf '%s' "$vermelhos" | sed 's/^ //')" \
		"$(printf '%s' "$nao_medidos" | sed 's/^ //')" "$etapas_json" >>"$LEDGER"

	if [ -n "$vermelhos" ]; then
		echo "qualidade-diaria: VERMELHO em:$vermelhos" >&2
		echo "qualidade-diaria: saida completa de cada etapa que falhou em $DIAGNOSTICO/" >&2
		[ -n "$nao_medidos" ] && echo "qualidade-diaria: NAO MEDIDO (relogio ou infra ausente) em:$nao_medidos" >&2
		echo "qualidade-diaria: série em $LEDGER" >&2
		medidor_sai 1
	fi
	if [ -n "$nao_medidos" ]; then
		# Nenhum gate acusou defeito, mas alguns nao chegaram a responder. Dizer
		# "tudo verde" aqui seria afirmar sobre o que nao foi medido.
		#
		# A coluna tem DUAS causas desde 2026-09-05 e a mensagem precisa dizer as
		# duas: relogio (timeout, exit 124) e infra ausente (EX_TEMPFAIL, exit 75 --
		# cache vazio, unit nao instalada, rede fora). Chamar de "estourou o
		# relogio" um cache vazio manda procurar lentidao onde nao ha.
		#
		# Este exit 1 NAO alerta o dono: a unit declara SuccessExitStatus=1, entao o
		# OnFailure so dispara em exit 2 (o runner nao conseguiu rodar). Verificado
		# em 2026-09-05, ao ligar os selftests. Na primeira passada completa saiu UM
		# `infra`, nao dois: `check-normative-fingerprint-selftest` (cache do
		# Planalto vazio, /tmp nao sobrevive ao reboot). O da atestacao do grafo
		# passou verde, porque a frente do v2ingest reatestou antes da varredura --
		# a guarda de pre-condicao que ele ganhou hoje so entra em cena enquanto o
		# worktree estiver com v2ingest modificado sem reatestar, que e estado de
		# trabalho e nao permanente. Transformar `infra` em alerta diario seria a
		# mordaca que test_notify_owner_mordaca.sh existe para travar.
		echo "qualidade-diaria: NAO MEDIDO (relogio ou infra ausente) em:$nao_medidos" >&2
		echo "qualidade-diaria: nenhum gate acusou defeito, mas os acima nao responderam" >&2
		echo "qualidade-diaria: série em $LEDGER" >&2
		medidor_sai 1
	fi
	echo "qualidade-diaria: tudo verde"
	exit 0
}

# ESCOPO: as tres etapas longas saem do caminho critico (2026-09-09).
#
# MEDIDO em 2026-09-09, journal da unit: a passada morreu em
# TimeoutStartSec=90min (04:46:05 -> 06:16:05) logo depois de `sca-gosec`, e 43
# das 55 etapas nomeadas NUNCA executaram — o maior "skip" da suite, e ele nao
# aparecia como skip em lugar nenhum. As tres mais lentas somam 54,6 min dos
# 68,7 medidos: suite-completa 2.400 s, teste-lote-3 609 s, sca-staticcheck
# 264 s. Sem elas sobram 14,1 min, folga de sobra para as 43 que morriam.
#
# NAO se aumenta o TimeoutStartSec (contrato, secao 4): reparticiona-se. O
# escopo padrao continua "tudo" para quem roda a mao; a unit diaria passa
# WIKI_QUALIDADE_ESCOPO=curto e a unit irma passa longo. Escopo desconhecido
# aborta em vez de silenciosamente rodar tudo — teto que ninguem le e teto que
# nao existe.
ESCOPO="${WIKI_QUALIDADE_ESCOPO:-tudo}"
case "$ESCOPO" in
tudo | curto | longo) ;;
*)
	echo "qualidade-diaria: WIKI_QUALIDADE_ESCOPO invalido: $ESCOPO (use tudo|curto|longo)" >&2
	exit 2
	;;
esac

# roda_longa e roda() com a regua do escopo. A etapa pulada e REGISTRADA como
# pulada, com o motivo: etapa que some sem linha no ledger e a cegueira que esta
# mudanca veio corrigir.
roda_longa() {
	local nome="$1"
	if [ "$ESCOPO" = "curto" ]; then
		registra "$nome" pulada 0 0 "fora do caminho critico: WIKI_QUALIDADE_ESCOPO=curto (roda em wikijuridica-qualidade-longa)"
		echo "qualidade-diaria: $nome PULADA (escopo=curto)"
		return 0
	fi
	roda "$@"
}

# No escopo "longo" roda-se SO as tres longas: as demais etapas ficam com a unit
# curta, e duplicar aqui seria pagar duas vezes pelo mesmo verde.
somente_longas() { [ "$ESCOPO" = "longo" ]; }

# teste-lote-3 e a unica etapa longa cujo nome depende do indice do laco; o
# helper mantem a regua num lugar so.
roda_longa_se_lote3() {
	local indice="$1" lote="$2"
	if [ "$indice" = "3" ]; then
		# shellcheck disable=SC2086
