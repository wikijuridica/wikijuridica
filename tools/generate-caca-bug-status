#!/usr/bin/env python3
"""generate-caca-bug-status — move um BUG da caça de aberto para fechado/refutado/parcial.

★ POR QUE EXISTE (2026-08-29)

A caça aos bugs catalogou 137 defeitos em três lugares que precisam concordar:
`docs/goal/BUGLOG.md` (registro canônico), `.agents/runtime/p0_frontboard.jsonl`
(tasks, de onde o contador é derivado) e `docs/goal/PLANO_CACA_BUGS_20260829.md`
(o plano vivo). Fechar um bug editando os três à mão, 137 vezes, produz
divergência garantida — e um contador que diverge da própria lista é exatamente
a R1 que o plano cobra dos outros.

Este gerador faz a transição de estado de forma atômica nos dois registros de
estado (BUGLOG e frontboard), exigindo EVIDÊNCIA. Sem `--evidencia`, ele recusa:
fechar bug sem prova é a fraude operacional que o contrato proíbe.

★ O QUE ELE NÃO FAZ

Não apaga linha nenhuma. `refutado` é status de sucesso — significa investigado
e derrubado por medição — e a linha fica registrada para ninguém reinvestigar.

Uso:
  tools/generate-caca-bug-status BUG-053 --status fechado \
      --evidencia 'check-untracked-product-inventory: exit 1 -> exit 0' \
      --commit b24db0f3
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
BUGLOG = RAIZ / "docs" / "goal" / "BUGLOG.md"
FRONTBOARD = RAIZ / ".agents" / "runtime" / "p0_frontboard.jsonl"

STATUS_VALIDOS = ("fechado", "parcial", "refutado", "doing", "todo")


def atualiza_frontboard(bug: str, status: str, evidencia: str, commit: str) -> bool:
    if not FRONTBOARD.exists():
        return False
    linhas = FRONTBOARD.read_text(encoding="utf-8").splitlines()
    achou = False
    for i, linha in enumerate(linhas):
        if not linha.strip():
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if registro.get("bug") != bug:
            continue
        registro["status"] = "done" if status in ("fechado", "refutado") else status
        registro["desfecho"] = status
        registro["evidencia_desfecho"] = evidencia
        if commit:
            registro["commit"] = commit
        linhas[i] = json.dumps(registro, ensure_ascii=False)
        achou = True
    if achou:
        FRONTBOARD.write_text("\n".join(linhas) + "\n", encoding="utf-8")
    return achou


def atualiza_buglog(bug: str, status: str, evidencia: str, commit: str) -> bool:
    if not BUGLOG.exists():
        return False
    texto = BUGLOG.read_text(encoding="utf-8")
    padrao = re.compile(
        r"(^## " + re.escape(bug) + r" —.*?^- \*\*Status:\*\* )(.*?)(?=\n)",
        re.MULTILINE | re.DOTALL,
    )
    rotulo = {
        "fechado": "FECHADO",
        "parcial": "parcialmente resolvido",
        "refutado": "REFUTADO (investigado e derrubado por medição — não era defeito)",
        "doing": "em correção",
        "todo": "aberto",
    }[status]
    sufixo = f" — {evidencia}" if evidencia else ""
    if commit:
        sufixo += f" (commit {commit})"
    novo = rotulo + sufixo + "."
    texto_novo, n = padrao.subn(lambda m: m.group(1) + novo, texto, count=1)
    if n:
        BUGLOG.write_text(texto_novo, encoding="utf-8")
    return bool(n)


def contador() -> dict[str, int]:
    contagem: dict[str, int] = {}
    if not FRONTBOARD.exists():
        return contagem
    for linha in FRONTBOARD.read_text(encoding="utf-8").splitlines():
        if '"fase": "caca-bugs-20260829"' not in linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            continue
        chave = registro.get("desfecho") or registro.get("status") or "todo"
        contagem[chave] = contagem.get(chave, 0) + 1
    return contagem


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("bug", nargs="?", help="ex.: BUG-053")
    parser.add_argument("--status", choices=STATUS_VALIDOS)
    parser.add_argument("--evidencia", default="", help="comando + resultado que prova o desfecho")
    parser.add_argument("--commit", default="", help="sha do commit que fechou")
    parser.add_argument("--contador", action="store_true", help="só imprime o placar")
    args = parser.parse_args()

    if args.contador:
        placar = contador()
        total = sum(placar.values())
        ordem = ("todo", "doing", "fechado", "parcial", "refutado", "done")
        partes = [f"{k}={placar[k]}" for k in ordem if k in placar]
        partes += [f"{k}={v}" for k, v in sorted(placar.items()) if k not in ordem]
        print(f"caça aos bugs: {total} tasks | " + " ".join(partes))
        return 0

    if not args.bug or not args.status:
        parser.error("informe o BUG e --status (ou use --contador)")
    if args.status in ("fechado", "refutado", "parcial") and not args.evidencia:
        print(
            "recusado: fechar/refutar exige --evidencia. "
            "Sem prova, o registro vira alegação — e alegação não fecha bug.",
            file=sys.stderr,
        )
        return 2

    ok_fb = atualiza_frontboard(args.bug, args.status, args.evidencia, args.commit)
    ok_bl = atualiza_buglog(args.bug, args.status, args.evidencia, args.commit)
    if not ok_fb and not ok_bl:
        print(f"{args.bug} não encontrado nem no frontboard nem no BUGLOG", file=sys.stderr)
        return 1
    print(
        f"{args.bug} → {args.status}"
        f" | frontboard={'ok' if ok_fb else 'AUSENTE'}"
        f" | buglog={'ok' if ok_bl else 'AUSENTE'}"
    )
    placar = contador()
    print("   placar: " + " ".join(f"{k}={v}" for k, v in sorted(placar.items())))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
