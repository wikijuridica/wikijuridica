def grapheme_count(text: str) -> int:
    """Clusters de grafema: uma base seguida de suas marcas combinantes."""
    normalized = unicodedata.normalize("NFC", text)
    count = 0
    for character in normalized:
        if unicodedata.combining(character) == 0:
            count += 1
    return count


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def existing_titles() -> dict[str, str]:
    """title -> intent_id de toda pagina ativa do estoque."""
    titles: dict[str, str] = {}
    for path in sorted(glob.glob(os.fspath(ROOT / PAGES_GLOB))):
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                record = json.loads(line)
                if record.get("skipped") is True:
                    continue
                title = (record.get("title") or "").strip()
                intent = record.get("intent_id") or ""
                if title:
                    titles[title] = intent
    return titles


def preflight() -> None:
    """Valida os 28 titles novos antes de qualquer escrita."""
    taken = existing_titles()
    problems: list[str] = []
    seen_new: dict[str, str] = {}
    for intent, (_rel, old, new) in sorted(REPAIRS.items()):
        graphemes = grapheme_count(new)
        runes = len(new)
        if not (MIN_TITLE <= graphemes <= MAX_TITLE):
            problems.append(f"{intent}: grafemas={graphemes} fora de {MIN_TITLE}-{MAX_TITLE}: {new!r}")
        if not (MIN_TITLE <= runes <= MAX_TITLE):
            problems.append(f"{intent}: runas={runes} fora de {MIN_TITLE}-{MAX_TITLE}: {new!r}")
        if grapheme_count(old) <= MAX_TITLE:
            problems.append(f"{intent}: title atual ja cabe na faixa ({grapheme_count(old)}); reparo desnecessario")
        if new in seen_new:
            problems.append(f"{intent}: title novo colide com {seen_new[new]}: {new!r}")
        seen_new[new] = intent
        owner = taken.get(new)
        if owner is not None and owner != intent:
            problems.append(f"{intent}: title novo ja usado por {owner}: {new!r}")
    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(REPAIRS)} titles novos dentro de {MIN_TITLE}-{MAX_TITLE} "
          f"grafemas/runas, unicos no estoque")


def by_file() -> dict[str, dict[str, tuple[str, str]]]:
    grouped: dict[str, dict[str, tuple[str, str]]] = {}
    for intent, (rel, old, new) in REPAIRS.items():
        grouped.setdefault(rel, {})[intent] = (old, new)
    return grouped


def apply_file(rel: str, wanted: dict[str, tuple[str, str]]) -> tuple[int, int]:
    path = ROOT / rel
    payload = path.read_bytes()
    lines = payload.decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    changed = 0
    already = 0
    seen: set[str] = set()
    output: list[str] = []
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{rel}: linha em branco {number}")
        record = json.loads(raw)
        intent = record.get("intent_id")
        if intent not in wanted:
            output.append(raw)
            continue
        seen.add(intent)
        old, new = wanted[intent]
        current = record.get("title")
        if current == new:
            already += 1
            output.append(raw)
            continue
        if current != old:
            raise SystemExit(
                f"CAS de campo falhou {rel}:{number} intent={intent} "
                f"title esperado={old!r} atual={current!r}"
            )
        if (record.get("h1") or "").strip() == new:
            raise SystemExit(f"{rel}:{number} intent={intent}: title novo igual ao h1")
        record["title"] = new
        output.append(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
        changed += 1

    missing = sorted(set(wanted) - seen)
    if missing:
        raise SystemExit(f"{rel}: intents nao encontrados: {missing}")
    if changed == 0:
        return 0, already

    rewritten = "\n".join(output)
    if trailing_newline:
        rewritten += "\n"
    if path.read_bytes() != payload:
        raise SystemExit(f"{rel}: mudou durante a transacao - abortado")
    atomic_write(path, rewritten.encode("utf-8"))
    return changed, already


def main() -> int:
    preflight()
    total_changed = 0
    total_already = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for rel, wanted in sorted(by_file().items()):
                    changed, already = apply_file(rel, wanted)
                    total_changed += changed
                    total_already += already
                    print(f"shard={rel} reparados={changed} ja_aplicados={already}")
    except StockEpochBusy as error:
        print(f"title-length-repair: canonical stock busy: {error}", file=sys.stderr)
        return 75
    print(f"total reparados={total_changed} ja_aplicados={total_already} alvo={len(REPAIRS)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
