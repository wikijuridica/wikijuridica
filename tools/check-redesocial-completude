#!/usr/bin/env bash
# check-redesocial-completude — o guardiao contra entrega pela metade.
#
# POR QUE ELE EXISTE (ordem do dono, 2026-09-04): "so me da o plano com ele
# 100% implementado e sem bugs (...) e o guardiao nao deixar voce entregar
# trabalho pela metade e com bugs".
#
# content/redesocial_entregas.json lista as entregas do PLANO_REDE_SOCIAL com a
# prova conferivel de cada uma. Este gate reprova quando uma entrega marcada
# "entregue" NAO tem a prova no disco: pacote Go ausente ou sem fonte, arquivo
# ausente ou vazio, gate sem nome na lista ou sem `case` no switch, simbolo
# inexistente, texto ausente, testes com corpo abaixo do minimo, ou marcador de
# stub no codigo do pacote.
#
# O QUE ELE NAO FAZ, E E DE PROPOSITO: entrega marcada "pendente" nao reprova
# aqui. Um gate vermelho de F0 ate F6 seria o vermelho permanente que ninguem
# le, e a DEC-045 mediu onde isso da: 273 falhas acumuladas no
# codex2-policy-enforcement sem ninguem notar. Pendencia e cobrada pelo gate
# irmao, que se roda ao declarar o trabalho pronto:
#
#   ./tools/go-modern run ./cmd/check redesocial-entrega-final
#
# Ou seja: este aqui reprova MENTIRA; aquele reprova TRABALHO QUE FALTA.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e nao `go-modern run ./cmd/check` direto: e por ele que passam o
# cache do binario, o teto de tempo e a politica de argumentos.
exec "$ROOT/tools/run-check" redesocial-completude "$@"
