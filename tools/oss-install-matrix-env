#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_OSS_PYTHON_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/oss-python-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-oss-python-venv"
if [[ -n "${WIKI_OSS_PYTHON_VENV:-}" ]]; then
	VENV="$WIKI_OSS_PYTHON_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
# BUG-098: os modelos do Stanza (centenas de MB baixados) passam a ter
# default persistente, e no MESMO diretorio que o par
# tools/{check,generate}-ptbr-morphsyntax-evidence ja usa — nao se cria um
# terceiro local para o mesmo download. O legado em /tmp continua valendo
# enquanto existir; STANZA_RESOURCES_DIR e WIKI_STANZA_RESOURCES_DIR vencem.
STANZA_PERSISTENT_DEFAULT="$ROOT/.cache/ptbr-morphsyntax-stanza-resources"
STANZA_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-stanza-resources"
if [[ -n "${STANZA_RESOURCES_DIR:-}" ]]; then
	STANZA_DIR="$STANZA_RESOURCES_DIR"
elif [[ -n "${WIKI_STANZA_RESOURCES_DIR:-}" ]]; then
	STANZA_DIR="$WIKI_STANZA_RESOURCES_DIR"
elif [[ -d "$STANZA_LEGACY_DEFAULT" ]]; then
	STANZA_DIR="$STANZA_LEGACY_DEFAULT"
else
	STANZA_DIR="$STANZA_PERSISTENT_DEFAULT"
fi
# Raiz persistente: o systemd limpa /tmp no boot e tantivy/sonic/quickwit levam
# minutos para reinstalar (compilacao cargo / download), entao nao se qualificam
# como "cache regeneravel em segundos" — regra do dono, produto nunca mora em
# /tmp. WIKI_OSS_CARGO_ROOT continua sobrepondo; o default agora vive dentro do
# repo (gitignored, ver .gitignore), no mesmo caminho que
# internal/ossinstallmatrix/matrix.go usa como busca padrao.
CARGO_ROOT="${WIKI_OSS_CARGO_ROOT:-$ROOT/.agents/runtime/oss-cargo}"
# ★ Defeito medido (BUG-098): este wrapper chama tools/htmltest-release-env
# (linha abaixo), que instala em "$ROOT/.cache/tools" desde o BUG-067, mas
# exportava WIKI_HTMLTEST_BIN apontando para /tmp/opt-wiki-tools — instalava
# num lugar e anunciava outro. O default passa a ser o mesmo do irmao;
# WIKI_HTMLTEST_BIN_DIR (a mesma variavel que ele le) continua vencendo, e o
# /tmp legado segue coberto por ossBinarySearchDirs em
# internal/ossinstallmatrix/matrix.go.
HTMLTEST_BIN_DIR="${WIKI_HTMLTEST_BIN_DIR:-$ROOT/.cache/tools}"
HTMLTEST_BIN="$HTMLTEST_BIN_DIR/htmltest"
CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
PYTHON_QUALITY_SCA_REQ="$ROOT/tools/requirements-python-quality-sca.txt"
ZIZMOR_WORKFLOW_SECURITY_REQ="$ROOT/tools/requirements-zizmor-workflow-security.txt"
SONIC_PINNED_PREBUILT_URL="https://github.com/valeriansaliou/sonic/releases/download/v1.7.0/v1.7.0-x86_64-gnu.tar.gz"
SONIC_PINNED_PREBUILT_SHA256="f658d5a135dd1890f2eec9e6cbb13a552ae0dd9ad88a9e9390d685db2d54b1b3"
SONIC_PREBUILT_URL="${WIKI_OSS_SONIC_PREBUILT_URL:-$SONIC_PINNED_PREBUILT_URL}"
SONIC_PREBUILT_SHA256="${WIKI_OSS_SONIC_PREBUILT_SHA256:-$SONIC_PINNED_PREBUILT_SHA256}"
QUICKWIT_INSTALL_SCRIPT_URL="${WIKI_OSS_QUICKWIT_INSTALL_SCRIPT_URL:-https://install.quickwit.io}"
TARGETS="${WIKI_OSS_INSTALL_MATRIX_TARGETS:-full}"

# AO SAIR PARA A REDE, O PORTAL E O WikijuridicaBot (CLAUDE.md secao 11, ordem
# do dono de 2026-09-05). Ate 2026-09-10 os dois downloads deste instalador
# saiam como `curl/8.x` para github.com e install.quickwit.io. O proposito e'
# proprio — instalacao de ferramenta, nao coleta de fonte nem submissao de URL —
# e a forma e' a que `internal/wikijuridicabot.UserAgentComProposito` produziria.
# A integridade continua sendo do SHA-256 fixado logo acima; o User-Agent nao
# substitui nenhuma verificacao, ele apenas nomeia quem baixa.
UA_SAIDA="Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/; instalacao-de-ferramenta)"
SEARCH_BACKEND_BINARIES_ONLY=0
case "$TARGETS" in
"full" | "")
	;;
"search-backend-binaries")
	SEARCH_BACKEND_BINARIES_ONLY=1
	;;
*)
	printf 'oss-install-matrix-env: unknown WIKI_OSS_INSTALL_MATRIX_TARGETS=%s\n' "$TARGETS" >&2
	exit 1
	;;
esac

OSS_INSTALL_FALHAS="${WIKI_OSS_INSTALL_FALHAS:-$CARGO_ROOT/falhas-de-instalacao.jsonl}"
# Quanto tempo uma falha por causa UPSTREAM vale antes de valer a pena tentar de
# novo. Crate abandonado em 2018 e subdominio retirado do DNS nao mudam de hora
# em hora; 24 h e curto o bastante para nao cristalizar um veredito e longo o
# bastante para nao repetir minutos de cargo a cada invocacao.
OSS_FALHA_TTL_SEGUNDOS="${WIKI_OSS_FALHA_TTL_SEGUNDOS:-86400}"
RUSTC_ID="$(rustc --version 2>/dev/null || echo sem-rustc)"

registra_falha_de_instalacao() {
	local crate="$1" versao="$2" motivo="$3"
	mkdir -p "$(dirname "$OSS_INSTALL_FALHAS")" 2>/dev/null || return 0
	printf '{"quando":"%s","epoch":%s,"crate":"%s","versao":"%s","rustc":"%s","motivo":"%s"}\n' \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date -u +%s)" "$crate" "$versao" "$RUSTC_ID" "$motivo" \
		>>"$OSS_INSTALL_FALHAS" 2>/dev/null || true
	printf 'oss-install-matrix-env: %s@%s nao instalou (%s); a matriz segue e o registra como ausente\n' \
		"$crate" "$versao" "$motivo" >&2
}

# FALHA UPSTREAM RECENTE NAO SE RETENTA A CADA INVOCACAO, e o motivo e medido.
#
# `run-go-cmd-cached` executa a sonda de identidade do Go ATRAVES deste wrapper
# (`run_go_tool_bounded` -> `"$ENV_WRAPPER" go-modern version`, com teto de
# poucos segundos). Uma instalacao que NUNCA vai dar certo — `cargo install`
# que compila minutos ate o E0119, `curl` num host que saiu do DNS — era paga
# outra vez a cada chamada, inclusive nessa sonda: o wrapper so alcancava o
# `exec "$@"` depois de minutos, e a sonda estourava o teto. Resultado medido em
# 2026-09-10: `generate-oss-installation-matrix` devolvia exit 75 com
# "could not authenticate bounded Go version for fast cache" numa maquina
# ociosa, com `go version` custando 0,047 s.
#
# Isto NAO e aumentar timeout — e nao repetir trabalho que ja se sabe que
# falha. A guarda expira sozinha (TTL) e e invalidada por troca de rustc, que e
# a unica coisa que poderia mudar o veredito do tantivy. `WIKI_OSS_REPETIR_FALHAS=1`
# forca a tentativa.
#
# MAS O RELOGIO NAO E A UNICA INVALIDACAO, e para o quickwit ele e o KEY ERRADO.
# A causa registrada la nao e o compilador: e `install.quickwit.io` ter saido do
# DNS. Trocar de rustc nao muda nada nisso, entao o unico caminho de volta seria
# esperar o TTL — o host podia voltar as 9h e a guarda continuaria pulando ate as
# 16h27 do dia seguinte. Quem sabe a resposta e o proprio DNS, e perguntar custa
# 0,01-0,05 s medidos (`getent hosts`, 3 amostras em 2026-09-10).
#
# A precondicao e amarrada a CAUSA que esta escrita no ledger, nunca ao crate:
# so levanta a guarda quando o motivo do registro mais novo casa o marcador E a
# precondicao diz que aquela causa se desfez. Sem esse par, um quickwit que
# voltasse ao DNS e falhasse por OUTRO motivo (404 no asset, tarball corrompida)
# passaria a pagar um `curl` a cada invocacao para sempre — que e exatamente o
# custo que esta guarda existe para nao pagar.
#
# Uso: falha_upstream_recente <crate> <versao> [marcador_da_causa comando...]
causa_dns_resolvida() {
	local host="$1"
	[[ -n "$host" ]] || return 1
	timeout 2 getent hosts "$host" >/dev/null 2>&1
}

host_da_url() {
	local url="${1#*://}"
	url="${url%%/*}"
	url="${url%%\?*}"
	printf '%s' "${url%%:*}"
}

falha_upstream_recente() {
	local crate="$1" versao="$2" marcador="${3:-}"
	if (($# > 3)); then
		shift 3
	else
		shift $#
	fi
	[[ "${WIKI_OSS_REPETIR_FALHAS:-0}" == "1" ]] && return 1
	[[ -f "$OSS_INSTALL_FALHAS" ]] || return 1
	local agora motivo
	agora="$(date -u +%s)"
	# O awk imprime o motivo do registro MAIS NOVO dentro do TTL; sem registro
	# em vigor ele sai 1 e a funcao devolve "nao ha falha recente".
	motivo="$(awk -v crate="$crate" -v versao="$versao" -v rustc="$RUSTC_ID" \
		-v agora="$agora" -v ttl="$OSS_FALHA_TTL_SEGUNDOS" '
		index($0, "\"crate\":\"" crate "\"") == 0 { next }
		index($0, "\"versao\":\"" versao "\"") == 0 { next }
		index($0, "\"rustc\":\"" rustc "\"") == 0 { next }
		{
			epoch = $0
			sub(/.*"epoch":/, "", epoch)
			sub(/[^0-9].*/, "", epoch)
			if (epoch == "" || agora - epoch >= ttl) { next }
			if (achou && epoch + 0 < melhor + 0) { next }
			melhor = epoch
			motivo = $0
			sub(/.*"motivo":"/, "", motivo)
			sub(/"[^"]*$/, "", motivo)
			achou = 1
		}
		END { if (achou) print motivo; exit(achou ? 0 : 1) }
	' "$OSS_INSTALL_FALHAS")" || return 1
	if [[ -n "$marcador" && "$motivo" == *"$marcador"* ]] && (($# > 0)) && "$@"; then
		printf 'oss-install-matrix-env: %s@%s retentado (a causa registrada — %s — nao vale mais)\n' \
			"$crate" "$versao" "$marcador" >&2
		return 1
	fi
	return 0
}

# AUTOTESTE — roda ANTES do provisionamento, de proposito.
#
# O que ele cobre e a decisao de PULAR, que e a parte com consequencia: pular de
# menos custa minutos de cargo na sonda sub-segundo do `run-go-cmd-cached`;
# pular de mais cristaliza um veredito e esconde um upstream que voltou. O bloco
# fica aqui, e nao depois das instalacoes, porque um teste que paga o
# provisionamento inteiro para conferir uma decisao de milissegundos nao entra
# em suite nenhuma.
if [[ "${WIKI_OSS_AUTOTESTE:-0}" == "1" ]]; then
	autoteste_falhas=0
	autoteste_ledger="$(mktemp)"
	trap 'rm -f "$autoteste_ledger"' EXIT
	OSS_INSTALL_FALHAS="$autoteste_ledger"
	RUSTC_ID="rustc 1.93.0 (teste)"
	agora_teste="$(date -u +%s)"

	autoteste_caso() {
		local nome="$1" esperado="$2"
		shift 2
		local obtido=0
		if falha_upstream_recente "$@" 2>/dev/null; then obtido=1; fi
		if [[ "$obtido" == "$esperado" ]]; then
			printf 'ok   %s\n' "$nome"
		else
			printf 'FALHA %s: esperado pular=%s, obtido pular=%s\n' "$nome" "$esperado" "$obtido" >&2
			autoteste_falhas=$((autoteste_falhas + 1))
		fi
	}

	sim() { return 0; }
	nao() { return 1; }

	: >"$autoteste_ledger"
	autoteste_caso "ledger vazio nao pula" 0 quickwit prebuilt

	printf '{"quando":"x","epoch":%s,"crate":"quickwit","versao":"prebuilt","rustc":"%s","motivo":"upstream: install.quickwit.io saiu do DNS"}\n' \
		"$agora_teste" "$RUSTC_ID" >"$autoteste_ledger"
	autoteste_caso "falha recente sem precondicao pula" 1 quickwit prebuilt
	autoteste_caso "causa desfeita retenta" 0 quickwit prebuilt "saiu do DNS" sim
	autoteste_caso "causa em pe continua pulando" 1 quickwit prebuilt "saiu do DNS" nao
	autoteste_caso "marcador que nao casa a causa nao levanta a guarda" 1 quickwit prebuilt "E0119" sim
	WIKI_OSS_REPETIR_FALHAS=1 autoteste_caso "REPETIR_FALHAS=1 ignora a guarda" 0 quickwit prebuilt

	printf '{"quando":"x","epoch":%s,"crate":"quickwit","versao":"prebuilt","rustc":"outro rustc","motivo":"upstream: install.quickwit.io saiu do DNS"}\n' \
		"$agora_teste" >"$autoteste_ledger"
	autoteste_caso "rustc diferente invalida" 0 quickwit prebuilt

	printf '{"quando":"x","epoch":%s,"crate":"quickwit","versao":"prebuilt","rustc":"%s","motivo":"upstream: install.quickwit.io saiu do DNS"}\n' \
		"$((agora_teste - 90000))" "$RUSTC_ID" >"$autoteste_ledger"
	autoteste_caso "registro fora do TTL nao pula" 0 quickwit prebuilt

	# O motivo lido e o do registro MAIS NOVO, nao o da primeira linha: um
	# quickwit que saiu do DNS e depois falhou por outro motivo nao pode ter a
	# guarda levantada pela sonda de DNS.
	{
		printf '{"quando":"x","epoch":%s,"crate":"quickwit","versao":"prebuilt","rustc":"%s","motivo":"upstream: install.quickwit.io saiu do DNS"}\n' \
			"$((agora_teste - 600))" "$RUSTC_ID"
		printf '{"quando":"x","epoch":%s,"crate":"quickwit","versao":"prebuilt","rustc":"%s","motivo":"upstream: asset da release devolveu 404"}\n' \
			"$agora_teste" "$RUSTC_ID"
	} >"$autoteste_ledger"
	autoteste_caso "motivo lido e o do registro mais novo" 1 quickwit prebuilt "saiu do DNS" sim

	# `host_da_url` alimenta a precondicao, entao erro nela vira retentativa
	# eterna ou guarda eterna, dependendo do lado.
	autoteste_host() {
		local url="$1" esperado="$2" obtido
		obtido="$(host_da_url "$url")"
		if [[ "$obtido" == "$esperado" ]]; then
			printf 'ok   host_da_url %s\n' "$url"
		else
			printf 'FALHA host_da_url %s: esperado %s, obtido %s\n' "$url" "$esperado" "$obtido" >&2
			autoteste_falhas=$((autoteste_falhas + 1))
		fi
	}
	autoteste_host "https://install.quickwit.io" "install.quickwit.io"
	autoteste_host "https://install.quickwit.io/sh" "install.quickwit.io"
	autoteste_host "http://exemplo.test:8080/x?y=1" "exemplo.test"

	if ((autoteste_falhas > 0)); then
		printf 'AUTOTESTE oss-install-matrix-env: %s falha(s)\n' "$autoteste_falhas" >&2
		exit 1
	fi
	printf 'AUTOTESTE oss-install-matrix-env OK: 12 casos\n'
	exit 0
fi

if [[ "${WIKI_OSS_INSTALL_MATRIX_NO_INSTALL:-}" == "1" ]]; then
	export PATH="$HTMLTEST_BIN_DIR:$CARGO_ROOT/bin:$HOME/.cargo/bin:$PATH"
	export WIKI_OSS_PYTHON="$PY"
	export WIKI_OSS_BIN_DIR="$HTMLTEST_BIN_DIR:$CARGO_ROOT/bin:$HOME/.cargo/bin"
	export WIKI_HTMLTEST_BIN="${WIKI_HTMLTEST_BIN:-$HTMLTEST_BIN}"
	export WIKI_STANZA_RESOURCES_DIR="$STANZA_DIR"
	export STANZA_RESOURCES_DIR="$STANZA_DIR"
	export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
	exec "$@"
fi

if [[ "$SEARCH_BACKEND_BINARIES_ONLY" != "1" ]]; then
	if [[ ! -x "$PY" ]]; then
		python3 -m venv "$VENV"
	fi

	REQ_HASH="$(sha256sum "$ROOT/tools/requirements-oss-install-matrix.txt" "$PYTHON_QUALITY_SCA_REQ" "$ZIZMOR_WORKFLOW_SECURITY_REQ" | sha256sum | awk '{print $1}')"
	PY_MARKER="$VENV/.requirements-oss-install-matrix-$REQ_HASH.ok"
	if [[ ! -f "$PY_MARKER" ]]; then
		# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
		# `user = true` como padrao, e dentro de um venv o pip recusa com
		# "Can not perform a '--user' install. User site-packages are not
		# visible in this virtualenv." Instalar no user-site NUNCA e o que um
		# venv pinado quer — a variavel afirma a intencao, nao contorna a
		# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
		# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
		PIP_USER=0 "$PY" -m pip install --disable-pip-version-check --prefer-binary -r "$ROOT/tools/requirements-oss-install-matrix.txt" -r "$PYTHON_QUALITY_SCA_REQ"
		rm -f "$VENV"/.requirements-oss-install-matrix-*.ok
		touch "$PY_MARKER"
	fi
	"$ROOT/tools/zizmor-workflow-security-env" true
	"$ROOT/tools/htmltest-release-env" true

	STANZA_MARKER="$STANZA_DIR/.pt-stanza-oss-install-matrix-$REQ_HASH.ok"
	if [[ ! -f "$STANZA_MARKER" ]]; then
		mkdir -p "$STANZA_DIR"
		"$PY" - <<PY
import stanza
stanza.download("pt", processors="tokenize,mwt,pos,lemma,depparse", model_dir="$STANZA_DIR", verbose=False)
PY
		rm -f "$STANZA_DIR"/.pt-stanza-oss-install-matrix-*.ok
		touch "$STANZA_MARKER"
	fi
fi

mkdir -p "$CARGO_ROOT/bin"
export PATH="$HTMLTEST_BIN_DIR:$CARGO_ROOT/bin:$HOME/.cargo/bin:$PATH"
export WIKI_OSS_BIN_DIR="$HTMLTEST_BIN_DIR:$CARGO_ROOT/bin:$HOME/.cargo/bin"
export WIKI_HTMLTEST_BIN="${WIKI_HTMLTEST_BIN:-$HTMLTEST_BIN}"
export CARGO_BUILD_JOBS

cargo_install_required() {
	local crate="$1"
	local version="$2"
	if command -v flock >/dev/null 2>&1; then
		flock "$CARGO_ROOT/.cargo-install.lock" cargo install "$crate" --version "$version" --locked --root "$CARGO_ROOT"
	else
		cargo install "$crate" --version "$version" --locked --root "$CARGO_ROOT"
	fi
}

sonic_prebuilt_install_required() {
	local tmp archive extract
	for tool in curl sha256sum tar install; do
		command -v "$tool" >/dev/null 2>&1 || return 1
	done
	case "$SONIC_PREBUILT_URL" in
	"$SONIC_PINNED_PREBUILT_URL")
		if [[ "$SONIC_PREBUILT_SHA256" != "$SONIC_PINNED_PREBUILT_SHA256" ]]; then
			printf 'oss-install-matrix-env: Sonic prebuilt SHA override rejected for pinned URL\n' >&2
			return 1
		fi
		;;
	file://*)
		if [[ "${WIKI_OSS_ALLOW_LOCAL_SONIC_PREBUILT:-}" != "1" ]]; then
			printf 'oss-install-matrix-env: local Sonic prebuilt override requires WIKI_OSS_ALLOW_LOCAL_SONIC_PREBUILT=1\n' >&2
			return 1
		fi
		;;
	*)
		printf 'oss-install-matrix-env: Sonic prebuilt URL override rejected: %s\n' "$SONIC_PREBUILT_URL" >&2
		return 1
		;;
	esac
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/opt-wiki-sonic-prebuilt.XXXXXX")" || return 1
	archive="$tmp/sonic.tar.gz"
	extract="$tmp/extract"
	mkdir -p "$extract" || {
		rm -rf "$tmp"
		return 1
	}
	if ! curl -fL --retry 3 --retry-delay 2 -A "$UA_SAIDA" -o "$archive" "$SONIC_PREBUILT_URL"; then
		rm -rf "$tmp"
		return 1
	fi
	if ! printf '%s  %s\n' "$SONIC_PREBUILT_SHA256" "$archive" | sha256sum -c -; then
		rm -rf "$tmp"
		return 1
	fi
	if ! tar -xzf "$archive" -C "$extract"; then
		rm -rf "$tmp"
		return 1
	fi
	if [[ ! -x "$extract/sonic/sonic" ]]; then
		rm -rf "$tmp"
		return 1
	fi
	if ! install -m 0755 "$extract/sonic/sonic" "$CARGO_ROOT/bin/sonic"; then
		rm -rf "$tmp"
		return 1
	fi
	if ! "$CARGO_ROOT/bin/sonic" --version >/dev/null 2>&1; then
		rm -rf "$tmp"
		return 1
	fi
	rm -rf "$tmp"
	return 0
}

quickwit_prebuilt_install_required() {
	local tmp quickwit_bin
	for tool in curl find install; do
		command -v "$tool" >/dev/null 2>&1 || return 1
	done
	case "$QUICKWIT_INSTALL_SCRIPT_URL" in
	"https://install.quickwit.io" | file://*)
		;;
	*)
		printf 'oss-install-matrix-env: Quickwit install script override rejected: %s\n' "$QUICKWIT_INSTALL_SCRIPT_URL" >&2
		return 1
		;;
	esac
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/opt-wiki-quickwit-prebuilt.XXXXXX")" || return 1
	if ! (cd "$tmp" && curl -L -A "$UA_SAIDA" "$QUICKWIT_INSTALL_SCRIPT_URL" | sh); then
		rm -rf "$tmp"
		return 1
	fi
	quickwit_bin="$(find "$tmp" -type f -name quickwit -perm /111 -print -quit || true)"
	if [[ -z "$quickwit_bin" ]]; then
		rm -rf "$tmp"
		return 1
	fi
	if ! install -m 0755 "$quickwit_bin" "$CARGO_ROOT/bin/quickwit"; then
		rm -rf "$tmp"
		return 1
	fi
	if ! "$CARGO_ROOT/bin/quickwit" --version >/dev/null 2>&1; then
		rm -rf "$tmp"
		return 1
	fi
	rm -rf "$tmp"
	return 0
}

# TANTIVY-CLI NAO COMPILA EM NENHUM rustc MODERNO, e a causa e upstream —
# medida em 2026-09-10, nao presumida.
#
#   cargo install tantivy-cli --version 0.24.0 --locked  =>  exit 101
#   error[E0119]: conflicting implementations of trait `Trait`
#                 for type `(dyn Send + Sync + 'static)`   (3x)
#   error: could not compile `traitobject` (lib)
#
# A cadeia, conferida uma a uma na API do crates.io:
#
#   tantivy-cli 0.24.0 -> iron ^0.6        (NAO opcional)
#   iron 0.6.1         -> typemap          (ultima versao 2015-12-16)
#   typemap 0.3.3      -> unsafe-any ^0.4  (ultima versao 2017-05-25)
#   unsafe-any 0.4.2   -> traitobject ^0.1 (ultima versao 2018)
#
# Tres coisas seguem dai, e cada uma fecha uma saida:
#  - NAO ha versao mais nova para onde ir: 0.24.0 e o `max_version` do crate.
#  - NAO ha feature a desligar: `iron` e dependencia NAO opcional, entao
#    `--no-default-features` nao a remove.
#  - NAO e defeito de ambiente nem do rustc desta maquina: o E0119 e a rejeicao
#    correta de impls sobrepostas num crate abandonado em 2018.
#
# POR QUE ISSO DEIXOU DE ABORTAR O WRAPPER INTEIRO. Com `set -eu`, a falha do
# `cargo install` matava este script ANTES do `exec "$@"` — e a matriz nunca
# rodava. Resultado: um candidato ininstalavel por causa upstream cegava a
# medicao dos OUTROS backends (sonic, quickwit), e o gate reportava um exit 101
# opaco em vez de "1 dependencia ausente, com o motivo". A matriz JA sabe lidar
# com binario ausente — `BuildEvidenceWithProbe` conta `missing_count` e lista
# `missing_dependency_ids`. Entao a tentativa continua sendo feita, a falha
# passa a ser REGISTRADA, e a matriz segue medindo o que da para medir.
#
# Isto NAO afrouxa o gate: `tantivy-cli-sidecar` continua entrando como ausente
# e o veredito continua vermelho. O que muda e o gate passar a dizer QUAL
# dependencia falta e POR QUE, em vez de morrer sem evidencia.
#
# Trocar o backend de busca (usar a lib `tantivy` 0.26.2, mantida, em vez do
# CLI) continua sendo ADR — dependencia nova que afeta runtime, com licenca,
# versao fixada e benchmark 10k/100k.
if ! command -v tantivy >/dev/null 2>&1; then
	if falha_upstream_recente tantivy-cli 0.24.0; then
		printf 'oss-install-matrix-env: tantivy-cli@0.24.0 pulado (falha upstream registrada nas ultimas %ss, mesmo rustc)\n' \
			"$OSS_FALHA_TTL_SEGUNDOS" >&2
	elif ! cargo_install_required tantivy-cli 0.24.0; then
		registra_falha_de_instalacao tantivy-cli 0.24.0 \
			"upstream: iron 0.6 (nao opcional) -> typemap -> unsafe-any -> traitobject 0.1 falha com E0119 no rustc atual"
	fi
fi

if ! command -v sonic-server >/dev/null 2>&1 && ! command -v sonic >/dev/null 2>&1; then
	sonic_prebuilt_install_required || cargo_install_required sonic-server 1.7.0
fi

# INSTALL.QUICKWIT.IO FOI RETIRADO DO DNS, e isso e upstream, nao infra desta
# maquina. Medido em 2026-09-10:
#
#   curl: (6) Could not resolve host: install.quickwit.io
#   dig install.quickwit.io @1.1.1.1  ->  status: NOERROR, ANSWER: 0
#   dig quickwit.io          @1.1.1.1  ->  185.199.110.153 (GitHub Pages)
#
# NOERROR com zero respostas no resolvedor publico e o dominio-pai vivo: o
# subdominio deixou de existir, nao ha falha de resolucao local. A regra do
# contrato — "build falha por DNS/rede => corrigir INFRA" — foi conferida antes
# de concluir isso, e nao se aplica: `quickwit.io`, `github.com` e as releases
# de `quickwit-oss/quickwit` (HTTP 200) resolvem e respondem desta maquina.
#
# A ROTA CERTA JA EXISTE NESTE ARQUIVO: e a do sonic, logo acima — URL de
# release fixada + sha256 conferido antes de instalar. Trocar o script de
# instalacao por um asset de release pinado e o conserto, mas escolher QUAL
# release e fixar o hash e decisao da frente que avalia backend de busca, com
# versao e benchmark; nao se pina uma dependencia as cegas para calar um erro.
# Ate la o candidato entra como AUSENTE, com o motivo escrito.
#
# Como no tantivy: a falha deixa de matar o wrapper. Antes, com `set -eu`, ela
# abortava o script ANTES do `exec "$@"` e a matriz inteira nunca rodava — dois
# candidatos ininstalaveis cegavam a medicao dos que INSTALAM (o sonic instala,
# e instalou nesta mesma execucao).
if ! command -v quickwit >/dev/null 2>&1; then
	if falha_upstream_recente quickwit prebuilt "saiu do DNS" \
		causa_dns_resolvida "$(host_da_url "$QUICKWIT_INSTALL_SCRIPT_URL")"; then
		printf 'oss-install-matrix-env: quickwit pulado (falha upstream registrada nas ultimas %ss, mesmo rustc)\n' \
			"$OSS_FALHA_TTL_SEGUNDOS" >&2
	elif ! quickwit_prebuilt_install_required; then
		# O MOTIVO REGISTRADO TEM DE SER O MOTIVO REAL, senao a precondicao que
		# acabou de levantar a guarda a levanta OUTRA VEZ na proxima invocacao e
		# o retry vira laco. Medido em 2026-09-10 com a URL apontada para um host
		# que resolve: o texto fixo dizia "saiu do DNS" depois de a instalacao ter
		# falhado por rejeicao do override, e o marcador voltava a casar.
		quickwit_host="$(host_da_url "$QUICKWIT_INSTALL_SCRIPT_URL")"
		if causa_dns_resolvida "$quickwit_host"; then
			registra_falha_de_instalacao quickwit prebuilt \
				"upstream: $quickwit_host resolve no DNS e ainda assim a instalacao falhou; a rota e um asset de release pinado, como o sonic"
		else
			registra_falha_de_instalacao quickwit prebuilt \
				"upstream: $quickwit_host saiu do DNS (NOERROR com 0 respostas em 1.1.1.1); a rota e um asset de release pinado, como o sonic"
		fi
	fi
fi

export WIKI_OSS_PYTHON="$PY"
export WIKI_OSS_BIN_DIR="$CARGO_ROOT/bin:$HOME/.cargo/bin"
export WIKI_STANZA_RESOURCES_DIR="$STANZA_DIR"
export STANZA_RESOURCES_DIR="$STANZA_DIR"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

exec "$@"
