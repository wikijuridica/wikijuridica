#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-simplemma-ptbr-lemma-audit [--root PATH] [--limit N] [--checked-at YYYY-MM-DD] [--output PATH] [--timings]
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:simplemma-ptbr-lemma-audit:python}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-60000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-30000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=20}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/simplemma_ptbr_lemma_audit.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-simplemma-ptbr-lemma-audit}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/simplemma_ptbr_lemma_audit.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-420}"
VENV="$ROOT/.cache/simplemma-ptbr-venv"
PYTHON="$VENV/bin/python"
REQUIREMENTS="$ROOT/tools/requirements-simplemma-ptbr.txt"
STAMP="$VENV/.requirements.sha256"

. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"

if [[ ! -x "$PYTHON" ]]; then
	python3 -m venv "$VENV"
fi

requirements_sha="$(sha256sum "$REQUIREMENTS" | awk '{print $1}')"
current_sha=""
if [[ -f "$STAMP" ]]; then
	current_sha="$(<"$STAMP")"
fi
if [[ "$current_sha" != "$requirements_sha" ]]; then
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 "$PYTHON" -m pip install -r "$REQUIREMENTS" >/tmp/simplemma-ptbr-pip-install.log
	printf '%s\n' "$requirements_sha" >"$STAMP"
fi
exec "$ROOT/tools/run-heavy-throttled" "$PYTHON" "$ROOT/tools/simplemma_ptbr_lemma_audit.py" --root "$ROOT" "$@"
