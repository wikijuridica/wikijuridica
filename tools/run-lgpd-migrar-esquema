#!/usr/bin/env bash
# run-lgpd-migrar-esquema — leva var/social/lgpd.db da versao 1 do esquema para
# a versao 2 (internal/lgpd.VersaoEsquema), ANTES de publicar o binario novo.
#
# POR QUE ISTO EXISTE. A versao 2 acrescenta `atendimentos_art18` -- movida de
# cmd/social/titular.go para internal/lgpd, que e o unico pacote da casa que
# versiona o esquema do banco da LGPD e falha fechado sobre divergencia
# (internal/lgpd/banco.go:299). Um banco ja gravado na versao 1 NAO abre
# sozinho sob um binario compilado com VersaoEsquema=2 -- de proposito, para
# que a divergencia nunca passe em silencio.
#
# RODE ISTO ANTES DO DEPLOY, NAO DEPOIS. O DDL que a migracao aplica e aditivo
# (create table/index if not exists) e o processo ANTIGO nunca toca a tabela
# nova, entao rodar esta migracao com o binario antigo ainda no ar nao muda
# nada que ele enxergue. Publicar o binario novo antes de migrar faz
# lgpd.Abrir falhar em producao: a rede social sobe com o banco da LGPD
# indisponivel, as rotas do art. 18 respondem 503, e o expurgo diario das
# 04:10 (wikijuridica-lgpd-expurgo) tambem falha, porque ele abre o mesmo
# banco pelo mesmo Abrir.
#
# IDEMPOTENTE: rodar sobre um banco ja na versao 2 apenas confirma.
#
# O BINÁRIO É CONSTRUÍDO AQUI, pelo mesmo motivo de run-lgpd-expurgo: uma
# migracao datada nao pode rodar com regra velha por engano.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
raiz="$PWD"

binario="$raiz/bin/wikijuridica-lgpd-migrar-esquema"
mkdir -p "$raiz/bin"

nice -n 10 ./tools/go-modern build -o "$binario" ./cmd/lgpd-migrar-esquema

# O comando le WIKI_SOCIAL_DATA_DIR sozinho (mesma variavel da unit da rede
# social e do expurgo) e recusa diretorio sem banco em vez de criar um vazio.
exec "$binario" "$@"
