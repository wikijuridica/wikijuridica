#!/usr/bin/env python3
"""Vigia o enquadramento como agente de tratamento de pequeno porte.

POR QUE ESTE GATE EXISTE.

`docs/politica/ENQUADRAMENTO_PEQUENO_PORTE.md` declara, com números medidos, que
esta aplicacao se enquadra no regime da Resolucao CD/ANPD no 2, de 27 de janeiro
de 2022 -- e o art. 5o daquele regulamento da ao agente QUINZE DIAS para
comprovar o enquadramento quando a ANPD pedir.

Declaracao de enquadramento que ninguem revisita e declaracao que envelhece em
silencio. A operacao cresce, o documento continua dizendo "zero titulares", e a
comprovacao que se entrega a autoridade descreve um sistema que nao existe mais.
Este gate transforma o gatilho de reavaliacao em medicao: ele le o banco real e
reprova quando a operacao se afastou do que o documento afirma.

O QUE ELE NAO FAZ, e a honestidade importa aqui. Ele NAO decide se ha alto risco
-- essa e uma avaliacao juridica que o art. 4o manda fazer no caso concreto,
ponderando volume, duracao, frequencia e extensao geografica. O gate mede a
unica dimensao objetiva do criterio geral (a) -- o numero de titulares -- e
avisa quando ela deixou de sustentar sozinha a conclusao do documento.

E OS LIMIARES NAO SAO DA NORMA. Nem a Res. 2/2022 nem a LGPD fixam numero de
titulares para "larga escala"; o art. 4o, par. 1o descreve o conceito e deixa a
caracterizacao para o caso concreto. Os numeros abaixo sao decisao de
engenharia deste projeto, escolhidos para que a reavaliacao aconteca com folga
-- ANTES de o enquadramento virar duvidoso, e nao depois. Chamar isso de
"limite legal" seria inventar norma; chamar de gatilho de prudencia e o que e.
"""

import json
import os
import sqlite3
import sys

# A raiz e parametrizavel por WIKI_RAIZ para que o teste do proprio gate possa
# monta-lo sobre uma arvore temporaria e prova-lo REPROVANDO. Gate que nunca foi
# visto vermelho e gate que ninguem sabe se funciona -- e testar este contra o
# banco de producao exigiria semear dez mil contas falsas nele, que e
# exatamente o que o contrato deste projeto proibe.
RAIZ = os.environ.get("WIKI_RAIZ") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BANCO_SOCIAL = os.path.join(RAIZ, "var", "social", "social.db")
BANCO_LGPD = os.path.join(RAIZ, "var", "social", "lgpd.db")
DOCUMENTO = os.path.join(RAIZ, "docs", "politica", "ENQUADRAMENTO_PEQUENO_PORTE.md")

# Gatilhos de prudencia, nao limites legais -- ver o cabecalho.
TITULARES_PARA_AVISO = 1_000
TITULARES_PARA_REAVALIAR = 10_000


def conta_linhas(caminho, tabela):
    """Devolve (quantidade, observacao). Tabela ausente nao e falha.

    Banco novo, ou schema que ainda nao criou a tabela, e estado legitimo desta
    frente -- reprovar por isso faria o gate vermelho por motivo que nao e o
    dele, e gate cronicamente vermelho e gate que ninguem le.
    """
    if not os.path.exists(caminho):
        return None, f"banco ausente: {os.path.relpath(caminho, RAIZ)}"
    try:
        conexao = sqlite3.connect(f"file:{caminho}?mode=ro", uri=True)
    except sqlite3.Error as erro:
        return None, f"nao foi possivel abrir {os.path.relpath(caminho, RAIZ)}: {erro}"
    try:
        cursor = conexao.execute(
            "select count(*) from sqlite_master where type='table' and name=?", (tabela,)
        )
        if cursor.fetchone()[0] == 0:
            return None, f"tabela {tabela} ainda nao existe"
        return conexao.execute(f"select count(*) from {tabela}").fetchone()[0], ""
    except sqlite3.Error as erro:
        return None, f"consulta a {tabela} falhou: {erro}"
    finally:
        conexao.close()


def main():
    achados = []
    linhas = []

    if not os.path.exists(DOCUMENTO):
        print(
            "check-enquadramento-pequeno-porte: FALHA: "
            f"{os.path.relpath(DOCUMENTO, RAIZ)} nao existe. O art. 5o da Res. CD/ANPD 2/2022 "
            "da quinze dias para comprovar o enquadramento; sem o registro escrito, esse prazo "
            "e curto demais para produzir a analise do zero."
        )
        return 1

    medidas = {}
    for rotulo, caminho, tabela in (
        ("contas", BANCO_SOCIAL, "contas"),
        ("perfis", BANCO_SOCIAL, "perfis"),
        ("registros de acesso", BANCO_LGPD, "registros_acesso"),
    ):
        quantidade, observacao = conta_linhas(caminho, tabela)
        medidas[rotulo] = quantidade
        if quantidade is None:
            linhas.append(f"  - {rotulo}: nao medido ({observacao})")
        else:
            linhas.append(f"  - {rotulo}: {quantidade}")

    titulares = medidas.get("contas")
    if titulares is None:
        titulares = 0
        linhas.append(
            "  - titulares cadastrados tratados como 0: a tabela de contas ainda nao existe, "
            "o que e estado legitimo e nao contradiz o documento"
        )

    if titulares >= TITULARES_PARA_REAVALIAR:
        achados.append(
            f"{titulares} titulares cadastrados, acima do gatilho de reavaliacao "
            f"({TITULARES_PARA_REAVALIAR}). O documento de enquadramento afirma ausencia do "
            "criterio geral (a) do art. 4o da Res. CD/ANPD 2/2022 (tratamento em larga escala), "
            "e essa afirmacao precisa ser reexaminada e REDATADA antes de ser apresentada a "
            "ANPD. Se, junto dela, se verificar qualquer criterio especifico do art. 4o, II -- "
            "e o inciso (d), dado sensivel, e plausivel em conteudo juridico --, o tratamento "
            "passa a ser de alto risco e o regime diferenciado cessa pelo art. 3o, I."
        )
    elif titulares >= TITULARES_PARA_AVISO:
        linhas.append(
            f"  - AVISO: {titulares} titulares, acima de {TITULARES_PARA_AVISO}. Ainda dentro do "
            f"que o documento sustenta, mas a {TITULARES_PARA_REAVALIAR} a reavaliacao passa a "
            "ser exigida por este gate. Vale reler a secao 6 do documento agora, com folga."
        )

    # A data de emissao e o que a autoridade le. Documento sem data nao comprova
    # nada -- o art. 5o cobra a comprovacao NO MOMENTO do pedido.
    with open(DOCUMENTO, encoding="utf-8") as arquivo:
        texto = arquivo.read()
    if "Emitido em" not in texto and "Local e data" not in texto:
        achados.append(
            "o documento de enquadramento nao tem campo de data: o art. 5o cobra comprovacao "
            "no momento do pedido, e declaracao sem data nao situa os fatos que afirma"
        )

    print("check-enquadramento-pequeno-porte: medicao")
    for linha in linhas:
        print(linha)

    if achados:
        for achado in achados:
            print(f"check-enquadramento-pequeno-porte: FALHA: {achado}")
        return 1

    print(
        "check-enquadramento-pequeno-porte: pass "
        f"({titulares} titulares; gatilho de reavaliacao em {TITULARES_PARA_REAVALIAR}). "
        "Os numeros medidos continuam sustentando o que o registro de enquadramento afirma."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
