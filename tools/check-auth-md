#!/usr/bin/env python3
"""check-auth-md — confere, NO AR, que /auth.md descreve o que o portal faz.

POR QUE ELE EXISTE: /auth.md é o documento que um agente lê para saber se precisa
de credencial. Um documento desatualizado aqui é pior que documento nenhum — ele
manda o agente tentar um fluxo que não existe, ou desistir de um que existe.

O QUE ELE MEDE, e por que cada item: o documento é servido por ROTA do Go, não por
arquivo em public/. Como o nginx serve public/ do disco e o disco VENCE o Go em
`location /`, um public/auth.md deixado por uma publicação futura passaria a
responder no lugar da rota — com 200, com conteúdo velho, sem nenhum gate falar.
Por isso a primeira verificação é a ausência daquele arquivo.

Depois: toda rota que o documento ANUNCIA tem de existir. O critério é "não é 404",
e não "é 200": um 401 no recurso protegido e um 405 no token_endpoint sob GET são
respostas corretas — provam que a rota está lá e guardada.

Read-only: nada é escrito.

Uso:
    tools/check-auth-md                    # mede a origem (127.0.0.1:8088)
    tools/check-auth-md --base https://wikijuridica.com.br
"""
import argparse
import os
import re
import sys
import urllib.error
import urllib.request

UA = "wikijuridica-selfcheck/1.0"
CABECALHOS = {"User-Agent": UA, "X-Warming-Request": "true", "Host": "wikijuridica.com.br"}


def pede(base, caminho, metodo="GET"):
    url = base.rstrip("/") + caminho
    req = urllib.request.Request(url, method=metodo)
    for k, v in CABECALHOS.items():
        if k == "Host" and not base.startswith("http://127.0.0.1"):
            continue
        req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            return r.status, r.read().decode("utf-8", "replace"), dict(r.headers)
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", "replace"), dict(e.headers)
    except Exception as e:
        return 0, str(e), {}


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--base", default="http://127.0.0.1:8088")
    args = p.parse_args()

    falhas = 0

    # 1) O arquivo no disco sombrearia a rota.
    sombra = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "public", "auth.md")
    if os.path.exists(sombra):
        print(f"  FALHA existe {sombra}: ele sombrearia a rota do Go e serviria conteudo velho")
        falhas += 1
    else:
        print("  OK    nenhum public/auth.md sombreando a rota")

    # 2) A rota responde, com o tipo certo.
    status, corpo, cabecalhos = pede(args.base, "/auth.md")
    if status != 200:
        print(f"  FALHA /auth.md respondeu {status}")
        return sai(falhas + 1)
    tipo = cabecalhos.get("Content-Type", "")
    if "text/markdown" not in tipo:
        print(f"  FALHA /auth.md com Content-Type {tipo!r}, esperado text/markdown")
        falhas += 1
    else:
        print(f"  OK    /auth.md 200 {tipo} ({len(corpo)} bytes)")

    # 3) Toda rota anunciada existe. "Nao e 404" e o criterio.
    anunciadas = sorted(set(re.findall(r"https://wikijuridica\.com\.br(/[A-Za-z0-9._/\-]*)", corpo)))
    # As servidas do disco pelo nginx nao passam pelo roteador do Go quando se
    # mede a origem; sao conferidas do mesmo jeito, porque na origem 8088 elas
    # tambem respondem.
    ignoradas = {"/", "/qualquer/pagina/index.md", "/area/pagina/"}
    conferidas = 0
    for rota in anunciadas:
        if rota in ignoradas or "{" in rota or rota.endswith("index.md"):
            continue
        st, _, _ = pede(args.base, rota)
        conferidas += 1
        if st == 404:
            print(f"  FALHA /auth.md anuncia {rota} e a origem devolve 404")
            falhas += 1
        elif st == 0:
            print(f"  FALHA nao consegui medir {rota}")
            falhas += 1
    print(f"  OK    {conferidas} rota(s) anunciada(s) existem (criterio: nao e 404)")

    # 4) Coerencia com o estado do OAuth: se o documento ensina o fluxo, o
    #    descritor tem de responder; se nao ensina, ele tem de estar em 404.
    ensina_oauth = "/oauth/token" in corpo
    st_as, _, _ = pede(args.base, "/.well-known/oauth-authorization-server")
    if ensina_oauth and st_as == 404:
        print("  FALHA o auth.md ensina o fluxo OAuth e o descritor RFC 8414 responde 404")
        falhas += 1
    elif not ensina_oauth and st_as == 200:
        print("  FALHA o descritor RFC 8414 responde 200 e o auth.md nao ensina o fluxo")
        falhas += 1
    else:
        estado = "ligado" if ensina_oauth else "desligado"
        print(f"  OK    auth.md e descritor de OAuth coerentes (capacidade {estado})")

    return sai(falhas)


def sai(falhas):
    print()
    if falhas:
        print(f"{falhas} verificacao(oes) reprovaram")
        return 1
    print("auth.md conferido no ar: coerente com o que o portal faz")
    return 0


if __name__ == "__main__":
    sys.exit(main())
