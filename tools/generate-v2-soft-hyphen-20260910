#!/usr/bin/env python3
"""Corrige a única ocorrência de HÍFEN CONDICIONAL (U+00AD) na cadeia de prosa
pública, e ela levou a palavra junto.

O QUE ESTÁ NO DADO, medido em 2026-09-10:

    "…de se a própria conduta é ou não puni\xadvel. Um parlamentar pode ter foro…"

`data/editorial/public_prose_candidate.jsonl` e
`data/editorial/refined_public_prose.jsonl`, linha 964 em ambos, campo
`public_body_sections[2].text`, da página "Imunidade parlamentar protege o
mandato, não a pessoa do parlamentar" (área constitucional).

POR QUE ISTO É DEFEITO, e não decoração. U+00AD não desenha NADA no navegador:
o leitor vê "punivel" e quem processa o texto por byte — que é exatamente o
crawler e o modelo de linguagem que este portal existe para servir — vê duas
sequências separadas por um caractere de formato. `internal/ptbrunicodequality`
o classifica como blocker pela categoria `format` (unicode.Cf), e blocker não
publica.

POR QUE A CORREÇÃO É "punível" E NÃO "punivel". Apagar o U+00AD deixaria
"punivel", que não existe em português — a grafia correta da palavra nesse
contexto ("a própria conduta é ou não punível") é com acento agudo no i. O §8
do contrato exige PT-BR perfeito com acentuação em tudo que é visível ao
público, e aqui não há ambiguidade a resolver: nenhuma outra palavra portuguesa
se escreve "puni" + qualquer coisa + "vel" nessa frase.

ESCOPO FECHADO, e o gerador conta o que ficou de fora. A troca é UMA, literal,
e o relatório imprime quantas ocorrências de U+00AD sobraram em cada arquivo
depois da passada. Se sobrar alguma, ela aparece com o trecho — nunca é
apagada em silêncio, porque hífen condicional em citação literal de terceiro
poderia ser o dado da fonte, e isso é decisão de quem lê, não deste gerador.

O ACERVO PUBLICADO NÃO TEM O DEFEITO: conferido no mesmo dia, zero ocorrências
de U+00AD em `public/**/index.html` e zero em `content/pages.json`. Isto é
conserto de ESTOQUE, que destrava a publicação daquele registro — não é
correção de página no ar.

Escrita atômica (temporário no mesmo diretório + fsync + rename) e idempotente:
a segunda passada não muda nada.

Uso:
    tools/generate-v2-soft-hyphen-20260910 --dry-run
    tools/generate-v2-soft-hyphen-20260910
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

HIFEN_CONDICIONAL = "­"

# (antigo, novo). O antigo carrega o U+00AD por escape: byte de formato literal
# no fonte de uma ferramenta é a mesma classe de defeito que ela conserta.
TROCAS = (("puni­vel", "punível"),)

ARQUIVOS = (
    "data/editorial/public_prose_candidate.jsonl",
    "data/editorial/refined_public_prose.jsonl",
)


def troca_em(valor, antigo: str, novo: str):
    """Aplica a troca recursivamente em str/list/dict, contando as ocorrências."""
    if isinstance(valor, str):
        return valor.replace(antigo, novo), valor.count(antigo)
    if isinstance(valor, list):
        saida, total = [], 0
        for item in valor:
            trocado, n = troca_em(item, antigo, novo)
            saida.append(trocado)
            total += n
        return saida, total
    if isinstance(valor, dict):
        saida, total = {}, 0
        for chave, item in valor.items():
            trocado, n = troca_em(item, antigo, novo)
            saida[chave] = trocado
            total += n
        return saida, total
    return valor, 0


def sobras(registro: dict) -> list[str]:
    """Devolve os trechos em que o U+00AD sobreviveu à troca, para o relatório."""
    texto = json.dumps(registro, ensure_ascii=False)
    achados = []
    inicio = 0
    while True:
        indice = texto.find(HIFEN_CONDICIONAL, inicio)
        if indice < 0:
            return achados
        achados.append(texto[max(0, indice - 60):indice + 30])
        inicio = indice + 1


def corrige(arquivo_rel: str, dry_run: bool) -> tuple[int, int, list[str]]:
    arquivo = RAIZ / arquivo_rel
    if not arquivo.exists():
        print(f"arquivo ausente: {arquivo}", file=sys.stderr)
        return 2, 0, []

    saida: list[str] = []
    trocadas = 0
    restantes: list[str] = []
    for linha in arquivo.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        for antigo, novo in TROCAS:
            registro, n = troca_em(registro, antigo, novo)
            trocadas += n
        restantes.extend(sobras(registro))
        # SERIALIZACAO COMPACTA, e ela nao e detalhe de estilo. O produtor do
        # corpus e Go (encoding/json), que escreve {"a":"b"} sem espaco. O
        # default do json.dumps do Python e {"a": "b"}, e reserializar 7.959
        # linhas com o default cresce o arquivo em 1,8 MB e muda TODAS elas --
        # medido nesta sessao, na primeira passada deste gerador: 86.519.454 ->
        # 88.321.072 bytes por causa de uma troca de um caractere. Churn assim
        # invalida a atestacao do corpus, enche o diff e esconde a correcao
        # real no meio de milhares de linhas identicas em conteudo.
        saida.append(json.dumps(registro, ensure_ascii=False, separators=(",", ":")))

    nome = arquivo.name
    conteudo = "\n".join(saida) + "\n"
    ja_no_disco = arquivo.read_text(encoding="utf-8")
    if trocadas == 0 and conteudo == ja_no_disco:
        print(f"{nome}: nada a fazer (idempotente)")
        return 0, 0, restantes

    if trocadas == 0:
        # Sem troca a fazer, mas o disco diverge da serializacao canonica: e o
        # caso de reparar uma passada anterior que gravou no formato errado.
        print(f"{nome}: sem troca, reserializando no formato compacto")
    else:
        print(f"{nome}: {trocadas} troca(s)")
    if not dry_run:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=arquivo.parent,
                                         prefix=".tmp-", delete=False) as temporario:
            temporario.write(conteudo)
            temporario.flush()
            os.fsync(temporario.fileno())
            caminho = temporario.name
        os.replace(caminho, arquivo)
        print(f"  gravado: {arquivo.relative_to(RAIZ)}")
    return 0, trocadas, restantes


# TestemunhoRelPath e a atestacao que o produtor do corpus refinado grava
# (internal/refinedcorpusfloor/refinedcorpusfloor.go:59). Ela nao e decoracao:
# `refinedcorpusfloor.Piso` compara `records`, `corpus_bytes` e `corpus_sha256`
# com o disco e FALHA FECHADA no piso de producao (10.000) em qualquer
# divergencia. Corrigir o corpus sem reatestar derruba o piso e reprova
# `ptbr-unicode-quality` por `minimum_records_missing` -- que e' o mesmo
# esquecimento que a atestacao do v2ingest cobra de quem toca o grafo do
# validador. Medido nesta sessao: a primeira passada deste gerador fez
# exatamente isso.
TESTEMUNHO = "data/ops/refined_public_prose_generation_witness.json"
CORPUS_ATESTADO = "data/editorial/refined_public_prose.jsonl"


def digest_e_registros(caminho: Path) -> tuple[str, int, int]:
    """Reproduz digestERegistros (refinedcorpusfloor.go:161): sha256 sobre os
    BYTES do arquivo inteiro, e contagem de linhas nao vazias (uma linha conta
    quando tem algum byte que nao seja espaco, tabulacao ou retorno)."""
    import hashlib

    soma = hashlib.sha256()
    registros = 0
    linha_em_curso = False
    tamanho = 0
    with open(caminho, "rb") as arquivo:
        while True:
            bloco = arquivo.read(1 << 20)
            if not bloco:
                break
            soma.update(bloco)
            tamanho += len(bloco)
            for b in bloco:
                if b == 0x0A:
                    if linha_em_curso:
                        registros += 1
                    linha_em_curso = False
                    continue
                if b not in (0x20, 0x09, 0x0D):
                    linha_em_curso = True
    if linha_em_curso:
        registros += 1
    return soma.hexdigest(), registros, tamanho


def reatesta(dry_run: bool) -> int:
    """Atualiza o testemunho com o digest, o tamanho e a contagem REAIS.

    `producer` NAO muda: o corpus continua sendo o que
    `cmd/generate-refined-public-prose` produziu. O que este gerador fez foi uma
    correcao pontual, e ela e registrada em `corrections` -- campo novo, que
    `leTestemunho` ignora por usar json.Unmarshal comum (sem
    DisallowUnknownFields), entao acrescenta-lo nao quebra o leitor.
    """
    caminho = RAIZ / TESTEMUNHO
    if not caminho.exists():
        print(f"testemunho ausente: {caminho}", file=sys.stderr)
        return 2
    atestado = json.loads(caminho.read_text(encoding="utf-8"))
    digest, registros, tamanho = digest_e_registros(RAIZ / CORPUS_ATESTADO)

    if (atestado.get("corpus_sha256") == "sha256:" + digest
            and atestado.get("corpus_bytes") == tamanho
            and atestado.get("records") == registros):
        print("testemunho: ja confere (idempotente)")
        return 0

    print("testemunho: reatestando")
    print(f"  records      {atestado.get('records')} -> {registros}")
    print(f"  corpus_bytes {atestado.get('corpus_bytes')} -> {tamanho}")
    print(f"  corpus_sha256 {str(atestado.get('corpus_sha256'))[:22]}… -> sha256:{digest[:16]}…")
    if dry_run:
        return 0

    atestado["records"] = registros
    atestado["corpus_bytes"] = tamanho
    atestado["corpus_sha256"] = "sha256:" + digest
    atestado["checkpoint_durable_records"] = registros
    correcoes = list(atestado.get("corrections") or [])
    correcoes.append({
        "tool": "tools/generate-v2-soft-hyphen-20260910",
        "date": "2026-09-10",
        "reason": "hifen condicional U+00AD dentro de 'punivel' na pagina de imunidade parlamentar",
        "replacements": 1,
    })
    atestado["corrections"] = correcoes

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=caminho.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write(json.dumps(atestado, ensure_ascii=False) + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        temp = temporario.name
    os.replace(temp, caminho)
    print(f"  gravado: {TESTEMUNHO}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true",
                        help="mostra o que mudaria, sem gravar")
    argumentos = parser.parse_args()

    total = 0
    restantes: list[str] = []
    for arquivo_rel in ARQUIVOS:
        codigo, trocadas, sobrou = corrige(arquivo_rel, argumentos.dry_run)
        if codigo != 0:
            return codigo
        total += trocadas
        restantes.extend(sobrou)

    print(f"total: {total} troca(s) em {len(ARQUIVOS)} arquivo(s)")

    codigo = reatesta(argumentos.dry_run)
    if codigo != 0:
        return codigo

    if restantes:
        print(f"U+00AD RESTANTE em {len(restantes)} trecho(s) — nenhum foi apagado:")
        for trecho in restantes[:10]:
            print("   ", repr(trecho))
    else:
        print("nenhum U+00AD restante nos arquivos tocados")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
