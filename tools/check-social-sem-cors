#!/usr/bin/env python3
"""check-social-sem-cors — nenhuma resposta do 8091 autoriza origem cruzada?

READ-ONLY. Não escreve arquivo nenhum.

POR QUE O MESMO CABEÇALHO É CERTO NO ACERVO E ERRADO AQUI. O cmd/server emite
`Access-Control-Allow-Origin: *` em vários pontos do canal de máquina (a2a,
/api/v1/lote, gêmea Markdown, descritores, agent-skills), e ali está CORRETO: é
superfície pública, sem cookie, feita para agente de terceiro consumir. O que
vaza não é o cabeçalho sozinho — é a COMBINAÇÃO de rota com cookie de sessão e
ACAO permissivo: com os dois, qualquer página da web lê, com a sessão da vítima,
o conteúdo autenticado dela. Por isso esta sonda mira o 8091, e o gate
estrutural mira o fecho de imports do cmd/social — nunca o repositório inteiro,
que reprovaria os pontos legítimos e seria desligado na primeira semana.

DUAS METADES:

  ESTRUTURAL  `cmd/check social-sem-cors` prova que nenhum pacote do fecho de
              imports do cmd/social declara `Access-Control-`, que ele não
              importa biblioteca de CORS, e que o nginx não declara ACAO em
              nível que uma location social herdaria.
  SERVIDA     esta sonda varre as rotas do processo social com GET, HEAD, POST e
              OPTIONS, com e sem `Origin`, incluindo os caminhos de erro (404 e
              405) — que são onde um cabeçalho escapa quando o middleware é
              aplicado depois do roteamento.

exit 0 medido e correto · exit 1 medido e errado (ou gate estrutural reprovado)
· exit 2 não foi possível medir.
"""
import importlib.util
import os
import sys


def carrega_sonda():
    """Carrega tools/social_borda_probe.py sem mexer no sys.path.

    O idioma usual aqui seria `sys.path.insert(...)` seguido de import, que
    obriga a um `# noqa: E402` — e suprimir o diagnostico em vez de resolver a
    causa e proibido neste repositorio. Carregar por caminho explicito resolve a
    causa: nao ha import fora de ordem para o lint reclamar.
    """
    caminho = os.path.join(os.path.dirname(os.path.abspath(__file__)), "social_borda_probe.py")
    spec = importlib.util.spec_from_file_location("social_borda_probe", caminho)
    if spec is None or spec.loader is None:
        raise ImportError(f"nao consegui carregar {caminho}")
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


sonda = carrega_sonda()

NOME = "check-social-sem-cors"

# `.invalid` e reservado pela RFC 2606 e nunca resolve: a origem da sonda nao
# pode ser um dominio de terceiro real.
ORIGEM_DE_TESTE = "https://origem-cruzada-de-sonda.invalid"

# Os caminhos de ERRO entram de proposito: 404 e 405 sao onde um cabecalho
# escapa quando o middleware roda depois do roteamento.
CAMINHOS = [
    "/redesocial/",
    "/redesocial/index.md",
    "/healthz",
    "/readyz",
    "/redesocial/rota-que-nao-existe",
]
METODOS = ["GET", "HEAD", "POST", "OPTIONS"]

# Todo cabecalho da familia, e nao so o Allow-Origin: Allow-Credentials sozinho
# ja e sinal de que alguem ligou CORS nesta superficie.
FAMILIA = [
    "Access-Control-Allow-Origin",
    "Access-Control-Allow-Credentials",
    "Access-Control-Expose-Headers",
]


def main():
    codigo, saida = sonda.gate_estrutural("social-sem-cors")
    if codigo == sonda.ERRADO:
        print(saida.rstrip())
        return sonda.relata(NOME, sonda.ERRADO, [
            "o gate estrutural social-sem-cors reprovou: ha codigo no fecho do cmd/social, ou diretiva no nginx, "
            "capaz de autorizar origem cruzada numa superficie que tem cookie de sessao."])
    if codigo == sonda.INCONCLUSIVO:
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [saida.strip()])

    if not sonda.escuta(sonda.PORTA_SOCIAL):
        return sonda.relata(NOME, sonda.INCONCLUSIVO, [
            f"nada escutando em 127.0.0.1:{sonda.PORTA_SOCIAL} (cmd/social): o codigo servido nao emite CORS "
            "(provado por construcao no gate estrutural), e as respostas reais nao podem ser medidas agora"])

    problemas = []
    medidas = 0
    for caminho in CAMINHOS:
        for metodo in METODOS:
            for origem in (None, ORIGEM_DE_TESTE):
                cabecalhos = {"Origin": origem} if origem else None
                status, headers, erro = sonda.requisita_bruto(
                    sonda.PORTA_SOCIAL, caminho, metodo=metodo, cabecalhos=cabecalhos)
                if erro:
                    return sonda.relata(NOME, sonda.INCONCLUSIVO, [
                        f"{metodo} {caminho} (Origin={origem}): {erro}"])
                medidas += 1
                for nome_do_cabecalho in FAMILIA:
                    valores = sonda.cabecalhos_repetidos(headers, nome_do_cabecalho)
                    for valor in valores:
                        problemas.append(
                            f"{metodo} {caminho} (HTTP {status}, Origin={origem or 'ausente'}) devolveu "
                            f"{nome_do_cabecalho}: {valor!r}")

    if problemas:
        return sonda.relata(NOME, sonda.ERRADO, problemas + [
            "rota com cookie de sessao mais CORS permissivo deixa qualquer pagina ler o conteudo autenticado da vitima"])
    return sonda.relata(NOME, sonda.OK, [
        f"{medidas} respostas medidas no 8091 ({len(CAMINHOS)} rotas x {len(METODOS)} metodos, com e sem Origin, "
        "404 e 405 incluidos): nenhuma traz cabecalho da familia Access-Control"])


if __name__ == "__main__":
    sys.exit(main())
