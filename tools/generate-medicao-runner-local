#!/usr/bin/env python3
"""Mede, com prompt e corpus REAIS, quanto custa cada configuracao do runner
local de LLM (llama-server) desta maquina.

Por que existe: em 2026-09-08 o drop-in do ollama.service passou a forcar
OLLAMA_FLASH_ATTENTION=1 e OLLAMA_KV_CACHE_TYPE=q8_0, e o modelo de extracao
virou qwen3.5:4b -- que e' multimodal (24 blocos de visao) e hibrido
(full_attention_interval=4, so 8 das 32 camadas com atencao plena). O journal do
ollama registra, em 100% das tarefas, "forcing full prompt re-processing due to
lack of cache data", e o prefill passou a ser a maior parte do tempo de parede.
Nenhuma dessas tres escolhas tinha A/B: o journal so tem n=1 de cada lado.

O que ele NAO faz: nao mexe no ollama.service, nao mexe no drop-in, nao muda
`--modelo` de ninguem, nao reenfileira tarefa. Ele sobe um llama-server proprio,
mede, mata e escreve o numero.

Saida: data/ops/ia_local_runner_variantes.jsonl (append, uma linha por variante).

Guardas (o incidente de 2026-09-08 12:04:53 custou o llama-server e os servidores
MCP das sessoes de Claude Code):
  - recusa rodar com QUALQUER modelo residente no ollama (dois residentes = earlyoom);
  - recusa rodar sem folga de RAM declarada em --min-livre-mb;
  - mata o proprio runner em qualquer saida, inclusive por excecao.
"""

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
LLAMA_SERVER = Path("/usr/local/lib/ollama/llama-server")
BLOBS = Path("/usr/share/ollama/.ollama/models/blobs")
MANIFESTS = Path("/usr/share/ollama/.ollama/models/manifests/registry.ollama.ai/library")
SAIDA = RAIZ / "data/ops/ia_local_runner_variantes.jsonl"
CORPUS = RAIZ / "data/corpus/jurisprudencia/stj-espelhos"
FONTE_DO_PROMPT = RAIZ / "internal/cerebro/extracao.go"
TETO_CHARS = 3000  # TetoCharsExtracao, internal/cerebro/extracao.go


def sistema_da_extracao() -> str:
    """Le a constante `sistemaDaExtracao` do Go, para o prompt medido ser
    literalmente o de producao. Concatenacao de literais Go com `+`."""
    fonte = FONTE_DO_PROMPT.read_text(encoding="utf-8")
    m = re.search(r"const sistemaDaExtracao = (.*?)\n\n", fonte, re.S)
    if not m:
        raise SystemExit("nao achei `const sistemaDaExtracao` em " + str(FONTE_DO_PROMPT))
    partes = re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))
    if not partes:
        raise SystemExit("constante do prompt sem literal de string")
    return "".join(p.encode().decode("unicode_escape") for p in partes)


def blob_do_modelo(tag: str) -> Path:
    """`qwen3.5:4b` -> caminho do blob de pesos."""
    nome, _, versao = tag.partition(":")
    manifesto = MANIFESTS / nome / (versao or "latest")
    if not manifesto.is_file():
        raise SystemExit(f"manifesto ausente: {manifesto}")
    d = json.loads(manifesto.read_text())
    for camada in d["layers"]:
        if camada["mediaType"].endswith(".image.model"):
            return BLOBS / camada["digest"].replace(":", "-")
    raise SystemExit(f"manifesto de {tag} sem camada de modelo")


def ementas(quantas: int) -> list[dict]:
    """Amostra deterministica por stride sobre o corpus real ja coletado."""
    linhas = []
    for arq in sorted(CORPUS.glob("registros-*.jsonl")):
        with arq.open(encoding="utf-8") as f:
            for linha in f:
                d = json.loads(linha)
                texto = (d.get("ementa") or "").strip()
                if len(texto) >= 400:
                    linhas.append({"id_fonte": d["id_fonte"], "texto": texto[:TETO_CHARS]})
    if len(linhas) < quantas:
        raise SystemExit(f"corpus tem {len(linhas)} ementas uteis, pedi {quantas}")
    passo = len(linhas) // quantas
    return [linhas[i * passo] for i in range(quantas)]


# IDENTIDADE DA SONDA (CLAUDE.md secao 11). Ate 2026-09-10 as tres leituras
# saiam como `Python-urllib/3.x` para o Ollama e para o llama-server locais. O
# destino e servico NOSSO na maquina, nao o portal: vai o User-Agent da sonda
# interna que o contrato nomeia, e nao vai o `X-Warming-Request` — aquele
# cabecalho tira a requisicao da metrica de audiencia do portal, e aqui nao ha
# audiencia a medir.
UA_SONDA = "wikijuridica-superficie-probe/1.0"
CABECALHOS_SONDA = {"User-Agent": UA_SONDA}


def residentes_no_ollama() -> list[str]:
    try:
        pedido = urllib.request.Request("http://127.0.0.1:11434/api/ps",
                                       headers=CABECALHOS_SONDA)
        with urllib.request.urlopen(pedido, timeout=5) as r:
            d = json.load(r)
    except (urllib.error.URLError, TimeoutError, OSError):
        return []  # ollama fora do ar nao e' impedimento: ninguem disputa a RAM
    return [m.get("name", "?") for m in d.get("models") or []]


def mem_livre_mb() -> int:
    for linha in Path("/proc/meminfo").read_text().splitlines():
        if linha.startswith("MemAvailable:"):
            return int(linha.split()[1]) // 1024
    raise SystemExit("/proc/meminfo sem MemAvailable")


class JanelaContaminada(RuntimeError):
    """Alguem carregou um modelo no ollama no meio da medicao.

    Medido em 2026-09-08 na primeira passada desta ferramenta: o
    wikijuridica-cerebro.service voltou sozinho no meio da variante
    `producao-hoje`, o ollama subiu um SEGUNDO llama-server com o mesmo blob
    (3,88 GB de RSS cada, 6,7 GB livres e caindo) e os dois passaram a disputar
    os 4 nucleos. A guarda so no inicio da execucao nao pega isso: o numero sai,
    parece bom, e mede contencao de CPU em vez de configuracao. Por isso a
    verificacao e' por requisicao, e a variante inteira e' descartada -- media
    contaminada nao se corrige depois, se joga fora."""


def carga1() -> float:
    return float(Path("/proc/loadavg").read_text().split()[0])


def espera_pronto(porta: int, proc: subprocess.Popen, teto_s: int) -> float:
    limite = time.monotonic() + teto_s
    while time.monotonic() < limite:
        if proc.poll() is not None:
            raise SystemExit(f"llama-server morreu na carga (exit {proc.returncode})")
        try:
            pedido = urllib.request.Request(f"http://127.0.0.1:{porta}/health",
                                           headers=CABECALHOS_SONDA)
            with urllib.request.urlopen(pedido, timeout=2) as r:
                if json.load(r).get("status") == "ok":
                    return teto_s - (limite - time.monotonic())
        except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
            time.sleep(1.0)
    raise SystemExit(f"llama-server nao ficou pronto em {teto_s}s")


def pico_rss_kb(pid: int) -> int:
    try:
        for linha in Path(f"/proc/{pid}/status").read_text().splitlines():
            if linha.startswith("VmHWM:"):
                return int(linha.split()[1])
    except OSError:
        pass
    return 0


def completa(porta: int, prompt: str, n_predict: int, teto_s: int) -> dict:
    corpo = json.dumps({
        "prompt": prompt,
        "n_predict": n_predict,
        "temperature": 0.0,
        "cache_prompt": True,
        "stream": False,
    }).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{porta}/completion",
        data=corpo,
        headers={"Content-Type": "application/json", "User-Agent": UA_SONDA},
    )
    inicio = time.monotonic()
    with urllib.request.urlopen(req, timeout=teto_s) as r:
        d = json.load(r)
    d["_parede_s"] = round(time.monotonic() - inicio, 3)
    return d


VARIANTES = [
    {
        "nome": "producao-hoje",
        "modelo": "qwen3.5:4b",
        "descricao": "exatamente o que o ollama.service sobe hoje: mmproj, KV q8_0, flash-attn on",
        "flags": ["--mmproj", "{blob}", "--cache-type-k", "q8_0", "--cache-type-v", "q8_0",
                  "--flash-attn", "on", "-b", "1024", "-ub", "1024"],
    },
    {
        "nome": "sem-visao-kv-f16",
        "modelo": "qwen3.5:4b",
        "descricao": "mesmo modelo sem a torre de visao e com KV f16, flash-attn off",
        "flags": ["--cache-type-k", "f16", "--cache-type-v", "f16",
                  "--flash-attn", "off", "-b", "1024", "-ub", "1024"],
    },
    {
        "nome": "denso-qwen3-4b",
        "modelo": "qwen3:4b",
        "descricao": "modelo denso e so-texto: sem torre de visao e sem estado recorrente, cache de prefixo utilizavel",
        "flags": ["--cache-type-k", "f16", "--cache-type-v", "f16",
                  "--flash-attn", "off", "-b", "1024", "-ub", "1024"],
    },
]


def roda_variante(v: dict, amostras: list[dict], sistema: str, args) -> dict:
    blob = blob_do_modelo(v["modelo"])
    flags = [f.replace("{blob}", str(blob)) for f in v["flags"]]
    cmd = [str(LLAMA_SERVER), "--model", str(blob), "--port", str(args.porta),
           "--host", "127.0.0.1", "--no-webui", "-c", str(args.contexto), "-np", "1",
           "--no-webui", "--log-verbosity", "1", *flags]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    try:
        carga_s = round(espera_pronto(args.porta, proc, args.teto_carga_s), 1)
        medidas = []
        for a in amostras:
            intrusos = residentes_no_ollama()
            if intrusos:
                raise JanelaContaminada(
                    "modelo residente no ollama durante a medicao: " + ", ".join(intrusos))
            prompt = sistema + "\n\nTEXTO:\n" + a["texto"] + "\n\nJSON:"
            carga_antes = carga1()
            r = completa(args.porta, prompt, args.n_predict, args.teto_requisicao_s)
            t = r.get("timings", {})
            medidas.append({
                "id_fonte": a["id_fonte"],
                "prompt_n": t.get("prompt_n"),
                "prompt_ms": round(t.get("prompt_ms", 0.0), 1),
                "prompt_tok_s": round(t.get("prompt_per_second") or 0.0, 2),
                "eval_n": t.get("predicted_n"),
                "eval_tok_s": round(t.get("predicted_per_second") or 0.0, 2),
                "parede_s": r["_parede_s"],
                "load1_antes": carga_antes,
                "load1_depois": carga1(),
            })
        intrusos = residentes_no_ollama()
        if intrusos:
            raise JanelaContaminada(
                "modelo residente no ollama durante a medicao: " + ", ".join(intrusos))
        # Repeticao da PRIMEIRA amostra: com cache de prefixo util, `prompt_n`
        # cai para perto de zero; sem ele, repete o numero da primeira passada.
        prompt = sistema + "\n\nTEXTO:\n" + amostras[0]["texto"] + "\n\nJSON:"
        r = completa(args.porta, prompt, args.n_predict, args.teto_requisicao_s)
        t = r.get("timings", {})
        reuso = {
            "prompt_n_1a_passada": medidas[0]["prompt_n"],
            "prompt_n_repetida": t.get("prompt_n"),
            "parede_s_repetida": r["_parede_s"],
        }
        pico_kb = pico_rss_kb(proc.pid)
    finally:
        proc.send_signal(signal.SIGTERM)
        try:
            proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            proc.wait(timeout=10)

    def mediana(chave):
        vals = sorted(m[chave] for m in medidas if m[chave])
        return vals[len(vals) // 2] if vals else None

    return {
        "schema_version": "medicao_runner_local_v1",
        "variante": v["nome"],
        "descricao": v["descricao"],
        "modelo": v["modelo"],
        "blob_sha256": blob.name.removeprefix("sha256-"),
        "flags": flags,
        "contexto": args.contexto,
        "amostras": len(medidas),
        "carga_s": carga_s,
        "pico_rss_kb": pico_kb,
        "prompt_tok_s_mediana": mediana("prompt_tok_s"),
        "eval_tok_s_mediana": mediana("eval_tok_s"),
        "parede_s_mediana": mediana("parede_s"),
        "parede_s_total": round(sum(m["parede_s"] for m in medidas), 1),
        "reuso_de_prefixo": reuso,
        "medidas": medidas,
        "medido_em": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--amostras", type=int, default=5, help="ementas por variante (stride deterministico)")
    p.add_argument("--porta", type=int, default=18099)
    p.add_argument("--contexto", type=int, default=8192)
    p.add_argument("--n-predict", type=int, default=200)
    p.add_argument("--teto-carga-s", type=int, default=300)
    p.add_argument("--teto-requisicao-s", type=int, default=600)
    p.add_argument("--min-livre-mb", type=int, default=6000,
                   help="recusa rodar com menos folga que isto")
    p.add_argument("--variante", action="append",
                   help="roda so a(s) variante(s) nomeada(s); repetivel")
    args = p.parse_args()

    if not LLAMA_SERVER.is_file():
        print(f"llama-server ausente em {LLAMA_SERVER}", file=sys.stderr)
        return 2
    residentes = residentes_no_ollama()
    if residentes:
        print("RECUSO: o ollama tem modelo residente (" + ", ".join(residentes) + ").",
              file=sys.stderr)
        print("Dois runners residentes ja derrubaram esta maquina pelo earlyoom.",
              file=sys.stderr)
        print("Descarregue antes:", file=sys.stderr)
        print("""  curl -s http://127.0.0.1:11434/api/generate -d '{"model":"<nome>","keep_alive":0}'""",
              file=sys.stderr)
        return 3
    livre = mem_livre_mb()
    if livre < args.min_livre_mb:
        print(f"RECUSO: MemAvailable {livre} MB < --min-livre-mb {args.min_livre_mb}",
              file=sys.stderr)
        return 3

    sistema = sistema_da_extracao()
    amostras = ementas(args.amostras)
    escolhidas = [v for v in VARIANTES if not args.variante or v["nome"] in args.variante]
    if not escolhidas:
        print("nenhuma variante casou com --variante", file=sys.stderr)
        return 2

    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    contaminadas = []
    for v in escolhidas:
        print(f"== {v['nome']} ({v['modelo']}) ...", flush=True)
        try:
            linha = roda_variante(v, amostras, sistema, args)
        except JanelaContaminada as e:
            contaminadas.append(v["nome"])
            print(f"   DESCARTADA: {e}", file=sys.stderr, flush=True)
            print("   pare o wikijuridica-cerebro.service e descarregue o modelo "
                  "antes de repetir esta variante.", file=sys.stderr, flush=True)
            continue
        with SAIDA.open("a", encoding="utf-8") as f:
            f.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
        r = linha["reuso_de_prefixo"]
        print(f"   prompt {linha['prompt_tok_s_mediana']} tok/s | "
              f"eval {linha['eval_tok_s_mediana']} tok/s | "
              f"parede mediana {linha['parede_s_mediana']} s | "
              f"pico RSS {linha['pico_rss_kb'] // 1024} MiB | "
              f"reuso de prefixo: {r['prompt_n_1a_passada']} -> {r['prompt_n_repetida']} tokens",
              flush=True)
    print(f"gravado em {SAIDA}")
    if contaminadas:
        print("variantes DESCARTADAS por janela contaminada: " + ", ".join(contaminadas),
              file=sys.stderr)
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main())
