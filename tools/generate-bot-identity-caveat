#!/usr/bin/env python3
"""generate-bot-identity-caveat — marca, sem reescrever, a série de crawler que
foi medida por STRING de User-Agent.

POR QUE EXISTE, com o número que obriga: até 2026-08-12 toda a telemetria de
crawler deste projeto identificava o robô pela string do User-Agent. Isso soma as
sondas de auditoria do próprio repositório, porque o cabeçalho
`X-Bot-Simulation` — que marca a simulação — só é visível ao nginx e NUNCA à
borda da Cloudflare, que não expõe cabeçalho arbitrário no GraphQL. Medições do
mesmo dia:

  - log do nginx: 2.053 das 2.062 linhas com "Googlebot" eram `bot_sim=true`
    (229x mais sonda que crawler);
  - borda, requisições de Googlebot por dia — por UA: 08-06=189, 08-07=150,
    08-11=1040, 08-12=380; por bot VERIFICADO: 25, 102, 1038 e 10;
  - relatório de tráfego da borda, janela de 24h: "Anthropic 33" e "Perplexity
    39" viraram ZERO ao exigir verificação — nenhuma daquelas requisições foi
    autenticada pela Cloudflare.

O QUE ESTE PRODUTOR FAZ, E O QUE ELE NÃO FAZ: ele ANOTA. Não apaga linha, não
reescreve arquivo, não corrige número histórico. Os ledgers são append-only e a
regra do repositório é correção só para frente — a linha antiga continua legível
por qualquer consumidor, e passa a ter, ao lado, o registro assinado de por que
ela não vale como medida de crawler. É a mesma postura da quarentena de
telemetria (`generate-edge-telemetry-quarantine`), aplicada a um defeito de
IDENTIDADE em vez de um de MAGNITUDE.

A ressalva é por (série, schema_version), não por linha: o defeito é do
PRODUTOR, e o schema_version é exatamente o que diz qual produtor escreveu
aquela linha. Uma anotação por linha produziria milhares de registros dizendo a
mesma coisa, e o volume esconderia o fato.

Escreve `data/ops/bot_identity_caveat.jsonl`, append-only. Consumidor deduplica
por (series, affected_schema_version) mantendo a ÚLTIMA linha.

Uso:
    tools/generate-bot-identity-caveat
    tools/generate-bot-identity-caveat --json
"""
import argparse
import datetime
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
SAIDA = os.path.join(ROOT, "data/ops/bot_identity_caveat.jsonl")
SCHEMA = "bot_identity_caveat_v1"

# (série, schema afetado, schema corrigido, produtor, o que aquele schema media)
#
# `edge_traffic_daily_v1/v2/v3` entram porque `external_sampled_24h` e
# `local_verification_sampled_24h` saíam da mesma classificação por UA — o v3 é
# recente (a separação do aquecimento, de 2026-08-12 de manhã) e ainda assim
# nasceu com a identidade por string, então também fica sob ressalva.
ESCOPOS = [
    ("data/ops/crawl_coverage_daily.jsonl", "crawl_coverage_daily_v1",
     "crawl_coverage_daily_v2", "tools/measure-crawl-coverage",
     "cobertura do acervo por crawler, contada por userAgent_like sem verificacao"),
    ("data/ops/edge_bot_agents_daily.jsonl", "edge_bot_agents_daily_v1",
     "edge_bot_agents_daily_v3", "tools/generate-bot-agents-daily",
     "requisicoes por bot, contadas por string de User-Agent"),
    ("data/ops/edge_bot_agents_daily.jsonl", "edge_bot_agents_daily_v2",
     "edge_bot_agents_daily_v3", "tools/generate-bot-agents-daily",
     "requisicoes por bot, por string de User-Agent mais heuristico de pais; "
     "declarava authenticity=unverifiable_at_edge sobre a premissa falsa de que "
     "o plano Free negava verifiedBotCategory"),
    ("data/ops/edge_traffic_daily.jsonl", "edge_traffic_daily_v1",
     "edge_traffic_daily_v4", "tools/check-edge-traffic",
     "separacao visita x trafego proprio por string de User-Agent"),
    ("data/ops/edge_traffic_daily.jsonl", "edge_traffic_daily_v2",
     "edge_traffic_daily_v4", "tools/check-edge-traffic",
     "separacao visita x trafego proprio por string de User-Agent"),
    ("data/ops/edge_traffic_daily.jsonl", "edge_traffic_daily_v3",
     "edge_traffic_daily_v4", "tools/check-edge-traffic",
     "separacao visita x trafego proprio por User-Agent mais heuristico de pais"),
]

MOTIVO = (
    "identidade de crawler contada por STRING de User-Agent, sem verificacao. "
    "A borda da Cloudflare nao ve o cabecalho X-Bot-Simulation que marca a sonda "
    "de auditoria deste repositorio, entao a sonda entrou na serie como se fosse "
    "o crawler. Vale como registro historico e como sinal grosso de presenca; NAO "
    "vale como contagem de rastreio real."
)

EVIDENCIA = {
    "nginx_access_log_2026-08-12": {
        "linhas_googlebot": 2062,
        "linhas_googlebot_bot_sim": 2053,
        "fator_inflacao": 229.1,
        "fonte": "/var/log/nginx/wikijuridica/access.log, campo bot_sim do log_format wj_main",
    },
    "borda_googlebot_requisicoes_por_dia": {
        "por_user_agent": {"2026-08-06": 189, "2026-08-07": 150,
                           "2026-08-11": 1040, "2026-08-12": 380},
        "por_bot_verificado": {"2026-08-06": 25, "2026-08-07": 102,
                               "2026-08-11": 1038, "2026-08-12": 10},
        "fonte": "httpRequestsAdaptiveGroups, dimensao verifiedBotCategory",
    },
    "cobertura_acumulada_googlebot_8_dias": {
        "por_user_agent": 7175,
        "por_bot_verificado": 7147,
        "sitemap_total": 9835,
        "nota": ("a cobertura e um CONJUNTO de paths, nao uma contagem de "
                 "requisicoes: a sonda repetia paths que o crawler tambem pediu, "
                 "entao ela inflou o volume em ordens de grandeza e o conjunto em "
                 "28 URLs. Os dois numeros medem coisas diferentes e so o de "
                 "volume estava 229x errado."),
    },
}


def contar_linhas(rel, schema_alvo):
    """Quantas linhas daquele schema existem, e entre que datas."""
    caminho = os.path.join(ROOT, rel)
    total = 0
    datas = set()
    if not os.path.isfile(caminho):
        return None, total, datas
    try:
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except json.JSONDecodeError:
                    continue
                if registro.get("schema_version") != schema_alvo:
                    continue
                total += 1
                if registro.get("date"):
                    datas.add(registro["date"])
    except OSError:
        return None, total, datas
    return True, total, datas


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    agora = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    registros = []
    for rel, schema_afetado, schema_corrigido, produtor, media in ESCOPOS:
        existe, total, datas = contar_linhas(rel, schema_afetado)
        if existe is None:
            print("  serie ausente: %s (nada a anotar)" % rel)
            continue
        if not total:
            # Schema sem nenhuma linha no arquivo não recebe ressalva: anotar o
            # que não existe encheria o ledger de afirmação vazia.
            continue
        registros.append({
            "schema_version": SCHEMA,
            "generated_at": agora,
            "series": rel,
            "affected_schema_version": schema_afetado,
            "affected_lines": total,
            "affected_dates_first": min(datas) if datas else "",
            "affected_dates_last": max(datas) if datas else "",
            "affected_dates_count": len(datas),
            "what_it_measured": media,
            "caveat": MOTIVO,
            "corrected_schema_version": schema_corrigido,
            "corrected_producer": produtor,
            "identity_verification_now": "cloudflare_verified_bot_category",
            "evidence": EVIDENCIA,
            "lines_deleted": 0,
            "lines_rewritten": 0,
        })

    # O estado acumulado da cobertura não é ledger de linhas, é arquivo de
    # estado — e o namespace antigo dele foi CONGELADO em vez de apagado. A
    # ressalva registra isso no mesmo lugar, senão a única prova de que existe
    # um acumulado por UA estaria dentro de um JSON que ninguém abre.
    estado = os.path.join(ROOT, "data/ops/crawl_coverage_state.json")
    if os.path.isfile(estado):
        try:
            with open(estado, encoding="utf-8") as handle:
                dados = json.load(handle)
        except Exception:
            dados = {}
        legado = dados.get("crawlers") or {}
        if legado:
            registros.append({
                "schema_version": SCHEMA,
                "generated_at": agora,
                "series": "data/ops/crawl_coverage_state.json",
                "affected_schema_version": "crawl_coverage_state_v1",
                "affected_lines": len(legado),
                "affected_dates_first": "",
                "affected_dates_last": "",
                "affected_dates_count": 0,
                "what_it_measured": (
                    "conjunto acumulado de paths por crawler, montado por "
                    "userAgent_like sem verificacao (namespace 'crawlers')"),
                "caveat": MOTIVO + (" O namespace foi CONGELADO em %s e nao recebe "
                                    "mais ingestao; o acumulado valido vive em "
                                    "'crawlers_verified'."
                                    % dados.get("legacy_frozen_at", "?")),
                "corrected_schema_version": "crawl_coverage_state_v2",
                "corrected_producer": "tools/measure-crawl-coverage",
                "identity_verification_now": "cloudflare_verified_bot_category",
                "evidence": EVIDENCIA,
                "frozen_crawlers": sorted(legado),
                "lines_deleted": 0,
                "lines_rewritten": 0,
            })

    if registros:
        os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
        with open(SAIDA, "a", encoding="utf-8") as handle:
            for registro in registros:
                handle.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")

    print("generate-bot-identity-caveat — series sob ressalva de IDENTIDADE")
    for registro in registros:
        janela = ""
        if registro["affected_dates_first"]:
            janela = "  %s..%s" % (registro["affected_dates_first"],
                                    registro["affected_dates_last"])
        print("  %-40s %-28s %6d linha(s)%s"
              % (os.path.basename(registro["series"]),
                 registro["affected_schema_version"],
                 registro["affected_lines"], janela))
    print("\n  nenhuma linha apagada, nenhuma reescrita — anotacao ao lado, em %s"
          % os.path.relpath(SAIDA, ROOT))
    print("  append-only: dedupe por (series, affected_schema_version), ULTIMA linha vence")

    if args.json:
        print(json.dumps(registros, ensure_ascii=False, indent=1, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
