#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# O contract test abaixo é caro: recompila/relinga o pacote e, dentro dele,
# codex2sourcefrontier.Generate(".") recarrega e reprocessa ao vivo as camadas
# de demanda (demandexpansion ~26 MB + demandobservations) a cada execução.
# Rodar isso solto, fora de tools/run-heavy-throttled, deixa N agentes
# executando o mesmo trabalho pesado em paralelo sem lock, sem teto de tempo e
# sem entrada no ledger de comandos — foi o defeito apontado na auditoria de
# 2026-07-29. Precedente do mesmo padrão (test caro + gate, ambos throttled):
# tools/check-authorial-mass-global-similarity-audit.
# O budget é FOLGADO de propósito: run-heavy-throttled usa o MENOR entre
# BUDGET_MS e TIMEOUT_SECONDS como timeout efetivo, e apertar isso mataria o
# teste no meio, trocando um problema de escala por um falso-vermelho.
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-check:codex2-source-frontier:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-540000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-120000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-check_pass_or_report_issues_with_timings}"
./tools/run-heavy-throttled go-modern test -count=1 ./internal/codex2sourcefrontier ./internal/contract/codex2 -run TestCodex2SourceFrontierMapsMassiveOfficialSourceGapsWithoutPublishing
# `--timings` NAO e enfeite: run-heavy-throttled classifica `run-check` como
# comando pesado de projeto e EXIGE evidencia de tempo antes de pegar o lock.
# Sem a flag o envelope aborta com exit 2 -- "missing: timing_evidence" -- e
# este gate ficava IMPOSSIVEL de executar por qualquer um, sempre vermelho por
# um motivo que nada tem a ver com a saude do repositorio (medido na
# remedicao da bateria, BUG-109, 2026-08-29). O comentario acima deste bloco
# afirmava que envolver aqui "nao introduz exit=2": ele valia so para a linha
# de `go-modern test`, nao para esta. O irmao sancionado
# tools/check-authorial-mass-global-similarity-audit ja passa a flag.
exec ./tools/run-heavy-throttled "$ROOT/tools/run-check" codex2-source-frontier --timings "$@"
