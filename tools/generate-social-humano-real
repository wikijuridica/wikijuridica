def serializa(objeto):
    return json.dumps(objeto, ensure_ascii=False, sort_keys=True)


def linhas_existentes():
    """(por_dia, cruas_ilegiveis) do destino, preservando o texto original.

    Dia que não foi recalculado é reescrito BYTE A BYTE: re-serializar poderia
    mudar bytes de uma linha que ninguém pediu para mexer.
    """
    por_dia = {}
    ilegiveis = []
    if not os.path.exists(DESTINO):
        return por_dia, ilegiveis
    with open(DESTINO, encoding="utf-8") as handle:
        for bruta in handle:
            texto = bruta.rstrip("\n")
            if not texto.strip():
                continue
            try:
                objeto = json.loads(texto)
            except ValueError:
                ilegiveis.append(texto)
                continue
            if objeto.get("registro") == "cabecalho":
                continue
            dia = objeto.get("dia")
            if not dia:
                ilegiveis.append(texto)
                continue
            por_dia[dia] = texto
    return por_dia, ilegiveis


def le_fonte(dia):
    """(registros, descritor da fonte) do dia, ou (None, None) se não houver arquivo."""
    caminho = os.path.join(FONTE_DIR, "nginx-%s.jsonl" % dia)
    if not os.path.exists(caminho):
        return None, None
    registros = []
    linhas = 0
    ilegiveis = 0
    with open(caminho, encoding="utf-8") as handle:
        for bruta in handle:
            if not bruta.strip():
                continue
            linhas += 1
            try:
                registros.append(json.loads(bruta))
            except ValueError:
                ilegiveis += 1
    fonte = {
        "arquivo": os.path.relpath(caminho, RAIZ),
        "sha256": sha256_do_arquivo(caminho),
        "linhas": linhas,
    }
    if ilegiveis:
        fonte["linhas_ilegiveis"] = ilegiveis
    return registros, fonte


def escreve(novas):
    """Reescrita atômica do destino inteiro, preservando o que não foi recalculado."""
    por_dia, ilegiveis = linhas_existentes()
    for dia, linha in novas.items():
        por_dia[dia] = serializa(linha)
    os.makedirs(os.path.dirname(DESTINO), exist_ok=True)
    temporario = DESTINO + ".tmp"
    with open(temporario, "w", encoding="utf-8") as handle:
        handle.write(serializa(cabecalho()) + "\n")
        for dia in sorted(por_dia):
            handle.write(por_dia[dia] + "\n")
        # Linha que este produtor não consegue interpretar não se apaga: ela
        # volta ao arquivo, no fim, e o operador é avisado por stderr.
        for texto in ilegiveis:
            handle.write(texto + "\n")
    os.replace(temporario, DESTINO)
    return len(ilegiveis)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dias", type=int, default=2, help="quantos dias retroativos (padrão 2)")
    ap.add_argument("--dia", help="um dia específico, YYYY-MM-DD (ignora --dias)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    hoje = datetime.datetime.now(datetime.timezone.utc).date()
    if args.dia:
        try:
            alvos = [datetime.date.fromisoformat(args.dia).isoformat()]
        except ValueError:
            print("generate-social-humano-real: --dia inválido: %s" % args.dia, file=sys.stderr)
            return 2
    else:
        alvos = [(hoje - datetime.timedelta(days=n)).isoformat() for n in range(max(1, args.dias))]

    novas = {}
    ausentes = []
    antes_da_superficie = []
    for dia in sorted(alvos):
        if dia < DIA_DE_NASCIMENTO_DA_SUPERFICIE:
            antes_da_superficie.append(dia)
            continue
        registros, fonte = le_fonte(dia)
        if registros is None:
            ausentes.append(dia)
            continue
        novas[dia] = agrega(dia, registros, fonte)

    if not novas:
        print("generate-social-humano-real: nenhum dia a agregar — sem ledger de origem "
              "para %s (produtor: tools/generate-origin-access-ledger)%s"
              % (", ".join(ausentes) or "nenhum dia pedido",
                 ("; %s é anterior a %s, quando a superfície entrou no ar"
                  % (", ".join(antes_da_superficie), DIA_DE_NASCIMENTO_DA_SUPERFICIE))
                 if antes_da_superficie else ""),
              file=sys.stderr)
        return 2

    preservadas = escreve(novas)
    if preservadas:
        print("generate-social-humano-real: %d linha(s) ilegível(is) do destino foram "
              "preservadas no fim do arquivo" % preservadas, file=sys.stderr)

    resultado = {"schema_version": SCHEMA, "destino": os.path.relpath(DESTINO, RAIZ),
                 "dias": {d: novas[d] for d in sorted(novas)},
                 "sem_ledger_de_origem": ausentes,
                 "anteriores_a_superficie": antes_da_superficie,
                 "dia_de_nascimento_da_superficie": DIA_DE_NASCIMENTO_DA_SUPERFICIE}
    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=2, sort_keys=True))
        return 0

    print("generate-social-humano-real -> %s" % os.path.relpath(DESTINO, RAIZ))
    for dia in sorted(novas):
        linha = novas[dia]
        print("  %s  %s" % (dia, _botagents.denominador_em_uma_linha(
            linha["denominador"], rotulo="requisicoes /redesocial")))
        print("     PISO humano: %d requisição(ões) · %d sessão(ões) · %d visitante(s) "
              "distinto(s) — sem teto (borda serve HIT sem tocar a origem)"
              % (linha["requisicoes_humanas_piso"], linha["sessoes_piso"],
                 linha["visitantes_distintos_piso"]))
        if linha["por_origem_sessao"]:
            print("     origem das sessões: %s" % linha["por_origem_sessao"])
        if linha["por_rota"]:
            print("     rotas: %s" % linha["por_rota"])
        if linha["descontadas_por_motivo"]:
            print("     descontadas: %s" % linha["descontadas_por_motivo"])
    for dia in ausentes:
        print("  %s  sem ledger de origem" % dia)
    for dia in antes_da_superficie:
        print("  %s  anterior a %s: a superfície ainda não existia, e zero aqui seria "
              "linha reta falsa" % (dia, DIA_DE_NASCIMENTO_DA_SUPERFICIE))
    return 0


if __name__ == "__main__":
    sys.exit(main())
