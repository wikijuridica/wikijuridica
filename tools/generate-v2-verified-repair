#!/usr/bin/env python3
"""generate-v2-verified-repair — registra que o defeito apontado por um auditor sumiu.

O PROBLEMA QUE ISTO RESOLVE: 133 páginas estão fora do ar por veredito humano
`REPROVADA:N`. O censo de severidade decide olhando os ARQUIVOS DE AUDITORIA, não
o conteúdo atual — então corrigir o texto não muda nada. E acrescentar um
`APROVADA` produz `{APROVADA, REPROVADA}` = `veredito_conflitante`, que também é
crítico. Hoje NÃO EXISTE caminho para uma página reprovada voltar ao ar, por mais
correta que ela fique. Isso não é rigor; é um beco.

O QUE ESTE REGISTRO AFIRMA, e o que ele deliberadamente NÃO afirma:

  AFIRMA  — "o defeito específico que o auditor apontou não está mais no
            conteúdo, e isso é verificável agora, por um predicado que qualquer
            um pode re-executar".
  NÃO AFIRMA — "esta página está aprovada". Aprovação é juízo editorial humano
            sobre a página inteira. Um reparo verificado cobre UM defeito.

A distinção é o que impede este mecanismo de virar um botão de anular auditoria.
Se o auditor apontou dois defeitos e só um foi corrigido, o veredito continua de
pé — e é exatamente o caso de 3 das 5 páginas examinadas em 2026-08-06:

  fam-uniao-homoafetiva          REPROVADA:5, nota "art. 1723 sem separador"   -> COBERTO
  imob-juros-multa-cota-atrasada REPROVADA:5, nota "O artigo 1336, §1º"        -> COBERTO
  imob-composse-verbete          REPROVADA:1,5, nota "vírgula solta"           -> NÃO coberto
  fam-anulacao-casamento         REPROVADA:5, defeito de conteúdo jurídico     -> NÃO coberto
  fam-casamento-putativo         REPROVADA:1, erro de redação                  -> NÃO coberto

Os três últimos tiveram formatação corrigida na mesma sessão — e ainda assim NÃO
entram, porque o defeito apontado era outro. Corrigir algo na página não é
corrigir o que o auditor viu.

O predicado é uma expressão regular que NÃO PODE casar no conteúdo atual. Ele é
gravado no registro e reavaliado por `tools/check-verified-repair` a cada
verificação: se alguém reintroduzir o defeito, o reparo deixa de valer sozinho.

Read-only sobre o estoque. Grava só o registro de reparo.

Uso:
    tools/generate-v2-verified-repair --dry-run
    tools/generate-v2-verified-repair
"""
from __future__ import annotations

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
REGISTRO = os.path.join(ROOT, "data/ops/v2_verified_repairs.jsonl")
SHARDS = os.path.join(ROOT, "data/editorial/v2_pages/*.jsonl")

# Cada entrada é um reparo que cobre INTEGRALMENTE o defeito citado pelo auditor.
# `defect_quoted` é a nota literal do veredito — não uma paráfrase minha.
# `forbidden_pattern` é o que não pode mais existir no corpo.
REPAROS = [
    {
        "intent_id": "fam-uniao-homoafetiva",
        "original_verdict": "REPROVADA:5",
        "verdict_source": ".agents/runtime/staging/audit_lote37_banda2.json",
        "defect_class": "citacao_legal_numeracao_sem_separador",
        "defect_quoted": (
            "Artefato de numeracao na citacao legal: 'deu interpretação conforme a "
            "Constituição ao art. 1723 do Código Civil' (sem separador de milhar), "
            "enquanto o restante da pagina usa a forma correta"
        ),
        "repair_tool": "tools/generate-v2-separador-milhar-citacao-20260806",
        "forbidden_pattern": r"\bart(?:igo)?s?\.?\s*\d{4,5}(?![\d.\-/])",
    },
    {
        "intent_id": "imob-juros-multa-cota-atrasada",
        "original_verdict": "REPROVADA:5",
        "verdict_source": ".agents/runtime/staging/_lote21_b3_verdicts.json",
        "defect_class": "citacao_legal_numeracao_sem_separador",
        "defect_quoted": (
            "O artigo 1336, §1º, do Código Civil determina que o condômino em mora "
            "fica sujeito aos juros moratórios convencionados (numeracao sem separador, "
            "enquanto a mesma pagina usa 'art. 1.336, §1º' na forma correta)"
        ),
        "repair_tool": "tools/generate-v2-separador-milhar-citacao-20260806",
        "forbidden_pattern": r"\bart(?:igo)?s?\.?\s*\d{4,5}(?![\d.\-/])",
    },
    {
        # Terceiro reparo, 2026-08-20. Ele difere dos dois acima num ponto que
        # vale registrar: os outros sao ARTEFATO DE FORMATACAO (numero de artigo
        # sem separador de milhar), e este e AFIRMACAO DE DIREITO ERRADA.
        #
        # A pagina trazia o subtitulo "O limite de 40% da remuneracao
        # disponivel" enquanto o CORPO dela se recusa a cravar percentual --
        # diz que "esse percentual ja passou por diversas alteracoes
        # legislativas ao longo dos anos, e o valor atualizado em vigor consta
        # no texto compilado". O corpo esta certo e e prudente: o teto do
        # consignado mudou mais de uma vez. O subtitulo fazia justamente o que o
        # corpo evita, e quem so passa os olhos nos subtitulos saia com um
        # numero que a pagina nao sustenta.
        #
        # O predicado nao procura "40%" -- o corpo pode legitimamente discutir
        # percentuais. Ele procura o SUBTITULO exato que afirmava, que e o
        # defeito que o auditor apontou e o unico que este reparo cobre.
        "intent_id": "banc-consignado-clt-como-funciona",
        "original_verdict": "REPROVADA:5",
        "verdict_source": ".agents/runtime/staging/audit_lote14_banda1.json",
        "defect_class": "afirmacao_de_percentual_em_subtitulo_sem_lastro_no_corpo",
        "defect_quoted": (
            "Subtitulo 'O limite de 40% da remuneracao disponivel' afirmando um "
            "percentual que o proprio corpo da secao se recusa a cravar, por saber "
            "que o teto do consignado mudou mais de uma vez"
        ),
        "repair_tool": "tools/generate-v2-heading-consignado-teto-20260820",
        "forbidden_pattern": r"O limite de 40% da remunera[çc][ãa]o dispon[íi]vel",
    },
    {
        # Quarto reparo, 2026-08-20. Classe nova outra vez: AFIRMACAO NO PRESENTE
        # ANCORADA NUMA DATA -- a frase que envelhece sozinha.
        #
        # A abertura dizia "Em 11 de julho de 2026, o cadastro eleitoral esta
        # fechado". Era verdadeira em julho, continuava verdadeira em agosto, e
        # viraria FALSA em 3 de novembro, quando o cadastro reabre -- sem ninguem
        # olhando e sem gate nenhum acusando. Num portal juridico, "esta fechado"
        # precisa continuar verdade enquanto a pagina estiver no ar.
        #
        # O predicado procura a ancora "Em <dia> de julho de 2026, o cadastro
        # eleitoral esta fechado", que e a forma exata do defeito. Nao procura
        # datas em geral: a pagina PRECISA citar datas -- 7 de maio, 4 de
        # outubro, 3 de novembro sao o conteudo dela. O que nao pode e afirmar
        # no presente a partir de um dia especifico.
        "intent_id": "proc-titulo-regularizar",
        "original_verdict": "REPROVADA:4",
        "verdict_source": ".agents/runtime/staging/audit_banda5_lote2_verdicts.json",
        "defect_class": "afirmacao_no_presente_ancorada_em_data_que_envelhece_sozinha",
        "defect_quoted": (
            "Abertura afirmando 'Em 11 de julho de 2026, o cadastro eleitoral esta "
            "fechado' -- frase no presente ancorada num dia, que se torna falsa por "
            "conta propria em 3 de novembro, quando o cadastro reabre"
        ),
        "repair_tool": "tools/generate-v2-titulo-eleitoral-data-ancorada-20260820",
        "forbidden_pattern": r"Em \d{1,2} de julho de 2026, o cadastro eleitoral est[áa] fechado",
    },
]


def corpo(registro):
    partes = [registro.get("opening") or ""]
    for secao in registro.get("sections") or []:
        partes += [secao.get("heading") or "", secao.get("text") or ""]
    for item in registro.get("faq") or []:
        partes += [item.get("q") or "", item.get("a") or ""]
    for campo in ("title", "h1", "meta_description"):
        partes.append(registro.get(campo) or "")
    return "\n".join(partes)


def carregar_estoque():
    encontrados = {}
    for caminho in sorted(glob.glob(SHARDS)):
        with open(caminho, encoding="utf-8") as handle:
            for numero, linha in enumerate(handle, 1):
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except json.JSONDecodeError:
                    continue
                intent = registro.get("intent_id")
                if intent:
                    encontrados[intent] = (registro, os.path.relpath(caminho, ROOT), numero, linha)
    return encontrados


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    estoque = carregar_estoque()
    agora = datetime.datetime.now(datetime.timezone.utc).isoformat()
    novos, recusados = [], []

    for reparo in REPAROS:
        intent = reparo["intent_id"]
        achado = estoque.get(intent)
        if not achado:
            recusados.append((intent, "intent não encontrado no estoque"))
            continue
        registro, shard, numero, linha_bruta = achado

        # A verificação que dá nome ao registro: o defeito NÃO pode mais existir.
        # Sem isto, o arquivo seria uma declaração de fé.
        texto = corpo(registro)
        padrao = re.compile(reparo["forbidden_pattern"])
        ocorrencias = padrao.findall(texto)
        if ocorrencias:
            recusados.append((intent, "defeito AINDA presente: %d ocorrência(s) de %r"
                              % (len(ocorrencias), reparo["forbidden_pattern"])))
            continue

        # O veredito citado precisa existir de verdade no arquivo apontado.
        caminho_veredito = os.path.join(ROOT, reparo["verdict_source"])
        if not os.path.exists(caminho_veredito):
            recusados.append((intent, "arquivo de veredito inexistente: %s" % reparo["verdict_source"]))
            continue

        novos.append({
            "schema_version": 1,
            "record_type": "v2_verified_repair",
            "intent_id": intent,
            "original_verdict": reparo["original_verdict"],
            "verdict_source": reparo["verdict_source"],
            "defect_class": reparo["defect_class"],
            "defect_quoted": reparo["defect_quoted"],
            "forbidden_pattern": reparo["forbidden_pattern"],
            "repair_tool": reparo["repair_tool"],
            "source_shard": shard,
            "source_line": numero,
            "record_sha256_after_repair": hashlib.sha256(linha_bruta.encode("utf-8")).hexdigest(),
            "verified_at": agora,
            "verification": "forbidden_pattern_absent_from_body",
            # O que este registro NÃO é. Fica no próprio dado para que ninguém o
            # leia como aprovação editorial.
            "scope": "cobre_apenas_o_defeito_citado_nao_e_aprovacao_da_pagina",
            "reviewer_role": "automated_defect_class_verification",
        })

    print("=== REPARO VERIFICADO ===")
    print("candidatos            : %d" % len(REPAROS))
    print("verificados e válidos : %d" % len(novos))
    for registro in novos:
        print("  %-34s %s  (%s)" % (registro["intent_id"], registro["original_verdict"],
                                    registro["defect_class"]))
    if recusados:
        print("recusados             : %d" % len(recusados))
        for intent, motivo in recusados:
            print("  %-34s %s" % (intent, motivo))

    if args.dry_run:
        print("\n--dry-run: nada gravado.")
        return 0
    if not novos:
        print("\nnada a gravar.")
        return 0

    existentes = set()
    if os.path.exists(REGISTRO):
        with open(REGISTRO, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if linha:
                    try:
                        anterior = json.loads(linha)
                    except json.JSONDecodeError:
                        continue
                    existentes.add((anterior.get("intent_id"), anterior.get("original_verdict")))
    gravados = 0
    os.makedirs(os.path.dirname(REGISTRO), exist_ok=True)
    with open(REGISTRO, "a", encoding="utf-8") as handle:
        for registro in novos:
            chave = (registro["intent_id"], registro["original_verdict"])
            if chave in existentes:
                continue
            handle.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")
            gravados += 1
    print("\ngravados %d registro(s) em %s" % (gravados, os.path.relpath(REGISTRO, ROOT)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
