#!/usr/bin/env python3
"""generate-noticias-licenca-corrigida — reescreve a base legal do estoque já coletado.

O DEFEITO, medido em 2026-08-26: o coletor de notícias gravava, em cada registro,
que o título da matéria é citado *"sob art. 46, VIII, na medida justificada para o
fim a atingir"*. Conferido verbatim na fonte primária (LEGIN da Câmara), são dois
erros num dispositivo só — a expressão citada é do art. 46, **III**, e para título
isolado nem se chega ao art. 46, porque o art. 8º, **VI** põe "os nomes e títulos
isolados" entre o que NÃO É OBJETO DE PROTEÇÃO. É base mais forte, não mais fraca.

O commit `5a4c7bb2` corrigiu o COLETOR. Isto aqui existe porque corrigir o
produtor não conserta o estoque: **1.174 registros já coletados** (20 a 26/08)
seguem carregando a citação errada, e o gerador de páginas lê a licença DO DADO
(`fontesDasMaterias`: `LicenseNote: item.Licenca`), não de uma tabela própria.
Sem esta correção, a primeira onda diária bem-sucedida publica a base legal
errada em página pública — e citação errada de dispositivo é a classe que o
`CLAUDE.md` marca como risco OAB real e P1 permanente.

Medido antes de escrever: **zero** chegou a página publicada (0 ocorrências no
`published_manifest` e 0 no HTML em `public/`). A correção pega antes do dano.

A TABELA NÃO É COPIADA — É LIDA DO PRÓPRIO COLETOR. `cmd/collect-noticias-oficiais`
é a autoridade sobre qual base legal vale para qual fonte, e uma segunda cópia
aqui envelheceria em silêncio, que é exatamente a classe de defeito que produziu
o problema original. O parsing falha ALTO: se a tabela do Go mudar de forma e o
regex não casar, isto sai com erro em vez de adivinhar.

CHAVE DESCONHECIDA É ERRO, nunca fallback. Um registro cuja `chave` não está na
tabela do coletor não tem base legal derivável, e escrever qualquer coisa nele
seria inventar fundamento jurídico — pior que deixar o errado, porque o errado ao
menos é rastreável.

PRESERVAÇÃO: os 7 arquivos estão em HEAD (commit `29d0fc84`), então o conteúdo
anterior é recuperável por `git show HEAD:<caminho>` — não se apaga trabalho aqui,
só se corrige para frente. A escrita é atômica (tmp + rename): interrupção deixa o
arquivo íntegro no estado anterior, nunca meio reescrito.

Uso:
    tools/generate-noticias-licenca-corrigida --dry-run
    tools/generate-noticias-licenca-corrigida
"""

import argparse
import json
import os
import re
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
COLETOR = os.path.join(RAIZ, "cmd", "collect-noticias-oficiais", "main.go")
ESTOQUE = os.path.join(RAIZ, "data", "research", "daily", "noticias-oficiais")

# Casa um bloco `{Chave: "x", ... Licenca: "...", Natureza: "..."}` do literal Go.
# Non-greedy e ancorado em Chave/Licenca para não atravessar entradas vizinhas.
PADRAO_FONTE = re.compile(
    r'\{Chave:\s*"([a-z0-9]+)".*?Licenca:\s*"((?:[^"\\]|\\.)*)"',
    re.DOTALL,
)


def tabela_do_coletor() -> dict[str, str]:
    """chave -> licença vigente, lida do Go que é a autoridade."""
    with open(COLETOR, encoding="utf-8") as f:
        fonte = f.read()
    # Recorta só o literal `var fontes = []Fonte{...}` para não casar com
    # exemplo em comentário nem com teste que porventura viva no mesmo arquivo.
    inicio = fonte.find("var fontes = []Fonte{")
    if inicio < 0:
        raise SystemExit(f"nao achei `var fontes = []Fonte{{` em {COLETOR} — "
                         "a tabela mudou de forma e este corretor precisa ser revisto")
    fim = fonte.find("\n}", inicio)
    if fim < 0:
        raise SystemExit(f"literal de fontes sem fechamento em {COLETOR}")
    bloco = fonte[inicio:fim]
    achados = {chave: lic.encode().decode("unicode_escape") if "\\" in lic else lic
               for chave, lic in PADRAO_FONTE.findall(bloco)}
    if not achados:
        raise SystemExit(f"o regex nao casou nenhuma fonte em {COLETOR} — "
                         "falhar alto e melhor que adivinhar base legal")
    return achados


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    tabela = tabela_do_coletor()
    print(f"tabela lida de {os.path.relpath(COLETOR, RAIZ)}: {len(tabela)} fonte(s)")
    for chave, lic in sorted(tabela.items()):
        print(f"  {chave:6s} {lic}")
    print()

    if not os.path.isdir(ESTOQUE):
        print(f"estoque ausente: {ESTOQUE}", file=sys.stderr)
        return 2

    arquivos = sorted(f for f in os.listdir(ESTOQUE) if f.endswith(".jsonl"))
    total = corrigidos = intactos = 0
    tocados = []
    desconhecidas: set[str] = set()

    for nome in arquivos:
        caminho = os.path.join(ESTOQUE, nome)
        with open(caminho, encoding="utf-8") as f:
            linhas = [l for l in f.read().split("\n") if l.strip()]
        saida = []
        mudou = 0
        for linha in linhas:
            registro = json.loads(linha)
            total += 1
            chave = registro.get("chave", "")
            if chave not in tabela:
                desconhecidas.add(chave)
                saida.append(linha)
                continue
            correta = tabela[chave]
            if registro.get("licenca") == correta:
                intactos += 1
                saida.append(linha)
                continue
            registro["licenca"] = correta
            mudou += 1
            corrigidos += 1
            # `separators` compacto porque é o que o `encoding/json` do Go emite,
            # e é o que está no disco (medido: `{"chave":"stj","orgao":...}`, sem
            # espaço depois de `:` nem de `,`). O default do Python acrescenta os
            # espaços e reescreveria as 1.174 linhas por formatação, num diff que
            # esconderia a única mudança que importa e trocaria o estilo do
            # arquivo sem que ninguém tivesse decidido isso.
            saida.append(json.dumps(registro, ensure_ascii=False, separators=(",", ":")))
        if mudou:
            tocados.append((nome, mudou, len(linhas)))
            if not args.dry_run:
                tmp = caminho + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write("\n".join(saida) + "\n")
                # Conferência antes do rename: contagem de linhas tem de bater.
                # Perder registro coletado seria descartar matéria-prima paga.
                with open(tmp, encoding="utf-8") as f:
                    conferidas = sum(1 for l in f if l.strip())
                if conferidas != len(linhas):
                    os.unlink(tmp)
                    print(f"ABORTADO em {nome}: {conferidas} linhas gravadas contra "
                          f"{len(linhas)} lidas", file=sys.stderr)
                    return 1
                os.replace(tmp, caminho)

    if desconhecidas:
        print(f"ERRO: {len(desconhecidas)} chave(s) fora da tabela do coletor: "
              f"{sorted(desconhecidas)}", file=sys.stderr)
        print("  Base legal nao e derivavel para elas, e inventar fundamento juridico "
              "seria pior que deixar o erro rastreavel.", file=sys.stderr)
        return 1

    print(f"registros    : {total}")
    print(f"ja corretos  : {intactos}")
    print(f"{'corrigiria' if args.dry_run else 'corrigidos'}   : {corrigidos}")
    for nome, mudou, linhas in tocados:
        print(f"  {nome}: {mudou}/{linhas}")
    if args.dry_run:
        print("\n--dry-run: nada gravado")
    return 0


if __name__ == "__main__":
    sys.exit(main())
