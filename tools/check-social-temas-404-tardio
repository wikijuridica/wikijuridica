#!/usr/bin/env python3
"""check-social-temas-404-tardio — o tema chegou, mas chegou DEPOIS do bot.

POR QUE ESTE GATE EXISTE, E POR QUE O IRMAO NAO O SUBSTITUI.

`check-social-temas-espelhados` compara dois CONJUNTOS: as rotas do
`published_manifest` e os temas de `var/social/social.db`. Ele responde "falta
tema agora?" — e essa pergunta se cura sozinha no deploy seguinte, porque
`tools/deploy-publico` (passo 2.7) roda `generate-social-temas --aplicar`. Medido
em 2026-09-16: manifesto 11.116, espelho 11.116, diferenca ZERO, gate verde.

E mesmo assim o portal mandou bot para o vazio nos seis dias anteriores:

  1.194 respostas 404 sob /redesocial/ entre 2026-09-10 e 2026-09-16
  (GPTBot 867, PerplexityBot 255, PetalBot 12, Amazonbot 5, OAI-SearchBot 1),
  em 877 caminhos distintos — e o tema de CADA um deles existe hoje.

A diferenca entre as duas perguntas e o tempo. A semeadura do espelho e um PASSO
de UM produtor (`tools/deploy-publico`), nao um invariante da publicacao: quem
publica por outro caminho — `tools/run-daily-content`, que grava noticias,
diarios e paginas de lei e escreve o proprio `published_manifest.jsonl` — deixa a
pagina no ar com a ancora `/redesocial/tema/...` no HTML e o tema inexistente ate
o proximo deploy completo. Caso medido: `public/leis/cpc-art-536/index.html`
escrito em 2026-09-12 12:26, tema (id 11165) so espelhado em 2026-09-16 — QUATRO
DIAS de 404 numa URL que a propria pagina anuncia.

Um gate de conjunto nao enxerga isso por construcao: quando ele roda, o conjunto
ja convergiu. Este aqui mede o RASTRO — o 404 que ja aconteceu — e por isso
enxerga o incidente mesmo depois de ele se curar.

O VEREDITO E POR FLUXO, NUNCA POR ESTOQUE. Reprova so o que aconteceu na janela
de fluxo (padrao: hoje), porque gate que reprova por historico fica vermelho por
dias sem que exista acao capaz de o fechar — e gate assim vira ruido que o
operador aprende a ignorar. A janela de contexto (padrao: 7 dias) entra no
relatorio para dimensionar, nunca no exit code.

O REMEDIO NAO E REMOVER A ANCORA (ordem do dono, 2026-09-10: "se tem URL, tem
conteudo"). E ligar a semeadura a PUBLICACAO, e nao a um script: uma unit .path
sobre data/editorial/published_manifest.jsonl, irma de
ops/systemd/wikijuridica-cerebro-enfileirar.path, que dispara
`generate-social-temas --aplicar` sempre que o manifesto mudar, qualquer que
seja o produtor.

Exit 0 = nenhum 404 tardio na janela de fluxo. Exit 1 = houve (com a lista).
Exit 2 = infra ausente (banco ou ledger ilegivel), que nao e veredito.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import sqlite3
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BANCO = os.path.join(RAIZ, "var", "social", "social.db")
ACESSO = os.path.join(RAIZ, "data", "ops", "access")
PREFIXO = "/redesocial/tema/"
SEGMENTOS_DE_TEMA = 2


def temas_do_banco(caminho: str) -> set[str]:
    """Pares (área, slug) espelhados, lidos em modo somente-leitura."""
    conexao = sqlite3.connect("file:" + caminho + "?mode=ro", uri=True)
    try:
        return {
            (str(area).strip(), str(slug).strip())
            for area, slug in conexao.execute("SELECT area, slug FROM temas")
        }
    finally:
        conexao.close()


def tema_do_caminho(rota: str) -> tuple[str, str] | None:
    """(área, slug) de /redesocial/tema/{área}/{slug}/..., ou None."""
    if not rota.startswith(PREFIXO):
        return None
    partes = [p for p in rota[len(PREFIXO):].strip("/").split("/") if p]
    if len(partes) < SEGMENTOS_DE_TEMA:
        return None
    return partes[0], partes[1]


def quatrocentos_e_quatro_tardios(dir_acesso: str, dia: str, temas: set[tuple[str, str]]
                                  ) -> dict[str, dict[str, int]]:
    """404 de UM dia cujo tema EXISTE hoje, por caminho e por agente.

    O filtro textual antes do json.loads não é otimização gratuita: o ledger de
    um dia passa de 10 MB e a esmagadora maioria das linhas não é 404 nem toca a
    rede social. Sem ele, o gate gastaria segundos decodificando o que vai
    descartar.
    """
    caminho = os.path.join(dir_acesso, "nginx-%s.jsonl" % dia)
    achados: dict[str, dict[str, int]] = {}
    if not os.path.isfile(caminho):
        return achados
    with open(caminho, encoding="utf-8") as arquivo:
        for linha in arquivo:
            if PREFIXO not in linha or "404" not in linha:
                continue
            try:
                registro = json.loads(linha)
            except json.JSONDecodeError:
                continue
            if registro.get("status") != 404:
                continue
            if registro.get("bot_simulation") or registro.get("warming"):
                continue
            par = tema_do_caminho(registro.get("path") or "")
            if par is None or par not in temas:
                continue
            rota = registro.get("path") or ""
            agente = registro.get("agent_key") or "(sem agent_key)"
            achados.setdefault(rota, {})
            achados[rota][agente] = achados[rota].get(agente, 0) + 1
    return achados


def dias_ate(hoje: datetime.date, quantos: int) -> list[str]:
    return [(hoje - datetime.timedelta(days=i)).isoformat() for i in range(quantos)]


def total(achados: dict[str, dict[str, int]]) -> int:
    return sum(sum(por_agente.values()) for por_agente in achados.values())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--banco", default=BANCO)
    parser.add_argument("--acesso-dir", default=ACESSO)
    parser.add_argument("--dias-fluxo", type=int, default=1,
                        help="janela que REPROVA (padrão: 1 = o dia de hoje)")
    parser.add_argument("--dias-contexto", type=int, default=7,
                        help="janela apenas relatada, nunca no exit code")
    parser.add_argument("--hoje", default="", help="data ISO a tratar como hoje (para teste)")
    parser.add_argument("--amostra", type=int, default=10)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.dias_fluxo < 1 or args.dias_contexto < args.dias_fluxo:
        print("check-social-temas-404-tardio: --dias-fluxo >= 1 e --dias-contexto >= --dias-fluxo",
              file=sys.stderr)
        return 2
    if not os.path.isfile(args.banco):
        print("check-social-temas-404-tardio: banco social ausente em %s" % args.banco, file=sys.stderr)
        return 2
    if not os.path.isdir(args.acesso_dir):
        print("check-social-temas-404-tardio: ledger de acesso ausente em %s" % args.acesso_dir,
              file=sys.stderr)
        return 2

    try:
        temas = temas_do_banco(args.banco)
    except sqlite3.Error as erro:
        print("check-social-temas-404-tardio: leitura do banco falhou: %s" % erro, file=sys.stderr)
        return 2

    hoje = datetime.date.fromisoformat(args.hoje) if args.hoje else datetime.datetime.now(
        datetime.timezone.utc).date()
    fluxo: dict[str, dict[str, int]] = {}
    contexto: dict[str, dict[str, int]] = {}
    for indice, dia in enumerate(dias_ate(hoje, args.dias_contexto)):
        try:
            achados = quatrocentos_e_quatro_tardios(args.acesso_dir, dia, temas)
        except OSError as erro:
            print("check-social-temas-404-tardio: leitura de %s falhou: %s" % (dia, erro), file=sys.stderr)
            return 2
        for rota, por_agente in achados.items():
            for agente, n in por_agente.items():
                contexto.setdefault(rota, {})
                contexto[rota][agente] = contexto[rota].get(agente, 0) + n
                if indice < args.dias_fluxo:
                    fluxo.setdefault(rota, {})
                    fluxo[rota][agente] = fluxo[rota].get(agente, 0) + n

    agentes_do_fluxo: dict[str, int] = {}
    for por_agente in fluxo.values():
        for agente, n in por_agente.items():
            agentes_do_fluxo[agente] = agentes_do_fluxo.get(agente, 0) + n

    if args.json:
        print(json.dumps({
            "schema_version": "social_temas_404_tardio_v1",
            "temas_no_espelho": len(temas),
            "dias_fluxo": args.dias_fluxo,
            "dias_contexto": args.dias_contexto,
            "respostas_404_no_fluxo": total(fluxo),
            "caminhos_no_fluxo": len(fluxo),
            "respostas_404_no_contexto": total(contexto),
            "caminhos_no_contexto": len(contexto),
            "agentes_no_fluxo": agentes_do_fluxo,
            "amostra": sorted(fluxo)[: args.amostra or len(fluxo)],
        }, ensure_ascii=False, sort_keys=True))
    else:
        print("temas no espelho                 : %d" % len(temas))
        print("404 tardio no FLUXO (%d dia(s))   : %d em %d caminho(s)"
              % (args.dias_fluxo, total(fluxo), len(fluxo)))
        print("404 tardio no CONTEXTO (%d dias)  : %d em %d caminho(s) — relatado, fora do exit"
              % (args.dias_contexto, total(contexto), len(contexto)))
        for rota in sorted(fluxo)[: args.amostra or len(fluxo)]:
            por_agente = ", ".join("%s=%d" % (a, n) for a, n in sorted(fluxo[rota].items()))
            print("  %s  (%s)" % (rota, por_agente))
        if len(fluxo) > (args.amostra or len(fluxo)):
            print("  (+%d)" % (len(fluxo) - args.amostra))

    if fluxo:
        print("\ncheck-social-temas-404-tardio: %d resposta(s) 404 hoje em tema que EXISTE no espelho."
              "\n  A pagina do acervo anunciou /redesocial/tema/... e o tema so foi semeado depois:"
              "\n  a semeadura e passo de UM produtor (deploy-publico 2.7), nao invariante da publicacao."
              "\n  Semeie agora:"
              "\n    ./tools/go-modern run ./cmd/generate-social-temas --aplicar"
              "\n  E ligue a semeadura ao manifesto (irma de ops/systemd/wikijuridica-cerebro-enfileirar.path),"
              "\n  para que QUALQUER produtor a dispare." % total(fluxo), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
