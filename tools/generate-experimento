          f"páginas no escopo={escopo['paginas_no_escopo']} de {escopo['paginas_publicadas']} publicadas")
    print(f"sal              {registro['aleatorizacao']['sal']}")
    print(f"receita          {registro['aleatorizacao']['receita']}")
    print(f"limiar seleção   {registro['aleatorizacao']['limiar_selecao']}")
    print()
    print(f"ELEGIBILIDADE    {eleg['elegiveis']} elegíveis de {eleg['avaliadas']} avaliadas")
    for motivo, quantas in eleg["recusas"].items():
        print(f"    recusa       {quantas:>6}  {motivo}")
