def carrega_universo(raiz):
    """Páginas publicadas (manifesto) casadas com o texto do estoque v2.

    O manifesto é quem sabe o PATH — medido em 2026-09-10: `public_path` está
    vazio nos 11.039 registros v2 casados, então derivar path do estoque daria
    coorte vazia sem dizer por quê.
    """
    manifesto = os.path.join(raiz, X.MANIFESTO_REL)
    if not os.path.isfile(manifesto):
        raise X.FonteAusente(f"{X.MANIFESTO_REL} não existe — é o universo de páginas publicadas")
    shards = sorted(glob.glob(os.path.join(raiz, X.SHARDS_REL, "*.jsonl")))
    if not shards:
        raise X.FonteAusente(f"{X.SHARDS_REL}/*.jsonl não existe — é a fonte do texto autoral")

    v2 = {}
    for caminho in shards:
        nome = os.path.basename(caminho)
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                registro = json.loads(linha)
                intent = registro.get("intent_id")
                if intent:
                    v2[intent] = (nome, registro)

    paginas = []
    with open(manifesto, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            if registro.get("page_status") != "published" or registro.get("index_policy") != "index":
                continue
            intent = registro.get("unique_intent_id")
            shard, texto = v2.get(intent, (None, None))
            caminho = X.normaliza_path(registro.get("path"))
            paginas.append({
                "path": caminho,
                "intent_id": intent,
                "shard": shard,
                "area": caminho.strip("/").split("/")[0] if caminho.strip("/") else "(raiz)",
                "title_manifesto": X.limpa(registro.get("title")),
                "v2": texto,
            })
    return paginas


def resume_motivo(motivo):
    """`titulo_longo:68` vira `titulo_longo`; `promessa_oab:garantia` fica inteiro.

    O censo de recusa serve para ver O QUE barra a variante. Com o número
    colado, uma causa única virava 21 linhas de uma letra de diferença e a
    leitura se perdia — mas a etiqueta do detector (promessa, encoding,
    vocabulário) é informação, não ruído, e permanece.
    """
    cabeca, _, cauda = motivo.partition(":")
    return cabeca if cauda.isdigit() else motivo


def elegibilidade(fator, paginas, detectores, ocupadas):
    """Quem pode carregar a variante, e o CENSO de quem não pode e por quê.

    A ordem é determinística (por path) para que a resolução de colisão de
    título/meta não dependa da ordem em que o disco devolveu os arquivos.
    """
    titulos_do_acervo = {p["title_manifesto"] for p in paginas if p["title_manifesto"]}
    metas_do_acervo = set()
    for pagina in paginas:
        if pagina["v2"]:
            titulos_do_acervo.add(X.limpa(pagina["v2"].get("title")))
            meta = X.limpa(pagina["v2"].get("meta_description"))
            if meta:
                metas_do_acervo.add(meta)

    recusas = collections.Counter()
    elegiveis = []
    reivindicados = set()
    for pagina in sorted(paginas, key=lambda p: p["path"]):
        if pagina["path"] in ocupadas:
            recusas["interferencia:ja_em_" + ocupadas[pagina["path"]]] += 1
            continue
        registro = pagina["v2"]
        if registro is None:
            recusas["sem_registro_v2"] += 1
            continue

        if fator == "titulo":
            atual = X.limpa(registro.get("title"))
            candidato = X.limpa(registro.get("h1"))
            if not candidato:
                recusas["h1_ausente"] += 1
                continue
            if candidato == atual:
                recusas["h1_igual_ao_title"] += 1
                continue
            # O conjunto entra INTEIRO, sem `- {atual}`: o candidato já foi
            # recusado acima se fosse igual ao próprio título, então não há
            # colisão consigo mesmo a excluir — e a subtração copiava um
            # conjunto de 11 mil títulos por página, o que fazia a passada
            # sobre o acervo inteiro custar O(n²) (lentidão em 10k é P0 neste
            # repositório, não detalhe).
            motivos = X.valida_titulo(candidato, detectores, titulos_do_acervo)
            if candidato in reivindicados:
                motivos.append("colide_com_outra_variante")
            if motivos:
                recusas[resume_motivo(motivos[0])] += 1
                continue
            reivindicados.add(candidato)
            pagina = dict(pagina, texto_atual=atual, texto_variante=candidato)

        elif fator == "meta_description":
            atual = X.limpa(registro.get("meta_description"))
            candidato = X.recorte_por_frase(registro.get("opening"), X.META_MIN, X.META_MAX)
            if not candidato:
                recusas["opening_sem_recorte_de_70_a_160"] += 1
                continue
            if candidato == atual:
                recusas["recorte_igual_a_meta_atual"] += 1
                continue
            motivos = X.valida_meta(candidato, detectores, metas_do_acervo)  # idem: sem cópia por página
            if candidato in reivindicados:
                motivos.append("colide_com_outra_variante")
            if motivos:
                recusas[resume_motivo(motivos[0])] += 1
                continue
            reivindicados.add(candidato)
            pagina = dict(pagina, texto_atual=atual, texto_variante=candidato)

        elif fator == "ordem_faq":
            faq = registro.get("faq") or []
            if len(faq) < 2:
                recusas[f"faq_com_{len(faq)}_perguntas"] += 1
                continue
            pagina = dict(pagina, texto_atual=" | ".join(X.limpa(q.get("q")) for q in faq),
                          texto_variante=None, faq_n=len(faq))

        elif fator == "resumo_tres_linhas":
            # Sem texto: a máquina não escreve resumo. A página é elegível para
            # ENTRAR na fila de prosa, e o registro conta quantas esperam autor.
            pagina = dict(pagina, texto_atual=None, texto_variante=None, prosa_pendente=True)

        else:
            raise ValueError(f"fator desconhecido: {fator}")

        elegiveis.append(pagina)
    return elegiveis, recusas


def sorteia(elegiveis, sal, bracos, limite):
    """Coorte e braços, tudo por sha256 do path — reprodutível por terceiros.

    O corte é pelo MENOR `u_selecao`: equivale a um limiar, é determinístico e
    não privilegia área, tamanho nem ordem de leitura do disco. O limiar
    efetivo vai gravado, então qualquer pessoa confere a pertinência de uma
    página só com o hash.
    """
    com_u = []
    for pagina in elegiveis:
        u = X.u_de(sal, "selecao", pagina["path"])
        com_u.append((u, pagina))
    com_u.sort(key=lambda par: (par[0], par[1]["path"]))
    escolhidas = com_u[:limite]
    limiar = escolhidas[-1][0] if escolhidas else 0.0

    coorte = []
    for u_sel, pagina in escolhidas:
        braco, u_braco = X.atribui_braco(sal, pagina["path"], bracos)
        item = {
            "path": pagina["path"],
            "intent_id": pagina["intent_id"],
            "shard": pagina["shard"],
            "area": pagina["area"],
            "braco": braco,
            "u_selecao": round(u_sel, 12),
            "u_braco": round(u_braco, 12),
        }
        for chave in ("texto_atual", "texto_variante", "faq_n", "prosa_pendente"):
            if chave in pagina:
                item[chave] = pagina[chave]
        if pagina.get("faq_n") and braco != bracos[0]:
            item["permutacao"] = X.permutacao_faq(sal, pagina["path"], pagina["faq_n"])
        if braco == bracos[0]:
            # Controle não recebe variante nenhuma: o texto atual permanece, e
            # nenhuma prosa é esperada dele — marcar o controle como pendente
            # inflaria a fila de escrita do autor com páginas que não mudam.
            item["texto_variante"] = None
            item.pop("permutacao", None)
            item.pop("prosa_pendente", None)
        coorte.append(item)
    coorte.sort(key=lambda item: item["path"])
    return coorte, limiar


def monta_registro(args, raiz, universo, elegiveis, recusas, coorte, limiar, teto, bracos, agora):
    espec = FATORES[args.fator]
    variante = [item for item in coorte if item["braco"] == bracos[1]]
    pendencias = {}
    estado = espec["estado"]
    if args.fator == "resumo_tres_linhas":
        pendencias["paginas_sem_prosa"] = len(variante)
    if args.fator in ("titulo", "meta_description"):
        pendencias["paginas_aguardando_ok_do_autor"] = len(variante)

    desfechos = []
    for nome, definicao in X.DESFECHOS.items():
        desfechos.append({
            "nome": nome,
            "papel": "primario" if nome == args.desfecho_primario else "secundario",
            "fonte": definicao["fonte"],
            "unidade": definicao["unidade"],
            "modelo": definicao["modelo"],
            "chave": definicao["chave"],
            "ressalvas": definicao["ressalvas"],
        })

    return {
        "schema_version": X.SCHEMA_VERSION,
        "tipo": "experimento",
        "experimento_id": args.id,
        "date": agora[:10],
        "gerado_em": agora,
        "estado": estado,
        "fator": args.fator,
        "campo_alterado": espec["campo"],
        "escopo": {
            "universo": X.MANIFESTO_REL,
            "area": args.area,
            "paginas_publicadas": len(universo),
            "paginas_no_escopo": sum(1 for p in universo if args.area in (None, p["area"])),
        },
        "aleatorizacao": {
            "unidade": "pagina",
            "motivo": ("acervo estático atrás de CDN com s-maxage=604800: variar por "
                       "visitante exigiria Vary/cookie (mata o cache) ou decisão por "
                       "User-Agent (cloaking)"),
            "sal": args.sal,
            "dominio": X.DOMINIO,
            "receita": X.RECEITA_HASH,
            "limiar_selecao": round(limiar, 12),
            "verificacao": ("página pertence à coorte se é elegível e "
                            "u_de(sal,'selecao',path) <= limiar_selecao"),
        },
        "teto": teto,
        "bracos": [
            {"nome": bracos[0], "transformacao": "nenhuma (controle)",
             "paginas": sum(1 for item in coorte if item["braco"] == bracos[0])},
            {"nome": bracos[1], "transformacao": espec["transformacao"],
             "origem_do_texto": espec["origem_do_texto"],
             "paginas": len(variante)},
        ],
        "elegibilidade": {
            "avaliadas": sum(1 for p in universo if args.area in (None, p["area"])),
            "elegiveis": len(elegiveis),
            "recusas": dict(sorted(recusas.items(), key=lambda par: (-par[1], par[0]))),
        },
        "contrato_de_texto": {
            "title_caracteres": [X.TITULO_MIN, X.TITULO_MAX],
            "meta_description_caracteres": [X.META_MIN, X.META_MAX],
            "unicidade": "title e meta description únicos no acervo",
            "etica": "promessa de resultado (Provimento OAB 205/2021) reprovada pelo "
                     "detector de tools/generate-v2-publication-severity",
        },
        "janela_dias": args.janela_dias,
        "desfecho_primario": args.desfecho_primario,
        "desfechos": desfechos,
        "regra_de_veredito": {
            "fixada_antes_da_medicao": True,
            "p_variante_melhor_para_adotar": args.p_adotar,
            "p_variante_melhor_para_descartar": args.p_descartar,
            "piso_eventos_por_braco": args.piso_eventos,
            "piso_page_days_por_braco": args.piso_page_days,
            "exige_ic95_do_quociente_excluir_1": True,
            "abaixo_do_piso": "sem_decisao, com o N que falta declarado",
            "so_o_desfecho_primario_decide": True,
        },
        "aplicado_em": None,
        "bloqueios": [espec["bloqueio"]] if espec["bloqueio"] else [],
        "pendencias": pendencias,
        "comando_de_aplicacao": comando_de_aplicacao(args.id, args.fator),
        "coorte": coorte,
    }


def comando_de_aplicacao(experimento_id, fator):
    """O caminho SANCIONADO de escrita no estoque v2 — nomeado, não executado."""
    if fator == "resumo_tres_linhas":
        return ("BLOQUEADO: não há campo `resumo` no estoque v2 nem bloco de resumo em "
                "internal/render; a aplicação depende de mudança em Go, fora desta frente")
    return (f"tools/generate-v2-experimento-aplicar-{dt.date.today():%Y%m%d} "
            f"--experimento {experimento_id} --aplicar  "
            "# gerador datado: canonical_stock_write_lease + lock exclusivo + CAS por "
            "sha256 da linha viva em data/editorial/v2_pages/<shard>.jsonl; depois "
            "./tools/deploy-publico SEM --ressemear (muda texto servido: a re-datação é verdadeira)")


