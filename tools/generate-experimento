    teto = registro["teto"]
    print(f"TETO GLOBAL      {teto['fracao']:.0%} do acervo = {teto['paginas']} páginas")
    print(f"    ocupado      {teto['ocupado_por_ativos']} por {teto['experimentos_ativos']} experimento(s) ativo(s)")
    print(f"    disponível   {teto['disponivel']}")
    print(f"    coorte       {len(registro['coorte'])}")
