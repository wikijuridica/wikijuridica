    print(f"APLICAÇÃO        {registro['comando_de_aplicacao']}")
    print()
    print(f"origem do texto  {espec['origem_do_texto']}")


def muda_estado(args, registros, agora):
    """Acrescenta uma linha `tipo=estado` — a transição do experimento.

    É a peça que fecha o ciclo: sem ela `aplicado_em` fica nulo para sempre
    (toda medição sairia como A/A) e as páginas de um experimento encerrado
    seguiriam ocupando o teto de 5% do acervo, impedindo o próximo.
    """
    eid = args.marcar_aplicado or args.encerrar
    vivos = X.dobra_experimentos(registros)
    if eid not in vivos:
        print(f"erro: experimento {eid} não está no ledger. Ids: "
              + ", ".join(sorted(vivos)), file=sys.stderr)
        return 3, None
    atual = vivos[eid]
    linha = {"schema_version": X.SCHEMA_VERSION, "tipo": "estado",
             "experimento_id": eid, "date": agora[:10], "gerado_em": agora,
             "estado_anterior": atual.get("estado")}
    if args.marcar_aplicado:
        aplicado_em = args.aplicado_em or agora[:10]
        try:
            dt.date.fromisoformat(aplicado_em)
        except ValueError:
            print("erro: --aplicado-em tem de ser uma data ISO (AAAA-MM-DD)", file=sys.stderr)
            return 3, None
        if atual.get("pendencias", {}).get("paginas_sem_prosa"):
            print(f"erro: {eid} ainda tem "
                  f"{atual['pendencias']['paginas_sem_prosa']} páginas sem prosa humana — "
                  "não se marca como aplicado o que não foi escrito (DEC-017)", file=sys.stderr)
            return 3, None
        linha["estado"] = "aplicado"
        linha["aplicado_em"] = aplicado_em
        linha["motivo"] = ("variante escrita no estoque v2 pelo gerador datado com CAS e "
                           "publicada; a janela de medição começa nesta data")
    else:
        if args.estado not in X.ESTADOS_TERMINAIS:
            print(f"erro: --encerrar exige --estado entre {', '.join(X.ESTADOS_TERMINAIS)}",
                  file=sys.stderr)
            return 3, None
        linha["estado"] = args.estado
        linha["motivo"] = args.motivo or "encerrado pelo operador"
        linha["paginas_liberadas"] = len(atual.get("coorte") or [])
    return 0, linha


def principal(argv=None):
    parser = argparse.ArgumentParser(
        description="cria um experimento A/B cluster-randomizado por página (ensaio por padrão)")
    parser.add_argument("--fator", default=None, choices=sorted(FATORES),
                        help="o que varia entre os braços (obrigatório ao criar)")
    parser.add_argument("--marcar-aplicado", default=None, metavar="ID",
                        help="registra que a variante foi ao ar; a janela conta a partir daí")
    parser.add_argument("--aplicado-em", default=None, metavar="AAAA-MM-DD",
                        help="data da publicação da variante (padrão: hoje)")
    parser.add_argument("--encerrar", default=None, metavar="ID",
                        help="encerra o experimento e LIBERA as páginas dele do teto de 5%%")
    parser.add_argument("--estado", default=None, choices=sorted(X.ESTADOS_TERMINAIS),
                        help="estado terminal de --encerrar")
    parser.add_argument("--motivo", default=None, help="motivo da transição, gravado na linha")
    parser.add_argument("--area", default=None,
                        help="restringe ao primeiro segmento do path (ex.: familia)")
    parser.add_argument("--id", default=None, help="identificador do experimento")
    parser.add_argument("--sal", default=None,
                        help="sal do sorteio (padrão: o próprio id — determinístico e gravado)")
    parser.add_argument("--paginas", type=int, default=None,
                        help="teto de páginas desta coorte (o teto global de 5%% continua valendo)")
    parser.add_argument("--fracao", type=float, default=None,
                        help="fração das páginas elegíveis a sortear (0 a 1)")
    parser.add_argument("--janela-dias", type=int, default=X.JANELA_DIAS_PADRAO)
    parser.add_argument("--desfecho-primario", default=X.DESFECHO_PRIMARIO_PADRAO,
                        choices=sorted(X.DESFECHOS))
    parser.add_argument("--p-adotar", type=float, default=0.95)
    parser.add_argument("--p-descartar", type=float, default=0.05)
    parser.add_argument("--piso-eventos", type=int, default=30,
                        help="eventos mínimos por braço no desfecho primário para haver veredito")
    parser.add_argument("--piso-page-days", type=int, default=100,
                        help="páginas×dias mínimos por braço para haver veredito")
    parser.add_argument("--amostra", type=int, default=8, help="linhas da coorte a imprimir")
    parser.add_argument("--json", action="store_true", help="imprime o registro em JSON")
    parser.add_argument("--aplicar", action="store_true",
                        help="grava no ledger; sem esta bandeira nada toca o disco")
    parser.add_argument("--raiz", default=X.raiz_do_repo(__file__))
    args = parser.parse_args(argv)

    agora = X.agora_utc()

    if args.marcar_aplicado or args.encerrar:
        if args.marcar_aplicado and args.encerrar:
            print("erro: --marcar-aplicado e --encerrar são exclusivos", file=sys.stderr)
            return 3
        try:
            registros = X.le_ledger(args.raiz)
        except ValueError as erro:
            print(f"ledger ilegível: {erro}", file=sys.stderr)
            return 2
        codigo, linha = muda_estado(args, registros, agora)
        if codigo:
            return codigo
        print(json.dumps(linha, ensure_ascii=False, sort_keys=True, indent=2)
              if args.json else
              f"transição       {linha['experimento_id']}: "
              f"{linha['estado_anterior']} -> {linha['estado']}"
              + (f"  (aplicado_em {linha['aplicado_em']})" if linha.get("aplicado_em") else "")
              + (f"  libera {linha['paginas_liberadas']} páginas do teto"
                 if linha.get("paginas_liberadas") else ""))
        aviso = sys.stderr if args.json else sys.stdout
        if args.aplicar:
            caminho = X.acrescenta_ao_ledger(args.raiz, linha)
            print(f"\nGRAVADO em {os.path.relpath(caminho, args.raiz)}", file=aviso)
        else:
            print("\nENSAIO — nada foi escrito. Use --aplicar para registrar a transição.",
                  file=aviso)
        return 0

    if not args.fator:
        print("erro: informe --fator ao criar um experimento (ou --marcar-aplicado/--encerrar)",
              file=sys.stderr)
        return 3
    if not args.id:
        sufixo = args.area or "acervo"
        args.id = f"exp-{agora[:10].replace('-', '')}-{args.fator.replace('_', '-')}-{sufixo}"
    if not args.sal:
        args.sal = args.id
    if not 0 <= args.p_descartar < args.p_adotar <= 1:
        print("erro: exija 0 <= --p-descartar < --p-adotar <= 1", file=sys.stderr)
        return 3

    try:
        registros = X.le_ledger(args.raiz)
        universo = carrega_universo(args.raiz)
        detectores = X.carrega_detectores(args.raiz)
    except X.FonteAusente as erro:
        print(f"fonte ausente: {erro}", file=sys.stderr)
        return 2
    except ValueError as erro:
        # Linha corrompida no ledger é erro de fonte, não traceback: um
        # experimento invisível liberaria as páginas dele para outro.
        print(f"ledger ilegível: {erro}", file=sys.stderr)
        return 2

    if any(r.get("tipo") == "experimento" and r.get("experimento_id") == args.id for r in registros):
        print(f"erro: já existe experimento com id {args.id} no ledger — escolha outro --id "
              "(o ledger é append-only e nunca se reescreve)", file=sys.stderr)
        return 4

    ativos = X.experimentos_ativos(registros)
    ocupadas = X.paginas_ocupadas(registros)
    teto_paginas = int(len(universo) * X.TETO_FRACAO_ACERVO)
    disponivel = max(0, teto_paginas - len(ocupadas))
    teto = {"fracao": X.TETO_FRACAO_ACERVO, "paginas": teto_paginas,
            "acervo": len(universo), "ocupado_por_ativos": len(ocupadas),
            "experimentos_ativos": len(ativos), "disponivel": disponivel}

    no_escopo = [p for p in universo if args.area in (None, p["area"])]
    if not no_escopo:
        areas = sorted({p["area"] for p in universo})
        print(f"erro: nenhuma página publicada na área {args.area!r}. Áreas: {', '.join(areas)}",
              file=sys.stderr)
        return 3

    elegiveis, recusas = elegibilidade(args.fator, no_escopo, detectores, ocupadas)
    if not elegiveis:
        print(f"erro: nenhuma página elegível para o fator {args.fator} no escopo. "
              f"Censo de recusa: {dict(recusas)}", file=sys.stderr)
        return 3

    limite = min(len(elegiveis), disponivel)
    if args.fracao is not None:
        if not 0 < args.fracao <= 1:
            print("erro: --fracao tem de estar em (0, 1]", file=sys.stderr)
            return 3
        limite = min(limite, int(round(args.fracao * len(elegiveis))))
    if args.paginas is not None:
        limite = min(limite, max(0, args.paginas))
    if limite <= 0:
        print(f"erro: teto global esgotado — {len(ocupadas)} de {teto_paginas} páginas já estão "
              f"em {len(ativos)} experimento(s) ativo(s). Encerre um antes de abrir outro.",
              file=sys.stderr)
        return 3

    espec = FATORES[args.fator]
    bracos = ["controle", espec["braco_variante"]]
    coorte, limiar = sorteia(elegiveis, args.sal, bracos, limite)
    registro = monta_registro(args, args.raiz, universo, elegiveis, recusas,
                              coorte, limiar, teto, bracos, agora)

    if args.json:
        print(json.dumps(registro, ensure_ascii=False, sort_keys=True, indent=2))
    else:
        imprime_ensaio(registro, args.amostra)

    # Com --json o stdout é JSON e nada mais: o aviso de estado vai para o
    # stderr, senão `| jq` e `| python -m json.tool` quebram com "Extra data".
    aviso = sys.stderr if args.json else sys.stdout
    if args.aplicar:
        caminho = X.acrescenta_ao_ledger(args.raiz, registro)
        print(f"\nGRAVADO em {os.path.relpath(caminho, args.raiz)} — {len(coorte)} páginas, "
              f"estado {registro['estado']}.", file=aviso)
    else:
        print("\nENSAIO — nada foi escrito. Use --aplicar para registrar o experimento.",
              file=aviso)
    return 0


if __name__ == "__main__":
    sys.exit(principal())
