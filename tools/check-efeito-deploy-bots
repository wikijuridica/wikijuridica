#!/usr/bin/env python3
"""check-efeito-deploy-bots — a correção fez o bot voltar, ou não fez?

READ-ONLY. Compara o comportamento dos bots DEPOIS de um marco de deploy contra a
janela equivalente ANTES dele, e responde à única pergunta que interessa nesta
frente: *isso está fazendo efeito?*

A RÉGUA É RETORNO, NÃO COBERTURA — e a distinção não é semântica. Cobertura
acumulada só cresce, então ela NUNCA acusa abandono: foi por isso que ninguém viu
o GPTBot cair para 1 requisição/dia em 08/08 nem o `meta-externalagent` sumir em
23/08. Um agente que varre uma vez e some não gera citação recorrente, não
acompanha mudança de lei e não volta quando a página é corrigida. O que se mede
aqui é **frequência de retorno e descoberta nova**.

AS QUATRO MÉTRICAS, e o que cada uma responde:

  req/dia            ele continua vindo?
  urls novas/dia     ele está DESCOBRINDO, ou repassando o que já conhece?
  dias sem visita    quanto tempo desde a última vez?
  cliques de volta   alguma citação trouxe humano? (é o produto, não o meio)

HONESTIDADE SOBRE A JANELA, e isto é o mais importante deste instrumento: efeito
de crawler não aparece em horas. Se a janela depois do marco for curta, este check
diz **"cedo demais para concluir"** e NÃO emite veredito. Fabricar tendência com
dois dias de dado seria exatamente o número que parece medição e não é — e esta
sessão já pagou por isso três vezes, com um ledger cumulativo somado linha a linha.

POR QUE ELE NÃO REPROVA POR EFEITO AUSENTE. Sair != 0 porque um bot não voltou
transformaria uma medição em alarme falso: o Googlebot pode levar semanas para
reagir, e o próprio Google documenta que a recuperação de taxa é gradual. Este
check reprova por **defeito de instrumento** — marco ausente, série parada,
janela impossível. O veredito sobre o efeito é texto, para ser lido e agir.

Uso:
    tools/check-efeito-deploy-bots
    tools/check-efeito-deploy-bots --janela 7
    tools/check-efeito-deploy-bots --json
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import date, timedelta

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
MARCOS = os.path.join(RAIZ, "data", "ops", "deploy_marcos.jsonl")
SERIE = os.path.join(RAIZ, "data", "ops", "bot_return_daily.jsonl")

# Abaixo disto não se conclui nada. Três dias é o mínimo para distinguir
# comportamento de ruído de um único dia — e mesmo três é pouco para bot de
# busca, o que o relatório diz por extenso em vez de esconder.
DIAS_MINIMOS = 3

# Só se avisa o dono depois de UMA JANELA INTEIRA sem reação, e a régua é alta de
# propósito. Crawler não reage em horas, e o Google documenta que a recuperação de
# taxa é gradual — avisar cedo produziria o ruído que já afogou sete famílias de
# alerta crítico neste repositório. A chave NÃO leva data: seis dias da mesma
# falha viraram sete alertas distintos que nunca escalaram, e essa lição custou
# uma semana de fábrica parada.
DIAS_PARA_AVISAR = 7
CHAVE_ALERTA = "efeito-deploy-bots"
NOTIFICADOR = os.path.join(RAIZ, "tools", "notify-owner")


def avisa(titulo: str, mensagem: str, severidade: str = "media") -> None:
    """Entrega pelo canal único do repo, sem inventar um segundo."""
    if not os.path.isfile(NOTIFICADOR):
        return
    try:
        subprocess.run(
            [NOTIFICADOR, "--chave", CHAVE_ALERTA, "--severidade", severidade,
             "--titulo", titulo, "--mensagem", mensagem,
             "--origem", "check-efeito-deploy-bots",
             "--evidencia", "tools/check-efeito-deploy-bots --janela 7",
             "--cooldown", "82800"],
            capture_output=True, timeout=60, check=False)
    except Exception:
        # Falha no aviso não pode derrubar a medição: o número medido continua
        # valendo, e engolir o veredito por causa do mensageiro seria pior.
        pass


def ultimo_marco() -> dict | None:
    if not os.path.isfile(MARCOS):
        return None
    ultimo = None
    for linha in open(MARCOS, encoding="utf-8"):
        linha = linha.strip()
        if linha:
            ultimo = json.loads(linha)
    return ultimo


def serie() -> list[dict]:
    if not os.path.isfile(SERIE):
        return []
    return [json.loads(l) for l in open(SERIE, encoding="utf-8") if l.strip()]


def media(valores: list[float]) -> float:
    return sum(valores) / len(valores) if valores else 0.0


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--janela", type=int, default=7,
                   help="dias de cada lado do marco (default 7)")
    p.add_argument("--json", action="store_true")
    args = p.parse_args()

    marco = ultimo_marco()
    if marco is None:
        print("check-efeito-deploy-bots: FAIL")
        print(f"  - nenhum marco em {os.path.relpath(MARCOS, RAIZ)}.")
        print("    Sem marco nao ha eixo de comparacao: grave um no proximo deploy com")
        print("    tools/generate-deploy-marco --mudou '<o que foi ao ar>'")
        return 1

    linhas = serie()
    if not linhas:
        print("check-efeito-deploy-bots: FAIL")
        print(f"  - serie vazia ou ausente: {os.path.relpath(SERIE, RAIZ)}")
        print("    O produtor e tools/generate-bot-return-series (timer wikijuridica-bot-telemetry).")
        return 1

    dia_marco = date.fromisoformat(marco["gravado_em"][:10])
    hoje = max(date.fromisoformat(r["date"]) for r in linhas)
    dias_depois = (hoje - dia_marco).days

    ini_antes = dia_marco - timedelta(days=args.janela)
    antes: dict[str, list[dict]] = {}
    depois: dict[str, list[dict]] = {}
    for r in linhas:
        d = date.fromisoformat(r["date"])
        chave = r["agent_key"]
        if ini_antes <= d < dia_marco:
            antes.setdefault(chave, []).append(r)
        elif d >= dia_marco:
            depois.setdefault(chave, []).append(r)

    print(f"marco  : {marco.get('rotulo')} · commit {marco.get('commit','?')[:12]} · "
          f"{marco['gravado_em'][:16]}")
    for item in marco.get("mudou", []):
        print(f"         - {item}")
    print(f"janela : {args.janela} dia(s) antes ({ini_antes} a {dia_marco}) × "
          f"{dias_depois} dia(s) depois")

    if dias_depois < DIAS_MINIMOS:
        print()
        print(f"VEREDITO: CEDO DEMAIS — {dias_depois} dia(s) desde o deploy, minimo {DIAS_MINIMOS}.")
        print("  Nao emito tendencia com esta janela, e isso e deliberado: crawler nao")
        print("  reage em horas, e numero fabricado com dois dias de dado e pior que")
        print("  numero nenhum. Rode de novo depois — a serie continua sendo gravada")
        print("  pelo timer, entao o dado destes dias nao se perde.")
        print()
        print("check-efeito-deploy-bots: OK (instrumento sadio; efeito ainda nao mensuravel)")
        return 0

    melhoraram, pioraram, estaveis, sumidos = [], [], [], []
    for chave in sorted(set(antes) | set(depois)):
        ra = media([r.get("requisicoes", 0) for r in antes.get(chave, [])])
        rd = media([r.get("requisicoes", 0) for r in depois.get(chave, [])])
        na = media([r.get("urls_novas_no_dia", 0) for r in antes.get(chave, [])])
        nd = media([r.get("urls_novas_no_dia", 0) for r in depois.get(chave, [])])
        valioso = any(r.get("valioso") for r in
                      depois.get(chave, []) + antes.get(chave, []))
        item = {"agente": chave, "valioso": valioso,
                "req_antes": round(ra, 1), "req_depois": round(rd, 1),
                "novas_antes": round(na, 1), "novas_depois": round(nd, 1)}
        if rd == 0 and ra > 0:
            sumidos.append(item)
        elif rd > ra * 1.2 or nd > na * 1.2:
            melhoraram.append(item)
        elif rd < ra * 0.8:
            pioraram.append(item)
        else:
            estaveis.append(item)

    if args.json:
        print(json.dumps({"marco": marco.get("rotulo"), "dias_depois": dias_depois,
                          "melhoraram": melhoraram, "pioraram": pioraram,
                          "estaveis": estaveis, "sumidos": sumidos},
                         ensure_ascii=False, indent=1))
        return 0

    def mostra(titulo: str, itens: list[dict]) -> None:
        if not itens:
            return
        print(f"\n{titulo} ({len(itens)}):")
        for i in sorted(itens, key=lambda x: -x["req_depois"])[:10]:
            marca = "★" if i["valioso"] else " "
            print(f"  {marca} {i['agente']:26s} req/dia {i['req_antes']:7.1f} → "
                  f"{i['req_depois']:7.1f} | urls novas/dia {i['novas_antes']:6.1f} → "
                  f"{i['novas_depois']:6.1f}")

    mostra("VOLTANDO MAIS (req ou descoberta acima de +20%)", melhoraram)
    mostra("VOLTANDO MENOS (req abaixo de −20%)", pioraram)
    mostra("ESTÁVEIS", estaveis)
    mostra("SUMIRAM depois do deploy", sumidos)

    valiosos_melhor = [i for i in melhoraram if i["valioso"]]
    valiosos_pior = [i for i in pioraram + sumidos if i["valioso"]]
    print(f"\nVEREDITO ({dias_depois} dia(s) de janela):")
    print(f"  bots valiosos voltando mais : {len(valiosos_melhor)}")
    print(f"  bots valiosos voltando menos: {len(valiosos_pior)}")
    if valiosos_pior:
        print("  ONDE MELHORAR — estes nao reagiram, e cada um pede investigacao propria:")
        for i in valiosos_pior[:5]:
            print(f"    {i['agente']}: {i['req_antes']:.1f} → {i['req_depois']:.1f} req/dia")
    if not valiosos_melhor and not valiosos_pior:
        print("  Nenhum bot valioso mudou de patamar. Se isso persistir por duas janelas,")
        print("  a hipotese do plano — que os impedimentos tecnicos eram o gargalo — nao")
        print("  se sustenta, e o proximo passo deixa de ser transporte e passa a ser")
        print("  frescor e motivo de retorno (Fase 7 do plano).")

    # O AVISO SÓ SAI COM JANELA INTEIRA E SEM REAÇÃO NENHUMA. Enquanto houver
    # qualquer bot valioso voltando mais, a correção está fazendo algo e o canal
    # fica quieto — porque alerta que dispara sobre resultado parcial é ruído, e
    # ruído foi o que escondeu os alertas críticos de verdade nesta máquina.
    if dias_depois >= DIAS_PARA_AVISAR and not valiosos_melhor:
        avisa(
            "As correcoes de transporte nao trouxeram bot valioso de volta",
            f"{dias_depois} dias apos o deploy '{marco.get('rotulo')}': zero bots valiosos "
            f"voltando mais, {len(valiosos_pior)} voltando menos. A hipotese de que o "
            "gargalo era transporte (revalidacao, cache, negociacao) nao se sustenta "
            "sozinha — o proximo eixo do plano e FRESCOR e motivo de retorno: lastmod que "
            "se move quando a pagina muda, feed com conteudo, canal incremental anunciado "
            "onde o agente ja olha.",
            severidade="alta")
    elif dias_depois >= DIAS_PARA_AVISAR and valiosos_melhor:
        # Resolver a chave quando o efeito aparece é o que fecha o laço: alerta
        # que nunca é resolvido vira as 25 chaves abertas que este repositório
        # acumulou sem ninguém agir.
        try:
            subprocess.run(
                [NOTIFICADOR, "--chave", CHAVE_ALERTA, "--resolvido",
                 "--titulo", "Bot valioso voltou depois das correcoes",
                 "--mensagem", f"{len(valiosos_melhor)} bot(s) valioso(s) com retorno acima "
                               f"de +20% em {dias_depois} dias apos o deploy."],
                capture_output=True, timeout=60, check=False)
        except Exception:
            pass

    print("\ncheck-efeito-deploy-bots: OK (instrumento sadio)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
