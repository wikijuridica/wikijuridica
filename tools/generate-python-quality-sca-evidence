#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
cd "$ROOT"

CHECKED_AT="$(date -u +%F)"
if [[ "${1:-}" == --checked-at=* ]]; then
	CHECKED_AT="${1#--checked-at=}"
	shift
elif [[ "${1:-}" == "--checked-at" ]]; then
	CHECKED_AT="$2"
	shift 2
fi

OUT="data/ops/python_quality_sca_evidence.jsonl"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-python-quality-sca.txt" "$ROOT/tools/python_quality_sca_audit.py" 2>/dev/null | sha256sum | awk '{print $1}')"
printf 'generate-python-quality-sca-evidence: artifact_claim path=%s producer=tools/generate-python-quality-sca-evidence input_fingerprint=sha256:%s output_fingerprint_expected=updated_or_stable:%s lock_scope=artifact:%s budget_ms=300000 stop_condition=python_quality_sca_evidence_ready\n' \
	"$OUT" "$REQ_HASH" "$OUT" "$OUT" >&2

exec "$ROOT/tools/python-quality-sca-env" python "$ROOT/tools/python_quality_sca_audit.py" --root "$ROOT" --checked-at "$CHECKED_AT" --output "$OUT" "$@"
