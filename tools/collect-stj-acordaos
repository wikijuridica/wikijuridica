#!/usr/bin/env bash
# tools/collect-stj-acordaos — ESCREVE (não é read-only).
#
# Aciona o coletor de acórdãos do STJ pelo canal de dados abertos do próprio
# tribunal. A prosa completa — por que este canal e não o STF, o TST ou o SCON,
# o que ele traz e o que ele não traz — está no cabeçalho de
# internal/stjacordaos/fonte.go e de cmd/collect-stj-acordaos/main.go.
#
# ★ O QUE ELE RESOLVE, medido em 2026-09-08 antes desta ferramenta: o
# repositório coletava DJEN, DataJud, informativo do STF, precedentes
# qualificados do STJ, normas federais, notícias oficiais e diários municipais,
# e NENHUMA ementa de acórdão. Portal jurídico sem jurisprudência em casa
# depende de terceiro para o insumo que mais o define.
#
# ★ RITMO DECLARADO CONTRA A FONTE OFICIAL. O robots.txt de
# dadosabertos.web.stj.jus.br declara Crawl-Delay 10 e proíbe /api/, /revision/,
# /dataset/rate/ e /dataset/*/history (medido 2026-09-08, 200, 123 bytes). O
# coletor lê o robots a cada execução, aborta se ele passar a proibir /dataset/,
# nunca vai mais rápido que 1 requisição por 10 s e manda ETag e
# If-Modified-Since — o mês que não mudou custa um 304 em vez de 360 KB.
#
# ★ IDENTIDADE DE SAÍDA. O STJ recebe
#   Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/; coleta-oficial)
# vinda de internal/wikijuridicabot, nunca de string escrita à mão.
#
# ★ ENSAIO É O PADRÃO. Sem --aplicar o comando lê a fonte e não escreve nada.
#
#   ./tools/collect-stj-acordaos                                        # ensaio dos 10 datasets
#   ./tools/collect-stj-acordaos --dataset espelhos-de-acordaos-primeira-turma --desde 2025-07-01
#   ./tools/collect-stj-acordaos --aplicar --max-registros 200 --timings
#
# ★ ONDE O DADO POUSA. data/corpus/jurisprudencia/stj-espelhos/: os
# registros-AAAA-MM.jsonl ficam fora do git (dado bruto que cresce sem fim);
# manifest.jsonl e cursor.json entram, porque são o que prova o que foi
# coletado, quando e com que hash.
#
# ★ POR QUE A EXECUÇÃO É LIMITADA E RETOMÁVEL. Com Crawl-Delay 10, cada arquivo
# mensal custa ~10 s: os dez datasets × ~50 meses custariam mais de 5.000 s, e
# `run-go-cmd-cached` recusa comando pesado acima de 1.800 s — corretamente, e a
# resposta certa não é aumentar timeout (o contrato trata isso como mascaramento
# de performance). Cada disparo lê no máximo `--max-recursos` arquivos e grava o
# cursor a cada lote; o disparo seguinte começa onde este parou.
#
# ★ O ENVELOPE. O piso de throughput é conservador de propósito: com
# Crawl-Delay 10 o gargalo é a cortesia com a fonte, não a CPU. Um arquivo
# mensal da Primeira Turma tem 123 acórdãos e 360 KB, então uma requisição a
# cada 10 s já dá ~12 registros/s de média — o contrato declara 5.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-collect:stj-acordaos:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-1800000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-120000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=5}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_cursor_written}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/corpus/jurisprudencia/stj-espelhos/manifest.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/collect-stj-acordaos}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/corpus/jurisprudencia/stj-espelhos/manifest.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-1800}"
# O teto de execução do run-go-cmd-cached é 300 s por padrão, e 300 s não cobrem
# nem 30 arquivos mensais a 10 s cada. Elevar aqui NÃO é mascarar performance: o
# relógio é o Crawl-Delay que o STJ declara no próprio robots.txt, não lentidão
# nossa — o trabalho de CPU por arquivo é de milissegundos (24,1 s de wall para
# 1,49 MB e 408 acórdãos, medido em 2026-09-08, dos quais ~20 s foram espera
# obrigatória). O que mantém o custo previsível é `--max-recursos`, que fecha a
# execução por número de arquivos; o cursor leva o disparo seguinte adiante.
export WIKI_GO_CMD_TIMEOUT_SECONDS="${WIKI_GO_CMD_TIMEOUT_SECONDS:-1500}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/collect-stj-acordaos --timings "$@"
