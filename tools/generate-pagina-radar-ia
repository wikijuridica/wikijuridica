#!/usr/bin/env python3
"""Cria e ATUALIZA a página pública /radar-ia/ — o que os assistentes de IA verificados
leem neste portal, para humanos.

POR QUE (ordem do dono, 2026-09-08): "plataforma viva, que se comunica com humanos e com
bots de IA valiosos". O dado nasce em public/datasets/radar-ia.json (tools/generate-radar-ia,
ledger do nginx com identidade por faixa publicada, sem IP). Esta página é a leitura humana
do mesmo dado: quem lê, quanto, que áreas e que páginas — nenhum portal jurídico brasileiro
publica isso.

REGRAS (as mesmas de tools/generate-pagina-bot-20260905, com uma diferença):
- content/pages.json é dado editorial: cópia do anterior preservada em .agents/runtime/,
  escrita atômica, e este gerador toca SÓ a entrada /radar-ia/.
- Diferença: a página é VIVA. Se já existe, o corpo é regravado quando o dado mudou;
  publication_date fica a da criação e content_revised_at/reviewed_at recebem a data da
  última mudança real do dado (é re-datação verdadeira: o texto mudou).
- Números só do JSON gerado; nenhum escrito à mão.

    tools/generate-pagina-radar-ia --seco
    tools/generate-pagina-radar-ia
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import pathlib
import shutil
import sys
import tempfile

RAIZ = pathlib.Path(__file__).resolve().parent.parent
PAGES = RAIZ / "content" / "pages.json"
RADAR = RAIZ / "public" / "datasets" / "radar-ia.json"
GUARDA = RAIZ / ".agents" / "runtime" / "pages-json-antes"
CAMINHO = "/radar-ia/"
HOJE = datetime.date.today().isoformat()

NOMES = {
    "perplexitybot": "PerplexityBot (Perplexity)", "oai-searchbot": "OAI-SearchBot (ChatGPT Search)",
    "chatgpt-user": "ChatGPT-User (pedidos de usuários do ChatGPT)", "gptbot": "GPTBot (OpenAI)",
    "claude-user": "Claude-User (pedidos de usuários do Claude)", "claudebot": "ClaudeBot (Anthropic)",
    "claude-searchbot": "Claude-SearchBot (Anthropic)", "bingbot": "Bingbot (Microsoft, alimenta o Copilot)",
    "googlebot": "Googlebot (Google)", "applebot": "Applebot (Apple)", "amazonbot": "Amazonbot (Amazon)",
    "google-extended": "Google-Extended (Gemini)", "meta-externalagent": "Meta-ExternalAgent (Meta)",
}
AREAS = {"redesocial": "rede social do portal", "leis": "leis", "jurisprudencia": "jurisprudência", "sumulas": "súmulas",
         "glossario": "glossário", "diarios": "diários oficiais"}


def nome(agente):
    return NOMES.get(agente, agente)


def area_legivel(area):
    return AREAS.get(area, area.replace("-", " "))


def monta(radar):
    dias = radar["dias"]
    total = radar["total_por_agente"]
    janela = radar["janela_dias"]
    ultimo = dias[-1] if dias else {"date": HOJE, "verificados": {}}
    soma = sum(total.values())
    linhas_total = "\n".join("- %s: %d leituras" % (nome(a), n) for a, n in total.items()) or "- nenhuma leitura verificada na janela"
    areas_hoje = {}
    for a, v in ultimo["verificados"].items():
        for x in v["areas"]:
            areas_hoje[x["area"]] = areas_hoje.get(x["area"], 0) + x["leituras"]
    linhas_areas = "\n".join("- %s: %d leituras" % (area_legivel(k), n) for k, n in sorted(areas_hoje.items(), key=lambda kv: -kv[1])[:10]) or "- sem leitura verificada hoje"
    paginas = {}
    for d in dias:
        for a, v in d["verificados"].items():
            for x in v["paginas"]:
                p = paginas.setdefault(x["path"], {"leituras": 0, "titulo": x.get("titulo") or x["path"]})
                p["leituras"] += x["leituras"]
    top = sorted(paginas.items(), key=lambda kv: -kv[1]["leituras"])[:15]
    # renderSectionBody (internal/render) so entende paragrafo e lista "- ": nada de link Markdown
    linhas_paginas = "\n".join("- %s (%s): %d leituras" % (v["titulo"], p, v["leituras"]) for p, v in top) or "- sem páginas na janela"
    markdown = sum(v["markdown"] for d in dias for v in d["verificados"].values())
    return {
        "path": CAMINHO, "page_type": "institucional", "status": "published", "index_policy": "index",
        "unique_intent_id": "institucional:radar-de-ia-o-que-os-assistentes-leem",
        "canonical_url": "https://wikijuridica.com.br" + CAMINHO,
        "title": "Radar de IA: o que os assistentes de IA leem neste portal",
        "meta_description": ("Quais assistentes de IA leem a Wiki Jurídica, quanto, em que áreas e quais páginas — "
                             "medido nos últimos %d dias, com identidade verificada e sem dados pessoais." % janela),
        "heading": "Radar de IA: o que os assistentes de IA leem neste portal",
        "summary": ("Nos últimos %d dias, %d leituras de páginas deste portal foram feitas por assistentes de inteligência "
                    "artificial com identidade verificada. Esta página mostra quem lê, quanto, em que áreas do direito e "
                    "quais páginas — o mesmo dado que servimos às máquinas, em linguagem de gente. Atualiza todo dia." % (janela, soma)),
        "body_sections": [
            {"title": "Quem lê, nos últimos %d dias" % janela,
             "body": ("Leituras de páginas e das versões em Markdown do acervo, por agente, contando só requisições cuja origem "
                      "bate com a faixa de endereços que o próprio operador publica. Aquecimento interno, simulações e agentes "
                      "que se apresentam com nome de outro ficam de fora.\n\n%s\n\nDas leituras acima, %d foram da versão em "
                      "Markdown, o formato feito para máquinas." % (linhas_total, markdown))},
            {"title": "Áreas mais lidas hoje (%s)" % ultimo["date"],
             "body": "Somando todos os agentes verificados no dia:\n\n%s" % linhas_areas},
            {"title": "Páginas mais lidas por assistentes de IA",
             "body": "As páginas que mais receberam leituras verificadas na janela, somando todos os agentes:\n\n%s" % linhas_paginas},
            {"title": "Como medimos, e o que não fazemos",
             "body": ("O dado vem do registro de acesso da origem do portal, não de terceiros. A identidade de cada agente é "
                      "conferida contra a lista oficial de endereços que a empresa responsável publica; quem chega com o nome de um "
                      "assistente mas de fora dessa lista é contado como forjado e descartado. Não guardamos nem publicamos "
                      "endereço IP, e não medimos pessoas: só programas que se identificam como tal.\n\n"
                      "O mesmo dado, em JSON e com sete dias de histórico, está em /datasets/radar-ia.json. Os demais conjuntos "
                      "abertos do portal estão descritos em /datasets/datasets.json, e o agente de coleta do próprio portal, em /bot/.")},
        ],
        "internal_links": ["/", "/bot/", "/metodologia/", "/sobre/"],
        "publication_date": HOJE, "reviewed_at": HOJE, "content_revised_at": HOJE,
        "author": "Rafael Toledo OAB/RJ 227191", "reviewer": "Rafael Toledo OAB/RJ 227191",
        "source_provenance": [],
        "legal_notice": "Página institucional de transparência sobre o uso do portal por assistentes de inteligência artificial. Conteúdo informativo; não substitui consulta jurídica individual.",
        "publication_purpose": "Mostrar a humanos, com número verificado, quais assistentes de IA leem o portal, quanto e o quê — a mesma medição servida às máquinas em /datasets/radar-ia.json.",
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seco", action="store_true")
    ap.add_argument("--root", default=str(RAIZ))
    args = ap.parse_args()
    raiz = pathlib.Path(args.root)
    pages = raiz / "content" / "pages.json"
    radar_path = raiz / "public" / "datasets" / "radar-ia.json"
    if not radar_path.is_file():
        print("ABORTADO: %s ausente — rode tools/generate-radar-ia antes." % radar_path)
        return 2
    radar = json.loads(radar_path.read_text(encoding="utf-8"))
    dados = json.loads(pages.read_text(encoding="utf-8"))
    if not isinstance(dados, list):
        print("ABORTADO: content/pages.json não é uma lista.")
        return 2
    nova = monta(radar)
    existente = next((p for p in dados if p.get("path") == CAMINHO), None)
    if existente:
        # VIVA: mantém a data de publicação; re-data só quando o corpo muda de verdade
        nova["publication_date"] = existente.get("publication_date") or HOJE
        mesmo = all(existente.get(k) == nova[k] for k in ("summary", "body_sections", "title", "meta_description"))
        if mesmo:
            print("NADA A FAZER: %s já reflete o radar de %s." % (CAMINHO, radar["dias"][-1]["date"] if radar["dias"] else "?"))
            return 0
        nova["reviewed_at"] = HOJE
        nova["content_revised_at"] = HOJE
    caminhos = {p.get("path") for p in dados}
    faltando = [c for c in nova["internal_links"] if c not in caminhos]
    if faltando:
        print("ABORTADO: links internos para rota inexistente: %s" % faltando)
        return 2
    n_t, n_m = len(nova["title"]), len(nova["meta_description"])
    palavras = sum(len(s["body"].split()) for s in nova["body_sections"])
    print("title %d chars, meta %d chars, %d seções, %d palavras, %s" % (n_t, n_m, len(nova["body_sections"]), palavras, "atualiza" if existente else "cria"))
    if not (20 <= n_t <= 65 and 70 <= n_m <= 160):
        print("ABORTADO: title/meta fora do contrato de indexação."); return 2
    if args.seco:
        return 0
    GUARDA.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(pages, GUARDA / ("pages.json.%s.antes-de-radar-ia" % datetime.datetime.now().strftime("%Y%m%dT%H%M%S")))
    novo = [p for p in dados if p.get("path") != CAMINHO] + [nova] if not existente else [nova if p.get("path") == CAMINHO else p for p in dados]
    fd, tmp = tempfile.mkstemp(prefix=".pages-", dir=str(pages.parent))
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(novo, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.replace(tmp, pages)
    print("gravado: %s (%d páginas)" % (pages, len(novo)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
