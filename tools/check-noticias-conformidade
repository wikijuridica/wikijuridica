#!/usr/bin/env python3
"""check-noticias-conformidade — a linha de base do canal derivado, para que regressão apareça.

READ-ONLY. Mede as páginas de `/noticias/` servidas em `public/` contra os
invariantes que a DEC-032 e o contrato editorial exigem, e reprova quando algum
cai abaixo do piso MEDIDO em 2026-08-26.

POR QUE PISO MEDIDO E NÃO NÚMERO ESCOLHIDO. Piso inventado ou aprova tudo ou
reprova o acervo inteiro no dia em que nasce. Estes vieram da medição das 20
páginas no ar, e cada um é o pior valor observado — então o gate reprova
exatamente quando o canal PIORAR em relação a si mesmo:

    corpo visível              min 681 palavras   (piso: 250, o do gerador)
    proporção de texto citado  máx 16,4%          (teto: 30%)
    identidade OAB             20/20
    fontes oficiais no HTML    20/20
    JSON-LD com license        20/20
    meta description 70-160    20/20
    PT-BR sem mojibake         20/20

A DISTÂNCIA ENTRE O PIOR VALOR E O PISO É DE PROPÓSITO. Reprovar em 681 palavras
porque foi o mínimo observado transformaria variação normal em alarme; o piso é o
que o gerador promete (250), e o valor medido fica registrado aqui para que a
queda seja visível antes de virar violação.

O QUE ELE ACUSA HOJE, e não é regressão futura — é defeito presente: as 20
páginas servem `meta description` começando com dígito colado em maiúscula
(*"5 As decisões que o STJ divulgou em 24 de julho de 2026…"*). A causa foi
corrigida no gerador em 2026-08-26 14:48 — o chamador passava uma frase já
iniciada em maiúscula para `plural()`, que prefixa a contagem. Mas as páginas no
ar são de 19/08, e **corrigir o produtor não conserta o estoque**: elas só deixam
de mentir quando forem regeneradas e republicadas.

Este gate fica VERMELHO até essa republicação acontecer, e isso é o desenho certo:
gate que ignora o defeito conhecido para "ficar verde" é o gate verde sobre mundo
errado que este repositório já catalogou cinco vezes.

ARMADILHA DE MEDIÇÃO EMBUTIDA, porque ela me mordeu ao escrever este gate: o
JSON-LD vive dentro de `<script type="application/ld+json">`. Quem remover as tags
`<script>` antes de procurar `license` mede 0 de 20 e conclui que o canal não
declara licença. Ele declara — em 20 de 20. Por isso a checagem de JSON-LD roda
sobre o HTML BRUTO, e só a de texto visível roda sobre o corpo despido.
"""

import argparse
import glob
import html
import os
import re
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
PADRAO = os.path.join(RAIZ, "public", "noticias", "*", "index.html")

PISO_PALAVRAS = 250          # o que o gerador promete
TETO_CITADO = 0.30           # proporção máxima de texto entre aspas curvas


def texto_visivel(bruto: str) -> str:
    corpo = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", bruto)
    principal = re.search(r"(?is)<main.*?</main>", corpo)
    despido = re.sub(r"(?s)<[^>]+>", " ", principal.group(0) if principal else corpo)
    return re.sub(r"\s+", " ", html.unescape(despido)).strip()


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--verbose", action="store_true")
    args = p.parse_args()

    paginas = sorted(glob.glob(PADRAO))
    if not paginas:
        print("check-noticias-conformidade: FAIL")
        print(f"  - nenhuma pagina em {os.path.relpath(PADRAO, RAIZ)}")
        return 1

    falhas: dict[str, list[str]] = {}

    def acusa(rotulo: str, rota: str, detalhe: str = "") -> None:
        falhas.setdefault(rotulo, []).append(f"{rota}{(' — ' + detalhe) if detalhe else ''}")

    menor, maior_citado = 10**9, 0.0
    for caminho in paginas:
        rota = caminho.split(os.sep)[-2]
        bruto = open(caminho, encoding="utf-8").read()
        visivel = texto_visivel(bruto)
        palavras = len(visivel.split())
        menor = min(menor, palavras)

        citado = re.findall(r"“([^”]{10,})”", visivel)
        proporcao = sum(len(c.split()) for c in citado) / max(1, palavras)
        maior_citado = max(maior_citado, proporcao)

        if palavras < PISO_PALAVRAS:
            acusa("corpo abaixo do piso", rota, f"{palavras} palavras")
        if proporcao > TETO_CITADO:
            acusa("texto citado acima do teto", rota, f"{proporcao:.1%}")
        if "OAB" not in bruto:
            acusa("sem identidade OAB", rota)
        # Sobre o HTML BRUTO: o JSON-LD mora dentro de <script>.
        if not re.search(r'"license"\s*:', bruto):
            acusa("JSON-LD sem license", rota)
        if re.search(r"[ÃÂ][\x80-\xbf]", bruto):
            acusa("mojibake", rota)
        meta = re.search(r'<meta name="description" content="([^"]*)"', bruto)
        if not meta:
            acusa("sem meta description", rota)
        else:
            conteudo = meta.group(1)
            if not 70 <= len(conteudo) <= 160:
                acusa("meta fora de 70-160", rota, f"{len(conteudo)} caracteres")
            if re.match(r"^\d+\s+[A-ZÀ-Ú]", conteudo):
                acusa("meta com contagem colada em frase", rota, f'"{conteudo[:52]}…"')

    print(f"paginas de /noticias/ em public/: {len(paginas)}")
    print(f"corpo visivel: minimo {menor} palavras (piso {PISO_PALAVRAS})")
    print(f"texto citado : maximo {maior_citado:.1%} do corpo (teto {TETO_CITADO:.0%})")

    if not falhas:
        print("check-noticias-conformidade: OK (a linha de base de 2026-08-26 se mantem)")
        return 0

    print("check-noticias-conformidade: FAIL")
    for rotulo, rotas in sorted(falhas.items()):
        print(f"  - {rotulo}: {len(rotas)} de {len(paginas)}")
        for r in rotas[:3 if not args.verbose else len(rotas)]:
            print(f"      {r}")
        if not args.verbose and len(rotas) > 3:
            print(f"      ... e mais {len(rotas) - 3} (use --verbose)")
    print("  Se a causa ja foi corrigida no gerador, o que falta e REGENERAR e")
    print("  republicar: corrigir o produtor nao conserta o estoque ja publicado.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
