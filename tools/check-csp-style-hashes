#!/usr/bin/env bash
# check-csp-style-hashes — prova, READ-ONLY, que TODA folha de CSS servida em
# public/ está autorizada pela Content-Security-Policy.
#
# POR QUE ELE EXISTE (BUG-079, 2026-08-29): a CSP deixou de conceder
# `style-src 'unsafe-inline'` e passou a autorizar por hash as folhas do
# catálogo fechado de internal/render/inline_style.go. Desde 2026-09-03 a folha
# das páginas é EXTERNA (/assets/wj-<hash>.css, internal/render/stylesheet.go)
# e a CSP autoriza a URL exata dela; só as páginas de erro seguem inline, por
# hash. Nas duas formas o modo de falha é SILENCIOSO — folha servida que a
# política não cobre: o servidor responde 200, o HTML chega inteiro, todos os
# gates de conteúdo passam, e o navegador recusa o CSS. A página fica sem uma
# linha de estilo e nada no servidor registra o fato.
#
# O que ele confere, e distingue na mensagem:
#   1. public/assets/wj-<hash>.css existe com o conteúdo EXATO do binário;
#   2. toda página tem o <link> exato (uma vez) OU um <style> do catálogo
#      (o 50x.html) — href de outro hash é public/ velho: reconstruir o acervo;
#   3. nenhum atributo `style="…"` (sem 'unsafe-inline' o navegador não o
#      aplica), nenhuma outra folha externa nem @import (sem 'self' em
#      style-src não carregam).
#
# É o MESMO motor do gate nomeado:
#   ./tools/go-modern run ./cmd/check csp-style-hashes
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# run-check, e nao `go-modern run ./cmd/check` direto: e por ele que passam
# o cache do binario, o teto de tempo, o orcamento e a politica de argumentos.
# Chamar o binario de gates por fora recompila a cada invocacao e escapa do teto —
# com 330 gates, e a diferenca entre 2,6 s e 5,2 s por chamada.
exec "$ROOT/tools/run-check" csp-style-hashes --timings "$@"
