#!/usr/bin/env python3
"""check-edge-cache-coverage-honesty — o numero de cobertura tem que fechar a
conta E tem que ser uma medicao nova, nunca o rastro da anterior repetido.

POR QUE EXISTE (X.8, 2026-08-19): no mesmo dia em que `check-edge-cache-coverage`
nasceu, ele produziu um 100% falso porque a semente do sorteio vinha do DIA — a
segunda execucao mediu exatamente as URLs que a primeira tinha acabado de
aquecer (commit 1c92c581). O conserto trocou a semente para a HORA e passou a
gravar `chave_amostra` no proprio registro para que uma repeticao ficasse
DETECTAVEL no arquivo — mas "detectavel no arquivo" so vale alguma coisa se
alguem, ou algo, olhar. Ate este check nascer, ninguem olhava: o mesmo defeito
podia se repetir (execucao manual duas vezes na mesma hora, por exemplo) e a
serie aceitaria o segundo 100% do mesmo jeito que aceitou o primeiro.

O QUE ESTE CHECK REPROVA:
  1. Linha cuja aritmetica nao fecha: cobertura_pct declarado != o que
     quentes/medidas realmente produz, ou quentes+frias+nao_cacheaveis !=
     amostra_medida. Numero fabricado por fora da conta que o proprio arquivo
     carrega os ingredientes para refazer.
  2. Linha que nao declara `sonda_aquece_o_que_mede: true` — a sonda SEMPRE
     aquece o que mede (e um GET real), e uma linha que omitisse isso deixaria
     o vies escondido de quem le so o numero.
  3. Duas linhas ADJACENTES na serie com o MESMO `chave_amostra` — a marca
     exata do defeito que gerou o 100% falso: a segunda medicao caiu sobre o
     rastro que a primeira tinha acabado de aquecer, em vez de medir o acervo.
  4. `data/ops/edge_cache_warm.jsonl` (o AQUECEDOR, instantaneo por desenho)
     com qualquer campo que se apresente como cobertura entre ciclos
     (`cobertura_pct`, `coverage_pct` ou variantes). O aquecedor mede o que o
     PROPRIO GET dele encontrou HA POUCO — nunca o estado do acervo horas
     depois; se um campo desses aparecesse ali, o instrumento voltaria a se
     apresentar como o que nao e, que e o defeito original do X.8.

READ-ONLY.

Uso:
    tools/check-edge-cache-coverage-honesty
    tools/check-edge-cache-coverage-honesty --json
"""
import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
COBERTURA = os.path.join(ROOT, "data/ops/edge_cache_coverage.jsonl")
AQUECEDOR = os.path.join(ROOT, "data/ops/edge_cache_warm.jsonl")

SCHEMA_COBERTURA = "edge_cache_coverage_v1"

# Tolerancia de arredondamento: o produtor grava `round(x, 2)`; comparar em
# ponto flutuante direto reprovaria por erro de representacao, nao por
# fabricacao. 0.011 cobre duas casas decimais com folga sem abrir espaco para
# um numero visivelmente errado passar.
TOLERANCIA_PCT = 0.011

# Campos que so fariam sentido descrevendo cobertura ENTRE ciclos — nunca no
# aquecedor, que mede o instante do proprio GET.
CAMPOS_PROIBIDOS_NO_AQUECEDOR = ("cobertura_pct", "coverage_pct", "cobertura_ic95_baixo", "cobertura_ic95_alto")


def ler_jsonl(caminho):
    linhas = []
    if not os.path.isfile(caminho):
        return linhas
    with open(caminho, encoding="utf-8") as arquivo:
        for numero, bruto in enumerate(arquivo, start=1):
            bruto = bruto.strip()
            if not bruto:
                continue
            try:
                linhas.append((numero, json.loads(bruto)))
            except json.JSONDecodeError as erro:
                linhas.append((numero, {"_erro_json": str(erro)}))
    return linhas


def checar_cobertura():
    problemas = []
    linhas = ler_jsonl(COBERTURA)
    if not linhas:
        return problemas, {"lines": 0}

    # `chave_amostra` so existe a partir do conserto de 2026-08-19 (commit
    # 1c92c581). As linhas gravadas ANTES dele — inclusive as que registraram
    # o proprio 100% falso — sao LEGADO: aceitas sem reprovar por faltar o
    # campo (regra do repositorio: correcao so para frente, a serie antiga nao
    # e reescrita), mas contadas a parte para que ninguem leia "0 problemas"
    # como "nunca aconteceu".
    chave_anterior = None
    numero_anterior = None
    divida_historica: list[str] = []
    legado_sem_chave = 0
    ultima_tem_chave = None
    for numero, registro in linhas:
        if "_erro_json" in registro:
            problemas.append("edge_cache_coverage_invalid_json line=%d %s" % (numero, registro["_erro_json"]))
            continue
        if registro.get("schema_version") != SCHEMA_COBERTURA:
            problemas.append("edge_cache_coverage_unknown_schema line=%d schema=%r"
                              % (numero, registro.get("schema_version")))
            continue

        quentes = registro.get("quentes")
        frias = registro.get("frias")
        nao_cacheaveis = registro.get("nao_cacheaveis")
        medidas = registro.get("amostra_medida")
        cobertura_declarada = registro.get("cobertura_pct")

        if None in (quentes, frias, nao_cacheaveis, medidas, cobertura_declarada):
            problemas.append("edge_cache_coverage_field_missing line=%d" % numero)
            continue

        if quentes + frias + nao_cacheaveis != medidas:
            problemas.append(
                "edge_cache_coverage_sample_sum_mismatch line=%d quentes=%d frias=%d "
                "nao_cacheaveis=%d amostra_medida=%d"
                % (numero, quentes, frias, nao_cacheaveis, medidas))

        cobertura_recalculada = round(100.0 * quentes / medidas, 2) if medidas else 0.0
        if abs(cobertura_recalculada - cobertura_declarada) > TOLERANCIA_PCT:
            problemas.append(
                "edge_cache_coverage_pct_fabricated line=%d declarado=%.2f recalculado=%.2f "
                "(quentes=%d medidas=%d) — o numero nao sai da propria conta que o registro carrega"
                % (numero, cobertura_declarada, cobertura_recalculada, quentes, medidas))

        if registro.get("sonda_aquece_o_que_mede") is not True:
            problemas.append(
                "edge_cache_coverage_bias_undeclared line=%d — a sonda SEMPRE aquece o que mede "
                "(GET real); a linha tem que declarar isso, nao omitir" % numero)

        chave_atual = registro.get("chave_amostra")
        ultima_tem_chave = bool(chave_atual)
        if not chave_atual:
            legado_sem_chave += 1
        elif chave_atual == chave_anterior:
            # DIVIDA HISTORICA x REGRESSAO (2026-09-03). A colisao de chave e
            # defeito real — a segunda medicao cai sobre o rastro que a primeira
            # acabou de aquecer, a causa-raiz do 100% falso de 2026-08-19 (commit
            # 1c92c581). Mas o ledger e APPEND-ONLY: as cinco colisoes que ele
            # carrega sao todas de 27 a 29/08 e nao ha nenhuma desde entao (30
            # linhas de setembro, zero duplicata). Um gate que reprove para sempre
            # por linha que ninguem pode reescrever nao distingue regressao de
            # divida, e e assim que um vermelho permanente ensina a ignorar o
            # vermelho. A divida sai DECLARADA na saida, com a lista; so a
            # colisao POSTERIOR ao corte reprova.
            aviso = ("edge_cache_coverage_self_measurement line=%d e line=%d compartilham chave_amostra=%r "
                     "— a segunda medicao caiu sobre o rastro que a primeira acabou de aquecer, a mesma "
                     "causa-raiz do 100%% falso de 2026-08-19 (commit 1c92c581)"
                     % (numero_anterior, numero, chave_atual))
            if str(chave_atual) >= CORTE_DIVIDA_HISTORICA:
                problemas.append(aviso)
            else:
                divida_historica.append(aviso)
        if chave_atual:
            chave_anterior = chave_atual
            numero_anterior = numero

    if ultima_tem_chave is False:
        problemas.append(
            "edge_cache_coverage_producer_stale — a linha mais recente ainda nao tem "
            "chave_amostra; o produtor corrigido (semente por HORA, commit 1c92c581) ainda "
            "nao gravou nenhuma linha nova")

    return problemas, {"lines": len(linhas), "legacy_without_sample_key": legado_sem_chave,
                       "divida_historica": divida_historica}


def checar_aquecedor_nao_se_apresenta_como_cobertura():
    problemas = []
    linhas = ler_jsonl(AQUECEDOR)
    if not linhas:
        return problemas, {"lines": 0}
    for numero, registro in linhas:
        if "_erro_json" in registro:
            continue
        achados = [campo for campo in CAMPOS_PROIBIDOS_NO_AQUECEDOR if campo in registro]
        if achados:
            problemas.append(
                "edge_cache_warm_masquerades_as_coverage line=%d campos=%s — o aquecedor mede o "
                "GET que ele mesmo fez, nao a cobertura do acervo entre ciclos; esse numero pertence "
                "a data/ops/edge_cache_coverage.jsonl, produzido por check-edge-cache-coverage"
                % (numero, achados))
    return problemas, {"lines": len(linhas)}


# Chave de amostra a partir da qual a colisao volta a REPROVAR. Todas as cinco
# colisoes do ledger sao anteriores a esta data (a ultima e 2026-08-29T15) e o
# ledger e append-only: nao ha o que corrigir nelas, so o que declarar.
CORTE_DIVIDA_HISTORICA = "2026-08-30"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    problemas_cobertura, resumo_cobertura = checar_cobertura()
    problemas_aquecedor, resumo_aquecedor = checar_aquecedor_nao_se_apresenta_como_cobertura()
    todos = problemas_cobertura + problemas_aquecedor

    print("check-edge-cache-coverage-honesty")
    print("  cobertura (%d linha(s), %d sem chave_amostra/legado pre-1c92c581): %d problema(s)"
          % (resumo_cobertura.get("lines", 0), resumo_cobertura.get("legacy_without_sample_key", 0),
             len(problemas_cobertura)))
    print("  aquecedor (%d linha(s)): %d problema(s) de invasao de campo de cobertura"
          % (resumo_aquecedor.get("lines", 0), len(problemas_aquecedor)))
    divida = resumo_cobertura.get("divida_historica") or []
    if divida:
        # Declarada, nunca escondida: o ledger e append-only e estas linhas nao
        # podem ser corrigidas, mas quem le o gate precisa saber que existem.
        print("  divida historica (colisoes anteriores a %s, nao reprovam): %d"
              % (CORTE_DIVIDA_HISTORICA, len(divida)))
        for aviso in divida[:3]:
            print("    " + aviso[:150])
        if len(divida) > 3:
            print("    ... e mais %d" % (len(divida) - 3))

    if args.json:
        print(json.dumps({
            "problems": todos,
            "coverage": resumo_cobertura,
            "warm": resumo_aquecedor,
        }, ensure_ascii=False, indent=2))

    if todos:
        print("\nREPROVADO:", file=sys.stderr)
        for problema in todos:
            print("  " + problema, file=sys.stderr)
        return 1

    print("\ncheck-edge-cache-coverage-honesty: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
