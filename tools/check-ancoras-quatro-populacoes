#!/usr/bin/env python3
"""check-ancoras-quatro-populacoes — o diff por PATH das ancoras de dispositivo.

READ-ONLY. Compara `public/` de AGORA contra a base gravada antes da passada de
2026-09-11 e imprime as quatro populacoes com o dever de cada uma.

POR QUE QUATRO, E POR QUE JUNTAS: conferir uma sem as outras deixa passar o dano
da vizinha. A populacao 2 e REGRESSAO se encolher e a 4 e falha de emissao se nao
crescer, e as duas passam verde numa contagem de "quantos fragmentos errados
sairam" -- que era a unica conferencia que existia. Medido em 2026-09-11: dois
instrumentos independentes erraram cinco vezes classificando, nunca varrendo.

POR QUE POR PATH: quando `art5lvii` vira `art5`, o TOTAL de `raso` nao muda. Troca
de destino com classe igual e invisivel por soma.

A base e `.agents/runtime/ancoras/base_antes_do_ressemear_20260911.json`, gravada
com esta MESMA classificacao -- se as duas divergissem, o diff mediria a regua e
nao o acervo.

Uso:
    tools/check-ancoras-quatro-populacoes                 # contra a base padrao
    tools/check-ancoras-quatro-populacoes --base <arquivo>
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
BASE_PADRAO = ".agents/runtime/ancoras/base_antes_do_ressemear_20260911.json"
CLASSES = ("paragrafo_percent", "paragrafo_literal", "letrado", "inciso_romano",
           "sufixo_ponto_zero", "raso", "outra_forma", "adct")

RE_FRAG = re.compile(r'href="([^"]*#(?:adct)?art[^"]*)"')
RE_RASO = re.compile(r'^(?:adct)?art\d+$')
RE_LETRADO = re.compile(r'^(?:adct)?art\d+-?[a-z]$')
RE_ROMANO = re.compile(r'^(?:adct)?art\d+[ivxlcdm]{2,}$')
RE_PONTO = re.compile(r'^(?:adct)?art\d+\.\d+$')
RE_PLANALTO = re.compile(r'href="(https://www\.planalto\.gov\.br/[^"]*)"')


def classifica(fragmento: str) -> str:
    if "%C2%A7" in fragmento:
        return "paragrafo_percent"
    if "§" in fragmento:
        return "paragrafo_literal"
    if RE_LETRADO.fullmatch(fragmento):
        return "letrado"
    if RE_ROMANO.fullmatch(fragmento):
        return "inciso_romano"
    if RE_PONTO.fullmatch(fragmento):
        return "sufixo_ponto_zero"
    if RE_RASO.fullmatch(fragmento):
        return "raso"
    return "outra_forma"


def varre(raiz_public: str) -> tuple[dict, dict, int]:
    """(por_path, totais, links_sem_fragmento)."""
    por_path: dict[str, dict[str, int]] = {}
    totais = dict.fromkeys(CLASSES, 0)
    sem_fragmento = 0
    for dirpath, _, arquivos in os.walk(raiz_public):
        if "index.html" not in arquivos:
            continue
        rel = ("/" + os.path.relpath(dirpath, raiz_public).strip(".") + "/").replace("//", "/")
        try:
            with open(os.path.join(dirpath, "index.html"), encoding="utf-8") as f:
                html = f.read()
        except OSError:
            continue
        conta = dict.fromkeys(CLASSES, 0)
        for bruto in RE_FRAG.findall(html):
            fragmento = bruto.split("#", 1)[1]
            if fragmento.startswith("adct"):
                conta["adct"] += 1
            conta[classifica(fragmento)] += 1
        # A QUARTA POPULACAO: link para o Planalto SEM fragmento nenhum. Ela nao
        # entra em `por_path` porque nao tem fragmento a comparar -- o que se
        # mede nela e o total, e o dever dela e CRESCER.
        sem_fragmento += sum(1 for u in RE_PLANALTO.findall(html) if "#" not in u)
        if any(conta.values()):
            por_path[rel] = conta
            for chave in CLASSES:
                totais[chave] += conta[chave]
    return por_path, totais, sem_fragmento


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--base", default=BASE_PADRAO)
    args = ap.parse_args()

    caminho = os.path.join(RAIZ, args.base)
    if not os.path.exists(caminho):
        print(f"check-ancoras-quatro-populacoes: base ausente: {caminho}", file=sys.stderr)
        return 2
    with open(caminho, encoding="utf-8") as f:
        base = json.load(f)

    agora, totais, sem_fragmento = varre(os.path.join(RAIZ, "public"))
    antes = base["totais"]
    antes_por_path = base["por_path"]

    print(f"base: {args.base}  ({base.get('gerado_em','?')})")
    print(f"paginas com ancora: antes {len(antes_por_path)} · agora {len(agora)}")
    print("\nclasse                 antes    agora    delta")
    for chave in CLASSES:
        a, d = antes.get(chave, 0), totais[chave]
        print(f"  {chave:<20} {a:>6}   {d:>6}   {d - a:>+6}")
    a_sem = antes.get("sem_fragmento", 0)
    print(f"  {'sem_fragmento':<20} {a_sem:>6}   {sem_fragmento:>6}   {sem_fragmento - a_sem:>+6}"
          "   (dever: ENCOLHER, ganhando fragmento)")

    # POR PATH: troca de destino com classe igual e invisivel por soma.
    mudaram = [p for p in set(antes_por_path) | set(agora)
               if antes_por_path.get(p) != agora.get(p)]
    print(f"\npaginas cujo perfil de ancora MUDOU: {len(mudaram)}")
    for p in sorted(mudaram)[:10]:
        print(f"    {p}\n      antes {antes_por_path.get(p)}\n      agora {agora.get(p)}")
    if len(mudaram) > 10:
        print(f"    ... e mais {len(mudaram) - 10}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
