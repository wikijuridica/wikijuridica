def sufixo_de_formula(caminho_do_snapshot):
    """O arquivo irmao que declara sob QUE formula o snapshot foi tirado."""
    base, marca, _ = caminho_do_snapshot.rpartition(".jsonl")
    return (base if marca else caminho_do_snapshot) + ".formula.txt"


def formula_comparavel(caminho_do_snapshot, ler_texto):
    """(True, "") quando o snapshot declara a MESMA formula do served_sha256 de hoje.

    `served_sha256` so e comparavel consigo mesmo sob a mesma formula de
    neutralizacao (`tools/generate-page-content-revision`, BLOCOS_DE_NAVEGACAO +
    neutraliza_datas). Quando a formula avanca, TODO hash do acervo muda de uma
    vez: o diff devolveria as ~11 mil rotas e pareceria uma catastrofe de
    frescor, quando o que mudou foi a REGUA. Por isso a comparacao so acontece
    com as duas assinaturas na mao, e a ausencia da do snapshot e recusa --
    nunca suposicao de igualdade.
    """
    atual = ler_texto(FORMULA_ATUAL)
    if not atual:
        return False, ("a assinatura da formula de hoje nao esta legivel em %s"
                       % os.path.relpath(FORMULA_ATUAL, ROOT))
    irmao = sufixo_de_formula(caminho_do_snapshot)
    declarada = ler_texto(irmao)
    if not declarada:
        return False, ("o snapshot nao declara a formula sob a qual foi tirado. Esperado em %s.\n"
                       "  Um snapshot sem essa declaracao nao prova comparabilidade: se a formula\n"
                       "  avancou entre ele e agora, o diff mede a troca de regua e nao a de bytes.\n"
                       "  Quem tira o snapshot copia junto a assinatura do momento:\n"
                       "      cp %s <snapshot>.formula.txt"
                       % (os.path.relpath(irmao, ROOT), os.path.relpath(FORMULA_ATUAL, ROOT)))
    if declarada.strip() != atual.strip():
        return False, ("a formula do served_sha256 mudou desde o snapshot.\n"
                       "  snapshot: %s...\n"
                       "  hoje:     %s...\n"
                       "  Comparar os dois mediria a troca de REGUA, nao a troca de bytes."
                       % (declarada.strip()[:16], atual.strip()[:16]))
    return True, ""


def served_por_caminho(entradas):
    """(path -> served_sha256, quantas entradas nao tem o campo).

    Sem `served_sha256` nao ha comparacao possivel -- nem a favor nem contra.
    Contar e obrigatorio: somar "nao sei ler" a "nao mudou" e tratar o
    desconhecido como neutro, que e como um veredito aceita o que nunca mediu.
    """
    mapa = {}
    sem_campo = 0
    for entrada in entradas:
        caminho = entrada.get("path")
        if not caminho:
            continue
        servido = entrada.get("served_sha256")
        if not servido:
            sem_campo += 1
            continue
        mapa[caminho] = servido
    return mapa, sem_campo


def rotas_com_bytes_diferentes(snapshot, atual):
    """(mudadas, novas, sem_served) entre dois estados do ledger de revisao.

    `mudadas`: o path existe nos dois e o `served_sha256` e outro.
    `novas`:   o path so existe agora -- bytes novos por construcao.
    `sem_served`: entradas de um lado ou do outro sem o campo, que nao entram em
    lista nenhuma e sao devolvidas para quem chama poder RELATAR o que nao mediu.

    Path que sumiu nao entra: rota removida nao tem frescor a provar.
    """
    antes, sem_antes = served_por_caminho(snapshot)
    agora, sem_agora = served_por_caminho(atual)
    mudadas = []
    novas = []
    for caminho, servido in agora.items():
        anterior = antes.get(caminho)
        if anterior is None:
            novas.append(caminho)
        elif anterior != servido:
            mudadas.append(caminho)
    return sorted(set(mudadas)), sorted(set(novas)), sem_antes + sem_agora


def manifesto_por_caminho(linhas):
    mapa = {}
    for linha in linhas:
        caminho = linha.get("path")
        sha = linha.get("html_sha256")
        if caminho and sha:
            mapa[caminho] = sha
    return mapa


# ---------------------------------------------------------------- verdade

def caminho_no_disco(path):
    return os.path.join(PUBLIC, path.strip("/"), "index.html") if path.strip("/") \
        else os.path.join(PUBLIC, "index.html")


def sha_disco(path):
    arquivo = caminho_no_disco(path)
    try:
        with open(arquivo, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except FileNotFoundError:
        return None


def decodifica_repr_digest(valor):
    """`sha-256=:BASE64:` (RFC 9530) → hex; None quando ausente ou de outro algoritmo."""
    if not valor:
        return None
    m = REPR_DIGEST.search(valor)
    if not m:
        return None
    try:
        return base64.b64decode(m.group(1)).hex()
    except (ValueError, TypeError):
        return None


def classifica_html(sha_borda, sha_disco, sha_manifesto):
    """Classe do HTML de uma rota. A VERDADE é o disco; o manifesto só atesta o disco.

    - disco ausente                         → disco_ausente (defeito de publicação)
    - manifesto presente e ≠ disco          → disco_diverge_do_manifesto (idem; não purga)
    - borda ≠ disco                         → velha
    - senão                                 → fresca

    A ordem importa: a comparação com a borda só acontece depois de o disco
    estar atestado. Compará-la com o manifesto em vez do disco mudaria a classe
    do caso "disco diverge" (test_check_edge_frescor.py prova pelo mutante).
    """
    if sha_disco is None:
        return DISCO_AUSENTE
    if sha_manifesto is not None and sha_manifesto != sha_disco:
        return DISCO_DIVERGE
    if sha_borda != sha_disco:
        return VELHA
    return FRESCA


def classifica_gemea(sha_borda, sha_go):
    return FRESCA if sha_borda == sha_go else VELHA


def variantes_velhas(digests_por_variante, sha_go):
    """As variantes de Accept-Encoding cujo objeto no nginx não é o que o Go serve."""
    return [ae for ae, digest in digests_por_variante.items() if digest != sha_go]


# ---------------------------------------------------------------- sonda

class Limitador:
    """No máximo `rps` requisições por segundo, partilhado entre as threads."""

    def __init__(self, rps):
        self.intervalo = 1.0 / rps if rps > 0 else 0.0
        self.lock = threading.Lock()
        self.proximo = 0.0

    def espera(self):
        with self.lock:
            agora = time.monotonic()
            inicio = max(agora, self.proximo)
            self.proximo = inicio + self.intervalo
        atraso = inicio - agora
        if atraso > 0:
            time.sleep(atraso)


class _SemRedirecionamento(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_ABRIDOR = urllib.request.build_opener(_SemRedirecionamento())


def _uma_leitura(url, cabecalhos, timeout):
    pedido = urllib.request.Request(url, headers=cabecalhos, method="GET")
    try:
        with _ABRIDOR.open(pedido, timeout=timeout) as resposta:
            corpo = resposta.read()
            return resposta.status, {k.lower(): v for k, v in resposta.headers.items()}, corpo
    except urllib.error.HTTPError as erro:
        corpo = erro.read()
        return erro.code, {k.lower(): v for k, v in erro.headers.items()}, corpo


def busca(url, cabecalhos, timeout=TIMEOUT):
    """(status, cabeçalhos em minúsculas, corpo). Uma repetição em falha de transporte.

    Repetir uma vez é o que `warm-edge-cache` faz: a borda fecha a conexão depois
    de N requisições e um timeout isolado não é veredito sobre a rota. Duas
    falhas seguidas são.
    """
    ultima = None
    for _ in range(2):
        try:
            return _uma_leitura(url, cabecalhos, timeout)
        except (urllib.error.URLError, http.client.HTTPException, OSError, TimeoutError) as erro:
            ultima = erro
    raise FalhaDeSonda("%s: %s" % (type(ultima).__name__, str(ultima)[:120]))


def sha_sem_relacionados(corpo):
    """sha256 do corpo SEM os itens do bloco "Conteúdos relacionados".

    Remove a linha do título e as linhas de lista que vêm logo depois — e só
    elas: o que vier DEPOIS do bloco (o JSON de citação, a versão canônica)
    continua dentro do hash, senão esta função viraria um cego para o fim do
    documento. Corpo sem o marcador devolve o mesmo sha do corpo inteiro.
    """
    try:
        texto = corpo.decode("utf-8")
    except UnicodeDecodeError:
        return hashlib.sha256(corpo).hexdigest()
    linhas = texto.split("\n")
    try:
        inicio = linhas.index(MARCA_RELACIONADOS)
    except ValueError:
        return hashlib.sha256(corpo).hexdigest()
    fim = inicio + 1
    while fim < len(linhas) and (linhas[fim].startswith("- ") or linhas[fim] == ""):
        fim += 1
    restante = linhas[:inicio] + linhas[fim:]
    return hashlib.sha256("\n".join(restante).encode("utf-8")).hexdigest()


def le_corpo(busca_fn, url, cabecalhos, limitador=None):
    """Lê uma URL e devolve (sha256 hex, sha256 sem relacionados, cabeçalhos).

    Levanta FalhaDeSonda fora do contrato.
    """
    if limitador is not None:
        limitador.espera()
    status, cabecalhos_resp, corpo = busca_fn(url, cabecalhos)
    if status != 200:
        raise FalhaDeSonda("HTTP %s" % status)
    codificacao = (cabecalhos_resp.get("content-encoding") or "identity").strip().lower()
    if codificacao not in ("", "identity"):
        # Hash de bytes comprimidos não é comparável com o disco.
        raise FalhaDeSonda("corpo veio comprimido (%s) apesar de Accept-Encoding: identity" % codificacao)
    digest = hashlib.sha256(corpo).hexdigest()
    declarado = decodifica_repr_digest(cabecalhos_resp.get("repr-digest"))
    if declarado is not None and declarado != digest:
        raise FalhaDeSonda("Repr-Digest %s… não bate com o corpo lido %s…" % (declarado[:12], digest[:12]))
    return digest, sha_sem_relacionados(corpo), cabecalhos_resp


def le_digest_declarado(busca_fn, url, cabecalhos):
    """Lê uma variante que pode vir comprimida e devolve só o `Repr-Digest` (hex).

    É a única forma de conferir a variante `gzip, br` sem biblioteca de brotli:
    o Go calcula o digest sobre a representação, o nginx guarda o cabeçalho junto
    com o objeto e a compressão na saída não o altera.
    """
    status, cabecalhos_resp, _ = busca_fn(url, cabecalhos)
    if status != 200:
        raise FalhaDeSonda("HTTP %s" % status)
    declarado = decodifica_repr_digest(cabecalhos_resp.get("repr-digest"))
    if declarado is None:
        raise FalhaDeSonda("origem sem Repr-Digest; a variante não é comparável")
    return declarado


def _idade(cabecalhos):
    try:
        return int(cabecalhos.get("age", ""))
    except (TypeError, ValueError):
        return None


def sonda_rota(path, deps):
    """Cinco leituras e três classes para UMA rota. Nunca levanta: erro vira campo."""
    base = deps["base"]
    url_html = base + path
    url_md = base + path + "index.md"
    url_go = GO + path + "index.md"
    url_origem = ORIGEM + path + "index.md"
    cabecalhos_local = dict(CABECALHOS_BORDA, Host=deps["dominio"])

    manifesto = deps["manifesto"].get(path)
    disco = deps["sha_disco"](path)

    resultado = {"path": path, "sem_manifesto": manifesto is None, "erros": [],
                 "origem": {"classe": FRESCA, "variantes_velhas": [], "digests": {}}}

    # HTML: borda × disco (atestado pelo manifesto).
    try:
        sha_borda, _, cab = le_corpo(deps["busca"], url_html, CABECALHOS_BORDA, deps["limitador"])
        classe = classifica_html(sha_borda, disco, manifesto)
        resultado["html"] = {
            "classe": classe, "url": url_html,
            "cf_cache_status": cab.get("cf-cache-status", "-"), "age": _idade(cab),
            "sha_borda": sha_borda, "sha_disco": disco, "sha_manifesto": manifesto,
            "borda_igual_manifesto": (manifesto is not None and sha_borda == manifesto),
        }
    except FalhaDeSonda as erro:
        resultado["html"] = {"classe": ERRO, "url": url_html, "erro": str(erro),
                             "sha_disco": disco, "sha_manifesto": manifesto}
        resultado["erros"].append({"path": path, "canal": "html", "erro": str(erro)})

    # Gêmea: a verdade é o Go. Sem ela nem a borda nem o nginx têm com o que ser comparados.
    try:
        sha_go, nucleo_go, _ = le_corpo(deps["busca"], url_go, cabecalhos_local, None)
    except FalhaDeSonda as erro:
        resultado["md"] = {"classe": ERRO, "url": url_md, "erro": "go: %s" % erro}
        resultado["origem"] = {"classe": ERRO, "variantes_velhas": [], "digests": {}}
        resultado["erros"].append({"path": path, "canal": "md", "erro": "go: %s" % erro})
        return resultado

    # Cache de origem: uma leitura por variante que a borda pede, só o digest.
    digests = {}
    for ae in VARIANTES_ACCEPT_ENCODING:
        try:
            digests[ae] = le_digest_declarado(deps["busca"], url_origem,
                                              dict(cabecalhos_local, **{"Accept-Encoding": ae}))
        except FalhaDeSonda as erro:
            resultado["origem"]["classe"] = ERRO
            resultado["erros"].append({"path": path, "canal": "origem:%s" % (ae or "-"), "erro": str(erro)})
    velhas = variantes_velhas(digests, sha_go)
    resultado["origem"]["digests"] = digests
    resultado["origem"]["variantes_velhas"] = velhas
    if velhas:
        resultado["origem"]["classe"] = ORIGEM_VELHA
    resultado["origem"]["url"] = url_origem
    resultado["origem"]["rota"] = path + "index.md"

    # Gêmea pela borda × Go.
    try:
        sha_borda_md, nucleo_borda, cab = le_corpo(deps["busca"], url_md, CABECALHOS_BORDA,
                                                   deps["limitador"])
        resultado["md"] = {
            "classe": classifica_gemea(sha_borda_md, sha_go), "url": url_md,
            "cf_cache_status": cab.get("cf-cache-status", "-"), "age": _idade(cab),
            "sha_borda": sha_borda_md, "sha_go": sha_go,
            # Diagnóstico, não isenção: a classe acima não olha para este campo.
            "so_relacionados": (sha_borda_md != sha_go and nucleo_borda == nucleo_go),
        }
    except FalhaDeSonda as erro:
        resultado["md"] = {"classe": ERRO, "url": url_md, "erro": str(erro)}
        resultado["erros"].append({"path": path, "canal": "md", "erro": str(erro)})
    return resultado


def confere(rotas, deps):
    with concurrent.futures.ThreadPoolExecutor(max_workers=CONCORRENCIA) as executor:
        return list(executor.map(lambda p: sonda_rota(p, deps), rotas))


def classe_da_rota(resultado):
    """Uma classe por rota: velha > disco diverge > origem velha > erro > fresca.

    Velha vence o erro de propósito: um canal medido velho é purgado mesmo que
    outro não tenha respondido — o erro continua contado e derruba o exit.
    """
    classes = {resultado["html"]["classe"], resultado["md"]["classe"], resultado["origem"]["classe"]}
    if VELHA in classes:
        return VELHA
    if DISCO_DIVERGE in classes or DISCO_AUSENTE in classes:
        return DISCO_DIVERGE
    if ORIGEM_VELHA in classes:
        return ORIGEM_VELHA
    if ERRO in classes:
        return ERRO
    return FRESCA


def urls_velhas(resultados):
    """As URLs da borda medidas velhas, canal a canal — é isto que se purga na borda."""
    urls = []
    for r in resultados:
        for canal in ("html", "md"):
            if r[canal]["classe"] == VELHA:
                urls.append(r[canal]["url"])
    return urls


def rotas_origem_velhas(resultados):
    """As gêmeas cujo cache de origem guarda variante velha — é isto que se invalida no nginx."""
    return [r["origem"]["rota"] for r in resultados if r["origem"]["classe"] == ORIGEM_VELHA]


def rotas_a_reler(resultados):
    return sorted({r["path"] for r in resultados if classe_da_rota(r) in (VELHA, ORIGEM_VELHA)})


# ---------------------------------------------------------------- purga

def purga_por_url(urls, executor=subprocess.run):
    """Chama tools/purge-edge-cache com a lista exata e teto igual ao tamanho dela.

    Devolve (exit, saída). O teto explícito é o que impede a degradação para
    purga total quando a lista passar do padrão dele.
    """
    comando = [PURGE, "--de-arquivo", "-", "--teto-por-url", str(len(urls))]
    proc = executor(comando, input="\n".join(urls) + "\n", capture_output=True, text=True,
                    cwd=ROOT, timeout=300)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def invalida_origem(rotas, executor=subprocess.run):
    """Chama tools/purge-origin-cache para as gêmeas; devolve (exit, saída, relatório).

    O relatório é o JSON da ferramenta — `objetos_antes`, `removidos`,
    `restantes` por rota. É o que substitui a contagem de INTENÇÃO: até
    2026-09-16 este check gravava `invalidadas_origem = len(rotas)` quando o exit
    era 0, e o exit era 0 mesmo quando a ferramenta não removia objeto nenhum.
    Medido na zona viva no mesmo dia: cada rota tinha 2 ou 3 objetos e a
    ferramenta alcançava 1.
    """
    comando = [PURGE_ORIGEM, "--de-arquivo", "-", "--json"]
    proc = executor(comando, input="\n".join(rotas) + "\n", capture_output=True, text=True,
                    cwd=ROOT, timeout=300)
    saida = (proc.stdout or "") + (proc.stderr or "")
    try:
        relatorio = json.loads(proc.stdout)
    except (ValueError, TypeError):
        relatorio = None
    return proc.returncode, saida, relatorio


def origem_ainda_velha(rotas_md, deps):
    """Relê as variantes que a borda pede e devolve as gêmeas ainda velhas no nginx.

    Leitura LOCAL (nginx e Go), fora do limitador da borda. Existe porque purgar
    a borda com a origem velha é ativamente pior que não purgar: medido em
    2026-09-16 em `/noticias/index.md`, a borda purgada voltou `MISS` em 1,11 s
    servindo o corpo ANTIGO que o nginx ainda tinha; com a origem invalidada
    antes, a mesma rota voltou `MISS` em 1,03 s com o corpo do Go.
    """
    def confere_uma(rota_md):
        path = rota_md[:-len("index.md")] if rota_md.endswith("index.md") else rota_md
        cabecalhos_local = dict(CABECALHOS_BORDA, Host=deps["dominio"])
        try:
            sha_go, _, _ = le_corpo(deps["busca"], GO + rota_md, cabecalhos_local, None)
        except FalhaDeSonda as erro:
            return rota_md, ["go: %s" % erro]
        velhas = []
        for ae in VARIANTES_ACCEPT_ENCODING:
            try:
                digest = le_digest_declarado(deps["busca"], ORIGEM + rota_md,
                                             dict(cabecalhos_local, **{"Accept-Encoding": ae}))
            except FalhaDeSonda as erro:
                velhas.append("%s: %s" % (ae or "-", erro))
                continue
            if digest != sha_go:
                velhas.append(ae or "-")
        return rota_md, velhas

    with concurrent.futures.ThreadPoolExecutor(max_workers=CONCORRENCIA) as executor:
        return {rota: velhas for rota, velhas in executor.map(confere_uma, rotas_md) if velhas}


# A JANELA DE PROPAGAÇÃO DA PURGA DE BORDA, MEDIDA — não escolhida (2026-09-16).
# Oito purgas por URL na zona viva, cronometradas do retorno da API até a
# primeira leitura com os bytes novos: 0,10 s, 0,13 s, 0,65 s, 0,67 s, 0,68 s,
# 0,69 s, 0,70 s e 0,72 s — em TODAS elas a primeira leitura já veio `MISS` com o
# corpo do Go. O teto abaixo é 7x o máximo observado, e existe para que uma
# lentidão pontual da borda não vire "purga que não purgou" (exit 2, alerta ao
# dono); rota que continuar velha ao fim dele está velha de verdade.
ESPERA_POS_PURGA_S = (0.0, 1.0, 4.0)


# ---------------------------------------------------------------- linha

def monta_linha(date, criterio, rotas, resultados, invalidos, purga, duracao_s):
    por_classe = {FRESCA: [], VELHA: [], DISCO_DIVERGE: [], ORIGEM_VELHA: [], ERRO: []}
    for r in resultados:
        por_classe[classe_da_rota(r)].append(r)
    velhas = por_classe[VELHA]
    diverge = por_classe[DISCO_DIVERGE]
    com_erro = [r for r in resultados if r["erros"]]
    sem_manifesto = [r["path"] for r in resultados if r["sem_manifesto"]]
    origem_velha = [r for r in resultados if r["origem"]["classe"] == ORIGEM_VELHA]

    detalhe_velhas = []
    por_canal = {"html": 0, "md": 0}
    for r in velhas:
        for canal in ("html", "md"):
            if r[canal]["classe"] == VELHA:
                por_canal[canal] += 1
                if len(detalhe_velhas) < TETO_LISTA:
                    esperado = r[canal].get("sha_disco") if canal == "html" else r[canal].get("sha_go")
                    detalhe_velhas.append({
                        "path": r["path"], "canal": canal,
                        "cf_cache_status": r[canal].get("cf_cache_status", "-"),
                        "age": r[canal].get("age"),
                        "sha_borda": (r[canal].get("sha_borda") or "")[:16],
                        "sha_esperado": (esperado or "")[:16],
                    })
    detalhe_diverge = [{
        "path": r["path"], "motivo": r["html"]["classe"],
        "borda_igual_manifesto": bool(r["html"].get("borda_igual_manifesto")),
    } for r in diverge[:TETO_LISTA]]
    detalhe_origem = [{
        "path": r["path"], "variantes_velhas": r["origem"]["variantes_velhas"],
    } for r in origem_velha[:TETO_LISTA]]
    erros_detalhe = [e for r in com_erro for e in r["erros"]][:TETO_ERROS]

    return {
        "schema_version": SCHEMA,
        "date": date,
        "criterio": criterio,
        "rotas_mudadas": len(rotas),
        "carimbos_invalidos": invalidos,
        "conferidas": len(resultados) - len(com_erro),
        "frescas": len(por_classe[FRESCA]),
        "velhas": [r["path"] for r in velhas[:TETO_LISTA]],
        "velhas_total": len(velhas),
        "velhas_por_canal": por_canal,
        "velhas_detalhe": detalhe_velhas,
        "disco_diverge": [r["path"] for r in diverge[:TETO_LISTA]],
        "disco_diverge_total": len(diverge),
        "disco_diverge_detalhe": detalhe_diverge,
        "origem_cache_velha": [r["path"] for r in origem_velha[:TETO_LISTA]],
        "origem_cache_velha_total": len(origem_velha),
        "origem_cache_velha_classe": len(por_classe[ORIGEM_VELHA]),
        "origem_cache_detalhe": detalhe_origem,
        "sem_manifesto": sem_manifesto[:TETO_LISTA],
        "sem_manifesto_total": len(sem_manifesto),
        "erros_de_sonda": len(com_erro),
        "erros_detalhe": erros_detalhe,
        "purga_pedida": purga["pedida"],
        "purgadas": purga["purgadas"],
        "purga_exit": purga["exit"],
        # `invalidadas_origem` MUDOU DE SIGNIFICADO em 2026-09-16: era o número de
        # rotas PEDIDAS quando o exit fosse 0 (intenção); passa a ser o número de
        # rotas em que objeto foi removido E nenhum sobrou (efeito medido). Os
        # três campos `objetos_origem_*` dizem sobre o que a conta foi feita.
        "invalidadas_origem": purga["invalidadas_origem"],
        "invalidacao_origem_exit": purga["origem_exit"],
        "objetos_origem_antes": purga["objetos_origem_antes"],
        "objetos_origem_removidos": purga["objetos_origem_removidos"],
        "objetos_origem_restantes": purga["objetos_origem_restantes"],
        "origem_velha_apos_invalidacao": purga["origem_velha_apos_invalidacao"][:TETO_LISTA],
        "origem_velha_apos_invalidacao_total": len(purga["origem_velha_apos_invalidacao"]),
        "pos_purga_velhas": purga["pos_purga_velhas"],
        "pos_purga_tentativas": purga["pos_purga_tentativas"],
        "pos_purga_espera_s": purga["pos_purga_espera_s"],
        "pos_purga_releitura_s": purga["pos_purga_releitura_s"],
        # Diagnóstico do oráculo que se move (ver MARCA_RELACIONADOS). Não muda
        # classe nem exit: diz quantas das gêmeas velhas divergem SÓ no bloco de
        # relacionados, que é o que o gate irmão do HTML já neutraliza.
        "velhas_so_relacionados": sum(1 for r in velhas if r["md"].get("so_relacionados")),
        "duracao_s": round(duracao_s, 1),
        "counts_as_audience": False,
    }


VOLATEIS = ("duracao_s", "gerado_em")


def assinatura(linha):
    return json.dumps({k: v for k, v in linha.items() if k not in VOLATEIS},
                      ensure_ascii=False, sort_keys=True)


def grava(linha, caminho):
    """Acrescenta a linha; devolve False (sem escrever) se já existe uma idêntica."""
    nova = assinatura(linha)
    if os.path.exists(caminho):
        for existente in le_jsonl(caminho):
            if assinatura(existente) == nova:
                return False
    linha = dict(linha)
    linha["gerado_em"] = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    with open(caminho, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    return True


