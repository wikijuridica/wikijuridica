# ---------------------------------------------------------------- main

def _argumentos(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    janela = parser.add_mutually_exclusive_group()
    janela.add_argument("--dia", help="rotas carimbadas neste dia (AAAA-MM-DD); padrão hoje em UTC")
    janela.add_argument("--desde-horas", type=int,
                        help="rotas cujo carimbo toca as últimas N horas (dia puro conta o dia inteiro)")
    janela.add_argument("--desde-ledger", metavar="SNAPSHOT",
                        help="rotas cujo served_sha256 difere do snapshot do ledger de revisão "
                             "(é o modo que enxerga --ressemear, que muda bytes sem avançar data)")
    parser.add_argument("--max", type=int, default=MAX_PADRAO,
                        help="teto de rotas a conferir; acima disso exit 2, nunca amostra (padrão %d)" % MAX_PADRAO)
    parser.add_argument("--purgar", action="store_true",
                        help="invalida a origem e purga por URL cada canal medido velho, depois relê")
    parser.add_argument("--gravar", action="store_true",
                        help="acrescenta a linha em data/ops/edge_frescor_daily.jsonl (sem isto, só relata)")
    args = parser.parse_args(argv)
    if args.dia is not None and not CARIMBO_DIA.match(args.dia):
        parser.error("--dia exige AAAA-MM-DD")
    if args.desde_horas is not None and args.desde_horas <= 0:
        parser.error("--desde-horas exige inteiro positivo")
    return args


def _purga_e_releitura(resultados, deps, purga):
    """Ordem do deploy-binario-go: invalidar a origem, CONFERIR, purgar a borda, reler.

    O passo do meio é novo (2026-09-16) e não é zelo: purgar a borda enquanto o
    nginx guarda a resposta anterior repopula a borda com o conteúdo antigo —
    medido, com a rota nomeada, no comentário de `origem_ainda_velha`.
    """
    # A espera entre releituras é injetável para o teste não pagar a janela real:
    # o que ele mede é a CONVERGÊNCIA em mais de uma tentativa, não o relógio.
    espera_fn = deps.get("espera") or time.sleep
    origem = rotas_origem_velhas(resultados)
    borda = urls_velhas(resultados)
    falhou = False
    if origem:
        codigo, saida, relatorio = deps["purga_origem"](origem)
        purga["origem_exit"] = codigo
        if relatorio:
            purga["objetos_origem_antes"] = relatorio.get("objetos_antes", 0)
            purga["objetos_origem_removidos"] = relatorio.get("removidos", 0)
            purga["objetos_origem_restantes"] = relatorio.get("restantes", 0)
            # MEDIDA, não declarada: rota é "invalidada" quando teve objeto
            # removido E não sobrou nenhum. Sem objeto na zona não há o que
            # invalidar, e contar isso como invalidação foi o defeito anterior.
            purga["invalidadas_origem"] = sum(
                1 for r in relatorio.get("rotas", [])
                if r.get("removidos", 0) > 0 and r.get("restantes", 0) == 0)
        if codigo != 0:
            falhou = True
            print("check-edge-frescor: invalidação da origem falhou (exit %d)\n%s"
                  % (codigo, saida.strip()), file=sys.stderr)
        else:
            ainda = origem_ainda_velha(origem, deps)
            purga["origem_velha_apos_invalidacao"] = sorted(ainda)
            if ainda:
                falhou = True
                print("check-edge-frescor: a origem continua servindo o objeto anterior em %d "
                      "gêmea(s) DEPOIS da invalidação — a borda NÃO foi purgada, porque purgar "
                      "agora traria o conteúdo antigo de volta para ela. %s"
                      % (len(ainda), "; ".join("%s [%s]" % (r, ", ".join(v))
                                               for r, v in sorted(ainda.items())[:5])),
                      file=sys.stderr)
    if borda and not falhou:
        codigo, saida = deps["purga"](borda)
        purga["exit"] = codigo
        if codigo == 0:
            purga["purgadas"] = len(borda)
        else:
            falhou = True
            print("check-edge-frescor: purga da borda falhou (exit %d)\n%s" % (codigo, saida.strip()),
                  file=sys.stderr)
    if falhou:
        return
    # Relê SÓ o que purgou: prova que a purga surtiu efeito e, de quebra, repõe
    # a versão fresca na borda e no cache de origem. A releitura se repete dentro
    # da janela MEDIDA de propagação (ESPERA_POS_PURGA_S): uma amostra só, a 1,2 s
    # da purga, não distinguia "a borda ainda não propagou" de "a purga não
    # surtiu efeito", e as duas saem pelo mesmo exit 2.
    alvo = rotas_a_reler(resultados)
    inicio = time.time()
    esperado = 0.0
    for tentativa, espera in enumerate(ESPERA_POS_PURGA_S, start=1):
        if espera:
            espera_fn(espera)
            esperado += espera
        releitura = confere(alvo, deps)
        restantes = rotas_a_reler(releitura)
        purga["pos_purga_velhas"] = len(restantes)
        purga["pos_purga_tentativas"] = tentativa
        # DOIS NÚMEROS, e a distinção é o ponto: `espera` é só o que se ESPEROU
        # pela propagação (0 na primeira tentativa, por desenho); `releitura` é o
        # relógio de parede do laço, dominado pela sonda a 8 rps. Numa medição de
        # 125 rotas eles deram 0,0 e 31,74 s — um campo só, chamado "espera",
        # diria que a borda levou 31 s para propagar e contradiria as oito
        # cronometragens de 0,10 s a 0,72 s. É a mesma forma de mentira que
        # `invalidadas_origem` tinha.
        purga["pos_purga_espera_s"] = round(esperado, 2)
        purga["pos_purga_releitura_s"] = round(time.time() - inicio, 2)
        if not restantes:
            return
        alvo = restantes


# O aquecedor de borda ja tem trava propria (tools/warm-edge-cache:58,
# LOCK_EX|LOCK_NB): duas varreduras nao colidem. Esta sonda nunca a consultou,
# e a guarda ficava pela metade — aquecimento x aquecimento protegido,
# aquecimento x MEDICAO nao.
LOCK_AQUECIMENTO = "/tmp/opt-wiki-warm-edge-cache.lock"


def aquecimento_em_voo(caminho=LOCK_AQUECIMENTO):
    """True quando ha aquecimento de borda segurando a trava.

    MEDIDO EM 2026-09-10, e o numero e o argumento. A mesma passada de
    `warm-edge-cache --rps 12 --so-frios`, com e sem esta sonda rodando junto:

        com a sonda   11210 em 1015s (11,05 r/s)   {200: 10430, 0: 780}
        sozinha       11210 em  934s (12,00 r/s)   {200: 11210}

    E do lado do gate, na mesma janela: 521 `erros_de_sonda` com
    "Temporary failure in name resolution", contra 0 depois. As duas medem o
    MESMO canal, e a que chega em segundo mede a degradacao que a primeira
    causou. Nenhum dos numeros ruins era sobre o portal — as paginas serviam
    200 com cf-cache-status HIT o tempo todo.
    #
    # O VEREDITO E 2, NAO 1. Medir durante aquecimento nao e "a borda esta
    # velha": e "nao da para saber". Vermelho aqui mandaria purgar rota que
    # esta fresca, e verde afirmaria frescor que nao foi medido. Inconclusivo
    # e a unica resposta honesta, e e o mesmo codigo que o gate ja usa para
    # erro de sonda.

    A trava e tomada em modo COMPARTILHADO: duas sondas simultaneas nao se
    atrapalham entre si (nenhuma escreve), e o que precisa ser detectado e o
    aquecedor, que a toma em EXCLUSIVO.
    """
    if not os.path.exists(caminho):
        return False
    try:
        arquivo = open(caminho, "a+")
    except OSError:
        return False
    try:
        fcntl.flock(arquivo.fileno(), fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        arquivo.close()
    return False


def main(argv=None, deps=None):
    args = _argumentos(argv)
    deps = deps or dependencias_reais()
    if deps is None and aquecimento_em_voo():
        print("check-edge-frescor: aquecimento de borda em voo (%s) — medicao INCONCLUSIVA."
              % LOCK_AQUECIMENTO, file=sys.stderr)
        print("  As duas sondam o mesmo canal: medido em 2026-09-10, a passada concorrente",
              file=sys.stderr)
        print("  deu 521 erros de resolucao de nome aqui e 780 falhas de conexao la, e ZERO",
              file=sys.stderr)
        print("  nos dois quando rodaram separadas. Espere o aquecimento sair e repita.",
              file=sys.stderr)
        return 2
    deps = deps or dependencias_reais()
    agora = deps["agora"]()
    inicio = time.monotonic()

    try:
        revisoes = deps["ler_revisoes"]()
        manifesto = deps["ler_manifesto"]()
    except (OSError, ValueError) as erro:
        print("check-edge-frescor: não consigo medir — %s" % erro, file=sys.stderr)
        return 2
    if not revisoes or not manifesto:
        print("check-edge-frescor: não consigo medir — ledger de revisão ou manifesto vazio", file=sys.stderr)
        return 2

    if args.desde_ledger is not None:
        comparavel, motivo = formula_comparavel(args.desde_ledger, deps["ler_texto"])
        if not comparavel:
            print("check-edge-frescor: não consigo medir — %s" % motivo, file=sys.stderr)
            return 2
        try:
            snapshot = deps["ler_ledger_de"](args.desde_ledger)
        except (OSError, ValueError) as erro:
            print("check-edge-frescor: não consigo medir — snapshot ilegível: %s" % erro,
                  file=sys.stderr)
            return 2
        if not snapshot:
            print("check-edge-frescor: não consigo medir — snapshot vazio (%s)"
                  % args.desde_ledger, file=sys.stderr)
            return 2
        mudadas, novas, sem_served = rotas_com_bytes_diferentes(snapshot, revisoes)
        # PISO DE VOLUME, e não "maior que zero". Um ledger em que NENHUMA entrada
        # traz served_sha256 devolveria zero mudadas e sairia verde sem ter
        # comparado uma única rota — a mesma armadilha da amostra de dois
        # arquivos. Sem base de comparação o veredito é "não sei", nunca "está
        # fresco".
        comparaveis, _ = served_por_caminho(revisoes)
        if not comparaveis:
            print("check-edge-frescor: não consigo medir — nenhuma entrada do ledger de revisão "
                  "tem served_sha256 (%d sem o campo). Rode tools/generate-page-content-revision "
                  "antes." % sem_served, file=sys.stderr)
            return 2
        rotas = sorted(set(mudadas) | set(novas))
        invalidos = 0
        criterio = {"modo": "desde_ledger",
                    "snapshot": os.path.relpath(os.path.abspath(args.desde_ledger), ROOT),
                    "bytes_mudados": len(mudadas), "rotas_novas": len(novas),
                    "sem_served_sha256": sem_served, "comparaveis": len(comparaveis)}
    elif args.desde_horas is not None:
        desde = agora - dt.timedelta(hours=args.desde_horas)
        rotas, invalidos = rotas_mudadas(revisoes, desde=desde)
        criterio = {"modo": "desde_horas", "horas": args.desde_horas,
                    "desde": desde.isoformat(timespec="seconds"),
                    "ate": agora.isoformat(timespec="seconds")}
    else:
        dia = args.dia or agora.strftime("%Y-%m-%d")
        rotas, invalidos = rotas_mudadas(revisoes, dia=dia)
        criterio = {"modo": "dia", "dia": dia}
    date = agora.strftime("%Y-%m-%d")

    print("critério : %s" % json.dumps(criterio, ensure_ascii=False))
    if args.desde_ledger is not None:
        print("rotas    : %d a conferir (%d com bytes servidos diferentes, %d novas; "
              "%d entrada(s) sem served_sha256, %d comparáveis)"
              % (len(rotas), criterio["bytes_mudados"], criterio["rotas_novas"],
                 criterio["sem_served_sha256"], criterio["comparaveis"]))
    else:
        print("rotas    : %d mudadas (carimbos inválidos: %d)" % (len(rotas), invalidos))

    # JANELA VAZIA NÃO É FRESCOR PROVADO — ver alcance_do_ledger.
    #
    # No modo `--desde-ledger` a pergunta é outra e a resposta vazia é legítima:
    # comparar dois estados do MESMO ledger e não achar diferença é dizer "nenhum
    # byte servido mudou", que é uma medição de verdade. O piso que a protege é o
    # de comparabilidade, aplicado acima (assinatura da fórmula igual e pelo menos
    # uma entrada com served_sha256), não o alcance de um carimbo de data.
    if not rotas and args.desde_ledger is None:
        alcance = alcance_do_ledger(revisoes)
        if alcance is None:
            print("check-edge-frescor: não consigo medir — nenhum carimbo de revisão legível "
                  "no ledger (%d inválido(s))" % invalidos, file=sys.stderr)
            return 2
        fim_do_ledger, ultimo_dia = alcance
        if args.desde_horas is not None:
            janela_alem_do_ledger = desde >= fim_do_ledger
            pedido = criterio["desde"]
        else:
            janela_alem_do_ledger = criterio["dia"] > ultimo_dia
            pedido = criterio["dia"]
        if janela_alem_do_ledger:
            print("check-edge-frescor: não consigo medir — o ledger de revisão alcança até %s "
                  "e a janela pedida começa em %s. Zero rota conferida não é frescor provado; "
                  "rode o produtor (tools/generate-page-content-revision) ou peça a janela que "
                  "o ledger cobre." % (ultimo_dia, pedido), file=sys.stderr)
            return 2
    if len(rotas) > args.max:
        print("check-edge-frescor: %d rotas excedem o teto de %d — a lista é grande demais para "
              "conferir no dia; suba --max de propósito, nunca amostre." % (len(rotas), args.max),
              file=sys.stderr)
        return 2

    deps = dict(deps, manifesto=manifesto)
    purga = {"pedida": args.purgar, "purgadas": 0, "exit": None,
             "invalidadas_origem": 0, "origem_exit": None, "pos_purga_velhas": None,
             "objetos_origem_antes": 0, "objetos_origem_removidos": 0,
             "objetos_origem_restantes": 0, "origem_velha_apos_invalidacao": [],
             "pos_purga_tentativas": 0, "pos_purga_espera_s": None,
             "pos_purga_releitura_s": None}

    if rotas:
        pronta, motivo = deps["origem_pronta"](deps["busca"], deps["dominio"])
        if not pronta:
            print("check-edge-frescor: não consigo medir — %s" % motivo, file=sys.stderr)
            return 2
        resultados = confere(rotas, deps)
    else:
        resultados = []

    velhas = urls_velhas(resultados)
    origem_velha = rotas_origem_velhas(resultados)
    if args.purgar and (velhas or origem_velha):
        _purga_e_releitura(resultados, deps, purga)

    linha = monta_linha(date, criterio, rotas, resultados, invalidos, purga, time.monotonic() - inicio)

    print("conferidas: %d  frescas: %d  velhas na borda: %d (html %d, md %d)  cache de origem velho: %d  "
          "disco≠manifesto: %d  sem manifesto: %d  erros de sonda: %d  %.1fs"
          % (linha["conferidas"], linha["frescas"], linha["velhas_total"],
             linha["velhas_por_canal"]["html"], linha["velhas_por_canal"]["md"],
             linha["origem_cache_velha_total"], linha["disco_diverge_total"],
             linha["sem_manifesto_total"], linha["erros_de_sonda"], linha["duracao_s"]))
    if velhas:
        print("\nVELHAS NA BORDA (%d URL(s)):" % len(velhas))
        for url in velhas:
            print("  " + url)
    if origem_velha:
        print("\nCACHE DE ORIGEM VELHO (%d gêmea(s); purgar só a borda repopularia com o velho):" % len(origem_velha))
        for r in resultados:
            if r["origem"]["classe"] == ORIGEM_VELHA:
                print("  %s  variantes: %s" % (r["origem"]["rota"],
                                               ", ".join(repr(v) for v in r["origem"]["variantes_velhas"])))
    if linha["disco_diverge_total"]:
        print("\nDISCO DIVERGE DO MANIFESTO (defeito de publicação, não purgado):")
        for r in resultados:
            if classe_da_rota(r) == DISCO_DIVERGE:
                print("  %s  (%s)" % (r["path"], r["html"]["classe"]))
    if linha["erros_de_sonda"]:
        print("\nERROS DE SONDA (%d rota(s)):" % linha["erros_de_sonda"])
        for r in resultados:
            for e in r["erros"]:
                print("  %s [%s] %s" % (e["path"], e["canal"], e["erro"]))
    if args.purgar and (velhas or origem_velha):
        print("\npurga: origem exit %s (%d rota(s) invalidada(s); %d objeto(s) na zona, %d "
              "removido(s), %d restante(s)), borda exit %s (%d purgada(s)), velhas após purga: %s "
              "em %s tentativa(s) (esperou %ss, releu em %ss)"
              % (purga["origem_exit"], purga["invalidadas_origem"], purga["objetos_origem_antes"],
                 purga["objetos_origem_removidos"], purga["objetos_origem_restantes"],
                 purga["exit"], purga["purgadas"], purga["pos_purga_velhas"],
                 purga["pos_purga_tentativas"], purga["pos_purga_espera_s"],
                 purga["pos_purga_releitura_s"]))

    if args.gravar:
        try:
            gravou = grava(linha, deps["saida"])
        except OSError as erro:
            print("check-edge-frescor: falha gravando %s: %s" % (deps["saida"], erro), file=sys.stderr)
            return 2
        print("\nledger: %s (%s)" % (os.path.relpath(deps["saida"], ROOT), "gravada" if gravou else "idêntica"))
    print("\n" + json.dumps(linha, ensure_ascii=False, sort_keys=True))

    if linha["erros_de_sonda"]:
        return 2
    if args.purgar and (velhas or origem_velha):
        # Cada termo é um jeito diferente de a purga NÃO ter acontecido, e os
        # dois do meio são novos: objeto que sobrou na zona e gêmea que o nginx
        # continua servindo velha depois da invalidação. Antes, os dois passavam
        # por "origem exit 0" e viravam `invalidadas_origem` — a contagem de
        # intenção que este conserto substitui.
        purga_falhou = (
            (velhas and purga["exit"] != 0)
            or (origem_velha and purga["origem_exit"] != 0)
            or purga["objetos_origem_restantes"]
            or purga["origem_velha_apos_invalidacao"])
        if purga_falhou or purga["pos_purga_velhas"]:
            return 2
    if linha["velhas_total"] or linha["disco_diverge_total"] or linha["origem_cache_velha_total"]:
        return 1
    return 0


