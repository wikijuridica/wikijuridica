def le_texto(caminho):
    """Conteudo do arquivo, ou "" quando ele nao existe ou nao se le.

    Devolver "" em vez de levantar deixa a decisao com quem chama: aqui a
    ausencia da assinatura da formula NAO e "seguir em frente", e sim recusa
    explicita em `formula_comparavel`.
    """
    try:
        with open(caminho, encoding="utf-8") as arquivo:
            return arquivo.read()
    except OSError:
        return ""


def le_jsonl(caminho):
    with open(caminho, encoding="utf-8") as fh:
        for linha in fh:
            linha = linha.strip()
            if linha:
                yield json.loads(linha)


def intervalo_do_carimbo(carimbo):
    """[início, fim) em UTC do que o carimbo cobre; None se não for carimbo.

    Dia puro cobre o dia inteiro — é a forma histórica do ledger (287 das 288
    rotas recentes em 2026-09-09) e de uma publicação antiga não se sabe a hora.
    Instante cobre só o instante.
    """
    texto = str(carimbo or "")
    m = CARIMBO_INSTANTE.match(texto)
    if m:
        inicio = dt.datetime(*(int(g) for g in m.groups()), tzinfo=dt.timezone.utc)
        return inicio, inicio
    m = CARIMBO_DIA.match(texto)
    if m:
        inicio = dt.datetime(*(int(g) for g in m.groups()), tzinfo=dt.timezone.utc)
        return inicio, inicio + dt.timedelta(days=1)
    return None


def rotas_mudadas(entradas, dia=None, desde=None):
    """Caminhos cujo carimbo cai no dia (`dia`) ou toca a janela [`desde`, ∞).

    Devolve (caminhos ordenados, carimbos inválidos). Uma rota com carimbo que
    não se lê não entra em lista nenhuma e é contada, nunca ignorada em silêncio.
    """
    escolhidas = []
    invalidos = 0
    for entrada in entradas:
        caminho = entrada.get("path")
        if not caminho:
            continue
        intervalo = intervalo_do_carimbo(entrada.get("revised_on"))
        if intervalo is None:
            invalidos += 1
            continue
        inicio, fim = intervalo
        if dia is not None:
            if str(entrada.get("revised_on"))[:10] == dia:
                escolhidas.append(caminho)
        elif desde is not None:
            # Toca a janela: o fim do que o carimbo cobre é posterior ao começo dela.
            if fim >= desde:
                escolhidas.append(caminho)
    return sorted(set(escolhidas)), invalidos


def alcance_do_ledger(entradas):
    """Até onde o ledger de revisão fala: (fim do intervalo coberto, último dia).

    Existe para separar duas coisas que o gate confundia e que têm verdades
    opostas. Nas duas, `rotas_mudadas` devolve lista vazia:

      - NADA MUDOU no dia pedido — o ledger alcança o dia e não tem rota nele.
        Verde legítimo.
      - O LEDGER NÃO ALCANÇA o dia pedido — o produtor
        (`generate-page-content-revision`) ainda não rodou, ou carimbou com a
        data de ontem. Aqui não há frescor provado nenhum: o gate não conferiu
        rota alguma.

    Medido em 2026-09-11: logo depois de um `deploy-publico` que mudou 902
    páginas, `check-edge-frescor` sem argumento pediu o dia de HOJE em UTC
    (2026-09-11), o ledger carimbava `revised_on: 2026-09-10`, e a saída foi
    `rotas mudadas 0 · conferidas 0 · OK`. Verde com ZERO conferidas. Rodado com
    `--dia 2026-09-10`, o mesmo gate conferiu 1.520 rotas e achou 1.520 frescas.
    É a mesma família do piso de volume dos testes por amostra: "maior que zero"
    prova que o instrumento executou, não que ele mediu alguma coisa.

    Devolve None quando nenhum carimbo se lê — e aí quem chama também não pode
    dizer verde, pelo mesmo motivo.
    """
    fim = None
    ultimo_dia = None
    for entrada in entradas:
        intervalo = intervalo_do_carimbo(entrada.get("revised_on"))
        if intervalo is None:
            continue
        if fim is None or intervalo[1] > fim:
            fim = intervalo[1]
            ultimo_dia = str(entrada.get("revised_on"))[:10]
    if fim is None:
        return None
    return fim, ultimo_dia


