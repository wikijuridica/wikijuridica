def origem_pronta(busca_fn, dominio):
    """(True, "") se nginx e Go respondem 200 em `/readyz`; senão (False, motivo).

    Os dois, porque a gêmea é comparada com o Go e a borda recebe do nginx:
    houve 13 min em que o Go respondia e o proxy não.
    """
    for nome, base in (("nginx", ORIGEM), ("go", GO)):
        try:
            status, _, _ = busca_fn(base + "/readyz", dict(CABECALHOS_BORDA, Host=dominio), 8)
        except FalhaDeSonda as erro:
            return False, "%s inalcançável: %s" % (nome, erro)
        if status != 200:
            return False, "%s /readyz respondeu %d" % (nome, status)
    return True, ""


def dependencias_reais():
    with open(SITE, encoding="utf-8") as fh:
        base = json.load(fh)["base_url"].rstrip("/")
    return {
        "base": base,
        "dominio": base.split("//", 1)[-1],
        "busca": busca,
        "sha_disco": sha_disco,
        "limitador": Limitador(RPS),
        "agora": lambda: dt.datetime.now(dt.timezone.utc),
        "ler_revisoes": lambda: list(le_jsonl(LEDGER_REVISAO)),
        "ler_manifesto": lambda: manifesto_por_caminho(le_jsonl(MANIFESTO)),
        "ler_ledger_de": lambda caminho: list(le_jsonl(caminho)),
        "ler_texto": le_texto,
