#!/bin/sh
# Empacota as habilidades com material de apoio e grava o manifesto de digests.
# Use --conferir para só verificar, sem escrever.
#
# 2026-08-29: passa a rodar SUPERVISIONADO. Este wrapper nasceu em ad7c1271
# (2026-08-20) ja invocando o toolchain direto, forma que passa ao largo de
# budget, stop_condition, cache e artifact_claim — e ele GRAVA artefato servido
# ao publico: content/agent-skills/dist/*.tar.gz e o .zip do plugin
# (cmd/generate-agent-skill-archives/main.go:70,129). O claim e EXPLICITO
# porque o stem "agent_skill_archives" nao resolve nenhum candidato material em
# data/* (medido: 0 candidatos), e run-generate-supervised recusa wrapper sem
# claim. O manifesto e o ledger de digests de TODOS os archives: ele muda
# sempre que qualquer .tar.gz muda, entao um caminho basta. Ele acompanha o
# --raiz default do gerador (content/agent-skills).
# Custo medido em 2026-08-29: 0,588 s em --conferir, folgado no budget default
# de 120 s do supervisor.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-content/agent-skills/manifesto.json}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-agent-skill-archives}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate-agent-skill-archives "$@"
