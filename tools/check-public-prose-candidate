#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: check-public-prose-candidate [flags]

Runs the public-prose-candidate check through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
exec "$ROOT/tools/run-check" public-prose-candidate "$@"
