#!/usr/bin/env python3
"""measure-judicial-demand — quanto litígio real existe sobre cada tema, e o que o acervo cobre.

POR QUE EXISTE: o portal precisa decidir que conteúdo escrever e refinar, e não
tem sistema de conversão. O titular decidiu não usar Search Console, e a pesquisa
de mercado não achou dado brasileiro confiável de volume de busca por área
jurídica. A priorização vinha sendo por severidade de defeito — que diz o que
está errado, não o que dá retorno.

O DATAJUD RESOLVE ISSO por um ângulo melhor que volume de busca: ele diz quantos
PROCESSOS existem sobre cada assunto. Quem entra na Justiça já passou do estágio
de dúvida — é demanda comprovada, não interesse. E é dado oficial do CNJ,
publicado sob a Portaria 160/2020.

Só metadados: a API entrega `assuntos`, `classe`, `orgaoJulgador`, `movimentos` e
`nivelSigilo`. NÃO entrega partes, nem peças, nem conteúdo de decisão — o que
mantém a coleta longe de dado pessoal, e é por isso que o registro da fonte no
projeto a marca como `metadata_only`. Esta ferramenta agrega e descarta; não
guarda processo nenhum.

Chave pública divulgada pelo próprio CNJ em datajud-wiki.cnj.jus.br/api-publica/acesso.
Não é credencial privada; o CNJ pode trocá-la a qualquer momento.

O QUE ELE ENTREGA: por assunto, o volume de processos e quantas páginas do
acervo tratam do tema — as duas colunas que decidem onde investir esforço
editorial.

Uso:
    tools/measure-judicial-demand
    tools/measure-judicial-demand --tribunal tjrj
    tools/measure-judicial-demand --top 40
"""
import argparse
import datetime
import json
import os
import re
import sys
import unicodedata
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
PAGES = os.path.join(ROOT, "content/pages.json")
EVIDENCIA = os.path.join(ROOT, "data/research/judicial_demand_by_subject.json")

API = "https://api-publica.datajud.cnj.jus.br/api_publica_%s/_search"
CHAVE_PUBLICA = "cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw=="

# Identidade única de saída (CLAUDE.md §11 e internal/wikijuridicabot): quem
# recebe a requisição precisa saber quem somos, onde nos documentamos e para
# que estamos coletando. O prefixo "Mozilla/5.0 (compatible;" é a forma que os
# crawlers legítimos usam para atravessar WAF — o nome real vem em seguida.
#
# MEDIDO em 2026-09-05 contra api-publica.datajud.cnj.jus.br (POST _search,
# size 0, chave pública do CNJ): HTTP 200 e 191 bytes com este User-Agent, o
# mesmo resultado do antigo "wikijuridica-demanda/1.0".
USER_AGENT = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
              "+https://wikijuridica.com.br/bot/; observacao-de-demanda)")

# Assuntos genéricos demais para orientar conteúdo: "DIREITO CIVIL" não é um
# tema de página, é um ramo inteiro. Ficam de fora do ranking para não empurrar
# o topo com ruído.
GENERICOS = {
    "direito civil", "direito penal", "direito tributario", "direito do trabalho",
    "direito processual civil", "direito processual penal", "direito administrativo",
    "direito previdenciario", "direito do consumidor", "direito civil",
    "objetos de cartas precatorias civeis/de ordem", "assunto principal",
}


def normalizar(texto):
    sem_acento = "".join(
        c for c in unicodedata.normalize("NFKD", texto or "")
        if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9 ]+", " ", sem_acento.lower()).strip()


def consultar(tribunal, tamanho, timeout=60.0):
    corpo = json.dumps({
        "size": 0,
        "aggs": {"assuntos": {"terms": {"field": "assuntos.nome.keyword", "size": tamanho}}},
    }).encode()
    pedido = urllib.request.Request(
        API % tribunal, data=corpo, method="POST",
        headers={
            "Authorization": "APIKey " + CHAVE_PUBLICA,
            "Content-Type": "application/json",
            "User-Agent": USER_AGENT,
        })
    with urllib.request.urlopen(pedido, timeout=timeout) as resposta:
        return json.loads(resposta.read().decode("utf-8"))


def vocabulario_das_paginas():
    """Palavras significativas do título/h1 de cada página, por área."""
    with open(PAGES, encoding="utf-8") as handle:
        paginas = json.load(handle)
    itens = []
    for pagina in paginas:
        if not pagina.get("unique_intent_id"):
            continue
        texto = normalizar(" ".join([
            pagina.get("title") or "", pagina.get("heading") or "",
            (pagina.get("path") or "").replace("-", " ").replace("/", " "),
        ]))
        itens.append((pagina.get("path"), set(p for p in texto.split() if len(p) > 3)))
    return itens


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--tribunal", default="tjsp",
                        help="alias do tribunal na API (tjsp, tjrj, tjmg, trf3, stj...)")
    parser.add_argument("--top", type=int, default=30)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--cache", action="store_true",
                        help="reprocessa a ultima medicao gravada, sem chamar a API")
    args = parser.parse_args()

    if args.cache:
        if not os.path.exists(EVIDENCIA):
            print("sem medicao gravada em %s" % EVIDENCIA, file=sys.stderr)
            return 1
        with open(EVIDENCIA, encoding="utf-8") as handle:
            anterior = json.load(handle)
        dados = {"aggregations": {"assuntos": {"buckets": [
            {"key": s["assunto"], "doc_count": s["processos"]}
            for s in anterior.get("subjects", [])]}}}
        args.tribunal = anterior.get("tribunal", args.tribunal)
    else:
      try:
        dados = consultar(args.tribunal, max(args.top * 3, 60))
      except urllib.error.HTTPError as erro:
        print("measure-judicial-demand: API respondeu HTTP %s" % erro.code, file=sys.stderr)
        if erro.code == 401:
            print("  a chave publica do CNJ pode ter sido rotacionada; confira em",
                  "datajud-wiki.cnj.jus.br/api-publica/acesso", file=sys.stderr)
        if erro.code == 429:
            print("  limite de requisicoes: use --cache para reprocessar a ultima medicao",
                  file=sys.stderr)
        return 1
      except Exception as erro:
        print("measure-judicial-demand: %s" % str(erro)[:120], file=sys.stderr)
        return 1

    baldes = (dados.get("aggregations", {}).get("assuntos", {}) or {}).get("buckets", [])
    if not baldes:
        print("nenhum assunto retornado pela API.", file=sys.stderr)
        return 1

    paginas = vocabulario_das_paginas()
    linhas = []
    for balde in baldes:
        assunto = balde["key"]
        if normalizar(assunto) in GENERICOS:
            continue
        termos = set(p for p in normalizar(assunto).split() if len(p) > 3)
        if not termos:
            continue
        # COBERTURA PELO TERMO DISTINTIVO, não pela maioria dos termos.
        #
        # A primeira versão exigia 60% dos termos do assunto e reportou "IPTU:
        # 7,2 milhões de processos, ZERO página". Falso: o acervo tem 39 páginas
        # de IPTU. O nome oficial do assunto é "IPTU/ Imposto Predial e
        # Territorial Urbano", e nenhuma página escreve "predial territorial
        # urbano" — elas dizem "IPTU". Exigir a maioria dos termos de um rótulo
        # burocrático mede a burocracia, não o tema.
        #
        # Agora conta o termo mais RARO do assunto (o que o identifica), com
        # descarte das palavras genéricas de vocabulário jurídico.
        vagos = {"imposto", "sobre", "servicos", "contrato", "contratos", "acao",
                 "civel", "civeis", "ordem", "demais", "outros", "geral",
                 "direito", "processo", "processual", "pena", "danos", "dano"}
        distintivos = termos - vagos or termos
        cobertura = [caminho for caminho, vocab in paginas
                     if distintivos & vocab]
        linhas.append({
            "assunto": assunto,
            "processos": balde["doc_count"],
            "paginas_no_acervo": len(cobertura),
            "exemplos": sorted(cobertura)[:3],
        })
        if len(linhas) >= args.top:
            break

    print("=== DEMANDA JUDICIAL REAL x COBERTURA DO ACERVO ===")
    print("fonte    : API Pública Datajud/CNJ (%s), metadados agregados" % args.tribunal.upper())
    print("leitura  : processo ajuizado é demanda COMPROVADA — quem litiga já passou da dúvida")
    print()
    print("%-52s %11s %8s" % ("ASSUNTO", "PROCESSOS", "PÁGINAS"))
    for linha in linhas:
        marca = ""
        if linha["processos"] >= 500000 and linha["paginas_no_acervo"] == 0:
            marca = "  <-- MUITO LITÍGIO, ZERO PÁGINA"
        elif linha["processos"] >= 500000 and linha["paginas_no_acervo"] < 3:
            marca = "  <-- cobertura rasa"
        print("%-52s %11d %8d%s" % (linha["assunto"][:52], linha["processos"],
                                    linha["paginas_no_acervo"], marca))

    lacunas = [l for l in linhas if l["processos"] >= 300000 and l["paginas_no_acervo"] == 0]
    if lacunas:
        print("\n--- maior oportunidade: litígio alto e nenhuma página ---")
        for linha in lacunas[:10]:
            print("  %9d processos  %s" % (linha["processos"], linha["assunto"]))

    registro = {
        "schema_version": "judicial_demand_v1",
        "measured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "source": "api_publica_datajud_cnj",
        "source_scope": "metadados_agregados_sem_dado_pessoal",
        "tribunal": args.tribunal,
        "subjects": linhas,
    }
    os.makedirs(os.path.dirname(EVIDENCIA), exist_ok=True)
    with open(EVIDENCIA, "w", encoding="utf-8") as handle:
        json.dump(registro, handle, ensure_ascii=False, indent=1, sort_keys=True)
    print("\nevidência: %s" % os.path.relpath(EVIDENCIA, ROOT))

    if args.json:
        print(json.dumps(registro, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
