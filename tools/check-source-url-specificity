#!/usr/bin/env python3
"""check-source-url-specificity — protege o que já está bom.

READ-ONLY. Não corrige nada, e é de propósito: aqui NÃO HÁ DEFEITO A CORRIGIR.

A PREMISSA QUE ESTA FERRAMENTA REFUTA. O plano de superfície de bots supunha que
as fontes oficiais do acervo apontassem para a home do órgão, deixando ao leitor
a tarefa de achar o documento. Medido em 2026-08-26 sobre `content/pages.json`:
das 24.388 fontes publicadas, **2 apontam para a raiz do host** — 0,01%. As
outras 24.386 apontam para um documento ou para um dispositivo dentro dele.

Como não há o que consertar, o trabalho útil é impedir a REGRESSÃO: um gerador
novo que passe a gravar a home do órgão, um lote que troque a URL profunda pela
genérica, uma fonte que perca o fragmento do dispositivo. Sem piso medido, essa
queda seria invisível — nenhuma outra medição do repositório olha para isto.

AS TRÊS CLASSES, e por que são três e não uma:

  dispositivo  a URL leva ao artigo (fragmento "#art26"). É o melhor que uma
               fonte pode ser: o leitor cai na regra citada, não no diploma
               inteiro. 34,9% hoje.
  documento    a URL leva ao documento (extensão .htm/.pdf/…). 43,4%.
  raiz         a URL leva só ao host. É o defeito que a premissa supunha
               generalizado e que praticamente não existe. 0,01%.

O piso de cada uma vem da MEDIÇÃO, com folga deliberada para não reprovar por
ruído de um lote pequeno — o alarme é para queda estrutural, não para variação.

REPRODUÇÃO INDEPENDENTE (a mesma conta, em uma linha):
    python3 -c "import json;from urllib.parse import urlsplit;\
p=json.load(open('content/pages.json'));\
u=[s['source_url'] for x in p for s in (x.get('source_provenance') or [])];\
print(sum(1 for v in u if not urlsplit(v).path.strip('/')), 'de', len(u))"

Uso:
    tools/check-source-url-specificity
    tools/check-source-url-specificity --json
"""
from __future__ import annotations

import argparse
import collections
import json
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent.parent
PAGES_JSON = ROOT / "content/pages.json"

EXTENSAO_DE_DOCUMENTO = re.compile(r"\.(html?|pdf|asp|jsp|php|xml|txt)$", re.IGNORECASE)

# Pisos medidos em 2026-08-26, com folga. A folga não é generosidade: um lote
# novo de 200 páginas de uma fonte que só publica em HTML sem extensão move o
# percentual em décimos, e reprovar por isso ensinaria a ignorar o alarme.
PISOS = {
    "aponta_documento_ou_dispositivo": 74.0,   # medido 78,3%
    "aponta_dispositivo_exato": 30.0,          # medido 34,9%
    "paginas_com_todas_as_fontes_especificas": 95.0,  # medido 99,98%
}
TETO_RAIZ_PCT = 1.0  # medido 0,01%


def classifica(url: str) -> str:
    partes = urlsplit(url)
    caminho = partes.path.strip("/")
    if not caminho and not partes.query:
        return "raiz"
    if partes.fragment:
        return "dispositivo"
    if EXTENSAO_DE_DOCUMENTO.search(partes.path):
        return "documento"
    if partes.query:
        return "consulta_ou_listagem"
    if "/" not in caminho:
        return "secao_unica"
    return "caminho_sem_extensao"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    with open(PAGES_JSON, encoding="utf-8") as handle:
        paginas = json.load(handle)

    classes: collections.Counter[str] = collections.Counter()
    total = 0
    paginas_com_fonte = 0
    paginas_todas_especificas = 0
    exemplos_raiz: list[str] = []

    for pagina in paginas:
        fontes = pagina.get("source_provenance") or []
        urls = [(f.get("source_url") or "").strip() for f in fontes]
        urls = [u for u in urls if u]
        if not urls:
            continue
        paginas_com_fonte += 1
        todas = True
        for url in urls:
            total += 1
            classe = classifica(url)
            classes[classe] += 1
            if classe == "raiz":
                todas = False
                if len(exemplos_raiz) < 10:
                    exemplos_raiz.append(f"{pagina.get('path')} -> {url}")
        if todas:
            paginas_todas_especificas += 1

    if total == 0:
        print("nenhuma fonte publicada: nada a medir", file=sys.stderr)
        return 2

    def pct(n: int, base: int = 0) -> float:
        return 100.0 * n / (base or total)

    medidas = {
        "aponta_documento_ou_dispositivo": pct(classes["documento"] + classes["dispositivo"]),
        "aponta_dispositivo_exato": pct(classes["dispositivo"]),
        "paginas_com_todas_as_fontes_especificas": pct(paginas_todas_especificas, paginas_com_fonte),
    }
    raiz_pct = pct(classes["raiz"])

    falhas: list[str] = []
    for chave, piso in PISOS.items():
        if medidas[chave] < piso:
            falhas.append(f"{chave}: {medidas[chave]:.2f}% abaixo do piso {piso:.1f}%")
    if raiz_pct > TETO_RAIZ_PCT:
        falhas.append(f"fontes apontando a raiz do host: {raiz_pct:.2f}% acima do teto {TETO_RAIZ_PCT:.1f}%")

    resultado = {
        "ferramenta": "check-source-url-specificity",
        "fontes_publicadas": total,
        "paginas_com_fonte": paginas_com_fonte,
        "classes": dict(sorted(classes.items())),
        "medidas_pct": {k: round(v, 2) for k, v in medidas.items()},
        "raiz_pct": round(raiz_pct, 4),
        "pisos": PISOS,
        "teto_raiz_pct": TETO_RAIZ_PCT,
        "falhas": falhas,
        "exemplos_raiz": exemplos_raiz,
    }

    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=1))
        return 1 if falhas else 0

    print("check-source-url-specificity — READ-ONLY\n")
    print(f"fontes publicadas: {total} em {paginas_com_fonte} páginas")
    for classe, n in sorted(classes.items(), key=lambda kv: -kv[1]):
        print(f"  {classe:22s} {n:6d}  {pct(n):5.2f}%")
    print()
    for chave, valor in medidas.items():
        print(f"{chave}: {valor:.2f}% (piso {PISOS[chave]:.1f}%)")
    print(f"fontes apontando a raiz do host: {raiz_pct:.4f}% (teto {TETO_RAIZ_PCT:.1f}%)")
    if exemplos_raiz:
        print("\nas que apontam a raiz:")
        for exemplo in exemplos_raiz:
            print("  " + exemplo)
    if falhas:
        print("\nREPROVADO:")
        for falha in falhas:
            print("  - " + falha)
        return 1
    print("\nOK: nenhuma regressão abaixo dos pisos medidos.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
