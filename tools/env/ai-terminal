#!/usr/bin/env bash
set -euo pipefail

export COLORTERM=truecolor
export CLICOLOR=1
unset NO_COLOR
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/bin:$HOME/go/bin:$HOME/.cargo/bin:/usr/local/go/bin:/snap/bin:$PATH"

launcher="$HOME/start-ai-terminal.sh"
config="$HOME/.config/wezterm/wezterm.lua"
wezterm_bin="${WEZTERM_BIN:-}"

if [ -z "$wezterm_bin" ] && command -v wezterm >/dev/null 2>&1; then
  wezterm_bin="$(command -v wezterm)"
fi

if [ -n "$wezterm_bin" ] && [ -x "$wezterm_bin" ]; then
  exec "$wezterm_bin" --config-file "$config" start --always-new-process --class AI-Terminal --workspace ai-terminal "$launcher" "$@"
fi

if command -v kitty >/dev/null 2>&1; then
  exec kitty "$launcher" "$@"
fi

if command -v alacritty >/dev/null 2>&1; then
  exec alacritty -e "$launcher" "$@"
fi

exec xfce4-terminal --command "$launcher $*"
