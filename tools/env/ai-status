#!/usr/bin/env bash
# ai-status — linha compacta de saturacao para a status-bar do tmux.
#
# Chamado pelo tmux a cada status-interval (30s). Precisa ser BARATO: le /proc
# direto, sem `ps`, sem pipeline, sem subshell por campo. Um fork por ciclo.
# Saida: "RAM 21%  LD 1.02  cc 2  ag 1"   (cc = processos claude, ag = agentes)
set -uo pipefail

mem_total=0; mem_avail=0
while read -r key val _; do
  case "$key" in
    MemTotal:)     mem_total=$val ;;
    MemAvailable:) mem_avail=$val; break ;;
  esac
done < /proc/meminfo
mem_pct=0
[ "$mem_total" -gt 0 ] && mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))

read -r l1 _ < /proc/loadavg

# Contagem de processos claude sem `ps`: varre /proc/*/comm (barato, sem fork).
cc=0
for c in /proc/[0-9]*/comm; do
  [ -r "$c" ] || continue
  read -r name < "$c" 2>/dev/null || continue
  [ "$name" = claude ] && cc=$(( cc + 1 ))
done

# Agentes ATIVOS. Nao use /tmp/claude-agents-running: aqueles .pid sao gravados
# pelo hook com o PID do PROPRIO HOOK (que morre em seguida), entao o numero nao
# tem relacao com agente nenhum — medido em 2026-07-28: 1 arquivo apontando para
# PID morto enquanto 13 agentes trabalhavam. Alem disso subagente do Claude Code
# NAO e processo separado (roda dentro do mesmo processo), logo contar processo
# jamais funcionaria. A verdade observavel e o transcript: agente vivo escreve no
# proprio .jsonl o tempo todo. Custo medido: 10ms.
ag=$(find "$HOME/.claude/projects" -path '*/subagents/*' -name 'agent-*.jsonl' -mmin -2 2>/dev/null | wc -l)

# Tokens do dia. A varredura completa custa ~190ms — caro demais para pagar a
# cada refresh da barra e a cada cliente tmux conectado. Entao a barra le um
# arquivo de cache e dispara a atualizacao EM BACKGROUND quando ele envelhece:
# a barra nunca bloqueia, e o numero fica no maximo TTL segundos atrasado.
TOKCACHE="$HOME/.claude/ai-terminal/tokens.line"
# 180 s, nao 45 s. Consumo de token e um numero para orientar decisao ao longo do
# turno — ninguem decide nada com a diferenca de 45 s. A varredura custa ~250 ms
# sobre 4.208 arquivos, entao cada ciclo desnecessario e trabalho jogado fora.
TOKTTL=180
tok=''
if [ -r "$TOKCACHE" ]; then
  tok="$(cat "$TOKCACHE" 2>/dev/null)"
  age=$(( $(date +%s) - $(stat -c %Y "$TOKCACHE" 2>/dev/null || echo 0) ))
else
  age=999999
fi
if [ "$age" -ge "$TOKTTL" ] && command -v ai-tokens >/dev/null 2>&1; then
  mkdir -p "$(dirname "$TOKCACHE")"
  # Lock por diretorio: varios clientes tmux atualizando junto seria desperdicio puro.
  if mkdir "$TOKCACHE.lock" 2>/dev/null; then
    ( ai-tokens --oneline > "$TOKCACHE.tmp" 2>/dev/null &&
      mv -f "$TOKCACHE.tmp" "$TOKCACHE"
      rmdir "$TOKCACHE.lock" 2>/dev/null ) >/dev/null 2>&1 &
  fi
fi

# Cor so no campo que importa: RAM e o recurso que derruba a maquina.
if   [ "$mem_pct" -ge 90 ]; then col='#[fg=#ef2929,bold]'
elif [ "$mem_pct" -ge 70 ]; then col='#[fg=#fce94f]'
else                             col='#[fg=#8ae234]'
fi

printf '%sRAM %d%%#[default] LD %s cc %d ag %d' "$col" "$mem_pct" "$l1" "$cc" "$ag"
[ -n "$tok" ] && printf ' #[fg=#729fcf]%s#[default]' "$tok"
