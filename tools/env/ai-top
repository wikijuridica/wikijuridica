#!/usr/bin/env bash
# ai-top — painel de saturacao do AI Terminal (janela `mon` da sessao).
#
# POR QUE
#   Rodar muitos agentes so e seguro se a saturacao for VISIVEL. Em 2026-07-15 a
#   maquina congelou 2x em 7h por exaustao de RAM+swap sem ninguem enxergar a
#   subida. Este painel mostra, em uma tela, o que decide se cabe mais agente:
#   RAM/swap, load por core, processos Claude e o peso de cada um.
#
# CUSTO
#   Leitura direta de /proc + um `ps` por ciclo (default 5s). Sem `top`, sem
#   watch, sem subshell por linha — o painel nao pode competir por CPU com o
#   trabalho que ele monitora.
#
# USO
#   ai-top [INTERVALO_SEGUNDOS]     # default 5
set -uo pipefail

interval="${1:-5}"
[[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 1 ] || interval=5

CORES=$(nproc 2>/dev/null || echo 1)
B='\033[1m'; D='\033[2m'; R='\033[0;31m'; Y='\033[1;33m'; G='\033[0;32m'; C='\033[0;36m'; N='\033[0m'

bar() { # valor_pct largura
  local pct="$1" width="${2:-24}" filled i out=''
  filled=$(( pct * width / 100 ))
  [ "$filled" -gt "$width" ] && filled="$width"
  [ "$filled" -lt 0 ] && filled=0
  for ((i=0;i<filled;i++)); do out+='#'; done
  for ((i=filled;i<width;i++)); do out+='.'; done
  printf '%s' "$out"
}

color_for() { # pct
  if   [ "$1" -ge 90 ]; then printf '%b' "$R"
  elif [ "$1" -ge 70 ]; then printf '%b' "$Y"
  else printf '%b' "$G"; fi
}

trap 'printf "\033[?25h\n"; exit 0' INT TERM
printf '\033[?25l'  # esconde cursor

while :; do
  # --- memoria (kB, direto do /proc — sem fork) ---
  mem_total=0; mem_avail=0; swap_total=0; swap_free=0
  while read -r key val _; do
    case "$key" in
      MemTotal:)     mem_total=$val ;;
      MemAvailable:) mem_avail=$val ;;
      SwapTotal:)    swap_total=$val ;;
      SwapFree:)     swap_free=$val ;;
    esac
  done < /proc/meminfo
  mem_used=$(( mem_total - mem_avail ))
  mem_pct=$(( mem_total > 0 ? mem_used * 100 / mem_total : 0 ))
  swap_used=$(( swap_total - swap_free ))
  swap_pct=$(( swap_total > 0 ? swap_used * 100 / swap_total : 0 ))

  read -r l1 l5 l15 _ < /proc/loadavg
  load_pct=$(awk -v l="$l1" -v c="$CORES" 'BEGIN{p=l/c*100; if(p>999)p=999; printf "%d", p}')

  # --- processos claude: contagem e RSS total (um unico ps) ---
  claude_n=0; claude_rss=0; claude_list=''
  while read -r pid rss etimes args; do
    [ -n "${pid:-}" ] || continue
    claude_n=$(( claude_n + 1 ))
    claude_rss=$(( claude_rss + rss ))
    claude_list+="$(printf '%8s %7.2fG %8ss  %s\n' "$pid" "$(awk -v r="$rss" 'BEGIN{printf "%.2f", r/1048576}')" "$etimes" "${args:0:40}")"$'\n'
  done < <(ps -u "$(id -u)" -o pid=,rss=,etimes=,args= 2>/dev/null |
             grep -E 'share/claude/versions|/\.local/bin/claude' | grep -v grep |
             sort -k2 -rn | head -8)

  # Agentes ativos pelo transcript, nao por PID: subagente do Claude Code roda
  # DENTRO do processo principal (nao ha processo por agente), e os .pid em
  # /tmp/claude-agents-running guardam o PID do proprio hook, ja morto quando o
  # agente comeca a trabalhar. Transcript com escrita recente = agente vivo.
  agents_n=$(find "$HOME/.claude/projects" -path '*/subagents/*' -name 'agent-*.jsonl' -mmin -2 2>/dev/null | wc -l)

  tmux_sessions=0; tmux_windows=0
  if command -v tmux >/dev/null 2>&1; then
    tmux_sessions=$(tmux list-sessions 2>/dev/null | wc -l)
    tmux_windows=$(tmux list-windows -a 2>/dev/null | wc -l)
  fi

  procs=$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)

  # --- render ---
  printf '\033[H\033[2J'
  printf "${B}  AI TERMINAL — saturacao${N}   ${D}%s   %s cores${N}\n\n" "$(date '+%H:%M:%S')" "$CORES"

  printf "  RAM   %b%s%b  %5.1f/%5.1f GB  %3d%%\n" \
    "$(color_for "$mem_pct")" "$(bar "$mem_pct" 28)" "$N" \
    "$(awk -v v="$mem_used" 'BEGIN{printf "%.1f", v/1048576}')" \
    "$(awk -v v="$mem_total" 'BEGIN{printf "%.1f", v/1048576}')" "$mem_pct"

  printf "  SWAP  %b%s%b  %5.1f/%5.1f GB  %3d%%\n" \
    "$(color_for "$swap_pct")" "$(bar "$swap_pct" 28)" "$N" \
    "$(awk -v v="$swap_used" 'BEGIN{printf "%.1f", v/1048576}')" \
    "$(awk -v v="$swap_total" 'BEGIN{printf "%.1f", v/1048576}')" "$swap_pct"

  printf "  LOAD  %b%s%b  %s / %s / %s\n\n" \
    "$(color_for "$load_pct")" "$(bar "$load_pct" 28)" "$N" "$l1" "$l5" "$l15"

  printf "  ${C}claude${N} %-3s processos  %6.2f GB total   ${C}agentes${N} %-4s   ${C}tmux${N} %s sess / %s jan   ${C}procs${N} %s\n\n" \
    "$claude_n" "$(awk -v r="$claude_rss" 'BEGIN{printf "%.2f", r/1048576}')" "$agents_n" \
    "$tmux_sessions" "$tmux_windows" "$procs"

  if [ -n "$claude_list" ]; then
    printf "  ${D}%8s %8s %9s  %s${N}\n" PID RSS IDADE PROCESSO
    printf '%s' "$claude_list" | sed 's/^/  /'
  fi

  # Alertas acionaveis: o ponto em que o dono decide segurar a frota.
  printf '\n'
  if [ "$mem_pct" -ge 90 ] || { [ "$swap_pct" -ge 50 ] && [ "$mem_pct" -ge 80 ]; }; then
    printf "  ${R}${B}ALERTA${N} RAM/swap no limite — nao lance nova onda de agentes.\n"
    printf "  ${D}  fechar sessao ociosa:  ai-pane list / ai-pane killall-agents${N}\n"
  elif [ "$mem_pct" -ge 70 ]; then
    printf "  ${Y}atencao${N} RAM acima de 70%% — dimensione a proxima onda pela folga.\n"
  else
    printf "  ${G}folga${N} — cabe mais frente em paralelo.\n"
  fi

  command sleep "$interval"
done
