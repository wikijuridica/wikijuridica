import argparse
import collections
import json
import os
import sys


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=".")
    ap.add_argument("--mostrar", type=int, default=3, help="quantos registros inteiros imprimir")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    caminho = os.path.join(args.root, "data", "ai", "extracoes_dispositivos.jsonl")
    if not os.path.exists(caminho):
        print("sem extracoes ainda:", caminho)
        return 0
    regs = [json.loads(l) for l in open(caminho, encoding="utf-8") if l.strip()]
    n = len(regs)
    itens = sum(len(r["dispositivos"]) for r in regs)
    descartados = sum(r["descartados"] for r in regs)
    com_urn = sum(1 for r in regs for d in r["dispositivos"] if d.get("urn"))
    vazios = sum(1 for r in regs if not r["dispositivos"])
    cortadas = sum(1 for r in regs if r.get("done_reason") != "stop")
    tok_s = [r["eval_tok_s"] for r in regs if r.get("eval_tok_s")]
    resumo = {
        "acordaos": n, "itens_mantidos": itens, "itens_descartados": descartados,
        "taxa_descarte": round(descartados / (itens + descartados), 3) if itens + descartados else 0,
        "itens_com_urn": com_urn, "taxa_urn": round(com_urn / itens, 3) if itens else 0,
        "acordaos_sem_item": vazios, "respostas_cortadas": cortadas,
        "eval_tok_s_mediana": sorted(tok_s)[len(tok_s) // 2] if tok_s else 0,
        "normas_mais_citadas": collections.Counter(d["norma"] for r in regs for d in r["dispositivos"]).most_common(5),
    }
    print(json.dumps(resumo, ensure_ascii=False))
    if not args.json:
        for r in regs[: args.mostrar]:
            print("\n==", r["chave"], "descartados", r["descartados"], r.get("done_reason"))
            for d in r["dispositivos"]:
                print("  -", d["norma"], "|", d["artigo"], "|", d.get("urn") or "(sem URN)", "|", d["texto_citado"][:100])
    # SAI 0 SEMPRE, E ISSO E DELIBERADO: ver o bloco POR QUE ELE NAO ENTRA NA
    # BANCADA, no topo. Este numero nao e veredito de qualidade nenhum — quem
