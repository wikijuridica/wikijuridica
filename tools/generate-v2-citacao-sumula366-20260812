        linhas.append(json.dumps({
            "gerador": Path(__file__).name, "gerado_em": HOJE,
            "tipo": "aplicacao", **resultado,
        }, ensure_ascii=False))
    atomic_write(EVIDENCIA, ("\n".join(linhas) + "\n").encode("utf-8"))
    print(f"evidência: {len(linhas)} registro(s) em "
          f"{os.path.relpath(EVIDENCIA, ROOT)}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    resultados: list[dict] = []
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for alvo in ALVOS:
                    resultado = aplicar_um(
                        alvo["shard"], alvo["intent"], alvo["trocas"],
                        args.dry_run)
                    resultados.append(resultado)
                if not args.dry_run and resultados:
                    escrever_evidencia(resultados)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    rotulo = "--dry-run: " if args.dry_run else ""
    for resultado in resultados:
        print(f"{rotulo}{resultado['shard']}:{resultado['linha']} "
              f"({resultado['intent_id']}) corrigido — word_count "
              f"{resultado['word_count_campo_antes']} -> "
              f"{resultado['word_count_calculado_depois']}")
        if resultado.get("title_depois"):
            print(f"  title ({resultado['title_len_depois']} chars): "
                  f"{resultado['title_depois']}")
        if resultado.get("meta_depois"):
            print(f"  meta ({resultado['meta_len_depois']} chars): "
                  f"{resultado['meta_depois']}")
        if resultado.get("h1_depois"):
            print(f"  h1: {resultado['h1_depois']}")
    if args.dry_run:
        print("Nada escrito.")
    else:
        print("Reingerir o estoque e republicar para o espelho refletir a correção.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
