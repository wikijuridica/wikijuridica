@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go / generate_v2_review_queue.py."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def preservar(shard: Path) -> None:
    destino = ROOT / BACKUP / shard.name
    if destino.exists():
        return
    destino.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(shard, destino)


WC_PATTERN = re.compile(r'"word_count"\s*:\s*\d+')


def aplicar_um(shard: Path, intent: str, trocas: list[tuple[str, str]],
                dry_run: bool) -> dict:
    rel = os.path.relpath(shard, ROOT)
    bruto = shard.read_bytes().decode("utf-8")
    linhas = bruto.split("\n")
    fim_com_newline = bool(linhas) and linhas[-1] == ""
    if fim_com_newline:
        linhas = linhas[:-1]

    alvo_idx = None
    for numero, raw in enumerate(linhas, 1):
        if not raw.strip():
            raise SystemExit(f"{rel}: linha em branco {numero}")
        registro = json.loads(raw)
        if registro.get("intent_id") == intent:
            alvo_idx = numero
            break
    if alvo_idx is None:
        raise SystemExit(f"{rel}: intent {intent} não encontrado")

    raw = linhas[alvo_idx - 1]
    registro_antes = json.loads(raw)
    wc_antes = word_count(registro_antes)
    wc_campo_antes = registro_antes.get("word_count")
    title_antes = registro_antes.get("title")
    meta_antes = registro_antes.get("meta_description")
    h1_antes = registro_antes.get("h1")
    digest_antes = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()

    nova = raw
    for antiga, corrigida in trocas:
        ocorrencias = nova.count(antiga)
        if ocorrencias != 1:
            raise SystemExit(
                f"{rel}:{alvo_idx} ({intent}): substring esperada 1x, "
                f"encontrada {ocorrencias}x — {antiga[:80]!r}")
        nova = nova.replace(antiga, corrigida, 1)

    registro_depois = json.loads(nova)
    if registro_depois.get("intent_id") != intent:
        raise SystemExit(f"{rel}:{alvo_idx}: intent_id mudou — abortado")

    wc_depois = word_count(registro_depois)
    if not WC_PATTERN.search(nova):
        raise SystemExit(f"{rel}:{alvo_idx}: campo word_count não encontrado")
    nova = WC_PATTERN.sub('"word_count":%d' % wc_depois, nova, count=1)
    registro_depois_final = json.loads(nova)
    if registro_depois_final.get("word_count") != wc_depois:
        raise SystemExit(f"{rel}:{alvo_idx}: word_count não gravou corretamente")

    title_depois = registro_depois_final.get("title")
    meta_depois = registro_depois_final.get("meta_description")
    h1_depois = registro_depois_final.get("h1")
    if title_depois and not (20 <= len(title_depois) <= 65):
        raise SystemExit(
            f"{rel}:{alvo_idx}: title fora do limite 20-65 "
            f"({len(title_depois)} chars)")
    if meta_depois and not (70 <= len(meta_depois) <= 160):
        raise SystemExit(
            f"{rel}:{alvo_idx}: meta_description fora do limite 70-160 "
            f"({len(meta_depois)} chars)")

    # CAS: relê a linha viva do disco agora e compara com o hash lido no
    # início desta função (protege contra escrita concorrente).
    atual = hashlib.sha256(
        shard.read_bytes().decode("utf-8").split("\n")[alvo_idx - 1]
        .strip().encode("utf-8")).hexdigest()
    if atual != digest_antes:
        raise SystemExit(
            f"CAS DE LINHA FALHOU em {rel}:{alvo_idx} ({intent}): outra "
            f"frente tocou este registro durante a execução.")

    resultado = {
        "shard": rel, "linha": alvo_idx, "intent_id": intent,
        "trocas": len(trocas),
        "word_count_campo_antes": wc_campo_antes,
        "word_count_calculado_antes": wc_antes,
        "word_count_calculado_depois": wc_depois,
        "title_antes": title_antes, "title_depois": title_depois,
        "title_len_depois": len(title_depois) if title_depois else None,
        "meta_antes": meta_antes, "meta_depois": meta_depois,
        "meta_len_depois": len(meta_depois) if meta_depois else None,
        "h1_antes": h1_antes, "h1_depois": h1_depois,
    }

    if not dry_run:
        linhas[alvo_idx - 1] = nova
        preservar(shard)
        payload = "\n".join(linhas) + ("\n" if fim_com_newline else "")
        atomic_write(shard, payload.encode("utf-8"))

    return resultado


