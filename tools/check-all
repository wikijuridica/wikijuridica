#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

run_step() {
	name="$1"
	shift
	start="$(date +%s)"
	printf 'TIMING start %s\n' "$name"
	if "$@"; then
		status=0
	else
		status="$?"
	fi
	end="$(date +%s)"
	elapsed="$((end - start))"
	if [ "$status" -eq 0 ]; then
		printf 'TIMING pass %s seconds=%s\n' "$name" "$elapsed"
	else
		printf 'TIMING fail %s seconds=%s status=%s\n' "$name" "$elapsed" "$status"
	fi
	return "$status"
}

# Cada passo roda ate o fim mesmo que o anterior reprove: com `set -eu` e
# `return "$status"`, um `go test ./...` vermelho (as vezes flaky/infra, nao
# conteudo) abortava o script ANTES dos gates editoriais/anti-fraude, escondendo
# se eles passariam e forcando o ciclo fix -> rerun -> descobrir a proxima falha.
# O veredito agregado nao afrouxa: qualquer passo vermelho mantem exit != 0.
overall=0
failed_steps=""

record_step() {
	step_name="$1"
	shift
	if run_step "$step_name" "$@"; then
		return 0
	fi
	overall=1
	failed_steps="$failed_steps $step_name"
	return 0
}

if [ "${PROFILE_CONTRACT:-0}" = "1" ]; then
	record_step profile-contract-tests ./tools/profile-contract-tests
fi

# ESCOPO (corrigido em 2026-08-29, BUG-108 da caca): `go test ./...` NAO
# EXPANDE neste repositorio — var/nginx/* pertence a `nobody` com modo 0700 e o
# caminhador aborta o padrao INTEIRO com "permission denied". O passo chamado
# "go-test-all" rodava a suite sobre ZERO pacote e reportava sucesso: o runner
# de teste do projeto nunca testou nada. Nao encolhe escopo: a fonte Go do
# modulo vive toda em internal/ e cmd/.
# ATUALIZACAO 2026-08-29 (DEC-039): o padrao ./... passou a EXPANDIR — o go.mod
# raiz ganhou a diretiva `ignore ./var`, que tira a subarvore do runtime do nginx
# do alcance dos padroes. O escopo explicito abaixo CONTINUA certo, por outro
# motivo: ./... virou comando full-tree pesado (488 pacotes), proibido pelo
# AGENTS.md e guardado pelo hook block-heavy-go.sh. O texto acima descreve o
# estado ate aquela data e fica como registro do que a armadilha custou.
record_step go-test-all go test ./internal/... ./cmd/...
record_step check-all-contracts ./tools/run-check all --timings

if [ -n "$failed_steps" ]; then
	printf 'check-all: passos reprovados:%s\n' "$failed_steps" >&2
	printf 'check-all: reproduza isolado com "go test -count=1 ./internal/<pacote>/" (go-test-all) ou "./tools/run-check <nome-do-check> --timings" (check-all-contracts); a saida acima ja nomeia o check que reprovou.\n' >&2
fi
exit "$overall"
