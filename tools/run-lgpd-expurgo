#!/usr/bin/env bash
# run-lgpd-expurgo — apaga do banco da LGPD o que já venceu a retenção.
#
# POR QUE ISTO EXISTE. `lgpd.Varrer` estava escrito e testado desde 2026-09-04 e
# NUNCA ERA CHAMADO fora dos testes. Enquanto ninguém o executasse, "os
# registros de acesso ficam 6 meses" era um aviso ao titular, não um fato do
# disco — e o aviso que promete o que o sistema não faz é exatamente o defeito
# que internal/lgpd foi criado para corrigir.
#
# O prazo NÃO é decidido aqui. Cada linha de `registros_acesso` carrega o
# próprio `expira_em`, calculado no momento do registro a partir da tabela de
# finalidades. Este script só apaga o que já venceu — por isso mudar a política
# de retenção amanhã não reescreve retroativamente o prazo do que já foi
# coletado.
#
# O BINÁRIO É CONSTRUÍDO AQUI, e não vem de `bin/` pronto: o expurgo roda uma
# vez por dia e um binário desatualizado varreria com a regra velha em silêncio.
# O custo é um `go build` de um pacote pequeno.
#
# FALHA FECHADA: qualquer erro sai com código diferente de zero, e a unit tem
# `OnFailure=` — expurgo que falha em silêncio deixa o banco crescer com dado
# vencido enquanto o painel continua verde.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
raiz="$PWD"

binario="$raiz/bin/wikijuridica-lgpd-expurgo"
mkdir -p "$raiz/bin"

# `nice` porque o expurgo não corre contra ninguém: ele pode esperar o disco.
nice -n 10 ./tools/go-modern build -o "$binario" ./cmd/lgpd-expurgo

# O comando lê WIKI_SOCIAL_DATA_DIR sozinho (mesma variável da unit da rede
# social) e recusa diretório sem banco em vez de criar um vazio e relatar
# sucesso. Repassar os argumentos permite `--agora` em conferência manual.
exec "$binario" "$@"
