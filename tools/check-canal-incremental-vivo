#!/usr/bin/env python3
"""Prova, PELO TRANSPORTE, que o canal incremental do MCP concorda com /changes.json.

POR QUE EXISTE, e a data importa. Em 2026-09-08 a ferramenta MCP `mudancas_desde`
passou a devolver ZERO mudanças para qualquer cursor, enquanto `/changes.json`
respondia com o acervo inteiro — duas leituras do MESMO índice, uma congelada e
outra viva. A causa era de tempo de montagem (campo atribuído depois de
`mcpHandler()`, que congela uma cópia do Server), e ela sobreviveu a um deploy
porque a conferência pós-deploy foi feita pela AUSÊNCIA de um caminho indevido
("`mudancas_desde` não anuncia mais /aviso-legal/") em vez de pela PRESENÇA do
que ele deve entregar. Ausência de sinal não é evidência.

Este check faz a pergunta na ordem certa: a ferramenta entrega alguma coisa? e o
que ela entrega concorda com a rota HTTP que lê o mesmo índice?

Ele NÃO cobre: se as duas fontes estiverem igualmente erradas, ele passa. Para
isso existe o teste diferencial em internal/httpserver, que compara a busca
binária do cursor com a varredura linear ingênua sobre TODO cursor possível.

Sonda sem fraude (§11): sai como `wikijuridica-superficie-probe/1.0` com
`X-Warming-Request: true`, para a conferência não entrar na métrica de audiência.
"""

import argparse
import json
import sys
import urllib.error
import urllib.request

UA = "wikijuridica-superficie-probe/1.0"
CABECALHOS = {"User-Agent": UA, "X-Warming-Request": "true",
              "Content-Type": "application/json"}


def pede(url, corpo=None, timeout=20):
    dados = json.dumps(corpo).encode() if corpo is not None else None
    req = urllib.request.Request(url, data=dados, headers=CABECALHOS)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--base", default="http://127.0.0.1:8088")
    p.add_argument("--json", action="store_true")
    args = p.parse_args()
    base = args.base.rstrip("/")
    problemas = []

    try:
        mudancas = pede(base + "/changes.json?limite=1")
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as erro:
        print("check-canal-incremental-vivo: /changes.json inalcançável: %s" % erro,
              file=sys.stderr)
        return 2
    total = mudancas.get("total")

    try:
        resposta = pede(base + "/mcp", {
            "jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": "mudancas_desde", "arguments": {"limite": 50}},
        })
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as erro:
        print("check-canal-incremental-vivo: /mcp inalcançável: %s" % erro,
              file=sys.stderr)
        return 2

    # A ferramenta devolve o objeto em `structuredContent`; o `content[0].text`
    # carrega o MESMO JSON em texto. Lemos o estruturado e, se faltar, caímos no
    # texto — nunca inventamos ausência a partir de um formato inesperado.
    resultado = (resposta.get("result") or {})
    saida = resultado.get("structuredContent")
    if saida is None:
        blocos = resultado.get("content") or []
        texto = blocos[0].get("text") if blocos else None
        saida = json.loads(texto) if texto else {}

    itens = saida.get("mudancas") or []
    restantes = saida.get("restantes")
    cursor = saida.get("proximo_cursor") or ""

    if not itens:
        problemas.append(
            "mudancas_desde devolveu 0 mudanças com /changes.json em total=%s — "
            "é o sintoma exato do campo congelado (ver internal/httpserver/"
            "ordem_de_montagem_test.go)" % total)
    if itens and not cursor:
        problemas.append("devolveu %d mudanças e nenhum proximo_cursor: "
                         "o agente não tem como continuar" % len(itens))
    if itens and restantes is not None and total is not None:
        # A ferramenta filtra por gêmea Markdown, então o total dela é MENOR ou
        # igual ao de /changes.json — nunca maior. Maior significa que ela está
        # anunciando o que a coleção nega, que foi o defeito dos 7 caminhos.
        anunciado = len(itens) + restantes
        if anunciado > total:
            problemas.append(
                "mudancas_desde anuncia %d itens e /changes.json tem %d: a "
                "ferramenta está listando o que a coleção negaria com 404"
                % (anunciado, total))

    saida_json = {"changes_total": total, "mcp_itens": len(itens),
                  "mcp_restantes": restantes, "tem_cursor": bool(cursor),
                  "problemas": problemas}
    if args.json:
        print(json.dumps(saida_json, ensure_ascii=False, sort_keys=True))
    else:
        print("check-canal-incremental-vivo: /changes.json total=%s | "
              "mudancas_desde itens=%d restantes=%s cursor=%s"
              % (total, len(itens), restantes, "sim" if cursor else "NAO"))
        for problema in problemas:
            print("  DEFEITO: " + problema)
    if problemas:
        return 1
    print("check-canal-incremental-vivo: pass")
    return 0


if __name__ == "__main__":
    sys.exit(main())
