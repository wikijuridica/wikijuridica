#!/usr/bin/env bash
ROOT="$(
	unset CDPATH
	cd -- "$(dirname -- "$0")/.." && pwd
)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$(dirname "$0")/.."
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
if [[ "${OPS_CHECK_SELFTEST:-0}" == "1" ]]; then
	go test -count=1 ./internal/checkperformance ./internal/contract/checkmeta -run TestOpsCheckPerformanceLedgerCoversChecksWithProportionalPolicy
fi
exec "$ROOT/tools/run-check" ops-check-performance-ledger "$@"
