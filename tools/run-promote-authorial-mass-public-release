#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
cd "$ROOT"

# TARGET_N mirrors internal/authorialmassstock.ExpectedTotalContents: the canonical
# release total is driven by data/editorial/stock_manifest.json (drafts_expected +
# expansion_expected) and falls back to the historical 10000 milestone when the
# manifest is absent or unparseable. This keeps the out-of-band artifact-claim
# counts aligned with the Go gate so a sub-10k canonical stock (v2, N=6846) promotes
# without demanding a full 10000 (DEC-014).
TARGET_N=10000
STOCK_MANIFEST="$ROOT/data/editorial/stock_manifest.json"
if [ -e "$STOCK_MANIFEST" ]; then
	drafts_expected="$(grep -o '"drafts_expected"[[:space:]]*:[[:space:]]*[0-9]\+' "$STOCK_MANIFEST" | grep -o '[0-9]\+' | head -1)"
	expansion_expected="$(grep -o '"expansion_expected"[[:space:]]*:[[:space:]]*[0-9]\+' "$STOCK_MANIFEST" | grep -o '[0-9]\+' | head -1)"
	if [ -n "$drafts_expected" ] && [ -n "$expansion_expected" ]; then
		manifest_total=$((drafts_expected + expansion_expected))
		if [ "$manifest_total" -gt 0 ]; then
			TARGET_N="$manifest_total"
		fi
	fi
fi

EXPECTED_CURRENT_MANIFEST_RECORDS=""
EXPECTED_MANIFEST_RECORDS=""
# A hold-list muda QUAIS paginas entram na coorte, entao ela e insumo do claim:
# sem ela no fingerprint, duas execucoes com hold-lists diferentes reivindicavam
# o mesmo artefato com a mesma assinatura de entrada. O cmd usa o flag package
# do Go, que aceita tanto --hold-file=X quanto --hold-file X — as duas formas
# precisam ser capturadas.
HOLD_FILE_ARG=""
pending_value_flag=""
for arg in "$@"; do
	if [ -n "$pending_value_flag" ]; then
		case "$pending_value_flag" in
		expected-current) EXPECTED_CURRENT_MANIFEST_RECORDS="$arg" ;;
		expected-final) EXPECTED_MANIFEST_RECORDS="$arg" ;;
		hold-file) HOLD_FILE_ARG="$arg" ;;
		esac
		pending_value_flag=""
		continue
	fi
	case "$arg" in
	--expected-current-manifest-records)
		pending_value_flag="expected-current"
		;;
	--expected-current-manifest-records=*)
		EXPECTED_CURRENT_MANIFEST_RECORDS="${arg#*=}"
		;;
	--expected-manifest-records)
		pending_value_flag="expected-final"
		;;
	--expected-manifest-records=*)
		EXPECTED_MANIFEST_RECORDS="${arg#*=}"
		;;
	--hold-file | -hold-file)
		pending_value_flag="hold-file"
		;;
	--hold-file=* | -hold-file=*)
		HOLD_FILE_ARG="${arg#*=}"
		;;
	esac
done
if [ -n "$pending_value_flag" ]; then
	printf 'run-promote-authorial-mass-public-release: missing value for flag %s\n' "$pending_value_flag" >&2
	exit 2
fi
case "$EXPECTED_CURRENT_MANIFEST_RECORDS" in
'' | *[!0-9]*)
	printf 'run-promote-authorial-mass-public-release: --expected-current-manifest-records must be an explicit non-negative integer\n' >&2
	exit 2
	;;
esac
case "$EXPECTED_MANIFEST_RECORDS" in
'' | *[!0-9]*)
	printf 'run-promote-authorial-mass-public-release: --expected-manifest-records must be an explicit positive integer\n' >&2
	exit 2
	;;
esac
if [ "${#EXPECTED_CURRENT_MANIFEST_RECORDS}" -gt 5 ] || [ "${#EXPECTED_MANIFEST_RECORDS}" -gt 5 ]; then
	printf 'run-promote-authorial-mass-public-release: expected manifest counts are outside the P0 numeric range\n' >&2
	exit 2
fi
EXPECTED_CURRENT_MANIFEST_RECORDS=$((10#$EXPECTED_CURRENT_MANIFEST_RECORDS))
EXPECTED_MANIFEST_RECORDS=$((10#$EXPECTED_MANIFEST_RECORDS))
if [ "$EXPECTED_MANIFEST_RECORDS" -le "$EXPECTED_CURRENT_MANIFEST_RECORDS" ]; then
	printf 'run-promote-authorial-mass-public-release: final manifest count must be greater than current count\n' >&2
	exit 2
fi
if [ "$EXPECTED_MANIFEST_RECORDS" -gt "$TARGET_N" ]; then
	printf 'run-promote-authorial-mass-public-release: final manifest count cannot exceed the canonical release total of %s\n' "$TARGET_N" >&2
	exit 2
fi
# Cohort ceiling mirrors publicrelease.P0ReleaseCohortMaxRecords, env-tunable via
# WIKI_PUBLIC_RELEASE_COHORT_MAX (default 250) so the wrapper stays in lockstep
# with the Go gate instead of silently rejecting a widened cohort first.
COHORT_MAX="${WIKI_PUBLIC_RELEASE_COHORT_MAX:-250}"
case "$COHORT_MAX" in
'' | *[!0-9]*) COHORT_MAX=250 ;;
esac
if [ "$COHORT_MAX" -le 0 ]; then
	COHORT_MAX=250
fi
if [ $((EXPECTED_MANIFEST_RECORDS - EXPECTED_CURRENT_MANIFEST_RECORDS)) -gt "$COHORT_MAX" ]; then
	printf 'run-promote-authorial-mass-public-release: public release cohort cannot exceed %s records\n' "$COHORT_MAX" >&2
	exit 2
fi

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-promotion:authorial-mass-public-release:public-transaction:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-90000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-pages_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-validated_public_promotion_claims_and_command_exits_without_unclaimed_public_write}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-180}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-.release-staging/promotion_manifest.json}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/run-promote-authorial-mass-public-release}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:.release-staging/promotion_manifest.json}"

claim_input_fingerprint() {
	{
		printf 'expected_current_manifest_records:%s\n' "$EXPECTED_CURRENT_MANIFEST_RECORDS"
		printf 'expected_manifest_records:%s\n' "$EXPECTED_MANIFEST_RECORDS"
		printf 'expected_verdict_records:%s\n' "$TARGET_N"
		if [ -n "$HOLD_FILE_ARG" ]; then
			printf 'hold_file:%s\n' "$HOLD_FILE_ARG"
			if [ -e "$HOLD_FILE_ARG" ]; then
				sha256sum "$HOLD_FILE_ARG" | awk -v rel="$HOLD_FILE_ARG" '{print "hold_file:" rel ":" $1}'
			else
				printf 'hold_file:%s:missing\n' "$HOLD_FILE_ARG"
			fi
		fi
		for rel in \
			"data/ops/v2_ingest_transaction_receipt.json" \
			"data/editorial/stock_manifest.json" \
			"data/editorial/authorial_mass_manifest_transaction_rehearsal.jsonl" \
			"data/editorial/authorial_mass_manifest_transaction_body_section_chunks.jsonl" \
			"data/editorial/scaled_content_release_verdict.jsonl"; do
			if [ -e "$ROOT/$rel" ]; then
				sha256sum "$ROOT/$rel" | awk -v rel="$rel" '{print rel ":" $1}'
			else
				printf '%s:missing\n' "$rel"
			fi
		done
	} | sha256sum | awk '{print "sha256:" $1}'
}

claim_output_fingerprint() {
	path="$1"
	printf 'public_promotion_claim:%s:%s:%s:%s\n' "$path" "$CLAIM_INPUT_FINGERPRINT" "$EXPECTED_CURRENT_MANIFEST_RECORDS" "$EXPECTED_MANIFEST_RECORDS" | sha256sum | awk '{print "sha256:" $1}'
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

claim_json() {
	path="$1"
	output_fingerprint="$(claim_output_fingerprint "$path")"
	printf '{"path":"%s","producer":"tools/run-promote-authorial-mass-public-release","input_fingerprint":"%s","output_fingerprint_esperado":"%s","lock_scope":"%s","budget_ms":%s,"stop_condition":"%s","expected_current_manifest_records":%s,"expected_manifest_records":%s,"expected_verdict_records":%s,"public_write_allowed":false,"publication_allowed":false,"render_allowed":false,"sitemap_allowed":false,"approval":false,"public_path":"","index_policy":"noindex"}' \
		"$(json_escape "$path")" \
		"$CLAIM_INPUT_FINGERPRINT" \
		"$output_fingerprint" \
		"$(json_escape "$WIKI_HEAVY_LOCK_SCOPE")" \
		"$WIKI_HEAVY_BUDGET_MS" \
		"$(json_escape "$WIKI_HEAVY_STOP_CONDITION")" \
		"$EXPECTED_CURRENT_MANIFEST_RECORDS" \
		"$EXPECTED_MANIFEST_RECORDS" \
		"$TARGET_N"
}

CLAIM_INPUT_FINGERPRINT="$(claim_input_fingerprint)"
CLAIM_PUBLIC="$(claim_json "public/")"
CLAIM_CONTENT_PAGES="$(claim_json "content/pages.json")"
CLAIM_PUBLISHED_MANIFEST="$(claim_json "data/editorial/published_manifest.jsonl")"
CLAIM_PROMOTION_MANIFEST="$(claim_json ".release-staging/promotion_manifest.json")"
# A partir de publicrelease.publicReleaseContentStoreThresholdPages (2000) a
# transação para de reserializar content/pages.json e passa a escrever o
# contentstore: índice, manifesto e journal de release (nomes fixos em
# internal/contentstore) mais os shards. Sem estas linhas a declaração
# subdeclarava a superfície real de escrita justo nas coortes do meio da
# campanha. Os shards são variáveis por corte, então o diretório é a declaração
# honesta — mesma convenção de "public/".
CLAIM_CONTENT_STORE_INDEX="$(claim_json "content/page_index.jsonl")"
CLAIM_CONTENT_STORE_RELEASE_MANIFEST="$(claim_json "content/page_release_manifest.json")"
CLAIM_CONTENT_STORE_RELEASE_JOURNAL="$(claim_json "content/page_release_journal.jsonl")"
CLAIM_CONTENT_STORE_SHARDS="$(claim_json "content/page_shards/")"
export WIKI_PUBLIC_PROMOTION_ARTIFACT_CLAIMS_JSON="[$CLAIM_PUBLIC,$CLAIM_CONTENT_PAGES,$CLAIM_PUBLISHED_MANIFEST,$CLAIM_PROMOTION_MANIFEST,$CLAIM_CONTENT_STORE_INDEX,$CLAIM_CONTENT_STORE_RELEASE_MANIFEST,$CLAIM_CONTENT_STORE_RELEASE_JOURNAL,$CLAIM_CONTENT_STORE_SHARDS]"

printf 'run-promote-authorial-mass-public-release: cohort current=%s final=%s delta=%s\n' "$EXPECTED_CURRENT_MANIFEST_RECORDS" "$EXPECTED_MANIFEST_RECORDS" "$((EXPECTED_MANIFEST_RECORDS - EXPECTED_CURRENT_MANIFEST_RECORDS))" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=public/ producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=content/pages.json producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=data/editorial/published_manifest.jsonl producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=.release-staging/promotion_manifest.json producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=content/page_index.jsonl producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=content/page_release_manifest.json producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=content/page_release_journal.jsonl producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2
printf 'run-promote-authorial-mass-public-release: artifact_claim path=content/page_shards/ producer=tools/run-promote-authorial-mass-public-release input_fingerprint=%s lock_scope=%s budget_ms=%s stop_condition=%s publication_allowed=false render_allowed=false sitemap_allowed=false index_policy=noindex\n' "$CLAIM_INPUT_FINGERPRINT" "$WIKI_HEAVY_LOCK_SCOPE" "$WIKI_HEAVY_BUDGET_MS" "$WIKI_HEAVY_STOP_CONDITION" >&2

exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/promote-authorial-mass-public-release --timings "$@"
