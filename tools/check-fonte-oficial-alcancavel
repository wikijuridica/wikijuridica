#!/usr/bin/env python3
"""check-fonte-oficial-alcancavel — sonda de ALCANCE de fonte oficial.

Separa, para cada host de fonte oficial, DUAS coisas que este projeto já
confundiu e quase pagou caro por confundir:

    REDE    — DNS resolve? TLS fecha? o servidor responde em HTTP/2 e em
              HTTP/1.1? qual status, em quanto tempo, de qual IP?
    POLÍTICA— o robots.txt do host permite que ESTE portal colete?

Reprova só quando a REDE falha num host que o repositório declara depender.
`Disallow` no robots é POLÍTICA: sai no relatório como recusa do host, nunca
como defeito de infraestrutura — e é a distinção inteira deste arquivo.

★ O CASO QUE O FEZ NASCER (T8.9 do PLANO_SUPERFICIE_BOTS_20260826)

O plano registrava: "o DOU é INALCANÇÁVEL deste servidor: in.gov.br/leiturajornal
devolve PROTOCOL_ERROR em HTTP/2 (curl 92) e 'Empty reply' em HTTP/1.1 (curl 52),
com DNS resolvendo — investigue o caminho de rede antes de desistir da fonte".

MEDIDO EM 2026-08-26, com `-A 'wiki-fase8/1.0' -H 'X-Warming-Request: true'`:

    https://www.in.gov.br/leiturajornal            200  HTTP/2   546.705 B  0,14 s  201.78.203.17
    https://www.in.gov.br/leiturajornal (--http1.1) 200                              idem
    https://www.in.gov.br/leiturajornal?data=26-08-2026&secao=do1
                                                   200  HTTP/2   547.325 B  0,93 s
      -> <title>Leitura do Jornal - Imprensa Nacional</title> e os atos do dia
         ("acordaos-de-24-de-agosto-de-2026-727980420")
    https://in.gov.br/leiturajornal (APEX, sem www) 302  HTTP/1.0  Server: BigIP
      -> Location: https://www.in.gov.br/leiturajornal
    https://inlabs.in.gov.br/                      302  -> acessar.php (login)

O DOU ESTÁ NO AR E RESPONDE DESTE SERVIDOR. A conclusão "inalcançável" mediu o
APEX — que é um balanceador BigIP falando HTTP/1.0 e devolvendo 302 —, não o
host que serve o jornal. Sondar o apex com HTTP/2 é exatamente o cenário que
produz `curl 92`.

E O BLOQUEIO REAL É OUTRO, e é de política, não de rede:

    https://www.in.gov.br/robots.txt  ->  "User-agent: *\\nDisallow: /"

A Imprensa Nacional NEGA a coleta a todo agente, pelo canal padrão. Pela regra
de coleta em três degraus da DEC-032 — canal aberto permitido por robots
primeiro; portal público com identificação embutida e ritmo humano só quando
não houver o primeiro; NUNCA contra host que negue por outro meio que não o WAF
— raspar www.in.gov.br está vedado. O canal correto é o `inlabs`, que é
credenciado (302 para acessar.php) e cuja credencial é decisão do dono.

Ou seja: horas de engenharia de rede resolveriam um problema que não existe, e
o caminho que elas "destravariam" é o que a política proíbe. É esse par de
erros que este arquivo passa a impedir.

★ SEM HARDCODE: os hosts saem de content/source_registry.json, contados por
frequência. `--host` filtra; `--limite` corta. Ritmo de 2 s entre requisições ao
MESMO host (DEC-032), User-Agent próprio e `X-Warming-Request: true` — nunca UA
de bot real, que neste repositório é fraude.
"""

from __future__ import annotations

import argparse
import collections
import json
import os
import re
import subprocess
import sys
import time

# Identidade canonica do portal ao sair para a rede (CLAUDE.md secao 11,
# internal/wikijuridicabot.UserAgentComProposito). O host sondado vem do
# registro (content/source_registry.json) e varia -- por isso o proposito
# fica generico ("verificacao-de-fonte"), igual ao caso Go que confere URL
# de fonte oficial citada.
UA = ("Mozilla/5.0 (compatible; WikijuridicaBot/1.0; "
      "+https://wikijuridica.com.br/bot/; verificacao-de-fonte)")
INTERVALO_POR_HOST_S = 2.0
HOST = re.compile(r"https?://([A-Za-z0-9.-]+)")


def hosts_do_registro(caminho: str) -> list[tuple[str, int]]:
    with open(caminho, encoding="utf-8", errors="replace") as fh:
        bruto = fh.read()
    contagem = collections.Counter(m.group(1).lower() for m in HOST.finditer(bruto))
    return contagem.most_common()


def curl(url: str, extra: list[str], timeout: int = 25) -> tuple[int, str]:
    comando = [
        "curl", "-sS", "-o", "/dev/null",
        "-w", "%{http_code}|%{http_version}|%{size_download}|%{time_total}|%{remote_ip}",
        "-A", UA, "-H", "X-Warming-Request: true",
        "--max-time", str(timeout), *extra, url,
    ]
    try:
        saida = subprocess.run(comando, capture_output=True, text=True, timeout=timeout + 5)
    except subprocess.TimeoutExpired:
        return 28, "timeout"
    return saida.returncode, (saida.stdout or saida.stderr or "").strip().replace("\n", " ")


def robots_verdito(host: str) -> str:
    comando = ["curl", "-sS", "-L", "-A", UA, "-H", "X-Warming-Request: true",
               "--max-time", "20", f"https://{host}/robots.txt"]
    try:
        saida = subprocess.run(comando, capture_output=True, text=True, timeout=25)
    except subprocess.TimeoutExpired:
        return "robots: timeout"
    corpo = saida.stdout or ""
    if saida.returncode != 0 or not corpo.strip():
        return f"robots: ausente/erro (curl {saida.returncode})"
    curinga = False
    for linha in corpo.splitlines():
        nua = linha.split("#", 1)[0].strip()
        if not nua:
            continue
        chave, _, valor = nua.partition(":")
        chave, valor = chave.strip().lower(), valor.strip()
        if chave == "user-agent":
            curinga = valor == "*"
        elif chave == "disallow" and curinga and valor == "/":
            return "robots: NEGA tudo ao curinga (Disallow: /) -- coleta vedada pela DEC-032"
    return "robots: permite o curinga (coleta pelo canal aberto e licita)"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="separa falha de REDE de recusa de POLITICA nas fontes oficiais do registro"
    )
    parser.add_argument("--root", default=None)
    parser.add_argument("--host", default=None, help="sonda so este host")
    parser.add_argument("--limite", type=int, default=5, help="quantos hosts sondar (por frequencia)")
    parser.add_argument("--listar", action="store_true", help="so lista os hosts, sem tocar na rede")
    args = parser.parse_args()

    raiz = os.path.abspath(args.root or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    registro = os.path.join(raiz, "content/source_registry.json")
    if not os.path.isfile(registro):
        print(f"check-fonte-oficial-alcancavel: {registro} nao existe", file=sys.stderr)
        return 2

    ranking = hosts_do_registro(registro)
    if args.host:
        ranking = [(h, n) for h, n in ranking if h == args.host or h.endswith("." + args.host)]
        if not ranking:
            ranking = [(args.host, 0)]
    else:
        ranking = ranking[: args.limite]

    if args.listar:
        for host, n in ranking:
            print(f"  {host:<40} {n} referencia(s) no registro")
        return 0

    falhas_de_rede: list[str] = []
    print(f"check-fonte-oficial-alcancavel: sondando {len(ranking)} host(s) "
          f"com UA proprio e {INTERVALO_POR_HOST_S:.0f}s entre requisicoes")
    for host, referencias in ranking:
        rc2, m2 = curl(f"https://{host}/", [])
        time.sleep(INTERVALO_POR_HOST_S)
        rc1, m1 = curl(f"https://{host}/", ["--http1.1"])
        time.sleep(INTERVALO_POR_HOST_S)
        politica = robots_verdito(host)
        time.sleep(INTERVALO_POR_HOST_S)
        print(f"  {host}  ({referencias} ref.)")
        print(f"      HTTP/2   curl={rc2}  {m2}")
        print(f"      HTTP/1.1 curl={rc1}  {m1}")
        print(f"      {politica}")
        # REDE falhou só quando NENHUM dos dois transportes fechou. Um deles
        # respondendo prova que o caminho existe — foi assim que a conclusao
        # "DOU inalcancavel" caiu.
        if rc2 != 0 and rc1 != 0:
            falhas_de_rede.append(f"{host}: HTTP/2 curl={rc2} e HTTP/1.1 curl={rc1} "
                                  f"-- nenhum transporte fechou")

    if not falhas_de_rede:
        print("OK: todo host sondado responde por pelo menos um transporte. "
              "Recusa por robots, quando houver, e POLITICA do host -- nao defeito de rede.")
        return 0
    for falha in falhas_de_rede:
        print(f"FALHA: {falha}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
