def main():
    falhas = []

    modulo = carregar_gerador()
    regex = modulo.ARTIGO_RE
    for texto, numero_esperado, inicio_esperado in FORMAS:
        achado = regex.search(texto)
        if not achado:
            falhas.append("forma não reconhecida: %r" % texto)
            continue
        numero = (achado.group(1).replace(".", "").replace(" ", "")
                  + (achado.group(2) or "")).upper()
        resto = texto[achado.end():]
        if numero != numero_esperado:
            falhas.append("%r -> art. %s, esperado %s" % (texto[:40], numero, numero_esperado))
        elif not resto.startswith(inicio_esperado):
            falhas.append("%r -> caput começa em %r, esperado %r"
                          % (texto[:40], resto[:24], inicio_esperado))

    print("=== EXTRATOR: %d formas de escrita de artigo ===" % len(FORMAS))
    print("reconhecidas corretamente: %d/%d" % (len(FORMAS) - len(falhas), len(FORMAS)))

    print("\n=== BUG-118: %d blocos de alteração (contaminação e falso positivo) ==="
          % len(BLOCOS_DE_ALTERACAO))
    for texto, devem_sumir, devem_sobreviver, motivo in BLOCOS_DE_ALTERACAO:
        artigos = modulo.indexar_artigos(modulo.texto_limpo(texto.encode("utf-8")))
        presentes_indevidos = devem_sumir & set(artigos)
        ausentes_indevidos = devem_sobreviver - set(artigos)
        if presentes_indevidos:
            falhas.append("BUG-118: art(s). %s deveria(m) ter sido excluído(s) por "
                          "transcrição de outra lei e continua(m) no corpus — %s"
                          % (sorted(presentes_indevidos), motivo))
            print("  FALHA    contaminação não removida: %s — %s"
                  % (sorted(presentes_indevidos), motivo))
        elif ausentes_indevidos:
            falhas.append("BUG-118: art(s). %s é(são) falso positivo — sumiu(ram) sem "
                          "ser transcrição de outra lei — %s"
                          % (sorted(ausentes_indevidos), motivo))
            print("  FALHA    falso positivo: %s — %s" % (sorted(ausentes_indevidos), motivo))
        else:
            print("  ok       %s" % motivo)

    # === LEI CURTA NÃO É PÁGINA DE ERRO ===
    # O piso de "pelo menos 5 artigos" reprovava a Lei 12.653/2012, que tem
    # QUATRO — e só não reprovava antes porque o extrator contava junto o art.
    # 135-A do Código Penal que ela insere. Corrigido o BUG-118, o texto
    # oficial CORRETO passou a ser recusado pelo gerador.
    LEI_CURTA = ("A PRESIDENTA DA REPÚBLICA Faço saber que o Congresso Nacional "
                 "decreta e eu sanciono a seguinte Lei:\n"
                 "Art. 1º O Decreto-Lei nº 2.848 passa a vigorar acrescido do art. X.\n"
                 "Art. 2º O estabelecimento fica obrigado a afixar cartaz.\n"
                 "Art. 3º O Poder Executivo regulamentará o disposto nesta Lei.\n"
                 "Art. 4º Esta Lei entra em vigor na data de sua publicação.\n")
    PAGINA_DE_ERRO = "Verificando seu navegador antes de acessar o site. Art. 1 teste.\n"
    print("\n=== FORMA DE LEI: o que separa texto oficial de página de erro ===")
    for texto, esperado, motivo in (
            (LEI_CURTA, True, "lei de 4 artigos com promulgação e vigência (Lei 12.653/2012)"),
            (PAGINA_DE_ERRO, False, "resposta de challenge com um 'Art.' solto")):
        limpo = modulo.texto_limpo(texto.encode("utf-8"))
        obtido = modulo.documento_e_lei(limpo, modulo.indexar_artigos(limpo))
        if bool(obtido) != esperado:
            falhas.append("forma de lei: %s -> %s, esperado %s" % (motivo, obtido, esperado))
            print("  FALHA    %s -> %s" % (motivo, obtido))
        else:
            print("  ok       %s" % motivo)

    print("\n=== FIM DO DISPOSITIVO: %d documentos do Planalto ===" % len(FIM_DO_DISPOSITIVO))
    for html, limites, tem_de_conter, nao_pode_conter, motivo in FIM_DO_DISPOSITIVO:
        artigos = modulo.indexar_artigos(modulo.texto_limpo(html))
        problemas = []
        for numero, (comeco, fim) in limites.items():
            corpo = " ".join(artigos.get(numero, "").split())
            if not corpo:
                problemas.append("art. %s não indexado" % numero)
                continue
            if comeco and not corpo.startswith(comeco):
                problemas.append("art. %s começa em %r, esperado %r"
                                 % (numero, corpo[:40], comeco))
            if fim and not corpo.endswith(fim):
                problemas.append("art. %s termina em %r, esperado %r"
                                 % (numero, corpo[-40:], fim))
        for numero, trechos in tem_de_conter.items():
            corpo = " ".join(artigos.get(numero, "").split())
            for trecho in trechos:
                if trecho not in corpo:
                    problemas.append("art. %s perdeu %r — amputação" % (numero, trecho))
        for numero, trechos in nao_pode_conter.items():
            corpo = " ".join(artigos.get(numero, "").split())
            for trecho in trechos:
                if trecho in corpo:
                    problemas.append("art. %s ainda traz %r — contaminação"
                                     % (numero, trecho))
        if problemas:
            falhas.extend("fim do dispositivo: %s (%s)" % (p, motivo) for p in problemas)
            print("  FALHA    %s" % motivo)
            for problema in problemas:
                print("           %s" % problema)
        else:
            print("  ok       %s" % motivo)

    print("\n=== ORDINAL NA MARCAÇÃO: %d formas ===" % len(ORDINAL_NA_MARCACAO))
    for bruto, esperado, motivo in ORDINAL_NA_MARCACAO:
        obtido = " ".join(modulo.texto_limpo(bruto).split())
        if obtido != esperado:
            falhas.append("ORDINAL NA MARCAÇÃO: %r, esperado %r — %s"
                          % (obtido, esperado, motivo))
            print("  FALHA    %r" % obtido)
        else:
            print("  ok       %s" % motivo)

    print("\n=== ENDEREÇO DO ARTIGO: %d documentos ===" % len(ENDERECO_DO_ARTIGO))
    for texto, esperado, motivo in ENDERECO_DO_ARTIGO:
        posicao = modulo.posicao_dos_artigos(modulo.texto_limpo(texto.encode("utf-8")))
        erro = None
        for numero, divisoes in esperado.items():
            obtido = posicao.get(numero) or {}
            if set(obtido) != set(divisoes):
                erro = ("art. %s -> níveis %s, esperado %s"
                        % (numero, sorted(obtido), sorted(divisoes)))
                break
            for nivel, (designacao, nome) in divisoes.items():
                if obtido[nivel]["designacao"] != designacao:
                    erro = ("art. %s, %s -> designação %r, esperado %r"
                            % (numero, nivel, obtido[nivel]["designacao"], designacao))
                    break
                if obtido[nivel]["nome"] != nome:
                    erro = ("art. %s, %s -> nome %r, esperado %r"
                            % (numero, nivel, obtido[nivel]["nome"], nome))
                    break
            if erro:
                break
        if erro:
            falhas.append("ENDEREÇO: %s — %s" % (erro, motivo))
            print("  FALHA    %s" % erro)
        else:
            print("  ok       %s" % motivo)

    print("\n=== NOTA DE VIGÊNCIA: %d formas do texto oficial ===" % len(NOTAS_DE_VIGENCIA))
    for texto, tipo_esperado, motivo in NOTAS_DE_VIGENCIA:
        obtidas = modulo.notas_de_vigencia("Corpo do artigo. %s" % texto)
        tipos = [nota["tipo"] for nota in obtidas]
        if tipo_esperado is None:
            if obtidas:
                falhas.append("nota de vigência: %r não é nota e virou %s (%s)"
                              % (texto, tipos, motivo))
                print("  FALHA    %r virou %s — %s" % (texto, tipos, motivo))
            else:
                print("  ok       não é nota: %s" % motivo)
            continue
        if tipos != [tipo_esperado]:
            falhas.append("nota de vigência: %r -> %s, esperado [%r] (%s)"
                          % (texto, tipos, tipo_esperado, motivo))
            print("  FALHA    %r -> %s, esperado %r" % (texto, tipos, tipo_esperado))
        else:
            print("  ok       %-30s %s" % (tipo_esperado, motivo))

    print("\n=== CORPUS EM DISCO: %d dispositivos que já geraram acusação falsa ===" % len(NO_DISCO))
    ausentes = 0
    for slug, artigo, trecho, motivo in NO_DISCO:
        caminho = os.path.join(CORPUS, slug + ".json")
        if not os.path.exists(caminho):
            print("  AUSENTE  %s (arquivo não existe) — %s" % (slug, motivo))
            falhas.append("corpus sem %s" % slug)
            ausentes += 1
            continue
        with open(caminho, encoding="utf-8") as handle:
            artigos = json.load(handle).get("articles", {})
        corpo = artigos.get(artigo)
        if not corpo:
            print("  FALHA    %s art. %s não indexado — %s" % (slug, artigo, motivo))
            falhas.append("%s art. %s ausente" % (slug, artigo))
        elif trecho.lower() not in " ".join(corpo.split()).lower():
            print("  FALHA    %s art. %s sem %r — %s" % (slug, artigo, trecho, motivo))
            falhas.append("%s art. %s sem %r" % (slug, artigo, trecho))
        else:
            print("  ok       %s art. %-5s %s" % (slug, artigo, motivo))

    # === NENHUM art. 1º PODE SER O DO ATO APROVADOR ===
    # Verificação de AUSÊNCIA, sobre TODOS os diplomas do corpus. A lista
    # NO_DISCO acima é nominal e só sabe o que alguém escreveu nela; esta varre
    # o que existe. Foi a falta dela que deixou o art. 1º da CLT errado passar
    # verde por este mesmo gate, no dia em que ele foi lido pela primeira vez.
    import glob as _glob
    arquivos_corpus = sorted(_glob.glob(os.path.join(CORPUS, "*.json")))
    print("\n=== ART. 1º NÃO PODE SER O DO ATO APROVADOR: %d diplomas ===" % len(arquivos_corpus))
    aprovadores = 0
    for caminho in arquivos_corpus:
        slug = os.path.splitext(os.path.basename(caminho))[0]
        with open(caminho, encoding="utf-8") as handle:
            artigos = json.load(handle).get("articles", {})
        primeiro = " ".join(str(artigos.get("1", "")).split())
        if primeiro and FORMA_DE_ATO_APROVADOR.search(primeiro):
            print("  FALHA    %s art. 1 é o do ato aprovador: %.90s" % (slug, primeiro))
            falhas.append("%s art. 1 traz o ato aprovador" % slug)
            aprovadores += 1
    if aprovadores == 0:
        print("  ok       nenhum art. 1º traz a forma do ato aprovador")

    # === OS DOIS ENDEREÇOS NÃO PODEM SE MISTURAR ===
    # `source_url`/`conference_url` respondem "qual TEXTO o verificador compara";
    # `citation_url` responde "qual LINK o leitor recebe". Se os dois campos
    # divergirem de valor, ou se a citação apontar para o documento com MENOS
    # âncoras, o registro voltou a responder duas perguntas com um endereço só.
    import glob
    arquivos = sorted(glob.glob(os.path.join(CORPUS, "*.json")))
    print("\n=== DOIS ENDEREÇOS: %d diplomas ===" % len(arquivos))
    confiaveis = 0
    for caminho in arquivos:
        with open(caminho, encoding="utf-8") as handle:
            d = json.load(handle)
        slug = d.get("slug", os.path.basename(caminho)[:-5])
        if d.get("schema_version") not in ("legal_corpus_v2", "legal_corpus_v3"):
            continue  # registro antigo: o gerador ainda não passou por ele
        if d.get("source_url") != d.get("conference_url"):
            falhas.append("%s: source_url != conference_url (o texto de conferência "
                          "deixou de ser o que foi indexado)" % slug)
        if not d.get("citation_url"):
            falhas.append("%s: sem citation_url" % slug)
        if (d.get("citation_url") != d.get("conference_url")
                and d.get("citation_url_normative_anchors", 0)
                < d.get("conference_url_normative_anchors", 0)):
            falhas.append("%s: citation_url com menos âncoras normativas (%d) que a de "
                          "conferência (%d) — o link escolhido não resolve melhor"
                          % (slug, d.get("citation_url_normative_anchors", 0),
                             d.get("conference_url_normative_anchors", 0)))
        evidencia = d.get("text_version_evidence") or {}
        if d.get("confiavel_para_acusar_divergencia"):
            confiaveis += 1
            if not evidencia.get("regra_conferencia"):
                falhas.append("%s: confiável sem a medição que o autoriza" % slug)
            if d.get("text_version") == "texto_original":
                falhas.append("%s: confiável declarando texto_original" % slug)
        elif not evidencia.get("regra_conferencia"):
            falhas.append("%s: fail-closed sem motivo registrado" % slug)
    print("  confiáveis para acusar divergência: %d/%d" % (confiaveis, len(arquivos)))
    print("  citação separada da conferência   : %d" % sum(
        1 for c in arquivos
        if (lambda x: x.get("citation_url") != x.get("conference_url"))(
            json.load(open(c, encoding="utf-8")))))

    if falhas:
        print("\nREPROVADO — %d problema(s):" % len(falhas))
        for problema in falhas:
            print("  - %s" % problema)
        if ausentes:
            print("\n  regenere o corpus: tools/generate-legal-corpus")
        return 1

    print("\nAPROVADO — extrator e corpus batem com o texto oficial vigente.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
