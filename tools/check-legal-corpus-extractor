def carregar_gerador():
    """Importa o gerador pelo caminho — ele não tem extensão .py."""
    caminho = os.path.join(ROOT, "tools/generate-legal-corpus")
    spec = importlib.util.spec_from_loader(
        "generate_legal_corpus",
        importlib.machinery.SourceFileLoader("generate_legal_corpus", caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


