# === NOTA DE VIGÊNCIA: o que o texto oficial diz sobre o artigo ainda valer ===
#
# O art. 1.790 do Código Civil foi declarado inconstitucional no RE 878.694
# (Tema 809), e o Planalto avisa na própria transcrição. A nota estava no
# corpus, dissolvida no caput, e uma página publicada afirmou que o artigo
# "continua em vigor: sim". O campo registra o que o texto diz — a remissão
# prova que existe um processo, nunca como ele terminou.
NOTAS_DE_VIGENCIA = [
    ("(Vide Recurso Extraordinário nº 878.694)", "desafio_constitucional",
     "art. 1.790 do Código Civil"),
    ("(Vide \n ADIN 3392)", "desafio_constitucional",
