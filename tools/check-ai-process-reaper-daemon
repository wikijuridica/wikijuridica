#!/bin/bash
# check-ai-process-reaper-daemon — o reaper antigo enxerga daemon órfão?
#
# Ele protegia TODA árvore de `claude daemon run` incondicionalmente. Foi por
# esse buraco que, em 2026-08-19, um daemon com 50 descendentes e 1.242 MB
# sobreviveu à sessão que o criou: reparentou para o init e seguiu intocável,
# enquanto o script reportava "nenhum órfão".
#
# Dois casos, ambos com PPID==1 (via setsid) e idade forçada por --min-age-minutes 0:
#
#   A. daemon com `--spawned-by` apontando para pid MORTO  -> deve ser ALVO
#   B. daemon com `--spawned-by` apontando para pid VIVO   -> deve ser PROTEGIDO
#
# Sempre em dry-run. Não mata nada.

set -uo pipefail
REAPER="${REAPER:-$HOME/.local/bin/ai-process-reaper}"
[ -x "$REAPER" ] || {
	echo "reaper não encontrado em $REAPER"
	exit 2
}
command -v setsid >/dev/null 2>&1 || {
	echo "setsid ausente; não dá para montar a isca"
	exit 2
}

ISCAS=()
falhas=0
limpar() { for p in "${ISCAS[@]:-}"; do [ -n "$p" ] && kill "$p" 2>/dev/null; done; }
trap limpar EXIT INT TERM

# pid garantidamente morto: nasce e morre agora
(exit 0) &
MORTO=$!
wait "$MORTO" 2>/dev/null
while [ -d "/proc/$MORTO" ]; do command sleep 1; done

# pid garantidamente vivo, e que não é ancestral de ninguém importante
command sleep 300 &
VIVO=$!
ISCAS+=("$VIVO")

# A isca precisa ter o cmdline do daemon REAL, com caminho absoluto: o reaper
# varre por `pgrep -f 'share/claude/versions|/\.local/bin/claude'`, então uma
# isca chamada só "claude daemon run" não é escaneada e o teste mediria a si
# mesmo em vez do reaper.
isca() { # isca <pid-do-criador> -> imprime o pid da isca
	local criador="$1"
	setsid bash -c "exec -a '$HOME/.local/bin/claude daemon run --origin transient --spawned-by {\"label\":\"claude\",\"cwd\":\"/opt/wiki\",\"pid\":$criador}' sleep 120" >/dev/null 2>&1 &
	command sleep 2
	pgrep -f "\"pid\":$criador}" 2>/dev/null | head -1
}

confere() {
	if [ "$2" = "$3" ]; then
		printf '  ok    %-44s %s\n' "$1" "$3"
	else
		printf '  FALHA %-44s esperado=%s obtido=%s\n' "$1" "$2" "$3"
		falhas=$((falhas + 1))
	fi
}

echo "=== daemon órfão visto pelo ai-process-reaper ==="

A=$(isca "$MORTO")
if [ -n "$A" ]; then
	ISCAS+=("$A")
	# a saída é "órfão a reapear:<pid> <user> ..." — o pid vem colado no ':'
	saida=$("$REAPER" --min-age-minutes 0 2>/dev/null | grep -cE "(^|[^0-9])$A([^0-9]|\$)")
	confere "criador MORTO (deve ser alvo)" "1" "$([ "${saida:-0}" -ge 1 ] && echo 1 || echo 0)"
else
	echo "  (não foi possível montar a isca A)"
	falhas=$((falhas + 1))
fi

B=$(isca "$VIVO")
if [ -n "$B" ]; then
	ISCAS+=("$B")
	saida=$("$REAPER" --min-age-minutes 0 2>/dev/null | grep -cE "(^|[^0-9])$B([^0-9]|\$)")
	confere "criador VIVO (deve ser protegido)" "0" "$([ "${saida:-0}" -ge 1 ] && echo 1 || echo 0)"
else
	echo "  (não foi possível montar a isca B)"
	falhas=$((falhas + 1))
fi

echo
if [ "$falhas" -eq 0 ]; then
	echo "check-ai-process-reaper-daemon: passou."
	exit 0
fi
echo "check-ai-process-reaper-daemon: $falhas caso(s) falharam."
exit 1
