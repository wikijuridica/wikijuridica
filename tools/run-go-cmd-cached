}

current_wrapper_process_identity() {
	local boot_id stat_line remainder
	local -a fields
	boot_id="$(sed -n '1p' /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
	IFS= read -r stat_line <"/proc/$$/stat" 2>/dev/null || return 1
	[[ -n "$boot_id" && "$stat_line" == *') '* ]] || return 1
	remainder="${stat_line##*) }"
	read -r -a fields <<<"$remainder"
	[[ "${#fields[@]}" -ge 20 && "${fields[19]}" =~ ^[0-9]+$ ]] || return 1
	printf 'v1:%s:%s:%s' "$boot_id" "$$" "${fields[19]}"
}

run_command_with_timeout() {
	if ! command -v timeout >/dev/null 2>&1; then
		echo "run-go-cmd-cached: timeout command is required for supervised P0 command execution" >&2
		exit 75
	fi
	if ! timeout_supervision_is_verified; then
		if [[ "${WIKI_RUN_GO_CMD_CACHED_UNDER_TIMEOUT:-}" == v1:* ]]; then
			echo "run-go-cmd-cached: invalid authenticated outer-timeout marker; refusing recursive supervision" >&2
			exit 75
		fi
		local supervision_marker
		supervision_marker="$(current_wrapper_process_identity)" || {
			echo "run-go-cmd-cached: could not authenticate outer timeout process identity" >&2
			exit 75
		}
		exec timeout --kill-after="$TIMEOUT_KILL_AFTER_SPEC" "$WRAPPER_TIMEOUT_SPEC" env WIKI_RUN_GO_CMD_CACHED_UNDER_TIMEOUT="$supervision_marker" "$0" "$PKG" "$@"
	fi
}

