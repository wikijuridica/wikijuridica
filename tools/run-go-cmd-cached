parse_duration_milliseconds() {
	local duration="$1"
	local total_ms=0
	local value unit rest
	if [[ -z "$duration" ]]; then
		return 1
	fi
	while [[ -n "$duration" ]]; do
		if [[ "$duration" =~ ^([0-9]+)(ms|s|m|h)(.*)$ ]]; then
			value="${BASH_REMATCH[1]}"
			unit="${BASH_REMATCH[2]}"
			rest="${BASH_REMATCH[3]}"
			if [[ "${#value}" -gt 9 ]]; then
				return 1
			fi
			value=$((10#$value))
			case "$unit" in
			ms) total_ms=$((total_ms + value)) ;;
			s) total_ms=$((total_ms + value * 1000)) ;;
			m) total_ms=$((total_ms + value * 60 * 1000)) ;;
			h) total_ms=$((total_ms + value * 60 * 60 * 1000)) ;;
			esac
			if [[ "$total_ms" -gt $((MAX_WRAPPER_TIMEOUT_SECONDS * 1000)) ]]; then
				return 1
			fi
			duration="$rest"
			continue
		fi
		return 1
	done
	if [[ "$total_ms" -lt 1 ]]; then
		return 1
	fi
	printf '%s' "$total_ms"
}

parse_duration_seconds() {
	local total_ms
	total_ms="$(parse_duration_milliseconds "$1")" || return 1
	local seconds=$(((total_ms + 999) / 1000))
	if [[ "$seconds" -lt 1 ]]; then
		seconds=1
	fi
	printf '%s' "$seconds"
}

timeout_ms_from_max_duration() {
	local parsed
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--max-duration)
			shift
			if [[ $# -eq 0 ]]; then
				printf '0'
				return 0
			fi
			parsed="$(parse_duration_milliseconds "$1" 2>/dev/null || true)"
			printf '%s' "${parsed:-0}"
			return 0
			;;
		--max-duration=*)
			parsed="$(parse_duration_milliseconds "${1#--max-duration=}" 2>/dev/null || true)"
			printf '%s' "${parsed:-0}"
			return 0
			;;
		esac
		shift
	done
	printf '0'
}

timeout_seconds_from_max_duration() {
	local parsed_ms
	parsed_ms="$(timeout_ms_from_max_duration "$@")"
	if [[ "$parsed_ms" =~ ^[0-9]+$ && "$parsed_ms" -gt 0 ]]; then
		printf '%s' "$(((parsed_ms + 999) / 1000))"
		return 0
	fi
	printf '0'
}

timeout_ms_from_budget_ms() {
	local value
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--budget-ms)
			shift
			if [[ $# -eq 0 ]]; then
				printf '0'
				return 0
			fi
			value="$1"
			;;
		--budget-ms=*)
			value="${1#--budget-ms=}"
			;;
		*)
			shift
			continue
			;;
		esac
		if [[ "$value" =~ ^[0-9]+$ && "${#value}" -le 9 && "$value" -gt 0 && "$value" -le $((MAX_WRAPPER_TIMEOUT_SECONDS * 1000)) ]]; then
			printf '%s' "$value"
			return 0
		fi
		printf '0'
		return 0
	done
	printf '0'
}

timeout_seconds_from_budget_ms() {
	local parsed_ms
	parsed_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$parsed_ms" =~ ^[0-9]+$ && "$parsed_ms" -gt 0 ]]; then
		printf '%s' "$(((parsed_ms + 999) / 1000))"
		return 0
	fi
	printf '0'
}

format_timeout_spec_from_ms() {
	local value="$1"
	local whole fractional
	if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
		whole=$((value / 1000))
		fractional=$((value % 1000))
		if [[ "$fractional" -eq 0 ]]; then
			printf '%ss' "$whole"
		else
			printf '%s.%03ds' "$whole" "$fractional"
		fi
		return 0
	fi
	return 1
}

timeout_spec_from_budget_ms() {
	local value
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--budget-ms)
			shift
			if [[ $# -eq 0 ]]; then
				return 1
			fi
			value="$1"
			;;
		--budget-ms=*)
			value="${1#--budget-ms=}"
			;;
		*)
			shift
			continue
			;;
		esac
		if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
			format_timeout_spec_from_ms "$value"
			return 0
		fi
		return 1
	done
	return 1
}

validate_command_timeout_arguments() {
	local value parsed
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--max-duration)
			shift
			if [[ $# -eq 0 ]]; then
				echo "run-go-cmd-cached: --max-duration requires a positive duration no greater than ${MAX_WRAPPER_TIMEOUT_SECONDS}s" >&2
				exit 2
			fi
			value="$1"
			if ! parsed="$(parse_duration_milliseconds "$value" 2>/dev/null)"; then
				echo "run-go-cmd-cached: --max-duration must be positive and no greater than ${MAX_WRAPPER_TIMEOUT_SECONDS}s; shard/cache/optimize instead of extending it" >&2
				exit 2
			fi
			;;
		--max-duration=*)
			value="${1#--max-duration=}"
			if ! parsed="$(parse_duration_milliseconds "$value" 2>/dev/null)"; then
				echo "run-go-cmd-cached: --max-duration must be positive and no greater than ${MAX_WRAPPER_TIMEOUT_SECONDS}s; shard/cache/optimize instead of extending it" >&2
				exit 2
			fi
			;;
		--budget-ms)
			shift
			if [[ $# -eq 0 ]] || ! bounded_wrapper_milliseconds "$1"; then
				echo "run-go-cmd-cached: --budget-ms must be positive and no greater than $((MAX_WRAPPER_TIMEOUT_SECONDS * 1000)); shard/cache/optimize instead of extending it" >&2
				exit 2
			fi
			;;
		--budget-ms=*)
			value="${1#--budget-ms=}"
			if ! bounded_wrapper_milliseconds "$value"; then
				echo "run-go-cmd-cached: --budget-ms must be positive and no greater than $((MAX_WRAPPER_TIMEOUT_SECONDS * 1000)); shard/cache/optimize instead of extending it" >&2
				exit 2
			fi
			;;
		esac
		shift
	done
}

min_positive_timeout_seconds() {
	local left="$1"
	local right="$2"
	if [[ "$left" =~ ^[0-9]+$ && "$left" -gt 0 && "$right" =~ ^[0-9]+$ && "$right" -gt 0 ]]; then
		if [[ "$left" -lt "$right" ]]; then
			printf '%s' "$left"
		else
			printf '%s' "$right"
		fi
		return 0
	fi
	if [[ "$left" =~ ^[0-9]+$ && "$left" -gt 0 ]]; then
		printf '%s' "$left"
		return 0
	fi
	if [[ "$right" =~ ^[0-9]+$ && "$right" -gt 0 ]]; then
		printf '%s' "$right"
		return 0
	fi
	printf '0'
}

derive_run_timeout_seconds() {
	local env_seconds max_duration_seconds budget_seconds selected_seconds
	env_seconds="${WIKI_GO_CMD_TIMEOUT_SECONDS:-0}"
	max_duration_seconds="$(timeout_seconds_from_max_duration "$@")"
	budget_seconds="$(timeout_seconds_from_budget_ms "$@")"
	if [[ "$max_duration_seconds" =~ ^[0-9]+$ && "$max_duration_seconds" -gt 0 ]]; then
		max_duration_seconds=$((max_duration_seconds + RUN_TIMEOUT_GRACE_SECONDS))
	fi
	selected_seconds="$(min_positive_timeout_seconds "$env_seconds" "$max_duration_seconds")"
	selected_seconds="$(min_positive_timeout_seconds "$selected_seconds" "$budget_seconds")"
	if [[ "$selected_seconds" =~ ^[0-9]+$ && "$selected_seconds" -gt 0 ]]; then
		printf '%s' "$selected_seconds"
		return 0
	fi
	printf '300'
}

derive_run_timeout_spec() {
	local env_ms=0 max_duration_ms budget_ms max_with_grace_ms selected_ms=0
	if [[ -n "${WIKI_GO_CMD_TIMEOUT_SECONDS:-}" && "$WIKI_GO_CMD_TIMEOUT_SECONDS" =~ ^[0-9]+$ && "$WIKI_GO_CMD_TIMEOUT_SECONDS" -gt 0 ]]; then
		env_ms=$((WIKI_GO_CMD_TIMEOUT_SECONDS * 1000))
	fi
	max_duration_ms="$(timeout_ms_from_max_duration "$@")"
	budget_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$max_duration_ms" =~ ^[0-9]+$ && "$max_duration_ms" -gt 0 ]]; then
		max_with_grace_ms=$((max_duration_ms + RUN_TIMEOUT_GRACE_SECONDS * 1000))
	else
		max_with_grace_ms=0
	fi
	for candidate_ms in "$env_ms" "$max_with_grace_ms" "$budget_ms"; do
		if [[ "$candidate_ms" =~ ^[0-9]+$ && "$candidate_ms" -gt 0 ]]; then
			if [[ "$selected_ms" -eq 0 || "$candidate_ms" -lt "$selected_ms" ]]; then
				selected_ms="$candidate_ms"
			fi
		fi
	done
	if [[ "$selected_ms" -gt 0 ]]; then
		format_timeout_spec_from_ms "$selected_ms"
		return 0
	fi
	printf '%ss' "$(derive_run_timeout_seconds "$@")"
}

derive_wrapper_timeout_spec() {
	local run_seconds build_seconds total_seconds
	run_seconds="$(derive_run_timeout_seconds "$@")"
	build_seconds=$(((BUILD_BUDGET_MS + 999) / 1000))
	total_seconds=$((run_seconds + build_seconds + 1))
	if [[ "$BOOTSTRAP_CACHE_MODE" == "1" ]]; then
		# Two bounded context snapshots (before/after a build) plus bounded
		# metadata validation/install. This is a hard outer cap, not a retry budget.
		total_seconds=$((total_seconds + 2 * (2 * BUILD_IDENTITY_TIMEOUT_SECONDS + DEPENDENCY_LIST_TIMEOUT_SECONDS + 2 * METADATA_TIMEOUT_SECONDS) + 4 * METADATA_TIMEOUT_SECONDS))
	else
		# Fast-cache identity is collected once on a hit and again after a build:
		# each snapshot has two Go probes and two metadata/source-tree probes.
		# Reserve three more metadata windows for binary hash/install/revalidation.
		total_seconds=$((total_seconds + 2 * (2 * BUILD_IDENTITY_TIMEOUT_SECONDS + 2 * METADATA_TIMEOUT_SECONDS) + 3 * METADATA_TIMEOUT_SECONDS))
	fi
	# The kill-after interval is part of the same hard wall-clock ceiling. Signal
	# early enough that even a SIGTERM-ignoring tree is killed by the ceiling
	# second (MAX_WRAPPER_TIMEOUT_SECONDS).
	local outer_signal_seconds=$((MAX_WRAPPER_TIMEOUT_SECONDS - RUN_TIMEOUT_GRACE_SECONDS))
	if [[ "$total_seconds" -gt "$outer_signal_seconds" ]]; then
		total_seconds="$outer_signal_seconds"
	fi
	printf '%ss' "$total_seconds"
}

derive_repo_awareness_timeout() {
	if [[ -n "${WIKI_REPO_AWARENESS_TIMEOUT:-}" ]]; then
		printf '%s' "$WIKI_REPO_AWARENESS_TIMEOUT"
		return 0
	fi
	local max_duration_ms budget_ms selected_ms=0
	max_duration_ms="$(timeout_ms_from_max_duration "$@")"
	budget_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$max_duration_ms" =~ ^[0-9]+$ && "$max_duration_ms" -gt 0 ]]; then
		selected_ms="$max_duration_ms"
	fi
	if [[ "$budget_ms" =~ ^[0-9]+$ && "$budget_ms" -gt 0 ]]; then
		if [[ "$selected_ms" -eq 0 || "$budget_ms" -lt "$selected_ms" ]]; then
			selected_ms="$budget_ms"
		fi
	fi
	if [[ "$selected_ms" -gt 0 && "$selected_ms" -le 2000 ]]; then
		printf '0.05s'
		return 0
	fi
	printf '2s'
}

repo_awareness_fast_mode_from_args() {
	local max_duration_ms budget_ms selected_ms=0
	max_duration_ms="$(timeout_ms_from_max_duration "$@")"
	budget_ms="$(timeout_ms_from_budget_ms "$@")"
	if [[ "$max_duration_ms" =~ ^[0-9]+$ && "$max_duration_ms" -gt 0 ]]; then
		selected_ms="$max_duration_ms"
	fi
	if [[ "$budget_ms" =~ ^[0-9]+$ && "$budget_ms" -gt 0 ]]; then
		if [[ "$selected_ms" -eq 0 || "$budget_ms" -lt "$selected_ms" ]]; then
			selected_ms="$budget_ms"
		fi
	fi
	[[ "$selected_ms" -gt 0 && "$selected_ms" -le 2000 ]]
}

