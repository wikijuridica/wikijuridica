dependency_source_newer_than_bin() {
	local pkg="$1"
	local bin="$2"
	local deps dir package_dir deps_tmp
	if ! deps_build_root_matches; then
		return 0
	fi
	package_dir="${BUILD_SOURCE_ROOT}/${pkg#./}"
	if find "$package_dir" -maxdepth 0 \( -newer "$bin" -o -cnewer "$bin" \) -print -quit 2>/dev/null | grep -q .; then
		return 0
	fi
	if find "$package_dir" -maxdepth 1 -type f ! -name '*_test.go' \( -newer "$bin" -o -cnewer "$bin" \) -print -quit 2>/dev/null | grep -q .; then
		return 0
	fi
	if [[ -s "$DEPS_LIST" ]]; then
		deps="$(cat "$DEPS_LIST" 2>/dev/null || true)"
	else
		if deps="$(cd "$BUILD_SOURCE_ROOT" && run_go_tool_bounded "$DEPENDENCY_LIST_TIMEOUT_SECONDS" list -deps -tags devcmds -f '{{.Dir}}' "$pkg" 2>/dev/null)"; then
			deps_tmp="$DEPS_LIST.$$"
			printf '%s\n' "$deps" >"$deps_tmp"
			mv -fT -- "$deps_tmp" "$DEPS_LIST"
		else
			run_go_cmd_notice "dependency list timed out or failed for pkg=$pkg; using conservative cmd/internal source freshness fallback"
			if find "$BUILD_SOURCE_ROOT/cmd" "$BUILD_SOURCE_ROOT/internal" -type f ! -name '*_test.go' \( -newer "$bin" -o -cnewer "$bin" \) -print -quit 2>/dev/null | grep -q .; then
				return 0
			fi
			return 1
		fi
	fi
	deps_list_source_newer_than_bin "$deps" "$bin"
}

deps_build_root_matches() {
	local recorded_root
	if [[ -s "$DEPS_BUILD_ROOT" ]]; then
		recorded_root="$(sed -n '1p' "$DEPS_BUILD_ROOT" 2>/dev/null || true)"
		[[ "$recorded_root" == "$BUILD_SOURCE_ROOT" ]]
		return $?
	fi
	[[ "$BUILD_SOURCE_ROOT_EXPLICIT" == "0" ]]
}

deps_list_source_newer_than_bin() {
	local deps="$1"
	local bin="$2"
	local dir
	while IFS= read -r dir; do
		[[ -n "$dir" ]] || continue
		case "$dir" in
		"$BUILD_SOURCE_ROOT/.toolchains" | "$BUILD_SOURCE_ROOT/.toolchains"/*) continue ;;
		"$BUILD_SOURCE_ROOT" | "$BUILD_SOURCE_ROOT"/*) ;;
		*) continue ;;
		esac
		if find "$dir" -maxdepth 0 \( -newer "$bin" -o -cnewer "$bin" \) -print -quit 2>/dev/null | grep -q .; then
			return 0
		fi
		if find "$dir" -maxdepth 1 -type f ! -name '*_test.go' \( -newer "$bin" -o -cnewer "$bin" \) -print -quit 2>/dev/null | grep -q .; then
			return 0
		fi
	done <<<"$deps"
	return 1
}

