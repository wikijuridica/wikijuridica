#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "usage: run-go-cmd-cached ./cmd/name [args...]" >&2
	exit 2
fi

ROOT="$(
	unset CDPATH
	cd -- "$(dirname -- "$0")/.." && pwd
)"
PATH="$ROOT/tools:$PATH"
export PATH
# Cache persistente (ULTRAPLAN E2): /tmp evapora a cada boot e forcava cold-start
# recorrente de compilacao; o default do Go (~/.cache/go-build) e compartilhado
# com go-modern/pre-commit, entao todos os caminhos reusam o mesmo cache.
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

PKG="$1"
shift

case "$PKG" in
./cmd/*) ;;
*)
	echo "run-go-cmd-cached: package must be under ./cmd, got $PKG" >&2
	exit 2
	;;
esac

NAME="${PKG#./cmd/}"
case "$NAME" in
*[!A-Za-z0-9_-]* | "")
	echo "run-go-cmd-cached: invalid command name $NAME" >&2
	exit 2
	;;
esac

MAX_WRAPPER_TIMEOUT_SECONDS=1800
MAX_BUILD_BUDGET_MS=300000
MAX_LOCK_WAIT_SECONDS=300

BUILD_SOURCE_ROOT_EXPLICIT=0
if [[ -n "${WIKI_GO_CMD_BUILD_SOURCE_ROOT:-}" ]]; then
	BUILD_SOURCE_ROOT_EXPLICIT=1
	BUILD_SOURCE_ROOT="$WIKI_GO_CMD_BUILD_SOURCE_ROOT"
else
	BUILD_SOURCE_ROOT="$ROOT"
fi
case "$BUILD_SOURCE_ROOT" in
/*) ;;
*)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_SOURCE_ROOT must be a canonical absolute path" >&2
	exit 2
	;;
esac
resolved_build_source_root="$(realpath -e -- "$BUILD_SOURCE_ROOT" 2>/dev/null || true)"
if [[ -z "$resolved_build_source_root" || "$resolved_build_source_root" != "$BUILD_SOURCE_ROOT" || ! -d "$BUILD_SOURCE_ROOT" || -L "$BUILD_SOURCE_ROOT" ]]; then
	echo "run-go-cmd-cached: build source root must exist canonically without symlinks: $BUILD_SOURCE_ROOT" >&2
	exit 2
fi
if [[ ! -f "$BUILD_SOURCE_ROOT/go.mod" || -L "$BUILD_SOURCE_ROOT/go.mod" || ! -d "$BUILD_SOURCE_ROOT/cmd" || -L "$BUILD_SOURCE_ROOT/cmd" || ! -d "$BUILD_SOURCE_ROOT/internal" || -L "$BUILD_SOURCE_ROOT/internal" ]]; then
	echo "run-go-cmd-cached: build source root requires regular go.mod and non-symlink cmd/internal trees: $BUILD_SOURCE_ROOT" >&2
	exit 2
fi
if [[ -e "$BUILD_SOURCE_ROOT/go.sum" && (! -f "$BUILD_SOURCE_ROOT/go.sum" || -L "$BUILD_SOURCE_ROOT/go.sum") ]]; then
	echo "run-go-cmd-cached: build source root go.sum must be a regular non-symlink file" >&2
	exit 2
fi

positive_integer() {
	case "$1" in
	'' | *[!0-9]*) return 1 ;;
	esac
	[[ "$1" -gt 0 ]]
}

bounded_wrapper_milliseconds() {
	local value="$1"
	[[ "$value" =~ ^[0-9]+$ && "${#value}" -le 9 && "$value" -gt 0 && "$value" -le $((MAX_WRAPPER_TIMEOUT_SECONDS * 1000)) ]]
}

positive_duration() {
	case "$1" in
	'' | 0 | 0ms | 0s | 0m | 0h) return 1 ;;
	*[!0-9msh]*) return 1 ;;
	*ms | *s | *m | *h) return 0 ;;
	*) return 1 ;;
	esac
}

heavy_throughput_expected_is_numeric() {
	local contract="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-}" numeric
	if [[ ! "$contract" =~ ^(records_per_second|pages_per_second|urls_per_second|items_per_second|records/s|pages/s|throughput)=([0-9]+([.][0-9]+)?)$ ]]; then
		return 1
	fi
	numeric="${BASH_REMATCH[2]}"
	awk -v value="$numeric" 'BEGIN { exit !(value + 0 > 0) }'
}

cached_generate_has_budget_arg() {
	local expect_budget_value=0
	for arg in "$@"; do
		if [[ "$expect_budget_value" == "1" ]]; then
			positive_integer "$arg"
			return $?
		fi
		case "$arg" in
		--budget-ms=*)
			positive_integer "${arg#--budget-ms=}"
			return $?
			;;
		--budget-ms)
			expect_budget_value=1
			;;
		esac
	done
	return 1
}

cached_generate_has_timings_arg() {
	local arg
	for arg in "$@"; do
		if [[ "$arg" == "--timings" ]]; then
			return 0
		fi
	done
	return 1
}

heavy_supervisor_ancestry_is_verified() {
	[[ "${WIKI_RUN_GO_CMD_CACHED_UNDER_HEAVY:-}" == "1" ]] || return 1
	command -v python3 >/dev/null 2>&1 || return 1
	python3 - "$ROOT" "$(realpath -e -- "$0" 2>/dev/null || true)" <<'PY'
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
runner = pathlib.Path(sys.argv[2])
heavy = root / "tools" / "run-heavy-throttled"
supervisor = root / "tools" / "supervise-process-tree"
expected_uid = os.geteuid()

if not runner.is_absolute() or not heavy.is_file() or not supervisor.is_file():
    raise SystemExit(1)

def canonical_argument(argument: bytes, cwd: pathlib.Path, path_value: str) -> pathlib.Path | None:
    try:
        text = os.fsdecode(argument)
        candidate = pathlib.Path(text)
        if not candidate.is_absolute() and "/" not in text:
            for entry in path_value.split(os.pathsep):
                base = pathlib.Path(entry) if entry else cwd
                if not base.is_absolute():
                    base = cwd / base
                resolved_candidate = base / candidate
                try:
                    if resolved_candidate.is_file() and os.access(resolved_candidate, os.X_OK):
                        return resolved_candidate.resolve(strict=True)
                except OSError:
                    continue
            return None
        if not candidate.is_absolute():
            candidate = cwd / candidate
        return candidate.resolve(strict=True)
    except (OSError, RuntimeError, UnicodeError):
        return None

def read_process(pid: int) -> tuple[int, list[bytes], pathlib.Path, str, pathlib.Path]:
    proc = pathlib.Path("/proc") / str(pid)
    status = (proc / "status").read_text(encoding="ascii", errors="strict")
    parent = None
    owner = None
    for line in status.splitlines():
        if line.startswith("PPid:"):
            parent = int(line.split()[1])
        elif line.startswith("Uid:"):
            owner = int(line.split()[1])
    if parent is None or owner != expected_uid:
        raise OSError("untrusted process owner or parent")
    with (proc / "cmdline").open("rb") as command_file:
        payload = command_file.read(256 * 1024 + 1)
    if not payload or len(payload) > 256 * 1024:
        raise OSError("missing or oversized process command line")
    arguments = [part for part in payload.split(b"\0") if part]
    cwd = (proc / "cwd").resolve(strict=True)
    with (proc / "environ").open("rb") as environment_file:
        environment_payload = environment_file.read(256 * 1024 + 1)
    if len(environment_payload) > 256 * 1024:
        raise OSError("oversized process environment")
    path_value = ""
    for item in environment_payload.split(b"\0"):
        if item.startswith(b"PATH="):
            path_value = os.fsdecode(item.removeprefix(b"PATH="))
            break
    executable = (proc / "exe").resolve(strict=True)
    executable_info = executable.stat()
    if (
        not stat.S_ISREG(executable_info.st_mode)
        or executable_info.st_uid not in (0, expected_uid)
        or executable_info.st_mode & 0o022
    ):
        raise OSError("untrusted process executable")
    return parent, arguments, cwd, path_value, executable

def trusted_interpreters(target: pathlib.Path, cwd: pathlib.Path, path_value: str) -> set[pathlib.Path]:
    try:
        with target.open("rb") as target_file:
            first_line = target_file.readline(4097)
    except OSError:
        return set()
    if len(first_line) > 4096 or not first_line.startswith(b"#!"):
        return set()
    try:
        words = os.fsdecode(first_line[2:].strip()).split()
    except UnicodeError:
        return set()
    if not words:
        return set()
    interpreter = canonical_argument(os.fsencode(words[0]), cwd, path_value)
    trusted = {interpreter} if interpreter is not None else set()
    # /usr/bin/env replaces itself with the selected interpreter, so the live
    # process executable is the command after `env`, not env itself.
    if interpreter is not None and interpreter.name == "env" and len(words) >= 2:
        selected = canonical_argument(os.fsencode(words[-1]), cwd, path_value)
        if selected is not None:
            trusted.add(selected)
    return trusted

def invokes_script(
    arguments: list[bytes], cwd: pathlib.Path, path_value: str,
    executable: pathlib.Path, target: pathlib.Path,
) -> bool:
    # A real shebang-backed script is argv[1] of its live interpreter. Merely
    # assigning the script path to a forged argv[0] must not authenticate an
    # unrelated shell/process as run-heavy or supervise-process-tree.
    if len(arguments) < 2 or canonical_argument(arguments[1], cwd, path_value) != target:
        return False
    return executable in trusted_interpreters(target, cwd, path_value)

def contains_runner(arguments: list[bytes], cwd: pathlib.Path, path_value: str) -> bool:
    return any(canonical_argument(argument, cwd, path_value) == runner for argument in arguments)

pid = os.getppid()
seen: set[int] = set()
supervisor_seen = False
for _ in range(64):
    if pid <= 1 or pid in seen:
        break
    seen.add(pid)
    try:
        parent, arguments, cwd, path_value, executable = read_process(pid)
    except (OSError, ValueError, UnicodeError):
        raise SystemExit(1)
    if invokes_script(arguments, cwd, path_value, executable, supervisor) and contains_runner(arguments, cwd, path_value):
        supervisor_seen = True
    elif supervisor_seen and invokes_script(arguments, cwd, path_value, executable, heavy) and contains_runner(arguments, cwd, path_value):
        raise SystemExit(0)
    pid = parent
raise SystemExit(1)
PY
}

validate_cached_generate_command_contract() {
	# ./cmd/generate is the multiplexed launcher (subcommand form). It must be
	# held to the SAME supervised P0 contract as the standalone ./cmd/generate-*
	# tools. This is additive: the ./cmd/generate-* branch is unchanged, so the
	# non-migrated tools behave exactly as before.
	case "$PKG" in
	./cmd/generate | ./cmd/generate-*) ;;
	*) return 0 ;;
	esac

	missing=""
	local heavy_supervision_verified=0
	if heavy_supervisor_ancestry_is_verified; then
		heavy_supervision_verified=1
	else
		missing="${missing} run-heavy-throttled"
	fi
	if [[ -z "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-}" || -z "${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-}" || -z "${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-}" ]]; then
		missing="${missing} artifact_claim"
	fi
	if ! positive_integer "${WIKI_HEAVY_BUDGET_MS:-}" && ! cached_generate_has_budget_arg "$@"; then
		missing="${missing} budget_ms"
	fi
	if [[ -n "${WIKI_HEAVY_BUDGET_MS:-}" ]] && ! bounded_wrapper_milliseconds "$WIKI_HEAVY_BUDGET_MS"; then
		missing="${missing} budget_ms_exceeds_${MAX_WRAPPER_TIMEOUT_SECONDS}s_or_invalid"
	fi
	if ! positive_integer "${WIKI_HEAVY_EXPECTED_DURATION_MS:-}"; then
		missing="${missing} expected_duration_ms"
	fi
	if [[ -n "${WIKI_HEAVY_EXPECTED_DURATION_MS:-}" ]] && ! bounded_wrapper_milliseconds "$WIKI_HEAVY_EXPECTED_DURATION_MS"; then
		missing="${missing} expected_duration_ms_exceeds_${MAX_WRAPPER_TIMEOUT_SECONDS}s_or_invalid"
	fi
	if [[ -z "${WIKI_HEAVY_STOP_CONDITION:-}" ]]; then
		missing="${missing} stop_condition"
	fi
	if ! heavy_throughput_expected_is_numeric; then
		missing="${missing} throughput_expected"
	fi
	case "${WIKI_HEAVY_TIMING_MODE:-}" in
	'')
		if ! cached_generate_has_timings_arg "$@"; then
			missing="${missing} timing_evidence(--timings or supervisor_wall_clock_v1)"
		fi
		;;
	child_flag_v1)
		if ! cached_generate_has_timings_arg "$@"; then
			missing="${missing} --timings(child_flag_v1 capability)"
		fi
		;;
	supervisor_wall_clock_v1)
		if [[ "$heavy_supervision_verified" != "1" ]]; then
			missing="${missing} supervisor_wall_clock_without_verified_run-heavy-process-tree"
		fi
		;;
	*) missing="${missing} invalid_WIKI_HEAVY_TIMING_MODE" ;;
	esac
	if [[ -n "$missing" ]]; then
		echo "run-go-cmd-cached: ./cmd/generate-* requires run-heavy-throttled supervision with explicit artifact_claim, numeric budget/expected duration, stop_condition, numeric throughput_expected and real child or supervisor timing evidence; missing:$missing command=$PKG $*" >&2
		exit 2
	fi
}

validate_cached_generate_command_contract "$@"

# Binarios cacheados persistem no repo (.cache/ e gitignored) em vez de /tmp,
# que evapora a cada boot e forcava recompilar todos os geradores (ULTRAPLAN E2).
CACHE_ROOT="${WIKI_GO_CMD_BIN_CACHE:-$ROOT/.cache/go-cmd-bin}"
case "$CACHE_ROOT" in
/*) ;;
*)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BIN_CACHE must be a canonical absolute path" >&2
	exit 2
	;;
esac
CACHE_DIR="$CACHE_ROOT/$NAME"
BIN="$CACHE_DIR/$NAME"
DEPS_LIST="$CACHE_DIR/deps.list"
DEPS_BUILD_ROOT="$CACHE_DIR/deps.build-root"
LOCK_DIR="$CACHE_DIR/build.lock"
LOCK_META="$LOCK_DIR/meta"
LOCK_METADATA_TMP=""
BUILD_LOCK_OWNED=0
BUILD_METADATA="$CACHE_DIR/bootstrap-build-metadata.json"
BUILD_METADATA_SHA256="$CACHE_DIR/bootstrap-build-metadata.sha256"
BUILD_METADATA_STORE="$CACHE_DIR/bootstrap-build-metadata.d"
BUILD_IDENTITY="$CACHE_DIR/build-identity.json"
BUILD_BINARY_SHA256="$CACHE_DIR/build-binary.sha256"
ENV_WRAPPER="${WIKI_GO_CMD_ENV_WRAPPER:-}"
LOCK_WAIT_SECONDS="${WIKI_GO_CMD_BUILD_LOCK_WAIT_SECONDS:-300}"
LOCK_STALE_SECONDS="${WIKI_GO_CMD_BUILD_LOCK_STALE_SECONDS:-900}"
LOCK_META_INIT_GRACE_MS="${WIKI_GO_CMD_BUILD_LOCK_META_INIT_GRACE_MS:-500}"
# 2026-07-31 (bug medido ao vivo, sandbox Cowork/virtiofs): liberar OU reciclar
# o lock de build dependia exclusivamente de rmdir/unlink. Em mount que nega
# DELETE (EPERM), (a) o dono nunca conseguia soltar o proprio lock e (b) o
# candidato nunca conseguia despejar o lock de uma sessao morta -- as duas
# metades de reclaim_stale_build_lock terminam em "rm -f || return 1". Caso
# real: .cache/go-cmd-bin/finalize-v2-semantic-recut/build.lock ficou orfao de
# 2026-07-30 22:49 (pid 81, boot_id de outro boot) e travou o wrapper para
# sempre, invocacao apos invocacao. Correcao: heartbeat renovado DENTRO do
# lock-dir como prova de vida do detentor + despejo por RENAME atomico do
# lock-dir (que o mount permite), com rmdir/unlink apenas como limpeza
# best-effort. A exclusao mutua no caso sao fica intacta: heartbeat fresco
# nunca e despejado, e o vencedor continua sendo decidido pelo mkdir atomico.
LOCK_HEARTBEAT="$LOCK_DIR/heartbeat"
LOCK_EVICTED_ROOT="$CACHE_DIR/.build.lock.evicted"
LOCK_HEARTBEAT_INTERVAL_SECONDS="${WIKI_GO_CMD_BUILD_LOCK_HEARTBEAT_INTERVAL_SECONDS:-5}"
LOCK_HEARTBEAT_STALE_SECONDS="${WIKI_GO_CMD_BUILD_LOCK_HEARTBEAT_STALE_SECONDS:-120}"
LOCK_HEARTBEAT_RENEWER_PID=""
BUILD_LOCK_OWNED_IDENTITY=""
WRAPPER_PID="$$"
BUILD_BUDGET_MS="${WIKI_GO_CMD_BUILD_BUDGET_MS:-180000}"
BUILD_IDENTITY_TIMEOUT_SECONDS="${WIKI_GO_CMD_BUILD_IDENTITY_TIMEOUT_SECONDS:-10}"
DEPENDENCY_LIST_TIMEOUT_SECONDS="${WIKI_GO_CMD_DEPENDENCY_LIST_TIMEOUT_SECONDS:-15}"
METADATA_TIMEOUT_SECONDS="${WIKI_GO_CMD_METADATA_TIMEOUT_SECONDS:-15}"
RUN_TIMEOUT_GRACE_SECONDS="${WIKI_GO_CMD_TIMEOUT_GRACE_SECONDS:-5}"
BOOTSTRAP_SOURCE_CONTRACT="${WIKI_BOOTSTRAP_SOURCE_CONTRACT_SHA256:-}"
BOOTSTRAP_CACHE_MODE=0
BOOTSTRAP_CONTEXT_FILE=""
BOOTSTRAP_CLOSURE_FILE=""
BOOTSTRAP_GO_ENV_FILE=""
BOOTSTRAP_CONTEXT_SHA256=""
CURRENT_METADATA_SHA256=""
CURRENT_BINARY_SHA256=""
CURRENT_CLOSURE_SHA256=""
CURRENT_BUILD_SOURCE_SHA256=""
GENERAL_CONTEXT_FILE=""
GENERAL_GO_ENV_FILE=""
GENERAL_CONTEXT_SHA256=""
if [[ -n "$BOOTSTRAP_SOURCE_CONTRACT" ]]; then
	if [[ "$BOOTSTRAP_SOURCE_CONTRACT" =~ ^sha256:[0-9a-f]{64}$ ]]; then
		BOOTSTRAP_CACHE_MODE=1
		if ! command -v base64 >/dev/null 2>&1; then
			echo "run-go-cmd-cached: base64 is required for machine-readable bootstrap metadata paths" >&2
			exit 75
		fi
	else
		echo "run-go-cmd-cached: WIKI_BOOTSTRAP_SOURCE_CONTRACT_SHA256 must be a canonical sha256 token" >&2
		exit 2
	fi
fi
REPO_AWARENESS_TIMEOUT="${WIKI_REPO_AWARENESS_TIMEOUT:-}"
REPO_AWARENESS_TIMEOUT_EXPLICIT=0
# ULTRAPLAN E2/DEC-016: a "repo awareness" completa custa 7 comandos git por
# invocacao (~5s de CPU em repo grande) e e burocracia de processo (DEC-002).
# Default agora e o modo rapido; a coleta completa exige WIKI_REPO_AWARENESS_FULL=1.
if [[ "${WIKI_REPO_AWARENESS_FULL:-0}" == "1" ]]; then
	REPO_AWARENESS_FAST_MODE=0
else
	REPO_AWARENESS_FAST_MODE=1
fi
if [[ -n "${WIKI_REPO_AWARENESS_TIMEOUT+x}" ]]; then
	REPO_AWARENESS_TIMEOUT_EXPLICIT=1
fi
if ! mkdir -p "$CACHE_DIR" 2>/dev/null; then
	echo "run-go-cmd-cached: cannot create command cache directory: $CACHE_DIR" >&2
	exit 75
fi
resolved_cache_dir="$(realpath -e -- "$CACHE_DIR" 2>/dev/null || true)"
if [[ -z "$resolved_cache_dir" || "$resolved_cache_dir" != "$CACHE_DIR" ]]; then
	echo "run-go-cmd-cached: command cache path must be canonical and must not cross symlinks: path=$CACHE_DIR resolved=${resolved_cache_dir:-missing}" >&2
	exit 75
fi
cache_owner_uid="$(stat -c %u "$CACHE_DIR" 2>/dev/null || printf 'unknown')"
cache_mode="$(stat -c %a "$CACHE_DIR" 2>/dev/null || printf 'unknown')"
cache_mode_is_safe=0
if [[ "$cache_mode" =~ ^[0-7]+$ ]] && (((8#$cache_mode & 8#022) == 0)); then
	cache_mode_is_safe=1
fi
if [[ ! -d "$CACHE_DIR" || -L "$CACHE_DIR" || ! -w "$CACHE_DIR" || "$cache_owner_uid" != "$(id -u)" || "$cache_mode_is_safe" != "1" ]]; then
	echo "run-go-cmd-cached: command cache directory must be writable, non-symlink, current-user-owned and not group/world-writable: owner_uid=$cache_owner_uid mode=$cache_mode expected_uid=$(id -u) path=$CACHE_DIR" >&2
	exit 75
fi

# A safe leaf is not sufficient when another user can rename one of its
# ancestors and replace the whole cache between validation and exec. Sticky
# roots such as /tmp are safe only when owned by root/current user; every other
# group/world-writable ancestor is rejected.
cache_ancestor="$CACHE_ROOT"
while :; do
	cache_ancestor_owner="$(stat -c %u "$cache_ancestor" 2>/dev/null || printf 'unknown')"
	cache_ancestor_mode="$(stat -c %a "$cache_ancestor" 2>/dev/null || printf 'unknown')"
	if [[ ! "$cache_ancestor_owner" =~ ^[0-9]+$ || ! "$cache_ancestor_mode" =~ ^[0-7]+$ ]]; then
		echo "run-go-cmd-cached: cannot authenticate cache ancestor: path=$cache_ancestor owner_uid=$cache_ancestor_owner mode=$cache_ancestor_mode" >&2
		exit 75
	fi
	if (((8#$cache_ancestor_mode & 8#022) != 0)); then
		if (((8#$cache_ancestor_mode & 8#1000) == 0)) || [[ "$cache_ancestor_owner" != "0" && "$cache_ancestor_owner" != "$EUID" ]]; then
			echo "run-go-cmd-cached: cache ancestor is replaceable by another user: path=$cache_ancestor owner_uid=$cache_ancestor_owner mode=$cache_ancestor_mode" >&2
			exit 75
		fi
	fi
	[[ "$cache_ancestor" == "/" ]] && break
	cache_ancestor="${cache_ancestor%/*}"
	[[ -n "$cache_ancestor" ]] || cache_ancestor="/"
done

if [[ -n "$ENV_WRAPPER" ]]; then
	resolved_env_wrapper="$(realpath -e -- "$ENV_WRAPPER" 2>/dev/null || true)"
	env_wrapper_owner="$(stat -c %u "$resolved_env_wrapper" 2>/dev/null || printf 'unknown')"
	env_wrapper_mode="$(stat -c %a "$resolved_env_wrapper" 2>/dev/null || printf 'unknown')"
	env_wrapper_mode_is_safe=0
	if [[ "$env_wrapper_mode" =~ ^[0-7]+$ ]] && (((8#$env_wrapper_mode & 8#022) == 0)); then
		env_wrapper_mode_is_safe=1
	fi
	if [[ -z "$resolved_env_wrapper" || ! -f "$resolved_env_wrapper" || ! -x "$resolved_env_wrapper" ||
		! "$env_wrapper_owner" =~ ^[0-9]+$ || ("$env_wrapper_owner" != "0" && "$env_wrapper_owner" != "$EUID") ||
		"$env_wrapper_mode_is_safe" != "1" ]]; then
		echo "run-go-cmd-cached: WIKI_GO_CMD_ENV_WRAPPER must resolve to a safe root/current-user-owned executable wrapper, got $ENV_WRAPPER owner_uid=$env_wrapper_owner mode=$env_wrapper_mode" >&2
		exit 2
	fi
	ENV_WRAPPER="$resolved_env_wrapper"
fi

case "$LOCK_WAIT_SECONDS" in
'' | *[!0-9]*)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_WAIT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
if [[ "$LOCK_WAIT_SECONDS" -gt "$MAX_LOCK_WAIT_SECONDS" ]]; then
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_WAIT_SECONDS must not exceed ${MAX_LOCK_WAIT_SECONDS}s; reorient/shard instead of extending a passive wait" >&2
	exit 2
fi
case "$LOCK_STALE_SECONDS" in
'' | *[!0-9]* | 0)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_STALE_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
case "$LOCK_META_INIT_GRACE_MS" in
'' | *[!0-9]*)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_META_INIT_GRACE_MS must be numeric milliseconds" >&2
	exit 2
	;;
esac
if [[ "$LOCK_META_INIT_GRACE_MS" -gt 5000 ]]; then
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_META_INIT_GRACE_MS must not exceed 5000 milliseconds" >&2
	exit 2
fi
# `0*` alem de `0`: o padrao antigo recusava `0` e ACEITAVA `00`, `000` e `007`.
# Nao e teoria — medido em 2026-09-05 sob refutacao adversarial: com `00`,
# `sleep 00` volta em 2 ms e o renovador reescreve o heartbeat 105+ vezes em 2 s,
# queimando CPU durante todo o build. `007` e pior ainda, porque parece 7 e nao
# e: em `[[ ... -gt 60 ]]` o bash le base 8. Recusar todo prefixo zero mata as
# duas armadilhas de uma vez, e a mensagem ja diz "positive integer".
case "$LOCK_HEARTBEAT_INTERVAL_SECONDS" in
'' | *[!0-9]* | 0*)
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_HEARTBEAT_INTERVAL_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
if [[ "$LOCK_HEARTBEAT_INTERVAL_SECONDS" -gt 60 ]]; then
	echo "run-go-cmd-cached: WIKI_GO_CMD_BUILD_LOCK_HEARTBEAT_INTERVAL_SECONDS must not exceed 60 seconds" >&2
	exit 2
fi
case "$LOCK_HEARTBEAT_STALE_SECONDS" in
