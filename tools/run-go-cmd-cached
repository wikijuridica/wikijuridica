inline_token() {
	tr '\n' ' ' <<<"$1" | sed 's/[[:space:]][[:space:]]*/_/g'
}

run_go_cmd_notice() {
	echo "run-go-cmd-cached: $*" >&2
}

sha256_token() {
	case "$1" in
	sha256:????????????????????????????????????????????????????????????????)
		printf '%s' "$1"
		return 0
		;;
	esac
	printf '%s' "$1" | sha256sum | awk '{print "sha256:" $1}'
}

base64_token() {
	printf '%s' "$1" | base64 -w0
}

repo_metric_for() {
	local metric tmp
	tmp="$(mktemp "${TMPDIR:-/tmp}/wiki-repo-awareness.XXXXXX" 2>/dev/null || true)"
	if [[ -z "$tmp" ]]; then
		printf 'unavailable'
		return 0
	fi
	if command -v timeout >/dev/null 2>&1; then
		if timeout --kill-after="$TIMEOUT_KILL_AFTER_SPEC" "$REPO_AWARENESS_TIMEOUT" "$@" >"$tmp" 2>/dev/null; then
			metric="$(cksum "$tmp" 2>/dev/null | awk '{print "cksum:" $1 ":bytes:" $2}')"
		else
			if [[ "$REPO_AWARENESS_TIMEOUT_EXPLICIT" == "1" ]]; then
				metric="unavailable"
			else
				metric="$(
					printf 'timed_out:%s\n' "$*" |
						cksum 2>/dev/null | awk '{print "timed_out:cksum:" $1 ":bytes:" $2}'
				)"
			fi
		fi
	else
		if "$@" >"$tmp" 2>/dev/null; then
			metric="$(cksum "$tmp" 2>/dev/null | awk '{print "cksum:" $1 ":bytes:" $2}')"
		else
			metric="unavailable"
		fi
	fi
	rm -f "$tmp"
	if [[ -z "$metric" ]]; then
		metric="unavailable"
	fi
	printf '%s' "$metric"
}

repo_head_show_metric() {
