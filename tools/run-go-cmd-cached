validate_build_lock_wait_classification_or_exit() {
	local classification missing observed_owner_pid
	classification="${WIKI_GO_CMD_BUILD_LOCK_WAIT_CLASSIFICATION:-}"
	case "$classification" in
	non_critical_wait)
		echo "run-go-cmd-cached: non_critical_wait forbids passive build lock sleep; reorient to independent P0 front lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-go-cmd-cached $PKG $*")" >&2
		exit 75
		;;
	critical_dependency)
		missing=""
		case "${WIKI_GO_CMD_BUILD_LOCK_DEPENDENCY_ID:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} dependency_id" ;; esac
		case "${WIKI_GO_CMD_BUILD_LOCK_OWNER_PID:-}" in '' | *[!0-9]*) missing="${missing} owner_pid" ;; esac
		observed_owner_pid="$(lock_meta_first pid)"
		if [[ "${WIKI_GO_CMD_BUILD_LOCK_OWNER_PID:-}" =~ ^[0-9]+$ && "$observed_owner_pid" != "$WIKI_GO_CMD_BUILD_LOCK_OWNER_PID" ]]; then
			missing="${missing} owner_pid_mismatch(observed=${observed_owner_pid:-missing})"
		fi
		case "${WIKI_GO_CMD_BUILD_LOCK_WAIT_TIMEOUT_MS:-}" in '' | *[!0-9]* | 0) missing="${missing} timeout_ms" ;; esac
		case "${WIKI_GO_CMD_BUILD_LOCK_LAST_EVIDENCE:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} ultima_evidencia" ;; esac
		case "${WIKI_GO_CMD_BUILD_LOCK_REORIENTATION_COMMAND:-}" in '' | *placeholder* | *later* | *todo*) missing="${missing} comando_reorientacao" ;; esac
		if [[ -n "$missing" ]]; then
			echo "run-go-cmd-cached: critical_dependency build lock wait missing structured fields:$missing lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-go-cmd-cached $PKG $*")" >&2
			exit 75
		fi
		;;
	*)
		echo "run-go-cmd-cached: active build lock requires WIKI_GO_CMD_BUILD_LOCK_WAIT_CLASSIFICATION=critical_dependency with dependency_id/owner_pid/timeout_ms/ultima_evidencia/comando_reorientacao or non_critical_wait reorientation; refusing passive sleep lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-go-cmd-cached $PKG $*")" >&2
		exit 75
		;;
	esac
}

critical_build_lock_wait_timeout_ms() {
	if [[ "${WIKI_GO_CMD_BUILD_LOCK_WAIT_CLASSIFICATION:-}" == "critical_dependency" ]]; then
		case "${WIKI_GO_CMD_BUILD_LOCK_WAIT_TIMEOUT_MS:-}" in
		'' | *[!0-9]*) printf '0' ;;
		*) printf '%s' "$WIKI_GO_CMD_BUILD_LOCK_WAIT_TIMEOUT_MS" ;;
		esac
		return 0
	fi
	printf '0'
}

# ── 2026-07-31: staleness sem depender de DELETE ─────────────────────────────
# Todo o reclaim antigo terminava em "rm -f meta || return 1" + "rmdir || return
# 1". Em mount que nega unlink/rmdir (EPERM), isso reprovava SEMPRE: lock de
# sessao morta virava permanente e nenhuma invocacao futura conseguia buildar.
# As primitivas abaixo trocam o mecanismo (rename atomico) sem afrouxar o
# criterio (identidade de encarnacao do processo + heartbeat renovado).
build_lock_dir_identity() {
	stat -c '%d:%i' "$LOCK_DIR" 2>/dev/null || printf 'missing'
}

snapshot_field() {
	local key="$1" payload="$2"
	awk -v prefix="${key}:" 'index($0, prefix) == 1 { print substr($0, length(prefix) + 1); exit }' <<<"$payload"
}

# Despeja o lock-dir liberando o caminho para o proximo mkdir atomico. Quando
# expected_identity e informado, o despejo so acontece se o dev:ino observado
# ainda for aquele -- e a garantia de que nao estamos despejando um lock NOVO
# que nasceu entre a analise e a acao. Imprime o dev:ino despejado.
evict_build_lock_directory() {
	local expected_identity="${1:-}" keep_evidence="${2:-1}" evicted_name
	[[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || return 1
	evicted_name="$(date +%s 2>/dev/null || printf '0')-${WRAPPER_PID}-${RANDOM}"
	python3 - "$LOCK_DIR" "$LOCK_EVICTED_ROOT" "$evicted_name" "$expected_identity" "$keep_evidence" <<'PY'
import os
import shutil
import stat
import sys

lock_dir, evicted_root, evicted_name, expected_identity, keep_evidence = sys.argv[1:6]

try:
    info = os.lstat(lock_dir)
except OSError:
    raise SystemExit(1)

# Nunca despejar algo que nao seja o diretorio de lock do proprio usuario.
if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
    raise SystemExit(1)

identity = f"{info.st_dev}:{info.st_ino}"
if expected_identity and expected_identity != "missing" and expected_identity != identity:
    raise SystemExit(1)

try:
    os.makedirs(evicted_root, mode=0o700, exist_ok=True)
except OSError:
    raise SystemExit(1)

target = os.path.join(evicted_root, evicted_name)
try:
    # rename(2) e all-or-nothing e a janela entre o lstat acima e ele e de
    # microssegundos no mesmo processo. Ou o caminho do lock fica livre, ou
    # nada muda -- nunca o meio-termo "meta apagado, diretorio de pe" que o
    # par unlink+rmdir produzia quando o segundo passo falhava.
    os.rename(lock_dir, target)
except OSError:
    # Sem rename utilizavel, cai para o caminho legado (ainda funciona onde
    # DELETE e permitido). Se tambem falhar, nada foi tocado.
    try:
        for entry in os.listdir(lock_dir):
            os.unlink(os.path.join(lock_dir, entry))
        os.rmdir(lock_dir)
    except OSError:
        raise SystemExit(1)
    print(identity)
    raise SystemExit(0)

if keep_evidence != "1":
    # Liberacao pelo proprio dono nao vira evidencia forense; onde DELETE e
    # permitido isso evita acumular lixo, e onde e negado o ignore_errors
    # apenas deixa o diretorio despejado parado, inofensivo.
    shutil.rmtree(target, ignore_errors=True)
print(identity)
PY
}

# Prova de vida de uma encarnacao especifica. Sem dados de encarnacao, o pid
# vivo e a unica evidencia disponivel e vale como VIVO (conservador: na duvida,
# respeita o lock).
build_lock_process_incarnation_is_live() {
	local pid="$1" recorded_boot_id="${2:-}" recorded_start_ticks="${3:-}" live_boot_id live_start_ticks
	case "$pid" in
	'' | *[!0-9]*) return 1 ;;
	esac
	process_exists "$pid" || return 1
	if [[ -z "$recorded_boot_id" || "$recorded_boot_id" == "unknown" || ! "$recorded_start_ticks" =~ ^[0-9]+$ ]]; then
		return 0
	fi
	live_boot_id="$(process_boot_id 2>/dev/null || true)"
	live_start_ticks="$(process_start_ticks "$pid" 2>/dev/null || true)"
	if [[ -z "$live_boot_id" || ! "$live_start_ticks" =~ ^[0-9]+$ ]]; then
		return 0
	fi
	[[ "$recorded_boot_id" == "$live_boot_id" && "$recorded_start_ticks" == "$live_start_ticks" ]]
}

# Imprime "<veredito> <pid> <idade_s>", com veredito em:
#   absent       -- sem heartbeat legivel/atribuivel: decidem as regras antigas
#   fresh        -- alguem esta renovando: respeitar mesmo alem do orcamento
#   stale_live   -- parou de renovar, mas o processo dono existe: respeitar
#   stale_orphan -- parou de renovar E o processo dono nao existe: orfao
build_lock_heartbeat_verdict() {
	local snapshot epoch now age hb_pid hb_boot_id hb_start_ticks
	if [[ ! -e "$LOCK_HEARTBEAT" && ! -L "$LOCK_HEARTBEAT" ]]; then
		printf 'absent 0 0'
		return 0
	fi
	if ! snapshot="$(read_lock_metadata_snapshot "$LOCK_HEARTBEAT" 2>/dev/null)"; then
		printf 'absent 0 0'
		return 0
	fi
	hb_pid="$(snapshot_field pid "$snapshot")"
	hb_boot_id="$(snapshot_field boot_id "$snapshot")"
	hb_start_ticks="$(snapshot_field start_ticks "$snapshot")"
	epoch="$(snapshot_field epoch "$snapshot")"
	case "$epoch" in
	'' | *[!0-9]*) epoch="$(stat -c %Y "$LOCK_HEARTBEAT" 2>/dev/null || printf '0')" ;;
	esac
	now="$(date +%s 2>/dev/null || printf '0')"
	if [[ ! "$epoch" =~ ^[0-9]+$ || ! "$now" =~ ^[0-9]+$ || "$epoch" -le 0 || "$now" -le 0 ]]; then
		printf 'absent 0 0'
		return 0
	fi
	age=0
	if [[ "$now" -gt "$epoch" ]]; then
		age=$((now - epoch))
	fi
	case "$hb_pid" in
	'' | *[!0-9]*) hb_pid=0 ;;
	esac
	if [[ "$age" -lt "$LOCK_HEARTBEAT_STALE_SECONDS" ]]; then
		printf 'fresh %s %s' "$hb_pid" "$age"
		return 0
	fi
	if [[ "$hb_pid" -le 0 ]]; then
		# Sem pid nao da para avaliar o "E nenhum processo vivo": orfandade nao
		# esta provada, entao decidem as regras conservadoras antigas.
		printf 'absent 0 %s' "$age"
		return 0
	fi
	if build_lock_process_incarnation_is_live "$hb_pid" "$hb_boot_id" "$hb_start_ticks"; then
		printf 'stale_live %s %s' "$hb_pid" "$age"
		return 0
	fi
	printf 'stale_orphan %s %s' "$hb_pid" "$age"
}

write_build_lock_heartbeat() {
	local heartbeat_tmp now_epoch owner_boot_id owner_start_ticks
	[[ "$BUILD_LOCK_OWNED" == "1" ]] || return 1
	[[ -n "$BUILD_LOCK_OWNED_IDENTITY" && "$BUILD_LOCK_OWNED_IDENTITY" == "$(build_lock_dir_identity)" ]] || return 1
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	[[ "$now_epoch" -gt 0 ]] || return 1
	owner_boot_id="$(process_boot_id 2>/dev/null || true)"
	owner_start_ticks="$(process_start_ticks "$WRAPPER_PID" 2>/dev/null || true)"
	heartbeat_tmp="$(mktemp "$CACHE_DIR/.build-lock-heartbeat.XXXXXX" 2>/dev/null || true)"
	[[ -n "$heartbeat_tmp" ]] || return 1
	if {
		printf 'pid:%s\n' "$WRAPPER_PID"
		printf 'boot_id:%s\n' "${owner_boot_id:-unknown}"
		printf 'start_ticks:%s\n' "${owner_start_ticks:-unknown}"
		printf 'epoch:%s\n' "$now_epoch"
	} >"$heartbeat_tmp" 2>/dev/null && mv -fT -- "$heartbeat_tmp" "$LOCK_HEARTBEAT" 2>/dev/null; then
		return 0
	fi
	rm -f -- "$heartbeat_tmp" 2>/dev/null || true
	return 1
}

# O build e uma unica chamada bloqueante de varios minutos: sem um renovador em
# segundo plano o heartbeat nao teria como provar vida durante ele. O renovador
# morre sozinho quando o wrapper morre (kill -0) ou quando o lock deixa de ser
# nosso (dev:ino), entao um wrapper SIGKILLado nao consegue manter vivo para
# sempre um lock que ninguem mais detem.
start_build_lock_heartbeat_renewer() {
	[[ "$BUILD_LOCK_OWNED" == "1" ]] || return 0
	[[ -z "$LOCK_HEARTBEAT_RENEWER_PID" ]] || return 0
	write_build_lock_heartbeat || return 0
	(
		trap - EXIT
		# O `kill` de stop_build_lock_heartbeat_renewer alcanca ESTA subshell,
		# nunca o `sleep` que ela executasse em primeiro plano: o sono e um
		# processo separado, sobrevive ao TERM da mae e e adotado pelo
		# subreaper que envelopa o wrapper. Sob
		# `supervise-process-tree --fail-on-descendant-cleanup` isso e lido
		# como descendente abandonado e devolve 125 — e o intervalo de 5 s
		# passa longe do grace de 1,5 s do supervisor, entao a corrida nunca
		# se resolve sozinha. Dormir em SEGUNDO plano e esperar por `wait`
		# (builtin interrompivel) faz o TERM chegar ao trap, que encerra o
		# sono junto com a subshell.
		# E `jobs -p` no trap, nao o pid guardado numa variavel. A primeira
		# versao desta correcao fazia `sleep ... & sono_pid=$!` e matava
		# `$sono_pid`: sao dois comandos DISTINTOS, e o bash executa trap
		# pendente ENTRE eles. TERM nessa fresta encontrava a variavel com o
		# valor velho (vazia na primeira volta), o trap saia sem matar nada e o
		# sono ficava orfao por um intervalo inteiro — o mesmo 125, agora
		# intermitente, que e a pior especie. Confirmado por refutacao
		# adversarial em 2026-09-05, com repro sob o supervisor real.
		# `jobs -p` lista os filhos DESTA subshell no instante do disparo:
		# vazio antes do primeiro sono, sempre atual depois, e fecha de quebra
		# a janela espelho entre o retorno do `wait` e a limpeza da variavel.
		trap 'kill $(jobs -p) 2>/dev/null || true; exit 0' TERM
		while :; do
			sleep "$LOCK_HEARTBEAT_INTERVAL_SECONDS" &
			wait "$!" || exit 0
			kill -0 "$WRAPPER_PID" 2>/dev/null || exit 0
			[[ "$BUILD_LOCK_OWNED_IDENTITY" == "$(build_lock_dir_identity)" ]] || exit 0
			write_build_lock_heartbeat || exit 0
		done
	) >/dev/null 2>&1 &
	LOCK_HEARTBEAT_RENEWER_PID="$!"
}

stop_build_lock_heartbeat_renewer() {
	[[ -n "$LOCK_HEARTBEAT_RENEWER_PID" ]] || return 0
	kill "$LOCK_HEARTBEAT_RENEWER_PID" 2>/dev/null || true
	# ESPERA COM TETO, e nao `wait` nu (2026-09-05, achado sob refutacao).
	#
	# Se quem invocou este wrapper entrou com `trap "" TERM`, o bash instala
	# SIG_IGN no filho assincrono e o trap da subshell NUNCA dispara: o `kill`
	# acima e inocuo e um `wait` sem teto pendura o wrapper inteiro ate o
	# relogio externo — medido rc=124, identico na versao anterior a esta
	# correcao. O renovador passa a ser dono do relogio de quem o criou.
	#
	# 40 voltas de 50 ms dao 2 s, folga larga para a saida normal (medida em
	# 0,28 s no pior caso do fixture). Esgotado o teto, SIGKILL: este processo
	# nasceu NESTE wrapper e e a unica coisa que ele pode matar sem duvida.
	local tentativas=0
	while kill -0 "$LOCK_HEARTBEAT_RENEWER_PID" 2>/dev/null && [[ "$tentativas" -lt 40 ]]; do
		sleep 0.05
		tentativas=$((tentativas + 1))
	done
	kill -KILL "$LOCK_HEARTBEAT_RENEWER_PID" 2>/dev/null || true
	wait "$LOCK_HEARTBEAT_RENEWER_PID" 2>/dev/null || true
	LOCK_HEARTBEAT_RENEWER_PID=""
}

release_build_lock() {
	local identity_now
	identity_now="$(build_lock_dir_identity)"
	if [[ "$identity_now" == "missing" ]]; then
		return 0
	fi
	if [[ -n "$BUILD_LOCK_OWNED_IDENTITY" && "$BUILD_LOCK_OWNED_IDENTITY" != "missing" && "$BUILD_LOCK_OWNED_IDENTITY" != "$identity_now" ]]; then
		# Este lock ja nao e o nosso: outra sessao despejou o nosso e criou o
		# dela no mesmo caminho. Liberar agora destruiria o lock DELA.
		echo "run-go-cmd-cached: build lock path now holds another session's lock; leaving it untouched command=$NAME owned=$BUILD_LOCK_OWNED_IDENTITY observed=$identity_now" >&2
		return 0
	fi
	if evict_build_lock_directory "$BUILD_LOCK_OWNED_IDENTITY" 0 >/dev/null 2>&1; then
		return 0
	fi
	echo "run-go-cmd-cached: failed to release build lock; next session will reclaim it by heartbeat command=$NAME path=$LOCK_DIR" >&2
	return 1
}

reclaim_missing_meta_lock() {
	[[ -d "$LOCK_DIR" ]] || return 1
	lock_metadata_entry_exists && return 1
	local now_epoch mtime_epoch age identity
	identity="$(build_lock_dir_identity)"
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	mtime_epoch="$(lock_dir_mtime_epoch)"
	[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
	age=$((now_epoch - mtime_epoch))
	[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
	evict_build_lock_directory "$identity" 1 >/dev/null 2>&1 || return 1
	echo "run-go-cmd-cached: reclaimed stale build lock with missing metadata command=$NAME age=${age}s" >&2
	return 0
}

# mkdir(2) grants lock ownership atomically, while the owner publishes the
# diagnostic metadata immediately afterwards. A waiter gets only this bounded
# initialization handshake; waiting for the build still requires the explicit
# critical-dependency classification below.
await_build_lock_metadata_initialization() {
	[[ -d "$LOCK_DIR" ]] || return 0
	lock_metadata_entry_exists && return 0
	local waited_ms=0
	while [[ -d "$LOCK_DIR" && "$waited_ms" -lt "$LOCK_META_INIT_GRACE_MS" ]] && ! lock_metadata_entry_exists; do
		sleep 0.01
		waited_ms=$((waited_ms + 10))
	done
}

reclaim_stale_build_lock() {
	[[ -d "$LOCK_DIR" ]] || return 1
	# 2026-07-31: o heartbeat decide ANTES das regras antigas porque e a unica
	# evidencia que separa "detentor vivo trabalhando" de "sessao morta" sem
	# depender de relogio de parede. Ele so amplia a seguranca: prova de vida
	# BLOQUEIA reciclagem que o orcamento por mtime autorizaria, e orfandade
	# provada (parou de renovar E o processo nao existe) dispensa esperar o
	# orcamento inteiro.
	local lock_identity heartbeat_verdict heartbeat_pid heartbeat_age
	lock_identity="$(build_lock_dir_identity)"
	read -r heartbeat_verdict heartbeat_pid heartbeat_age <<<"$(build_lock_heartbeat_verdict)"
	case "$heartbeat_verdict" in
	fresh | stale_live)
		return 1
		;;
	stale_orphan)
		if evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1; then
			echo "run-go-cmd-cached: reclaimed orphaned build lock by stalled heartbeat command=$NAME pid=$heartbeat_pid heartbeat_age=${heartbeat_age}s stale_budget=${LOCK_HEARTBEAT_STALE_SECONDS}s identity=$lock_identity" >&2
			return 0
		fi
		;;
	esac
	if ! lock_metadata_entry_exists; then
		reclaim_missing_meta_lock
		return $?
	fi
	local meta_pid meta_boot_id meta_start_ticks live_boot_id live_start_ticks now_epoch mtime_epoch age
	if ! lock_metadata_is_safe; then
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		mtime_epoch="$(lock_dir_mtime_epoch)"
		[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
		age=$((now_epoch - mtime_epoch))
		[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
		evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1 || return 1
		echo "run-go-cmd-cached: reclaimed stale build lock with unsafe metadata command=$NAME age=${age}s" >&2
		return 0
	fi
	meta_pid="$(lock_meta_first pid)"
	case "$meta_pid" in
	'' | *[!0-9]*)
		# Malformed/partial metadata does not prove owner death. An older wrapper
		# may still be publishing it, so reclaim only after the stale budget.
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		mtime_epoch="$(lock_dir_mtime_epoch)"
		[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
		age=$((now_epoch - mtime_epoch))
		[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
		evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1 || return 1
		echo "run-go-cmd-cached: reclaimed stale build lock with malformed metadata command=$NAME age=${age}s" >&2
		return 0
		;;
	esac
	if process_exists "$meta_pid"; then
		meta_boot_id="$(lock_meta_first owner_boot_id)"
		meta_start_ticks="$(lock_meta_first owner_start_ticks)"
		live_boot_id="$(process_boot_id 2>/dev/null || true)"
		live_start_ticks="$(process_start_ticks "$meta_pid" 2>/dev/null || true)"
		if [[ -n "$meta_boot_id" && "$meta_start_ticks" =~ ^[0-9]+$ && -n "$live_boot_id" && "$live_start_ticks" =~ ^[0-9]+$ ]]; then
			if [[ "$meta_boot_id" == "$live_boot_id" && "$meta_start_ticks" == "$live_start_ticks" ]]; then
				return 1
			fi
			evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1 || return 1
			echo "run-go-cmd-cached: reclaimed reused-pid build lock command=$NAME pid=$meta_pid recorded_boot_id=$meta_boot_id recorded_start_ticks=$meta_start_ticks live_boot_id=$live_boot_id live_start_ticks=$live_start_ticks" >&2
			return 0
		fi
		# Legacy metadata without a process incarnation is not trusted forever.
		# It remains protected during the stale budget, then may be reclaimed
		# without signalling or killing the unrelated live process.
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		mtime_epoch="$(lock_dir_mtime_epoch)"
		[[ "$now_epoch" -gt 0 && "$mtime_epoch" -gt 0 ]] || return 1
		age=$((now_epoch - mtime_epoch))
		[[ "$age" -ge "$LOCK_STALE_SECONDS" ]] || return 1
		evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1 || return 1
		echo "run-go-cmd-cached: reclaimed stale legacy build lock without process identity command=$NAME pid=$meta_pid age=${age}s" >&2
		return 0
	fi
	evict_build_lock_directory "$lock_identity" 1 >/dev/null 2>&1 || return 1
	echo "run-go-cmd-cached: reclaimed dead build lock command=$NAME pid=$meta_pid" >&2
	return 0
}

build_lock_identity() {
	stat -c '%d:%i:%Y:%s' "$LOCK_META" 2>/dev/null || stat -c 'missing:%d:%i:%Y' "$LOCK_DIR" 2>/dev/null || printf 'missing'
}

write_build_lock_metadata() {
	local started_epoch="$1" owner_boot_id owner_start_ticks command_description lock_budget_description stop_description
	shift || true
	owner_boot_id="$(process_boot_id 2>/dev/null || true)"
	owner_start_ticks="$(process_start_ticks "$$" 2>/dev/null || true)"
	if [[ -z "$owner_boot_id" || ! "$owner_start_ticks" =~ ^[0-9]+$ ]]; then
		echo "run-go-cmd-cached: failed to authenticate build lock owner process identity command=$NAME pid=$$" >&2
		exit 75
	fi
	LOCK_METADATA_TMP="$(mktemp "$CACHE_DIR/.build-lock-meta.XXXXXX" 2>/dev/null || true)"
	if [[ -z "$LOCK_METADATA_TMP" ]]; then
		echo "run-go-cmd-cached: failed to allocate build lock metadata temporary command=$NAME" >&2
		exit 75
	fi
	command_description="$(inline_token "run-go-cmd-cached $PKG $*")"
	command_description="${command_description:0:4096}"
	lock_budget_description="${WIKI_GO_CMD_BUDGET_MS:-$((RUN_TIMEOUT_SECONDS * 1000))}"
	if [[ ! "$lock_budget_description" =~ ^[0-9]+$ || "${#lock_budget_description}" -gt 9 ]]; then
		lock_budget_description=invalid
	fi
	stop_description="$(inline_token "${WIKI_GO_CMD_STOP_CONDITION:-command_exits_or_build_lock_timeout_or_run_timeout}")"
	stop_description="${stop_description:0:4096}"
	if ! {
		printf 'pid:%s\n' "$$"
		printf 'owner_boot_id:%s\n' "$owner_boot_id"
		printf 'owner_start_ticks:%s\n' "$owner_start_ticks"
		printf 'started_epoch:%s\n' "$started_epoch"
		printf 'command:%s\n' "$command_description"
		printf 'timeout_seconds:%s\n' "$RUN_TIMEOUT_SECONDS"
		printf 'budget_ms:%s\n' "$lock_budget_description"
		printf 'stop_condition:%s\n' "$stop_description"
		printf 'lock_scope:%s\n' "$(build_lock_scope)"
	} >"$LOCK_METADATA_TMP" || ! mv -fT -- "$LOCK_METADATA_TMP" "$LOCK_META"; then
		echo "run-go-cmd-cached: failed to write build lock metadata command=$NAME" >&2
		exit 75
	fi
	LOCK_METADATA_TMP=""
}

acquire_build_lock() {
	local lock_owner_uid lock_mode
	if (
		umask 077
		mkdir "$LOCK_DIR"
	) 2>/dev/null; then
		BUILD_LOCK_OWNED=1
		# 2026-07-31: a identidade (dev:ino) do lock que ganhamos e o que
		# autoriza renovar heartbeat e liberar depois. Sem ela, um dono antigo
		# poderia derrubar o lock de quem o sucedeu no mesmo caminho.
		BUILD_LOCK_OWNED_IDENTITY="$(build_lock_dir_identity)"
		return 0
	fi
	if [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then
		lock_owner_uid="$(stat -c %u "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		lock_mode="$(stat -c %a "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		if [[ "$lock_owner_uid" == "$EUID" && "$lock_mode" =~ ^[0-7]+$ ]] && (((8#$lock_mode & 8#022) == 0)); then
			return 1
		fi
		echo "run-go-cmd-cached: build lock directory is unsafe: expected_uid=$EUID owner_uid=$lock_owner_uid mode=$lock_mode path=$LOCK_DIR" >&2
		exit 75
	fi
	# The owner may have removed the lock immediately after mkdir reported
	# EEXIST. One bounded retry distinguishes that normal race from a real
	# filesystem failure without creating an unbounded retry loop.
	if [[ ! -e "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] && (
		umask 077
		mkdir "$LOCK_DIR"
	) 2>/dev/null; then
		BUILD_LOCK_OWNED=1
		BUILD_LOCK_OWNED_IDENTITY="$(build_lock_dir_identity)"
		return 0
	fi
	if [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]]; then
		lock_owner_uid="$(stat -c %u "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		lock_mode="$(stat -c %a "$LOCK_DIR" 2>/dev/null || printf 'unknown')"
		if [[ "$lock_owner_uid" == "$EUID" && "$lock_mode" =~ ^[0-7]+$ ]] && (((8#$lock_mode & 8#022) == 0)); then
			return 1
		fi
	fi
	echo "run-go-cmd-cached: cannot acquire build lock because mkdir failed without a valid same-user lock directory: $LOCK_DIR" >&2
	exit 75
}

current_milliseconds() {
	date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s 2>/dev/null || printf '0')"
}

elapsed_milliseconds_since() {
	local started="$1" now
	now="$(current_milliseconds)"
	case "$started" in
	'' | *[!0-9]*) printf '0' ;;
	*) printf '%s' "$((now - started))" ;;
	esac
}

run_build_with_timeout() {
	local tmp_bin="$1"
	local started_ms duration_ms status
	started_ms="$(current_milliseconds)"
	echo "run-go-cmd-cached: build_start command=$PKG bin=$(inline_token "$tmp_bin") build_budget_ms=$BUILD_BUDGET_MS run_timeout_spec=$(inline_token "$RUN_TIMEOUT_SPEC") build_timeout_spec=$(inline_token "$BUILD_TIMEOUT_SPEC")" >&2
	# Dev-mains em cmd/ carregam //go:build devcmds (tirados do `go build ./...`
	# quente). Este runner sempre builda UM pacote main exato, então a tag é
	# necessária para os dev-mains e inócua para mains de produção sem constraint.
	if [[ -n "$ENV_WRAPPER" ]]; then
		if timeout --kill-after="$TIMEOUT_KILL_AFTER_SPEC" "$BUILD_TIMEOUT_SPEC" "$ENV_WRAPPER" go-modern build -tags devcmds -o "$tmp_bin" -buildvcs=false "$PKG"; then
			status=0
		else
			status=$?
		fi
	else
		if timeout --kill-after="$TIMEOUT_KILL_AFTER_SPEC" "$BUILD_TIMEOUT_SPEC" go-modern build -tags devcmds -o "$tmp_bin" -buildvcs=false "$PKG"; then
			status=0
		else
			status=$?
		fi
	fi
	duration_ms="$(elapsed_milliseconds_since "$started_ms")"
	if [[ "$status" -ne 0 ]]; then
		echo "run-go-cmd-cached: build_finish command=$PKG status=fail exit_code=$status duration_ms=$duration_ms build_budget_ms=$BUILD_BUDGET_MS stop_condition=build_exited_or_build_budget_timeout" >&2
		return "$status"
	fi
	echo "run-go-cmd-cached: build_finish command=$PKG status=pass duration_ms=$duration_ms build_budget_ms=$BUILD_BUDGET_MS stop_condition=build_exited_or_build_budget_timeout" >&2
	return 0
}

exec_cached_binary_with_timeout() {
	if ! command -v timeout >/dev/null 2>&1; then
		echo "run-go-cmd-cached: timeout command is required for supervised P0 command execution" >&2
		exit 75
	fi
	if [[ "$BOOTSTRAP_CACHE_MODE" == "1" ]]; then
		# Recollect the live source/toolchain closure immediately before exec. The
		# first snapshot selected the cache entry, but a concurrent edit may have
		# landed after that decision. A mismatch fails closed instead of executing
		# the old binary once or starting an unbounded rebuild loop.
		cleanup_bootstrap_context
		collect_bootstrap_build_context
		if ! validate_bootstrap_build_metadata; then
			echo "run-go-cmd-cached: authenticated bootstrap binary changed before exec; refusing stale or tampered binary" >&2
			exit 75
		fi
		export WIKI_GO_CMD_BINARY_METADATA_PATH="$BUILD_METADATA"
		export WIKI_GO_CMD_BINARY_METADATA_SHA256="$CURRENT_METADATA_SHA256"
		export WIKI_GO_CMD_BINARY_SHA256="$CURRENT_BINARY_SHA256"
		export WIKI_GO_CMD_DEPENDENCY_CLOSURE_SHA256="$CURRENT_CLOSURE_SHA256"
		export WIKI_GO_CMD_BUILD_SOURCE_SHA256="$CURRENT_BUILD_SOURCE_SHA256"
		echo "run-go-cmd-cached: bootstrap_binary_metadata schema=run-go-cmd-cached-build-metadata/v1 package=$PKG source_contract_sha256=$BOOTSTRAP_SOURCE_CONTRACT build_source_root_base64=$(base64_token "$BUILD_SOURCE_ROOT") build_source_sha256=$CURRENT_BUILD_SOURCE_SHA256 metadata_path_base64=$(base64_token "$BUILD_METADATA") metadata_sha256=$CURRENT_METADATA_SHA256 binary_sha256=$CURRENT_BINARY_SHA256 dependency_closure_sha256=$CURRENT_CLOSURE_SHA256" >&2
		cleanup_build_contexts
	fi
	if [[ "$BOOTSTRAP_CACHE_MODE" == "0" ]]; then
		cleanup_general_build_context
		collect_general_build_context
		if ! general_build_identity_matches; then
			echo "run-go-cmd-cached: fast-cache source/toolchain/binary identity changed before exec; refusing stale or tampered binary" >&2
			exit 75
		fi
		cleanup_general_build_context
	fi
	# Open with O_NOFOLLOW|O_NONBLOCK and authenticate the exact descriptor that
	# timeout will execute. Bash's `< "$BIN"` can hang if the validated regular
	# file is swapped for a FIFO just before open(2); descriptor-first Python can
	# reject FIFO/directory/symlink replacements before any blocking read.
	trap - EXIT
	exec python3 - "$BIN" "$CURRENT_BINARY_SHA256" "$RUN_TIMEOUT_SPEC" "$TIMEOUT_KILL_AFTER_SPEC" "$ENV_WRAPPER" "$@" <<'PY'
import hashlib
import os
import shutil
import stat
import struct
import sys

binary_name, expected_identity, timeout_spec, kill_after_spec, environment_wrapper, *command_arguments = sys.argv[1:]
descriptor = -1
try:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(binary_name, flags)
    opened = os.fstat(descriptor)
    identity = lambda info: (
        info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
        info.st_size, info.st_mtime_ns, info.st_ctime_ns,
    )
    if (
        not stat.S_ISREG(opened.st_mode)
        or opened.st_uid != os.geteuid()
        or opened.st_mode & 0o022
        or opened.st_mode & 0o111 == 0
        or opened.st_size <= 0
        or opened.st_size > 2 * 1024 * 1024 * 1024
    ):
        raise OSError("unsafe cached binary descriptor")

    def go_build_id(fd):
        header = os.pread(fd, 64, 0)
        if len(header) != 64 or header[:4] != b"\x7fELF" or header[4] != 2:
            raise OSError("unsupported binary format for fast identity pin")
        endian = "<" if header[5] == 1 else ">"
        e_shoff, = struct.unpack_from(endian + "Q", header, 0x28)
        e_shentsize, = struct.unpack_from(endian + "H", header, 0x3A)
        e_shnum, = struct.unpack_from(endian + "H", header, 0x3C)
        e_shstrndx, = struct.unpack_from(endian + "H", header, 0x3E)
        if e_shentsize <= 0 or e_shnum <= 0 or e_shnum > 4096 or e_shstrndx >= e_shnum:
            raise OSError("unsafe ELF section header table before descriptor pin")
        shtab_size = e_shentsize * e_shnum
        if shtab_size > 1024 * 1024:
            raise OSError("oversized ELF section header table before descriptor pin")
        shtab = os.pread(fd, shtab_size, e_shoff)
        if len(shtab) != shtab_size:
            raise OSError("short ELF section header table read before descriptor pin")

        def section(index):
            base = index * e_shentsize
            name_off, = struct.unpack_from(endian + "I", shtab, base)
            sh_offset, = struct.unpack_from(endian + "Q", shtab, base + 0x18)
            sh_size, = struct.unpack_from(endian + "Q", shtab, base + 0x20)
            return name_off, sh_offset, sh_size

        _, strtab_off, strtab_size = section(e_shstrndx)
        if strtab_size <= 0 or strtab_size > 1024 * 1024:
            raise OSError("unsafe ELF section name table before descriptor pin")
        strtab = os.pread(fd, strtab_size, strtab_off)
        if len(strtab) != strtab_size:
            raise OSError("short ELF section name table read before descriptor pin")
        note_offset = note_size = None
        for index in range(e_shnum):
            name_off, sh_offset, sh_size = section(index)
            end = strtab.find(b"\0", name_off)
            if end < 0:
                continue
            if strtab[name_off:end] == b".note.go.buildid":
                note_offset, note_size = sh_offset, sh_size
                break
        if note_offset is None or note_size is None or note_size <= 0 or note_size > 65536:
            raise OSError("missing authenticated Go build id note before descriptor pin")
        note = os.pread(fd, note_size, note_offset)
        if len(note) != note_size or len(note) < 12:
            raise OSError("short Go build id note read before descriptor pin")
        namesz, descsz, _note_type = struct.unpack_from(endian + "III", note, 0)
        name_pad = (namesz + 3) & ~3
        desc_start = 12 + name_pad
        if descsz <= 0 or descsz > 4096 or desc_start + descsz > len(note):
            raise OSError("malformed Go build id note before descriptor pin")
        build_id = note[desc_start:desc_start + descsz]
        if not build_id:
            raise OSError("empty Go build id before descriptor pin")
        return build_id

    # v2: two identity schemes share this pre-exec pin. Bootstrap mode (content-
    # addressed, workspace builds) still gets a full sha256 of the descriptor,
    # unchanged. Fast/default mode uses the O(1) build-id+inode identity — see
    # general_build_identity_matches for the rationale; re-hashing ~240MB here
    # a third time per invocation bought nothing beyond what that identity
    # already authenticates through this same pinned descriptor.
    if expected_identity.startswith("sha256:"):
        digest = hashlib.sha256()
        remaining = opened.st_size
        while remaining:
            chunk = os.read(descriptor, min(1024 * 1024, remaining))
            if not chunk:
                raise OSError("short cached binary descriptor read")
            digest.update(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise OSError("cached binary descriptor grew during read")
        after = os.fstat(descriptor)
        if identity(after) != identity(opened):
            raise OSError("cached binary descriptor changed during read")
        observed_identity = "sha256:" + digest.hexdigest()
    else:
        build_id = go_build_id(descriptor)
        after = os.fstat(descriptor)
        if identity(after) != identity(opened):
            raise OSError("cached binary descriptor changed during read")
        observed_identity = (
            "binary-identity-v1:" + build_id.hex()
            + ":" + str(after.st_dev) + ":" + str(after.st_ino)
            + ":" + str(after.st_size) + ":" + str(after.st_mtime_ns)
        )
    if observed_identity != expected_identity:
        raise OSError("cached binary identity changed before descriptor pin")

    timeout_name = shutil.which("timeout")
    if timeout_name is None:
        raise OSError("timeout executable is unavailable")
    timeout_name = os.path.realpath(timeout_name)
    timeout_info = os.stat(timeout_name)
    timeout_owner_trusted = timeout_info.st_uid in (0, os.geteuid())
    if (
        not timeout_owner_trusted
        and timeout_info.st_uid == 65534
        and not os.access(timeout_name, os.W_OK)
    ):
        try:
            with open("/proc/self/uid_map", "rb") as uid_map_handle:
                uid_map_payload = uid_map_handle.read(4096)
        except OSError:
            uid_map_payload = b""
        # Mesma politica ja aplicada tres vezes neste arquivo (ancestry do
        # timeout, toolchain cgo do build e sua revalidacao): sob user namespace
        # com root NAO mapeado (sandbox Cowork), /usr/bin/timeout do host-root
        # aparece como uid de overflow 65534 e e imutavel para o usuario do
        # namespace. Este ponto de pin pre-exec tinha ficado de fora e reprovava
        # todo comando cacheado no sandbox. Em host sem userns, 65534 continua
        # reprovado como sempre.
        timeout_owner_trusted = uid_map_payload != b"" and not any(
            line.split() and line.split()[0] == "0"
            for line in uid_map_payload.decode("ascii", errors="replace").splitlines()
        )
    if (
        not stat.S_ISREG(timeout_info.st_mode)
        or not timeout_owner_trusted
        or timeout_info.st_mode & 0o022
        or timeout_info.st_mode & 0o111 == 0
    ):
        raise OSError("unsafe timeout executable")

    # Scripts need this descriptor after timeout's exec so their shebang
    # interpreter can reopen /proc/self/fd/N. The descriptor remains bound to
    # the authenticated inode and is never reopened through the cache pathname.
    os.set_inheritable(descriptor, True)
    pinned_binary = f"/proc/self/fd/{descriptor}"
    timeout_arguments = [timeout_name, f"--kill-after={kill_after_spec}", timeout_spec]
    if environment_wrapper:
        timeout_arguments.append(environment_wrapper)
    timeout_arguments.extend((pinned_binary, *command_arguments))
    os.execve(timeout_name, timeout_arguments, os.environ)
except (OSError, ValueError) as error:
    print(f"run-go-cmd-cached: could not pin authenticated cached binary before exec: {error}", file=sys.stderr)
    raise SystemExit(75)
finally:
    if descriptor >= 0:
        os.close(descriptor)
PY
}

tmp=""
cleanup_build() {
	stop_build_lock_heartbeat_renewer
	if [[ "$BUILD_LOCK_OWNED" == "1" ]]; then
		if [[ -n "$LOCK_METADATA_TMP" ]]; then
			rm -f -- "$LOCK_METADATA_TMP" 2>/dev/null || true
			LOCK_METADATA_TMP=""
		fi
		# 2026-07-31: liberar por rename (com unlink/rmdir apenas como fallback)
		# -- o par rm+rmdir falhava inteiro onde DELETE e negado e cada build
		# bem-sucedido deixava um lock permanente para tras.
		release_build_lock || true
		BUILD_LOCK_OWNED=0
		BUILD_LOCK_OWNED_IDENTITY=""
	fi
	if [[ -n "${tmp:-}" ]]; then
		rm -f -- "$tmp" 2>/dev/null || true
		tmp=""
	fi
}

if [[ "$needs_build" == "1" ]]; then
	start_epoch="$(date +%s 2>/dev/null || printf '0')"
	: "${start_epoch:=0}"
	now_epoch=0
	elapsed=0
	active_lock_identity=""
	trap 'cleanup_build; cleanup_build_contexts' EXIT
	while ! acquire_build_lock; do
		await_build_lock_metadata_initialization
		if [[ ! -d "$LOCK_DIR" ]]; then
			continue
		fi
		if reclaim_stale_build_lock; then
			continue
		fi
		current_lock_identity="$(build_lock_identity)"
		if [[ "$current_lock_identity" != "$active_lock_identity" ]]; then
			build_lock_holder_active_analysis
			validate_build_lock_wait_classification_or_exit "$@"
			active_lock_identity="$current_lock_identity"
		fi
		now_epoch="$(date +%s 2>/dev/null || printf '0')"
		: "${now_epoch:=0}"
		if [[ "$start_epoch" -gt 0 && "$now_epoch" -gt 0 ]]; then
			elapsed=$((now_epoch - start_epoch))
			critical_timeout_ms="$(critical_build_lock_wait_timeout_ms)"
			if [[ "$critical_timeout_ms" =~ ^[0-9]+$ && "$critical_timeout_ms" -gt 0 && $((elapsed * 1000)) -ge "$critical_timeout_ms" ]]; then
				build_lock_holder_active_analysis
				echo "run-go-cmd-cached: critical_dependency build lock wait timeout_ms=$critical_timeout_ms elapsed_ms=$((elapsed * 1000)) lock_scope=$(inline_token "$(build_lock_scope)") command=$(inline_token "run-go-cmd-cached $PKG $*")" >&2
				exit 75
			fi
			if [[ "$elapsed" -ge "$LOCK_WAIT_SECONDS" ]]; then
				echo "run-go-cmd-cached: build lock blocked after ${LOCK_WAIT_SECONDS}s for $NAME: $LOCK_DIR" >&2
				exit 75
			fi
		fi
		sleep 0.1
	done
	write_build_lock_metadata "$start_epoch" "$@"
	# 2026-07-31: a partir daqui o detentor prova vida continuamente; se este
	# processo morrer (inclusive por SIGKILL), o heartbeat congela e a proxima
	# sessao recicla o lock por rename sem depender de DELETE.
	start_build_lock_heartbeat_renewer
	build_after_lock=0
	if [[ "$BOOTSTRAP_CACHE_MODE" == "1" ]]; then
		if ! validate_bootstrap_build_metadata; then
			build_after_lock=1
		fi
	elif ! fast_cache_artifacts_present; then
		build_after_lock=1
	else
		# Outra sessao pode ter buildado enquanto esperavamos o lock: os
		# artefatos agora existem e merecem autenticacao. Se o snapshot ainda
		# nao foi coletado (caminho frio), colete AGORA — com identidade
		# autenticada, reaproveitar o binario alheio e correto e evita um build
		# redundante de minutos.
		ensure_general_build_context
		if ! general_build_identity_matches; then
			build_after_lock=1
		fi
	fi
	if [[ "$build_after_lock" == "1" ]]; then
		# O snapshot "antes" de verify_general_build_context_stable_after_build
		# e o de write_general_build_identity nascem aqui no caminho frio: colar
		# a coleta ao build restringe a janela vigiada ao build, em vez de
		# arrastar a espera pelo lock (ate LOCK_WAIT_SECONDS) para dentro dela.
		ensure_general_build_context
		tmp="$(mktemp "$CACHE_DIR/.${NAME}.build.XXXXXX")" || {
			echo "run-go-cmd-cached: failed to allocate private build output in cache" >&2
			exit 75
		}
		cd "$BUILD_SOURCE_ROOT"
		run_build_with_timeout "$tmp"
		verify_bootstrap_build_context_stable_after_build
		verify_general_build_context_stable_after_build
		# 2026-07-30 (sandbox Cowork/virtiofs): mktemp cria o alvo com 0600 e o
		# `go build -o` só consegue recriá-lo quando pode remover o arquivo
		# existente. Onde unlink é negado (EPERM), o Go escreve NO LUGAR e o
		# binário herda o 0600 do mktemp — sem bit de execução. O instalador
		# então publicava um cache inexecutável e toda invocação seguinte morria
		# em "unsafe authenticated cache file", reconstruindo em loop (~34s de
		# CPU por chamada, medido). Normalizar o modo aqui é o mesmo 0500 que a
		# autenticação do cache já exige (dono, sem escrita de grupo/outros, com
		# execução): não afrouxa nada, apenas deixa de depender de unlink.
		chmod 0500 -- "$tmp"
		mv -fT -- "$tmp" "$BIN"
		# 2026-07-29: o refresh do manifesto de dependências era exclusivo do
		# modo bootstrap. No caminho geral, o binário era reinstalado (mv -fT
		# atualiza o mtime) mas deps.list ficava para trás — medido ao vivo:
		# deps.list de 22/07 contra factory de 29/07. Consequências em cadeia:
		# (a) tools/audit_v2_pages.py itera esse manifesto para vigiar
		# staleness do factory; manifesto velho deixa pacote novo do fecho sem
		# vigilância (falso-FRESCO latente, exatamente o risco documentado em
		# tools/ensure-audit-ready:127-135); (b) ensure-audit-ready compara
		# mtime deps.list vs binário e entrava em rebuild forçado PERMANENTE
		# (~34s de CPU por chamada, sem nunca sarar). O manifesto deve ser
		# regenerado após TODA instalação de binário, em qualquer modo; a
		# falha do refresh continua fail-closed (rm do manifesto → auditor
		# recusa o factory até um rebuild+refresh completo).
		refresh_dependency_list_after_build "$PKG"
		write_bootstrap_build_metadata
		write_general_build_identity
		tmp=""
	fi
	trap - EXIT
	cleanup_build
	trap cleanup_build_contexts EXIT
fi

cd "$ROOT"
exec_cached_binary_with_timeout "$@"
