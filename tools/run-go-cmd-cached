timeout_supervision_is_verified() {
	local marker="${WIKI_RUN_GO_CMD_CACHED_UNDER_TIMEOUT:-}"
	[[ "$marker" == v1:* ]] || return 1
	python3 - "$marker" "$PPID" "$(realpath -e -- "$0" 2>/dev/null || true)" "$WRAPPER_TIMEOUT_SPEC" "$TIMEOUT_KILL_AFTER_SPEC" <<'PY'
import os
import pathlib
import stat
import sys

marker, shell_parent_text, runner_name, wrapper_spec, kill_after_spec = sys.argv[1:]
parts = marker.split(":")
if len(parts) != 4 or parts[0] != "v1":
    raise SystemExit(1)
boot_id, pid_text, ticks_text = parts[1:]
if not pid_text.isdigit() or not ticks_text.isdigit():
    raise SystemExit(1)
if not shell_parent_text.isdigit():
    raise SystemExit(1)
pid = int(pid_text)
if pid != int(shell_parent_text) or pid <= 1:
    raise SystemExit(1)
try:
    if pathlib.Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip() != boot_id:
        raise SystemExit(1)
    proc = pathlib.Path("/proc") / str(pid)
    status = (proc / "status").read_text(encoding="ascii", errors="strict")
    uid = None
    for line in status.splitlines():
        if line.startswith("Uid:"):
            uid = int(line.split()[1])
            break
    if uid != os.geteuid():
        raise SystemExit(1)
    stat_text = (proc / "stat").read_text(encoding="ascii", errors="strict")
    remainder = stat_text[stat_text.rfind(") ") + 2 :].split()
    if len(remainder) < 20 or remainder[19] != ticks_text:
        raise SystemExit(1)
    executable = (proc / "exe").resolve(strict=True)
    executable_info = executable.stat()
    executable_owner_trusted = executable_info.st_uid in (0, os.geteuid())
    if (
        not executable_owner_trusted
        and executable_info.st_uid == 65534
        and not os.access(executable, os.W_OK)
    ):
        try:
            with open("/proc/self/uid_map", "rb") as uid_map_handle:
                uid_map_payload = uid_map_handle.read(4096)
        except OSError:
            uid_map_payload = b""
        # Sob user namespace com root NAO mapeado (ex.: sandbox Cowork), todo
        # arquivo do host-root (ex.: /usr/bin/timeout) aparece como uid de
        # overflow 65534 e e imutavel para o usuario do namespace; mesma
        # correcao do trust-check do pre-commit (2026-07-29, .githooks/pre-commit)
        # e de tools/v2_stock_epoch.py:_host_root_owner_uids (2026-07-30) para o
        # mesmo falso-positivo, aqui na verificacao de ancestry do timeout que
        # supervisiona run-go-cmd-cached. Em host sem userns, 65534 continua
        # reprovado como sempre.
        executable_owner_trusted = uid_map_payload != b"" and not any(
            line.split() and line.split()[0] == "0"
            for line in uid_map_payload.decode("ascii", errors="replace").splitlines()
        )
    if (
        executable.name != "timeout"
        or not stat.S_ISREG(executable_info.st_mode)
        or not executable_owner_trusted
        or executable_info.st_mode & 0o022
    ):
        raise SystemExit(1)
