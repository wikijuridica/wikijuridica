        payload = command_file.read(256 * 1024 + 1)
    if not payload or len(payload) > 256 * 1024:
        raise SystemExit(1)
    arguments = [os.fsdecode(part) for part in payload.split(b"\0") if part]
    cwd = (proc / "cwd").resolve(strict=True)
    runner = pathlib.Path(runner_name)
    def canonical(value: str) -> pathlib.Path | None:
        try:
            candidate = pathlib.Path(value)
            if not candidate.is_absolute():
                candidate = cwd / candidate
            return candidate.resolve(strict=True)
        except (OSError, RuntimeError):
            return None
    if not any(canonical(argument) == runner for argument in arguments):
        raise SystemExit(1)
    required = {
        f"--kill-after={kill_after_spec}",
        wrapper_spec,
        f"WIKI_RUN_GO_CMD_CACHED_UNDER_TIMEOUT={marker}",
    }
    if not required.issubset(set(arguments)):
        raise SystemExit(1)
except (OSError, UnicodeError, ValueError):
    raise SystemExit(1)
