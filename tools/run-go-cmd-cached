process_exists() {
	local pid="$1"
	case "$pid" in
	'' | *[!0-9]*) return 1 ;;
	esac
	[[ "$pid" -gt 0 ]] || return 1
	[[ -r "/proc/$pid/stat" ]] && process_start_ticks "$pid" >/dev/null 2>&1
}

process_boot_id() {
	local boot_id
	boot_id="$(sed -n '1p' /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
	case "$boot_id" in
	'' | *[!0-9a-f-]*) return 1 ;;
	esac
	printf '%s' "$boot_id"
}

process_start_ticks() {
	local pid="$1" stat_line fields_after_comm
	local -a proc_fields
	case "$pid" in
	'' | *[!0-9]*) return 1 ;;
	esac
	IFS= read -r stat_line <"/proc/$pid/stat" 2>/dev/null || return 1
	case "$stat_line" in
	*') '*) ;;
	*) return 1 ;;
	esac
	# The comm field is parenthesized and may contain spaces. Strip through its
	# final `) `; field 20 of the remainder is procfs starttime (field 22).
	fields_after_comm="${stat_line##*) }"
	read -r -a proc_fields <<<"$fields_after_comm"
	[[ "${#proc_fields[@]}" -ge 20 && "${proc_fields[19]}" =~ ^[0-9]+$ ]] || return 1
	printf '%s' "${proc_fields[19]}"
}

