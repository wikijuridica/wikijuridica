	# aprova e general_build_identity_matches; isto so responde "existe algo a
	# autenticar?", pergunta que custa tres stat(2) em vez do snapshot completo
	# da arvore de fontes.
	[[ "$BOOTSTRAP_CACHE_MODE" == "0" ]] || return 1
