#!/usr/bin/env python3
"""check-percursos-fundamento-legal — o gate da seção que só existe no canal de máquina.

POR QUE ELE PRECISOU EXISTIR. A seção "Percursos por fundamento legal" nasceu em
2026-08-29 e não tinha gate nenhum. Ela é o pior lugar possível para um defeito
silencioso: sai apenas na gêmea `.md`, no MCP, no A2A e no `/api/v1/lote` — quatro
canais que NENHUM humano abre por hábito e que renderizam o mesmo objeto, então um
link morto ou uma atribuição legal errada apareceria nos quatro de uma vez e
ninguém veria. As páginas HTML continuam idênticas, o que torna a ausência de
sinal ainda mais completa.

O QUE ELE CONFERE, e o que cada régua defende:

  ANTI-404 EM REPOUSO — todo destino do artefato é rota do published_manifest.
  O servidor já filtra em runtime (httpserver.filtraPercursosServiveis), mas
  filtro em runtime esconde o problema em vez de denunciá-lo: se metade dos
  destinos morreu, o canal empobrece em silêncio e ninguém sabe.

  AUTO-REFERÊNCIA E REPETIÇÃO — página não é vizinha de si mesma, e não aparece
  duas vezes na mesma seção com rótulos diferentes. É a mesma regra que o gate do
  bloco de relacionados cobra no HTML.

  TETO DE ATRATOR — nenhuma página é destino mais que o teto. Sem ele, medido
  antes de o teto existir, aer-hotel-caucao-preauth-nao-liberada era vizinha de
  395 páginas: construir atrator gigante é a concentração que a malha inteira
  existe para desfazer.

  ATRIBUIÇÃO LEGAL — todo rótulo com URN LexML reconhecida nomeia a norma que a
  URN identifica. Citação legal mal atribuída é a única classe de defeito deste
  portal com risco real sob a ética da OAB, e nenhuma medição automática a pega
  depois de publicada. Aqui ela é pega antes.

  A RAZÃO DE SER — a fração cross-área. A seção existe para furar a clique de
  área; se ela cair ao patamar da malha base, ela virou mais uma lista de links.

  E O CANAL SERVIDO, quando o servidor está de pé: a seção chega mesmo ao
  `.md`. Verde no artefato não é prova de que o documento a carrega — foi
  exatamente assim que a medição de audiência passou verde com o evento morto.

Read-only. Não escreve nada, não toca no artefato.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import unicodedata
import urllib.error
import urllib.request

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ARTEFATO = os.path.join(RAIZ, "content/legal_cocitation_index.jsonl")
MANIFESTO = os.path.join(RAIZ, "data/editorial/published_manifest.jsonl")
# A FONTE de que o artefato deriva. `tools/deploy-publico:652-684` e explicito:
# o indice "tem de nascer DEPOIS da republicacao e ANTES de o servico voltar a
# atender" — ou seja, mais novo que `content/pages.json`.
FONTE = os.path.join(RAIZ, "content/pages.json")

# O mesmo teto que legalcocitation.defaultTetoAtrator aplica na geração. Ele é
# repetido aqui de propósito: o gate tem de reprovar mesmo que alguém suba a
# constante do gerador sem discutir, que é justamente quando o número importa.
TETO_DE_ATRATOR = 40

# Piso da fração cross-área. Medido em 2026-08-29: 76,7%. O piso é 50% — bem
# abaixo do medido, porque ele defende contra REGRESSÃO estrutural (a ordenação
# cross-área-primeiro sumir), não contra flutuação normal do acervo.
PISO_CROSS_AREA = 0.50

# Normas cujo nome o rótulo tem de trazer, por URN. Vem de
# internal/lexml/knowncodes.go — a conferência é de ATRIBUIÇÃO, então ela só vale
# para o que se sabe nomear com certeza.
NOMES_POR_URN = {
    "urn:lex:br:federal:lei:2002-01-10;10406": "codigo civil",
    "urn:lex:br:federal:lei:1990-09-11;8078": "codigo de defesa do consumidor",
    "urn:lex:br:federal:decreto.lei:1943-05-01;5452": "clt",
    "urn:lex:br:federal:lei:2015-03-16;13105": "codigo de processo civil",
    "urn:lex:br:federal:constituicao:1988-10-05;1988": "constituicao federal",
    "urn:lex:br:federal:lei:2018-08-14;13709": "lei geral de protecao de dados",
}


def dobra(valor: str) -> str:
    sem = unicodedata.normalize("NFD", valor.lower())
    return "".join(c for c in sem if unicodedata.category(c) != "Mn")


def area_da_rota(path: str) -> str:
    for parte in path.split("/"):
        if parte:
            return parte
    return ""


def carrega_manifesto() -> set[str]:
    rotas: set[str] = set()
    with open(MANIFESTO, encoding="utf-8") as fh:
        for linha in fh:
            linha = linha.strip()
            if linha:
                rotas.add(json.loads(linha).get("path", ""))
    return rotas


def mede() -> dict:
    if not os.path.isfile(ARTEFATO):
        return {"ausente": True}
    publicadas = carrega_manifesto()
    problemas: list[str] = []
    usos: dict[str, int] = {}
    total_links = 0
    cross = 0
    paginas = 0
    fingerprints: set[str] = set()

    with open(ARTEFATO, encoding="utf-8") as fh:
        for numero, linha in enumerate(fh, 1):
            linha = linha.strip()
            if not linha:
                continue
            registro = json.loads(linha)
            paginas += 1
            origem = registro.get("public_path", "")
            fingerprints.add(registro.get("entrada_sha256", ""))
            if origem not in publicadas:
                problemas.append(f"linha {numero}: origem {origem} não está no published_manifest")
            vistos: set[str] = set()
            for percurso in registro.get("percursos") or []:
                urn = percurso.get("urn", "")
                rotulo = percurso.get("rotulo", "")
                base = urn.split("!")[0]
                esperado = NOMES_POR_URN.get(base)
                if esperado and esperado not in dobra(rotulo):
                    problemas.append(
                        f"{origem}: o rótulo {rotulo!r} não nomeia a norma que a URN "
                        f"identifica ({esperado}) — atribuição legal errada")
                for vizinha in percurso.get("paginas") or []:
                    destino = vizinha.get("path", "")
                    total_links += 1
                    usos[destino] = usos.get(destino, 0) + 1
                    if destino not in publicadas:
                        problemas.append(f"{origem}: destino {destino} não está no published_manifest")
                    if destino == origem:
                        problemas.append(f"{origem}: é vizinha de si mesma")
                    if destino in vistos:
                        problemas.append(f"{origem}: repete o destino {destino} na mesma seção")
                    vistos.add(destino)
                    if not (vizinha.get("titulo") or "").strip():
                        problemas.append(f"{origem}: destino {destino} sem âncora")
                    if area_da_rota(destino) != area_da_rota(origem):
                        cross += 1

    for destino, quantos in usos.items():
        if quantos > TETO_DE_ATRATOR:
            problemas.append(
                f"{destino} é destino {quantos} vezes, acima do teto de atrator "
                f"{TETO_DE_ATRATOR} — é assim que se constrói o atrator que a malha "
                f"existe para desfazer")
    if len(fingerprints) > 1:
        problemas.append(
            f"o artefato traz {len(fingerprints)} fingerprints de insumo diferentes: "
            f"ele foi montado de gerações distintas")
    fracao = (cross / total_links) if total_links else 0.0
    if total_links and fracao < PISO_CROSS_AREA:
        problemas.append(
            f"apenas {100*fracao:.1f}% dos links atravessam área, abaixo do piso de "
            f"{100*PISO_CROSS_AREA:.0f}% — a seção existe para furar a clique de área")

    return {
        "ausente": False,
        "paginas": paginas,
        "links": total_links,
        "cross_area": cross,
        "fracao_cross_area": round(fracao, 4),
        "maior_atrator": max(usos.values()) if usos else 0,
        "problemas": problemas,
    }


def confere_canal_servido(origem: str) -> list[str]:
    """A seção chega MESMO ao documento servido, ou o artefato está só no disco.

    Verde no artefato não é prova. A medição de audiência deste portal passou
    verde por um dia inteiro com o evento de negócio morto, e foi leitura do
    canal real — não gate — que apanhou.
    """
    problemas: list[str] = []
    with open(ARTEFATO, encoding="utf-8") as fh:
        primeira = json.loads(fh.readline())
    rota = primeira["public_path"]
    url = origem.rstrip("/") + rota + "index.md"
    pedido = urllib.request.Request(url, headers={
        "User-Agent": "wikijuridica-superficie-probe/1.0",
        "X-Warming-Request": "true",
        "Accept": "text/markdown",
    })
    try:
        with urllib.request.urlopen(pedido, timeout=20) as resposta:
            corpo = resposta.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as erro:
        return [f"não consegui ler {url}: {erro}"]

    if "## Percursos por fundamento legal" not in corpo:
        problemas.append(f"{url}: o artefato declara percursos e o documento servido não os traz")
    if re.search(r"(?m)^### ", corpo) and "Perguntas frequentes" not in corpo:
        problemas.append(f"{url}: H3 fora do FAQ — o contrato do canal é que H3 é do FAQ")
    for percurso in primeira.get("percursos") or []:
        for vizinha in percurso.get("paginas") or []:
            alvo = vizinha["path"] + "index.md"
            if alvo not in corpo:
                problemas.append(f"{url}: o vizinho {vizinha['path']} não aparece no documento servido")
                break
    return problemas


def frescor(artefato: str = "", fonte: str = ""):
    """O artefato e DERIVADO: mais velho que a fonte significa que ele mente.

    ★ POR QUE ESTA REGUA EXISTE, com o caso de 2026-09-16

    Este gate media densidade — paginas, links, fracao cross-area, maior atrator —
    e saia **0** com o indice **cinco dias** atras da fonte: artefato de
    2026-09-11 03:08 contra `content/pages.json` de 2026-09-16 10:54. Densidade
    alta de um retrato velho continua sendo densidade alta, e o numero nao muda
    quando o acervo muda por baixo.

    O que isso servia errado nao aparecia em lugar nenhum: a secao "Percursos por
    fundamento legal" so sai na gemea `.md`, no MCP, no A2A e no `/api/v1/lote`.
    Nenhum humano abre esses canais por habito, e o HTML continua identico — a
    ausencia de sinal e completa, que e exatamente o motivo pelo qual este gate
    foi escrito.

    Devolve (True, motivo) quando esta velho, (False, "") quando esta em dia, e
    (None, motivo) quando NAO DEU PARA MEDIR — que nunca vira verde.
    """
    # LIGACAO TARDIA, e nao e estilo: com `artefato=ARTEFATO` no cabecalho o
    # default e resolvido na DEFINICAO, e um teste que troca o global mede o
    # arquivo real sem perceber — foi assim que a primeira versao desta bancada
    # passou verde pelo motivo errado.
    artefato = artefato or ARTEFATO
    fonte = fonte or FONTE
    if not os.path.exists(fonte):
        return None, f"nao medido: {os.path.relpath(fonte, RAIZ)} nao existe"
    if not os.path.exists(artefato):
        return None, f"nao medido: {os.path.relpath(artefato, RAIZ)} nao existe"
    mt_art = os.stat(artefato).st_mtime
    mt_fonte = os.stat(fonte).st_mtime
    if mt_art >= mt_fonte:
        return False, ""
    atraso = mt_fonte - mt_art
    return True, (
        f"artefato {os.path.relpath(artefato, RAIZ)} e "
        f"{atraso/86400:.1f} dia(s) mais VELHO que {os.path.relpath(fonte, RAIZ)} "
        f"({time.strftime('%Y-%m-%d %H:%M', time.localtime(mt_art))} contra "
        f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(mt_fonte))}): a secao sai "
        f"nos quatro canais de maquina a partir de um retrato vencido. "
        f"Regenere no passo 2.6 do deploy, que e a unica janela em que ele cabe: "
        f"./tools/go-modern run ./cmd/generate-legal-cocitation")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--origem", default="", help="sonda o canal servido nesta origem (ex.: http://127.0.0.1:8088)")
    args = parser.parse_args()

    medida = mede()
    if medida.get("ausente"):
        print("check-percursos-fundamento-legal: artefato ausente — a seção não é "
              "emitida e o canal fica como era (aditivo). Gere com "
              "./tools/go-modern run ./cmd/generate-legal-cocitation")
        return 0

    velho, motivo_frescor = frescor()
    if velho is None:
        print(f"check-percursos-fundamento-legal: INCONCLUSIVO: {motivo_frescor}", file=sys.stderr)
        return 2

    problemas = list(medida["problemas"])
    if velho:
        # FRESCOR E DEFEITO, nao aviso: densidade alta de retrato velho continua
        # alta, e por isso as outras reguas deste gate nao o enxergam.
        problemas.append(motivo_frescor)
    if args.origem:
        problemas.extend(confere_canal_servido(args.origem))

    if problemas:
        print("check-percursos-fundamento-legal: REPROVADO", file=sys.stderr)
        for p in problemas[:25]:
            print(f"  {p}", file=sys.stderr)
        if len(problemas) > 25:
            print(f"  ... e mais {len(problemas)-25}", file=sys.stderr)
        return 1

    print(f"check-percursos-fundamento-legal: paginas={medida['paginas']} "
          f"links={medida['links']} cross_area={medida['cross_area']} "
          f"({100*medida['fracao_cross_area']:.1f}%) maior_atrator={medida['maior_atrator']}"
          + (f" canal_servido=ok" if args.origem else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
