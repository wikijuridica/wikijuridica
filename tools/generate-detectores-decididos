#!/usr/bin/env python3
"""Escreve ops/detectores-decididos.jsonl a partir do censo de tools/check-detector-orfao.

★ ESTA FERRAMENTA NAO PODE SER AGENDADA, E O MOTIVO E' ANTI-FRAUDE.
==================================================================
O gate `check-detector-orfao` reprova ORFAO NOVO — detector que nenhum executor
alcanca e que nao tem linha no registro. Se esta ferramenta rodasse num timer,
todo orfao novo ganharia linha automaticamente e o gate ficaria verde POR
CONSTRUCAO: o instrumento passaria a absolver o defeito que existe para acusar.
Por isso ela e' de acionamento humano, esta declarada com este motivo em
`ops/detectores-decididos.jsonl` e NAO entra em `tools/run-qualidade-diaria`.

A classe de cada linha e' DERIVADA por regra nomeada (`classe_automatica` do
censo), nunca arbitrada aqui:

  datado               nome termina em -AAAAMMDD: migracao de uma vez
  toca-artefato-publicado  o corpo cita public/, published_manifest,
                       data/editorial/, pages.json ou sitemap. O censo NAO
                       distingue ler de escrever — quem distingue e o prefixo,
                       e a classe GRAVADA ja sai refinada (ver DESTINOS)
  selftest             sufixo -selftest
  pendente             nenhuma das anteriores

O DESTINO segue da classe e do prefixo, e a regra esta escrita em DESTINOS:
ligar um `generate-*` e' mudar o que a maquina ESCREVE em producao, e isso nao
e' decisao de quem faz o censo.
"""
import argparse
import json
import os
import subprocess
import sys

SAIDA = "ops/detectores-decididos.jsonl"

CABECALHO = """# REGISTRO DAS DECISOES SOBRE DETECTOR ORFAO. Nao e documentacao: e a fonte que
# o gate `tools/check-detector-orfao` consulta para separar BACKLOG DECIDIDO de
# ENTRADA NOVA. Orfao sem linha aqui deixa o gate VERMELHO; linha aqui para
# ferramenta que sumiu do disco, ou que JA ganhou executor, tambem.
#
# Linha em branco e linha iniciada por `#` NAO REGISTRAM NADA — o mesmo desenho
# de ops/produtores-de-pagina.jsonl, pelo mesmo motivo: mencionar um nome em
# comentario nao pode valer como decisao.
#
# CAMPOS (todos obrigatorios): ferramenta, classe, destino, motivo, decidido_em.
#
# O QUE ESTE ARQUIVO NAO E': uma allowlist que zera o problema. Ele congela o
# ESTOQUE medido para que o gate possa reprovar o FLUXO. Gate que nasce vermelho
# por divida acumulada se aprende a ignorar; gate que so' fica vermelho no dia em
# que um detector novo nasce sem executor acusa o defeito no dia em que ele
# nasce. Drenar o estoque e' trabalho de engenharia, e cada linha drenada some
# daqui porque o gate reprova linha obsoleta.
"""

# (classe automatica, prefixo) -> (classe GRAVADA, destino, motivo).
#
# A classe gravada REFINA a automatica pelo prefixo, e a razao e de leitura: o
# censo so sabe que o corpo TOCA um artefato publicado; quem distingue ler de
# escrever e o prefixo, que e contrato deste repositorio (`check-*` e read-only,
# `generate-*` escreve). Sem o refino, 63 checks read-only ficariam gravados como
# "escritores em producao", e quem filtrasse o registro para achar o que e
# arriscado ligar leria 63 falsos escritores.
DESTINOS = {
    ("datado", "check"): ("datado", "arquivar-migracao-datada",
        "o nome carrega a data da migracao (-AAAAMMDD): rodou no dia, nao volta a rodar; fica como registro do que foi feito"),
    ("datado", "generate"): ("datado", "arquivar-migracao-datada",
        "gerador de migracao datada: rodou uma vez na data do nome; religar reescreveria artefato ja consolidado"),
    ("toca-artefato-publicado", "check"): ("le-artefato-publicado", "ligar-apos-rodar-uma-vez",
        "LE artefato publicado (public/, manifesto, sitemap ou estoque) e nunca foi executado; entra na bancada depois de uma passada que prove que nao nasce vermelho por divida alheia"),
    ("toca-artefato-publicado", "generate"): ("escreve-artefato-publicado", "propor-ao-maestro",
        "ESCREVE em artefato de producao; ligar um escritor muda o que a maquina publica e a decisao nao e de quem faz o censo"),
    ("selftest", "check"): ("selftest", "coberto-pelo-glob",
        "o vigia descobre tools/*-selftest por glob; se aparecer aqui, o glob mudou e o gate esta certo em reclamar"),
    ("selftest", "generate"): ("selftest", "coberto-pelo-glob", "idem"),
    ("pendente", "check"): ("pendente", "medir-e-decidir",
        "predicado proprio, sem executor e sem leitura de artefato publicado; exige uma passada medida antes de decidir entre ligar e aposentar"),
    ("pendente", "generate"): ("pendente", "medir-e-decidir",
        "gerador sem executor; exige medir o que ele escreve antes de decidir entre ligar e aposentar"),
}

# Decisoes ESPECIFICAS, com evidencia propria. Elas vencem a regra derivada:
# onde houve medicao, o motivo e' a medicao, nao a classe.
ESPECIFICAS = {
    "tools/generate-detectores-decididos": (
        "excecao-declarada", "nunca-agendar",
        "escreve o proprio registro que o gate consulta; rodar isto num timer absolveria todo orfao novo e deixaria check-detector-orfao verde por construcao"),
    "tools/check-public-body-sections": (
        "le-artefato-publicado", "ligar-quando-o-vermelho-fechar",
        "rodado em 2026-09-16 (10,3 s): exit 1 com 17 paginas de /imobiliario/ marcando estoque=0 html=9 — divergencia real entre estoque e HTML servido, em territorio de outra frente; ligar gate que nasce vermelho por divida alheia ensina a ignorar o alerta"),
    "tools/check-correcao-chegou-ao-visitante": (
        "le-artefato-publicado", "ligar-apos-rodar-uma-vez",
        "compara o texto corrigido com o que o visitante recebe — a familia exata do defeito de 2026-09-16; faz GET a producao, entao a passada de qualificacao tem de sair com a identidade de sonda declarada"),
    "tools/check-corpo-integro-na-borda": (
        "le-artefato-publicado", "ligar-apos-rodar-uma-vez",
        "mede corpo truncado servido com 200 na borda; nenhum executor o alcanca e o defeito que ele mede e invisivel ao cliente"),
    "tools/check-static-freshness": (
        "le-artefato-publicado", "ligar-apos-rodar-uma-vez",
        "compara o estatico servido com o que o render produz; foi o cutover do nginx para public/ que criou a classe de defeito que ele mede"),
    "tools/check-redesocial-entrega-final": (
        "pendente", "manter-manual-declarado",
        "o proprio cabecalho o define como conferencia de fim de plano, rodada ao declarar a frente pronta; o unico arquivo que o NOMEIA e internal/redesocialcompletude/integracao_test.go:71, que faz os.Stat para conferir o bit de execucao e NAO executa o predicado — por isso ele conta como orfao, e nao como coberto por teste"),
}


def prefixo(ferramenta):
    return "check" if os.path.basename(ferramenta).startswith("check-") else "generate"


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--raiz", default=os.environ.get("WIKI_RAIZ", "/opt/wiki"))
    ap.add_argument("--decidido-em", required=True, help="data ISO da decisao (AAAA-MM-DD)")
    ap.add_argument("--aplicar", action="store_true", help="sem isto, imprime e nao escreve")
    args = ap.parse_args()
    raiz = os.path.abspath(args.raiz)

    censo = subprocess.run(
        [sys.executable, os.path.join(raiz, "tools", "check-detector-orfao"), "--json", "--raiz", raiz],
        capture_output=True, text=True, check=True)
    c = json.loads(censo.stdout)
    classes = c["classe_automatica"]

    linhas = []
    for ferramenta in c["orfaos"]:
        if ferramenta in ESPECIFICAS:
            classe, destino, motivo = ESPECIFICAS[ferramenta]
        else:
            automatica = classes.get(ferramenta, "pendente")
            classe, destino, motivo = DESTINOS[(automatica, prefixo(ferramenta))]
        linhas.append({"ferramenta": ferramenta, "classe": classe, "destino": destino,
                       "motivo": motivo, "decidido_em": args.decidido_em})

    corpo = CABECALHO + "".join(
        json.dumps(l, ensure_ascii=False, sort_keys=True) + "\n" for l in linhas)
    if not args.aplicar:
        print(f"[ensaio] {len(linhas)} linha(s) para {SAIDA}; use --aplicar para escrever")
        print(corpo[:1200])
        return 0
    destino_final = os.path.join(raiz, SAIDA)
    tmp = destino_final + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(corpo)
    os.replace(tmp, destino_final)
    print(f"{SAIDA}: {len(linhas)} decisao(oes) gravadas")
    return 0


if __name__ == "__main__":
    sys.exit(main())
