#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
if [[ -z "${WIKI_GO_CMD_BUDGET_MS:-}" ]]; then
	WIKI_PROBE_BUDGET_MS=5000
	WIKI_PROBE_NEXT_IS_BUDGET=0
	for arg in "$@"; do
		if [[ "$WIKI_PROBE_NEXT_IS_BUDGET" -eq 1 ]]; then
			WIKI_PROBE_BUDGET_MS="$arg"
			WIKI_PROBE_NEXT_IS_BUDGET=0
			continue
		fi
		case "$arg" in
		--budget-ms)
			WIKI_PROBE_NEXT_IS_BUDGET=1
			;;
		--budget-ms=*)
			WIKI_PROBE_BUDGET_MS="${arg#--budget-ms=}"
			;;
		esac
	done
	export WIKI_GO_CMD_BUDGET_MS="$WIKI_PROBE_BUDGET_MS"
fi
export WIKI_GO_CMD_ARTIFACT_CLAIM_PATH="${WIKI_GO_CMD_ARTIFACT_CLAIM_PATH:-read-only:public-prose-candidate-timing}"
export WIKI_GO_CMD_ARTIFACT_CLAIM_PRODUCER="${WIKI_GO_CMD_ARTIFACT_CLAIM_PRODUCER:-tools/probe-public-prose-candidate-timing}"
export WIKI_GO_CMD_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_GO_CMD_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-stdout:loader-construct-validation-timings:no-public-write}"
export WIKI_GO_CMD_STOP_CONDITION="${WIKI_GO_CMD_STOP_CONDITION:-completed_or_budget_exceeded_without_public_artifact_write}"
exec run-go-cmd-cached ./cmd/probe-public-prose-candidate-timing "$@"
