#!/usr/bin/env python3
"""generate-v2-link-topics-ponte-cross-area-20260829 — dá ponte cross-área às 29 páginas que não tinham nenhuma.

O DEFEITO, MEDIDO. A malha do portal resolve vizinhos por sobreposição de termos
significativos entre `title + h1 + internal_link_topics`, com bônus de +15 para a
mesma área (internal/v2publish/relatedlinks.go). Medido no acervo em 2026-08-29:
88,57% das arestas ficam dentro da própria área e 61,2% das páginas não têm
NENHUM link de saída cross-área — um grafo de cliques em que o crawler entra numa
área e não sai. O ClaudeBot pediu 338 páginas .md e todas eram de
/jurisprudencia/.

O passe de reequilíbrio (internal/meshrebalance, plugado no publicador em
e6120bd9) fechou 6.159 dessas páginas trocando um link redundante da mesma área
por uma ponte. Sobraram 29, e a causa delas NÃO é o algoritmo: é o dado.

POR QUE ESSAS 29 SÃO DIFERENTES. O título delas é rótulo de processo — "ADI 7795
no STF: Pagador", "STJ em 28/07/2026: as decisões do dia". No bag de assunto isso
deixa só o número do processo (que não casa com página nenhuma) e rótulos de
taxonomia herdados do coletor ("constitucional", "jurisprudencia",
"precedente-qualificado"), que por construção só casam com outras páginas da
MESMA área. Com `minTopicOverlap = 2`, nenhum candidato de fora sobrevive. O
passe de reequilíbrio recusou-as honestamente: "sem candidato qualificado".

O MECANISMO DA CORREÇÃO, e por que ele não é "melhorar o descritor".
relatedlinks.go:241-249 dá +100 ao tópico que É o intent_id de uma página
publicada — "ligação declarada pelo autor, vale mais que coincidência de
vocabulário". Qualquer OUTRA string vale zero nesse resolver (ela só alimenta o
artefato temático). Então trocar "constitucional" por um descritor mais bonito
não move uma aresta sequer: o que move é declarar o intent_id do vizinho.

VERDADE ANTES DE GRAFO. Os 30 pares foram lidos por revisão jurídico-editorial
contra o TEXTO real da página de origem, com veredito de três valores e recorte
verbatim que sustenta a relação — o mesmo rito de
generate-v2-link-topics-enrich-20260812. Seis páginas voltaram RECUSADAS na
primeira rodada, foram reexaminadas uma a uma contra o índice completo das
10.116 publicadas, e as seis tinham destino genuíno que a pré-seleção mecânica
não alcançava (a ADI do CONAMA com o licenciamento ambiental; o feriado local
com a dobra do feriado trabalhado; o veto parental com o poder familiar).
`build-link-topics-ponte-cross-area-data-20260829` reconfere cada trecho contra
o registro VIVO e recusa destino que não seja publicado ou que seja da mesma
área.

EFEITO NO GRAFO, e o que ele NÃO faz. Declarar um tópico não CRIA aresta: com o
acervo em 99,97% da capacidade de malha, ele REALOCA — o destino declarado sobe
ao topo da fila daquela origem e desloca o candidato de menor score. Nenhuma
página cai abaixo do piso de entradas (o passe de piso recompõe). E este gerador
é ADITIVO: nenhum tópico é removido. Os rótulos de taxonomia continuam onde
estão, porque o artefato temático os resolve sob critério próprio e removê-los
sem medir `BuildMeshSignals` antes e depois seria regressão às cegas.

CONTRATO DE ESCRITA: o de tools/v2_link_topics_writer — lease de época do estoque
canônico, lock exclusivo próprio, CAS pelo sha256 da LINHA viva, demais chaves
preservadas byte a byte, escrita atômica com fsync, idempotente, estado anterior
preservado em .agents/runtime/ ANTES da escrita. `word_count` NÃO é recalculado:
internal_link_topics não entra em bodyWordCount (internal/v2ingest/validate.go), e
mexer nele corromperia o número. NÃO commita e NÃO republica.

DEPOIS DE RODAR: o artefato da malha carimba o fingerprint do estoque, e
internal_link_topics entra nesse carimbo
(v2internallinkgraph.effectiveInputFingerprint). Regenerar o artefato e
republicar é da frente de publicação.

Uso:
    tools/generate-v2-link-topics-ponte-cross-area-20260829 --dry-run
    tools/generate-v2-link-topics-ponte-cross-area-20260829
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease  # noqa: E402
from tools.v2_link_topics_writer import (  # noqa: E402
    Destinos,
    aplicar,
    escrever_evidencia,
    exclusive_lock,
    indexar_acervo,
    preflight,
)

DADOS = Path(__file__).with_suffix(".data.json")
DESTINOS = Destinos(
    root=ROOT,
    lock=ROOT / "data/editorial/.link-topics-ponte-cross-area-20260829.lock",
    pages=ROOT / "data/editorial/v2_pages",
    backup=ROOT / ".agents/runtime/backup-link-topics-ponte-20260829",
    evidencia=ROOT / "data/editorial/v2_link_topics_ponte_cross_area_evidence_20260829.jsonl",
    gerador=Path(__file__).name,
)


def carregar_dados() -> list[dict]:
    if not DADOS.is_file():
        raise SystemExit(
            f"arquivo de dados ausente: {DADOS.name} — rode primeiro "
            f"tools/build-link-topics-ponte-cross-area-data-20260829")
    dados = json.loads(DADOS.read_text(encoding="utf-8"))
    topicos = dados.get("topicos")
    if not isinstance(topicos, list) or not topicos:
        raise SystemExit(f"{DADOS.name}: 'topicos' vazio ou ausente")
    return topicos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    topicos = carregar_dados()
    onde, registros = indexar_acervo(DESTINOS)
    por_shard = preflight(topicos, onde, registros)

    total_alterados = 0
    total_ja = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(DESTINOS.lock):
                for shard in sorted(por_shard):
                    print(f"\n{shard}")
                    alterados, ja = aplicar(
                        DESTINOS, shard, por_shard[shard], args.dry_run)
                    total_alterados += alterados
                    total_ja += ja
                if not args.dry_run:
                    escrever_evidencia(DESTINOS, topicos, onde)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if args.dry_run:
        print(f"\n--dry-run: {total_alterados} página(s) alterável(is), "
              f"{total_ja} tópico(s) já presente(s). Nada escrito.")
        return 0
    print(f"\n{total_alterados} página(s) com ponte declarada, "
          f"{total_ja} tópico(s) já estava(m) presente(s).")
    if total_alterados:
        print("Remedir com: ./tools/go-modern test -run TestEnsaioSobreOAcervoReal "
              "./internal/meshrebalance/ e tools/measure-link-graph")
    return 0


if __name__ == "__main__":
    sys.exit(main())
