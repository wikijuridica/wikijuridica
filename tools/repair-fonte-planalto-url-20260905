#!/usr/bin/env python3
"""repair-fonte-planalto-url-20260905 — a rota /fontes/planalto/ passa a citar o documento, não o redirecionador.

POR QUE ESTE REPARO EXISTE
--------------------------
`tools/check-checked-at-coerente` reprovava por UMA fonte em 24.768: a página
/fontes/planalto/ exibia o rótulo "Verificado em 2026-06-09" apontando para
`https://www.planalto.gov.br/`, e nenhuma conferência com esse `verified_at`
existia — nem no estoque v2, nem no ledger institucional.

Tentei conferir de verdade, que é o primeiro caminho que o gate oferece.
`tools/generate-institucional-source-verification` RECUSOU gravar, e a recusa
está certa (medido em 2026-09-05, com a identidade WikijuridicaBot):

    https://www.planalto.gov.br/            200,  1.783 B, meta http-equiv=refresh
    https://www.planalto.gov.br/legislacao/ 200,  1.797 B, meta http-equiv=refresh
    https://www.planalto.gov.br/ccivil_03/  200,  8.092 B, documento de verdade

A raiz do Planalto não é um documento: é um interstitial que reencaminha. Uma
conferência sobre ela atestaria o redirecionador, não a fonte — seria lastro
fabricado, e a ferramenta que se recusa a fabricá-lo está fazendo o seu
trabalho. O defeito não estava na conferência: estava na URL declarada.

O documento que a página de fato descreve é o Portal da Legislação
(`ccivil_03/`), onde moram as leis compiladas que este projeto cita.

O QUE MUDA, E POR QUE AS DUAS COISAS JUNTAS
-------------------------------------------
1. `source_url` passa a apontar para o documento (`.../ccivil_03/`).
2. `checked_at` passa para a data da conferência REAL desta URL (2026-09-05).

Mudar só a URL deixaria a página afirmando que o Portal da Legislação foi
conferido em 2026-06-09 — data em que ninguém conferiu coisa alguma. As duas
edições juntas é que tornam a afirmação verdadeira.

O segundo caminho que o gate oferecia (esvaziar `checked_at`, como já estão
135 fontes publicadas) foi descartado: a fonte É conferível, e apagar a
afirmação em vez de torná-la verdadeira empobrece a página sem necessidade.

Idempotente: se a URL já estiver corrigida, não faz nada e sai 0.
"""

from __future__ import annotations

import json
import os
import pathlib
import shutil
import sys
import tempfile

ROTA = "/fontes/planalto/"
URL_ANTIGA = "https://www.planalto.gov.br/"
URL_NOVA = "https://www.planalto.gov.br/ccivil_03/"
CHECKED_AT_NOVO = "2026-09-05"
SOURCE_ID = "planalto"


def main() -> int:
    raiz = pathlib.Path(__file__).resolve().parent.parent
    alvo = raiz / "content" / "pages.json"
    if not alvo.is_file():
        print(f"ERRO: {alvo} não existe", file=sys.stderr)
        return 1

    bruto = alvo.read_text(encoding="utf-8")
    doc = json.loads(bruto)
    paginas = doc["pages"] if isinstance(doc, dict) and "pages" in doc else doc
    if not isinstance(paginas, list):
        print("ERRO: formato de content/pages.json inesperado", file=sys.stderr)
        return 1

    alvos = [p for p in paginas if isinstance(p, dict) and p.get("path") == ROTA]
    if len(alvos) != 1:
        print(f"ERRO: esperava exatamente 1 página em {ROTA}, achei {len(alvos)}", file=sys.stderr)
        return 1
    pagina = alvos[0]

    proveniencia = pagina.get("source_provenance")
    if not isinstance(proveniencia, list) or not proveniencia:
        print(f"ERRO: {ROTA} sem source_provenance", file=sys.stderr)
        return 1

    registros = [r for r in proveniencia if isinstance(r, dict) and r.get("source_id") == SOURCE_ID]
    if len(registros) != 1:
        print(f"ERRO: esperava 1 registro source_id={SOURCE_ID}, achei {len(registros)}", file=sys.stderr)
        return 1
    registro = registros[0]

    atual = registro.get("source_url")
    if atual == URL_NOVA:
        print(f"nada a fazer: {ROTA} já cita {URL_NOVA}")
        return 0
    if atual != URL_ANTIGA:
        print(
            f"ERRO: source_url é {atual!r}, esperava {URL_ANTIGA!r}. "
            "Outra frente mexeu nesta rota — pare e leia antes de reescrever.",
            file=sys.stderr,
        )
        return 1

    # Preservação obrigatória antes de tocar em arquivo com texto redigido.
    preservado = raiz / ".agents" / "runtime" / "pages-json-antes" / "pages.json.antes-fonte-planalto-20260905"
    preservado.parent.mkdir(parents=True, exist_ok=True)
    if not preservado.exists():
        shutil.copy2(alvo, preservado)

    registro["source_url"] = URL_NOVA
    registro["checked_at"] = CHECKED_AT_NOVO

    # Escrita atômica preservando modo: o arquivo é lido por processos vivos.
    modo = os.stat(alvo).st_mode
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=str(alvo.parent), prefix=".pages.json.", delete=False
    ) as tmp:
        json.dump(doc, tmp, ensure_ascii=False, indent=2)
        tmp.write("\n")
        temporario = pathlib.Path(tmp.name)
    os.chmod(temporario, modo)
    os.replace(temporario, alvo)

    print(f"{ROTA}: source_url {URL_ANTIGA} -> {URL_NOVA}")
    print(f"{ROTA}: checked_at -> {CHECKED_AT_NOVO} (data da conferência real desta URL)")
    print(f"preservado: {preservado.relative_to(raiz)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
