#!/bin/sh
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -eu

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# "$@" é obrigatório: docs/CONTENT_QUALITY.md:196 e docs/LAB_VALIDATION.md:210
# documentam este wrapper como comando de uso direto, então flags passadas pelo
# operador (--timings, --limit, ...) precisam chegar ao run-check em vez de
# serem engolidas silenciosamente (agente repete o comando sem efeito nenhum).
exec "$ROOT/tools/run-check" batch-draft-generation "$@"
