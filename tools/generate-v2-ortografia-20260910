#!/usr/bin/env python3
"""Corrige quatro erros de portugues que estao no ar, e NAO toca a transcricao.

OS DEFEITOS, medidos em 2026-09-10 por passada de `/usr/bin/hunspell -d pt_BR -l`
sobre o texto visivel de public/**/index.html e confirmados por leitura propria
no HTML servido.

Erro de portugues em texto visivel ao visitante e falha P0 pelo §8 do contrato,
na mesma linha do fragmento truncado. Nao cabe "publicar e corrigir": essa regua
governa pagina incompleta ou abaixo do piso, e publicar sabendo do erro e
diferente de deixar no ar o que ainda nao se mediu.

1) fam-ex-nao-cumpre-acordo-divorcio -- "ter abrido mao"

   "por ela ter abrido mao de sua parte em um veiculo financiado"

   Flexao inexistente: o participio de abrir e ABERTO. Texto editorial corrido,
   redacao nossa (comeca em "Imagine um divorcio em que ficou combinado..."),
   entao se corrige.

2) trab-quem-tem-periculosidade -- "Operacoes" sem acento

   official_sources[].name: "NR-16 - Atividades e Operacoes Perigosas (gov.br)"

   O rotulo da fonte e escrito por NOS, e o titulo oficial da norma e
   "ATIVIDADES E OPERACOES PERIGOSAS" com cedilha e til. Nao e transcricao de
   corpo: e o nome que damos ao link, e ele sai no texto visivel e no
   aria-label.

3) trab-lista-negra -- "condenacao" sem cedilha nem til

   official_sources[].name: "TST (condenacao por manutencao de lista negra)"

   Mesmo caso: o parentese e descricao nossa da fonte, nao titulo dela.

4) jur-stj-puil-19 -- "reconher": DIAGNOSTICADO AQUI, CORRIGIDO NO PRODUTOR

   Este gerador NAO o corrige, e a razao e de divisao de trabalho, nao de
   merito: a correcao certa vive em `cmd/generate-stj-tema-pages`, porque
   `title` e `h1` saem de la a cada rodada -- consertar so o shard faria a
   proxima execucao reescrever o erro de volta, que e o "defeito do produtor
   tratado no efeito" documentado em internal/shardpreserve. A sessao par e dona
   daquele produtor desde 842070dc e ja tem a tabela `erratasDaFonte` escrita
   para isso. O diagnostico fica registrado aqui porque foi aqui que ele nasceu,
   e porque ele explica o desenho de `campos` logo abaixo.

   O erro esta na FONTE OFICIAL, nao no nosso coletor. Provado:
   data/research/daily/stj-precedentes/2026-09-{08,09,10}.jsonl trazem, nas tres
   coletas diarias, `questao_submetida` identico, vindo de
   dadosabertos.web.stj.jus.br/.../temas.csv:

     "Possibilidade de se reconher a especialidade do tempo de servico em razao
      de periculosidade mesmo apos o Decreto 2.172/1997, uma vez que o rol de
      atividades e agentes nocivos ali elencados tem carater meramente
      exemplificativo."

   Por isso este gerador NAO toca `sections`. Aquele bloco e transcricao
   literal, e o proprio texto da pagina o declara ("A controversia foi assim
   delimitada pelo proprio tribunal: [...] A transcricao e literal"). Alterar
   citacao de fonte oficial e falsificar citacao -- o §8 proibe, e e a unica
   classe com risco real sob a OAB.

   `title` e `h1` SE CORRIGEM, e a diferenca nao e formal: eles nao sao
   transcricao, sao redacao nossa derivada da controversia, e sao o que o
   buscador mostra e o assistente de IA cita. Um erro ali se propaga: `grep -rl
   reconher public/ --include=index.html` devolve 8 arquivos, porque toda pagina
   que linka /jurisprudencia/stj-puil-19/ carrega o texto da ancora.

   O tamanho da familia foi medido antes de tratar o caso como isolado: hunspell
   sobre os 1.197 registros do cadastro do STJ da 97 tokens fora do dicionario, e
   quase todos sao legitimos -- ortografia pre-Acordo de 1990 (`arguicao`,
   `assembleia`, `cinquenta`, `consequente`), latim (`decisum`, `debeatur`,
   `criminis`), termo tecnico (`antiexacional`, `contracautela`, `creditamento`,
   `demurrage`) e abreviacao (`art` 333x, `arts` 19x). Erro de digitacao do
   proprio cadastro sao poucos: `reconher`, `clausulas` com acento trocado e
   `acordocelebrado` aglutinado.

O ESCOPO POR CAMPO E O CORACAO DESTE ARQUIVO. Cada correcao declara em QUAIS
campos pode agir, e o gerador nunca varre o registro inteiro. Sem isso, a
correcao do item 4 varreria `sections` junto e desfaria a transcricao -- que e
exatamente o que ele existe para preservar.

Escrita atomica (temp no mesmo diretorio + fsync + rename) e idempotente: rodar
duas vezes nao muda nada na segunda.

Uso:
    tools/generate-v2-ortografia-20260910 --dry-run
    tools/generate-v2-ortografia-20260910
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

# (shard, intent_id, campos permitidos, texto antigo, texto novo)
#
# `campos` e uma tupla fechada. "sections" so aparece onde o texto e redacao
# nossa; no item do PUIL 19 ele esta DELIBERADAMENTE ausente.
CORRECOES = (
    ("data/editorial/v2_pages/familia-03.jsonl",
     "fam-ex-nao-cumpre-acordo-divorcio",
     ("sections",),
     "ter abrido mão de sua parte",
     "ter aberto mão de sua parte"),
    ("data/editorial/v2_pages/trabalhista-07.jsonl",
     "trab-quem-tem-periculosidade",
     ("official_sources",),
     "NR-16 - Atividades e Operacoes Perigosas (gov.br)",
     "NR-16 - Atividades e Operações Perigosas (gov.br)"),
    ("data/editorial/v2_pages/trabalhista-19.jsonl",
     "trab-lista-negra",
     ("official_sources",),
     "TST (condenacao por manutenção de lista negra)",
     "TST (condenação por manutenção de lista negra)"),
)


def troca_em(valor, antigo, novo):
    """Substitui em string, lista e dicionario, contando as trocas.

    Devolve (valor novo, quantidade). Nao usa json.dumps/loads sobre o registro
    inteiro de proposito: serializar tudo e trocar no texto alcancaria campos
    fora do escopo declarado, que e o que este gerador existe para impedir.
    """
    if isinstance(valor, str):
        if antigo not in valor:
            return valor, 0
        return valor.replace(antigo, novo), valor.count(antigo)
    if isinstance(valor, list):
        total = 0
        saida = []
        for item in valor:
            novo_item, n = troca_em(item, antigo, novo)
            saida.append(novo_item)
            total += n
        return saida, total
    if isinstance(valor, dict):
        total = 0
        saida = {}
        for chave, item in valor.items():
            novo_item, n = troca_em(item, antigo, novo)
            saida[chave] = novo_item
            total += n
        return saida, total
    return valor, 0


def corrige(shard_rel, intent, campos, antigo, novo, dry_run):
    shard = RAIZ / shard_rel
    if not shard.exists():
        print(f"shard ausente: {shard}", file=sys.stderr)
        return 2

    saida: list[str] = []
    trocados = 0
    encontrado = False
    fora_do_escopo = 0
    for linha in shard.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") != intent:
            saida.append(json.dumps(registro, ensure_ascii=False))
            continue
        encontrado = True
        for campo in campos:
            if campo not in registro:
                continue
            registro[campo], n = troca_em(registro[campo], antigo, novo)
            trocados += n
        # Contabiliza o que FICOU: e o numero que prova que o escopo foi
        # respeitado, e no PUIL 19 ele tem de ser maior que zero — a
        # transcricao literal do STJ continua intacta.
        for campo, valor in registro.items():
            if campo in campos:
                continue
            _, n = troca_em(valor, antigo, novo)
            fora_do_escopo += n
        saida.append(json.dumps(registro, ensure_ascii=False))

    if not encontrado:
        print(f"intent {intent} nao esta em {shard.name}", file=sys.stderr)
        return 1
    if trocados == 0:
        print(f"{intent}: nada a fazer (idempotente)"
              + (f" — {fora_do_escopo} ocorrencia(s) preservada(s) fora do escopo"
                 if fora_do_escopo else ""))
        return 0

    print(f"{intent}: {trocados} troca(s) em {'/'.join(campos)}")
    print(f"  de  : {antigo!r}")
    print(f"  para: {novo!r}")
    if fora_do_escopo:
        print(f"  PRESERVADO fora do escopo: {fora_do_escopo} ocorrencia(s) "
              f"(transcricao de fonte oficial nao se altera)")
    if dry_run:
        return 0

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=shard.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write("\n".join(saida) + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        caminho = temporario.name
    os.replace(caminho, shard)
    print(f"  gravado: {shard.relative_to(RAIZ)}")
    return 0


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    pior = 0
    for shard_rel, intent, campos, antigo, novo in CORRECOES:
        codigo = corrige(shard_rel, intent, campos, antigo, novo,
                         argumentos.dry_run)
        pior = max(pior, codigo)
    if argumentos.dry_run:
        print("\n--dry-run: nada gravado")
    return pior


if __name__ == "__main__":
    sys.exit(main())
