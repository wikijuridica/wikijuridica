# ★ A REPROVACAO DO PRE-COMMIT SE CLASSIFICA POR CAUSA, NUNCA POR EXIT CODE
# ==============================================================================
# O caso que obriga isto foi medido nesta sessao, num commit do proprio maestro:
#
#     go-index-compile-closure: REPROVADO: compile closure excedeu 76.5s
#       concedidos (teto de compilacao 120s; o restante do orcamento do gate
#       pode reduzi-lo)
#     pre-commit: comando reprovou rc=1
#
# NAO era defeito da peca. Era CONTENCAO -- o orcamento encolhe conforme o resto
# do pipeline consome, e havia llama-server a 319% mais as bancadas dos agentes.
# O MESMO commit, sem uma linha alterada, passou na retentativa.
#
# Se o publicador lesse isso como recusa de conteudo, a peca iria para quarentena
# e ficaria parada PARA SEMPRE por defeito que nao e' dela. E' o "travar a toa"
# que o dono nomeou.
#
# E o limite oposto e' pior: se tudo fosse ambiente, um defeito real viraria laco
# infinito. Por isso sao TRES classes, com destinos diferentes, e o DEFAULT e' a
# classe conservadora (peca), que nao insiste.
#
# A ordem de avaliacao importa: HOOK antes de AMBIENTE, porque um gate que
# estourou com Traceback tambem costuma imprimir "timeout" na linha seguinte, e
# hook quebrado que se disfarca de contencao nunca vira alerta.

# CLASSE HOOK — o gate falhou por defeito DELE, nao do conteudo. A peca retoma
# E o defeito vira alerta nomeado: hook quebrado que ninguem ve e' pior que peca
# parada. Esta sessao mediu CINCO gates reprovando sem defeito real, entao a
# hipotese nao e' paranoia: e' frequencia medida.
PADROES_HOOK = (
    "Traceback (most recent call last)",
    "ModuleNotFoundError",
    "ImportError",
    "SyntaxError",
    "command not found",
    "rc=127",
    "rc=126",
    "nao materializou checker",
    "não materializou checker",
    "Permission denied",
    "Permissao negada",
    "Permissão negada",
)

# CLASSE AMBIENTE — contencao ou indisponibilidade. A peca retoma e NAO consome
# tentativa: a culpa nao e' do trabalho, e e' o mesmo principio do `Devolver` da
# fila do cerebro, em que `Reivindicar` aposta que a culpa e' da tarefa e a
# infraestrutura refuta a aposta.
PADROES_AMBIENTE = (
    "compile closure excedeu",
    "teto de compilação",
    "teto de compilacao",
    "indice mudou durante compilacao",
    "índice mudou durante compilação",
    "index.lock",
    "Unable to create",
    "Resource temporarily unavailable",
    "Device or resource busy",
    "Recurso temporariamente indisponível",
    "opt-wiki-agent-heavy.lock",
    "flock: timeout",
    "timed out",
    "Timeout",
    "No space left on device",
    "Cannot allocate memory",
)

# Exit codes: o contrato com quem chama do shell. Classe tambem vai no stdout e
# no ledger, mas o codigo e' o que um `if` de shell le sem parsear texto.
SAIDA_OK = 0
SAIDA_PECA = 1       # defeito do conteudo -> quarentena, espera correcao
SAIDA_RECUSA = 2     # pedido invalido para esta porta -> nunca se retenta
SAIDA_AMBIENTE = 3   # contencao -> retomada, sem consumir tentativa
SAIDA_HOOK = 4       # defeito do gate -> retomada + alerta nomeado


def classifica(saida: str) -> tuple[str, int, str]:
    """(classe, exit code, o trecho LITERAL que decidiu).

    Devolver o trecho que casou nao e' cosmetico: sem ele a classificacao vira
    veredito sem evidencia, e a proxima sessao nao tem como refutar a regra que
    mandou a peca para o lugar errado.
    """
    for padrao in PADROES_HOOK:
        if padrao in saida:
            return "hook", SAIDA_HOOK, padrao
    for padrao in PADROES_AMBIENTE:
        if padrao in saida:
            return "ambiente", SAIDA_AMBIENTE, padrao
    return "peca", SAIDA_PECA, ""


class Recusa(Exception):
    """Pedido que esta porta nao atende. Sempre nomeada, nunca silenciosa."""

    def __init__(self, codigo: str, detalhe: str):
        super().__init__(f"{codigo}: {detalhe}")
        self.codigo = codigo
        self.detalhe = detalhe


def le_registro() -> list[dict]:
    saida = subprocess.run(
        [sys.executable, os.path.join(FERRAMENTAS, "listar-produtores-de-pagina"),
         "--todos", "--json", "--raiz", RAIZ],
        cwd=RAIZ, check=False, capture_output=True, text=True, timeout=120)
    if saida.returncode != 0:
        raise Recusa("registro_ilegivel",
                     f"listar-produtores-de-pagina saiu {saida.returncode}: "
                     f"{(saida.stderr or '').strip()}")
    try:
        return json.loads(saida.stdout)
    except json.JSONDecodeError as erro:
        raise Recusa("registro_ilegivel", f"saida nao e' JSON: {erro}") from erro


def allowlist(tipo: str) -> set[str]:
    """Os caminhos que ESTE tipo pode commitar, ja expandidos pela rotacao.

    A allowlist NAO e' uma lista escrita a mao: ela deriva de
    `ops/produtores-de-pagina.jsonl`, o mesmo registro de onde a onda deriva o
    que roda e o que commita. Produtor novo entra sozinho; produtor fora do
    registro nao commita — que e' a mesma fronteira que o gate `produtor-orfao`
    ja cobra.
    """
    if tipo == "publicacao":
        return set(PUBLICACAO)
    campo = "portfolio" if tipo == "portfolio" else "shard"
    permitidos: set[str] = set()
    for entrada in le_registro():
        base = entrada[campo]
        # `[0-9]{2}` E NAO `\d\d`: medido, `\d` casa digito UNICODE, entao
        # `noticia-٠١.jsonl` (indo-arabico) passaria aqui e NUNCA pelo glob
        # `-[0-9][0-9].jsonl` de `alvos_do_registro`. Porta que aceita caminho
        # que a cadeia jamais escreve e' superficie a mais, e duas reguas para
        # o mesmo fato e' o defeito que este repositorio ja pagou tres vezes.
        casado = re.search(r"-([0-9]{2})\.jsonl$", base)
        if not casado:
            raise Recusa("registro_ilegivel",
                         f"{REGISTRO}: {campo} {base!r} do canal {entrada.get('canal')!r} "
                         f"nao termina em -NN.jsonl; a rotacao nao teria como ser derivada")
        prefixo = os.path.basename(base[: casado.start()])
        relativo = os.path.dirname(base)
        diretorio = os.path.join(RAIZ, relativo)
        if os.path.isdir(diretorio):
            for nome in sorted(os.listdir(diretorio)):
                if re.fullmatch(re.escape(prefixo) + r"-[0-9]{2}\.jsonl", nome):
                    permitidos.add(os.path.join(relativo, nome))
    return permitidos


def valida(caminhos: list[str], tipo: str) -> list[str]:
    """Devolve os caminhos relativos canonicos, ou levanta Recusa nomeada."""
    permitidos = allowlist(tipo)
    if not permitidos:
        raise Recusa("allowlist_vazia",
                     f"nenhum caminho permitido para o tipo {tipo!r}: commitar assim seria "
                     f"commitar sem regra")
    canonicos: list[str] = []
    for bruto in caminhos:
        if not bruto.strip():
            raise Recusa("caminho_vazio", "pathspec vazio")
        # `..` RECUSADO PELO LITERAL, antes de qualquer resolucao.
        #
        # `realpath` ja barraria a maioria, mas por um motivo ACIDENTAL: medido,
        # `data/editorial/v2_pages/../../../etc/hosts` resolve para
        # `/opt/wiki/etc/hosts`, que nao existe, e a recusa saia com o codigo
        # `remocao` -- verdadeira no efeito e errada na causa. Codigo de recusa
        # que nomeia a causa errada ensina a proxima sessao a procurar o defeito
        # no lugar errado.
        if ".." in bruto.replace(os.sep, "/").split("/"):
            raise Recusa("travessia",
                         f"{bruto} tem `..`: pathspec desta porta e' caminho direto de "
                         f"arquivo, nunca navegacao")
        absoluto = bruto if os.path.isabs(bruto) else os.path.join(RAIZ, bruto)
        # SYMLINK ANTES DE RESOLVER: `realpath` apagaria a evidencia de que o
        # proprio pathspec e' um link, e o blob gravado seria o do link.
        if os.path.islink(absoluto):
            raise Recusa("symlink", f"{bruto} e' symlink; esta porta so commita arquivo regular")
        real = os.path.realpath(absoluto)
        if real != RAIZ and not real.startswith(RAIZ + os.sep):
            raise Recusa("fora_da_arvore",
                         f"{bruto} resolve para {real}, fora de {RAIZ}")
        if os.path.isdir(real):
            raise Recusa("diretorio",
                         f"{bruto} e' diretorio. Estagiar diretorio ja varreu trabalho "
                         f"nao-commitado de outra sessao TRES vezes neste repositorio: o "
                         f"indice do git e' compartilhado")
        if not os.path.isfile(real):
            raise Recusa("remocao",
                         f"{bruto} nao existe no disco. Commitar a ausencia dele seria "
                         f"remocao, e delecao de qualquer especie continua vedada")
        relativo = os.path.relpath(real, RAIZ)
        # PERTINENCIA A CONJUNTO, nunca prefixo de string: `..` e nomes que
        # comecam igual derrotam startswith, e um caminho canonico so pertence
        # ao conjunto se ele E' um dos elementos.
        if relativo not in permitidos:
            raise Recusa("fora_da_allowlist",
                         f"{relativo} nao e' {tipo} de nenhum produtor declarado em "
                         f"{REGISTRO} (nem artefato de publicacao). Permitidos: "
                         f"{len(permitidos)} caminho(s)")
        canonicos.append(relativo)
    if not canonicos:
        raise Recusa("sem_caminho", "nenhum pathspec informado")
    return sorted(set(canonicos))


def git(*args: str, checar: bool = False) -> subprocess.CompletedProcess:
    """Invoca o git REAL por caminho absoluto.

    Caminho absoluto e nao `git` do PATH: `.githooks/pre-commit` fixa
    `GIT_BIN=/usr/bin/git` pelo mesmo motivo escrito la — *"nao aceite um
    executavel injetado por PATH (inclusive dentro do proprio repositorio)"*.

    `GIT_OPTIONAL_LOCKS=0` porque `diff`/`ls-files` fazem refresh OPORTUNISTA do
    indice, e o indice deste repositorio e' COMPARTILHADO entre sessoes. Uma
    leitura desta porta — inclusive num `--seco` de bancada — nao pode escrever
    `.git/index` enquanto outra sessao estagia. A variavel existe para isso.
    """
    ambiente = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    return subprocess.run([GIT, *args], cwd=RAIZ, check=checar, env=ambiente,
                          capture_output=True, text=True, timeout=900)


def sob_lock(*args: str, teto: int) -> subprocess.CompletedProcess:
    """Mesma invocacao, serializada no lock de commit do repositorio."""
    return subprocess.run(
        ["/usr/bin/flock", "--wait", str(teto), LOCK, GIT, *args],
        cwd=RAIZ, check=False, capture_output=True, text=True, timeout=teto + 900)


def ha_mudanca(caminhos: list[str]) -> bool:
    """Ha algo a commitar nestes caminhos? UMA leitura, e ela NAO escreve o indice.

    ★ Medido em git 2.39.5, com `.git/index` carimbado antes e depois:

        git status --porcelain            escreve o indice; com GIT_OPTIONAL_LOCKS=0, NAO escreve
        git diff --quiet -- <caminhos>    escreve o indice, COM ou SEM a variavel
        git diff --cached / ls-files      nao escrevem em nenhum dos dois casos

    Ou seja: para o `diff` do worktree, o refresh nao e' opcional, e a variavel
    nao o impede. A versao anterior desta funcao usava exatamente esse `diff`, e
    por isso reescrevia `.git/index` — que neste repositorio e' COMPARTILHADO
    entre sessoes — a cada consulta, inclusive num `--seco`. Trocar por `status`
    tira a escrita e ainda custa o mesmo: 0,02 s contra 0,02 s, medido sobre um
    shard de producao.

    A classificacao continua correta sem o refresh persistido (medido, mesmo
    repositorio de rascunho): arquivo so com mtime novo sai VAZIO (nao ha falso
    positivo), conteudo alterado sai ` M`, nao rastreado sai `??`, estagiado sai
    `M `, apagado sai `MD`. Qualquer linha dentro do pathspec significa que ha o
    que commitar; nenhuma linha significa que nao ha.
    """
    estado = git("status", "--porcelain", "--untracked-files=all", "--", *caminhos)
    if estado.returncode != 0:
        raise Recusa("git_nao_mediu",
                     f"status saiu {estado.returncode}: {(estado.stderr or '').strip()}")
    return bool((estado.stdout or "").strip())


def nenhuma_remocao(caminhos: list[str], momento: str = "depois de estagiar") -> None:
    """Conferido ANTES e DEPOIS de estagiar, sobre o INDICE — nao sobre a intencao.

    Um arquivo pode existir no disco no instante da validacao e ainda assim
    entrar no indice como `D` (por exemplo se outra sessao o removeu entre a
    validacao e o `add`). O indice e' o que vira commit, entao e' ele que
    responde.

    E o `D` pode ja estar no indice ANTES desta porta encostar nele: o indice e'
    compartilhado, e o commit escopado por pathspec monta o candidato a partir de
    HEAD MAIS tudo o que estiver estagiado DENTRO do pathspec. Um `D` estagiado
    por outra sessao entraria neste commit mesmo com o `add` desta porta sendo
    impecavel, e a conferencia so-depois ficaria vazia na volta seguinte. Por
    isso ela roda nos dois momentos, e `momento` diz qual deles recusou.
    """
    estado = git("diff", "--cached", "--name-status", "--", *caminhos)
    if estado.returncode != 0:
        raise Recusa("git_nao_mediu",
                     f"diff --cached --name-status saiu {estado.returncode}: "
                     f"{(estado.stderr or '').strip()}")
    for linha in (estado.stdout or "").splitlines():
        if not linha.strip():
            continue
        status = linha.split("\t", 1)[0].strip()
        if status.startswith("D") or status.startswith("R"):
            raise Recusa("remocao",
                         f"o indice traz {linha.strip()!r} ({momento}): esta porta nunca "
                         f"commita remocao nem renomeacao (que e' remocao mais criacao)")


def avisa_dono(chave: str, titulo: str, mensagem: str) -> None:
    """Canal unico do repositorio. Falha de notificacao nunca derruba o commit."""
    try:
        subprocess.run([sys.executable, os.path.join(FERRAMENTAS, "notify-owner"),
                        "--chave", chave, "--severidade", "alta",
                        "--titulo", titulo, "--mensagem", mensagem,
                        "--origem", "tools/cerebro-commitar"],
                       cwd=RAIZ, check=False, capture_output=True, text=True, timeout=120)
    except subprocess.SubprocessError as erro:
        print(f"  ATENCAO: notify-owner falhou ({erro})", file=sys.stderr)


def trilha_de(tipo: str, quando: datetime.datetime) -> str:
    destino = os.path.join(RAIZ, TRILHA)
    os.makedirs(destino, exist_ok=True)
    return os.path.join(destino, f"{quando.strftime('%Y%m%d-%H%M%S')}-{tipo}")


def grava_ledger(registro: dict) -> None:
    absoluto = os.path.join(RAIZ, LEDGER)
    os.makedirs(os.path.dirname(absoluto), exist_ok=True)
    with open(absoluto, "a", encoding="utf-8") as saida:
        saida.write(json.dumps(registro, ensure_ascii=False) + "\n")


def main() -> int:
    global RAIZ  # noqa: PLW0603 -- ver o comentario de --raiz
    analisador = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    analisador.add_argument("--tipo", required=True, choices=TIPOS)
    analisador.add_argument("--rotulo", required=True,
                            help="identidade da passada; entra na mensagem e no ledger")
    analisador.add_argument("--seco", action="store_true",
                            help="valida o pedido e NAO toca no indice nem no historico")
    # `--raiz` E' EXCLUSIVAMENTE DE VALIDACAO, e por isso EXIGE `--seco`.
    #
    # Sem ele a bancada so poderia medir esta porta contra a allowlist de
    # producao, e nenhum caso conseguiria distinguir "pertence ao conjunto" de
    # "comeca com o prefixo" -- foi exatamente o mutante que sobreviveu na
    # primeira rodada. Permitir `--raiz` COM escrita seria criar a superficie
    # oposta: commitar num repositorio que nao e' este.
    analisador.add_argument("--raiz", default=RAIZ,
                            help="raiz do repositorio para VALIDAR (exige --seco)")
    analisador.add_argument("caminhos", nargs="+",
                            help="pathspecs EXATOS de arquivo (nunca diretorio)")
    argumentos = analisador.parse_args()

    if os.path.realpath(argumentos.raiz) != RAIZ:
        if not argumentos.seco:
            print("cerebro-commitar: --raiz so vale com --seco. Escrever historico num "
                  "repositorio que nao e' este e' a superficie que esta porta nao tem.",
                  file=sys.stderr)
            return 2
        RAIZ = os.path.realpath(argumentos.raiz)
    if not re.fullmatch(r"[A-Za-z0-9_-]+", argumentos.rotulo):
        print("cerebro-commitar: --rotulo aceita so letras, digitos, hifen e sublinhado",
              file=sys.stderr)
        return 2

    quando = datetime.datetime.now(datetime.timezone.utc)
    try:
        caminhos = valida(argumentos.caminhos, argumentos.tipo)
        # SO SE PERGUNTA AO GIT QUANDO A RAIZ E' A DESTE REPOSITORIO. Num cenario
        # de bancada nao ha historico, e `git diff` sairia com erro de uso que a
        # bancada leria como recusa da porta -- medindo o git em vez da regra.
        precisa = ha_mudanca(caminhos) if RAIZ == RAIZ_DO_REPO else True
    except Recusa as recusa:
        print(f"cerebro-commitar: RECUSADO [{recusa.codigo}] {recusa.detalhe}", file=sys.stderr)
        if not argumentos.seco:
            grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                          "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                          "acao": "recusado", "codigo": recusa.codigo,
                          "detalhe": recusa.detalhe, "caminhos": argumentos.caminhos})
        return 2

    print(f"cerebro-commitar: {argumentos.tipo} · {len(caminhos)} caminho(s) validado(s) "
          f"contra a allowlist derivada de {REGISTRO}")
    for caminho in caminhos:
        print(f"  {caminho}")
    if not precisa:
        print("  sem novidade: nada a commitar")
        return 0
    if argumentos.seco:
        print("  --seco: estagiaria e commitaria estes caminhos, nesta ordem, em duas "
              "invocacoes separadas")
        return 0

    # A PRE-CONFERENCIA VEM ANTES DE ESCREVER QUALQUER ARQUIVO. Recusar depois de
    # `trilha_de` deixaria uma mensagem de commit orfa por recusa, e arquivo orfo
    # de trilha e' exatamente o tipo de residuo que a proxima sessao interpreta
    # como "commit que ficou pela metade".
    try:
        nenhuma_remocao(caminhos, momento="antes de estagiar")
    except Recusa as recusa:
        print(f"cerebro-commitar: RECUSADO [{recusa.codigo}] {recusa.detalhe}", file=sys.stderr)
        print("  o indice ja trazia a remocao quando esta porta chegou: nada foi estagiado "
              "aqui. Confira com `git status` e decida.", file=sys.stderr)
        grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                      "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                      "acao": "recusado_antes_de_estagiar", "codigo": recusa.codigo,
                      "detalhe": recusa.detalhe, "caminhos": caminhos})
        return SAIDA_RECUSA

    base = trilha_de(argumentos.tipo, quando)
    mensagem = base + ".msg"
    log = base + ".log"  # NUNCA o mesmo arquivo da mensagem: capturar a saida do
    # hook no arquivo passado a `-F` sobrescreve a mensagem, e isso e'
    # irreversivel.
    rotulos = {"portfolio": "portfolio", "paginas": "paginas", "publicacao": "publicacao"}
    with open(mensagem, "w", encoding="utf-8") as saida:
        saida.write(f"chore({rotulos[argumentos.tipo]}): {argumentos.rotulo} de "
                    f"{quando.strftime('%Y-%m-%d')}\n\n")
        saida.write(f"Commit da publicacao autonoma do cerebro, por tools/cerebro-commitar.\n"
                    f"Caminhos ({len(caminhos)}), todos validados contra a allowlist derivada\n"
                    f"de {REGISTRO}:\n\n")
        for caminho in caminhos:
            saida.write(f"  {caminho}\n")

    estagiar = sob_lock("add", "--", *caminhos, teto=600)
    if estagiar.returncode != 0:
        with open(log, "w", encoding="utf-8") as saida:
            saida.write((estagiar.stdout or "") + (estagiar.stderr or ""))
        classe, codigo, trecho = classifica((estagiar.stdout or "") + (estagiar.stderr or ""))
        print(f"cerebro-commitar: estagiar falhou (exit {estagiar.returncode}); classe "
              f"{classe}; saida em {os.path.relpath(log, RAIZ)}", file=sys.stderr)
        grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                      "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                      "acao": "falhou_ao_estagiar", "exit": estagiar.returncode,
                      "classe": classe, "trecho_que_decidiu": trecho,
                      "caminhos": caminhos, "log": os.path.relpath(log, RAIZ)})
        return codigo

    try:
        nenhuma_remocao(caminhos, momento="depois de estagiar")
    except Recusa as recusa:
        print(f"cerebro-commitar: RECUSADO [{recusa.codigo}] {recusa.detalhe}", file=sys.stderr)
        # O indice fica como esta: desfaze-lo exigiria `reset`, que e'
        # exatamente o subcomando que esta porta nao tem. O caminho de cura e'
        # humano e esta na mensagem.
        print("  o indice NAO foi desfeito: esta porta nao tem subcomando que descarte "
              "trabalho. Confira com `git status` e decida.", file=sys.stderr)
        grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                      "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                      "acao": "recusado_apos_estagiar", "codigo": recusa.codigo,
                      "detalhe": recusa.detalhe, "caminhos": caminhos})
        return 2

    commitar = sob_lock("commit", "-F", mensagem, "--", *caminhos, teto=900)
    texto = (commitar.stdout or "") + (commitar.stderr or "")
    with open(log, "w", encoding="utf-8") as saida:
        saida.write(texto)
    if commitar.returncode != 0:
        classe, codigo, trecho = classifica(texto)
        destino = {"peca": "QUARENTENA (a peca espera correcao)",
                   "ambiente": "RETOMADA (contencao; a peca NAO consome tentativa)",
                   "hook": "RETOMADA + ALERTA (o defeito e' do gate, nao da peca)"}[classe]
        print(f"cerebro-commitar: o pre-commit ou o git RECUSARAM (exit "
              f"{commitar.returncode}). Nada foi apagado; a saida inteira esta em "
              f"{os.path.relpath(log, RAIZ)}", file=sys.stderr)
        print(f"  classe: {classe} -> {destino}", file=sys.stderr)
        if trecho:
            print(f"  decidida pelo trecho literal: {trecho!r}", file=sys.stderr)
        else:
            print("  nenhum padrao de ambiente nem de hook casou: a classe conservadora "
                  "e' a da peca, que NAO insiste", file=sys.stderr)
        for linha in texto.splitlines()[-6:]:
            print(f"    {linha}", file=sys.stderr)
        grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                      "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                      "acao": "reprovado_no_pre_commit", "exit": commitar.returncode,
                      "classe": classe, "trecho_que_decidiu": trecho,
                      "caminhos": caminhos, "log": os.path.relpath(log, RAIZ)})
        # ALERTA NOMEADO SO NA CLASSE HOOK. Gate que reprova sem defeito real e'
        # frequencia MEDIDA neste repositorio -- cinco casos numa sessao -- e
        # hook quebrado que ninguem ve e' pior que peca parada. Nas outras duas
        # classes quem alerta e' o publicador, que conhece a peca; alertar aqui
        # tambem duplicaria o alarme.
        if classe == "hook":
            avisa_dono(f"{argumentos.rotulo}-hook",
                       "Gate do pre-commit reprovou por defeito DELE, nao do conteudo",
                       f"Trecho que decidiu: {trecho!r}. A peca RETOMA na passada seguinte. "
                       f"Saida inteira em {os.path.relpath(log, RAIZ)}. "
                       f"O contrato e' literal: hook que bloqueou nao se desliga, "
                       f"corrige-se a causa -- e --no-verify continua proibido.")
        return codigo

    cabeca = git("rev-parse", "--short", "HEAD")
    sha = (cabeca.stdout or "").strip()
    print(f"  commitado: {sha}")
    grava_ledger({"schema_version": SCHEMA, "quando": quando.isoformat(),
                  "rotulo": argumentos.rotulo, "tipo": argumentos.tipo,
                  "acao": "commitado", "commit": sha, "caminhos": caminhos,
                  "mensagem": os.path.relpath(mensagem, RAIZ)})
    return 0


if __name__ == "__main__":
    sys.exit(main())
