#!/usr/bin/env python3
"""generate-v2-artigo-ponto-repair-20260905 — corrige "artigo." antes de número.

O DEFEITO (medido em 2026-09-05, 16 ocorrências em 9 páginas de familia-04 e
familia-13): o corpo visível traz "O artigo. 1.606 do Código Civil", com ponto
depois de "artigo". "Artigo" por extenso NÃO é abreviação e não leva ponto; a
abreviação é "art.". As duas formas corretas são "o artigo 1.606" e "o art.
1.606" — a que está publicada não é nenhuma delas, e é texto que o leitor vê.

Escolhi "art." e não "artigo" porque é a forma que o próprio acervo já usa ao
lado ("ao reconhecer a paternidade na sentença de primeiro grau, o art. 7...",
familia-13 seção 3): a correção alinha a página com a casa em vez de criar uma
terceira grafia.

COMO ISTO APARECEU. O gate `current_legal_facts` exigia que a página de
investigação de paternidade citasse o art. 1.606 no corpo, e reprovava
(`current_legal_fact_outcome_missing`) — 11 das 12 expressões passavam. Parecia
falta de conteúdo jurídico. Não era: o dispositivo ESTAVA citado, com um ponto
a mais que nenhum dos quatro padrões aceitos casa. O detector apontou um erro de
português achando que apontava uma lacuna de direito, e por isso valia corrigir
a FAMÍLIA inteira e não só a página que ele nomeou.

MÉTODO. Substituição textual posicional na linha crua do JSONL, nunca
reserialização: reserializar reescreveria escapes e ordem de chaves de linhas
que ninguém pediu para tocar. O padrão exige dígito depois, então "artigo" em
prosa comum não é alcançado. `word_count` não muda — "artigo." e "art." são uma
palavra cada.

Uso:
    ./tools/generate-v2-artigo-ponto-repair-20260905 --dry-run
    ./tools/generate-v2-artigo-ponto-repair-20260905 --aplicar
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
ALVOS = ("familia-04.jsonl", "familia-13.jsonl")
PADRAO = re.compile(r"artigo\.(\s+)(?=\d)")
CAMPOS_DE_TEXTO = ("opening", "sections", "faq")


def ocorrencias_em_texto(registro: dict) -> int:
    """Conta o padrão SÓ nos campos que o leitor vê.

    Serve de trava: se a contagem na linha crua não bater com esta, há
    ocorrência em campo que não é corpo (uma URL, um metadado) e a substituição
    textual estaria mexendo onde não deve. Nesse caso o reparo aborta.
    """
    total = 0
    total += len(PADRAO.findall(registro.get("opening") or ""))
    for secao in registro.get("sections") or []:
        total += len(PADRAO.findall(secao.get("heading") or ""))
        total += len(PADRAO.findall(secao.get("text") or ""))
    for item in registro.get("faq") or []:
        total += len(PADRAO.findall(item.get("q") or ""))
        total += len(PADRAO.findall(item.get("a") or ""))
    return total


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--aplicar", action="store_true", help="escreve; sem isto é dry-run")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    corrigidas = 0
    paginas = 0
    for nome in ALVOS:
        caminho = RAIZ / "data/editorial/v2_pages" / nome
        if not caminho.is_file():
            print(f"NAO RODOU: {caminho} ausente", file=sys.stderr)
            return 2
        linhas = caminho.read_text(encoding="utf-8").splitlines(keepends=True)
        saida: list[str] = []
        for numero, linha in enumerate(linhas, 1):
            if not linha.strip():
                saida.append(linha)
                continue
            registro = json.loads(linha)
            no_texto = ocorrencias_em_texto(registro)
            na_linha = len(PADRAO.findall(linha))
            if no_texto == 0:
                saida.append(linha)
                continue
            if no_texto != na_linha:
                print(f"ABORTADO: {nome}:{numero} tem {na_linha} ocorrência(s) na linha "
                      f"e {no_texto} no corpo visível — há ocorrência fora do texto",
                      file=sys.stderr)
                return 1
            nova = PADRAO.sub(r"art.\1", linha)
            # A linha continua sendo JSON válido e só o texto mudou.
            depois = json.loads(nova)
            for chave in depois:
                if chave in CAMPOS_DE_TEXTO:
                    continue
                if depois[chave] != registro[chave]:
                    print(f"ABORTADO: {nome}:{numero} alterou o campo {chave!r}", file=sys.stderr)
                    return 1
            if depois.get("word_count") != registro.get("word_count"):
                print(f"ABORTADO: {nome}:{numero} mudou word_count", file=sys.stderr)
                return 1
            print(f"  {nome}:{numero} {registro.get('intent_id')}: {no_texto} ocorrência(s)")
            corrigidas += no_texto
            paginas += 1
            saida.append(nova)
        if args.aplicar:
            temporario = caminho.with_suffix(caminho.suffix + ".tmp-artigo-ponto")
            temporario.write_text("".join(saida), encoding="utf-8")
            temporario.replace(caminho)

    modo = "aplicado" if args.aplicar else "dry-run"
    print(f"generate-v2-artigo-ponto-repair-20260905: {corrigidas} ocorrência(s) "
          f"em {paginas} página(s) [{modo}]")
    return 0


if __name__ == "__main__":
    sys.exit(main())
