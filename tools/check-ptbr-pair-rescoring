#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PINNED_RAPIDFUZZ="rapidfuzz==3.14.5"
rapidfuzz_python_ok() {
	local candidate="$1"
	[[ -n "$candidate" && -x "$candidate" ]] || return 1
	"$candidate" - <<'PY' >/dev/null 2>&1
from importlib.metadata import version
from rapidfuzz import fuzz
assert version("rapidfuzz") == "3.14.5"
assert fuzz.token_set_ratio("direito brasileiro contrato", "contrato de direito brasileiro") > 80
PY
}
PY="${WIKI_RAPIDFUZZ_PYTHON:-}"
if rapidfuzz_python_ok "$PY"; then
	WIKI_RAPIDFUZZ_PYTHON="$PY" exec "$ROOT/tools/run-check" ptbr-pair-rescoring --timings "$@"
fi
PY="${WIKI_OSS_PYTHON:-}"
if rapidfuzz_python_ok "$PY"; then
	WIKI_RAPIDFUZZ_PYTHON="$PY" exec "$ROOT/tools/run-check" ptbr-pair-rescoring --timings "$@"
fi
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_RAPIDFUZZ_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/rapidfuzz-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-rapidfuzz-venv"
if [[ -n "${WIKI_RAPIDFUZZ_VENV:-}" ]]; then
	VENV="$WIKI_RAPIDFUZZ_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-rapidfuzz.txt" | awk '{print $1}')"
MARKER="$VENV/.requirements-rapidfuzz-$REQ_HASH.ok"
if [[ ! -x "$PY" ]]; then
	echo "check-ptbr-pair-rescoring: RapidFuzz environment missing; run oss-install-matrix-env or the PT-BR pair rescoring generate wrapper to materialize $PINNED_RAPIDFUZZ" >&2
	exit 1
fi
if [[ ! -f "$MARKER" ]]; then
	echo "check-ptbr-pair-rescoring: requirements-rapidfuzz environment stale; run the PT-BR pair rescoring generate wrapper to refresh $PINNED_RAPIDFUZZ" >&2
	exit 1
fi
WIKI_RAPIDFUZZ_PYTHON="$PY" exec "$ROOT/tools/run-check" ptbr-pair-rescoring --timings "$@"
