#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-ptbr-morphsyntax-evidence [--limit N] [--checked-at YYYY-MM-DD]
EOF
		exit 0
		;;
	esac
done

# Persistent repo-local default (.cache/ survives reboot/GC, unlike /tmp).
# The legacy /tmp default is reused as-is when already present so venvs
# bootstrapped by earlier prewarm runs (2026-07-23) are not rebuilt for free;
# WIKI_PTBR_MORPHSYNTAX_VENV/WIKI_STANZA_RESOURCES_DIR keep top precedence.
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-ptbr-morphsyntax-venv"
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/ptbr-morphsyntax-venv"
if [[ -n "${WIKI_PTBR_MORPHSYNTAX_VENV:-}" ]]; then
	VENV="$WIKI_PTBR_MORPHSYNTAX_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PYTHON="$VENV/bin/python"

STANZA_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-stanza-resources"
STANZA_PERSISTENT_DEFAULT="$ROOT/.cache/ptbr-morphsyntax-stanza-resources"
if [[ -n "${WIKI_STANZA_RESOURCES_DIR:-}" ]]; then
	STANZA_DIR="$WIKI_STANZA_RESOURCES_DIR"
elif [[ -d "$STANZA_LEGACY_DEFAULT" ]]; then
	STANZA_DIR="$STANZA_LEGACY_DEFAULT"
else
	STANZA_DIR="$STANZA_PERSISTENT_DEFAULT"
fi
STANZA_RESOURCES_VERSION="${WIKI_STANZA_RESOURCES_VERSION:-1.13.0}"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-ptbr-morphsyntax-oracle.txt" | awk '{print $1}')"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:ptbr-morphsyntax-evidence:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-90000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=1}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-spacy_stanza_pt_oracle_sample_evidence_written_or_failed_with_model_error}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/ptbr_morphsyntax_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-ptbr-morphsyntax-evidence}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-script_validated_record_fingerprint}"

emit_artifact_claim() {
	local path="$1"
	local input_fingerprint="$2"
	local output_fingerprint="$3"
	local lock_scope="$4"
	local budget_ms="$5"
	local stop_condition="$6"
	python3 - "$path" "$input_fingerprint" "$output_fingerprint" "$lock_scope" "$budget_ms" "$stop_condition" <<'PY'
import json
import sys

claim = {
    "path": sys.argv[1],
    "producer": "tools/generate-ptbr-morphsyntax-evidence",
    "input_fingerprint": sys.argv[2],
    "output_fingerprint_expected": sys.argv[3],
    "output_fingerprint_esperado": sys.argv[3],
    "lock_scope": sys.argv[4],
    "budget_ms": int(sys.argv[5]),
    "stop_condition": sys.argv[6],
}
print("generate-ptbr-morphsyntax-evidence: artifact_claim " + json.dumps(claim, sort_keys=True, separators=(",", ":")), flush=True)
PY
}

. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"

if [[ ! -x "$PYTHON" ]]; then
	emit_artifact_claim "$VENV" "sha256:$REQ_HASH" "sha256:$REQ_HASH" "artifact:$VENV" 300000 "venv_created_before_pinned_python_requirements_install"
	python3 -m venv "$VENV"
fi

MARKER="$VENV/.requirements-ptbr-morphsyntax-$REQ_HASH.ok"
if [[ ! -f "$MARKER" ]]; then
	emit_artifact_claim "$VENV" "sha256:$REQ_HASH" "sha256:$REQ_HASH" "artifact:$VENV:requirements-ptbr-morphsyntax" 900000 "pinned_spacy_stanza_torch_and_pt_core_news_sm_installed"
	emit_artifact_claim "$MARKER" "sha256:$REQ_HASH" "sha256:$REQ_HASH" "artifact:$VENV:requirements-ptbr-morphsyntax" 900000 "pinned_spacy_stanza_torch_and_pt_core_news_sm_installed"
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 "$PYTHON" -m pip install --disable-pip-version-check -r "$ROOT/tools/requirements-ptbr-morphsyntax-oracle.txt" >/tmp/ptbr-morphsyntax-pip-install.log
	rm -f "$VENV"/.requirements-ptbr-morphsyntax-*.ok
	touch "$MARKER"
fi

STANZA_MARKER="$STANZA_DIR/.pt-morphsyntax-tokenize-mwt-pos-lemma-depparse-resources-$STANZA_RESOURCES_VERSION-$REQ_HASH.ok"
if [[ ! -f "$STANZA_MARKER" ]]; then
	emit_artifact_claim "$STANZA_DIR" "sha256:$REQ_HASH:stanza-pt-tokenize-mwt-pos-lemma-depparse:resources-$STANZA_RESOURCES_VERSION" "sha256:$REQ_HASH:stanza-pt-tokenize-mwt-pos-lemma-depparse:resources-$STANZA_RESOURCES_VERSION" "artifact:$STANZA_DIR:pt-tokenize-mwt-pos-lemma-depparse" 900000 "stanza_pt_models_downloaded_without_ner"
	emit_artifact_claim "$STANZA_MARKER" "sha256:$REQ_HASH:stanza-pt-tokenize-mwt-pos-lemma-depparse:resources-$STANZA_RESOURCES_VERSION" "sha256:$REQ_HASH:stanza-pt-tokenize-mwt-pos-lemma-depparse:resources-$STANZA_RESOURCES_VERSION" "artifact:$STANZA_DIR:pt-tokenize-mwt-pos-lemma-depparse" 900000 "stanza_pt_models_downloaded_without_ner"
	"$PYTHON" - <<PY
import stanza
stanza.download("pt", processors="tokenize,mwt,pos,lemma,depparse", model_dir="$STANZA_DIR", verbose=False, resources_url="https://raw.githubusercontent.com/stanfordnlp/stanza-resources/main", resources_version="$STANZA_RESOURCES_VERSION")
PY
	rm -f "$STANZA_DIR"/.pt-morphsyntax-tokenize-mwt-pos-lemma-depparse-*.ok
	touch "$STANZA_MARKER"
fi

export PYTHONDONTWRITEBYTECODE=1
export WIKI_STANZA_RESOURCES_DIR="$STANZA_DIR"
export WIKI_PTBR_MORPHSYNTAX_PYTHON="$PYTHON"
# The Go command delegates to scripts/ptbr_morphsyntax_oracle.py with --mode generate
# after the pinned spaCy/Stanza environment exists, preserving one real-model oracle implementation.
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-ptbr-morphsyntax-evidence --timings --root "$ROOT" --output data/ops/ptbr_morphsyntax_evidence.jsonl --requirements tools/requirements-ptbr-morphsyntax-oracle.txt "$@"
