#!/usr/bin/env python3
"""generate-citation-inventory — extrai toda citacao legal das paginas no ar.

POR QUE EXISTE: citacao de artigo mal atribuida e a falha mais grave que os
auditores humanos encontraram no acervo, e a UNICA que nenhuma medicao
automatica deste projeto detecta. Unicidade, molde, encoding, promessa OAB —
tudo isso tem detector. "O art. 581 define comodato" nao tem: a frase e
gramatical, plausivel e esta errada (a definicao e do art. 579).

Exemplos verbatim dos vereditos humanos:
  "o art. 581 diz o oposto"
  "o rol probatorio e do art. 561, nao do 560"
  "art. 107, IX CP = perdao judicial, nao clausula residual"
  "art. 25 §3º revogado"
  "o prazo do art. 134 e 60 dias, nao 30"

Nos 25% do acervo auditados por humano, ~8% das paginas tinham esse defeito.
Sobre 9.400 publicadas isso projeta ~700 paginas — mas projecao nao e
contagem. Esta ferramenta produz o DENOMINADOR REAL: uma linha por citacao,
com a afirmacao que a pagina faz sobre aquele dispositivo, pronta para
conferencia contra o texto normativo.

O que ela NAO faz: dizer se a citacao esta certa. Isso exige o texto da norma
(data/source-registry/official_source_url_inventory.jsonl e a API publica
normas.leg.br) e e o passo seguinte. Aqui se constroi a fila.

Read-only sobre content/pages.json; grava o inventario em data/ops/.

Uso:
    tools/generate-citation-inventory
    tools/generate-citation-inventory --write
    tools/generate-citation-inventory --lane comercial --write
"""
import argparse
import collections
import glob
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
PAGES = os.path.join(ROOT, "content/pages.json")
OUT = os.path.join(ROOT, "data/ops/citation_inventory.jsonl")
SUMMARY = os.path.join(ROOT, "data/ops/citation_inventory_summary.json")

# "art. 581", "art. 1.166", "artigo 49", "arts. 186 e 927"
ARTICLE_RE = re.compile(
    r"\barts?\.?\s*|\bartigos?\s+", re.IGNORECASE)
NUMBER_RE = re.compile(r"\b(\d{1,4}(?:\.\d{3})*(?:-[A-Z])?)\s*(?:º|°)?")
# Sufixos que qualificam o dispositivo: §, inciso romano, alinea.
QUALIFIER_RE = re.compile(
    r"\s*(?:,\s*)?(?:§+\s*\d+(?:º|°)?|par[aá]grafo\s+[\wúí]+|"
    r"\b[IVXLC]{1,6}\b|al[ií]nea\s+[a-z]\b)", re.IGNORECASE)

# Diploma a que o artigo pertence, quando a frase o nomeia.
DIPLOMA_PATTERNS = [
    (r"c[oó]digo\s+civil|\bCC\b", "codigo_civil"),
    (r"c[oó]digo\s+de\s+defesa\s+do\s+consumidor|\bCDC\b", "cdc"),
    (r"c[oó]digo\s+de\s+processo\s+civil|\bCPC\b", "cpc"),
    (r"c[oó]digo\s+penal\b|\bCP\b", "codigo_penal"),
    (r"c[oó]digo\s+de\s+processo\s+penal|\bCPP\b", "cpp"),
    (r"c[oó]digo\s+tribut[aá]rio\s+nacional|\bCTN\b", "ctn"),
    (r"consolida[cç][aã]o\s+das\s+leis\s+do\s+trabalho|\bCLT\b", "clt"),
    (r"c[oó]digo\s+de\s+tr[aâ]nsito|\bCTB\b", "ctb"),
    (r"constitui[cç][aã]o|\bCF\b|carta\s+magna", "constituicao"),
    (r"estatuto\s+da\s+crian[cç]a|\bECA\b", "eca"),
    # ATO INFRALEGAL E LEI ESPECIAL NOMEADA — ausentes até 2026-08-06, e é por
    # isso que o inventário dizia "9.975 citações sem diploma nomeado".
    #
    # Medido lendo as frases: a lei ESTAVA escrita e o detector não a via. "A
    # Lei Complementar 123/2006, no art. 18-A, § 1º", "o art. 27 da Resolução
    # 280/2013", "o art. 12 da Portaria ANAC 17.476/2025" — as três foram
    # contadas como citação órfã. Em áreas reguladas (aéreo, LGPD, INPI,
    # previdenciário, tributário) a norma aplicável quase nunca é um código:
    # é resolução de agência, instrução normativa ou lei complementar.
    #
    # Contar isso como "sem diploma" não só inflava a fila de conferência —
    # apontava para o lugar errado, porque essas citações estão completas.
    (r"lei\s+complementar\s+n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?|\bLC\s*n?[ºo°]?\s*[\d.]+", "lei_complementar"),
    (r"decreto[-\s]lei\s+n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?", "decreto_lei"),
    (r"decreto\s+n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?", "decreto"),
    (r"resolu[cç][aã]o\s+(?:normativa\s+)?(?:[A-Z]{2,6}\s+)?n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?", "resolucao"),
    (r"portaria\s+(?:[A-Z]{2,6}\s+)?n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?", "portaria"),
    (r"instru[cç][aã]o\s+normativa\s+(?:[A-Z]{2,6}\s+)?n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?|\bIN\s+[A-Z]{2,6}\s*n?[ºo°]?\s*[\d.]+", "instrucao_normativa"),
    (r"medida\s+provis[oó]ria\s+n?[ºo°]?\s*[\d.]+(?:/\d{2,4})?|\bMP\s+n?[ºo°]?\s*[\d.]+", "medida_provisoria"),
    (r"estatuto\s+(do\s+idoso|da\s+pessoa\s+com\s+defici[eê]ncia|da\s+advocacia|da\s+cidade|do\s+desarmamento)", "estatuto_especifico"),
    (r"marco\s+civil\s+da\s+internet", "marco_civil"),
    (r"lei\s+geral\s+de\s+prote[cç][aã]o\s+de\s+dados|\bLGPD\b", "lgpd"),
    (r"regimento\s+interno|\bRICD\b|\bRISTF\b|\bRISTJ\b", "regimento"),
    (r"conven[cç][aã]o\s+de\s+(montreal|varsóvia|varsovia|viena)", "convencao_internacional"),
    (r"lei\s+n?[ºo°]?\s*[\d.]+/\d{2,4}", "lei_especifica"),
]

# Lei especial NOMEADA pelo numero -> slug do corpus em data/legal-corpus/.
#
# "lei_especifica" nao permite conferir nada: sao 2.889 citacoes de dezenas de
# leis diferentes. Resolver o numero para o diploma concreto e o que torna a
# citacao verificavel contra o texto oficial.
LEI_NUMERO_RE = re.compile(
    r"\b(?:lei|lei\s+complementar|lc)\s+n?[ºo°]?\s*([\d.]+)\s*(?:/|,?\s*de\s+[^,]{0,30}\bde\s+)?(\d{4})?",
    re.IGNORECASE)
LEIS_NO_CORPUS = {
    "8213": "lei_8213_1991", "8112": "lei_8112_1990", "6015": "lei_6015_1973",
    "9656": "lei_9656_1998", "9099": "lei_9099_1995", "9279": "lei_9279_1996",
    "8245": "lei_8245_1991", "4591": "lei_4591_1964", "6830": "lei_6830_1980",
    "123": "lc_123_2006", "8036": "lei_8036_1990", "9784": "lei_9784_1999",
    "14790": "lei_14790_2023", "15040": "lei_15040_2024",
    # Os codigos, quando citados pelo numero da lei em vez do apelido.
    "10406": "codigo_civil", "8078": "cdc", "13105": "cpc", "13709": "lgpd",
    "9503": "ctb", "5172": "ctn", "8069": "eca", "12965": "marco_civil",
}
DIPLOMA_RE = [(re.compile(p, re.IGNORECASE), name) for p, name in DIPLOMA_PATTERNS]


def _tetos_do_corpus():
    """Último artigo de cada diploma baixado, para refutar atribuição impossível.

    A LGPD não tem art. 170; a Lei 9.099 não tem art. 291; o CDC não tem art.
    256. Quando a inferência produz um número acima do fim da lei, ela ERROU —
    e isso é conferível sem juízo de valor. Medido em 2026-08-06: 29 citações
    nessa situação, todas por engano do inventário e nenhuma por erro da
    página. Exemplos: "o § 1º do art. 291 do mesmo Código" (o mesmo Código é o
    CTB, e a proximidade pegou a Lei 9.099 citada na sequência) e "O art.
    1.423 permite que ele retenha o imóvel" (sem diploma na frase, a
    proximidade pegou uma menção distante à Constituição).

    Manter a atribuição errada seria pior que não ter nenhuma: a conferência
    compararia a afirmação da página com o texto de outra lei.
    """
    tetos = {}
    for caminho in glob.glob(os.path.join(ROOT, "data/legal-corpus", "*.json")):
        try:
            with open(caminho, encoding="utf-8") as handle:
                artigos = json.load(handle).get("articles", {})
        except (OSError, ValueError):
            continue
        numeros = [int(chave) for chave in artigos if chave.isdigit()]
        if numeros:
            tetos[os.path.basename(caminho)[:-5]] = max(numeros)
    return tetos


TETO_DO_DIPLOMA = _tetos_do_corpus()


def diploma_refutado_pelo_corpus(diploma, artigo):
    """True quando o número do artigo passa do último artigo daquela lei."""
    teto = TETO_DO_DIPLOMA.get(diploma)
    if not teto:
        return False
    base = re.match(r"\d+", (artigo or "").replace(".", ""))
    return bool(base) and int(base.group()) > teto

# Abreviacoes cujo ponto NAO encerra frase. Sem esta protecao o divisor corta
# exatamente onde a citacao comeca: "O art. 17 preve..." vira ["O art.", "17
# preve..."], o numero fica orfao e a citacao desaparece do inventario. Foi o
# que aconteceu na primeira versao — 9.409 paginas analisadas, ZERO citacoes
# encontradas, num acervo que cita artigo em quase toda pagina.
ABBREVIATIONS = [
    "art", "arts", "artigo", "artigos", "inc", "incs", "par", "pars",
    "al", "n", "nº", "no", "p", "pp", "cf", "ss", "seg", "segs",
    "lei", "dec", "res", "port", "sum", "ac", "min", "rel", "proc",
    "cc", "cdc", "cpc", "cp", "cpp", "ctn", "clt", "ctb", "eca",
    "stf", "stj", "tst", "trf", "des", "dr", "sr", "sra", "obs", "ex",
]
_ABBREV_RE = re.compile(
    r"\b(" + "|".join(re.escape(a) for a in ABBREVIATIONS) + r")\.", re.IGNORECASE)
_SENTENCE_SPLIT_RAW = re.compile(r"(?<=[.!?])\s+")
_ABBREV_MARK = "\x00"


def split_sentences(text):
    """Divide em frases sem quebrar dentro de abreviacao juridica."""
    protected = _ABBREV_RE.sub(lambda m: m.group(1) + _ABBREV_MARK, text)
    for sentence in _SENTENCE_SPLIT_RAW.split(protected):
        yield sentence.replace(_ABBREV_MARK, ".")


def _encerra(trecho):
    """Fecha o bloco com ponto quando ele nao tem pontuacao final.

    Titulo de secao nao termina em ponto, e sem isso ele COLA na primeira frase
    do paragrafo seguinte. A citacao herdava entao uma afirmacao que nao era
    dela: em /consumidor/carro-usado-da-loja-com-defeito/, o titulo "A garantia
    legal de 90 dias tambem protege quem compra carro usado de loja" grudava na
    frase que cita o art. 18 do CDC, e a conferencia lia a pagina como se ela
    atribuisse os 90 dias ao art. 18 — quando esse prazo e do art. 26, II, e a
    pagina nao dizia nada de errado.
    """
    trecho = (trecho or "").strip()
    if not trecho:
        return ""
    return trecho if trecho[-1] in ".!?:;" else trecho + "."


def page_text(page):
    parts = [_encerra(page.get("summary"))]
    for section in page.get("body_sections") or []:
        parts.append(_encerra(section.get("title")))
        parts.append(_encerra(section.get("body")))
    for item in page.get("faq") or []:
        parts.append(_encerra(item.get("question")))
        parts.append(_encerra(item.get("answer")))
    return "\n".join(parts)


def find_diploma(sentence, position):
    """Diploma citado MAIS PROXIMO do artigo, medido em distancia de caracteres.

    A versao anterior devolvia o primeiro padrao da LISTA que casasse na janela,
    e a lista comeca pelo Codigo Civil. Numa frase que cita dois diplomas o
    resultado era sistematicamente errado:

      "a impenhorabilidade do art. 833 do CPC"      -> atribuido ao CDC
      "Pela regra geral do art. 373 do CPC"         -> atribuido ao CDC
      "O CBA enumera no art. 256, § 3º"             -> atribuido ao CDC

    Nos tres a palavra "CDC" aparecia em outro ponto da frase e vencia por estar
    antes na lista. O erro so ficou visivel ao conferir contra o texto oficial:
    "art. 833 do CDC" nao existe, porque o CDC tem 119 artigos.

    Agora vence a MENOR distancia ao numero do artigo. Empate resolve pela
    ordem da lista, que mantem o comportamento antigo onde ele nao fazia mal.
    """
    inicio = max(0, position - 160)
    window = sentence[inicio:position + 160]
    relativa = position - inicio

    # "art. N DO DIPLOMA" é a forma canônica em português, e nela o diploma que
    # SEGUE o artigo é o dono — mesmo que outro apareça mais perto antes.
    #
    # Sem esta regra, "o STF deu interpretação conforme a Constituição ao art.
    # 1.723 do Código Civil" atribuía o artigo à Constituição, que tem 250
    # artigos. O erro só apareceu ao conferir contra o corpus: "art. 1.723 da
    # Constituição" não existe.
    # A janela começa no MARCADOR ("art."), não no número — por isso o padrão
    # consome o próprio "art.", o número, e os qualificadores (§, inciso,
    # alínea) antes de procurar o "do/da".
    depois = window[relativa:relativa + 90]
    posse = re.match(
        r"(?:arts?\.?|artigos?)?\s*[\d.]+\s*[ºo°]?\s*(?:[,\s]*(?:§+\s*[\d.ºo°]+|inc(?:iso)?s?\.?\s*[IVXLC]+|al[íi]neas?\s*[a-z]\)?|[IVXLC]+\b|[a-z]\)))*\s*,?\s*d[oaes]s?\s+",
        depois, re.IGNORECASE)
    if posse:
        resto = depois[posse.end():]
        for pattern, name in DIPLOMA_RE:
            achado = pattern.match(resto)
            if achado:
                if name in ("lei_especifica", "lei_complementar"):
                    numero = LEI_NUMERO_RE.search(resto[:60])
                    if numero:
                        return LEIS_NO_CORPUS.get(numero.group(1).replace(".", ""), name)
                return name

    def resolver(nome, trecho):
        """lei_especifica vira o slug concreto quando o numero esta no corpus."""
        if nome not in ("lei_especifica", "lei_complementar"):
            return nome
        achado = LEI_NUMERO_RE.search(trecho)
        if not achado:
            return nome
        numero = achado.group(1).replace(".", "")
        return LEIS_NO_CORPUS.get(numero, nome)

    melhor_nome, melhor_distancia, melhor_trecho = "", None, ""
    for pattern, name in DIPLOMA_RE:
        for match in pattern.finditer(window):
            # Distancia da MENCAO ao numero do artigo, nos dois sentidos.
            if match.end() <= relativa:
                distancia = relativa - match.end()
            elif match.start() >= relativa:
                distancia = match.start() - relativa
            else:
                distancia = 0
            if melhor_distancia is None or distancia < melhor_distancia:
                melhor_nome, melhor_distancia = name, distancia
                melhor_trecho = window[max(0, match.start() - 5):match.end() + 25]
    return resolver(melhor_nome, melhor_trecho)


def extract(page):
    """Uma entrada por citacao, com a frase inteira que a contem.

    A frase importa mais que o numero: e nela que esta a AFIRMACAO a conferir.
    Saber que a pagina cita o art. 581 nao ajuda; saber que ela afirma "o art.
    581 define o comodato" e o que permite dizer que esta errado.
    """
    found = []
    text = page_text(page)
    for sentence in split_sentences(text):
        sentence = " ".join(sentence.split())
        if len(sentence) < 20:
            continue
        for marker in ARTICLE_RE.finditer(sentence):
            tail = sentence[marker.end():]
            number_match = NUMBER_RE.match(tail)
            if not number_match:
                continue
            article = number_match.group(1)
            qualifier_match = QUALIFIER_RE.match(tail[number_match.end():])
            qualifier = qualifier_match.group(0).strip(" ,") if qualifier_match else ""
            diploma = find_diploma(sentence, marker.start())
            # Atribuição que o próprio texto oficial refuta não entra: vazia é
            # honesta, errada contamina toda a conferência a jusante.
            if diploma_refutado_pelo_corpus(diploma, article):
                diploma = ""
            found.append({
                "article": article,
                "qualifier": qualifier,
                "diploma": diploma,
                "claim": sentence[:400],
            })
    # Dedup por (artigo, qualificador, diploma) preservando a primeira frase.
    unique = {}
    for entry in found:
        key = (entry["article"], entry["qualifier"], entry["diploma"])
        unique.setdefault(key, entry)
    return list(unique.values())


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--lane", default="", choices=["", "comercial", "informativa"],
                        help="restringe a uma faixa editorial")
    args = parser.parse_args()

    with open(PAGES, encoding="utf-8") as handle:
        pages = json.load(handle)
    pages = [p for p in pages if p.get("unique_intent_id")]
    if args.lane:
        pages = [p for p in pages if (p.get("cta_lane") or "") == args.lane]

    rows = []
    per_page = collections.Counter()
    diplomas = collections.Counter()
    articles = collections.Counter()
    without_diploma = 0

    for page in pages:
        citations = extract(page)
        per_page[len(citations)] += 1
        for citation in citations:
            diplomas[citation["diploma"] or "(nao nomeado)"] += 1
            articles[(citation["diploma"], citation["article"])] += 1
            if not citation["diploma"]:
                without_diploma += 1
            rows.append({
                "intent_id": page["unique_intent_id"],
                "path": page["path"],
                "lane": page.get("cta_lane") or "",
                "article": citation["article"],
                "qualifier": citation["qualifier"],
                "diploma": citation["diploma"],
                "claim": citation["claim"],
                "verified": False,
                "verdict": "",
            })

    pages_with = sum(count for size, count in per_page.items() if size > 0)
    print("=== INVENTARIO DE CITACAO LEGAL ===")
    print("paginas analisadas        : %d%s" % (len(pages), " (lane %s)" % args.lane if args.lane else ""))
    print("paginas que citam artigo  : %d (%.1f%%)" % (pages_with, 100.0 * pages_with / max(len(pages), 1)))
    print("citacoes distintas        : %d" % len(rows))
    print("citacoes sem diploma nomeado: %d (%.1f%%) — ambiguas, conferir primeiro"
          % (without_diploma, 100.0 * without_diploma / max(len(rows), 1)))

    print("\n--- por diploma ---")
    for name, count in diplomas.most_common(14):
        print("  %-22s %6d" % (name, count))

    print("\n--- dispositivos mais citados ---")
    for (diploma, article), count in articles.most_common(12):
        print("  %6d  art. %-10s %s" % (count, article, diploma or "(nao nomeado)"))

    print("\n--- citacoes por pagina ---")
    for size in sorted(per_page):
        if size <= 6 or size % 5 == 0:
            print("  %2d citacoes: %d paginas" % (size, per_page[size]))

    if not args.write:
        print("\nrelatorio apenas. rode com --write para gravar a fila.")
        return 0

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")
    with open(SUMMARY, "w", encoding="utf-8") as handle:
        json.dump({
            "generated_at": "2026-08-06",
            "pages_analyzed": len(pages),
            "pages_with_citation": pages_with,
            "citations": len(rows),
            "citations_without_diploma": without_diploma,
            "by_diploma": dict(diplomas),
            "lane": args.lane or "todas",
        }, handle, ensure_ascii=False, indent=1)
    print("\ngravado %s (%d citacoes)" % (os.path.relpath(OUT, ROOT), len(rows)))
    print("gravado %s" % os.path.relpath(SUMMARY, ROOT))
    print("\nProximo passo: conferir cada `claim` contra o texto do dispositivo")
    print("(data/source-registry/official_source_url_inventory.jsonl e a API")
    print("publica normas.leg.br), gravando o veredito em `verified`/`verdict`.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
