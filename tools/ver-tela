#!/usr/bin/env python3
"""ver-tela — captura a tela do servidor e localiza texto nela, com coordenadas.

READ-ONLY: captura e lê. NÃO move mouse, NÃO digita, NÃO clica. O controle é
outra ferramenta, deliberadamente separada — ver é barato e reversível, agir
não é.

POR QUE EXISTE. A automação por seletor de DOM falhou nas três redes sociais: o
Instagram abre seletor de arquivo nativo que o DOM não alcança, e no Facebook o
botão final de publicar não aparece nem por `role=button` nem por busca de
texto. Ver a tela contorna isso — mas só se o agente souber ONDE clicar, e é
para isso que serve o OCR com coordenada.

NÚMEROS MEDIDOS em 2026-08-27 (Debian, X11, 1920x1080):
  captura com scrot .......... 0,28 s   PNG ~200 KB
  OCR da tela inteira ........ 3,5 s    confiança 89-92% em rótulo de botão
  janela ativa apenas ........ bem menos, e é o modo a preferir

CUSTO DE CONTEXTO. Cada PNG que o agente lê consome tokens. 1920x1080 inteiro é
caro e quase sempre desnecessário: prefira --janela (só a janela ativa) ou
--regiao. O --texto não devolve imagem nenhuma, só coordenadas — é o modo mais
barato de todos e resolve a maioria das perguntas ("onde está o botão X?").

USO
  ./tools/ver-tela                      captura a tela inteira, reduzida
  ./tools/ver-tela --janela             só a janela ativa (mais barato)
  ./tools/ver-tela --texto Publicar     ONDE está esse texto (sem imagem)
  ./tools/ver-tela --listar-janelas     o que está aberto
  ./tools/ver-tela --regiao 0,0,800,600
"""

import argparse
import csv
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
SAIDA = RAIZ / ".agents/runtime/tela"
DISPLAY = os.environ.get("DISPLAY") or ":0.0"
# Reduzir antes de o agente ler: a diferença entre 1920 e 1400 de largura é
# invisível para reconhecer um botão e economiza tokens em toda leitura.
LARGURA_MAXIMA = 1400


def exigir(binario: str) -> None:
    if not shutil.which(binario):
        raise SystemExit(f"ERRO: {binario} não está instalado. `sudo apt install {binario}`")


def capturar(destino: Path, janela_ativa: bool, regiao: str | None) -> Path:
    """Captura a tela, a janela ativa ou uma região. Devolve o caminho do PNG."""
    exigir("scrot")
    env = {**os.environ, "DISPLAY": DISPLAY}
    destino.parent.mkdir(parents=True, exist_ok=True)

    if janela_ativa:
        # import -window com o id da janela ativa: captura SÓ ela, o que corta
        # o desktop inteiro do que o agente precisa ler.
        exigir("xdotool")
        exigir("import")
        wid = subprocess.run(["xdotool", "getactivewindow"], env=env,
                             capture_output=True, text=True).stdout.strip()
        if not wid:
            raise SystemExit("ERRO: não consegui identificar a janela ativa.")
        subprocess.run(["import", "-window", wid, str(destino)], env=env, check=True)
    elif regiao:
        try:
            x, y, w, h = (int(v) for v in regiao.split(","))
        except ValueError:
            raise SystemExit("ERRO: --regiao espera x,y,largura,altura (ex.: 0,0,800,600)")
        subprocess.run(["import", "-window", "root", "-crop", f"{w}x{h}+{x}+{y}",
                        str(destino)], env=env, check=True)
    else:
        subprocess.run(["scrot", "-o", str(destino)], env=env, check=True)
    return destino


def reduzir(png: Path) -> tuple[Path, tuple[int, int], float]:
    """Reduz a imagem para leitura barata. Devolve (caminho, tamanho, escala).

    A ESCALA IMPORTA e é devolvida de propósito: quem for clicar precisa
    converter a coordenada vista na imagem reduzida de volta para a tela real.
    Perder esse fator é como o clique acaba 300px fora.
    """
    from PIL import Image

    with Image.open(png) as im:
        original = im.size
        if im.width <= LARGURA_MAXIMA:
            return png, original, 1.0
        escala = LARGURA_MAXIMA / im.width
        menor = png.with_name(png.stem + "-menor.png")
        im.resize((LARGURA_MAXIMA, round(im.height * escala))).save(menor)
        return menor, original, escala


def localizar(png: Path, alvo: str, confianca_minima: int = 55) -> list[dict]:
    """Localiza um texto na imagem e devolve as coordenadas de clique.

    Usa tesseract em TSV, que dá bounding box por palavra. O centro da caixa é
    onde se clica — estimar coordenada "de olho" na imagem erra por dezenas de
    pixels, e nesta tela isso é a diferença entre o botão e o que está ao lado.
    """
    exigir("tesseract")
    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp) / "ocr"
        subprocess.run(["tesseract", str(png), str(base), "-l", "por", "--psm", "11", "tsv"],
                       capture_output=True, check=True)
        achados = []
        with open(f"{base}.tsv", encoding="utf-8") as fh:
            for linha in csv.DictReader(fh, delimiter="\t", quoting=csv.QUOTE_NONE):
                texto = (linha.get("text") or "").strip()
                try:
                    conf = float(linha.get("conf") or -1)
                except ValueError:
                    continue
                if not texto or conf < confianca_minima:
                    continue
                if alvo.lower() not in texto.lower():
                    continue
                x, y = int(linha["left"]), int(linha["top"])
                w, h = int(linha["width"]), int(linha["height"])
                achados.append({"texto": texto, "x": x + w // 2, "y": y + h // 2,
                                "confianca": int(conf), "caixa": [x, y, w, h]})
    return achados


def listar_janelas() -> None:
    exigir("wmctrl")
    env = {**os.environ, "DISPLAY": DISPLAY}
    saida = subprocess.run(["wmctrl", "-lG"], env=env, capture_output=True, text=True).stdout
    print("janelas abertas (id, posição x y, tamanho, título):")
    for linha in saida.splitlines():
        partes = linha.split(None, 7)
        if len(partes) >= 8:
            wid, _, x, y, w, h, _, titulo = partes
            print(f"  {wid}  ({x},{y}) {w}x{h}  {titulo}")


def main() -> int:
    p = argparse.ArgumentParser(description="captura e lê a tela do servidor (read-only)")
    p.add_argument("--janela", action="store_true", help="só a janela ativa (mais barato)")
    p.add_argument("--regiao", help="x,y,largura,altura")
    p.add_argument("--texto", help="localizar este texto e devolver a coordenada de clique")
    p.add_argument("--listar-janelas", action="store_true")
    args = p.parse_args()

    if args.listar_janelas:
        listar_janelas()
        return 0

    SAIDA.mkdir(parents=True, exist_ok=True)
    bruto = capturar(SAIDA / "tela.png", args.janela, args.regiao)

    if args.texto:
        # Localiza no PNG EM TAMANHO REAL: as coordenadas saem prontas para o
        # xdotool, sem precisar desfazer escala nenhuma.
        achados = localizar(bruto, args.texto)
        if not achados:
            print(f'texto "{args.texto}" NÃO encontrado na tela.')
            return 1
        print(f'"{args.texto}" encontrado {len(achados)}x (coordenadas da tela real):')
        for a in achados:
            print(f"  ({a['x']}, {a['y']})  confiança {a['confianca']}%  texto lido: {a['texto']!r}")
        return 0

    menor, original, escala = reduzir(bruto)
    print(f"captura: {menor}")
    print(f"  tela real: {original[0]}x{original[1]}  |  escala aplicada: {escala:.3f}")
    if escala != 1.0:
        print(f"  ATENÇÃO: para clicar, divida a coordenada vista por {escala:.3f}")
    print(f"  tamanho do arquivo: {menor.stat().st_size // 1024} KB")
    return 0


if __name__ == "__main__":
    sys.exit(main())
