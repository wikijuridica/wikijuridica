def ultima_linha_da_serie():
    """A última janela gravada, ou {} se a série não existe/está ilegível.

    Serve para responder UMA pergunta: este orçamento já estava reprovado antes?
    Sem isso, a resolução ("voltou ao normal") seria emitida a cada execução —
    o timer roda de 30 em 30 minutos, e seriam 144 linhas por dia em
    data/ops/owner_alerts.jsonl dizendo que nada aconteceu. Ledger de alerta que
    cresce sem evento é como o dono aprende a não abrir o ledger de alerta.
    """
    try:
        with open(SERIE, encoding="utf-8") as arquivo:
            ultima = ""
            for linha in arquivo:
                if linha.strip():
                    ultima = linha
    except OSError:
        return {}
    if not ultima:
        return {}
    try:
        return json.loads(ultima)
    except ValueError:
        return {}


def notificar(registro, dominio, anterior):
    """Transmite ao dono o que ESTA execucao mediu, pelo canal unico do repo.

    Nao inventa evento e nao repete o que ja esta aberto — a deduplicacao por
    chave e o cooldown moram no proprio notify-owner. Chave por orcamento, para
    que a rajada de 530 (que exige agir em minutos) nao seja silenciada pelo
    cooldown de um 404 em massa que dura dias.

    Emitir alerta nao transforma este check em ferramenta de escrita (DEC-040):
    o veredito continua vindo da borda e a serie continua sendo o artefato.
    """
    binario = os.path.join(ROOT, "tools/notify-owner")
    if not os.access(binario, os.X_OK):
        print("check-crawler-error-budget: AVISO — tools/notify-owner ausente ou nao executavel; "
              "o alerta NAO foi entregue", file=sys.stderr)
        return

    def envia(chave, severidade, titulo, mensagem, resolvido=False):
        comando = [binario, "--chave", chave, "--origem", "check-crawler-error-budget",
                   "--titulo", titulo, "--mensagem", mensagem]
        if resolvido:
            comando.append("--resolvido")
        else:
            comando += ["--severidade", severidade,
                        "--evidencia", "data/ops/crawler_error_budget.jsonl (%s, janela de %dh, "
                                       "zona %s)" % (SCHEMA, registro["window_hours"], dominio)]
        try:
            saida = subprocess.run(comando, check=False)
        except OSError as erro:
            print("check-crawler-error-budget: AVISO — notify-owner falhou (%s)" % erro,
                  file=sys.stderr)
            return
        if saida.returncode != 0:
            print("check-crawler-error-budget: AVISO — notify-owner saiu %d; o alerta NAO foi "
                  "entregue" % saida.returncode, file=sys.stderr)

    # A resolução só sai quando a janela ANTERIOR estava reprovada naquele mesmo
    # orçamento — é o único momento em que "voltou ao normal" é notícia.
    def resolveu(campo):
        return bool(anterior.get(campo)) and not registro[campo]

    if registro["breached"]:
        envia("crawler-erro-indisponibilidade", "critica",
              "%d erro(s) 5xx/429/403 a crawler verificado" % registro["errors_total"],
              "Pior hora %s com %d. 530 = tunel fora, 502 = origem recusando."
              % (registro["worst_hour"] or "-", registro["worst_hour_errors"]))
    elif resolveu("breached"):
        envia("crawler-erro-indisponibilidade", "info",
              "Nenhum 5xx/429/403 a crawler verificado",
              "Janela de %dh limpa na borda." % registro["window_hours"], resolvido=True)

    if registro["breached_404_mass"]:
        piores = ", ".join("%s %d de %d (%.0f%%)"
                           % (i["agent_key"], i["requests_404"], i["requests_total"],
                              100 * i["share_404"])
                           for i in registro["wasted_404"][:3])
        envia("crawler-404-em-massa", "alta",
              "404 em massa a %d agente(s) verificado(s)" % len(registro["wasted_404"]),
              "O portal ensina que os enderecos nao existem: " + piores)
    elif resolveu("breached_404_mass"):
        envia("crawler-404-em-massa", "info", "Nenhum 404 em massa a agente verificado",
              "Janela de %dh dentro do teto." % registro["window_hours"], resolvido=True)

    if registro["breached_301_waste"]:
        piores = ", ".join("%s %.0f%% (%d de %d)"
                           % (i["agent_key"], 100 * i["share_301"], i["requests_301"],
                              i["requests_total"])
                           for i in registro["wasted_301"][:3])
        envia("crawler-301-desperdicado", "alta",
              "Orcamento de rastreio gasto em redirecionamento em %d agente(s)"
              % len(registro["wasted_301"]),
              "Concentracao assim e padrao de URL, nao acaso: " + piores)
    elif resolveu("breached_301_waste"):
        envia("crawler-301-desperdicado", "info", "Nenhum agente gastando o rastreio em 301",
              "Janela de %dh dentro do teto." % registro["window_hours"], resolvido=True)

    # Crítica, e não alta: robots.txt em 5xx é o Google tratando o host inteiro
    # como bloqueado, e isso se resolve em minutos ou custa semanas de rastreio.
    if registro["breached_discovery_port"]:
        piores = ", ".join("%s %d x %d em %s://%s%s"
                           % (i["agent_key"], i["count"], i["status"], i["scheme"], i["host"],
                              i["path"])
                           for i in registro["discovery_port_failures"][:3])
        envia("crawler-porta-de-descoberta", "critica",
              "Porta de descoberta respondendo erro a bot verificado",
              "/, robots.txt ou sitemap.xml sem conteudo: " + piores)
    elif resolveu("breached_discovery_port"):
        envia("crawler-porta-de-descoberta", "info",
              "Portas de descoberta limpas para bot verificado",
              "Janela de %dh sem 3xx/4xx/5xx fora da consolidacao." % registro["window_hours"],
              resolvido=True)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--horas", type=int, default=6,
                        help="tamanho da janela examinada (padrão 6)")
    parser.add_argument("--teto-hora", type=int, default=TETO_POR_HORA,
                        help="erros por hora que reprovam (padrão %d)" % TETO_POR_HORA)
    parser.add_argument("--teto-janela", type=int, default=TETO_JANELA,
                        help="erros na janela que reprovam (padrão %d)" % TETO_JANELA)
    parser.add_argument("--teto-404-janela", dest="teto_404_janela", type=int,
                        default=TETO_404_JANELA,
                        help="404 por agente verificado na janela que reprovam (padrão %d)"
                             % TETO_404_JANELA)
    parser.add_argument("--teto-404-hora", dest="teto_404_hora", type=int, default=TETO_404_HORA,
                        help="404 por agente verificado numa hora que reprovam (padrão %d)"
                             % TETO_404_HORA)
    parser.add_argument("--teto-301", dest="teto_301", type=float, default=TETO_301_PROPORCAO,
                        help="proporção de 301 por agente que reprova (padrão %.2f)"
                             % TETO_301_PROPORCAO)
    parser.add_argument("--piso-301", dest="piso_301", type=int, default=PISO_301_RESPOSTAS,
                        help="respostas 301 de desperdício mínimas para o teto de proporção "
                             "valer (padrão %d; era 200, inalcançável em 6h)" % PISO_301_RESPOSTAS)
    parser.add_argument("--piso-301-denominador", dest="piso_301_denominador", type=int,
                        default=PISO_301_DENOMINADOR,
                        help="requisições mínimas do agente na janela para a proporção de 301 "
                             "ser lida (padrão %d)" % PISO_301_DENOMINADOR)
    parser.add_argument("--autoteste", action="store_true",
                        help="exercita as regras C e D sobre os números reais do defeito, sem rede")
    parser.add_argument("--notificar", action="store_true",
                        help="além de imprimir, aciona tools/notify-owner. Emitir alerta não é "
                             "escrita de gate (DEC-040): o veredito continua vindo da borda, e "
                             "o canal só transmite o que esta execução mediu")
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    parser.add_argument("--sem-registro", action="store_true",
                        help="não anexa a %s" % os.path.relpath(SERIE, ROOT))
    args = parser.parse_args()

    if args.autoteste:
        return autoteste()

    env = ler_env()
    headers = cabecalhos(env)
    if not headers:
        print("check-crawler-error-budget: sem credencial Cloudflare em .env.local "
              "(CLOUDFLARE_ZONE_TOKEN ou CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN) — "
              "sem credencial nao ha como ler a borda, e a borda e a unica testemunha do 530",
              file=sys.stderr)
        return 2

    dominio = dominio_do_site()
    zona, erro = resolver_zona(headers, dominio)
    if erro:
        print("check-crawler-error-budget: zona indisponivel (%s)" % erro, file=sys.stderr)
        return 2

    # Segunda lane de verificação (v5): faixa de IP oficial do operador — a
    # mesma fonte e a mesma função que a ORIGEM usa (botagents.ler_faixas +
    # em_faixa) — e a rede desta casa, medida AO VIVO, nunca hardcoded.
    faixas = botagents.ler_faixas(ROOT)
    rede_casa = rede_desta_casa(dominio)
    if rede_casa is None:
        print("check-crawler-error-budget: AVISO — nao consegui medir o IP desta casa em "
              "cdn-cgi/trace; 'sonda deste repo' fica restrito ao criterio de pais (BR)",
              file=sys.stderr)

    agora = datetime.datetime.now(datetime.timezone.utc)
    desde = agora - datetime.timedelta(hours=args.horas)
    formato = FORMATO

    grupos, erro, fatiamento = coletar(headers, CONSULTA, {"zona": zona}, desde, agora, 10000)
    if erro:
        print("check-crawler-error-budget: consulta falhou (%s)" % erro, file=sys.stderr)
        return 2
    grupos_portas, erro, fatiamento_portas = coletar(
        headers, CONSULTA_PORTAS, {"zona": zona, "rotas": list(PORTAS_DE_DESCOBERTA)},
        desde, agora, 10000)
    if erro:
        print("check-crawler-error-budget: consulta das portas de descoberta falhou (%s)" % erro,
              file=sys.stderr)
        return 2
    for rotulo, fatias in (("principal", fatiamento), ("portas", fatiamento_portas)):
        if fatias["truncadas"]:
            print("check-crawler-error-budget: AVISO — consulta %s cortada no teto da API em %d "
                  "fatia(s) de 1h; a contagem e piso, nao total" % (rotulo, fatias["truncadas"]),
                  file=sys.stderr)

    # ORÇAMENTO A — indisponibilidade a crawler verificado de busca/usuário.
    por_hora = {}
    por_agente = {}
    total = 0
    amostras = []
    nao_verificados = 0

    # ORÇAMENTOS B e C — por agente verificado, qualquer função.
    servidas_por_agente = {}       # agente -> requisições totais na janela
    q404_por_agente = {}           # agente -> respostas 404
    q404_por_agente_hora = {}      # agente -> hora -> respostas 404
    q301_por_agente = {}           # agente -> respostas 301 de DESPERDÍCIO (https no apex)
    consolidacao_por_agente = {}   # agente -> {"www": n, "http": n}, 301 que não reprova
    funcao_por_agente = {}
    # Método que sustenta a verificação de cada agente ("cloudflare" e/ou
    # "ip_range") — para que a linha diga COMO, nunca só QUANTO.
    metodo_por_agente = {}
    # Corroboracao da classe "http": agente com 2xx sob TLS=none nao esta chegando
    # por HTTP externo. Ver agentes_com_2xx_sob_none.
    sem_corroboracao_http = agentes_com_2xx_sob_none(grupos)

    # POPULAÇÃO NÃO VERIFICADA — reportada por inteiro, nunca reprova. Dividida
    # em DUAS desde a v5: "sonda_local" (país BR ou rede desta casa — a
    # verificação local saindo desta máquina) e "nao_verificado" (nem
    # Cloudflare, nem faixa oficial, nem origem local — pode ser operador cuja
    # faixa não temos catalogada, ou o scanner que o cabeçalho deste módulo
    # descreve). Antes da v5 as duas eram uma coisa só e o texto da saída
    # afirmava que TUDO ali era "a sonda deste repo" — falso para a segunda.
    nv_servidas = {}
    nv_status = {}                 # agente -> status -> contagem
    nv_amostras = []
    nv_metodo = {}                 # agente -> "sonda_local" | "nao_verificado" (predominante)
    nv_servidas_local = {}         # agente -> requisições, sonda_local apenas
    nv_servidas_outros = {}        # agente -> requisições, nao_verificado apenas

    for grupo in grupos:
        dimensoes = grupo.get("dimensions") or {}
        user_agent = dimensoes.get("userAgent") or ""
        chave = botagents.agente_de(user_agent)
        if not chave:
            continue
        quantidade = grupo.get("count", 0)
        hora = (dimensoes.get("datetimeHour") or "")[:13]
        status = dimensoes.get("edgeResponseStatus")
        try:
            codigo = int(status)
        except (TypeError, ValueError):
            codigo = 0
        metodo = verificacao_de(chave, dimensoes, faixas, rede_casa)
        verificado = metodo in ("cloudflare", "ip_range")
        funcao = botagents.funcao_de(chave)

        # Nem Cloudflare nem faixa oficial: ou é sonda desta casa (BR/rede
        # própria), ou é User-Agent forjado, ou é operador cuja faixa não
        # temos catalogada. Contá-lo junto do crawler homônimo é o defeito que
        # a v2 tinha nos dois sentidos — inflava o erro do crawler e escondia o
        # scanner. Aqui ele é uma população à parte, com detalhe por status e
        # por método, e NÃO participa de veredito.
        if not verificado:
            nv_servidas[chave] = nv_servidas.get(chave, 0) + quantidade
            balde = nv_status.setdefault(chave, {})
            balde[str(codigo)] = balde.get(str(codigo), 0) + quantidade
            if metodo == "sonda_local":
                nv_servidas_local[chave] = nv_servidas_local.get(chave, 0) + quantidade
            else:
                nv_servidas_outros[chave] = nv_servidas_outros.get(chave, 0) + quantidade
            baldes_metodo = nv_metodo.setdefault(chave, {})
            baldes_metodo[metodo] = baldes_metodo.get(metodo, 0) + quantidade
            if classificar(status) and len(nv_amostras) < 12:
                nv_amostras.append({
                    "agent_key": chave,
                    "count": quantidade,
                    "hour": hora,
                    "status": status,
                    "method": metodo,
                })
            continue

        baldes_metodo_verificado = metodo_por_agente.setdefault(chave, {})
        baldes_metodo_verificado[metodo] = baldes_metodo_verificado.get(metodo, 0) + quantidade
        funcao_por_agente[chave] = funcao
        servidas_por_agente[chave] = servidas_por_agente.get(chave, 0) + quantidade
        if codigo == 404:
            q404_por_agente[chave] = q404_por_agente.get(chave, 0) + quantidade
            porhora = q404_por_agente_hora.setdefault(chave, {})
            porhora[hora] = porhora.get(hora, 0) + quantidade
        elif codigo == 301:
            classe = classe_de_consolidacao(dimensoes.get("clientRequestHTTPHost"),
                                            dimensoes.get("clientSSLProtocol"),
                                            chave not in sem_corroboracao_http)
            if classe:
                balde = consolidacao_por_agente.setdefault(chave, {})
                balde[classe] = balde.get(classe, 0) + quantidade
            else:
                q301_por_agente[chave] = q301_por_agente.get(chave, 0) + quantidade

        if funcao not in FUNCOES_VALIOSAS:
            continue
        rotulo = classificar(status)
        if not rotulo:
            continue
        por_hora[hora] = por_hora.get(hora, 0) + quantidade
        por_agente[chave] = por_agente.get(chave, 0) + quantidade
        total += quantidade
        if len(amostras) < 12:
            amostras.append({
                "agent_key": chave,
                "count": quantidade,
                "hour": hora,
                "status": status,
            })

    # `errors_unverified_ua_discarded` é o campo que a v2 gravava; ele continua
    # com EXATAMENTE o mesmo significado (erro de disponibilidade servido a UA
    # não verificado) para não quebrar quem já lê a série, e agora convive com o
    # detalhe completo em `unverified_population`.
    for chave, baldes in nv_status.items():
        for codigo_texto, quantidade in baldes.items():
            if classificar(codigo_texto):
                nao_verificados += quantidade

    pior_hora, pior_contagem = ("", 0)
    for hora, contagem in por_hora.items():
        if contagem > pior_contagem:
            pior_hora, pior_contagem = hora, contagem

    estourou_hora = pior_contagem >= args.teto_hora
    estourou_janela = total >= args.teto_janela
    reprovou = estourou_hora or estourou_janela

    # ORÇAMENTO B — 404 em massa por agente verificado.
    massa_404 = []
    sondas_de_protocolo = {}
    for chave, quantidade in sorted(q404_por_agente.items(), key=lambda kv: -kv[1]):
        if chave in AGENTES_QUE_SONDAM_PROTOCOLO:
            sondas_de_protocolo[chave] = quantidade
            continue
        horas = q404_por_agente_hora.get(chave, {})
        pior_h, pior_n = "", 0
        for hora, contagem in horas.items():
            if contagem > pior_n:
                pior_h, pior_n = hora, contagem
        if quantidade < args.teto_404_janela and pior_n < args.teto_404_hora:
            continue
        servidas = servidas_por_agente.get(chave, 0)
        massa_404.append({
            "agent_key": chave,
            "function": funcao_por_agente.get(chave, "unknown"),
            "requests_404": quantidade,
            "requests_total": servidas,
            "share_404": round(quantidade / servidas, 4) if servidas else 0.0,
            "worst_hour": pior_h,
            "worst_hour_404": pior_n,
        })

    # ORÇAMENTO C — 301 desperdiçado, proporção E volume, sobre o DESPERDÍCIO
    # (a consolidação já ficou em consolidacao_por_agente e não entra aqui).
    desperdicio_301 = []
    for chave, quantidade in sorted(q301_por_agente.items(), key=lambda kv: -kv[1]):
        item = avaliar_desperdicio_301(chave, funcao_por_agente.get(chave, "unknown"),
                                       quantidade, servidas_por_agente.get(chave, 0),
                                       args.teto_301, args.piso_301, args.piso_301_denominador)
        if item:
            desperdicio_301.append(item)

    # ORÇAMENTO D — porta de descoberta, piso 1.
    falhas_portas, consolidacao_portas = avaliar_portas(grupos_portas, faixas, rede_casa)

    reprovou_404 = bool(massa_404)
    reprovou_301 = bool(desperdicio_301)
    reprovou_portas = bool(falhas_portas)
    reprovou_algo = reprovou or reprovou_404 or reprovou_301 or reprovou_portas

    registro = {
        # `breached` mantém o significado da v2 — indisponibilidade a crawler
        # verificado de busca/usuário — porque internal/checks e a série antiga
        # dependem dele. Os orçamentos novos têm campo próprio, e o veredito do
        # processo é `breached_any`.
        "breached": reprovou,
        "breached_404_mass": reprovou_404,
        "breached_301_waste": reprovou_301,
        "breached_any": reprovou_algo,
        "breached_discovery_port": reprovou_portas,
        "checked_at": agora.strftime(formato),
        # 301 que NÃO reprova, por agente e classe (www / http). Vai gravado
        # porque "wasted_301: []" sem este campo seria lido como "não houve
        # redirecionamento", e houve — só que do tipo que consolida.
        "consolidation_301_by_agent": consolidacao_por_agente,
        "discovery_port_consolidation": consolidacao_portas,
        "discovery_port_failures": falhas_portas,
        "discovery_port_paths": list(PORTAS_DE_DESCOBERTA),
        "errors_by_agent": por_agente,
        "errors_by_hour": por_hora,
        "errors_total": total,
        "errors_unverified_ua_discarded": nao_verificados,
        "requests_by_verified_agent": servidas_por_agente,
        # COMO cada agente verificado foi autenticado — "cloudflare" e/ou
        # "ip_range" (v5). Uma linha só com `requests_by_verified_agent` não diz
        # se o número veio de verifiedBotCategory ou de faixa oficial de IP.
        "verification_method_by_agent": metodo_por_agente,
        "home_network_probed": str(rede_casa) if rede_casa is not None else None,
        "samples": amostras,
        "schema_version": SCHEMA,
        "query_slicing": {"main": fatiamento, "discovery_ports": fatiamento_portas},
        "threshold_301_denominator": args.piso_301_denominador,
        "threshold_301_share": args.teto_301,
        "threshold_301_volume": args.piso_301,
        "threshold_404_hour": args.teto_404_hora,
        "threshold_404_window": args.teto_404_janela,
        "threshold_hour": args.teto_hora,
        "threshold_window": args.teto_janela,
        "unverified_population": {
            "requests_by_agent": nv_servidas,
            # v5: o mesmo total, separado entre a sonda desta casa (BR ou rede
            # própria, medida ao vivo) e o resto (UA não verificado de origem
            # estrangeira — pode ser operador sem faixa catalogada ou scanner).
            # Antes desta separação o `verdict` abaixo afirmava que TUDO aqui
            # era "a sonda deste repo", o que era falso para a segunda parte.
            "requests_by_agent_sonda_local": nv_servidas_local,
            "requests_by_agent_nao_verificado": nv_servidas_outros,
            "method_by_agent": nv_metodo,
            "samples": nv_amostras,
            "status_by_agent": nv_status,
            # Diz na própria linha por que esta população não reprova, para
            # ninguém ler o zero como "não houve erro".
            "verdict": "reportada, nunca reprova: a fatia 'sonda_local' e a "
                       "verificacao de auditoria deste repositorio saindo desta "
                       "maquina (pais BR ou rede propria); a fatia "
                       "'nao_verificado' e trafego estrangeiro sem verificacao "
                       "da Cloudflare nem faixa oficial catalogada — pode ser "
                       "operador legitimo sem faixa cadastrada aqui, ou "
                       "scanner disfarcado de crawler. Nenhuma das duas reprova, "
                       "pela mesma razao anti-auto-alarme.",
        },
        "wasted_301": desperdicio_301,
        "wasted_404": massa_404,
        "wasted_404_protocol_probe": sondas_de_protocolo,
        "window_hours": args.horas,
        "worst_hour": pior_hora,
        "worst_hour_errors": pior_contagem,
    }
    anterior = ultima_linha_da_serie()

    if not args.sem_registro:
        os.makedirs(os.path.dirname(SERIE), exist_ok=True)
        with open(SERIE, "a", encoding="utf-8") as arquivo:
            arquivo.write(json.dumps(registro, sort_keys=True, ensure_ascii=False) + "\n")

    if args.json:
        print(json.dumps(registro, sort_keys=True, ensure_ascii=False, indent=1))
    else:
        print("check-crawler-error-budget (janela de %dh, zona %s)" % (args.horas, dominio))
        print("  [A] indisponibilidade (5xx/429/403) a crawler VERIFICADO de busca/usuario: "
              "%d (teto da janela: %d)" % (total, args.teto_janela))
        print("      pior hora: %s com %d (teto por hora: %d)"
              % (pior_hora or "-", pior_contagem, args.teto_hora))
        if por_agente:
            for chave in sorted(por_agente, key=lambda k: -por_agente[k]):
                metodos = metodo_por_agente.get(chave, {})
                marca = (" [%s]" % ", ".join("%s=%d" % (m, n) for m, n in sorted(metodos.items()))
                         if metodos else "")
                print("        %-26s %d%s" % (chave, por_agente[chave], marca))

        print("  [B] 404 em massa a agente VERIFICADO (teto %d na janela / %d na hora): %s"
              % (args.teto_404_janela, args.teto_404_hora,
                 "%d agente(s)" % len(massa_404) if massa_404 else "nenhum"))
        for item in massa_404:
            print("        %-26s %d de %d (%.1f%%), pior hora %s com %d [%s]"
                  % (item["agent_key"], item["requests_404"], item["requests_total"],
                     100 * item["share_404"], item["worst_hour"] or "-",
                     item["worst_hour_404"], item["function"]))
        for chave, quantidade in sorted(sondas_de_protocolo.items(), key=lambda kv: -kv[1]):
            print("        %-26s %d 404 NAO reprovam: sonda de protocolo, endpoint que este "
                  "portal nao implementa (criar o arquivo seria stub)" % (chave, quantidade))

