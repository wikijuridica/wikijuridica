def graphql(headers, consulta, variaveis):
    corpo = json.dumps({"query": consulta, "variables": variaveis}).encode()
    pedido = urllib.request.Request(API + "/graphql", data=corpo, headers=headers)
    try:
        with urllib.request.urlopen(pedido, timeout=90) as resposta:
            dados = json.loads(resposta.read().decode("utf-8"))
    except urllib.error.HTTPError as erro:
        return None, "HTTP %s" % erro.code
    except Exception as erro:  # rede fora, DNS, timeout — tratados como indisponibilidade
        return None, str(erro)[:160]
    if dados.get("errors"):
        return None, "; ".join(e.get("message", "?") for e in dados["errors"][:2])
    zonas = (dados.get("data") or {}).get("viewer", {}).get("zones") or []
    return (zonas[0] if zonas else {}), ""


def resolver_zona(headers, dominio):
    pedido = urllib.request.Request(API + "/zones?name=" + dominio, headers=headers)
    try:
        with urllib.request.urlopen(pedido, timeout=30) as resposta:
            dados = json.loads(resposta.read().decode("utf-8"))
    except Exception as erro:
        return "", str(erro)[:160]
    resultado = dados.get("result") or []
    if not resultado:
        return "", "zona %s nao encontrada na conta" % dominio
    return resultado[0]["id"], ""


def dominio_do_site():
    with open(SITE, encoding="utf-8") as arquivo:
        dados = json.load(arquivo)
    url = dados.get("base_url") or dados.get("baseURL") or ""
    return url.replace("https://", "").replace("http://", "").strip("/")


def rede_desta_casa(dominio):
    """A rede desta máquina, medida AO VIVO em cdn-cgi/trace — NUNCA hardcoded.

    O endereço saindo desta casa muda de host e de sessão de túnel; gravar um
    prefixo fixo no código seria a mesma dívida que fez o piso do orçamento C
    ficar inalcançável (ver o comentário de PISO_301_RESPOSTAS): um número
    calibrado uma vez e nunca mais revisto. A sonda usa o UA e o cabeçalho
    próprios deste repositório — nunca User-Agent de bot real — porque isto é
    tráfego de auditoria, não visita.

    Devolve um ip_network (/64 para IPv6, /32 para IPv4) ou None se a sonda
    falhar; falha aqui NUNCA derruba o check — só restringe "sonda deste repo"
    ao critério de país, como era antes desta correção.
    """
    import ipaddress

    pedido = urllib.request.Request(
        "https://%s/cdn-cgi/trace" % dominio,
        headers={"User-Agent": "wikijuridica-superficie-probe/1.0",
                 "X-Warming-Request": "true"})
    try:
        with urllib.request.urlopen(pedido, timeout=15) as resposta:
            corpo = resposta.read().decode("utf-8", errors="replace")
    except Exception:
        return None
    ip_bruto = ""
    for linha in corpo.splitlines():
        if linha.startswith("ip="):
            ip_bruto = linha[len("ip="):].strip()
            break
    if not ip_bruto:
        return None
    try:
        endereco = ipaddress.ip_address(ip_bruto)
    except ValueError:
        return None
    prefixo = 64 if endereco.version == 6 else 32
    return ipaddress.ip_network("%s/%d" % (ip_bruto, prefixo), strict=False)


def verificacao_de(chave, dimensoes, faixas, rede_casa):
    """Como ESTA linha do GraphQL foi identificada — nunca um booleano solto.

    Devolve um dos quatro métodos, na ordem de força da prova:

      "cloudflare" — `verifiedBotCategory` não vazio: a PRÓPRIA Cloudflare
          autenticou (rDNS + faixa de IP do operador). O critério mais forte.
      "ip_range"   — categoria vazia, mas o `clientIP` da linha cai numa faixa
          oficial publicada pelo operador em data/ops/bot_ip_ranges/ (mesma
          fonte e mesma função — botagents.ler_faixas/em_faixa — que a ORIGEM
          usa quando a borda não verifica). É o caso medido do PerplexityBot:
          100% dos IPs nos 8 prefixos oficiais, categoria sempre vazia.
      "sonda_local"— nem Cloudflare nem faixa publicada, mas a linha vem do
          Brasil OU do prefixo desta própria casa (rede_casa, medido ao vivo).
          É a verificação local saindo desta máquina, não o operador que o UA
          alega ser.
      "nao_verificado" — nenhuma das três provas. Pode ser UA forjado (o
          scanner que o cabeçalho deste módulo descreve pedindo
          /@fs/root/.aws/credentials sob o nome de "Amazonbot") ou operador
          real cuja faixa não temos catalogada — as duas coisas ficam nomeadas
          juntas porque daqui não dá para distinguir, e "não sei quem é" não é
          o mesmo que "sei que é forjado".
    """
    if (dimensoes.get("verifiedBotCategory") or "").strip():
        return "cloudflare"
    ip = dimensoes.get("clientIP") or ""
    redes = faixas.get(chave) or []
    if ip and botagents.em_faixa(ip, redes):
        return "ip_range"
    pais = (dimensoes.get("clientCountryName") or "").upper()
    if pais == "BR":
        return "sonda_local"
    if ip and rede_casa is not None:
        import ipaddress
        try:
            if ipaddress.ip_address(ip) in rede_casa:
                return "sonda_local"
        except ValueError:
            pass
    return "nao_verificado"


def classificar(status):
    """Devolve o rótulo do erro, ou "" quando a resposta é saudável.

    O 530 aparece como 530 mesmo — é status da Cloudflare, não da origem, e é
    justamente o que o log local nunca registra.
    """
    try:
        codigo = int(status)
    except (TypeError, ValueError):
        return ""
    if codigo >= 500:
        return "5xx"
    if codigo == 429:
        return "429"
    if codigo == 403:
        return "403"
    return ""


def agentes_com_2xx_sob_none(grupos):
    """Agentes que receberam alguma resposta 2xx com clientSSLProtocol=none na
    janela — a CORROBORACAO que separa HTTP externo de subrequest interno.

    Cliente HTTP externo NUNCA recebe 2xx desta borda: a Cloudflare responde 301
    para HTTPS antes de qualquer origem (curl proprio confirma). Logo, agente com
    2xx sob `none` esta chegando por outro caminho (Worker/servico interno), e os
    301 dele sob `none` nao sao consolidacao http->https: sao desperdicio como
    qualquer outro. Medido em 7 dias: 1.444 respostas 200 sob `none`
    (Cloudflare-AI-Search 954, AgentReadinessScanner 292, cloudflare-agentreadiness
    57)."""
    fora = set()
    for grupo in grupos:
        dimensoes = grupo.get("dimensions") or {}
        if (dimensoes.get("clientSSLProtocol") or "").lower() != "none":
            continue
        try:
            codigo = int(dimensoes.get("edgeResponseStatus"))
        except (TypeError, ValueError):
            continue
        if 200 <= codigo < 300:
            chave = botagents.agente_de(dimensoes.get("userAgent") or "")
            if chave:
                fora.add(chave)
    return fora


def classe_de_consolidacao(host, protocolo_tls, http_corroborado=False):
    """"www", "http" ou "" — a classe do 301 pelo endereço que o BOT pediu.

    "www": o host www, que ops/nginx/standalone/nginx.conf:1892 manda em um salto
    para o apex no mesmo caminho. Reconhecivel pelo host, sem olhar o Location.

    "http": clientSSLProtocol=none, MAS SO COM CORROBORACAO (http_corroborado):
    o agente nao recebeu nenhum 2xx sob `none` na janela. Sem isso, `none` nao
    prova nada.

    ★ A PRIMEIRA VERSAO devolvia "http" para QUALQUER 301 com TLS=none, e foi
    REFUTADA pelo critico adversarial em 2026-09-01 com medicao na mesma API:
    `none` significa "sem TLS do cliente", o que inclui subrequest interno da
    Cloudflare — 1.444 respostas 200 sob `none` em 7 dias. A classe isentava
    3x301 do agentreadiness em `/.well-known/...%60` (crase residual, desperdicio
    T3.9) e, pior, os 843x301 do facebookexternalhit que o comentario chamava de
    "escolha do bot" e NAO sao: .agents/runtime/artes-perfis-20260827/legendas.md
    publica o endereco SEM esquema, e os caminhos dos 301 sao os prefixos tecla a
    tecla dessa URL — forma de URL publicada por NOS, exatamente o que o orcamento
    C existe para acusar. Com a classe cega, facebookexternalhit caia de 19,1%
    para 0,8% e o gate deixava de reprovar.

    Remover a classe inteira tambem estava errado (medido logo em seguida): o
    duckduckbot com 1x301 em http://wikijuridica.com.br/ — http->https legitimo —
    passou a reprovar [D] com piso 1. A corroboracao e o que separa os dois.
    """
    if (host or "").lower().startswith("www."):
        return "www"
    if (protocolo_tls or "").lower() == "none" and http_corroborado:
        return "http"
    return ""


def avaliar_desperdicio_301(chave, funcao, desperdicio, servidas, teto_proporcao,
                            piso_respostas, piso_denominador):
    """O veredito do orçamento C para UM agente, isolado da rede.

    Devolve o item de `wasted_301` quando reprova, ou None. `desperdicio` já
    vem SEM a consolidação (ver classe_de_consolidacao) — a proporção que
    reprova é a de redirecionamento que denuncia padrão de URL do portal.

    Isolado para que `--autoteste` prove o caso que a versão anterior não
    conseguia reprovar: 30 de 90 (33%) num agente de baixo volume, que com o
    piso de 200 respostas passava verde.
    """
    if servidas < piso_denominador or desperdicio < piso_respostas:
        return None
    proporcao = desperdicio / servidas
    if proporcao < teto_proporcao:
        return None
    return {
        "agent_key": chave,
        "function": funcao,
        "requests_301": desperdicio,
        "requests_total": servidas,
        "share_301": round(proporcao, 4),
    }


def avaliar_portas(grupos, faixas=None, rede_casa=None):
    """O veredito do orçamento D sobre os grupos da CONSULTA_PORTAS.

    Devolve (falhas, consolidacao). `falhas` é a lista, por (agente, host,
    esquema, rota, status), de toda resposta a bot VERIFICADO — pela Cloudflare
    OU por faixa de IP oficial, ver `verificacao_de` — nas portas de descoberta
    que não é conteúdo (2xx) nem revalidação (304) nem consolidação (301 vindo
    do www ou de HTTP puro). Piso 1: uma resposta basta, porque um robots.txt em
    5xx é o Google tratando o host inteiro como bloqueado e um sitemap.xml em
    404 é a descoberta fechada. `consolidacao` conta, por agente e classe, o 301
    que NÃO reprova — contado e não descartado, para que o "nenhum" da saída
    nunca seja lido como "não houve redirecionamento".

    O 304 é saudável de propósito: é a resposta condicional a If-None-Match, e
    penalizá-lo faria o gate reprovar exatamente o crawler que revalida bem.
    Nem sonda local nem UA não verificado entram, pela mesma razão dos outros
    orçamentos.

    `faixas`/`rede_casa` são opcionais (default vazio/None) para que o
    `--autoteste`, cujos fixtures não trazem `clientIP`/`clientCountryName`,
    continue se comportando exatamente como antes desta correção.
    """
    faixas = faixas or {}
    falhas = {}
    consolidacao = {}
    sem_corroboracao_http = agentes_com_2xx_sob_none(grupos)
    for grupo in grupos:
        dimensoes = grupo.get("dimensions") or {}
        chave = botagents.agente_de(dimensoes.get("userAgent") or "")
        if not chave:
            continue
        if verificacao_de(chave, dimensoes, faixas, rede_casa) not in ("cloudflare", "ip_range"):
            continue
        rota = (dimensoes.get("clientRequestPath") or "").split("?", 1)[0]
        if rota not in PORTAS_DE_DESCOBERTA:
            continue
        try:
            codigo = int(dimensoes.get("edgeResponseStatus"))
        except (TypeError, ValueError):
            codigo = 0
        if 200 <= codigo < 300 or codigo == 304:
            continue
        host = dimensoes.get("clientRequestHTTPHost") or ""
        protocolo = dimensoes.get("clientSSLProtocol") or ""
        quantidade = grupo.get("count", 0)
        classe = classe_de_consolidacao(host, protocolo, chave not in sem_corroboracao_http) if codigo == 301 else ""
        if classe:
            balde = consolidacao.setdefault(chave, {})
            balde[classe] = balde.get(classe, 0) + quantidade
            continue
        esquema = "http" if protocolo.lower() == "none" else "https"
        hora = (dimensoes.get("datetimeHour") or "")[:13]
        identidade = (chave, host, esquema, rota, codigo)
        item = falhas.get(identidade)
        if item is None:
            item = falhas[identidade] = {
                "agent_key": chave,
                "function": botagents.funcao_de(chave),
                "host": host,
                "scheme": esquema,
                "path": rota,
                "status": codigo,
                "count": 0,
                "worst_hour": "",
                "worst_hour_count": 0,
            }
        item["count"] += quantidade
        if quantidade > item["worst_hour_count"]:
            item["worst_hour"], item["worst_hour_count"] = hora, quantidade
    ordenadas = sorted(falhas.values(),
                       key=lambda i: (-i["count"], i["agent_key"], i["path"], i["status"]))
    return ordenadas, consolidacao


def coletar(headers, consulta, variaveis, desde, ate, limite):
    """Percorre [desde, ate] em fatias e devolve (grupos, erro, fatiamento).

    A API recusa janela maior que 1 dia neste conjunto, então a fatia inicial é
    o dia. E `limit` é teto SILENCIOSO: resposta que bate exatamente nele foi
    cortada, e com orderBy datetimeHour_ASC o que cai fora são as horas mais
    recentes — as que um alarme mais precisa ver. Fatia que volta cheia é
    dividida ao meio e pedida de novo, até uma hora. Medido em 2026-09-01, a
    consulta principal traz ~1.500 grupos/dia (1.518 com host e esquema, 1.497
    sem), então a divisão é reserva contra crescimento, não regime — mas
    `fatiamento["truncadas"]` > 0 é dado incompleto e vai gravado na linha.
    """
    grupos = []
    fatiamento = {"consultas": 0, "divididas": 0, "truncadas": 0}
    pilha = []
    inicio = desde
    while inicio < ate:
        fim = min(inicio + datetime.timedelta(hours=23, minutes=59), ate)
        pilha.append((inicio, fim))
        inicio = fim + datetime.timedelta(seconds=1)
    pilha.reverse()
    while pilha:
        inicio, fim = pilha.pop()
        pedido = dict(variaveis)
        pedido.update({"desde": inicio.strftime(FORMATO), "ate": fim.strftime(FORMATO),
                       "limite": limite})
        zona_dados, erro = graphql(headers, consulta, pedido)
        fatiamento["consultas"] += 1
        if erro:
            return grupos, erro, fatiamento
        lote = (zona_dados or {}).get("httpRequestsAdaptiveGroups") or []
        if len(lote) >= limite:
            if fim - inicio > datetime.timedelta(hours=1):
                meio = inicio + (fim - inicio) / 2
                fatiamento["divididas"] += 1
                pilha.append((meio + datetime.timedelta(seconds=1), fim))
                pilha.append((inicio, meio))
                continue
            fatiamento["truncadas"] += 1
        grupos.extend(lote)
    return grupos, "", fatiamento


