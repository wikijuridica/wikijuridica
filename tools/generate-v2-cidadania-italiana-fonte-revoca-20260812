#!/usr/bin/env python3
"""generate-v2-cidadania-italiana-fonte-revoca-20260812 — registra a fonte que sustenta a correção da revoca.

POR QUE. Em 2026-08-12, a auditoria das 30 páginas recuperadas de
`v2_blocked_drafts/` apanhou um defeito P1 em `cid-italiana-por-casamento`: o
texto atribuía a revogação da cidadania por casamento à comprovação, em processo
penal, de vínculo simulado. A correção (aplicada por
generate-v2-blocked-drafts-promotion-20260812) passou a afirmar apenas o que a
fonte oficial sustenta — que a revoca é o instituto do art. 10-bis da Legge
91/1992, introduzido pelo decreto convertido na Legge 132/2018, alcançando as
hipóteses ali expressamente listadas.

Essa afirmação nasceu de uma consulta ao Ministero dell'Interno que NÃO constava
das fontes da página. Proveniência que não aparece na página é proveniência que
não existe para quem lê. Esta ferramenta acrescenta a fonte, com o anchor_claim
que descreve exatamente o trecho consultado.

FONTE (consultada em 2026-08-12, HTTP 200):
  https://www.interno.gov.it/it/temi/cittadinanza-e-altri-diritti-civili/cittadinanza
  sha256 do documento baixado:
  4d389f58b12d4a80d6d24459f9ad911c1db05869200fbd7a9bcd927d8a54d1a5
  trecho: "Il D.L. 4 ottobre 2018, n. 113, convertito con legge 1° dicembre 2018
  n. 132 ha introdotto all'art. 10 bis della legge 5/02/1992, n. 91 l'istituto
  della revoca della cittadinanza nei casi espressamente previsti dall'art. 10
  bis della citata legge n. 91/1992 e successive modificazioni e integrazioni."

CONTRATO DE ESCRITA: lease de época, lock exclusivo, CAS pelo sha256 da LINHA
viva, demais linhas preservadas byte a byte, forma de serialização preservada,
escrita atômica com fsync, idempotente. NÃO commita e NÃO publica.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.cidadania-italiana-fonte-revoca-20260812.lock"
SHARD = ROOT / "data/editorial/v2_pages/cidadania-04.jsonl"
INTENT = "cid-italiana-por-casamento"

FONTE = {
    "name": "Ministero dell'Interno — Cittadinanza",
    "url": "https://www.interno.gov.it/it/temi/cittadinanza-e-altri-diritti-civili/cittadinanza",
    "anchor_claim": ("página oficial do Ministério do Interior italiano, que registra "
                     "ter o decreto-legge 113/2018, convertido na Legge 132/2018, "
                     "introduzido no art. 10-bis da Legge 91/1992 o instituto da "
                     "revogação da cidadania nas hipóteses ali expressamente previstas"),
}
ANCORA = "art. 10-bis da Legge 91/1992"


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def forma(linha: str):
    original = json.loads(linha)
    for separadores in ((", ", ": "), (",", ":")):
        if json.dumps(original, ensure_ascii=False,
                      separators=separadores) == linha:
            return separadores
    return (", ", ": ")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                linhas = SHARD.read_text(encoding="utf-8").splitlines()
                alvo = None
                for numero, linha in enumerate(linhas):
                    if not linha.strip():
                        continue
                    if json.loads(linha).get("intent_id") == INTENT:
                        alvo = numero
                        break
                if alvo is None:
                    print(f"{INTENT} não está em {SHARD.name}", file=sys.stderr)
                    return 1

                linha = linhas[alvo]
                registro = json.loads(linha)
                fontes = registro.get("official_sources") or []
                if any(f.get("url") == FONTE["url"] for f in fontes):
                    print("fonte já registrada; nada a fazer (idempotente).")
                    return 0

                # A fonte só faz sentido se a afirmação que ela sustenta estiver
                # no corpo. CAS semântico antes de tocar no registro.
                corpo = " ".join(s.get("text", "") for s in registro["sections"])
                if ANCORA not in corpo:
                    print(f"CAS falhou: o corpo de {INTENT} não contém "
                          f"{ANCORA!r}; a correção P1 não está aplicada.",
                          file=sys.stderr)
                    return 1

                antes = hashlib.sha256(linha.encode("utf-8")).hexdigest()
                print(f"CAS: linha {alvo + 1} de {SHARD.name}, sha256 {antes[:16]}")
                fontes.append(FONTE)
                registro["official_sources"] = fontes
                nova = json.dumps(registro, ensure_ascii=False,
                                  separators=forma(linha))
                print(f"  fontes {len(fontes) - 1} -> {len(fontes)}")
                if args.dry_run:
                    print("--dry-run: nada escrito.")
                    return 0
                linhas[alvo] = nova
                atomic_write(SHARD, ("\n".join(linhas) + "\n").encode("utf-8"))
                print(f"  gravado: sha256 da linha "
                      f"{hashlib.sha256(nova.encode('utf-8')).hexdigest()[:16]}")
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75
    print("NÃO commitado e NÃO publicado.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
