#!/usr/bin/env bash
# run-medicao-runner-noturna — mede o runner local (llama-server) com o cérebro
# PARADO e o Ollama sem modelo residente, e devolve o cérebro ao ar no fim.
#
# POR QUE À NOITE E COM O CÉREBRO PARADO (medido em 2026-09-09): a sonda de
# prefixo com `qwen3.5:4b` rodou com a fila de embeddings viva e cada chamada
# pagou 21–115 s de `load_duration`, porque OLLAMA_MAX_LOADED_MODELS=1 despeja o
# modelo a cada troca — o número medido era o do thrash, não o do runner.
# `tools/generate-medicao-runner-local` RECUSA rodar com modelo residente (dois
# runners residentes derrubaram a máquina pelo earlyoom em 2026-09-08), então
# este wrapper: (1) para `wikijuridica-cerebro`, (2) descarrega o que o Ollama
# tiver residente (keep_alive 0), (3) roda o harness sobre 20 ementas reais
# (stride determinístico) para as três variantes, (4) religa o cérebro SEMPRE
# — inclusive em falha (trap), porque a fila 24/7 é ordem do dono.
#
# Saída: o harness acrescenta uma linha por variante em
# data/ops/ia_local_runner_variantes.jsonl; este wrapper acrescenta uma linha
# em data/ops/medicao_runner_noturna.jsonl com exit, duração e as variantes.
# O que decide a adoção (D6 do plano de 2026-09-09) é a leitura pareada dessas
# linhas: `reuso_de_prefixo` (prompt_n da 1ª passada → repetida) e tok/s por
# variante, com saída idêntica a temperatura 0.
#
# Uso:
#   tools/run-medicao-runner-noturna            # 20 amostras, 3 variantes
#   tools/run-medicao-runner-noturna --amostras 5 --variante producao-hoje
# Agendamento (feito em 2026-09-09 para 2026-09-10 03:05 local, unit transiente
# do usuário):
#   systemd-run --user --on-calendar="2026-09-10 03:05:00" \
#     --unit=wiki-medicao-runner-20260910 /opt/wiki/tools/run-medicao-runner-noturna
set -u
RAIZ="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$RAIZ" || exit 2
LEDGER="$RAIZ/data/ops/medicao_runner_noturna.jsonl"
INICIO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
T0="$(date +%s)"
ARGS=("$@")
[ $# -eq 0 ] && ARGS=(--amostras 20 --n-predict 200)

religa() {
	sudo -n systemctl start wikijuridica-cerebro.service
	echo "cerebro religado: $(systemctl show wikijuridica-cerebro -p SubState --value)"
}

grava() {
	local exit_code="$1"
	local etapa="$2"
	printf '{"schema_version":"medicao_runner_noturna_v1","inicio":"%s","fim":"%s","duracao_s":%d,"exit":%d,"etapa":"%s","args":"%s","counts_as_audience":false}\n' \
		"$INICIO" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(($(date +%s) - T0))" "$exit_code" "$etapa" "${ARGS[*]}" >>"$LEDGER"
}

if ! sudo -n systemctl stop wikijuridica-cerebro.service; then
	echo "nao consegui parar o cerebro (sudo -n systemctl stop)" >&2
	grava 2 "parar-cerebro"
	exit 2
fi
trap 'religa' EXIT

# IDENTIDADE DA SONDA (CLAUDE.md secao 11). Ate 2026-09-10 estas chamadas saiam
# como `curl/8.x` para o Ollama local. O destino e servico NOSSO na maquina, nao
# o portal — vai o User-Agent da sonda interna e nao vai o `X-Warming-Request`,
# que so faz sentido onde ha metrica de audiencia a proteger.
UA_SONDA="wikijuridica-superficie-probe/1.0"

# Descarrega o que estiver residente no Ollama: o harness recusa com residente.
for modelo in $(curl -s -m 10 -A "$UA_SONDA" http://127.0.0.1:11434/api/ps | python3 -c 'import json,sys; print(" ".join(m["name"] for m in json.load(sys.stdin).get("models", [])))' 2>/dev/null); do
	curl -s -m 60 -A "$UA_SONDA" http://127.0.0.1:11434/api/generate -d "{\"model\":\"$modelo\",\"keep_alive\":0}" >/dev/null
	echo "descarregado: $modelo"
done
# O descarregamento é assíncrono; espera até 60 s por /api/ps vazio.
for _ in $(seq 1 12); do
	if [ "$(curl -s -m 10 -A "$UA_SONDA" http://127.0.0.1:11434/api/ps | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("models", [])))' 2>/dev/null)" = "0" ]; then
		break
	fi
	timeout 5 tail -f /dev/null
done

"$RAIZ/tools/generate-medicao-runner-local" "${ARGS[@]}"
EXIT_HARNESS=$?
grava "$EXIT_HARNESS" "harness"
exit "$EXIT_HARNESS"
