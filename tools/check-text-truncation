def autoteste():
    """Prova que cada regra dispara no defeito e cala no caso legitimo."""
    falhas = 0
    for rotulo, blocos, esperado in CASOS_AUTOTESTE:
        obtido = {regra for regra, _r, _t in analisa_blocos(blocos, "/autoteste/")}
        if obtido != esperado:
            falhas += 1
            print("FALHOU: %s\n  esperado=%s\n  obtido  =%s"
                  % (rotulo, sorted(esperado), sorted(obtido)))
        else:
            print("ok: %s" % rotulo)
    falhas += autoteste_rotulo()
    if falhas:
        print("\nAUTOTESTE REPROVADO: %d caso(s)" % falhas)
        return 1
    print("\nAUTOTESTE OK: %d casos"
          % (len(CASOS_AUTOTESTE) + len(CASOS_ROTULO)))
    return 0


def main(argv):
    if "--autoteste" in argv:
        return autoteste()
    listar_tudo = "--listar-tudo" in argv
    amostra = 20
    if "--amostra" in argv:
        amostra = int(argv[argv.index("--amostra") + 1])

    contagem = defaultdict(int)
    rotas_por_regra = defaultdict(set)
    exemplos = defaultdict(list)
    paginas = 0

    for dirpath, _dirnames, filenames in os.walk(PUBLICO):
        if "index.html" not in filenames:
            continue
        paginas += 1
        rota = "/" + os.path.relpath(dirpath, PUBLICO).replace(os.sep, "/") + "/"
        if rota == "/./":
            rota = "/"
        for regra, r, trecho in analisa_pagina(os.path.join(dirpath, "index.html"), rota):
            contagem[regra] += 1
            rotas_por_regra[regra].add(r)
            if listar_tudo or len(exemplos[regra]) < amostra:
                exemplos[regra].append((r, trecho))

    total = sum(contagem.values())
    print("check-text-truncation — %d paginas analisadas em %s" % (paginas, PUBLICO))
    if not total:
        print("OK: nenhum fragmento truncado, conectivo pendurado, marcador de corte")
        print("    ou vocabulario interno no texto visivel.")
        return 0

    for regra in sorted(contagem):
        print("\n%s: %d ocorrencia(s) em %d pagina(s)"
              % (regra, contagem[regra], len(rotas_por_regra[regra])))
        for r, trecho in exemplos[regra]:
            print("  %s\n    %s" % (r, trecho))
        restante = contagem[regra] - len(exemplos[regra])
        if restante > 0:
            print("  (+%d ocorrencia(s) — use --listar-tudo)" % restante)

    rotas = sorted({r for conj in rotas_por_regra.values() for r in conj})
    print("\nREPROVADO: %d ocorrencia(s) em %d rota(s):" % (total, len(rotas)))
    for r in rotas:
        print("  %s" % r)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
