#!/usr/bin/env bash
# tools/check-v2-writing-semantic-contract — READ-ONLY (wrapper de ./cmd/...).
#
# Uso:
#   tools/check-v2-writing-semantic-contract [flags do cmd]
#   tools/check-v2-writing-semantic-contract --quiet        # ou WIKI_QUIET=1
#
# --quiet | -q reduz SO verbosidade: silencia no stderr as DUAS linhas de
# bookkeeping do runner (`run-go-cmd-cached: repo_awareness ...` e
# `run-go-cmd-cached: artifact_claim ...`), que somam ~1,25 KB de 1,49 KB por
# chamada e sao declaracao do produtor, nao veredito. O stdout (onde sai o
# veredito) permanece byte-a-byte identico, o exit code e o mesmo e QUALQUER
# outra mensagem do runner — inclusive erro real, que usa o mesmo prefixo —
# continua passando. Sem a flag, o comportamento e identico ao anterior.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
QUIET=0
if [ "${WIKI_QUIET:-0}" = "1" ]; then
	QUIET=1
fi
ARGS=()
prev=""
for arg in "$@"; do
	case "$arg" in
	--quiet | -q)
		# nao capturar quando o token e o VALOR de uma flag que exige valor
		if [ "$prev" = "--root" ] || [ "$prev" = "-root" ]; then
			ARGS+=("$arg")
		else
			QUIET=1
		fi
		;;
	*) ARGS+=("$arg") ;;
	esac
	prev="$arg"
done

if [ "$QUIET" != 1 ]; then
	exec "$ROOT/tools/run-go-cmd-cached" ./cmd/check-v2-writing-semantic-contract "$@"
fi

# stdout do cmd segue direto pelo fd 3 (intacto); so o stderr passa pelo filtro.
# O exit code real volta pelo fd 5, capturado na substituicao de comando.
BOOKKEEPING='^run-go-cmd-cached: (repo_awareness|artifact_claim) '
set +e +o pipefail
exec 3>&1
status="$({ {
	"$ROOT/tools/run-go-cmd-cached" ./cmd/check-v2-writing-semantic-contract ${ARGS[@]+"${ARGS[@]}"}
	echo "$?" >&5
} 2>&1 1>&3 | grep -Ev "$BOOKKEEPING" >&2; } 5>&1)"
exec 3>&-
case "$status" in
'' | *[!0-9]*) status=2 ;; # exit code ilegivel nunca vira verde inventado
esac
exit "$status"
