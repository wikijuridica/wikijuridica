#!/usr/bin/env python3
"""check-bot-registry-decidido — agente novo que aparece duas vezes tem de ter
decisão escrita. READ-ONLY.

O DEFEITO QUE ELE EXISTE PARA PEGAR, medido em 2026-09-16.
`tools/generate-bot-registry-candidates` roda todo dia (tools/run-qualidade-diaria
:1295) e acha bot novo com competência: 375 linhas, 48 tokens, 26 dias de série.
E não tinha UM consumidor — `grep -rln bot_registry_candidates` devolvia o
próprio gerador e nada mais. A docstring dele mandava a decisão para um humano,
que a Regra 8 veda, e o resultado foi acúmulo silencioso: na borda, na janela de
24h encerrada em 2026-09-16T16:00:00Z, 12.741 de 30.115 requisições líquidas
(42,3%) eram agente que SE DECLARA e o registro não conhecia — o maior deles,
AhrefsSiteAudit, com 5.859. É a mesma família do produtor órfão que `internal/checks/produtor_orfao.go`
fecha: produtor que roda, escreve, e cujo produto ninguém lê.

POR QUE ELE REPROVA POR DECISÃO, E NÃO POR VOLUME DE DESCONHECIDO. Tráfego de
terceiro não é dívida desta casa: um gate que ficasse vermelho enquanto
existisse bot não registrado nasceria vermelho e nunca fecharia, e gate que não
fecha se aprende a ignorar. O que se cobra aqui é o ato que é nosso — decidir —,
e decidir é barato: `nao_identificado` com o User-Agent literal é decisão
legítima e final.

POR QUE DUAS DATAS. Scanner de passagem não merece uma linha de registro
permanente; agente que volta, sim. O limiar é de PERSISTÊNCIA, não de volume,
porque é a volta que transforma o agente em audiência.

AS DUAS DIREÇÕES. Um registro que só conferisse "existe linha?" envelheceria em
silêncio: bastaria alguém registrar o agente em `tools/botagents.py` e esquecer
a linha daqui para o ledger passar a afirmar "não identificado" sobre um agente
que já tem chave. Por isso `registrado` tem de resolver para o `agent_key`
declarado, e `nao_identificado`/`cliente_generico` têm de continuar resolvendo
para None. A régua é `botagents.agente_de`, importada — nunca reimplementada:
uma cópia da régua mede a cópia, não o produto.
"""
import argparse
import collections
import json
import os
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
sys.path.insert(0, os.path.join(RAIZ, "tools"))
import botagents  # noqa: E402

LEDGER_PADRAO = os.path.join(RAIZ, "data", "ops", "bot_registry_candidates.jsonl")
REGISTRO_PADRAO = os.path.join(RAIZ, "ops", "bots-decididos.jsonl")

# Datas distintas a partir das quais o token exige decisão. Ver docstring.
DATAS_PARA_EXIGIR_DECISAO = 2

# PISO DE DETECÇÃO. Um gate que varre um ledger vazio passa verde e não mede
# nada — foi assim que mais de um detector deste repositório ficou verde por
# meses. O piso é bem abaixo do tamanho real (375 linhas em 2026-09-16) para não
# virar manutenção, e alto o bastante para acusar ledger truncado ou caminho
# errado. A bancada passa o piso da própria fixture.
PISO_DE_DETECCAO = 50

DECISOES = {
    "registrado": "o token tem agent_key em tools/botagents.py",
    "nao_identificado": "se declara, operador nao confirmado; exige o UA literal",
    "cliente_generico": "diz COMO a requisicao foi feita, nunca QUEM a fez",
    "desta_casa": "ferramenta deste repositorio",
    "token_invalido": "artefato de defeito de extracao; exige substituido_por",
}

# Decisões que afirmam "isto NÃO tem chave". Se `agente_de` passar a devolver
# uma chave para o UA delas, a decisão envelheceu.
DECISOES_SEM_CHAVE = ("nao_identificado", "cliente_generico", "desta_casa")


def le_jsonl(caminho):
    registros = []
    with open(caminho, encoding="utf-8") as f:
        for numero, linha in enumerate(f, 1):
            linha = linha.strip()
            if not linha or linha.startswith("#"):
                continue
            try:
                registros.append((numero, json.loads(linha)))
            except json.JSONDecodeError as erro:
                raise SystemExit(
                    "check-bot-registry-decidido: %s:%d nao e JSON: %s"
                    % (caminho, numero, erro))
    return registros


def audita(ledger, registro, piso=PISO_DE_DETECCAO,
           datas_para_exigir=DATAS_PARA_EXIGIR_DECISAO):
    """(problemas, resumo). Problema é (codigo, token, detalhe)."""
    problemas = []
    candidatos = le_jsonl(ledger)
    if len(candidatos) < piso:
        problemas.append((
            "ledger_de_candidatos_abaixo_do_piso", os.path.basename(ledger),
            "%d linha(s) contra piso de %d — varredura cega passa verde sem medir nada"
            % (len(candidatos), piso)))
        return problemas, {"candidatos": len(candidatos), "tokens": 0, "decisoes": 0}

    datas = collections.defaultdict(set)
    ua_do_token = {}
    for _, c in candidatos:
        token = c.get("token")
        if not token:
            continue
        datas[token].add(c.get("date"))
        ua_do_token.setdefault(token, c.get("user_agent_sample") or "")

    decisoes = {}
    for numero, d in le_jsonl(registro):
        token = d.get("token")
        if not token:
            problemas.append(("decisao_sem_token", "linha %d" % numero,
                              "toda linha do registro nomeia o token que ela decide"))
            continue
        if token in decisoes:
            problemas.append(("decisao_duplicada", token,
                              "o token aparece duas vezes no registro; a segunda "
                              "linha cala a primeira sem ninguem ver"))
            continue
        decisoes[token] = d

    # (1) Token persistente sem decisão — o defeito principal.
    for token in sorted(datas):
        if len(datas[token]) < datas_para_exigir:
            continue
        if token in decisoes:
            continue
        problemas.append((
            "token_sem_decisao", token,
            "visto em %d datas distintas (%s a %s) e sem linha em %s — decida: %s"
            % (len(datas[token]), min(datas[token]), max(datas[token]),
               os.path.relpath(registro, RAIZ), " | ".join(sorted(DECISOES)))))

    # (2) Decisão sobre token que o ledger nunca viu — registro virando ficção.
    for token in sorted(set(decisoes) - set(datas)):
        problemas.append((
            "decisao_sem_candidato", token,
            "o registro decide um token que nao existe em %s; registro que "
            "cresce sozinho deixa de descrever o trafego"
            % os.path.relpath(ledger, RAIZ)))

    # (3) Coerência de cada decisão, nas duas direções.
    for token in sorted(decisoes):
        d = decisoes[token]
        decisao = d.get("decisao")
        ua = d.get("user_agent") or ""
        if decisao not in DECISOES:
            problemas.append(("decisao_desconhecida", token,
                              "%r nao e decisao valida (validas: %s)"
                              % (decisao, ", ".join(sorted(DECISOES)))))
            continue
        if not ua.strip() and decisao != "token_invalido":
            problemas.append(("decisao_sem_user_agent_literal", token,
                              "decisao sem o UA literal nao se confere nem se "
                              "reproduz — e o balde generico que esconde o tamanho"))
            continue
        chave = botagents.agente_de(ua)
        if decisao == "registrado":
            declarada = d.get("agent_key")
            if chave is None:
                problemas.append((
                    "registrado_sem_chave_na_telemetria", token,
                    "decisao diz 'registrado' e botagents.agente_de devolve None "
                    "para o UA literal — a entrada saiu de tools/botagents.py ou "
                    "nunca entrou"))
            elif declarada != chave:
                problemas.append((
                    "agent_key_divergente", token,
                    "o registro declara %r e botagents.agente_de devolve %r"
                    % (declarada, chave)))
        elif decisao in DECISOES_SEM_CHAVE:
            if chave is not None:
                problemas.append((
                    "decisao_envelhecida", token,
                    "decisao diz %r, mas botagents.agente_de ja devolve %r para o "
                    "UA literal — alguem registrou o agente e esqueceu esta linha"
                    % (decisao, chave)))
        elif decisao == "token_invalido":
            if not (d.get("substituido_por") or "").strip():
                problemas.append((
                    "token_invalido_sem_substituto", token,
                    "token invalido sem `substituido_por` apaga a pista de qual "
                    "agente ele escondia"))

    resumo = {
        "candidatos": len(candidatos),
        "tokens": len(datas),
        "tokens_persistentes": sum(1 for t in datas if len(datas[t]) >= datas_para_exigir),
        "decisoes": len(decisoes),
        "por_decisao": dict(collections.Counter(
            d.get("decisao") for d in decisoes.values())),
    }
    return problemas, resumo


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--ledger", default=LEDGER_PADRAO)
    p.add_argument("--registro", default=REGISTRO_PADRAO)
    p.add_argument("--piso", type=int, default=PISO_DE_DETECCAO)
    p.add_argument("--json", action="store_true")
    args = p.parse_args()

    for caminho in (args.ledger, args.registro):
        if not os.path.isfile(caminho):
            print("check-bot-registry-decidido: arquivo ausente: %s" % caminho,
                  file=sys.stderr)
            return 2

    problemas, resumo = audita(args.ledger, args.registro, args.piso)

    if args.json:
        print(json.dumps({"resumo": resumo,
                          "problemas": [{"codigo": c, "token": t, "detalhe": d}
                                        for c, t, d in problemas]},
                         ensure_ascii=False, indent=2))
        return 1 if problemas else 0

    print("candidatos=%d tokens=%d persistentes(>=%d datas)=%d decisoes=%d %s"
          % (resumo["candidatos"], resumo["tokens"], DATAS_PARA_EXIGIR_DECISAO,
             resumo.get("tokens_persistentes", 0), resumo["decisoes"],
             resumo.get("por_decisao", {})))
    if not problemas:
        print("check-bot-registry-decidido: OK — todo agente persistente tem decisao escrita")
        return 0
    for codigo, token, detalhe in problemas:
        print("%s: %s — %s" % (codigo, token, detalhe))
    print("check-bot-registry-decidido: %d problema(s)" % len(problemas))
    return 1


if __name__ == "__main__":
    sys.exit(main())
