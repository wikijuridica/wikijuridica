#!/bin/bash
# Mede a cobertura de cache da borda e ANEXA o resultado ao ledger versionado
# data/ops/edge_cache_coverage.jsonl.
#
# POR QUE ESTE WRAPPER EXISTE (BUG-236, 2026-08-30)
#
# A medicao morava em tools/check-edge-cache-coverage, que gravava no ledger a
# cada execucao. AGENTS.md:371 e explicito: "Wrapper check-* deve ser read-only
# para artefatos rastreados" -- e este ledger e rastreado.
#
# E nao era formalidade. A sonda AQUECE o que mede (o proprio evento registra
# `sonda_aquece_o_que_mede: true`), entao duas execucoes do check na mesma hora
# deixavam duas linhas na serie, e a segunda media o rastro que a primeira
# acabou de aquecer. O check-edge-cache-coverage-honesty apanha exatamente isso
# em oito pares consecutivos do ledger, e o mesmo defeito ja produziu um 100%
# falso em 2026-08-19.
#
# Com os papeis separados, rodar o check quantas vezes for preciso -- para
# diagnosticar, para conferir depois de uma purga -- nao contamina mais a serie.
# Quem quiser um ponto novo na serie chama este gerador, deliberadamente.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$ROOT/tools/check-edge-cache-coverage" --gravar "$@"
