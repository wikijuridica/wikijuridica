#!/usr/bin/env python3
"""generate-revisao-restaurada-por-texto — devolve a data de revisao das rotas
cujo TEXTO nao mudou, depois de uma re-datacao em massa por mudanca estrutural.

O DEFEITO QUE ESTA FERRAMENTA CONSERTA, e ele ja aconteceu duas vezes.

`tools/generate-page-content-revision` carimba `revised_on` com a data de hoje em
toda rota cujo HTML SERVIDO mudou. A neutralizacao dele cobre `<script>` sem
atributo e datas — e mais nada. Entao mudanca ESTRUTURAL que nao e conteudo (um
`target="_blank"`, um `aria-label`, uma regra de CSS no rodape) re-data o acervo
inteiro, e o sitemap anuncia ao Googlebot que 10 mil paginas mudaram quando
NENHUMA mudou. E o bug do `reviewed_at` por outra porta, que o contrato registra
como caro.

O remedio preventivo e `--ressemear` (hoje alcancavel por
`tools/deploy-publico --ressemear`). Esta ferramenta e o remedio CORRETIVO, para
quando o carimbo ja foi dado.

A PROVA QUE CONDICIONA CADA RESTAURACAO e o `content_sha256`: ele hasheia o TEXTO
autoral, nao o HTML. Se o texto de uma rota e byte a byte o mesmo do commit-base,
entao a data de hoje nao descreve revisao nenhuma e volta a ser a de antes. Se o
texto mudou, a data de hoje e VERDADEIRA e fica — restaurar ali apagaria
justamente o que o ledger existe para registrar.

O `served_sha256` NAO e revertido: ele descreve o HTML de hoje, que de fato
mudou, e reverte-lo faria a proxima passada re-datar tudo de novo. O que se
corrige e a DATA, que e o que o sitemap anuncia.

Uso:
    ./tools/generate-revisao-restaurada-por-texto --base HEAD           # ensaio
    ./tools/generate-revisao-restaurada-por-texto --base HEAD --aplicar
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
LEDGER = RAIZ / "data" / "ops" / "page_content_revision.jsonl"
RELATIVO = "data/ops/page_content_revision.jsonl"


def carrega(linhas) -> dict[str, dict]:
    """path -> registro. Linha malformada e ERRO, nao linha ignorada.

    Engolir linha quebrada aqui faria a ferramenta 'restaurar' um subconjunto
    silencioso e declarar sucesso — o pior resultado possivel numa correcao de
    dado.
    """
    fora = {}
    for numero, linha in enumerate(linhas, start=1):
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError as erro:
            raise SystemExit(f"linha {numero} do ledger nao e JSON: {erro}")
        caminho = registro.get("path")
        if not caminho:
            raise SystemExit(f"linha {numero} do ledger sem campo 'path'")
        fora[caminho] = registro
    return fora


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", default="HEAD",
                    help="commit cujo ledger tem as datas verdadeiras (padrao: HEAD)")
    ap.add_argument("--aplicar", action="store_true",
                    help="sem isto, so relata o que faria")
    args = ap.parse_args()

    atual = carrega(LEDGER.read_text(encoding="utf-8").splitlines())
    try:
        bruto = subprocess.run(["git", "show", f"{args.base}:{RELATIVO}"],
                               cwd=RAIZ, capture_output=True, text=True, check=True).stdout
    except subprocess.CalledProcessError as erro:
        print(f"nao consegui ler o ledger em {args.base}: {erro.stderr.strip()}", file=sys.stderr)
        return 1
    base = carrega(bruto.splitlines())

    restauradas, mantidas_por_texto, sem_base, ja_iguais = [], [], [], 0
    for caminho, registro in atual.items():
        anterior = base.get(caminho)
        if anterior is None:
            sem_base.append(caminho)
            continue
        data_agora = str(registro.get("revised_on") or "")
        data_antes = str(anterior.get("revised_on") or "")
        if not data_antes or data_agora == data_antes:
            ja_iguais += 1
            continue
        # A PROVA. Texto igual => a data de hoje nao descreve revisao nenhuma.
        if registro.get("content_sha256") != anterior.get("content_sha256"):
            mantidas_por_texto.append(caminho)
            continue
        restauradas.append((caminho, data_agora, data_antes))
        registro["revised_on"] = data_antes

    print(f"ledger              : {len(atual)} rota(s)")
    print(f"data ja identica    : {ja_iguais}")
    print(f"texto MUDOU, data fica: {len(mantidas_por_texto)}")
    print(f"sem linha na base   : {len(sem_base)}")
    print(f"A RESTAURAR         : {len(restauradas)}")
    for caminho, de, para in restauradas[:5]:
        print(f"  {caminho}: {de} -> {para}")
    if len(restauradas) > 5:
        print(f"  …e mais {len(restauradas) - 5}")

    if not args.aplicar:
        print("\nensaio: nada foi escrito (use --aplicar)")
        return 0
    if not restauradas:
        print("\nnada a restaurar")
        return 0

    # Escrita atomica: o ledger e lido pelo publish e pelo gerador de sitemap, e
    # um arquivo pela metade ali produz shard incoerente.
    temporario = LEDGER.with_suffix(".jsonl.novo")
    with temporario.open("w", encoding="utf-8") as saida:
        for caminho in atual:
            saida.write(json.dumps(atual[caminho], ensure_ascii=False) + "\n")
    temporario.replace(LEDGER)
    print(f"\naplicado: {len(restauradas)} data(s) restaurada(s) em {LEDGER}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
