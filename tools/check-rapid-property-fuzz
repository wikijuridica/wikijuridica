#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export RAPID_CHECKS="${RAPID_CHECKS:-25}"
export RAPID_NOFAILFILE="${RAPID_NOFAILFILE:-true}"
cd "$ROOT"
if [[ ! -s "data/ops/rapid_property_fuzz_evidence.jsonl" ]]; then
	echo "rapid-property-fuzz evidence missing (data/ops/rapid_property_fuzz_evidence.jsonl): refresh it via ./tools/generate-rapid-property-fuzz before this read-only check" >&2
	exit 1
fi
exec "$ROOT/tools/run-check" rapid-property-fuzz --timings "$@"
