#!/usr/bin/env python3
"""measure-planalto-url-variants — a migração de URL do Planalto que ficou pela metade.

O ACHADO, em 2026-08-29. `internal/lexml/knowncodes.go` escolheu, para cada
código, a variante CANÔNICA da URL do Planalto, e a escolha foi medida baixando
os documentos: a variante sem sufixo tem muito mais âncora normativa que a
`compilado`/`compilada` (CDC 119 contra 0; Código Civil 2.048 contra 3; LGPD 67
contra 0; Lei 8.213 156 contra 0). Sem âncora, o link `#artN` cai no topo do
documento e o leitor — humano ou agente — perde o dispositivo citado.

A escolha foi feita e a migração NÃO terminou. Medido no acervo vivo, o mesmo
código aparece nas duas grafias:

    l10406.htm  2.193   ·   l10406compilada.htm    928
    l8078.htm     875   ·   l8078compilado.htm   1.056

E as tabelas de regra de `internal/v2ingest/current_legal_facts_*.go` exigem URL
EXATA (`hasExactOfficialSourceURL`). Onde a regra pede uma variante e a página
traz a outra, o gate acusa `current_legal_fact_source_missing` — 58 ocorrências
na suíte, e nenhuma delas é fonte ausente de verdade: a fonte está lá, com a
outra grafia.

Este medidor não corrige nada. Ele diz, com número, quantas páginas e quantas
regras estão de cada lado, para que a correção seja uma passada dirigida e não
uma varredura às cegas — e para que o gate que a validar tenha baseline.

Read-only.
"""
from __future__ import annotations

import argparse
import collections
import glob
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PAGES = os.path.join(RAIZ, "data/editorial/v2_pages")
KNOWNCODES = os.path.join(RAIZ, "internal/lexml/knowncodes.go")
CORPUS = os.path.join(RAIZ, "data/legal-corpus")
REGRAS = os.path.join(RAIZ, "internal/v2ingest")

DOC = re.compile(r"planalto\.gov\.br/(ccivil_03/[^\"#?\s]*)")
SUFIXO = re.compile(r"^(.*?)(compilad[oa]|cons)?\.htm$")


def familia(caminho: str) -> tuple[str, str]:
    """('leis/l8078', 'compilado') a partir de 'ccivil_03/leis/l8078compilado.htm'."""
    sem_prefixo = caminho[len("ccivil_03/"):] if caminho.startswith("ccivil_03/") else caminho
    casou = SUFIXO.match(sem_prefixo)
    if not casou:
        return sem_prefixo, ""
    return casou.group(1), casou.group(2) or ""


def canonicas() -> dict[str, str]:
    """família -> variante que knowncodes.go elegeu. É a fonte única da escolha."""
    with open(KNOWNCODES, encoding="utf-8") as fh:
        texto = fh.read()
    out: dict[str, str] = {}
    for url in re.findall(r'PlanaltoURL:\s*"([^"]+)"', texto):
        casou = DOC.search(url)
        if not casou:
            continue
        base, variante = familia(casou.group(1))
        out[base] = variante
    return out


def no_acervo() -> dict[tuple[str, str], int]:
    contagem: collections.Counter = collections.Counter()
    for arquivo in sorted(glob.glob(os.path.join(PAGES, "*.jsonl"))):
        with open(arquivo, encoding="utf-8") as fh:
            for linha in fh:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except json.JSONDecodeError:
                    continue
                for fonte in registro.get("official_sources") or []:
                    casou = DOC.search(fonte.get("url") or "")
                    if casou:
                        contagem[familia(casou.group(1))] += 1
    return contagem


def nas_regras() -> dict[tuple[str, str], int]:
    contagem: collections.Counter = collections.Counter()
    for arquivo in sorted(glob.glob(os.path.join(REGRAS, "current_legal_facts_*.go"))):
        with open(arquivo, encoding="utf-8") as fh:
            for url in re.findall(r'"(https://www\.planalto\.gov\.br/[^"]+)"', fh.read()):
                casou = DOC.search(url)
                if casou:
                    contagem[familia(casou.group(1))] += 1
    return contagem


def ausentes_da_tabela() -> list[dict]:
    """Atos que as REGRAS exigem, a tabela canônica não conhece, e o corpus já mediu.

    POR QUE ESTA LISTA IMPORTA. A equivalência entre as duas grafias do Planalto
    (internal/v2ingest.mesmaFonteExigida) só funciona para ato que
    lexml.URNForPlanaltoURL resolve — isto é, que está na tabela de
    knowncodes.go. Fora dela, as duas grafias continuam sendo strings diferentes
    e a reprovação "fonte ausente" persiste mesmo sendo a mesma fonte.

    E a medição que a tabela exige para eleger a variante JÁ EXISTE, gravada em
    data/legal-corpus/*.json: cada registro traz citation_url,
    citation_url_normative_anchors, document_sha256 e fetched_at. Medido em
    2026-08-29: o CTN tem 864 âncoras na variante sem sufixo e ZERO na
    `compilado`; o CPP 2.790 contra 1.932; o Código Penal 2.105 contra 6.

    Quem for fechar o resto tem aqui o que falta e a evidência para faze-lo sem
    baixar nada.
    """
    conhecidos = set()
    with open(KNOWNCODES, encoding="utf-8") as fh:
        for url in re.findall(r'PlanaltoURL:\s*"([^"]+)"', fh.read()):
            casou = DOC.search(url)
            if casou:
                conhecidos.add(familia(casou.group(1))[0])

    exigidos = set()
    for arquivo in sorted(glob.glob(os.path.join(REGRAS, "current_legal_facts_*.go"))):
        with open(arquivo, encoding="utf-8") as fh:
            for url in re.findall(r'"(https://www\.planalto\.gov\.br/[^"]+)"', fh.read()):
                casou = DOC.search(url)
                if casou:
                    exigidos.add(familia(casou.group(1))[0])

    medidos: dict[str, dict] = {}
    for arquivo in sorted(glob.glob(os.path.join(CORPUS, "*.json"))):
        try:
            with open(arquivo, encoding="utf-8") as fh:
                registro = json.load(fh)
        except (json.JSONDecodeError, OSError):
            continue
        casou = DOC.search(registro.get("citation_url") or "")
        if not casou:
            continue
        base = familia(casou.group(1))[0]
        medidos[base] = {
            "slug": registro.get("slug") or os.path.basename(arquivo),
            "nome": registro.get("nome"),
            "citation_url": registro.get("citation_url"),
            "ancoras_da_citada": registro.get("citation_url_normative_anchors"),
            "url_de_conferencia": registro.get("conference_url"),
            "ancoras_da_conferencia": registro.get("conference_url_normative_anchors"),
            "document_sha256": registro.get("document_sha256"),
            "fetched_at": registro.get("fetched_at"),
        }

    out = []
    for base in sorted(exigidos - conhecidos):
        if base in medidos:
            item = dict(medidos[base])
            item["familia"] = base
            out.append(item)
    return out


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    args = parser.parse_args()

    eleitas = canonicas()
    acervo = no_acervo()
    regras = nas_regras()

    familias = sorted({b for b, _ in acervo} | {b for b, _ in regras} | set(eleitas))
    linhas = []
    fora_no_acervo = 0
    fora_nas_regras = 0
    for base in familias:
        variantes_acervo = {v: n for (b, v), n in acervo.items() if b == base}
        variantes_regra = {v: n for (b, v), n in regras.items() if b == base}
        if not variantes_acervo and not variantes_regra:
            continue
        eleita = eleitas.get(base)
        divergente_acervo = sum(n for v, n in variantes_acervo.items()
                                if eleita is not None and v != eleita)
        divergente_regra = sum(n for v, n in variantes_regra.items()
                               if eleita is not None and v != eleita)
        fora_no_acervo += divergente_acervo
        fora_nas_regras += divergente_regra
        linhas.append({
            "familia": base,
            "variante_canonica": eleita,
            "no_acervo": variantes_acervo,
            "nas_regras": variantes_regra,
            "paginas_fora_da_canonica": divergente_acervo,
            "regras_fora_da_canonica": divergente_regra,
        })

    faltantes = ausentes_da_tabela()

    if args.json:
        json.dump({"familias": linhas,
                   "total_paginas_fora_da_canonica": fora_no_acervo,
                   "total_regras_fora_da_canonica": fora_nas_regras,
                   "ausentes_da_tabela_com_medicao_pronta": faltantes},
                  sys.stdout, ensure_ascii=False, indent=1)
        print()
        return 0

    print(f"{'familia':32s} {'canonica':12s} {'acervo (variante:n)':44s} regras")
    for item in linhas:
        if not item["paginas_fora_da_canonica"] and not item["regras_fora_da_canonica"]:
            continue
        ac = ", ".join(f"{v or 'sem sufixo'}:{n}" for v, n in sorted(item["no_acervo"].items()))
        rg = ", ".join(f"{v or 'sem sufixo'}:{n}" for v, n in sorted(item["nas_regras"].items()))
        print(f"{item['familia']:32s} {(item['variante_canonica'] or 'sem sufixo'):12s} {ac:44s} {rg}")
    print(f"\nfontes de página fora da variante canônica: {fora_no_acervo}")
    print(f"URLs de regra fora da variante canônica:    {fora_nas_regras}")
    print("\nA divergência não é fonte ausente: é a MESMA fonte com a outra grafia. "
          "Desde 2026-08-29, v2ingest.mesmaFonteExigida aceita as duas — mas SÓ "
          "para ato que lexml.URNForPlanaltoURL resolve.")

    if faltantes:
        print(f"\nAtos que as regras exigem, knowncodes.go NÃO conhece, e o corpus JÁ MEDIU "
              f"({len(faltantes)}):")
        for item in faltantes:
            citada = (item.get("citation_url") or "").split("/")[-1]
            confer = (item.get("url_de_conferencia") or "").split("/")[-1]
            print(f"  {item['familia']:34s} eleita {citada:26s} "
                  f"{item.get('ancoras_da_citada')} âncoras "
                  f"contra {confer}: {item.get('ancoras_da_conferencia')}")
        print("  Para estes, as duas grafias seguem sendo strings diferentes. A eleição "
              "não precisa ser medida de novo: está gravada em data/legal-corpus/, com "
              "document_sha256 e fetched_at.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
