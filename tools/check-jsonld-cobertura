#!/usr/bin/env python3
"""check-jsonld-cobertura — prova, sobre TODOS os public/**/index.html, que cada
página tem o JSON-LD que o gerador devia ter emitido para ela.

POR QUE EXISTE (medido em 2026-09-09). A publicação das 12:37 UTC saiu com ZERO
`"@type":"Article"` em 11.287 index.html: `renderArticleScript` devolve script
VAZIO quando o Report da validação não passa (internal/structureddata/
structured_data.go:502-504) — sem erro, sem log, sem gate — e o `sameAs` do
publisher tinha entrado no JSON sem entrar no schema (`additionalProperties:
false`). Sobraram FAQPage e BreadcrumbList. Nenhum teste pegou, porque todos
montam a identidade editorial sem `same_as` e o campo é `omitempty`. O acervo
inteiro ficou sem Article/author/publisher/datePublished, e a purga total da
borda entregou isso ao Googlebot e aos agentes de IA. Este check é o que
transforma "script vazio em silêncio" em vermelho nomeado.

O QUE MEDE. Para cada `public/**/index.html` (nunca amostra), a presença dos três
blocos que o render emite, contra o que a PÁGINA devia ter segundo
`content/pages.json`:

  - Article        esperado sse `page_type` ∈ content.LegalPageTypes
                   (internal/render/render.go:627: `page.IsLegalContent()`) E
                   `page_type` ≠ noticia-juridica;
  - NewsArticle    esperado sse `page_type` = noticia-juridica — subtipo de
                   Article no schema.org, emitido por
                   internal/structureddata/structured_data.go `tipoDeArtigo`
                   (a regra do repo é acrescentar tipo, nunca trocar a base por
                   algo mais pobre). Contado À PARTE de propósito: assim o gate
                   também flagra o inverso — notícia que perdeu o NewsArticle e
                   virou Article genérico aparece como faltante de um e
                   inesperado do outro. Falso positivo medido em 2026-09-09 na
                   primeira execução (85 /diarios/* acusados sem Article; tinham
                   NewsArticle), apanhado pela sessão par;
  - BreadcrumbList esperado sob a MESMA condição (o bloco sai dentro do mesmo
                   `if`, render.go:655);
  - FAQPage        esperado sse a página tem `faq` não vazio em pages.json
                   (aditivo: só sai quando há bloco autoral de perguntas).

O conjunto esperado é derivado do DISCO a cada execução, e o veredito é por
DIFERENÇA (quem falta, com o caminho), nunca por percentual fixo: o acervo muda
de composição e um piso numérico viraria falso vermelho ou falso verde.
Medido em 2026-09-09 (11.051 páginas em pages.json): Article/Breadcrumb
esperados em 11.039 (artigo 9.093, precedente 1.070, wiki 400, pergunta 331,
noticia-juridica 85, jurisprudencia 60); institucional 5, aviso-legal 3, home,
fonte-oficial, busca-interna e contato (1 cada) legitimamente NÃO os têm;
FAQPage esperado em 9.176; das 11.039, 85 são noticia-juridica (NewsArticle) e
10.954 esperam Article. Zero falso positivo sobre esse disco depois da
correção do NewsArticle (o Article estava de fato ausente na primeira medição).

A LISTA DE TIPOS LEGAIS É COPIADA DE `internal/content/content.go`
(`var LegalPageTypes`) e o teste `tools/test_check_jsonld_cobertura.py` reprova
se a cópia divergir do Go — é assim que "derivado do disco" não vira "número
fixo no script" pela porta de trás.

QUEDA RELATIVA TAMBÉM REPROVA. Zero é o caso fácil; o que morderia de novo é
11.039 virar 300 sem ninguém ver. Cada execução com `--gravar` acrescenta uma
linha a `data/ops/jsonld_cobertura_daily.jsonl`; a execução seguinte compara
`presente` por tipo com a ÚLTIMA linha e reprova queda acima de
`--queda-maxima-pct` (padrão 1,0) — salvo `--publicacao-declarada`, para a
passada em que o acervo encolheu de propósito.

ARQUIVO EM public/ QUE NÃO ESTÁ EM pages.json (hubs de área, páginas de erro,
`/redesocial/` estático…) não tem expectativa: entra em `fora_do_pages_json` e
nunca reprova por si. Página de pages.json sem index.html no disco entra em
`sem_html` (é defeito de publicação, de outra classe) e conta no relato.

READ-ONLY POR PADRÃO (CLAUDE.md §4, BUG-236): sem `--gravar` nada é escrito.

EXIT
  0  todo bloco esperado presente, sem queda relativa
  1  há página sem bloco esperado, ou queda relativa acima do teto
  2  não conseguiu medir: pages.json, site.json (base_url) ou public/ ausentes,
     nenhum index.html

Uso:
    tools/check-jsonld-cobertura                        # relata; exit = veredito
    tools/check-jsonld-cobertura --gravar               # o que a unit/deploy roda
    tools/check-jsonld-cobertura --publicacao-declarada # passada que encolheu o acervo

Custo medido em 2026-09-09: ~3 s para 11.287 arquivos (lê cada um inteiro).
Testes: python3 tools/test_check_jsonld_cobertura.py
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMA = "jsonld_cobertura_v1"
SERIE_RELATIVA = os.path.join("data", "ops", "jsonld_cobertura_daily.jsonl")

# Cópia de internal/content/content.go (var LegalPageTypes). O teste de paridade
# reprova se o Go ganhar ou perder um tipo sem esta lista acompanhar.
LEGAL_PAGE_TYPES = frozenset({
    "wiki",
    "legislacao",
    "dispositivo-legal",
    "jurisprudencia",
    "precedente",
    "noticia-juridica",
    "artigo",
    "pergunta",
    "hub-tematico",
})

MARCADORES = {
    "article": b'"@type":"Article"',
    "newsarticle": b'"@type":"NewsArticle"',
    "breadcrumb": b'"@type":"BreadcrumbList"',
    "faqpage": b'"@type":"FAQPage"',
}

# Cópia de internal/structureddata/institutional.go (var institutionalPages):
# rota -> fragmento do @id. O teste de paridade reprova se o Go ganhar ou perder
# uma rota sem esta lista acompanhar, pela mesma razão de LEGAL_PAGE_TYPES.
#
# POR QUE O @id E NÃO O @type, e o número é o argumento. Medido em 2026-09-11
# sobre as 11.287 páginas de public/:
#
#     "@type":"WebPage"         11.091 páginas — só 4 são institucionais
#     "@type":"CollectionPage"     238 páginas — só 1 é institucional
#     "@type":"ProfilePage"          1
#     "@type":"AboutPage"            1
#
# `WebPage` e `CollectionPage` aparecem dentro de outros nós (isPartOf,
# mainEntityOfPage, hubs de área) e como marcador dariam 11.087 e 237 falsos
# positivos. O @id com fragmento é único por rota por construção — é o próprio
# `canonical + kind.fragment` que institutional.go monta — e não casa em lugar
# nenhum além do nó que se quer contar.
ROTAS_INSTITUCIONAIS = {
    "/sobre/": "#profilepage",
    "/metodologia/": "#aboutpage",
    "/termos/": "#webpage",
    "/privacidade/": "#webpage",
    "/aviso-legal/": "#webpage",
    "/fontes/": "#collection",
    "/bot/": "#webpage",
    "/radar-ia/": "#webpage",
}

TIPO_INSTITUCIONAL = "institucional"


def carrega_base_url(root: str) -> str:
    """A URL canônica do portal, de content/site.json — NUNCA escrita aqui.

    `base_url` é a mesma chave que internal/content.LoadRepository lê e que
    institutional.go usa para montar o @id, e o repositório tem teste de contrato
    que reprova identidade literal em runtime. Ausente, o gate não tem como
    montar o marcador: isso é "não conseguiu medir" (exit 2), nunca "tudo
    presente".

    O `rstrip("/")` espelha o `strings.TrimRight(site.BaseURL, "/")` do Go: se a
    configuração ganhar barra final, o marcador continua idêntico ao emitido.
    """
    caminho = os.path.join(root, "content", "site.json")
    with open(caminho, encoding="utf-8") as handle:
        site = json.load(handle)
    base = str(site.get("base_url", "")).strip().rstrip("/")
    if not base:
        raise FileNotFoundError(caminho + " sem base_url")
    return base


def marcador_institucional(base_url: str, path: str) -> bytes:
    """A substring que só o nó institucional daquela rota produz.

    A ÂNCORA É A CHAVE `@id`, e não a aspa de abertura — esta função já errou por
    isso. Até 2026-09-16 ela montava `'"' + path + fragmento + '"'`, supondo @id
    RELATIVO (`"/sobre/#profilepage"`). O renderizador emite ABSOLUTO
    (`"@id":"https://wikijuridica.com.br/sobre/#profilepage"`, institutional.go:
    `canonical + kind.fragment`), então a aspa de abertura cai antes de `https:`
    e o marcador não casava em NENHUMA das oito rotas: o gate acusou 8 faltantes
    e 7 eram falso positivo — reprovou o deploy do acervo inteiro por um defeito
    que só existia em uma rota.

    POR QUE `"@id":"` BASTA, e por que a aspa sozinha não bastaria. Tirar a aspa
    da esquerda e casar só `URL + fragmento + '"'` resolveria o falso positivo e
    abriria outro buraco: sem âncora à esquerda, a substring casaria DENTRO de
    qualquer string maior terminada assim — outro campo, outra origem, um href
    no corpo. Ancorar na chave restringe o casamento ao membro JSON que É o
    identificador do nó, e a aspa de fechamento pina o valor INTEIRO (nada de
    prefixo de uma URL mais longa). O par chave+valor completo é único por rota
    por construção: é o próprio `canonical + fragment` que institutional.go
    monta, e canonical é único por página.

    DEPENDÊNCIA REGISTRADA: `encoding/json` serializa compacto, sem espaço depois
    dos dois-pontos, e é assim que o script sai no HTML. Se algum dia o emissor
    imprimir formatado, o controle POSITIVO da bancada fica vermelho — que é o
    desfecho certo: o gate avisa em vez de ficar verde por vacuidade.
    """
    return ('"@id":"' + base_url + path + ROTAS_INSTITUCIONAIS[path] + '"').encode("utf-8")

# Mesma regra de internal/structureddata/structured_data.go (tipoDeArtigo): a
# notícia jurídica sai como NewsArticle; todo outro tipo legal, como Article.
PAGE_TYPE_DE_NOTICIA = "noticia-juridica"

MODO_DE_FALHA = {
    "article": ("renderArticleScript devolve script VAZIO quando o Report da validação não passa "
                "(internal/structureddata/structured_data.go:502-504) — sem erro nem log; o gate de "
                "emissão é internal/render/render.go:627 (page.IsLegalContent()). Olhe o schema do "
                "Article (additionalProperties:false) contra o JSON que a identidade editorial produz."),
    "newsarticle": ("a notícia jurídica sai como NewsArticle por internal/structureddata/structured_data.go "
                    "(tipoDeArtigo: page_type noticia-juridica); ausente = ou o bloco do Article sumiu "
                    "(structured_data.go:502-504, script vazio sem erro) ou a notícia virou Article genérico — "
                    "confira `inesperados` de article."),
    "breadcrumb": ("o BreadcrumbList sai no mesmo bloco do Article (internal/render/render.go:655); "
                   "ausente = o if de emissão não entrou ou o render mudou de forma."),
    "faqpage": ("o FAQPage é aditivo (internal/structureddata/structured_data.go:289) e só sai quando "
                "a página tem `faq` em pages.json; ausente com faq = o bloco de perguntas deixou de "
                "ser renderizado ou o schema o reprovou em silêncio."),
    TIPO_INSTITUCIONAL: ("RenderInstitutionalScript (internal/structureddata/institutional.go:238) "
                "devolve script VAZIO em SEIS situações, todas com código no Report e NENHUMA com "
                "erro visível no build: page_type virou conteúdo jurídico "
                "(_page_type_conflict), origem não autenticada (_origin_unauthenticated), "
                "identidade editorial incompleta (_identity_missing), algum de heading/summary/"
                "publication_date/dateModified vazio (_required_identity_missing), só em "
                "ProfilePage, autor não autenticado (_profile_author_unauthenticated) — e "
                "_schema_validation_failed, de emitJSONLD, que NÃO é recusa explícita da função e "
                "por isso não estava nesta lista até 2026-09-16. Foi justamente ele que deixou "
                "/bot/ sem nenhum JSON-LD: dateModified vinha de content.Page.LastModified() com o "
                "INSTANTE de revisão (2026-09-10T17:22:26Z, o mesmo do <lastmod>) e o esquema só "
                "aceitava o dia. LEIA O REPORT antes de concluir por eliminação — esta mensagem "
                "mandava procurar nos cinco lugares errados. Estar na allowlist não basta: ela "
                "governa quem PODE receber o nó."),
}

MAX_CAMINHOS_NO_RELATO = 20


def caminho_da_pagina(raiz_public: str, arquivo: str) -> str:
    """public/a/b/index.html -> /a/b/ ; public/index.html -> /"""
    rel = os.path.relpath(os.path.dirname(arquivo), raiz_public)
    if rel in (".", ""):
        return "/"
    return "/" + rel.replace(os.sep, "/") + "/"


def carrega_paginas(root: str) -> dict:
    caminho = os.path.join(root, "content", "pages.json")
    with open(caminho, encoding="utf-8") as handle:
        bruto = json.load(handle)
    paginas = bruto["pages"] if isinstance(bruto, dict) and "pages" in bruto else bruto
    por_caminho = {}
    for pagina in paginas:
        path = pagina.get("path")
        if not path:
            continue
        por_caminho[path] = {
            "page_type": pagina.get("page_type", ""),
            "tem_faq": bool(pagina.get("faq")),
        }
    return por_caminho


def esperados_da_pagina(registro: dict, path: str) -> dict:
    legal = registro["page_type"] in LEGAL_PAGE_TYPES
    noticia = registro["page_type"] == PAGE_TYPE_DE_NOTICIA
    return {
        "article": legal and not noticia,
        "newsarticle": legal and noticia,
        "breadcrumb": legal,
        "faqpage": registro["tem_faq"],
        TIPO_INSTITUCIONAL: path in ROTAS_INSTITUCIONAIS,
    }


def mede(root: str) -> dict:
    inicio = time.time()
    por_caminho = carrega_paginas(root)
    base_url = carrega_base_url(root)
    raiz_public = os.path.join(root, "public")
    if not os.path.isdir(raiz_public):
        raise FileNotFoundError(raiz_public)

    tipos = list(MARCADORES) + [TIPO_INSTITUCIONAL]
    contagem = {tipo: {"esperado": 0, "presente": 0, "faltantes": [], "inesperados": 0}
                for tipo in tipos}
    vistos = set()
    fora_do_pages_json = 0
    total_html = 0
    for dirpath, dirnames, filenames in os.walk(raiz_public):
        dirnames.sort()
        if "index.html" not in filenames:
            continue
        arquivo = os.path.join(dirpath, "index.html")
        total_html += 1
        with open(arquivo, "rb") as handle:
            corpo = handle.read()
        path = caminho_da_pagina(raiz_public, arquivo)
        registro = por_caminho.get(path)
        presentes = {tipo: (marca in corpo) for tipo, marca in MARCADORES.items()}
        # O institucional é o único cujo marcador depende da ROTA, porque o @id
        # o é. Fora da allowlist não há marcador possível e o valor é False —
        # nunca "não sei".
        presentes[TIPO_INSTITUCIONAL] = (
            path in ROTAS_INSTITUCIONAIS and marcador_institucional(base_url, path) in corpo)
        if registro is None:
            fora_do_pages_json += 1
            continue
        vistos.add(path)
        esperados = esperados_da_pagina(registro, path)
        for tipo in tipos:
            if esperados[tipo]:
                contagem[tipo]["esperado"] += 1
                if presentes[tipo]:
                    contagem[tipo]["presente"] += 1
                else:
                    contagem[tipo]["faltantes"].append(path)
            elif presentes[tipo]:
                contagem[tipo]["inesperados"] += 1
    sem_html = sorted(set(por_caminho) - vistos)
    for tipo in contagem:
        contagem[tipo]["faltantes"].sort()
    return {
        "schema_version": SCHEMA,
        "date": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d"),
        "gerado_em": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "paginas_em_pages_json": len(por_caminho),
        "index_html": total_html,
        "fora_do_pages_json": fora_do_pages_json,
        "sem_html": len(sem_html),
        "sem_html_amostra": sem_html[:MAX_CAMINHOS_NO_RELATO],
        "tipos": {
            tipo: {
                "esperado": c["esperado"],
                "presente": c["presente"],
                "faltantes_total": len(c["faltantes"]),
                "faltantes_amostra": c["faltantes"][:MAX_CAMINHOS_NO_RELATO],
                "inesperados": c["inesperados"],
            }
            for tipo, c in contagem.items()
        },
        "duracao_s": round(time.time() - inicio, 2),
        "counts_as_audience": False,
    }


def ultima_linha(caminho: str) -> dict | None:
    if not os.path.exists(caminho):
        return None
    ultima = None
    with open(caminho, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if linha:
                ultima = linha
    if ultima is None:
        return None
    try:
        return json.loads(ultima)
    except json.JSONDecodeError:
        return None


def quedas_relativas(atual: dict, anterior: dict | None, teto_pct: float) -> list:
    """Uma entrada por tipo cujo `presente` caiu mais que `teto_pct` contra a
    última linha da série. Sem série anterior, nada a comparar."""
    if not anterior or "tipos" not in anterior:
        return []
    quedas = []
    for tipo, agora in atual["tipos"].items():
        antes = anterior["tipos"].get(tipo, {}).get("presente")
        if not antes:
            continue
        queda_pct = (antes - agora["presente"]) * 100.0 / antes
        if queda_pct > teto_pct:
            quedas.append({"tipo": tipo, "antes": antes, "agora": agora["presente"],
                           "queda_pct": round(queda_pct, 2)})
    return quedas


def grava_serie(caminho: str, linha: dict) -> None:
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    with open(caminho, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")


def relata(medida: dict, quedas: list, saida) -> None:
    print("check-jsonld-cobertura: %d index.html; %d páginas em pages.json; %d fora do pages.json; %d sem html"
          % (medida["index_html"], medida["paginas_em_pages_json"], medida["fora_do_pages_json"], medida["sem_html"]),
          file=saida)
    for tipo, c in medida["tipos"].items():
        print("  %-11s esperado %6d  presente %6d  faltam %6d  inesperados %d"
              % (tipo, c["esperado"], c["presente"], c["faltantes_total"], c["inesperados"]), file=saida)
        if c["faltantes_total"]:
            print("    MODO DE FALHA: " + MODO_DE_FALHA[tipo], file=saida)
            for path in c["faltantes_amostra"]:
                print("    falta em " + path, file=saida)
            if c["faltantes_total"] > len(c["faltantes_amostra"]):
                print("    … e mais %d" % (c["faltantes_total"] - len(c["faltantes_amostra"])), file=saida)
    for queda in quedas:
        print("  QUEDA RELATIVA %s: presente %d -> %d (%.2f%%) sem --publicacao-declarada"
              % (queda["tipo"], queda["antes"], queda["agora"], queda["queda_pct"]), file=saida)
    if medida["sem_html"]:
        print("  sem index.html no disco (defeito de publicação, outra classe): " + ", ".join(medida["sem_html_amostra"]),
              file=saida)


def main(argv: list | None = None, saida=None) -> int:
    saida = saida or sys.stdout
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", default=ROOT, help="raiz do repositório (padrão: a deste script)")
    parser.add_argument("--gravar", action="store_true",
                        help="acrescenta a linha em data/ops/jsonld_cobertura_daily.jsonl (sem isto, só relata)")
    parser.add_argument("--publicacao-declarada", action="store_true",
                        help="a passada encolheu o acervo de propósito: não reprova por queda relativa")
    parser.add_argument("--queda-maxima-pct", type=float, default=1.0,
                        help="queda de `presente` por tipo, contra a última linha da série, que reprova (padrão 1,0)")
    args = parser.parse_args(argv)

    try:
        medida = mede(args.root)
    except FileNotFoundError as erro:
        print("check-jsonld-cobertura: não conseguiu medir: %s ausente" % erro, file=saida)
        return 2
    if medida["index_html"] == 0:
        print("check-jsonld-cobertura: não conseguiu medir: nenhum index.html em public/", file=saida)
        return 2

    serie = os.path.join(args.root, SERIE_RELATIVA)
    quedas = [] if args.publicacao_declarada else quedas_relativas(medida, ultima_linha(serie), args.queda_maxima_pct)
    medida["quedas_relativas"] = quedas
    medida["publicacao_declarada"] = bool(args.publicacao_declarada)

    faltantes = sum(c["faltantes_total"] for c in medida["tipos"].values())
    veredito = 1 if (faltantes or quedas) else 0
    medida["exit"] = veredito
    relata(medida, quedas, saida)
    if args.gravar:
        grava_serie(serie, medida)
        print("  linha gravada em " + os.path.relpath(serie, args.root), file=saida)
    print(json.dumps({k: v for k, v in medida.items() if k not in ("sem_html_amostra",)},
                     ensure_ascii=False, sort_keys=True), file=saida)
    print("check-jsonld-cobertura: exit %d (%s) em %.1f s"
          % (veredito, "verde" if veredito == 0 else "VERMELHO", medida["duracao_s"]), file=saida)
    return veredito


if __name__ == "__main__":
    sys.exit(main())
