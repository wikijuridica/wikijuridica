#!/usr/bin/env python3
"""Mede a INDEXABILIDADE do acervo aceito antes do lancamento. Read-only.

Duas perguntas que nenhum gate do repo responde hoje, e que ficam caras depois
de indexado:

1. PROFUNDIDADE DE CLIQUE. Uma pagina que so existe no sitemap e descoberta
   devagar e recrawleada mal: sem caminho interno ela nao recebe PageRank
   interno nenhum. O contrato de lancamento pede 100% do acervo aceito a <=4
   cliques de "/". Este script mede a profundidade real em tres regimes:

     A (legado) -- nav fixo de 2 links e hubs de area DORMENTES (o antigo
                   enableAreaHubs=false de internal/ondemand). Nenhuma pagina
                   juridica e alcancavel a partir de "/".
     B (hub sem ancoras) -- home lista as areas e as hubs existem, mas a
                   paginacao e so a corrente linear rel=prev/next. A pagina N
                   da area so e alcancavel apos N saltos.
     C (hub com ancoras) -- home lista as areas (diretorio de
                   internal/render/home_areas.go) e cada hub emite ancora
                   DIRETA para todas as paginas de paginacao da propria area
                   (areaHubPageIndex em internal/render/area_hub.go).

   B e C tem exatamente o mesmo numero de URLs e o mesmo conteudo; mudam so as
   ancoras. A diferenca entre as duas colunas e o custo de nao emiti-las.

   O REGIME ATIVO e detectado do CODIGO VIVO (detect_live_regime): o veredito
   (exit code) julga o regime ativo, nao um modelo fixo — a ferramenta nao
   pode continuar reprovando um defeito ja corrigido nem aprovar por memoria
   um defeito reintroduzido.

2. UNICIDADE GLOBAL de <title> e meta description. O contrato de HTML leve
   (internal/htmlcontract) exige title unico de 20-65 caracteres e meta unica
   de 70-160. Comprimento ja e medido em outros gates; unicidade GLOBAL entre
   as ~9,7k paginas nunca foi provada. Title duplicado em escala e sinal
   classico de doorway e derruba o acervo inteiro, nao so a pagina repetida.

Uso: ./tools/check-seo-launch-graph [--json]
Saida: exit 0 se o acervo passa; exit 1 se ha duplicata ou pagina inalcancavel.
"""

from __future__ import annotations

import collections
import json
import math
import pathlib
import sys
import unicodedata

REPO = pathlib.Path(__file__).resolve().parent.parent
INGEST_REPORT = REPO / "data" / "ops" / "v2_ingest_report.jsonl"

# Espelha internal/ondemand/areahub.go:26 (areaHubPageSize). Se aquele valor
# mudar, esta medicao passa a mentir — por isso o numero aparece na saida.
AREA_HUB_PAGE_SIZE = 50

# Espelha o contrato de internal/htmlcontract / internal/seo.
TITLE_MIN, TITLE_MAX = 20, 65
META_MIN, META_MAX = 70, 160

# Alvo de arquitetura de informacao para o lancamento.
MAX_CLICK_DEPTH = 4


def detect_live_regime() -> tuple[str, list[str]]:
    """Detecta qual regime esta ATIVO lendo o estado real do codigo-fonte.

    Tres marcadores, um por elemento do pacote regime C:
      1. hubs ativos     -- internal/ondemand sem a flag de dormencia
                            (enableAreaHubs/areaHubsEnabled removidos quando a
                            malha foi ligada com paridade build<->servidor);
      2. home com areas  -- render emite o diretorio de areas da home
                            (renderHomeAreaNav + id areas-de-pratica);
      3. ancoras de paginacao -- area_hub.go emite areaHubPageIndex (ancora
                            direta para toda pagina de paginacao da area).

    Devolve (nome_do_regime, pendencias). Qualquer marcador ausente rebaixa o
    regime — reintroduzir a dormencia ou remover as ancoras volta a reprovar.
    """
    ondemand_src = (REPO / "internal" / "ondemand" / "ondemand.go").read_text(encoding="utf-8")
    render_src = (REPO / "internal" / "render" / "render.go").read_text(encoding="utf-8")
    hub_src = (REPO / "internal" / "render" / "area_hub.go").read_text(encoding="utf-8")

    # Marcadores de MECANISMO, nao de vocabulario de comentario: a dormencia
    # era um campo de flag (areaHubsEnabled) + construtor de 3 argumentos; a
    # ativacao e o New de 2 argumentos com o indice sempre construido.
    hubs_on = (
        "areaHubsEnabled" not in ondemand_src
        and "return newGenerator(repository, cacheDir)" in ondemand_src
        and "buildAreaIndex(repository.Pages)" in ondemand_src
    )
    home_areas = "renderHomeAreaNav" in render_src and "areas-de-pratica" in render_src
    index_anchors = "areaHubPageIndex" in hub_src

    pending = []
    if not hubs_on:
        pending.append("hubs de area dormentes em internal/ondemand")
    if not home_areas:
        pending.append("home sem o diretorio de areas (internal/render)")
    if not index_anchors:
        pending.append("hub sem ancoras diretas de paginacao (area_hub.go)")

    if hubs_on and home_areas and index_anchors:
        return "C_hub_com_ancoras", pending
    if hubs_on and home_areas:
        return "B_hub_sem_ancoras", pending
    return "A_legado", pending


def normalize(text: str) -> str:
    """Chave de comparacao de duplicidade.

    Compara o texto como o buscador o le: espacos colapsados, caixa unificada e
    forma Unicode normalizada (NFC). "Guia do INSS" e "Guia do INSS " sao a
    mesma duplicata para efeito de SERP, e acento composto vs precomposto
    tambem.
    """
    return unicodedata.normalize("NFC", " ".join(text.split())).casefold()


def load_accepted() -> list[dict]:
    if not INGEST_REPORT.exists():
        sys.exit(f"relatorio de ingestao ausente: {INGEST_REPORT}")
    rows = []
    with INGEST_REPORT.open(encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            row = json.loads(line)
            if row.get("status") == "accepted":
                rows.append(row)
    return rows


def load_titles(rows: list[dict]) -> dict[str, dict]:
    """Junta o relatorio de ingestao ao texto real do shard editorial.

    O relatorio carrega o public_path e a procedencia (source_shard +
    source_line, 1-indexado); o title/meta so existem no shard. A leitura e
    feita uma vez por shard.
    """
    by_shard: dict[str, list[dict]] = collections.defaultdict(list)
    for row in rows:
        by_shard[row["source_shard"]].append(row)

    resolved: dict[str, dict] = {}
    for shard, shard_rows in by_shard.items():
        path = REPO / shard
        if not path.exists():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        for row in shard_rows:
            index = row["source_line"] - 1
            if index < 0 or index >= len(lines):
                continue
            try:
                record = json.loads(lines[index])
            except json.JSONDecodeError:
                continue
            resolved[row["public_path"]] = {
                "title": record.get("title") or "",
                "meta": record.get("meta_description") or "",
                "area": row.get("practice_area") or "",
            }
    return resolved


def depth_profile(area_counts: dict[str, int]) -> dict[str, dict]:
    """Profundidade em cliques de cada pagina aceita, por regime.

    Regime A: "/" alcanca apenas /fontes/planalto/ e /buscar/. Nenhuma pagina
    juridica entra no grafo — todas ficam em profundidade infinita.

    Regime B: "/" -> hub da area (1 clique). A pagina 1 da hub lista 50 membros
    (2 cliques) e aponta rel=next para a pagina 2 (2 cliques). Logo a pagina k
    da paginacao esta a k cliques e seus membros a k+1.

    Regime C: "/" -> hub da area (1 clique). Toda pagina de paginacao da area
    recebe ancora direta da pagina 1, ficando a 2 cliques; os membros de
    qualquer uma delas ficam a 3.
    """
    regimes = {"A_legado": [], "B_hub_sem_ancoras": [], "C_hub_com_ancoras": []}
    for count in area_counts.values():
        pages = max(1, math.ceil(count / AREA_HUB_PAGE_SIZE))
        for index in range(count):
            page_number = index // AREA_HUB_PAGE_SIZE + 1
            regimes["A_legado"].append(math.inf)
            # pagina k a k cliques -> membro a k+1
            regimes["B_hub_sem_ancoras"].append(page_number + 1)
            # pagina 1 a 1 clique (a propria hub), demais a 2 -> membro a 2 ou 3
            regimes["C_hub_com_ancoras"].append(2 if page_number == 1 else 3)
        assert pages >= 1

    summary = {}
    for name, depths in regimes.items():
        finite = [d for d in depths if d != math.inf]
        unreachable = len(depths) - len(finite)
        summary[name] = {
            "paginas": len(depths),
            "inalcancaveis": unreachable,
            "profundidade_maxima": (max(finite) if finite else None),
            "mediana": (sorted(finite)[len(finite) // 2] if finite else None),
            "acima_de_%d_cliques" % MAX_CLICK_DEPTH: sum(
                1 for d in finite if d > MAX_CLICK_DEPTH
            )
            + unreachable,
        }
    return summary


def main() -> int:
    as_json = "--json" in sys.argv
    rows = load_accepted()
    area_counts = collections.Counter(r.get("practice_area") or "" for r in rows)
    resolved = load_titles(rows)

    depths = depth_profile(dict(area_counts))
    live_regime, regime_pending = detect_live_regime()

    titles: dict[str, list[str]] = collections.defaultdict(list)
    metas: dict[str, list[str]] = collections.defaultdict(list)
    bad_title_len, bad_meta_len, missing = [], [], []
    for path, data in resolved.items():
        title, meta = data["title"], data["meta"]
        if not title or not meta:
            missing.append(path)
            continue
        titles[normalize(title)].append(path)
        metas[normalize(meta)].append(path)
        if not TITLE_MIN <= len(title) <= TITLE_MAX:
            bad_title_len.append((path, len(title)))
        if not META_MIN <= len(meta) <= META_MAX:
            bad_meta_len.append((path, len(meta)))

    dup_titles = {k: v for k, v in titles.items() if len(v) > 1}
    dup_metas = {k: v for k, v in metas.items() if len(v) > 1}

    result = {
        "aceitas": len(rows),
        "areas": len(area_counts),
        "hub_page_size": AREA_HUB_PAGE_SIZE,
        "paginas_de_hub": sum(
            max(1, math.ceil(c / AREA_HUB_PAGE_SIZE)) for c in area_counts.values()
        ),
        "regime_ativo": live_regime,
        "regime_pendencias": regime_pending,
        "profundidade": depths,
        "titles_resolvidos": len(resolved),
        "titles_duplicados_grupos": len(dup_titles),
        "titles_duplicados_paginas": sum(len(v) for v in dup_titles.values()),
        "metas_duplicadas_grupos": len(dup_metas),
        "metas_duplicadas_paginas": sum(len(v) for v in dup_metas.values()),
        "title_fora_de_%d_%d" % (TITLE_MIN, TITLE_MAX): len(bad_title_len),
        "meta_fora_de_%d_%d" % (META_MIN, META_MAX): len(bad_meta_len),
        "sem_title_ou_meta": len(missing),
    }

    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(f"acervo aceito: {result['aceitas']} paginas em {result['areas']} areas")
        print(
            f"hubs de area: {result['paginas_de_hub']} paginas "
            f"(page size {AREA_HUB_PAGE_SIZE})"
        )
        print(f"regime ATIVO no codigo: {live_regime}")
        for item in regime_pending:
            print(f"  pendencia: {item}")
        print()
        print("PROFUNDIDADE DE CLIQUE a partir de /")
        for name, data in depths.items():
            marker = " <= ATIVO" if name == live_regime else ""
            print(
                f"  {name:22s} max={data['profundidade_maxima']} "
                f"mediana={data['mediana']} "
                f"inalcancaveis={data['inalcancaveis']} "
                f">{MAX_CLICK_DEPTH}cliques={data['acima_de_%d_cliques' % MAX_CLICK_DEPTH]}"
                f"{marker}"
            )
        print("\nUNICIDADE GLOBAL (title / meta description)")
        print(f"  resolvidos do shard editorial: {result['titles_resolvidos']}")
        print(
            f"  titles duplicados: {result['titles_duplicados_grupos']} grupos, "
            f"{result['titles_duplicados_paginas']} paginas"
        )
        print(
            f"  metas duplicadas:  {result['metas_duplicadas_grupos']} grupos, "
            f"{result['metas_duplicadas_paginas']} paginas"
        )
        print(f"  title fora de {TITLE_MIN}-{TITLE_MAX}: {len(bad_title_len)}")
        print(f"  meta fora de {META_MIN}-{META_MAX}: {len(bad_meta_len)}")
        print(f"  sem title ou meta: {len(missing)}")
        for label, groups in (("TITLE", dup_titles), ("META", dup_metas)):
            for key, paths in list(groups.items())[:5]:
                print(f"  [{label} dup x{len(paths)}] {key[:70]}")
                for p in paths[:3]:
                    print(f"      {p}")

    # O veredito julga o regime ATIVO no codigo: pagina inalcancavel ou acima
    # de 4 cliques NO REGIME VIVO reprova — assim como duplicata global de
    # title/meta. Controles que continuam reprovando: regressao a A (dormencia
    # reintroduzida) volta a inalcancaveis=total; remocao das ancoras (B)
    # reprova por >4 cliques; loc duplicada reprova sempre.
    live = depths[live_regime]
    failed = (
        bool(dup_titles or dup_metas)
        or live["inalcancaveis"] > 0
        or live["acima_de_%d_cliques" % MAX_CLICK_DEPTH] > 0
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
