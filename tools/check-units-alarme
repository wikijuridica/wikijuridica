    "wikijuridica-cerebro.service": "tools/check-cerebro-vivo",
    # StartLimitIntervalSec=0 DELIBERADO, com a analise escrita em
    # wikijuridica-social.service:84-96: daemon que SERVE nao pode entrar em
    # `failed`, porque ficaria parado ate alguem mandar reset-failed. O detector
    # e a derivada de NRestarts lida pelo vigia do portal.
    "wikijuridica-social.service": "tools/check-portal-health",
}


# ────────────────────────────────────────────────────────────────────────────
# R-H — A GUARDA QUE O NAMESPACE ENGOLE (acrescentado em 2026-09-16)
#
# `PrivateTmp=true` da ao servico um /tmp PRIVADO. Um processo que use um arquivo
# de /tmp para se COORDENAR com processos de fora -- um flock, um pidfile, um
# socket -- passa a se coordenar consigo mesmo, e a guarda responde sempre a
# mesma coisa, que e a resposta errada.
#
# O CASO MEDIDO, e ele custou 10 dias: `wikijuridica-cerebro.service` tem
# `PrivateTmp=true`; `internal/cerebro/carga_linux.go` abria
# /tmp/opt-wiki-agent-heavy.lock com `O_CREATE`. O daemon criava o proprio lock
# no /tmp privado, trancava esse, e concluia sempre "ninguem esta compilando".
# Inode 39454263 no host contra 39739472 no namespace do daemon (pid 926445), o
# do daemon nascido no minuto do ExecStart. Em 10 dias o cerebro pausou UMA vez,
# e por loadavg -- nunca pelo lock.
#
# E O DEFEITO NAO TEM LITERAL PARA PROCURAR NA UNIT: o caminho do lock mora no
# CODIGO, e a unit so diz `PrivateTmp=true`, que e correto e desejavel. Quem der
# grep em "/tmp" nas units nao acha nada.
#
# Por isso R-H tem DUAS METADES:
#
#   R-H1  ESTRUTURAL, sem lista: unit com PrivateTmp e um caminho /tmp/ escrito
#         numa diretiva propria (o `flock /tmp/... ` das bancadas, por exemplo)
#         precisa do BindPaths/BindReadOnlyPaths correspondente.
#   R-H2  DECLARADA e VERIFICADA, como DETECTORES_NOMEADOS: unit cujo caminho de
#         /tmp mora no binario entra em LOCKS_FORA_DA_UNIT, e o gate confere as
#         TRES pernas -- o caminho existe no codigo Go, a unit declara o bind, e
#         ha snippet tmpfiles.d que cria o arquivo no boot.
#
# A terceira perna nao e detalhe: /tmp e esvaziado no boot
# (`D /tmp 1777 root root -` em /usr/lib/tmpfiles.d/tmp.conf). Bind com prefixo
# `-` sobre origem ausente e PULADO em silencio, e ai o codigo volta a ver um
# /tmp privado -- a mentira de novo, agora sem nem o arquivo no disco para
# denuncia-la. Bind SEM o `-` sobre origem ausente aborta o namespace com
# 226/NAMESPACE, que num daemon com Restart=always e um laco de boot mudo. As
# duas saidas sao ruins, e a que fecha as duas e o snippet.
LOCKS_FORA_DA_UNIT = {
    # O flock de compilacao/commit do CLAUDE.md §1. O caminho vive em
    # internal/cerebro/saude.go (LockPesadoPadrao) e chega ao daemon por flag.
    "wikijuridica-cerebro.service": ["/tmp/opt-wiki-agent-heavy.lock"],
}

# Onde os snippets tmpfiles.d deste repositorio moram.
DIR_TMPFILES = os.path.join(RAIZ, "ops/tmpfiles.d")

# Diretivas que MONTAM um caminho do host dentro do namespace do servico.
DIRETIVAS_DE_BIND = ("BindPaths", "BindReadOnlyPaths")


def caminhos_de_tmp(texto):
    """Caminhos sob /tmp/ citados num valor de diretiva."""
    return re.findall(r"/tmp/[A-Za-z0-9._/-]+", texto or "")


def montados_no_namespace(diretivas):
    """Origens que a unit monta do host (o lado ESQUERDO de origem:destino)."""
    origens = set()
    for d in diretivas:
        if d["chave"] not in DIRETIVAS_DE_BIND:
            continue
        for item in d["valor"].split():
            bruto = item.lstrip("-")
            origem = bruto.split(":", 1)[0]
            if origem:
                origens.add(origem)
    return origens


def criado_por_tmpfiles(caminho):
    """Algum snippet de ops/tmpfiles.d cria este caminho?

    Le a LINHA de configuracao, nao o arquivo inteiro: um caminho citado so no
    comentario explicando o problema nao cria arquivo nenhum -- e o mesmo erro
    do `grep -l OnFailure` que este gate ja desarmou em R-A.
    """
    if not os.path.isdir(DIR_TMPFILES):
        return False
    for arquivo in sorted(os.listdir(DIR_TMPFILES)):
        try:
            with open(os.path.join(DIR_TMPFILES, arquivo), encoding="utf-8",
                      errors="replace") as fh:
                for linha in fh:
                    corpo = linha.strip()
                    if not corpo or corpo.startswith("#"):
                        continue
                    campos = corpo.split()
                    # Tipo, Caminho, ... — so os tipos que CRIAM arquivo contam.
                    if len(campos) >= 2 and campos[0].rstrip("+!=-") in ("f", "f+", "F", "w") \
                            and campos[1] == caminho:
                        return True
        except OSError:
            continue
    return False


def aparece_no_codigo_go(caminho):
    """O literal esta em algum .go de internal/ ou cmd/?

    Uma entrada de LOCKS_FORA_DA_UNIT que nao aparece no codigo e uma alegacao
    sobre um lock que ninguem usa — e ela ficaria verde por omissao para sempre.
    """
    for raiz_rel in ("internal", "cmd"):
        base = os.path.join(RAIZ, raiz_rel)
        for pasta, _, arquivos in os.walk(base):
            for arquivo in arquivos:
                if not arquivo.endswith(".go"):
                    continue
                try:
                    with open(os.path.join(pasta, arquivo), encoding="utf-8",
                              errors="replace") as fh:
                        if caminho in fh.read():
                            return True
                except OSError:
                    continue
    return False


def duracao_systemd(valor, padrao):
    """Converte `15`, `15s`, `2min`, `1min 30s` em segundos.

    Valor nu e' SEGUNDOS nas diretivas de tempo do systemd (RestartSec=15), e
    nao milissegundos — errar isso inverteria o veredito de R-F.
    """
    if valor is None:
        return padrao
    texto = valor.strip().lower()
    if not texto:
        return padrao
    if texto in ("infinity", "infinite"):
        return float("inf")
    unidades = {
        "us": 1e-6, "usec": 1e-6, "ms": 1e-3, "msec": 1e-3,
        "s": 1, "sec": 1, "second": 1, "seconds": 1,
        "m": 60, "min": 60, "minute": 60, "minutes": 60,
        "h": 3600, "hr": 3600, "hour": 3600, "hours": 3600,
        "d": 86400, "day": 86400, "days": 86400,
    }
    total, achou = 0.0, False
    for numero, unidade in re.findall(r"(\d+(?:\.\d+)?)\s*([a-z]*)", texto):
        if unidade == "":
            total += float(numero)
            achou = True
        elif unidade in unidades:
            total += float(numero) * unidades[unidade]
            achou = True
        else:
            return padrao
    return total if achou else padrao


def alvos_de_execstart(valor, raiz):
    """Scripts DESTE repositorio invocados por uma linha ExecStart.

    Sai do token, nunca de substring: `ExecStart=/usr/bin/flock /tmp/x
    /opt/wiki/tools/run-qualidade-diaria` tem o script no TERCEIRO token, e
    `ExecStart=/opt/wiki/tools/aguardar-fim-de-deploy /usr/bin/systemctl ...`
    tem dois executaveis na mesma linha. Devolver todos os que moram sob a raiz
    cobre os dois casos sem lista chumbada.
    """
    achados = []
    for token in valor.split():
        limpo = token.lstrip("-+!@:")
        if not limpo.startswith("/"):
            continue
        if os.path.realpath(limpo).startswith(os.path.realpath(raiz) + os.sep):
            achados.append(limpo)
    return achados


def protegido_contra_queda(caminho, visitados=None):
    """A ferramenta traduz queda em exit >= 2?

    Reconhece as tres formas que existem neste repositorio, e segue UM salto de
    `exec` — tools/generate-edge-cache-coverage e um wrapper de tres linhas cujo
    exit code e', literalmente, o da ferramenta que ele executa; exigir o helper
    NELE seria exigir uma linha que nao muda comportamento nenhum.
    """
    visitados = visitados or set()
    real = os.path.realpath(caminho)
    if real in visitados or not os.path.isfile(real):
        return False
    visitados.add(real)
    try:
        with open(real, encoding="utf-8", errors="replace") as fh:
            fonte = fh.read()
    except OSError:
        return False
    if "main_protegido" in fonte:                 # Python, via saida_de_medidor.py
        return True
    if "saida_de_medidor.sh" in fonte:            # bash, via o helper irmao
        return True
    # Trap EXIT propria que PRESERVA codigo >= 2. run-daily-content:264-278 tem
    # a dele desde a auditoria de 2026-08-28, e sobrepor outra trap EXIT ali a
    # destruiria (bash so guarda uma). Reconhecer a que ja existe e o certo.
    if re.search(r"trap\s+\w+\s+EXIT", fonte) and re.search(r"codigo\s*-ge\s*2", fonte):
        return True
    # Um salto de `exec` para outra ferramenta da arvore.
    for linha in fonte.splitlines():
        if linha.strip().startswith("exec ") and "$ROOT" in linha or linha.strip().startswith("exec \""):
            for pedaco in re.findall(r'"\$\{?ROOT\}?/([^"]+)"', linha):
                destino = os.path.join(os.path.dirname(real), "..", pedaco)
                if protegido_contra_queda(destino, visitados):
                    return True
    return False


def le_unit(caminho):
    """Devolve as diretivas com secao e numero de linha, ignorando comentario.

    Nao usa substring em lugar nenhum: e o parse que impede o erro do `grep -l`
    que contou comentario como diretiva.
    """
    with open(caminho, encoding="utf-8", errors="replace") as fh:
        linhas = fh.read().split("\n")

    diretivas = []
    secao = None
    for n, bruta in enumerate(linhas, start=1):
        linha = bruta.strip()
        if not linha or linha.startswith("#") or linha.startswith(";"):
            continue
        if linha.startswith("[") and linha.endswith("]"):
            secao = linha[1:-1]
            continue
        if "=" not in linha:
            continue
        chave, _, valor = linha.partition("=")
        diretivas.append(
            {"secao": secao, "chave": chave.strip(), "valor": valor.strip(), "linha": n}
        )
    return linhas, diretivas


def justificativa_adjacente(linhas, numero_linha):
    """Comentario contiguo imediatamente ACIMA da diretiva (1-indexado)."""
    prosa = []
    i = numero_linha - 2  # index 0 da linha anterior
    while i >= 0:
        linha = linhas[i].strip()
        if not linha.startswith("#"):
            break
        prosa.append(linha.lstrip("#").strip())
        i -= 1
    return " ".join(reversed(prosa)).strip()


def alvos_de_timer(dir_units, nomes_service):
    """Mapa service -> timer que o dispara.

    Timer sem `Unit=` aponta para o .service de mesmo basename: 4 dos 21 timers
    deste repo dependem dessa regra implicita do systemd.
    """
    alvos = {}
    for arquivo in sorted(os.listdir(dir_units)):
        if not arquivo.endswith(".timer"):
            continue
        _, diretivas = le_unit(os.path.join(dir_units, arquivo))
        declarado = None
        for d in diretivas:
            if d["chave"] == "Unit" and d["secao"] == "Timer":
                declarado = d["valor"]
        if declarado is None:
            declarado = arquivo[: -len(".timer")] + ".service"
        if declarado in nomes_service:
            alvos[declarado] = arquivo
    return alvos


def arquivo_do_alvo(alvo):
    """Resolve `wikijuridica-alerta@%N.service` -> `wikijuridica-alerta@.service`."""
    if not alvo.endswith(".service"):
        return alvo
    base = alvo[: -len(".service")]
    if "@" in base:
        base = base.split("@", 1)[0] + "@"
    return base + ".service"


def classifica(nome, diretivas, dirigida_por_timer):
    """Classe estrutural da unit. Sem lista chumbada de nomes."""
    chaves = {d["chave"] for d in diretivas}
    if "@" in nome:
        return "template", "instanciada por outra unit (`@` no nome)"
    if "Restart" in chaves:
        sem_limite = any(
            d["chave"] == "StartLimitIntervalSec" and d["valor"] == "0" for d in diretivas
        )
        if sem_limite:
            return "daemon", (
                "Restart= com StartLimitIntervalSec=0: reinicia para sempre e NUNCA "
                "chega a failed, entao OnFailure ali seria decoracao que nao dispara"
            )
        return "daemon", "Restart= presente: o supervisor reinicia em vez de falhar"
    if dirigida_por_timer:
        return "agendada", f"disparada por {dirigida_por_timer}"
    return "suporte", "oneshot sem timer e sem Restart: chamada por outra unit"


def main():
    ap = argparse.ArgumentParser(
        description="Reprova unit de vigia/medicao/publicacao que falha em silencio."
    )
    ap.add_argument("--json", action="store_true", help="saida legivel por maquina")
    args = ap.parse_args()

    if not os.path.isdir(DIR_UNITS):
        print(f"INCONCLUSIVO: {DIR_UNITS} nao existe ou nao e diretorio", file=sys.stderr)
        return 2
    try:
        arquivos = sorted(f for f in os.listdir(DIR_UNITS) if f.endswith(".service"))
    except OSError as erro:
        print(f"INCONCLUSIVO: {DIR_UNITS} ilegivel ({erro})", file=sys.stderr)
        return 2
    if not arquivos:
        print(f"INCONCLUSIVO: nenhuma unit .service em {DIR_UNITS}", file=sys.stderr)
        return 2

    nomes = set(arquivos)
    por_timer = alvos_de_timer(DIR_UNITS, nomes)

    problemas, isentas, mascaras, exigem, com_onfailure = [], [], [], [], []

    def reprova(unit, regra, detalhe):
        problemas.append({"unit": unit, "regra": regra, "detalhe": detalhe})

    for nome in arquivos:
        caminho = os.path.join(DIR_UNITS, nome)
        linhas, diretivas = le_unit(caminho)
        classe, motivo = classifica(nome, diretivas, por_timer.get(nome))

        onfailure = [d for d in diretivas if d["chave"] == "OnFailure"]
        sucesso = [d for d in diretivas if d["chave"] == "SuccessExitStatus"]
        # A unit de alerta e a que CHAMA notify-owner. Descoberta pelo conteudo,
        # nao pelo nome: renomear o canal nao pode cegar a guarda de laco.
        e_canal_alerta = any(
            d["chave"].startswith("ExecStart") and "notify-owner" in d["valor"]
            for d in diretivas
        )

        # ---- R-D: OnFailure fora de [Unit] o systemd ignora, em silencio.
        for d in onfailure:
            if d["secao"] != "Unit":
                reprova(nome, "R-D", f"OnFailure na secao [{d['secao']}] (linha {d['linha']}): "
                                     "fora de [Unit] o systemd ignora a diretiva")

        # ---- guarda de laco: o canal de alerta nao pode se alertar.
        if e_canal_alerta and onfailure:
            reprova(nome, "R-LACO", "a unit que executa notify-owner tem OnFailure: "
                                    "falha do canal dispararia o proprio canal, em laco")

        if classe == "agendada":
            exigem.append(nome)
            if not onfailure:
                reprova(nome, "R-A", f"{classe} ({motivo}) sem OnFailure: falha aqui morre "
                                     "no journal e ninguem e avisado")
            for d in onfailure:
                alvo = d["valor"].split()[0] if d["valor"] else ""
                arq = arquivo_do_alvo(alvo)
                if arq not in nomes:
                    reprova(nome, "R-B", f"OnFailure aponta para `{alvo}`, e `{arq}` nao "
                                         "existe em ops/systemd: nao se inventa unit de alerta")
                if "%n" in d["valor"]:
                    reprova(nome, "R-C", f"OnFailure usa `%n` em `{d['valor']}`: %n traz o "
                                         "sufixo e o alerta sai como '...service.service'. Use %N")
        else:
            isentas.append({"unit": nome, "classe": classe, "motivo": motivo})

        if onfailure:
            com_onfailure.append(nome)

        # ---- R-F: ALARME INALCANCAVEL.
        #
        # Uma unit com Restart= que declara OnFailure= esta afirmando que quer
        # ser avisada ao falhar. So que ela so CHEGA a `failed` se o systemd
        # contar `StartLimitBurst` partidas dentro de `StartLimitIntervalSec`.
        # Com RestartSec grande e janela pequena, esse burst e' aritmeticamente
        # inalcancavel: a unit reinicia para sempre, nunca falha, e o OnFailure
        # e' decoracao que nunca dispara.
        #
        # E o defeito NAO TEM LITERAL PARA PROCURAR. A unit do cerebro nao
        # declara nenhum `StartLimit*` — quem der grep no nome da diretiva nao
        # acha nada, e o default do manager (burst 5 em 10 s) decide sozinho
        # contra um RestartSec=15. Por isso este predicado CALCULA em vez de
        # casar texto.
        restart = [d for d in diretivas if d["chave"] == "Restart"]
        if restart and onfailure and classe != "template":
            intervalo_d = next(
                (d for d in diretivas if d["chave"] == "StartLimitIntervalSec"), None)
            # StartLimitIntervalSec so vale em [Unit]. Em [Service] o systemd
            # responde "Unknown key ... ignoring" (medido com systemd-analyze
            # verify em 2026-09-16) e o DEFAULT segue valendo — silenciosamente.
            intervalo_vale = intervalo_d is not None and intervalo_d["secao"] == "Unit"
            intervalo = duracao_systemd(
                intervalo_d["valor"] if intervalo_vale else None,
                DEFAULT_START_LIMIT_INTERVAL_S)
            burst_d = next((d for d in diretivas if d["chave"] == "StartLimitBurst"), None)
            burst_vale = burst_d is not None and burst_d["secao"] == "Unit"
            try:
                burst = int(burst_d["valor"]) if burst_vale else DEFAULT_START_LIMIT_BURST
            except ValueError:
                burst = DEFAULT_START_LIMIT_BURST
            reinicio = duracao_systemd(
                next((d["valor"] for d in diretivas if d["chave"] == "RestartSec"), None),
                DEFAULT_RESTART_SEC)

            # Tempo MINIMO para acumular o burst inteiro. Se ele nao cabe na
            # janela, o contador e' zerado antes de fechar a conta.
            minimo_para_o_burst = reinicio * burst
            alcancavel = intervalo > minimo_para_o_burst

            if intervalo_d is not None and intervalo_d["secao"] != "Unit":
                reprova(nome, "R-F", (
                    "StartLimitIntervalSec na secao [%s] (linha %d): e diretiva de [Unit]. "
                    "Em [Service] o systemd a IGNORA em silencio e o default do manager "
                    "(%ds) continua valendo — so `systemctl show` revela, e este "
                    "repositorio ja pagou por isso (wikijuridica-social.service:84)."
                    % (intervalo_d["secao"], intervalo_d["linha"],
                       DEFAULT_START_LIMIT_INTERVAL_S)))

            if not alcancavel:
                detector = DETECTORES_NOMEADOS.get(nome)
                if detector is None:
                    reprova(nome, "R-F", (
                        "OnFailure INALCANCAVEL: RestartSec=%gs x StartLimitBurst=%d = %gs "
                        "para completar o burst, contra StartLimitIntervalSec=%s. A unit "
                        "reinicia para sempre e NUNCA entra em `failed`, entao o OnFailure "
                        "nunca dispara. Ou a aritmetica muda, ou a unit ganha um DETECTOR "
                        "NOMEADO em DETECTORES_NOMEADOS."
                        % (reinicio, burst, minimo_para_o_burst,
                           "0 (sem teto)" if intervalo == 0 else "%gs" % intervalo)))
                else:
                    caminho_detector = os.path.join(RAIZ, detector)
                    if not os.path.isfile(caminho_detector):
                        reprova(nome, "R-F", (
                            "detector nomeado `%s` nao existe: a unit nao chega a `failed` "
                            "e o substituto declarado nao esta no disco" % detector))
                    elif not os.access(caminho_detector, os.X_OK):
                        reprova(nome, "R-F", (
                            "detector nomeado `%s` nao e executavel: ninguem o roda, entao "
                            "ele nao cobre coisa nenhuma" % detector))
                    else:
                        with open(caminho_detector, encoding="utf-8", errors="replace") as fh:
                            corpo = fh.read()
                        # Aceita com ou sem o sufixo `.service`: os detectores
                        # deste repo guardam o basename (`SERVICO_SOCIAL =
                        # "wikijuridica-social"`), que e a forma que o systemctl
                        # aceita.
                        base = nome[: -len(".service")]
                        if nome not in corpo and base not in corpo:
                            reprova(nome, "R-F", (
                                "detector nomeado `%s` NAO menciona `%s`: detector que nao "
                                "nomeia o alvo nao e detector, e um arquivo que responde ao "
                                "grep" % (detector, nome)))

        # ---- R-H: PrivateTmp engolindo a coordenacao com o mundo de fora.
        privado = any(
            d["chave"] == "PrivateTmp" and d["valor"].lower() in ("true", "yes", "on", "1")
            for d in diretivas
        )
        if privado:
            montados = montados_no_namespace(diretivas)

            # R-H1: caminho de /tmp escrito na PROPRIA unit.
            citados = set()
            for d in diretivas:
                if d["chave"] in DIRETIVAS_DE_BIND:
                    continue
                for caminho in caminhos_de_tmp(d["valor"]):
                    citados.add(caminho)
            for caminho in sorted(citados):
                if caminho in montados:
                    continue
                reprova(nome, "R-H", (
                    "PrivateTmp=true e a unit usa `%s` sem `BindPaths=`/"
                    "`BindReadOnlyPaths=` para ele. Dentro do /tmp privado esse "
                    "caminho e OUTRO arquivo: um flock ali se coordena com "
                    "ninguem e responde sempre 'livre'. Foi assim que a guarda do "
                    "cerebro ficou 10 dias muda (inode 39454263 no host contra "
                    "39739472 no namespace)." % caminho))

            # R-H2: caminho de /tmp que mora no BINARIO, declarado aqui.
            for caminho in LOCKS_FORA_DA_UNIT.get(nome, []):
                if not aparece_no_codigo_go(caminho):
                    reprova(nome, "R-H", (
                        "LOCKS_FORA_DA_UNIT declara `%s` e o literal nao aparece em "
                        "nenhum .go de internal/ ou cmd/: a entrada afirma um lock "
                        "que o codigo nao usa, e ficaria verde por omissao" % caminho))
                    continue
                if caminho not in montados:
                    reprova(nome, "R-H", (
                        "PrivateTmp=true e o binario desta unit usa `%s`, que NAO "
                        "esta em BindPaths=/BindReadOnlyPaths=. O processo cria o "
                        "proprio arquivo no /tmp privado, tranca esse, e a guarda "
                        "responde sempre a mesma coisa. `BindReadOnlyPaths` convive "
                        "com PrivateTmp=true: a origem do bind e resolvida contra a "
                        "raiz do HOST (systemd 252, src/core/namespace.c:1441-1465)."
                        % caminho))
                    continue
                if not criado_por_tmpfiles(caminho):
                    reprova(nome, "R-H", (
                        "a unit monta `%s`, e nenhum snippet de ops/tmpfiles.d o "
                        "CRIA no boot. /tmp e esvaziado no boot (`D /tmp 1777 root "
                        "root -`): depois de um reboot a origem some, o prefixo `-` "
                        "faz o systemd pular a montagem em silencio, e o namespace "
                        "volta a esconder a guarda. O `-` e o snippet sao as duas "
                        "metades da mesma correcao." % caminho))

        # ---- R-E: mascara exige razao registrada e secao certa.
        for d in sucesso:
            prosa = justificativa_adjacente(linhas, d["linha"])
            ok = len(prosa) >= PISO_JUSTIFICATIVA
            mascaras.append(
                {"unit": nome, "codigos": d["valor"], "linha": d["linha"],
                 "justificada": ok, "justificativa": prosa[:160]}
            )
            if d["secao"] != "Service":
                reprova(nome, "R-E", f"SuccessExitStatus na secao [{d['secao']}]: so vale "
                                     "em [Service]")
            if not ok:
                reprova(nome, "R-E", f"SuccessExitStatus={d['valor']} (linha {d['linha']}) sem "
                                     "comentario adjacente: mascara o exit sem razao registrada. "
                                     "Se o codigo e veredito medido, escreva o porque acima da "
                                     "diretiva; se nao e, remova a mascara")

            # ---- R-G: O QUE PODE SER MASCARADO, E O QUE A MASCARA EXIGE DE QUEM
            # E' MASCARADO.
            #
            # R-E ja garante que ha uma RAZAO escrita. R-G garante que a razao e'
            # possivel: nem todo codigo pode ser mascarado, e mascarar exige que a
            # ferramenta por tras saiba distinguir queda de veredito.
            codigos = []
            for pedaco in d["valor"].split():
                try:
                    codigos.append(int(pedaco))
                except ValueError:
                    # SuccessExitStatus aceita nome de sinal (SIGTERM, etc.).
                    # Sinal nao e codigo de saida de ferramenta e nao entra aqui.
                    continue

            for codigo in codigos:
                if codigo == 0:
                    continue  # 0 ja e sucesso; declara-lo e redundante, nao defeito.
                if codigo not in CODIGOS_MASCARAVEIS:
                    reprova(nome, "R-G", (
                        "SuccessExitStatus mascara o codigo %d (linha %d). So 1 (VEREDITO "
                        "MEDIDO) e 75 (EX_TEMPFAIL, falha temporaria) podem ser mascarados. "
                        "%s"
                        % (codigo, d["linha"],
                           "Mascarar 2 e o pior caso possivel: 2 significa NAO MEDI, e nao "
                           "medir nunca e sucesso — a mascara apagaria exatamente o sinal "
                           "que tools/lib/saida_de_medidor.py existe para produzir."
                           if codigo == 2 else
                           "Se este codigo tem significado proprio, o lugar dele e a "
                           "ferramenta, nao a mascara.")))

            # (iii) Mascarar exit 1 so e' seguro se a ferramenta NAO sair 1 ao
            # CAIR. Sem isso, um traceback vira `Result=success` e o OnFailure
            # fica mudo — que e' a familia de defeitos corrigida em 2026-09-16.
            #
            # `ExecStart=-` (com o prefixo) fica de fora: o `-` ja diz ao systemd
            # para ignorar o codigo daquele comando, entao a mascara nao e o que
            # esconde a queda. O predicado cobre os SEM prefixo, que sao os que a
            # mascara alcanca.
            if 1 in codigos:
                for e in diretivas:
                    if not e["chave"].startswith("ExecStart"):
                        continue
                    if e["valor"].startswith("-"):
                        continue
                    for alvo in alvos_de_execstart(e["valor"], RAIZ):
                        if not os.path.isfile(alvo):
                            reprova(nome, "R-G", (
                                "ExecStart (linha %d) aponta para `%s`, que nao existe"
                                % (e["linha"], os.path.relpath(alvo, RAIZ))))
                        elif not protegido_contra_queda(alvo):
                            reprova(nome, "R-G", (
                                "esta unit mascara exit 1, mas `%s` (ExecStart da linha %d) "
                                "nao traduz QUEDA em exit >= 2: uma excecao nao tratada sai 1, "
                                "a mascara a converte em Result=success e o OnFailure nunca "
                                "dispara. Use tools/lib/saida_de_medidor.py (main_protegido) "
                                "ou tools/lib/saida_de_medidor.sh."
                                % (os.path.relpath(alvo, RAIZ), e["linha"])))

    sem_onfailure = [n for n in exigem if n not in com_onfailure]
    veredito = "FAIL" if problemas else "OK"

    if args.json:
        print(json.dumps({
            "gate": "check-units-alarme",
            "raiz": RAIZ,
            "veredito": veredito,
            # Valor absoluto com denominador ao lado, sempre: percentagem sobre
            # denominador movel ja mentiu neste repo (cobertura "caiu" de 72,01%
            # para 70,39% enquanto o numerador SUBIA 125 URLs).
            "units_service_total": len(arquivos),
            "exigem_onfailure": len(exigem),
            "com_onfailure_real": len([n for n in exigem if n in com_onfailure]),
            "sem_onfailure": sem_onfailure,
            "isentas": isentas,
            "mascaras_successexitstatus": mascaras,
            "problemas": problemas,
        }, ensure_ascii=False, indent=2, sort_keys=True))
        return 1 if problemas else 0

    print(f"units .service: {len(arquivos)} · exigem OnFailure: {len(exigem)} · "
          f"com OnFailure real: {len([n for n in exigem if n in com_onfailure])} "
          f"(diretiva ancorada, comentario NAO conta)")
    print(f"isentas: {len(isentas)} (template, daemon com Restart=, suporte sem timer)")
    justificadas = len([m for m in mascaras if m["justificada"]])
    print(f"SuccessExitStatus: {len(mascaras)} unit(s) mascaram exit · "
          f"{justificadas} com razao registrada ao lado")

    if problemas:
        print("\ncheck-units-alarme: FAIL")
        for p in problemas:
            print(f"  - [{p['regra']}] {p['unit']}")
            print(f"      {p['detalhe']}")
        print("\n  Unit de vigia, medicao ou publicacao sem aviso e decoracao: ela")
        print("  falha, o journal registra, e o dono descobre dias depois pelo dano.")
        return 1

    print("\ncheck-units-alarme: OK (toda unit agendada avisa o dono ao falhar; "
          "toda mascara tem razao registrada)")
    return 0


if __name__ == "__main__":
    # PROTECAO CRASH->2 (2026-09-16). Sem ela, uma excecao nao tratada faz o
    # interpretador sair com 1 — o MESMO codigo que esta ferramenta usa para
    # "medi e esta degradado". A unit que a chama mascara o 1
    # (`SuccessExitStatus=0 1`), entao a queda virava `Result=success` e o
    # `OnFailure` nunca disparava: instrumento quebrado indistinguivel de
    # instrumento que disse "esta tudo bem". Ver tools/lib/saida_de_medidor.py.
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
    from saida_de_medidor import main_protegido

    main_protegido(main)
