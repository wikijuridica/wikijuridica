#
# Por que a lista e' curta e tem de continuar curta: cada entrada aqui e' uma
# unit que o systemd nunca vai marcar como `failed`, entao o unico aviso que
# existe e' o detector. Entrada sem detector vivo e' silencio com aparencia de
# cobertura.
DETECTORES_NOMEADOS = {
    # Restart=always + RestartSec=15 e nenhum StartLimit* declarado: 5 partidas
    # levam 60 s contra a janela de 10 s do manager, entao o burst nunca e
    # atingido e o OnFailure da unit nunca dispara. O cerebro PROCESSA (nao
