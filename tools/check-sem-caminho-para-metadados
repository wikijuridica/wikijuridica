#!/usr/bin/env python3
"""check-sem-caminho-para-metadados — o portal não pode virar proxy de SSRF.

READ-ONLY. Sai != 0 quando o código de produção ganha (a) um endpoint que busca
URL fornecida pelo cliente, ou (b) qualquer referência a endereço de metadados de
nuvem.

POR QUE ELE EXISTE — há um scanner ativo procurando exatamente isso.

Medido em `/var/log/nginx/wikijuridica/access.log` em 2026-08-26: **49 requisições
de um único IP** (34.125.61.17) varrendo **14 rotas de proxy por dicionário** —
`/fetch`, `/api/fetch`, `/proxy`, `/api/proxy`, `/redirect`, `/webhook`,
`/api/webhook`, `/preview`, `/api/preview`, `/screenshot`, `/image`,
`/api/image`, `/api/v1/fetch`, `/api/download` — todas com a mesma carga:

    /fetch?url=http://169.254.169.254/latest/meta-data/iam/security-credentials/

`169.254.169.254` é o endereço de metadados de instância de nuvem. Quem consegue
fazer um servidor buscá-lo por fora recebe as credenciais da máquina. Não é abuso
de rate limit: é tentativa de roubo de credencial.

O ESTADO HOJE É LIMPO, E É ISSO QUE ESTE GATE PROTEGE. As 49 tentativas
receberam 404 porque nenhuma dessas rotas existe, e `grep` por `169.254` em
`internal/` e `cmd/` devolve zero. O portal não busca URL que o cliente escolhe —
ele serve o que já publicou. Um gate que só reprovasse depois do dano seria
inútil; este existe para que a próxima rota de "preview" ou "webhook" não nasça
sem alguém decidir isso conscientemente.

O AGRAVANTE QUE ESTE GATE **NÃO** RESOLVE, e por isso fica escrito aqui: **27 das
49 requisições foram registradas com `allow=1`** — pista de rate limit ilimitada —
porque o scanner forjou User-Agent de bot valioso, inclusive `ClaudeBot`. O
allowlist do nginx decide por User-Agent cru, sem verificar identidade. Isso é
outra frente (verificação por faixa de IP publicada e por Web Bot Auth), e o
número acima é a evidência de que ela não é teórica.

COMO A DETECÇÃO É FEITA, e por que não é grep de palavra solta: procura-se por
requisição HTTP de saída cujo destino venha de entrada do cliente. Referência a
`169.254` em teste, em documentação ou numa lista de bloqueio é legítima e não
reprova — o que reprova é o código de produção poder alcançá-lo.
"""

import argparse
import os
import re
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
ARVORES = ("internal", "cmd")

# Endereços de metadados de instância das três nuvens grandes, mais o nome DNS
# que a Google aceita. São endereços de infraestrutura, não conteúdo — nenhum
# código deste portal tem motivo para citá-los fora de uma lista de bloqueio.
METADADOS = (
    "169.254.169.254",      # AWS IMDS, Azure IMDS, GCP (por IP)
    "metadata.google.internal",
    "instance-data",        # alias histórico da AWS
    "100.100.100.200",      # Alibaba
)

# Uma requisição de saída cujo alvo é montado a partir de valor vindo do cliente.
# É a forma que transforma um servidor em proxy: quem escolhe o destino é quem
# manda a query string.
SAIDA_COM_ALVO_DO_CLIENTE = re.compile(
    r"http\.(Get|Head|Post)\s*\(\s*(r\.URL\.Query\(\)|r\.FormValue|req\.URL\.Query\(\))")


def arquivos_go():
    for arvore in ARVORES:
        base = os.path.join(RAIZ, arvore)
        for raiz, _dirs, nomes in os.walk(base):
            for nome in nomes:
                if nome.endswith(".go") and not nome.endswith("_test.go"):
                    yield os.path.join(raiz, nome)


def main() -> int:
    argparse.ArgumentParser().parse_args()

    achados_metadados: list[str] = []
    achados_proxy: list[str] = []
    lidos = 0
    for caminho in arquivos_go():
        lidos += 1
        try:
            with open(caminho, encoding="utf-8") as f:
                texto = f.read()
        except OSError:
            continue
        rel = os.path.relpath(caminho, RAIZ)
        for numero, linha in enumerate(texto.split("\n"), 1):
            # Comentário que cita o endereço para EXPLICAR o bloqueio é legítimo:
            # este próprio gate precisa nomeá-lo para ser compreensível.
            despido = linha.strip()
            if despido.startswith("//"):
                continue
            for alvo in METADADOS:
                if alvo in linha:
                    achados_metadados.append(f"{rel}:{numero}: {despido[:90]}")
            if SAIDA_COM_ALVO_DO_CLIENTE.search(linha):
                achados_proxy.append(f"{rel}:{numero}: {despido[:90]}")

    print(f"arquivos Go de producao lidos: {lidos}")
    if not achados_metadados and not achados_proxy:
        print("check-sem-caminho-para-metadados: OK")
        print("  nenhum endereco de metadados de nuvem e nenhuma requisicao de saida com")
        print("  destino escolhido pelo cliente. O scanner que varre /fetch, /proxy e")
        print("  /webhook continua recebendo 404 porque essas rotas nao existem.")
        return 0

    print("check-sem-caminho-para-metadados: FAIL")
    if achados_proxy:
        print(f"  - {len(achados_proxy)} requisicao(oes) de saida cujo DESTINO vem do cliente.")
        print("    E a forma que transforma o portal em proxy: quem manda a query string")
        print("    escolhe o que o servidor vai buscar, e ha scanner ativo procurando isso.")
        for a in achados_proxy[:5]:
            print(f"      {a}")
    if achados_metadados:
        print(f"  - {len(achados_metadados)} referencia(s) a endereco de metadados de nuvem em")
        print("    codigo de producao. Credencial de instancia vive nesses enderecos:")
        for a in achados_metadados[:5]:
            print(f"      {a}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
