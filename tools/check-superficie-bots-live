             "veredito": {"aprovado": aprovado, **avaliacao}}, ensure_ascii=False) + "\n")
    print(f"gravado em {SAIDA} sob o rotulo {args.gravar!r}")
    return 0 if aprovado else 1


if __name__ == "__main__":
