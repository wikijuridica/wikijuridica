                "ferramenta": "tools/check-superficie-bots-live",
                "started_at": inicio,
                "finished_at": datetime.now(timezone.utc).isoformat(),
                "urls": len(linhas),
                "status": por_status,
                "user_agent": UA,
                "warming_header": True,
                "counts_as_audience": False,
                "motivo": "sonda de auditoria da superficie de bots; atravessa a borda e "
                          "por isso precisa ser descontada de organic_requests",
            }, ensure_ascii=False) + "\n")

    avaliacao = avaliar_divergencias(linhas, camadas)
    aprovado = not avaliacao["divergencias"]

    if args.json:
        print(json.dumps({"medido_em": agora, "sondas": linhas,
                          "veredito": {"aprovado": aprovado, **avaliacao}},
                         ensure_ascii=False, indent=1))
    else:
        cab = f"{'ROTA':<46} {'ACCEPT':<14}"
        for c in camadas:
            cab += f" {c:<22}"
        print(cab)
        print("-" * len(cab))
        for reg in linhas:
            linha = f"{reg['rota']:<46} {(reg['accept'] or '-'):<14}"
            for c in camadas:
                d = reg[c]
                linha += f" {d['status']:>3} {d['tipo'][:11]:<11} {d['bytes']:>6}"
            print(linha)
        print()
        print(f"medido em {agora} · UA={UA} · X-Warming-Request: true (fora de organic_requests)")

        if avaliacao["avisos_drift"]:
            print("\navisos de desatualização de baseline ('hoje' cujo valor mudou — "
                  "atualizar a tabela SONDAS ou investigar, não é reprovação):")
            for a in avaliacao["avisos_drift"]:
                print(f"  {a['rota']:<46} [{a['camada']}] documentado={a['baseline_documentada']} "
                      f"agora={a['obtido_agora']}")

        print()
        if aprovado:
            print("VEREDITO: aprovado — nenhuma expectativa firme divergiu.")
        else:
            print("VEREDITO: REPROVADO — divergências de expectativa firme:")
            for d in avaliacao["divergencias"]:
                extra = f" tipo={d['tipo_obtido']}" if "tipo_obtido" in d else ""
                print(f"  {d['rota']:<46} [{d['camada']}] achado={d['achado']} "
                      f"esperado={d['esperado']} obtido={d['obtido']}{extra}")

    # GRAVAÇÃO INCONDICIONAL desde 2026-09-03. Até aqui `--gravar` era opt-in e
    # sem ninguém lembrar da flag o ledger emudecia — medido: última linha em
    # 2026-08-26T16:45, dez dias parado, apesar de o PLANO_SUPERFICIE_BOTS
    # exigir medição ANTES/DEPOIS de toda tarefa. Toda execução grava agora,
    # com rótulo "auto" quando `--gravar` não é passado.
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
