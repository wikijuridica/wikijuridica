def _montar_comando(base: str, rota: str, accept: str | None, camada: str) -> list[str]:
    """Monta o argv do curl. Pura (sem rede), extraida de `_sonda_uma_vez` em
    2026-09-03 para o teste confirmar sem duvida que o UA e SEMPRE `UA`
    (wikijuridica-superficie-probe/1.0) nas TRES camadas, inclusive borda —
    esta ferramenta nunca vestiu identidade de bot real; a tabela SONDAS
    varia por ROTA, nunca por perfil de bot."""
    cmd = [
        "curl", "-sS", "-o", "/dev/null", "--max-time", "12",
        "-A", UA, "-H", "X-Warming-Request: true",
        "-w", "%{http_code}\t%{content_type}\t%{size_download}\t%{time_total}",
    ]
    if camada != "borda":
        cmd += ["-H", f"Host: {HOST}"]
    if accept:
        cmd += ["-H", f"Accept: {accept}"]
    cmd.append(base + rota)
    return cmd


def _sonda_uma_vez(base: str, rota: str, accept: str | None, camada: str) -> dict:
    cmd = _montar_comando(base, rota, accept, camada)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        partes = (r.stdout or "").strip().split("\t")
        if len(partes) < 4:
            return {"status": "ERRO", "tipo": (r.stderr or "")[:60], "bytes": 0, "ms": 0}
        return {
            "status": partes[0],
            "tipo": (partes[1] or "").split(";")[0],
            "bytes": int(partes[2] or 0),
            "ms": round(float(partes[3] or 0) * 1000),
        }
    except Exception as e:
        return {"status": "ERRO", "tipo": str(e)[:60], "bytes": 0, "ms": 0}


def sonda(base: str, rota: str, accept: str | None, camada: str) -> dict:
    """Uma repetição em caso de ERRO de transporte (timeout/conexão) antes de
    registrar o resultado — de-flake de falha transitória de curl, nunca de
    resultado HTTP válido (um 404/500 real não é reexecutado)."""
    resultado = _sonda_uma_vez(base, rota, accept, camada)
    if resultado["status"] == "ERRO":
        resultado = _sonda_uma_vez(base, rota, accept, camada)
    return resultado


def parse_esperado(raw: str) -> dict:
    """Decompõe o campo `esperado` de uma sonda em critério de veredito.

    Ver docstring do módulo (VEREDITO) para a semântica de "hoje" — estado
    documentado, nunca meta a impor."""
    tokens = (raw or "").split()
    hoje = "hoje" in tokens
    status = tokens[0] if tokens and tokens[0].isdigit() and len(tokens[0]) == 3 else None
    precisa_markdown = "md" in tokens
    return {
        "hoje": hoje,
        "status_esperado": status,
        "enforced": bool(status) and not hoje,
        "precisa_markdown": precisa_markdown and not hoje,
    }


def avaliar_divergencias(linhas: list[dict], camadas: list[str]) -> dict:
    """Confere cada sonda contra o seu `esperado`, camada por camada.

    Retorna divergências REAIS (reprovam) separadas de avisos de
    desatualização de baseline "hoje" (nunca reprovam, só sinalizam)."""
    divergencias = []
    avisos_drift = []
    for reg in linhas:
        criterio = parse_esperado(reg.get("esperado", ""))
        for camada in camadas:
            dado = reg.get(camada)
            if not dado:
                continue
            obtido = str(dado.get("status"))
            if criterio["enforced"]:
                if obtido != criterio["status_esperado"]:
                    divergencias.append({
                        "rota": reg["rota"], "accept": reg.get("accept"),
                        "achado": reg.get("achado"), "camada": camada,
                        "esperado": criterio["status_esperado"], "obtido": obtido,
                        "tipo_obtido": dado.get("tipo"),
                    })
                elif criterio["precisa_markdown"]:
                    tipo = (dado.get("tipo") or "")
                    if not tipo.startswith("text/markdown"):
                        divergencias.append({
                            "rota": reg["rota"], "accept": reg.get("accept"),
                            "achado": reg.get("achado"), "camada": camada,
                            "esperado": "text/markdown (Content-Type)",
                            "obtido": tipo or "(vazio)",
                        })
            elif criterio["status_esperado"] is not None and obtido != criterio["status_esperado"]:
                # "404 hoje" (ou similar) cujo valor atual mudou: pode ser
                # boa notícia (capacidade nova) ou regressão de outra
                # natureza — não é este script que decide qual, só avisa.
                avisos_drift.append({
                    "rota": reg["rota"], "camada": camada,
                    "baseline_documentada": criterio["status_esperado"],
                    "obtido_agora": obtido,
                })
    return {"divergencias": divergencias, "avisos_drift": avisos_drift}


def main() -> int:
    p = argparse.ArgumentParser()
