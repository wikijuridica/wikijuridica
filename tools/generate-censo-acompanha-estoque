#!/usr/bin/env python3
"""generate-censo-acompanha-estoque — confere se o censo acompanha o estoque v2
e, quando não acompanha, REGENERA.

★ POR QUE ESTE ARQUIVO EXISTE (2026-08-29).

A capacidade era do `tools/check-censo-acompanha-estoque`, atrás de uma flag
`--regenerar` criada por ordem do dono em 2026-08-27. A capacidade é útil e
continua aqui inteira; o que estava errado era o LUGAR.

O contrato do repositório separa os papéis: `tools/check-*` é READ-ONLY,
`tools/generate-*` escreve, e misturar os dois num arquivo só é bug. A razão é
concreta: um check que escreve pode ser chamado por qualquer gatilho de leitura
— uma varredura da bateria, um pre-voo, um agente conferindo estado — e mutar o
repositório sem que ninguém tenha pedido.

O achado veio do detector de `TestCheckWrappersDoNotGenerateTrackedArtifacts`,
que mantinha este caso escondido atrás de 188 falsos positivos: ele parava no
primeiro nome em ordem alfabética, e o primeiro era falso.

USO
    tools/generate-censo-acompanha-estoque          confere e regenera se preciso
    tools/generate-censo-acompanha-estoque --seco   só diz o que faria

O `--seco` existe pelo mesmo motivo que em todo gerador deste repositório: hoje
mesmo, um gerador de documento ia reescrever 118 linhas e destruir narrativa, e
o modo seco pegou antes.
"""
import os
import subprocess
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHECK = os.path.join(RAIZ, "tools", "check-censo-acompanha-estoque")
GERADOR = os.path.join(RAIZ, "tools", "generate-v2-publication-severity")


def main():
    seco = "--seco" in sys.argv or "--dry-run" in sys.argv

    # A conferência é DELEGADA ao check, não reimplementada. Duas cópias da
    # mesma regra divergem — e divergência silenciosa entre gate e gerador é o
    # defeito que este repositório já pagou várias vezes.
    conferencia = subprocess.run([sys.executable, CHECK], check=False)
    if conferencia.returncode == 0:
        print("censo em dia — nada a regenerar")
        return 0
    if conferencia.returncode != 1:
        print("o check falhou por outro motivo (exit %d); nao regenero as cegas"
              % conferencia.returncode, file=sys.stderr)
        return conferencia.returncode

    if seco:
        print("--seco: o censo seria regenerado por %s --write" % GERADOR)
        return 0

    print("\nregenerando o censo (%s --write)..." % GERADOR)
    resultado = subprocess.run(["nice", "-n", "19", sys.executable, GERADOR, "--write"],
                               check=False)
    if resultado.returncode != 0:
        print("o gerador do censo falhou (exit %d)" % resultado.returncode, file=sys.stderr)
        return 1

    # Reconfere: gerador que diz ter escrito e nao fecha o gate e pior que
    # gerador que falha, porque o operador segue achando que resolveu.
    if subprocess.run([sys.executable, CHECK], check=False).returncode != 0:
        print("o censo foi regenerado e o check CONTINUA reprovando — nao publique",
              file=sys.stderr)
        return 1
    print("censo regenerado e conferido — pode publicar")
    return 0


if __name__ == "__main__":
    sys.exit(main())
