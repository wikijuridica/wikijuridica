#!/usr/bin/env bash
# check-validator-attestation — o atestado gravado ainda descreve o grafo real?
#
# POR QUE EXISTE. `internal/v2ingest` guarda numa constante Go o sha256 do grafo
# de fonte do validador, e `ingest-v2-stock` RECUSA publicar quando a constante
# nao bate com o grafo. A recusa esta certa — e o que impede um binario antigo
# alegar o hash dos fontes novos —, mas ela so acontece DENTRO do deploy, depois
# de compilar, e a mensagem e uma linha de hashes.
#
# Custou quatro vezes: eedb3edf, 896d83ae, 612b687c e 63ed4b2d sao todos o mesmo
# incidente — alguem tocou o grafo, ninguem rodou `go generate`, e o deploy
# seguinte morreu no meio. Nao e descuido de uma pessoa: e um passo manual que
# nada cobra ate ser tarde.
#
# Este check antecipa a cobranca e diz o remedio. E READ-ONLY por construcao: o
# gerador escreve num arquivo temporario e a comparacao e por conteudo — nada no
# repositorio e tocado, nem em caso de divergencia.
#
# Uso: ./tools/check-validator-attestation
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

# O caminho do arquivo gravado e sobrescrivivel SO para que este check possa ser
# provado contra um atestado adulterado sem tocar o repositorio. Detector que
# nunca foi visto reprovando e alegacao, nao prova — e ja houve detector nesta
# casa que acusou 46 paginas sendo que as 46 eram falso positivo.
GRAVADO=${WIKI_ATESTADO_GRAVADO:-internal/v2ingest/validator_fingerprint_attestation_generated.go}
if [[ ! -f $GRAVADO ]]; then
	echo "REPROVADO: $GRAVADO nao existe" >&2
	exit 1
fi

TEMP=$(mktemp -t validator-attestation.XXXXXX.go) || exit 1
trap 'rm -f "$TEMP"' EXIT INT TERM

# -root . porque aqui o cwd e a raiz do repo; o `go:generate` usa `../..` porque
# roda de dentro de internal/v2ingest. Trocar um pelo outro faz o gerador
# fingerprintar a arvore errada e "passar" contra o grafo de outro lugar.
if ! saida=$(./tools/go-modern run ./internal/v2ingest/cmd/generate-validator-fingerprint-attestation \
	-root . -output "$TEMP" 2>&1); then
	echo "REPROVADO: o gerador do atestado falhou" >&2
	printf '%s\n' "$saida" | sed 's/^/  /' >&2
	exit 1
fi

if cmp -s "$TEMP" "$GRAVADO"; then
	echo "OK: o atestado do validador descreve o grafo de fonte atual"
	grep -o 'sha256:[0-9a-f]\{64\}' "$GRAVADO" | sed 's/^/  /'
	exit 0
fi

echo "REPROVADO: o atestado gravado NAO descreve o grafo de fonte atual." >&2
echo "  gravado: $(grep -o 'sha256:[0-9a-f]\{64\}' "$GRAVADO" | head -1)" >&2
echo "  grafo  : $(grep -o 'sha256:[0-9a-f]\{64\}' "$TEMP" | head -1)" >&2
echo "" >&2
echo "  Alguem mudou o codigo do validador (internal/v2ingest, cmd/ingest-v2-stock," >&2
echo "  go.mod ou go.sum) sem reatestar. Enquanto isso durar, NENHUM deploy passa:" >&2
echo "  ingest-v2-stock recusa publicar e o acervo fica preso na versao anterior." >&2
echo "" >&2
echo "  Remedio, uma linha:" >&2
echo "      ./tools/go-modern generate ./internal/v2ingest" >&2
echo "  e commitar $GRAVADO (o commit toca Go: serialize com flock)." >&2
exit 1
