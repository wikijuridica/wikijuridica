#!/usr/bin/env python3
"""check-cadeia-editorial-ordem-declarada — todo detector `older_than` tem de
estar documentado em docs/CADEIA_EDITORIAL_ORDEM_DE_REGENERACAO.md.

POR QUE EXISTE (2026-09-08): a ordem de regeneracao dos derivados de
`data/editorial/` vivia implicita nos detectores de mtime — nenhum documento
listava os cinco `older_than` existentes nem a ordem que eles impoem, e a
fabrica ja ficou 31 dias parada por regenerar fora dessa ordem nao-escrita.
`docs/CADEIA_EDITORIAL_ORDEM_DE_REGENERACAO.md` agora declara essa ordem, com
um bloco legivel por maquina (`<!-- cadeia:detectores -->`) listando cada
detector como `arquivo:funcao`. Este gate prova que a lista NAO FICA PRA TRAS
do codigo: ele re-executa a mesma descoberta (`grep -rn "older_than" internal/
--include=*.go`, resolvendo cada acerto para a funcao que o contem) e reprova,
nomeando `arquivo:linha` (funcao=X), qualquer detector que exista no codigo e
NAO esteja no documento — o "detector orfao" que motivou esta tarefa.

Nao verifica o inverso (entrada no documento que sumiu do codigo) porque isso
e historico legitimo do documento, nao um risco de regeneracao fora de ordem.

READ-ONLY.

Uso:
    tools/check-cadeia-editorial-ordem-declarada
    tools/check-cadeia-editorial-ordem-declarada --json
    tools/check-cadeia-editorial-ordem-declarada --doc /caminho --internal-dir /caminho
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
DOC_PADRAO = os.path.join(ROOT, "docs", "CADEIA_EDITORIAL_ORDEM_DE_REGENERACAO.md")
INTERNAL_PADRAO = os.path.join(ROOT, "internal")

INICIO_BLOCO = "<!-- cadeia:detectores -->"
FIM_BLOCO = "<!-- /cadeia:detectores -->"
FUNC_RE = re.compile(r"^func\s+(\w+)\s*\(")


def achar_detectores_no_codigo(internal_dir: str) -> list[tuple[str, int, str]]:
    """[(caminho_relativo_a_ROOT, linha, funcao)] de cada `older_than` vivo.

    Exclui _test.go (o proprio grep do enunciado tambem exclui, por
    --include=*.go nao filtrar _test.go explicitamente, mas nenhum teste
    hoje contem a string — filtramos aqui para nao depender disso ficar
    verdade para sempre)."""
    resultado = subprocess.run(
        ["grep", "-rn", "older_than", internal_dir, "--include=*.go"],
        capture_output=True, text=True)
    # grep devolve exit 1 quando NAO acha nada -- nao e erro de execucao.
    if resultado.returncode not in (0, 1):
        raise SystemExit(
            f"check-cadeia-editorial-ordem-declarada: grep falhou (exit "
            f"{resultado.returncode}): {resultado.stderr}")
    achados: list[tuple[str, int, str]] = []
    for linha_saida in resultado.stdout.splitlines():
        if not linha_saida.strip():
            continue
        caminho, resto = linha_saida.split(":", 1)
        numero_texto, _ = resto.split(":", 1)
        if caminho.endswith("_test.go"):
            continue
        numero = int(numero_texto)
        funcao = achar_funcao_envolvente(caminho, numero)
        caminho_rel = os.path.relpath(os.path.abspath(caminho), ROOT)
        achados.append((caminho_rel, numero, funcao))
    return achados


def achar_funcao_envolvente(caminho: str, numero_linha: int) -> str | None:
    """Sobe da linha do achado ate a declaracao `func Nome(` mais proxima."""
    try:
        with open(caminho, encoding="utf-8") as handle:
            linhas = handle.readlines()
    except OSError:
        return None
    for indice in range(min(numero_linha, len(linhas)) - 1, -1, -1):
        casamento = FUNC_RE.match(linhas[indice])
        if casamento:
            return casamento.group(1)
    return None


def ler_bloco_declarado(caminho_doc: str) -> set[tuple[str, str]]:
    """{(caminho_relativo, funcao)} declarados no bloco maquina do documento.

    O marcador so conta quando esta SOZINHO na linha (apos strip) -- uma
    mencao em prosa ao texto do marcador (ex.: para explicar o formato) nao
    pode ser confundida com o delimitador real do bloco. Foi exatamente essa
    armadilha que a primeira versao deste parser caiu: `str.find()` cru
    achava a PRIMEIRA ocorrencia da string, que era uma mencao em texto
    corrido antes do bloco de verdade, e o bloco lido ficava vazio/errado.
    """
    if not os.path.isfile(caminho_doc):
        raise SystemExit(
            f"check-cadeia-editorial-ordem-declarada: documento ausente: {caminho_doc}")
    with open(caminho_doc, encoding="utf-8") as handle:
        linhas_doc = handle.readlines()
    indice_inicio = next(
        (i for i, linha in enumerate(linhas_doc) if linha.strip() == INICIO_BLOCO), None)
    indice_fim = next(
        (i for i, linha in enumerate(linhas_doc) if linha.strip() == FIM_BLOCO), None)
    if indice_inicio is None or indice_fim is None or indice_fim <= indice_inicio:
        raise SystemExit(
            "check-cadeia-editorial-ordem-declarada: bloco "
            f"{INICIO_BLOCO} ... {FIM_BLOCO} ausente ou malformado (cada marcador "
            f"tem de estar sozinho em sua propria linha) em {caminho_doc}")
    declarados: set[tuple[str, str]] = set()
    for linha in linhas_doc[indice_inicio + 1:indice_fim]:
        linha = linha.strip()
        if not linha or ":" not in linha:
            continue
        caminho, funcao = linha.rsplit(":", 1)
        declarados.add((caminho.strip(), funcao.strip()))
    return declarados


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--doc", default=DOC_PADRAO,
                         help="documento com o bloco <!-- cadeia:detectores --> (default: docs/CADEIA_EDITORIAL_ORDEM_DE_REGENERACAO.md)")
    parser.add_argument("--internal-dir", default=INTERNAL_PADRAO,
                         help="raiz onde procurar os detectores older_than (default: internal/)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    achados = achar_detectores_no_codigo(args.internal_dir)
    declarados = ler_bloco_declarado(args.doc)

    orfaos = []
    for caminho_rel, numero, funcao in achados:
        chave = (caminho_rel, funcao or "")
        if funcao is None:
            orfaos.append({
                "caminho": caminho_rel, "linha": numero, "funcao": None,
                "motivo": "nao foi possivel resolver a funcao envolvente (func nao encontrado acima)",
            })
            continue
        if chave not in declarados:
            orfaos.append({
                "caminho": caminho_rel, "linha": numero, "funcao": funcao,
                "motivo": "detector older_than nao declarado no documento",
            })

    ok = not orfaos

    if args.json:
        print(json.dumps({
            "ok": ok,
            "detectores_no_codigo": len(achados),
            "detectores_declarados": len(declarados),
            "orfaos": orfaos,
        }, ensure_ascii=False, sort_keys=True))

    if ok:
        print(f"check-cadeia-editorial-ordem-declarada: pass — {len(achados)} detector(es) "
              f"older_than no codigo, todos declarados em {os.path.relpath(args.doc, ROOT)}")
        return 0

    print("check-cadeia-editorial-ordem-declarada: FAIL", file=sys.stderr)
    for item in orfaos:
        print(f"  - {item['caminho']}:{item['linha']} (funcao={item['funcao']}): {item['motivo']}",
              file=sys.stderr)
    print("\n  Detector novo de mtime/older_than exige atualizar o documento da cadeia —",
          file=sys.stderr)
    print("  sem isso, ninguem sabe em que ordem regenerar antes que 'fingerprint mismatch'",
          file=sys.stderr)
    print("  pare a fabrica de novo.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
