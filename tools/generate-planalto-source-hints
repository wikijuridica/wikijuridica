#!/usr/bin/env python3
"""generate-planalto-source-hints — resolve source_hints de norma federal em URL oficial.

POR QUE EXISTE (medido em 2026-07-29): o portfolio faz 17.514 referencias a
source_hints; 6.824 chaves DISTINTAS (11.472 ocorrencias) nao existem em
data/editorial/v2_source_hint_catalog.json. Isso trava a fabrica inteira: quando
UM hint nao resolve, derive_writing_source_resolution reclassifica a intencao como
"strict" e ZERA os overrides ja resolvidos, e o CAS passa a aceitar SOMENTE
tombstone. Redatores escreveram paginas completas, com fonte pesquisada e
verificada por curl, e foram forcados a grava-las como tombstone.

A CLASSIFICACAO que justifica esta ferramenta (medida, nao suposta):
    codigos (CDC/CC/CP/CPC/CLT/CTN)  1.442 chaves / 2.500 ocorrencias
    lei federal em texto livre       1.002 / 1.666
    lei federal em slug                567 / 1.095
    CF e emendas constitucionais       254 /   434
    decreto                            129 /   226
    -------------------------------------------------
    derivavel por regra              3.394 / 5.921  (mais da metade)
O resto — "leis-estaduais-itcmd", "detrans-estaduais", "anatel", "mec",
"Policia Federal" — sao referencias GENERICAS a orgao, nao a norma. Pelo contrato
do projeto homepage e listagem NAO servem como fonte: essas exigem curadoria
editorial ou remocao do portfolio, e esta ferramenta deliberadamente NAO as
inventa.

POR QUE GERADOR E NAO AGENTE: 5.921 ocorrencias resolvidas por FORMULA nao sao
trabalho de julgamento. Agente e para onde ha decisao editorial. Usar agente aqui
seria caro, lento e menos reprodutivel.

VERIFICACAO OBRIGATORIA: a URL do Planalto varia por epoca e por variante —
  leis/l8078compilado.htm            (pre-2000, sem diretorio de ano)
  leis/2003/l10.741compilado.htm     (anos 2000, com PONTO no numero)
  _ato2015-2018/2018/lei/l13786.htm  (2011+, diretorio de quadrienio)
  leis/2002/l10406compilada.htm      (compilada, no feminino)
  decreto-lei/del5452compilado.htm   (decreto-lei)
  constituicao/emendas/emc/emc132.htm (emenda constitucional)
Por isso a ferramenta GERA CANDIDATOS e so aceita o que responder 200 numa
requisicao de metadado. NUNCA registra URL nao verificada — inventar fonte e
fraude, e e o pior erro possivel neste projeto.

RESPEITO AO HOST: 2 requisicoes por segundo por padrao, User-Agent proprio e
identificavel, HEAD antes de GET. O Planalto e servico publico; nao se martela.

Uso:
  tools/generate-planalto-source-hints --dry-run           # so relata o que resolveria
  tools/generate-planalto-source-hints --apply             # escreve no catalogo
  tools/generate-planalto-source-hints --limit 200         # bounded
"""
import argparse
import collections
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CATALOG = os.path.join(ROOT, "data/editorial/v2_source_hint_catalog.json")
PORTFOLIO = os.path.join(ROOT, "data/editorial/portfolio_v2/*.jsonl")
UA = "Mozilla/5.0 WikiJuridicaV2SourceProvenance/1.0 metadata-only no-content-copy"

# Codigos com numero e ano conhecidos: o hint costuma cita-los pela sigla.
CODIGOS = {
    "cdc": ("8078", 1990, "Código de Defesa do Consumidor (Lei 8.078/1990)"),
    "cc": ("10406", 2002, "Código Civil (Lei 10.406/2002)"),
    "cp": ("2848", 1940, "Código Penal (Decreto-Lei 2.848/1940)"),
    "cpc": ("13105", 2015, "Código de Processo Civil (Lei 13.105/2015)"),
    "clt": ("5452", 1943, "Consolidação das Leis do Trabalho (Decreto-Lei 5.452/1943)"),
    "ctn": ("5172", 1966, "Código Tributário Nacional (Lei 5.172/1966)"),
    "ctb": ("9503", 1997, "Código de Trânsito Brasileiro (Lei 9.503/1997)"),
    "cf": (None, 1988, "Constituição Federal de 1988"),
}


def fold(text):
    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode().lower()


def parse_hint(hint):
    """Extrai (especie, numero, ano) de um hint. Devolve None quando nao e norma federal."""
    flat = fold(hint)
    # Emenda constitucional: "EC 132/2023", "ec-132-2023", "emenda-103-2019"
    match = re.search(r"\b(?:ec|emenda(?:[- ]constitucional)?)[- ]?n?o?\.?\s*(\d{1,3})[/-](\d{4})", flat)
    if match:
        return ("emenda", match.group(1), int(match.group(2)))
    # Constituicao sem numero
    if re.search(r"\b(cf|constituicao)\b", flat) and not re.search(r"\d{4,}", flat):
        return ("constituicao", None, 1988)
    # Codigo por sigla, sem numero explicito: "CDC art. 51", "cdc", "CLT art. 3o".
    # Ordem por sigla mais longa primeiro: "cpc" nao pode ser capturado por "cp".
    # CLT e CP sao DECRETO-LEI, nao lei ordinaria — errar a especie manda a
    # derivacao para /leis/ e nenhum candidato responde 200 (foi o caso real de
    # "CLT art. 3o" no primeiro ensaio).
    decreto_lei = {"clt", "cp"}
    for sigla in sorted(CODIGOS, key=len, reverse=True):
        numero, ano, _nome = CODIGOS[sigla]
        if re.match(r"^%s\b" % re.escape(sigla), flat) and not re.search(r"\b\d{4,}\b", flat):
            if sigla == "cf":
                return ("constituicao", None, 1988)
            return ("decreto-lei" if sigla in decreto_lei else "lei", numero, ano)
    # Lei/decreto com numero e ano, em slug ou texto: "lei-8078-1990", "Lei 13.786/2018",
    # "decreto-9580-2018", "Lei nº 8.213/1991"
    match = re.search(r"\b(lei|decreto[- ]lei|decreto|lc|lei[- ]complementar)\b[^0-9]{0,12}"
                      r"(\d{1,3}(?:[.\s]?\d{3})*)\s*[/-]\s*(\d{4})", flat)
    if match:
        especie = match.group(1).replace(" ", "-")
        numero = re.sub(r"[.\s]", "", match.group(2))
        return (especie, numero, int(match.group(3)))
    return None


def candidate_urls(especie, numero, ano):
    """Candidatos por epoca e variante. A ferramenta prova cada um; nao adivinha."""
    base = "https://www.planalto.gov.br/ccivil_03"
    out = []
    if especie == "constituicao":
        return ["%s/constituicao/constituicao.htm" % base]
    if especie == "emenda":
        return ["%s/constituicao/emendas/emc/emc%s.htm" % (base, numero)]
    # numero com ponto de milhar aparece nos anos 2000 (l10.741compilado.htm)
    dotted = numero
    if len(numero) > 3:
        dotted = numero[:-3] + "." + numero[-3:]
    if especie == "decreto-lei":
        for suf in ("compilado", ""):
            out.append("%s/decreto-lei/del%s%s.htm" % (base, numero, suf))
        return out
    if especie in ("lc", "lei-complementar"):
        for suf in ("compilado", ""):
            out.append("%s/leis/lcp/lcp%s%s.htm" % (base, numero, suf))
        return out
    if especie == "decreto":
        # O Planalto guarda decreto em quatro layouts, por epoca, e sempre em
        # MINUSCULO — a variante com maiuscula devolve 301 (medido: D20910 ->
        # 301, d20910 -> 200). Decreto antigo vive em /decreto/antigos/ ou em
        # faixa de decada; a partir de 2011 entra no diretorio de quadrienio.
        if ano >= 2011:
            quad_start = ano - ((ano - 2011) % 4)
            out.append("%s/_ato%d-%d/%d/decreto/d%s.htm" % (
                base, quad_start, quad_start + 3, ano, numero))
        if 2000 <= ano <= 2010:
            # 2000-2010 tambem usa quadrienio (_ato2004-2006/2004/decreto/...),
            # com faixas irregulares antes de 2011; tenta as vizinhas.
            for inicio, fim in ((1999, 2002), (2004, 2006), (2007, 2010), (2003, 2003)):
                if inicio <= ano <= fim:
                    out.append("%s/_ato%d-%d/%d/decreto/d%s.htm" % (
                        base, inicio, fim, ano, numero))
            out.append("%s/decreto/%d/d%s.htm" % (base, ano, numero))
        if ano < 2000:
            decada = ano - (ano % 10)
            out.append("%s/decreto/%d-%d/d%s.htm" % (base, decada, decada + 9, numero))
            out.append("%s/decreto/%d-%d/d%s.htm" % (
                base, decada - (decada % 20), decada - (decada % 20) + 19, numero))
            out.append("%s/decreto/antigos/d%s.htm" % (base, numero))
        out.append("%s/decreto/d%s.htm" % (base, numero))
        return out
    # lei ordinaria
    if ano >= 2011:
        quad_start = ano - ((ano - 2011) % 4)
        quad = "_ato%d-%d" % (quad_start, quad_start + 3)
        for suf in ("", "compilado"):
            out.append("%s/%s/%d/lei/l%s%s.htm" % (base, quad, ano, numero, suf))
    if 2000 <= ano <= 2010:
        for num in (dotted, numero):
            for suf in ("compilado", "compilada", ""):
                out.append("%s/leis/%d/l%s%s.htm" % (base, ano, num, suf))
    if ano < 2000:
        for suf in ("compilado", "compilada", ""):
            out.append("%s/leis/l%s%s.htm" % (base, numero, suf))
    return out


def probe(url, timeout=12):
    """HEAD seguindo redirect; devolve (codigo, url_final).

    O Planalto responde 301 para variantes de caixa (D20910 -> d20910) e para
    layouts antigos. Aceitar so o 200 direto descartaria URL boa; seguir o
    redirect e registrar a URL FINAL e o que mantem o catalogo canonico — o gate
    exige path documental especifico, e a URL final e ela.
    Metadata-only: -I nunca baixa corpo.
    """
    proc = subprocess.run(
        ["curl", "-s", "-o", "/dev/null", "-I", "-L", "-m", str(timeout),
         "-w", "%{http_code} %{url_effective}", "-A", UA, url],
        capture_output=True, text=True)
    partes = (proc.stdout or "").strip().split(None, 1)
    if not partes:
        return "", url
    return partes[0], (partes[1] if len(partes) > 1 else url)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--limit", type=int, default=0)
    parser.add_argument("--rate", type=float, default=2.0, help="requisicoes por segundo")
    args = parser.parse_args()
    if not args.apply and not args.dry_run:
        parser.error("escolha --apply ou --dry-run")

    with open(CATALOG, "rb") as handle:
        catalog_bytes = handle.read()
    # Preimagem CAS: o replace final so acontece se o catalogo em disco for
    # byte-identico ao lido aqui. Sem isso, uma execucao longa (horas de
    # probes) clobberaria em silencio qualquer escrita concorrente (curadoria,
    # reparo de URL) feita no meio — last-writer-wins e perda de trabalho.
    catalog_preimage_sha256 = hashlib.sha256(catalog_bytes).hexdigest()
    catalog = json.loads(catalog_bytes.decode("utf-8"))
    hints = catalog.get("source_hints")
    if hints is None:
        parser.error("catalogo sem chave source_hints — schema mudou, pare e investigue")
    known = set(hints)

    missing = collections.Counter()
    for path in glob.glob(PORTFOLIO):
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except Exception:
                continue
            for hint in (row.get("source_hints") or []):
                if hint not in known:
                    missing[hint] += 1

    # Frequencia primeiro: destrava mais pagina por requisicao gasta.
    alvos = [(h, n) for h, n in missing.most_common() if parse_hint(h)]
    if args.limit:
        alvos = alvos[:args.limit]

    print("hints ausentes: %d distintos / %d ocorrencias" % (len(missing), sum(missing.values())))
    print("parseaveis como norma federal: %d (atacando %d)" % (
        sum(1 for h in missing if parse_hint(h)), len(alvos)))

    resolvidos, falhos = {}, []
    intervalo = 1.0 / args.rate if args.rate > 0 else 0
    for hint, ocorrencias in alvos:
        especie, numero, ano = parse_hint(hint)
        achou = None
        for url in candidate_urls(especie, numero, ano):
            code, final = probe(url)
            if intervalo:
                time.sleep(intervalo)
            if code == "200":
                # Registra a URL FINAL, apos redirect: e ela que o gate valida.
                achou = final
                break
        if achou:
            nome = ("Constituição Federal de 1988" if especie == "constituicao" else
                    "Emenda Constitucional nº %s" % numero if especie == "emenda" else
                    "%s nº %s, de %d" % (especie.replace("-", " ").title(), numero, ano))
            resolvidos[hint] = {
                "name": nome,
                "url": achou,
                # anchor_claim descreve o que a fonte sustenta; aqui e generico e
                # honesto: a norma na integra. Quem cita fecha o recorte na pagina.
                "anchor_claim": "texto oficial vigente da norma no Planalto",
                "source_kind": "legal_act",
            }
            print("  OK   %5dx  %-46s -> %s" % (ocorrencias, hint[:46], achou))
        else:
            falhos.append((hint, ocorrencias))
            print("  FALHA %4dx  %-46s (nenhum candidato respondeu 200)" % (ocorrencias, hint[:46]))

    cobertas = sum(missing[h] for h in resolvidos)
    print("\nresolvidos: %d chaves / %d ocorrencias" % (len(resolvidos), cobertas))
    print("nao resolvidos: %d chaves / %d ocorrencias" % (
        len(falhos), sum(n for _, n in falhos)))

    if args.apply and resolvidos:
        with open(CATALOG, "rb") as handle:
            recheck = hashlib.sha256(handle.read()).hexdigest()
        if recheck != catalog_preimage_sha256:
            print("generate-planalto-source-hints: catalogo mudou durante a "
                  "execucao (outro produtor escreveu). NADA foi gravado — "
                  "re-rode; as URLs ja verificadas saem do cache do probe "
                  "rapidamente.", file=sys.stderr)
            return 3
        hints.update(resolvidos)
        tmp = CATALOG + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(catalog, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp, CATALOG)
        print("catalogo atualizado: %d -> %d chaves" % (len(known), len(hints)))
    elif args.apply:
        print("nada a aplicar")
    return 0


if __name__ == "__main__":
    sys.exit(main())
