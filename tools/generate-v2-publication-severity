# TERCEIRA CLASSE DE ENCODING QUEBRADO: os C1 crus do cp1252 (2026-09-10).
#
# MOJIBAKE_RE pega UTF-8 lido como latin1 ("A©") e o U+FFFD pega o que o
# decodificador desistiu de ler. Nenhum dos dois pega o texto que veio de cp1252
# e ficou com o BYTE C1 no lugar do caractere: U+0096 (travessao), U+0093 e
# U+0094 (aspas curvas), U+0092 (apostrofo). Eles nao desenham NADA no
# navegador, entao o defeito e invisivel na revisao visual e so aparece no byte.
#
# Medido no dia em que esta classe entrou: 145 artigos em 20 arquivos de
# data/legal-corpus/ e SEIS paginas ja publicadas servindo o texto do Codigo
# Penal como "Pena <U+0096> reclusao, de 1 (um) a 5 (cinco) anos" -- para o
# leitor e para o crawler, a pena do artigo aparecia como "Pena  reclusao".
#
# O conserto do DADO e decodificar para o caractere real, nunca apagar o byte:
# apagar deixa a frase mutilada que ja foi ao ar. Este detector so acusa.
#
# C0 legitimo (tab, CR, LF) fica de fora de proposito: texto de lei transcrito
# os usa, e acusa-los reprovaria o acervo inteiro.
MOJIBAKE_C1_RE = re.compile("[\u0080-\u009f]")


def grava_atomico(caminho, escritor):
    """Grava por arquivo temporário + os.replace, nunca truncando o vivo.

    ★ POR QUE (2026-09-16). `open(caminho, "w")` TRUNCA antes de escrever, e
    este censo tem ~5 MB. Quem o lê é `internal/v2publish.LoadSeverity`
    (v2publish.go:239), durante a publicação. Um leitor que pegue o arquivo no
    meio da escrita vê um censo PARCIAL: `SelectPublishable` (v2publish.go:391)
    pula todo intent que faltar com `sem_linha_no_censo`, e o publicador
    REESCREVE o `published_manifest` a partir do que sobrou — exatamente o
    estado que `cmd/publish-v2-direct` documenta como "o servidor não sobe"
    (main.go, bloco do --limit). A janela era pequena e passou a importar
    quando `tools/deploy-publico` passou a regenerar o censo no passo 0.5/7.

    `os.replace` é atômico dentro do mesmo filesystem: o leitor concorrente vê
    o arquivo antigo INTEIRO ou o novo INTEIRO, nunca meio de cada.
    """
    diretorio = os.path.dirname(caminho) or "."
    os.makedirs(diretorio, exist_ok=True)
    temporario = os.path.join(
        diretorio, ".%s.parcial.%d" % (os.path.basename(caminho), os.getpid()))
    modo_anterior = None
    if os.path.exists(caminho):
        modo_anterior = stat.S_IMODE(os.stat(caminho).st_mode)
    try:
        with open(temporario, "w", encoding="utf-8") as handle:
            escritor(handle)
            handle.flush()
            os.fsync(handle.fileno())
        if modo_anterior is not None:
            os.chmod(temporario, modo_anterior)
        os.replace(temporario, caminho)
    except BaseException:
        # Falhou no meio: o parcial não pode ficar no disco com cara de censo.
        # O arquivo vivo continua intocado, que é o ponto desta função.
        if os.path.exists(temporario):
            os.unlink(temporario)
        raise


def read_jsonl(path, key):
    """Indexa um JSONL por uma chave, tolerando linha malformada."""
    index = {}
    if not os.path.exists(path):
        return index
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            value = record.get(key)
            if value:
                index[value] = record
    return index


def visible_text(record):
    """Todo o texto que o visitante lê.

    O FAQ usa as chaves `q` e `a` — NÃO `question`/`answer`. Enquanto esta
    função pediu os nomes longos, ela devolveu string vazia para o FAQ inteiro,
    e todo detector que se apoia nela (promessa de resultado do Provimento OAB
    205/2021, encoding, PT-BR) foi cego a essa parte da página. Uma promessa
    escrita numa resposta de FAQ passaria sem ser vista.
    """
    parts = [
        record.get("title") or "", record.get("meta_description") or "",
        record.get("h1") or "", record.get("opening") or "",
    ]
    for section in record.get("sections") or []:
        parts.append(section.get("heading") or "")
        parts.append(section.get("text") or "")
    for item in record.get("faq") or []:
        parts.append(item.get("q") or "")
        parts.append(item.get("a") or "")
    return "\n".join(parts)


def _tokens(value):
    """Tokenização idêntica à de normalizedWords (internal/v2ingest/validate.go).

    Fold PT-BR (remove acento, minúsculas) e depois tudo que não é letra nem
    dígito separa. `[^\\W_]+` sobre texto sem acento reproduz o critério do Go
    `!unicode.IsLetter(r) && !unicode.IsDigit(r)`, mantendo o underscore como
    separador.
    """
    folded = unicodedata.normalize("NFKD", (value or "").lower())
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return re.findall(r"[^\W_]+", folded, re.UNICODE)


def body_word_count(record):
    """Fórmula do gate: bodyWordCount, internal/v2ingest/validate.go:984.

    O censo contava apenas `opening` + `sections[].text`, com `.split()` sobre o
    texto cru. O gate conta também o HEADING de cada seção e o Q/A de cada item
    de FAQ, tokenizando sobre o texto sem acentos — foi o mesmo erro corrigido
    nos geradores em 3fd10fca, que ficou aqui.

    O efeito da subcontagem não era cosmético: o censo classificava 3.243
    páginas como "corpo entre 250 e 400 palavras" quando a fórmula oficial vê
    1.258, e marcava como CRÍTICAS páginas cujo corpo passa de 250 palavras. A
    priorização de todo o trabalho editorial saía desse número.
    """
    total = len(_tokens(record.get("opening")))
    for section in record.get("sections") or []:
        total += len(_tokens(section.get("heading")))
        total += len(_tokens(section.get("text")))
    for item in record.get("faq") or []:
        total += len(_tokens(item.get("q")))
        total += len(_tokens(item.get("a")))
    return total


# Contextos que INVERTEM o sentido de um padrao de promessa. Sem isto o
# detector reprova justamente as paginas bem escritas: a primeira versao
# acusou 46 paginas e as 46 eram falso positivo — "sem garantia de
# resultado" (a pagina NEGANDO promessa, que e o texto sobrio que a OAB
# exige), "publicidade que promete ganho garantido" (a pagina DESCREVENDO
# a pratica irregular que a CVM fiscaliza) e um bootcamp cujo anuncio
# abusivo a pagina cita entre aspas para analisar.
NEGATION_BEFORE = re.compile(
    r"(sem|não\s+há|nao\s+ha|nenhum[a]?|jamais|nunca|proíbe|proibe|veda|"
    r"impede|ilegal|abusiv[ao]|irregular)\s*$", re.IGNORECASE)

# A NEGACAO QUASE NUNCA ENCOSTA NO GATILHO.
#
# NEGATION_BEFORE exige a particula colada ao padrao (`\s*$`), e por isso deixou
# passar as formas que o texto sobrio de fato usa: "sem confundir chance
# processual com garantia de resultado", "Nenhuma dessas ferramentas transforma
# uma pista incompleta em resultado garantido", "em vez de tratar o verbete como
# garantia de vitoria", "Pedido nao tem resultado garantido". Nas quatro ha
# palavras entre a negacao e o gatilho — o detector via so o gatilho e reprovava
# a pagina JUSTAMENTE por ela avisar que nao ha garantia.
#
# Resultado medido em 2026-08-06: 29 paginas bloqueadas, 29 falso positivo. Onze
# delas ja tinham human_verdict APROVADA — o detector contradisse auditoria
# humana ja feita. E o mesmo perfil do precedente registrado no CLAUDE.md, em que
# 46 paginas foram acusadas e as 46 eram inocentes.
#
# A correcao e olhar a SENTENCA INTEIRA, nao a vizinhanca imediata.
NEGATION_IN_SENTENCE = re.compile(
    r"\b(sem|não|nao|nem|nenhum[a]?|jamais|nunca|proíbe|proibe|veda[m]?|vedad[ao]|"
    r"impede|ilegal|abusiv[ao]|irregular|em\s+vez\s+de|ao\s+invés\s+de|ao\s+inves\s+de|"
    r"longe\s+de|deixa\s+de|evite|evitar|desconfie|cuidado\s+com|golpe|fraude)\b",
    re.IGNORECASE)

# Termos em que "garantia" e vocabulario JURIDICO, nao promessa: garantia real
# (penhor, hipoteca), garantia legal do CDC, garantia irredutivel do art. 618 do
# Codigo Civil, fundo garantidor. Reprovar isso e reprovar o uso correto da
# lingua tecnica que a pagina precisa usar.
LEGAL_GUARANTEE_TERM = re.compile(
    r"garantia\s+(real|legal|contratual|estendida|fiduciári[ao]|fiduciari[ao]|"
    r"bancária|bancaria|irredutível|irredutivel|do\s+produto|de\s+fábrica|de\s+fabrica)|"
    r"fundo\s+garantidor|crédito[s]?\s+com\s+garantia|credito[s]?\s+com\s+garantia|"
    r"garantia\s+de\s+cinco\s+anos", re.IGNORECASE)
THIRD_PARTY_BEFORE = re.compile(
    r"(anunci[ao]|promete|prometia|publicidade|propaganda|oferta|golpe|"
    r"empresa|loja|banco|bootcamp|curso|clínica|clinica|escritório|escritorio|"
    r"site|aplicativo|vendedor|corretor)\w*\s+(que\s+)?[\w\s,]{0,40}$",
