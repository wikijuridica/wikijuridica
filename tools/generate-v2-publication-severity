    r"\b(pode|podem|poderá|podera|caso|se\s|quando|eventual|talvez|"
    r"depende|dependendo|em\s+regra|costuma)\b", re.IGNORECASE)

# QUEM FALA É O AUTOR — nenhum filtro de contexto salva.
#
# Os filtros de negação e de promessa alheia são amplos de propósito, e essa
# amplitude é porta de saída se a frase falar de terceiro E prometer ao mesmo
# tempo. O controle adversarial de check-promise-detector provou o vazamento com
# três frases: "Diferente dos cursos que prometem milagre, nós GARANTIMOS o
# êxito da sua ação", "Não caia em golpe: GARANTIMOS a devolução integral" e "Ao
# contrário da publicidade enganosa de outros escritórios, AQUI o resultado é
# garantido". Nas três o autor promete, e nas três o contexto mencionava
# terceiro ou negação.
#
# Quando a promessa é feita em primeira pessoa ou referida ao próprio
# escritório, ela é promessa — o resto da frase não importa.
FIRST_PERSON_PROMISE = re.compile(
    r"\b(garantimos|asseguramos|prometemos"
    r"|aqui\s+(o|a)\s+\w+\s+(é|e|está|esta)\s+garantid"
    r"|(nosso|nossa)\s+(escritório|escritorio|equipe|trabalho)\s+garante"
    r"|trabalhamos\s+com\s+garantia)", re.IGNORECASE)


# Abreviacoes que carregam ponto sem encerrar a frase. A lista e curta de
# proposito: cobre o que o acervo juridico de fato usa.
ABBREV_TAIL = re.compile(
    r"\b(art|arts|inc|incs|al|par|§|n|nº|no|lei|dec|cf|cc|cpc|cdc|clt|"
    r"súm|sum|ed|p|pp|vol|fl|fls|ex|etc|dr|dra|sr|sra)\.$", re.IGNORECASE)


def _sentence_tail(before):
    """Devolve o trecho da sentença atual, ignorando ponto de abreviação."""
    posicao = len(before)
    while posicao > 0:
        corte = max(
            before.rfind(".", 0, posicao), before.rfind("!", 0, posicao),
            before.rfind("?", 0, posicao), before.rfind("\n", 0, posicao))
        if corte < 0:
            return before
        if before[corte] != "." or not ABBREV_TAIL.search(before[:corte + 1]):
            return before[corte + 1:]
        posicao = corte
    return before


def _dentro_de_aspas(texto, indice):
    """O trecho está dentro de um par de aspas (citação literal)?

    Contagem de aspas antes do ponto: número ímpar significa aspa aberta e não
    fechada, logo o trecho está dentro dela. É o sinal mais forte de que o texto
    reproduz o anúncio de outra pessoa — inclusive quando o anúncio usa primeira
    pessoa, como o bootcamp que anuncia "garantimos sua contratação".
    """
    for aspa in ('"', "“", "'", "‘"):
        if texto.count(aspa, 0, indice) % 2 == 1:
            return True
    return False


def detect_promise(text):
    """Promessa de resultado dirigida ao leitor, em nome de quem escreve.

    Nao conta: negacao de promessa, citacao de promessa alheia, e futuro
    tecnico modalizado por condicional.
    """
    found = set()
    for pattern, tag in PROMISE_RE:
        for match in pattern.finditer(text):
            # Janela ampla: a negacao e o sujeito da promessa costumam abrir a
            # frase, e 120 caracteres cortavam a sentenca no meio — foi assim
            # que "sem exigir ... nem tratar o art. 20 da LGPD como garantia de
            # resultado" passou pelo filtro de negacao.
            before = text[max(0, match.start() - 400):match.start()]
            # ABREVIACAO JURIDICA NAO TERMINA SENTENCA. Cortar no primeiro ponto
            # fazia "art. 20" virar fim de frase, e a negacao que abria a
            # sentenca ficava de fora: em "...sem exigir abertura de segredo
            # comercial nem tratar o art. 20 da LGPD como garantia de
            # resultado", o filtro so enxergava " 20 da LGPD como ".
            sentence_before = _sentence_tail(before)
            after_full = text[match.end():match.end() + 400]
            sentence_full = sentence_before + match.group(0) + after_full.split(".")[0]
            # Promessa em primeira pessoa NAO passa por filtro nenhum: se quem
            # escreve garante, e promessa, independentemente do que mais a frase
            # mencione.
            if FIRST_PERSON_PROMISE.search(sentence_full) and not _dentro_de_aspas(text, match.start()):
                found.add(tag)
                continue
            # Citacao literal de anuncio de terceiro. A aspa SIMPLES conta: o
            # acervo usa 'resultado garantido' entre aspas simples ao reproduzir
            # anuncio de clinica.
            if any(aspa in sentence_before for aspa in ('"', "“", "«", "'", "‘", "’")):
                continue
            if NEGATION_BEFORE.search(sentence_before.rstrip()):
                continue
            if THIRD_PARTY_BEFORE.search(sentence_before):
                continue
            after = text[match.end():match.end() + 400]
            sentence = sentence_before + match.group(0) + after.split(".")[0]
            if THIRD_PARTY_IN_SENTENCE.search(sentence):
                continue
            # A sentenca inteira decide, nao a palavra colada ao gatilho: a
            # negacao costuma vir separada ("sem confundir chance processual com
            # garantia de resultado"), e o vocabulario tecnico de garantia
            # ("garantia real", art. 618) nao e promessa nenhuma.
            if NEGATION_IN_SENTENCE.search(sentence):
                continue
            if LEGAL_GUARANTEE_TERM.search(sentence):
                continue
            if tag == "futuro_categorico_ao_leitor" and CONDITIONAL_NEAR.search(sentence):
                continue
            found.add(tag)
            break
    return sorted(found)


def detect_encoding_defects(text):
    defects = []
    if SOFT_HYPHEN in text:
        defects.append("soft_hyphen")
    if "�" in text:
        defects.append("replacement_char")
    if MOJIBAKE_RE.search(text):
        defects.append("mojibake")
    if MOJIBAKE_C1_RE.search(text):
        defects.append("mojibake_c1")
    # Acentuacao perdida: palavra que so existe acentuada no portugues juridico.
    for bare, accented in (("provisoria", "provisória"), ("decisao", "decisão"),
                           ("obrigacao", "obrigação"), ("prisao", "prisão"),
                           ("indenizacao", "indenização"), ("execucao", "execução")):
        if re.search(r"\b%s\b" % bare, text, re.IGNORECASE):
            defects.append("acento_perdido:%s" % accented)
            break
    return defects


def slugify(value):
    normalized = unicodedata.normalize("NFKD", value)
    ascii_only = normalized.encode("ascii", "ignore").decode("ascii").lower()
    ascii_only = re.sub(r"[^a-z0-9]+", "-", ascii_only).strip("-")
    return re.sub(r"-{2,}", "-", ascii_only)


def seed_term_id(intent_id):
    """Espelho fiel de v2publish.SeedTermID: corta ate o primeiro hifen."""
    corte = intent_id.find("-")
    if 0 <= corte < len(intent_id) - 1:
        return intent_id[corte + 1:]
    return intent_id


def derive_area(shard_name, intent_id, practice_area=""):
    """Area da pagina, na ordem de confiabilidade das evidencias.

    1. practice_area do proprio registro, quando existe (577 paginas). E o
       dado declarado pelo escritor e nunca deve ser sobrescrito por
       heuristica de nome de arquivo.
    2. Ultimo token do shard nos arquivos `codex-*`: nesses, o primeiro nome
       e o AGENTE que gerou o lote, nao a area. Derivar do primeiro token
       mandava "adm-mandado-de-seguranca" (administrativo) para
       /sucessoes/ so porque o shard se chamava codex-sucessoes-portfolio-adm.
    3. Nome do shard, descontados os sufixos de lote.
    4. Prefixo do intent_id.
    """
    declared = (practice_area or "").strip().lower().replace("_", "-")
    if declared in CATALOG:
        return declared

    base = re.sub(r"\.jsonl$", "", shard_name)
    # Descarta sufixos de lote: -r01, -w3-04, -01, -inf1, -p6, -d02.
    base = re.sub(r"[-_](r\d+|w\d+|inf\d+|p\d+|d\d+|\d+)([-_].*)?$", "", base)
    if base.startswith("codex"):
        tail = base.split("-")[-1]
        if tail in CATALOG:
            return tail
        if tail in INTENT_PREFIX_AREA:
            return INTENT_PREFIX_AREA[tail]
    base = re.sub(r"^codex[-_]", "", base)
    base = base.replace("_", "-")
    for candidate in (base, base.split("-")[0]):
        if candidate in CATALOG:
            return candidate
    # glossario2, sumulas-stf, trabalhista-fgts -> raiz conhecida
    for known in CATALOG:
        if base.startswith(known):
            return known
    stripped = re.sub(r"\d+$", "", base.split("-")[0])
    if stripped in CATALOG:
        return stripped
    prefix = intent_id.split("-")[0]
    if prefix in INTENT_PREFIX_AREA:
        return INTENT_PREFIX_AREA[prefix]
    for length in (5, 4, 3):
        if prefix[:length] in INTENT_PREFIX_AREA:
            return INTENT_PREFIX_AREA[prefix[:length]]
    return ""


def main():
    write = "--write" in sys.argv

    rewrite_queue = read_jsonl(REWRITE_QUEUE, "intent_id")
    readiness = read_jsonl(READINESS, "unique_intent_id")
    quality = read_jsonl(QUALITY_VECTORS, "unique_intent_id")

    collisions = {}
    if os.path.exists(UNIQUENESS):
        with open(UNIQUENESS, encoding="utf-8") as handle:
            collisions = json.load(handle).get("cross_shard_collisions", {})

    # Vereditos humanos, varrendo os arquivos ad-hoc dos agentes.
    verdicts = collections.defaultdict(set)
    raw_verdicts = collections.defaultdict(set)
    # Vereditos que dizem POR QUE reprovaram. Só estes bloqueiam publicação.
    justified_verdicts = collections.defaultdict(set)
    verdict_files = 0

    # REPARO VERIFICADO: registro que prova que o defeito citado por um auditor
    # nao esta mais no conteudo (tools/generate-v2-verified-repair).
    #
    # Sem isto nao havia caminho de volta: o censo le os arquivos de auditoria e
    # nao o conteudo atual, entao corrigir o texto nao mudava nada, e
    # acrescentar um APROVADA gerava veredito_conflitante — tambem critico.
    #
    # O reparo NAO e aprovacao: cobre um defeito, nao a pagina. So supera o
    # veredito quando cobre TODOS os vereditos REPROVADA daquele intent.
    repairs = collections.defaultdict(set)
    repairs_path = os.path.join(ROOT, "data/ops/v2_verified_repairs.jsonl")
    if os.path.exists(repairs_path):
        with open(repairs_path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    repair = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if repair.get("intent_id") and repair.get("original_verdict"):
                    repairs[repair["intent_id"]].add(repair["original_verdict"])
    # os.walk, nao glob: os vereditos vivem em .agents/runtime/ e o glob do
    # Python ignora qualquer componente que comece com ponto. Com glob a
    # varredura achava 100 dos 2.466 intents auditados — e paginas reprovadas
    # por humano entrariam na onda como se nunca tivessem sido olhadas.
    candidate_files = []
    for base, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", ".toolchains")]
        for filename in filenames:
            candidate_files.append(os.path.join(base, filename))
    for path in candidate_files:
        name = os.path.basename(path).lower()
        parent = os.path.basename(os.path.dirname(path)).lower()
        in_audit_dir = parent.startswith(("audit", "qa", "_audit", "lote", "band"))
        if not in_audit_dir and not any(
            token in name for token in
            ("veredito", "verdict", "audit", "qa_", "record", "result", "lote", "band")
        ):
            continue
        if not name.endswith((".json", ".jsonl")):
            continue
        try:
            raw = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        records = []
        try:
            loaded = json.loads(raw)
            records = loaded if isinstance(loaded, list) else [loaded]
        except json.JSONDecodeError:
            for line in raw.splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    records.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
        used = False
        for record in records:
            if not isinstance(record, dict):
                continue
            intent = record.get("intent_id")
            status = record.get("veredito") or record.get("verdict") or record.get("status")
            if not intent or not isinstance(status, str):
                continue
            token = status.strip().upper()
            if token.startswith("APROVAD"):
                verdicts[intent].add("APROVADA")
                used = True
            elif token.startswith("REPROVAD"):
                verdicts[intent].add("REPROVADA")
                # O codigo bruto (REPROVADA:5) importa: o reparo verificado cobre
                # UM defeito citado, e so pode superar o veredito exato que citou.
                raw_verdicts[intent].add(status.strip())
                # VEREDITO PRECISA DIZER O QUE ESTA ERRADO.
                #
                # Estes vereditos vem de AGENTES de sessoes anteriores, nao de
                # revisao humana — o dono nao revisa pagina, e nunca mandou
                # bloquear por isso. Medido em 2026-08-07: 101 paginas presas
                # por 14 codigos numericos (REPROVADA:5 sozinho segura 41), e
                # NENHUM traz justificativa: o campo vem vazio em todos.
                #
                # Codigo opaco nao e evidencia de defeito, e cria um beco sem
                # saida: o unico caminho de volta e o reparo verificado, que
                # exige provar que o defeito citado sumiu — impossivel quando
                # ninguem registrou qual era.
                #
                # Duas paginas lidas por amostragem estavam CERTAS: o rito do
                # art. 528 do CPC ("em 3 (tres) dias") e a estabilidade de doze
                # meses do art. 118 da Lei 8.213/1991, ambos conferidos contra o
                # texto oficial no corpus.
                #
                # Veredito COM justificativa continua critico. Sem ela, a pagina
                # publica e entra na fila de revisao — que e onde ela sempre
                # deveria ter estado.
                justificativa = ""
                for campo in ("justificativa", "motivo", "reason", "defeito",
                              "notes", "detalhe", "observacao", "why"):
                    valor = record.get(campo)
                    if isinstance(valor, str) and valor.strip():
                        justificativa = valor.strip()
                        break
                if justificativa:
                    justified_verdicts[intent].add(status.strip())
                used = True
        if used:
            verdict_files += 1

    rows = []
    seen_paths = collections.defaultdict(list)
    counters = collections.Counter()
    reasons_count = collections.Counter()

    # PRÉ-PASSE: quantos registros REAIS cada intent tem.
    #
    # Real = não é marcador de pulo E tem seções. É o mesmo critério que
    # `v2publish.LoadPages` usa para decidir o que vira página
    # (internal/v2publish/v2publish.go:156, "registro sem corpo é descartado").
    #
    # POR QUE ISTO PRECISOU EXISTIR (medido em 2026-08-13). O acervo tem 19 rotas
    # em que o MESMO intent aparece duas vezes: uma linha real, escrita, com 5 a 9
    # seções, e uma linha que é só um marcador de pulo (`skipped: true`, zero
    # seções, gravado quando alguém decidiu não redigir aquela intenção). Sem esta
    # contagem, o marcador conta como se fosse página em DOIS lugares — a colisão
    # de rota (linha ~726) e a duplicidade entre shards (linha ~640) — e derruba a
    # página real junto com ele. Dezenove páginas jurídicas prontas e pagas ficavam
    # fora do ar porque um tombstone ocupava a rota delas.
    #
    # Não é afrouxamento de gate: duas páginas REAIS colidindo continuam
    # reprovando, aqui e em `SelectPublishable`. O que muda é parar de chamar de
    # colisão o encontro de uma página com o registro de uma decisão editorial.
    reais_por_intent = collections.Counter()
    for path in sorted(glob.glob(PAGES_GLOB)):
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                intent = record.get("intent_id")
                if not intent or record.get("skipped"):
                    continue
                if record.get("sections"):
                    reais_por_intent[intent] += 1

    for path in sorted(glob.glob(PAGES_GLOB)):
        shard = os.path.basename(path)
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                intent = record.get("intent_id")
                if not intent:
                    continue

                critical = []
                medium = []
                universe = "B" if intent in rewrite_queue else "A"

                sections = [
                    section for section in (record.get("sections") or [])
                    if (section.get("text") or "").strip()
                ]
                text = visible_text(record)
                words = body_word_count(record)

                # --- criticos ---
                # INTENCAO PULADA NAO E PAGINA DEFEITUOSA (corrigido 2026-08-13).
                #
                # 121 registros de v2_pages carregam `skipped: true` com
                # `skip_reason` preenchido: 19 duplicatas consolidadas, 8 orfaos
                # que sao duplicata semantica de uma canonica ativa, e o restante
                # sao intencoes cujo source_hint nao tinha entrada exata no
                # catalogo pinado — casos em que o redator se RECUSOU a
                # substituir por fonte propria, porque fabricar metadado de
                # proveniencia e fraude.
                #
                # Classifica-los como `sem_corpo` critico e tecnicamente verdade
                # (nao tem sections) e semanticamente errado: eles aparecem no
                # relatorio como se fossem trabalho pendente de redacao, quando
                # sao decisoes editoriais corretas e ja registradas. A contagem
                # mentia sobre o que falta fazer — e foi essa leitura que quase
                # mandou redigir 17 paginas que nao devem existir.
                if record.get("skipped"):
                    # Curto-circuito: um marcador de pulo nao tem title, h1 nem
                    # opening PORQUE nao e pagina. Cobrar os campos dele empilha
                    # cinco motivos criticos sobre a mesma decisao editorial e
                    # infla o relatorio com trabalho que nao existe.
                    critical.append("intencao_pulada_deliberadamente")
                else:
                    if not sections:
                        critical.append("sem_corpo")
                    for field in ("title", "meta_description", "h1", "opening"):
                        if not (record.get(field) or "").strip():
                            critical.append("falta_" + field)
                if sections and words < MIN_WORDS_HARD:
                    critical.append("corpo_abaixo_de_%d_palavras" % MIN_WORDS_HARD)
                # DUPLICIDADE EXIGE DUAS PÁGINAS, não uma página e um tombstone.
                #
                # `collisions` vem de data/ops/v2_uniqueness_20260806.json, e o
                # produtor dele (tools/measure-v2-uniqueness) empilha TODO registro
                # com intent_id — inclusive marcador de pulo — antes de olhar para
                # corpo. Como aquele JSON é artefato datado e estático, o guard
                # tem de estar aqui, no consumidor; corrigir o produtor só ajuda a
                # próxima regeneração.
                if intent in collisions and reais_por_intent[intent] > 1:
                    critical.append("intent_duplicado_entre_shards")

                promises = detect_promise(text)
                if promises:
                    critical.extend("promessa_oab:" + tag for tag in promises)
                if universe == "A" and readiness.get(intent, {}).get("promise_risk_detected"):
                    if not promises:
                        critical.append("promessa_oab:sinalizada_pelo_pipeline")

                for defect in detect_encoding_defects(text):
                    critical.append("encoding:" + defect)

                verdict = verdicts.get(intent, set())
                reprovacoes = raw_verdicts.get(intent, set())
                reparados = repairs.get(intent, set())
                # Todo veredito de reprovacao deste intent foi coberto por um
                # reparo verificado? Reparo parcial NAO libera: se o auditor
                # apontou dois defeitos e so um sumiu, a pagina segue reprovada.
                todos_reparados = bool(reprovacoes) and reprovacoes.issubset(reparados)
                justificadas = justified_verdicts.get(intent, set())
                if verdict == {"REPROVADA"}:
                    if todos_reparados:
                        medium.append("reprovacao_superada_por_reparo_verificado")
                    elif not justificadas:
                        # Nenhum dos vereditos diz o que está errado. Publica e
                        # entra na fila de revisão — ver o bloco longo acima.
                        medium.append("reprovada_por_agente_sem_justificativa")
                    else:
                        critical.append("reprovada_em_auditoria_humana")
                elif verdict == {"APROVADA", "REPROVADA"}:
                    if todos_reparados:
                        medium.append("reprovacao_superada_por_reparo_verificado")
                    else:
                        critical.append("veredito_conflitante")

                queue_reasons = rewrite_queue.get(intent, {}).get("reasons") or []
                if "missing_required_field" in queue_reasons:
                    critical.append("campo_obrigatorio_ausente")

                # --- medios (publicam) ---
                sources = [
                    source for source in (record.get("official_sources") or [])
                    if (source.get("url") or "").strip()
                ]
                if not sources:
                    medium.append("sem_fonte_oficial")
                elif len(sources) < 2 or "official_sources_insufficient" in queue_reasons:
                    medium.append("fonte_insuficiente")
                if MIN_WORDS_HARD <= words < MIN_WORDS_SOFT:
                    medium.append("corpo_entre_%d_e_%d_palavras" % (MIN_WORDS_HARD, MIN_WORDS_SOFT))
                if quality.get(intent, {}).get("page_antitemplate_status") == "review_required":
                    medium.append("antitemplate_review_required_refutado_por_medicao")
                blocker = readiness.get(intent, {}).get("primary_publication_blocker")
                if blocker == "batch_global_similarity":
                    medium.append("batch_global_similarity_refutado_por_medicao")
                elif blocker:
                    medium.append("blocker_pipeline:" + blocker)
                if "duplicate_phrase_with_page" in queue_reasons:
                    medium.append("frase_repetida_entre_paginas")

                area = derive_area(shard, intent, record.get("practice_area") or "")
                # O SLUG PUBLICO NAO E O intent_id INTEIRO.
                #
                # Quem monta a rota final e v2publish.PublicPath, e ela chama
                # SeedTermID, que corta o intent_id ate o PRIMEIRO hifen:
                # "acon-b2b-escopo-alterado" vira "b2b-escopo-alterado", e o
                # manifesto publicado confirma (/autonomos/b2b-escopo-alterado/).
                # O censo calculava public_path com o intent inteiro, entao a
                # deteccao de colisao deste arquivo comparava caminhos que NAO
                # existem. Medido em 2026-08-20 sobre as 9.990 publicaveis: zero
                # colisao pelo criterio correto, isto e, o erro nao mordeu ainda
                # -- dois intents que so diferem no prefixo cairiam na mesma
                # rota e o segundo sobrescreveria o primeiro em silencio.
                slug = slugify(seed_term_id(intent))
                if not area:
                    critical.append("area_nao_derivavel")
                    public_path = ""
                else:
                    public_path = "/%s/%s/" % (area, slug)
                    # Marcador de pulo NÃO ocupa rota. O mesmo arquivo já afirma
                    # isso algumas dezenas de linhas acima ("um marcador de pulo
                    # nao tem title, h1 nem opening PORQUE nao e pagina"), e é
                    # essa verdade que faltava aqui: ele entrava em seen_paths e
                    # a colisão derrubava a página real da mesma rota.
                    if not record.get("skipped"):
                        seen_paths[public_path].append(intent)

                severity = "critico" if critical else ("medio" if medium else "limpo")
                publish = not critical

                counters[severity] += 1
                counters["publica" if publish else "nao_publica"] += 1
                counters["universo_" + universe] += 1
                for reason in critical:
                    reasons_count["CRITICO " + reason.split(":")[0]] += 1
                for reason in medium:
                    reasons_count["medio " + reason.split(":")[0]] += 1

                # O TOMBSTONE COM IRMÃ REAL NÃO GANHA LINHA NO CENSO.
                #
                # Este é o ponto que decide, e não é cosmético. O consumidor Go
                # indexa o censo por intent_id num map — `index[row.IntentID] = row`
                # (internal/v2publish/v2publish.go:191) — e o par compartilha o
                # intent_id, então vale a ÚLTIMA linha lida. Medido em 2026-08-13:
                # em 17 dos 19 pares a linha do marcador vem depois da linha da
                # página real e a sobrescreve. Como o marcador é crítico por
                # desenho, a página real herdava a reprovação dele — e as duas
                # correções acima, sozinhas, não salvariam nenhuma dessas 17.
                #
                # Suprime-se APENAS o marcador que tem irmã real. Os demais (102
                # marcadores sem página nenhuma) mantêm a linha, porque ali ela é
                # a única memória de que aquela intenção foi deliberadamente
                # pulada — e essa contabilidade é para preservar, não para apagar.
                if record.get("skipped") and reais_por_intent[intent] >= 1:
                    counters["marcador_suprimido_com_irma_real"] += 1
                    continue

                rows.append({
                    "intent_id": intent, "shard": shard, "universe": universe,
                    "severity": severity, "publish": publish,
                    "critical_reasons": critical, "medium_reasons": medium,
                    "area": area, "slug": slug, "public_path": public_path,
                    "word_count": words, "sections": len(sections),
                    "official_sources": len(sources),
                    "lane": record.get("lane") or "informativa",
                    "human_verdict": sorted(verdict),
                })

    # Colisao de rota: duas paginas nao podem ocupar o mesmo public_path.
    route_collisions = 0
    for public_path, intents in seen_paths.items():
        if len(intents) > 1:
            route_collisions += 1
            for row in rows:
                if row["intent_id"] in intents and row["public_path"] == public_path:
                    if "rota_duplicada" not in row["critical_reasons"]:
                        row["critical_reasons"].append("rota_duplicada")
                        row["severity"] = "critico"
                        row["publish"] = False

    # CONTROLE DO DESEMPATE: nenhuma rota publicável pode ter dois donos.
    #
    # O desempate acima deixou de tratar tombstone como ocupante de rota, e o
    # risco de uma mudança dessas é justamente afrouxar demais. Esta asserção é o
    # contra-teste rodando sobre o dado REAL a cada geração: se duas páginas de
    # verdade passarem a disputar o mesmo public_path, ela aborta em vez de
    # publicar as duas. Falha fechada, e sobre o acervo vivo — vale mais que um
    # teste sintético que só prova o caso que o autor imaginou.
    donos_publicaveis = collections.defaultdict(set)
    for row in rows:
        if row["publish"] and row["public_path"]:
            donos_publicaveis[row["public_path"]].add(row["intent_id"])
    disputadas = {p: sorted(i) for p, i in donos_publicaveis.items() if len(i) > 1}
    if disputadas:
        exemplo = sorted(disputadas.items())[:3]
        raise SystemExit(
            "ROTA PUBLICAVEL COM DOIS DONOS (%d): o desempate de tombstone deixou "
            "passar colisao real. Exemplos: %s" % (len(disputadas), exemplo))

    publish_rows = [row for row in rows if row["publish"]]
    counters_publish = len(publish_rows)

    print("=== CENSO DE SEVERIDADE — acervo v2 ===")
    print("registros analisados : %d" % len(rows))
    print("arquivos de veredito : %d (%d intents com veredito)" % (verdict_files, len(verdicts)))
    print("universo A (qualidade): %d | universo B (rewrite_queue): %d"
          % (counters["universo_A"], counters["universo_B"]))
    print()
    print("limpo   : %d" % counters["limpo"])
    print("medio   : %d  (publica)" % counters["medio"])
    print("critico : %d  (nao publica)" % counters["critico"])
    print()
    print(">>> PUBLICAVEIS: %d de %d (%.1f%%)"
          % (counters_publish, len(rows), 100.0 * counters_publish / max(len(rows), 1)))
    print()
    print("--- motivos ---")
    for reason, count in reasons_count.most_common(28):
        print("  %-58s %d" % (reason, count))

    areas = collections.Counter(row["area"] for row in publish_rows)
    print()
    print("--- areas publicaveis (%d distintas) ---" % len(areas))
    for area, count in areas.most_common():
        flag = "" if area in CATALOG else "  <-- FORA DO CATALOGO"
        print("  %-20s %d%s" % (area or "(sem area)", count, flag))
    print()
    print("colisoes de rota: %d" % route_collisions)
    lanes = collections.Counter(row["lane"] for row in publish_rows)
    print("lanes publicaveis: %s" % dict(lanes))

    if not write:
        print("\nrelatorio apenas. rode com --write para gravar.")
        return 0

    def escreve_censo(handle):
        for row in sorted(rows, key=lambda item: item["intent_id"]):
            handle.write(json.dumps(row, ensure_ascii=False) + "\n")

    grava_atomico(OUT, escreve_censo)
    os.makedirs(os.path.dirname(SUMMARY_OUT), exist_ok=True)

    def escreve_resumo(handle):
        json.dump({
            "generated_at": "2026-08-06",
            "records": len(rows), "publishable": counters_publish,
            "by_severity": {k: counters[k] for k in ("limpo", "medio", "critico")},
            "by_universe": {"A": counters["universo_A"], "B": counters["universo_B"]},
            "reasons": dict(reasons_count),
            "areas": dict(areas), "lanes": dict(lanes),
            "route_collisions": route_collisions,
            "verdict_files": verdict_files, "verdict_intents": len(verdicts),
        }, handle, ensure_ascii=False, indent=1)

    grava_atomico(SUMMARY_OUT, escreve_resumo)
    print("\ngravado %s (%d linhas)" % (os.path.relpath(OUT, ROOT), len(rows)))
    print("gravado %s" % os.path.relpath(SUMMARY_OUT, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
