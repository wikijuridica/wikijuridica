THIRD_PARTY_IN_SENTENCE = re.compile(
    r"\b(an[úu]ncio[s]?|anunci\w+|publicidade|propaganda|promessa[s]?|prometid[ao]s?|"
    r"prometend[ao]|golpe[s]?|fraude|estelionat\w+|enganos[ao]|abusiv[ao]|"
    r"vender|vendendo|venda\s+de|mentoria|bootcamp|curso[s]?|clínica|clinica|"
    r"sinais?\s+(relevantes?|de\s+risco|de\s+alerta)|infal[íi]vel|"
    r"m[ée]todo\s+infal|recuperador|falso[as]?)\b", re.IGNORECASE)
