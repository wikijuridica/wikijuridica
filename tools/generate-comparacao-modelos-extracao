#!/usr/bin/env python3
"""Compara DOIS modelos de extracao sobre os MESMOS acordaos, pareado por chave.

POR QUE PAREADO. Em 2026-09-08 a primeira leitura foi agregada -- 14 extracoes
do candidato contra 112 da producao -- e o candidato apareceu muito pior
(descarte 21,4% contra 7,6%, 0,79 dispositivo por acordao contra 1,53). O
agregado nao decide, porque o ensaio do candidato usa `--so-sem-referencias`:
ele roda justamente as ementas em que o parser NAO achou referencia
estruturada, que sao as mais dificeis por construcao. Rodar o modelo atual sobre
o MESMO subconjunto elimina esse vies dos dois lados.

POR QUE ESTES NUMEROS, e nao os tres de antes. O gate anterior media descarte,
URN e respostas cortadas. Os tres APROVARIAM um modelo que responde sempre
{"dispositivos":[]}: descarte 0%, URN 100%, 0 cortadas. Por isso entram tambem
`dispositivos_por_acordao` e `eval_tokens_mediano` -- quanto trabalho foi de
fato FEITO. Foi assim que se viu que o candidato extraia metade.

Saida: data/ops/extracao_dispositivos_amostra_daily.jsonl (append por dia+par).
"""

import argparse
import json
import os
import statistics
import sys
import time

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SAIDA = os.path.join(RAIZ, "data", "ops", "extracao_dispositivos_amostra_daily.jsonl")
SCHEMA = "extracao_dispositivos_amostra_daily_v2"


def le(caminho):
    """chave -> registro. Registro repetido: fica o ULTIMO, que e a extracao
    mais recente daquela chave (o arquivo e append-only)."""
    por_chave = {}
    with open(caminho, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            d = json.loads(linha)
            por_chave[d["chave"]] = d
    return por_chave


def mediana(valores):
    v = [x for x in valores if x is not None]
    return round(statistics.median(v), 3) if v else None


def resume(registros):
    dispositivos = sum(len(r.get("dispositivos") or []) for r in registros)
    descartados = sum(r.get("descartados", 0) for r in registros)
    precedentes = sum(r.get("descartados_precedentes", 0) for r in registros)
    com_urn = sum(1 for r in registros for d in (r.get("dispositivos") or []) if d.get("urn"))
    cortadas = sum(1 for r in registros if r.get("done_reason") == "length")
    propostos = dispositivos + descartados + precedentes
    return {
        "acordaos": len(registros),
        "dispositivos": dispositivos,
        # O numero que revela o modelo que responde vazio: descarte e URN
        # sozinhos nao o veem.
        "dispositivos_por_acordao": round(dispositivos / len(registros), 3) if registros else None,
        "urn_pct": round(100 * com_urn / dispositivos, 1) if dispositivos else None,
        # Descarte = item cujo texto_citado NAO ocorre literalmente na ementa.
        # E a guarda anti-invencao, e a classe P1 sob a OAB.
        "descarte_pct": round(100 * (descartados + precedentes) / propostos, 1) if propostos else None,
        "descartados": descartados,
        "descartados_precedentes": precedentes,
        "cortadas": cortadas,
        "eval_tokens_mediano": mediana(r.get("eval_tokens") for r in registros),
        "prompt_tokens_mediano": mediana(r.get("prompt_tokens") for r in registros),
        "eval_tok_s_mediano": mediana(r.get("eval_tok_s") for r in registros),
    }


def main():
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--a", required=True, help="jsonl de extracoes do modelo A")
    p.add_argument("--b", required=True, help="jsonl de extracoes do modelo B")
    p.add_argument("--rotulo", default="", help="rotulo do ensaio (ex.: gate-denso-20)")
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args()

    a, b = le(args.a), le(args.b)
    comuns = sorted(set(a) & set(b))
    if not comuns:
        print("nenhuma chave em comum: nao ha comparacao pareada a fazer",
              file=sys.stderr)
        print("  A: %d chaves | B: %d chaves" % (len(a), len(b)), file=sys.stderr)
        return 2

    modelos_a = sorted({a[c].get("modelo") for c in comuns})
    modelos_b = sorted({b[c].get("modelo") for c in comuns})
    if len(modelos_a) != 1 or len(modelos_b) != 1:
        print("cada lado tem de ter UM modelo so; A=%s B=%s" % (modelos_a, modelos_b),
              file=sys.stderr)
        return 2
    if modelos_a == modelos_b:
        print("os dois lados sao o mesmo modelo (%s): nao ha o que comparar" % modelos_a,
              file=sys.stderr)
        return 2

    resumo_a = resume([a[c] for c in comuns])
    resumo_b = resume([b[c] for c in comuns])
    dia = time.strftime("%Y-%m-%d", time.gmtime())
    linha = {
        "schema_version": SCHEMA, "date": dia, "rotulo": args.rotulo,
        "pareado_por": "chave", "chaves": len(comuns),
        "so_em_a": len(set(a) - set(b)), "so_em_b": len(set(b) - set(a)),
        "lados": [
            dict(modelo=modelos_a[0], arquivo=os.path.relpath(args.a, RAIZ), **resumo_a),
            dict(modelo=modelos_b[0], arquivo=os.path.relpath(args.b, RAIZ), **resumo_b),
        ],
        "gerado_em": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }

    largura = max(len(modelos_a[0]), len(modelos_b[0]))
    print("pareado por chave: n=%d (so em A: %d, so em B: %d)"
          % (len(comuns), linha["so_em_a"], linha["so_em_b"]))
    cabecalho = ("%-*s %9s %8s %9s %10s %12s %12s"
                 % (largura, "modelo", "disp/acor", "URN%", "descarte%",
                    "cortadas", "eval_tokens", "eval_tok/s"))
    print(cabecalho)
    for lado in linha["lados"]:
        print("%-*s %9s %8s %9s %10s %12s %12s" % (
            largura, lado["modelo"], lado["dispositivos_por_acordao"],
            lado["urn_pct"], lado["descarte_pct"], lado["cortadas"],
            lado["eval_tokens_mediano"], lado["eval_tok_s_mediano"]))

    if args.dry_run:
        print("--dry-run: nada gravado", file=sys.stderr)
        return 0
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    with open(SAIDA, "a", encoding="utf-8") as f:
        f.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
    print("gravado em %s" % SAIDA)
    return 0


if __name__ == "__main__":
    sys.exit(main())
