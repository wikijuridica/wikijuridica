    updated["official_sources"] = [dict(source) for source in OFFICIAL_SOURCES]
    updated["internal_link_topics"] = list(INTERNAL_LINK_TOPICS)
    updated["word_count"] = word_count(updated)
    return updated


def preflight(record: dict) -> None:
    problems: list[str] = []
    if not (MIN_TITLE <= len(TITLE) <= MAX_TITLE):
        problems.append(f"title fora de {MIN_TITLE}-{MAX_TITLE}: {len(TITLE)}")
    if not (MIN_META <= len(META) <= MAX_META):
        problems.append(f"meta fora de {MIN_META}-{MAX_META}: {len(META)}")
    if TITLE == H1:
        problems.append("title igual ao h1 (validate.go:606 reprova)")
    if len(record["sections"]) < 2:
        problems.append("menos de 2 secoes")
    for section in record["sections"]:
        if len(section["text"].split()) < 25:
            problems.append(f"secao com menos de 25 palavras: {section['heading']!r}")
    if len(record["official_sources"]) < 2:
        problems.append("menos de 2 fontes oficiais")
    if record["word_count"] < 400:
        problems.append(f"word_count abaixo de 400: {record['word_count']}")
    for source in record["official_sources"]:
        claim = source.get("anchor_claim") or ""
        if len(claim.split()) < 8:
            problems.append(f"anchor_claim curto demais: {source['url']}")
    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(
        f"preflight ok: title={len(TITLE)} meta={len(META)} "
        f"secoes={len(record['sections'])} fontes={len(record['official_sources'])} "
        f"palavras={record['word_count']}"
    )


def apply() -> int:
    path = ROOT / SHARD
    lines = path.read_bytes().decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    output: list[str] = []
    changed = 0
    already = 0
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{SHARD}: linha em branco {number}")
        record = json.loads(raw)
        if record.get("intent_id") != INTENT:
            output.append(raw)
            continue

        if record.get("title") == TITLE and record.get("h1") == H1:
            already += 1
            output.append(raw)
            continue

        digest = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        if digest != EXPECTED_LINE_SHA256:
            raise SystemExit(
                f"CAS FALHOU em {SHARD}:{number} ({INTENT}): a linha atual nao e a esperada.\n"
                f"  esperado: {EXPECTED_LINE_SHA256}\n"
                f"  atual:    {digest}\n"
                "Outra frente tocou este registro. Reler o conteudo vivo antes de reaplicar."
            )

        updated = build_record(record)
        preflight(updated)
        output.append(json.dumps(updated, ensure_ascii=False, sort_keys=True))
        changed += 1

    if changed == 0 and already == 0:
        raise SystemExit(f"{SHARD}: intent {INTENT} nao encontrado")

    if changed:
        payload = "\n".join(output)
        if trailing_newline:
            payload += "\n"
        atomic_write(path, payload.encode("utf-8"))

    print(f"{SHARD}: reescritos={changed} ja_aplicados={already}")
    return changed


