#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
check_args=("$@")
"$ROOT/tools/go-modern" test -count=1 ./internal/codex2sourcecodexlockdecision ./internal/contract/codex2 -run TestCodex2SourceCodexLockDecision
exec "$ROOT/tools/run-check" codex2-source-codex-lock-decision "${check_args[@]}"
