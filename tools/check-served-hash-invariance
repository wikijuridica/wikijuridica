#!/usr/bin/env python3
"""check-served-hash-invariance — a âncora institucional NÃO re-data o acervo.

O QUE ELE PROVA, E POR QUE ISSO VALE DINHEIRO.

`tools/generate-page-content-revision` decide a data de revisão de cada rota pelo
`served_sha256`: o sha256 do HTML servido DEPOIS de neutralizar as datas e os
blocos de navegação. O `<lastmod>` do sitemap, o `dateModified` do JSON-LD e o
"revisado em" visível saem daí. Uma mudança de markup que altere esse hash
re-data as 10.141 rotas de uma vez e faz o portal reanunciar o acervo inteiro ao
Googlebot como se fosse conteúdo novo — o "frescor fabricado" que aquele gerador
existe para combater, e que ensina o buscador a ignorar o campo.

A âncora institucional de /redesocial/ é emitida DENTRO de
`<section aria-labelledby="conteudos-relacionados">`, e o neutralizador troca
essa section inteira por `@NAV@` antes de hashear. Em tese o hash não muda. Este
check mede se é verdade, sobre o `public/` REAL, por amostra de stride
determinístico — nunca por prefixo conveniente, que não é evidência de escala.

COMO ELE NÃO MENTE:

  * A neutralização não é reimplementada aqui. O módulo
    `tools/generate-page-content-revision` é carregado e as suas
    `neutraliza_datas` e `BLOCOS_DE_NAVEGACAO` são as usadas — se a fórmula do
    served_sha256 mudar lá, esta prova muda junto, por construção.
  * O markup é POR ROTA desde 2026-09-05. O chrome institucional carrega, além
    da âncora de `/redesocial/`, o espelho de caminho
    `/redesocial/tema/{área}/{slug}/` da própria página — e injetar em 10.141
    rotas o endereço de uma só provaria a invariância de um HTML que o render
    nunca emite.
  * HÁ CONTROLE NEGATIVO. O mesmo markup, colado FORA do bloco, TEM de mudar o
    served_sha256; se não mudar, o check reprova. Sem ele, "hash intacto em
    203/203" seria indistinguível de um neutralizador que apaga o documento
    inteiro — e um instrumento que não vê mudança nenhuma é falso verde, não
    prova.
  * O texto da âncora não é redigitado aqui. Ele é LIDO de
    `internal/content/redesocial.go`, que é o dono das constantes. A forma
    exata do markup (`<p><a href="…">…</a></p>` entre `</ul>` e `</section>`) é
    fixada do lado Go por
    `internal/render.TestAncoraDaRedeSocialEhInstitucionalESobria` e
    `TestAncoraDaRedeSocialCabeDentroDoNAVNeutralizado`. Os dois pinos precisam
    concordar; se alguém mudar um só, este check acusa a diferença de tamanho.
  * O ponto de inserção é achado pela MESMA regex não-gulosa do neutralizador,
    nunca por `str.replace` de `</ul>\\n</section>` — essa substituição textual
    casa PRIMEIRO a seção de proveniência (medido: offset 14226 contra 14361 do
    bloco) e provaria a coisa errada.

Read-only (contrato `tools/check-*`): lê `public/` e dois arquivos de código,
não escreve nada.

Uso:
    tools/check-served-hash-invariance
    tools/check-served-hash-invariance --passo 50
    tools/check-served-hash-invariance --publico /caminho/para/public

Saída 0 = todos os hashes da amostra intactos; 1 = algum mudaria (a mudança
re-dataria o acervo); 2 = erro de uso ou árvore ausente.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GERADOR = os.path.join(RAIZ, "tools", "generate-page-content-revision")
CONSTANTES_GO = os.path.join(RAIZ, "internal", "content", "redesocial.go")

# A MESMA abertura que internal/render emite e que o neutralizador procura.
BLOCO = re.compile(
    r'<section aria-labelledby="conteudos-relacionados">.*?</section>', re.S
)
FECHO_DA_LISTA = "</ul>\n"


def falha(msg: str) -> SystemExit:
    print(f"check-served-hash-invariance: {msg}", file=sys.stderr)
    return SystemExit(2)


def carrega_gerador():
    """Reusa a fórmula do served_sha256 em vez de reimplementá-la.

    Duas implementações da mesma neutralização divergem com o tempo, e aí a
    prova passa a atestar um hash que ninguém calcula na hora de datar.
    """
    spec = importlib.util.spec_from_loader(
        "generate_page_content_revision",
        importlib.machinery.SourceFileLoader(
            "generate_page_content_revision", GERADOR),
    )
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    for atributo in ("neutraliza_datas", "BLOCOS_DE_NAVEGACAO"):
        if not hasattr(modulo, atributo):
            raise falha(f"{GERADOR} não expõe {atributo}: a fórmula mudou de forma")
    return modulo


def constantes_do_go() -> tuple[str, str, str, str]:
    """(rota da rede, âncora da rede, prefixo do espelho, âncora do espelho).

    As quatro são lidas de `internal/content/redesocial.go`, que é o dono delas.
    O prefixo do espelho é declarado lá como `RedeSocialPath + "tema/"` — uma
    concatenação, não um literal —, então ele é RESOLVIDO aqui a partir da rota
    já lida, em vez de procurado como string. Procurar um literal que o Go não
    escreve faria este check reprovar por não achar o que não existe.
    """
    try:
        with open(CONSTANTES_GO, encoding="utf-8") as fh:
            fonte = fh.read()
    except OSError as erro:
        raise falha(f"não consegui ler {CONSTANTES_GO}: {erro}")
    rota = re.search(r'RedeSocialPath\s*=\s*"([^"]+)"', fonte)
    ancora = re.search(r'RedeSocialAncora\s*=\s*"([^"]+)"', fonte)
    if not rota or not ancora:
        raise falha(f"não achei RedeSocialPath/RedeSocialAncora em {CONSTANTES_GO}")
    prefixo = re.search(r'TemaSocialPrefixo\s*=\s*RedeSocialPath\s*\+\s*"([^"]+)"', fonte)
    ancora_tema = re.search(r'TemaSocialAncora\s*=\s*"([^"]+)"', fonte)
    if not prefixo or not ancora_tema:
        raise falha(f"não achei TemaSocialPrefixo/TemaSocialAncora em {CONSTANTES_GO}")
    return rota.group(1), ancora.group(1), rota.group(1) + prefixo.group(1), ancora_tema.group(1)


def markup_da_rota(rota: str, markup_fixo: str, prefixo_tema: str, ancora_tema: str) -> str:
    """O chrome institucional DESTA rota: a âncora da rede mais o espelho dela.

    O CHECK DEIXOU DE TER MARKUP FIXO EM 2026-09-05, e isso não é detalhe. O
    chrome passou a carregar `/redesocial/tema/{área}/{slug}/`, diferente em cada
    uma das 10.141 rotas; um markup único injetaria em toda página o endereço de
    uma página só, e o que ficaria provado seria a invariância de um HTML que o
    render nunca emite. Só a rota da forma `/área/slug/` tem espelho — hub de
    área e fatia de paginação recebem apenas a primeira âncora, exatamente como
    internal/render decide.
    """
    partes = [p for p in rota.strip("/").split("/") if p]
    if len(partes) != 2:
        return markup_fixo
    espelho = f"{prefixo_tema}{partes[0]}/{partes[1]}/"
    return markup_fixo + f'<p><a href="{espelho}">{ancora_tema}</a></p>\n' 


def hash_servido(modulo, bruto: str) -> str:
    neutro = modulo.neutraliza_datas(bruto)
    for bloco in modulo.BLOCOS_DE_NAVEGACAO:
        neutro = bloco.sub("@NAV@", neutro)
    return hashlib.sha256(neutro.encode("utf-8")).hexdigest()


def par_de_estados(bruto: str, markup: str) -> tuple[str, str, str]:
    """Devolve (html do outro estado, modo, motivo de recusa).

    O CHECK É SIMÉTRICO DE PROPÓSITO, e sem isso ele mentiria depois do deploy.

      * ANTES da publicação, o disco não tem a âncora: o outro estado é o disco
        COM ela, inserida no MESMO ponto em que
        internal/render.renderRelatedContent a emite — logo depois do `</ul>\\n`
        que fecha a lista da malha e antes do `</section>` que fecha o bloco.
      * DEPOIS da publicação, o disco já a tem: injetá-la de novo produziria um
        bloco com DUAS âncoras. Os dois hashes continuariam batendo (tudo vira
        `@NAV@`) e o check imprimiria APROVADO sem ter medido o que promete. Aí
        o outro estado é o disco SEM a âncora — a mesma comparação, no sentido
        inverso.

    O bloco é localizado pela regex não-gulosa, então o `</section>` alvo é
    exatamente o que o neutralizador considera fim do trecho — que é a única
    coisa de que a invariância depende.
    """
    casou = BLOCO.search(bruto)
    if not casou:
        return "", "", "sem bloco de conteúdos relacionados"
    trecho = casou.group(0)
    if trecho.count("<section") != 1 or trecho.count("</section>") != 1:
        return "", "", "bloco com <section> aninhada ou irmã: o `.*?` pararia antes do fim"

    quantas = trecho.count(markup)
    if quantas > 1:
        return "", "", f"bloco com {quantas} âncoras institucionais: só pode haver uma"
    if quantas == 1:
        outro_trecho = trecho.replace(markup, "", 1)
        modo = "retirada"
    else:
        corte = trecho.rfind(FECHO_DA_LISTA)
        if corte < 0:
            return "", "", "bloco sem `</ul>\\n`: o ponto de inserção do render não existe aqui"
        ponto = corte + len(FECHO_DA_LISTA)
        outro_trecho = trecho[:ponto] + markup + trecho[ponto:]
        modo = "injecao"
    return bruto[: casou.start()] + outro_trecho + bruto[casou.end():], modo, ""


def rotas_de(publico: str) -> list[tuple[str, str]]:
    achadas = []
    for pasta, _, arquivos in os.walk(publico):
        if "index.html" not in arquivos:
            continue
        rel = os.path.relpath(pasta, publico)
        rota = "/" if rel == "." else "/" + rel.replace(os.sep, "/") + "/"
        achadas.append((rota, os.path.join(pasta, "index.html")))
    achadas.sort()
    return achadas


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--publico", default=os.path.join(RAIZ, "public"),
                    help="árvore a medir (default: public/ do repositório)")
    ap.add_argument("--passo", type=int, default=50,
                    help="stride determinístico sobre as rotas COM bloco (default: 50)")
    args = ap.parse_args()

    if args.passo < 1:
        raise falha("--passo tem de ser >= 1")
    if not os.path.isdir(args.publico):
        raise falha(f"árvore ausente: {args.publico}")

    modulo = carrega_gerador()
    rota_social, texto, prefixo_tema, ancora_tema = constantes_do_go()
    markup_fixo = f'<p><a href="{rota_social}">{texto}</a></p>\n'

    todas = rotas_de(args.publico)
    if not todas:
        raise falha(f"nenhum index.html em {args.publico}")

    com_bloco: list[tuple[str, str, str]] = []
    sem_bloco: list[str] = []
    for rota, caminho in todas:
        try:
            with open(caminho, encoding="utf-8", errors="replace") as fh:
                bruto = fh.read()
        except OSError as erro:
            raise falha(f"{caminho}: {erro}")
        if BLOCO.search(bruto):
            com_bloco.append((rota, caminho, bruto))
        else:
            sem_bloco.append(rota)

    amostra = com_bloco[:: args.passo]
    iguais = 0
    modos: dict[str, int] = {"injecao": 0, "retirada": 0}
    divergentes: list[str] = []
    recusadas: list[str] = []
    com_espelho = 0
    tamanhos: list[int] = []
    # CONTROLE NEGATIVO: quantas rotas da amostra provaram que o instrumento
    # ENXERGA mudança. Sem ele, "hash intacto em 203/203" seria compatível com
    # uma neutralização que apaga o documento inteiro — e um check que não
    # distingue "não mudou" de "não mede" é falso verde.
    controle_detectou = 0
    controle_cego: list[str] = []
    for rota, _, bruto in amostra:
        markup = markup_da_rota(rota, markup_fixo, prefixo_tema, ancora_tema)
        if markup != markup_fixo:
            com_espelho += 1
        tamanhos.append(len(markup.encode("utf-8")))
        antes = hash_servido(modulo, bruto)
        outro_html, modo, motivo = par_de_estados(bruto, markup)
        if motivo:
            recusadas.append(f"{rota}: {motivo}")
            continue
        modos[modo] += 1
        depois = hash_servido(modulo, outro_html)
        if antes == depois:
            iguais += 1
        else:
            divergentes.append(f"{rota}: {antes[:12]} -> {depois[:12]} ({modo})")

        # O MESMO markup, FORA do bloco neutralizado, TEM de mudar o hash. É a
        # prova de que a invariância medida acima vem de o chrome cair dentro do
        # @NAV@, e não de o hash ser insensível a tudo.
        casou = BLOCO.search(bruto)
        fora = bruto[: casou.end()] + markup + bruto[casou.end():]
        if hash_servido(modulo, fora) != antes:
            controle_detectou += 1
        else:
            controle_cego.append(rota)

    print(f"arvore                : {args.publico}")
    print(f"index.html            : {len(todas)}  "
          f"(com bloco: {len(com_bloco)}, sem bloco: {len(sem_bloco)})")
    print(f"ancora da rede        : {len(markup_fixo.encode('utf-8'))} B  {markup_fixo.strip()}")
    print(f"chrome por rota       : {min(tamanhos) if tamanhos else 0}-{max(tamanhos) if tamanhos else 0} B  "
          f"({com_espelho}/{len(amostra)} rotas com espelho {prefixo_tema}{{area}}/{{slug}}/)")
    print(f"amostra (stride {args.passo})  : {len(amostra)} rotas")
    print(f"modo                  : {modos['injecao']} por injeção (disco ainda sem a âncora), "
          f"{modos['retirada']} por retirada (disco já publicado com ela)")
    print(f"served_sha256 intacto : {iguais}/{len(amostra)}")
    print(f"controle negativo     : {controle_detectou}/{len(amostra)} "
          f"(o MESMO markup fora do bloco muda o hash)")

    if recusadas:
        print(f"\nRECUSADAS: {len(recusadas)} rota(s) em que a âncora não teria onde entrar")
        for linha in recusadas[:10]:
            print(f"    {linha}")
    if divergentes:
        print(f"\nHASH MUDARIA em {len(divergentes)} rota(s) — a mudança RE-DATARIA o acervo")
        for linha in divergentes[:10]:
            print(f"    {linha}")
        print("\nREPROVADO: a âncora sairia do trecho neutralizado.")
        return 1
    if recusadas:
        print("\nREPROVADO: há bloco em que o ponto de inserção do render não existe.")
        return 1
    if controle_cego:
        print(f"\nCONTROLE NEGATIVO FALHOU em {len(controle_cego)} rota(s): o mesmo markup "
              "FORA do bloco não mudou o served_sha256")
        for linha in controle_cego[:10]:
            print(f"    {linha}")
        print("\nREPROVADO: o instrumento não distingue mudança de ausência de mudança — "
              "a invariância medida acima não prova nada.")
        return 1
    if com_espelho == 0:
        print("\nREPROVADO: nenhuma rota da amostra tem espelho de caminho; o chrome medido "
              "não é o que o render emite hoje.")
        return 1
    print("\nAPROVADO: o served_sha256 de toda a amostra fica intacto; "
          "nenhuma rota é re-datada por esta âncora.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
