class GuardError(RuntimeError):
    pass


def git(arguments: list[str], *, input_payload: bytes | None = None) -> bytes:
    environment = {
        "PATH": "/usr/bin:/bin",
        "HOME": "/",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_NO_LAZY_FETCH": "1",
        "GIT_TERMINAL_PROMPT": "0",
    }
    completed = subprocess.run(
        [GIT, "--no-replace-objects", "-c", "core.fsmonitor=false",
         "-c", "core.untrackedCache=false", "-c", "core.hooksPath=/dev/null",
         "-c", f"safe.directory={ROOT}",
         *arguments],
        cwd=ROOT, env=environment, input=input_payload,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120,
        check=False,
    )
    if (len(completed.stdout) > MAX_GIT_BYTES or
            len(completed.stderr) > MAX_GIT_BYTES):
        raise GuardError("saída Git excedeu limite")
    if completed.returncode != 0:
        detail = " ".join(completed.stderr.decode(
            "utf-8", errors="replace").split())[:800]
        raise GuardError(f"git {' '.join(arguments[:3])} falhou: {detail}")
    return completed.stdout


def decode_object(raw: bytes, label: str) -> dict[str, Any]:
    def reject_duplicate(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                raise GuardError(f"chave JSON duplicada em {label}: {key}")
            result[key] = value
        return result
    try:
        value = json.loads(raw, object_pairs_hook=reject_duplicate)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise GuardError(f"JSON inválido em {label}") from error
    if not isinstance(value, dict):
        raise GuardError(f"registro não é objeto em {label}")
    return value


def decode_unique_intent(raw: bytes, label: str) -> str:
    try:
        pairs = json.loads(raw, object_pairs_hook=tuple)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise GuardError(f"JSON inválido em {label}") from error
    if (not isinstance(pairs, tuple) or
            any(not isinstance(pair, tuple) or len(pair) != 2 or
                not isinstance(pair[0], str) for pair in pairs)):
        raise GuardError(f"registro não é objeto em {label}")
    intents = [value for key, value in pairs if key == "intent_id"]
    if (len(intents) != 1 or not isinstance(intents[0], str) or
            not intents[0] or intents[0].strip() != intents[0]):
        raise GuardError(f"intent_id inválido em {label}")
    return intents[0]


def jsonl_records(payload: bytes, label: str) -> list[dict[str, Any]]:
    if (not payload or not payload.endswith(b"\n") or b"\r" in payload or
            b"\0" in payload):
        raise GuardError(f"JSONL inválido em {label}")
    lines = payload.splitlines()
    if not lines or any(not line for line in lines):
        raise GuardError(f"linha vazia em {label}")
    return [decode_object(raw, f"{label}:{line_number}")
            for line_number, raw in enumerate(lines, 1)]


def canonical_intent_fold(value: str) -> str:
    return "".join(
        character for character in unicodedata.normalize("NFKD", value)
        if unicodedata.combining(character) == 0)


def folded_intent_locations(
    locations: dict[str, list[tuple[str, int]]], canonical: str,
) -> list[tuple[str, str, int]]:
    return sorted(
        (intent, path, line_number)
        for intent, entries in locations.items()
        if canonical_intent_fold(intent) == canonical
        for path, line_number in entries
    )


def assert_public_state_closed(record: dict[str, Any], label: str) -> None:
    for flag in CLOSED_PUBLIC_REQUIRED_FALSE_FLAGS:
        # Historical internal v2 rows predate the explicit booleans. Absence is
        # closed (the zero value consumed by render/release); only a present,
        # non-false value may open state. Requiring a retroactive field rewrite
        # here made every otherwise unrelated v2 transaction impossible.
        if flag in record and record[flag] is not False:
            raise GuardError(f"flag pública aberta em {label}: {flag}")
    for flag in CLOSED_PUBLIC_OPTIONAL_FALSE_FLAGS:
        if flag in record and record[flag] is not False:
            raise GuardError(f"flag pública opcional aberta em {label}: {flag}")
    if "index_policy" in record and record["index_policy"] != "noindex":
        raise GuardError(f"index_policy aberto em {label}")
    if "public_path" in record and record["public_path"] != "":
        raise GuardError(f"public_path aberto em {label}")


# A product issue is deliberately content-addressed by its stable logical
# location, not by a human diagnostic string.  This lets a candidate prove
# that it did not add or move a pre-existing defect while still allowing an
# unrelated, safe V2 repair to land.  A changed page is never grandfathered:
# every issue in a touched shard must be fixed in that same transaction.
ProductIssue = tuple[str, str, int, str]


def public_state_product_issues(
    record: dict[str, Any], path: str, line_number: int, intent: str,
) -> set[ProductIssue]:
    issues: set[ProductIssue] = set()
    for flag in CLOSED_PUBLIC_REQUIRED_FALSE_FLAGS + \
            CLOSED_PUBLIC_OPTIONAL_FALSE_FLAGS:
        if flag in record and record[flag] is not False:
            issues.add(("public-state", path, line_number,
                        f"{intent}:{flag}"))
    if "index_policy" in record and record["index_policy"] != "noindex":
        issues.add(("public-state", path, line_number,
                    f"{intent}:index_policy"))
    if "public_path" in record and record["public_path"] != "":
        issues.add(("public-state", path, line_number,
                    f"{intent}:public_path"))
    return issues


def canonical_repair_transition(
    old_payload: bytes, new_payload: bytes, path: str,
) -> tuple[str, str, int]:
    old_records = jsonl_records(old_payload, path + "@old")
    new_records = jsonl_records(new_payload, path + "@new")
    old_lines = old_payload.splitlines(keepends=True)
    new_lines = new_payload.splitlines(keepends=True)
    if len(old_lines) != len(new_lines) or len(old_records) != len(new_records):
        raise GuardError("canonical-id-repair alterou quantidade de linhas")
    changed = [index for index, pair in enumerate(zip(old_lines, new_lines))
               if pair[0] != pair[1]]
    if len(changed) != 1:
        raise GuardError(
            "canonical-id-repair exige exatamente uma linha alterada")
    index = changed[0]
    old_record = old_records[index]
    new_record = new_records[index]
    old_intent = old_record.get("intent_id")
    new_intent = new_record.get("intent_id")
    if (not isinstance(old_intent, str) or not isinstance(new_intent, str) or
            not old_intent or not new_intent or
            old_intent.strip() != old_intent or
            new_intent.strip() != new_intent):
        raise GuardError("intent_id inválido no canonical-id-repair")
    if (CANONICAL_INTENT_ID.fullmatch(old_intent) is not None or
            new_intent != canonical_intent_fold(old_intent) or
            CANONICAL_INTENT_ID.fullmatch(new_intent) is None or
            old_intent == new_intent):
        raise GuardError("accent-fold canonical-id-repair diverge do NFKD exato")
    old_token = (
        b'"intent_id":' +
        json.dumps(old_intent, ensure_ascii=False, separators=(",", ":")).encode(
            "utf-8"))
    new_token = (
        b'"intent_id":' +
        json.dumps(new_intent, ensure_ascii=False, separators=(",", ":")).encode(
            "utf-8"))
    if (old_lines[index].count(old_token) != 1 or
            new_lines[index].count(new_token) != 1 or
            new_lines[index] != old_lines[index].replace(
                old_token, new_token, 1)):
        raise GuardError("bytes extras no canonical-id-repair")
    restored = dict(new_record)
    restored["intent_id"] = old_intent
    if restored != old_record:
        raise GuardError("campo extra mudou no canonical-id-repair")
    for line_number, (old_item, new_item) in enumerate(
            zip(old_records, new_records), 1):
        assert_public_state_closed(old_item, f"{path}:{line_number}:old")
        assert_public_state_closed(new_item, f"{path}:{line_number}:new")
    return old_intent, new_intent, index + 1


def canonical_tree_entries(
    commit: str,
    directory: str,
    pattern: re.Pattern[str],
    label: str,
) -> dict[str, tuple[str, str, int]]:
    """Inventory one directory completely, keeping mode/OID/size per entry.

    ``-l`` custa nada aqui e elimina um fork ``ls-tree`` POR PATH mais adiante:
    a mesma listagem que autentica o inventário passa a alimentar a leitura de
    blobs em lote.  Entry escondida por filtro continua sendo falha dura.
    """
    output = git([
        "ls-tree", "-r", "-l", "-z", commit, "--", directory,
    ])
    entries: dict[str, tuple[str, str, int]] = {}
    for raw in output.split(b"\0"):
        if not raw:
            continue
        try:
            metadata, raw_path = raw.split(b"\t", 1)
            fields = metadata.decode("ascii").split()
            path = raw_path.decode("utf-8", errors="strict")
        except (UnicodeDecodeError, ValueError) as error:
            raise GuardError(f"inventário {label} possui entry inválida") from error
        if len(fields) != 4:
            raise GuardError(f"inventário {label} possui entry inválida")
        mode, kind, oid, raw_size = fields
        if (pattern.fullmatch(path) is None or kind != "blob" or
                mode != "100644" or OID.fullmatch(oid) is None):
            raise GuardError(
                f"inventário {label} possui path/mode não canônico: {path}")
        if not raw_size.isdigit():
            raise GuardError(f"inventário {label} possui tamanho inválido: {path}")
        size = int(raw_size)
        if size > MAX_FILE_BYTES:
            raise GuardError(f"blob excede limite: {path}")
        if path in entries:
            raise GuardError(f"inventário {label} possui path duplicado")
        entries[path] = (mode, oid, size)
    return entries


def finalized_tree_entries(commit: str) -> dict[str, tuple[str, str, int]]:
    return canonical_tree_entries(
        commit, "data/editorial/v2_pages", FINALIZED, "v2")


def portfolio_tree_entries(commit: str) -> dict[str, tuple[str, str, int]]:
