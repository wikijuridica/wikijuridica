#!/usr/bin/env python3
"""measure-legal-corpus-unblock-20260812 — quantas páginas o corpus destrava, e por diploma.

READ-ONLY. Não escreve em `data/editorial/v2_pages/` e não republica: lê o corpo
VIVO das páginas, extrai as citações com o mesmo extrator do gerador sancionado
(`generate-citation-inventory`) e aplica, sem afrouxar nada, o critério de
`generate-v2-second-official-source-from-corpus-20260806`: faixa comercial com
exatamente uma fonte oficial; o diploma nomeado EXPLICITAMENTE depois do artigo;
o diploma no corpus com `confiavel_para_acusar_divergencia`; o artigo existente
no diploma; página fora de supersessão.

Compara dois corpus — o de antes (cópia preservada) e o de agora — e mostra o
saldo REAL: quantas páginas saem de `diploma_nao_confiavel` E chegam a `ok`, que
não é a mesma coisa (reindexar a partir do texto compilado muda o conjunto de
artigos, e página pode trocar de balde em vez de passar).

Uso:
    tools/measure-legal-corpus-unblock-20260812
    tools/measure-legal-corpus-unblock-20260812 --antes .agents/runtime/backup-legal-corpus-20260812
"""
from __future__ import annotations

import argparse
import collections
import glob
import importlib.machinery
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

SAIDA = ROOT / "data/source-audit/legal_corpus_unblock_measurement_20260812.json"
GENERICOS = {"lei_especifica", "decreto", "lei_complementar", "resolucao", "decreto_lei",
             "portaria", "estatuto_especifico", "medida_provisoria", "instrucao_normativa",
             "convencao_internacional", "regimento"}


def carrega(nome, caminho):
    spec = importlib.util.spec_from_loader(
        nome, importlib.machinery.SourceFileLoader(nome, os.fspath(caminho)))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def corpus_de(diretorio: Path):
    """Mesmo filtro do gerador: só diploma confiável entra."""
    todos, confiaveis = set(), {}
    for caminho in sorted(Path(diretorio).glob("*.json")):
        with open(caminho, encoding="utf-8") as handle:
            dados = json.load(handle)
        slug = dados.get("slug") or caminho.stem
        todos.add(slug)
        if not dados.get("confiavel_para_acusar_divergencia"):
            continue
        if not dados.get("source_url") or not dados.get("fetched_at"):
            continue
        confiaveis[slug] = dados
    return todos, confiaveis


def classifica(alvos, corpus, todos, protegidos, base, gci):
    """intent -> ('ok', diploma) ou (motivo, diploma)."""
    veredito = {}
    for intent, citacoes in alvos.items():
        if intent in protegidos:
            veredito[intent] = ("supersessao", "")
            continue
        melhor = None
        for cit in citacoes:
            diploma = cit.get("diploma") or ""
            artigo = (cit.get("article") or "").replace(".", "").upper()
            if not diploma:
                motivo = "diploma_nao_identificado"
            elif diploma in GENERICOS:
                motivo = "diploma_generico_nao_nomeado"
            elif diploma not in todos:
                motivo = "diploma_fora_do_corpus"
            elif diploma not in corpus:
                motivo = "diploma_nao_confiavel"
            elif not artigo or artigo not in corpus[diploma]["articles"]:
                motivo = "artigo_ausente_no_corpus"
            elif not base.diploma_explicito(gci, cit.get("claim") or "", cit.get("article") or ""):
                motivo = "citacao_nao_explicita"
            else:
                melhor = ("ok", diploma)
                break
            ordem = ("diploma_nao_confiavel", "artigo_ausente_no_corpus",
                     "citacao_nao_explicita", "diploma_fora_do_corpus",
                     "diploma_generico_nao_nomeado", "diploma_nao_identificado")
            if melhor is None or ordem.index(motivo) < ordem.index(melhor[0]):
                melhor = (motivo, diploma)
        veredito[intent] = melhor or ("sem_citacao_no_corpo", "")
    return veredito


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--antes", default=".agents/runtime/backup-legal-corpus-20260812")
    args = parser.parse_args()

    base = carrega("g20260806",
                   ROOT / "tools/generate-v2-second-official-source-from-corpus-20260806")
    gci = carrega("gci", ROOT / "tools/generate-citation-inventory")
    protegidos = base.intents_protegidos()

    # ALVO: faixa comercial com exatamente uma fonte oficial, lido do corpo VIVO.
    alvos = {}
    paginas = 0
    for caminho in sorted(glob.glob(os.fspath(ROOT / "data/editorial/v2_pages/*.jsonl"))):
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                registro = json.loads(linha)
                paginas += 1
                if registro.get("lane") != "comercial":
                    continue
                if len(registro.get("official_sources") or []) != 1:
                    continue
                # Mesma forma que `generate-v2-fonte-do-corpus-com-status-20260812`
                # entrega ao extrator, sobre o corpo VIVO do registro.
                corpo = {"summary": registro.get("opening"),
                         "body_sections": [{"title": s.get("heading"), "body": s.get("text")}
                                           for s in registro.get("sections") or []],
                         "faq": [{"question": i.get("q"), "answer": i.get("a")}
                                 for i in registro.get("faq") or []]}
                alvos[registro["intent_id"]] = gci.extract(corpo)

    todos_antes, corpus_antes = corpus_de(ROOT / args.antes)
    todos_agora, corpus_agora = corpus_de(ROOT / "data/legal-corpus")
    antes = classifica(alvos, corpus_antes, todos_antes, protegidos, base, gci)
    agora = classifica(alvos, corpus_agora, todos_agora, protegidos, base, gci)

    def conta(v):
        return collections.Counter(m for m, _ in v.values())

    bloqueadas_antes = {i for i, (m, _) in antes.items() if m == "diploma_nao_confiavel"}
    por_diploma_antes = collections.Counter(
        d for i, (m, d) in antes.items() if m == "diploma_nao_confiavel")
    destino = collections.Counter(agora[i][0] for i in bloqueadas_antes)
    liberadas = {i for i in bloqueadas_antes if agora[i][0] == "ok"}
    liberadas_por_diploma = collections.Counter(antes[i][1] for i in liberadas)
    presas_por_diploma = collections.Counter(
        antes[i][1] for i in bloqueadas_antes if i not in liberadas)

    print("páginas lidas do estoque vivo : %d" % paginas)
    print("faixa comercial com 1 fonte   : %d" % len(alvos))
    print("\n=== ANTES x AGORA (motivo dominante por página) ===")
    ca, cg = conta(antes), conta(agora)
    for motivo in sorted(set(ca) | set(cg), key=lambda m: -(cg[m] + ca[m])):
        print("  %-28s %5d -> %5d  (%+d)" % (motivo, ca[motivo], cg[motivo],
                                             cg[motivo] - ca[motivo]))
    print("\n=== as %d páginas de `diploma_nao_confiavel` ===" % len(bloqueadas_antes))
    for motivo, quantas in destino.most_common():
        print("  para %-26s %5d" % (motivo, quantas))
    print("\n=== por diploma ===")
    print("  %-16s %8s %10s %8s" % ("diploma", "presas", "liberadas", "restam"))
    for diploma, quantas in por_diploma_antes.most_common():
        print("  %-16s %8d %10d %8d" % (diploma, quantas, liberadas_por_diploma[diploma],
                                        presas_por_diploma[diploma]))

    payload = {
        "ferramenta": "measure-legal-corpus-unblock-20260812",
        "corpus_antes": args.antes,
        "corpus_agora": "data/legal-corpus",
        "paginas_lidas": paginas,
        "comerciais_com_uma_fonte": len(alvos),
        "motivos_antes": dict(ca),
        "motivos_agora": dict(cg),
        "bloqueadas_por_diploma_nao_confiavel": len(bloqueadas_antes),
        "destino_das_bloqueadas": dict(destino),
        "por_diploma_presas": dict(por_diploma_antes),
        "por_diploma_liberadas": dict(liberadas_por_diploma),
        "por_diploma_restam": dict(presas_por_diploma),
        "aviso": ("liberação é simulação de critério: a página só passa de fato depois de "
                  "`legal_corpus_live_verification` refeita para as URLs que mudaram e da "
                  "reingestão"),
    }
    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    with open(SAIDA, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=1, sort_keys=True)
    print("\nevidência: %s" % os.path.relpath(SAIDA, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
