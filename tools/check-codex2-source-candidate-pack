#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# Mesmo defeito de escala corrigido no irmao tools/check-codex2-source-frontier
# (auditoria 2026-07-29): o contract test roda solto, fora de
# tools/run-heavy-throttled, sem lock, sem teto de tempo e sem entrada no ledger
# de comandos — N agentes chamando este check em paralelo recompilavam
# ./internal/contract/codex2 ao mesmo tempo. Precedente vivo do padrao (test caro
# + gate, ambos throttled): tools/check-authorial-mass-global-similarity-audit.
# `go-modern test ./internal/...` nao dispara o gate de "project heavy command"
# do run-heavy-throttled (que so casa ./cmd/generate*|check*|probe-*), entao
# envolver aqui nao introduz exit=2.
# BUDGET_MS herdado do irmao que compila o MESMO ./internal/contract/codex2 (a
# compilacao domina; a validacao em si e in-memory sobre 28 packs). Teto folgado
# de proposito: o timeout efetivo e o MENOR entre BUDGET_MS e TIMEOUT_SECONDS, e
# apertar isso mataria o teste no meio, trocando escala por falso-vermelho.
# Recalibrar a partir da primeira execucao real com --timings.
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-check:codex2-source-candidate-pack:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-540000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-120000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-check_pass_or_report_issues_with_timings}"
./tools/run-heavy-throttled go-modern test -count=1 ./internal/codex2sourcecandidatepack ./internal/contract/codex2 -run TestCodex2SourceCandidatePack
# `--timings` NAO e enfeite: run-heavy-throttled classifica `run-check` como
# comando pesado de projeto e EXIGE evidencia de tempo antes de pegar o lock.
# Sem a flag o envelope aborta com exit 2 -- "missing: timing_evidence" -- e
# este gate ficava IMPOSSIVEL de executar por qualquer um, sempre vermelho por
# um motivo que nada tem a ver com a saude do repositorio (medido na
# remedicao da bateria, BUG-109, 2026-08-29). O comentario acima deste bloco
# afirmava que envolver aqui "nao introduz exit=2": ele valia so para a linha
# de `go-modern test`, nao para esta. O irmao sancionado
# tools/check-authorial-mass-global-similarity-audit ja passa a flag.
exec ./tools/run-heavy-throttled "$ROOT/tools/run-check" codex2-source-candidate-pack --timings "$@"
