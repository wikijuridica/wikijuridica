def candidato_demanda_de_agente(evento, dias_lidos):
    if not evento or evento["requisicoes"] <= 0:
        return None
    req = evento["requisicoes"]
    ag = evento["agentes_de_ia"]
    hu = evento["humano_estimado"]
    pct_ag = ag / req
    pct_hu = hu / req
    pct_md = evento["pct_markdown_soma"] / req if req else 0.0
    if ag >= MIN_REQUISICOES_AGENTE and pct_ag >= LIMIAR_PCT_AGENTE:
        evidencia = {
            "janela_dias_lidos": len(dias_lidos), "dias_com_dado": evento["dias_com_dado"],
            "requisicoes": req, "agentes_de_ia": ag, "humano_estimado": hu,
            "pct_agentes_de_ia": round(pct_ag, 4), "pct_markdown_da_pagina_medio": round(pct_md, 4),
        }
        patch = (
            "Agentes de IA fizeram %d de %d requisicoes (%.0f%%) nos ultimos %d dia(s); "
            "humanos, %d. Adicionar contexto mais denso na gemea Markdown (secao "
            "'Percursos por fundamento legal' e FAQ) sem exceder o teto de 50 KB do HTML "
            "humano (CLAUDE.md secao 6 e 7)." % (ag, req, pct_ag * 100, len(dias_lidos), hu)
        )
        return "agentes_leem_humanos_nao", evidencia, patch
    if hu >= MIN_REQUISICOES_HUMANO and pct_hu >= LIMIAR_PCT_HUMANO:
        evidencia = {
            "janela_dias_lidos": len(dias_lidos), "dias_com_dado": evento["dias_com_dado"],
            "requisicoes": req, "agentes_de_ia": ag, "humano_estimado": hu,
            "pct_humano": round(pct_hu, 4), "pct_markdown_da_pagina_medio": round(pct_md, 4),
        }
        patch = (
            "Humanos fizeram %d de %d requisicoes (%.0f%%) nos ultimos %d dia(s); agentes de "
            "IA, %d. Reforcar estrutura para IA (FAQ com H3 correspondente e secao de "
            "percursos por fundamento legal na gemea Markdown) sem reduzir o conteudo "
            "humano." % (hu, req, pct_hu * 100, len(dias_lidos), ag)
        )
        return "humanos_leem_agentes_nao", evidencia, patch
    return None


def candidato_corpo_curto(sev):
    if not sev or sev.get("severity") != "medio":
        return None
    wc = sev.get("word_count")
    if not isinstance(wc, int) or wc >= LIMIAR_WORD_COUNT_CURTO:
        return None
    evidencia = {
        "word_count": wc, "limiar_word_count": LIMIAR_WORD_COUNT_CURTO,
        "sections": sev.get("sections"), "official_sources": sev.get("official_sources"),
    }
    patch = (
        "Corpo publicado tem %d palavras (abaixo do piso de %d da severidade media), em %s "
        "secao(oes) com %s fonte(s) oficial(is) ja citada(s). Expandir com contexto autoral "
        "e fundamentacao adicional apoiada nas mesmas fontes, sem thin content nem "
        "permutacao de palavra-chave (CLAUDE.md secao 8)."
        % (wc, LIMIAR_WORD_COUNT_CURTO, sev.get("sections"), sev.get("official_sources"))
    )
    return "corpo_curto", evidencia, patch


def candidato_fonte_insuficiente(sev):
    if not sev or sev.get("severity") != "medio":
        return None
    motivos_base = {r.split(":")[0] for r in sev.get("medium_reasons") or []}
    achados = sorted(motivos_base & MOTIVOS_FONTE_INSUFICIENTE)
    if not achados:
        return None
    evidencia = {
        "medium_reasons": achados, "official_sources": sev.get("official_sources"),
    }
    patch = (
        "Severidade media aponta %s com %s fonte(s) oficial(is) hoje. Pesquisar e "
        "acrescentar fonte oficial especifica (URL, data de consulta e hash) alem das ja "
        "citadas, mantendo a separacao entre texto oficial citado e comentario autoral "
        "(CLAUDE.md secao 8, DEC-032)." % (", ".join(achados), sev.get("official_sources"))
    )
    return "fonte_insuficiente", evidencia, patch


