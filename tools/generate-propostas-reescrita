def caminho_pagina_logico(path_bruto):
    """Dobra a gemea Markdown explicita (".../index.md") no path base --
    demanda de agente pela gemea e demanda pela MESMA pagina logica
    (CLAUDE.md secao 7: "mesma pagina, quatro canais")."""
    if path_bruto.endswith("index.md"):
        return path_bruto[: -len("index.md")]
    return path_bruto


def carrega_eventos(root, dias_pedidos, hoje=None):
    """path logico -> {requisicoes, agentes_de_ia, humano_estimado,
    pct_markdown_soma, dias_com_dado}; e a lista de dias efetivamente lidos.

    `hoje` e injetavel (default: data real em UTC) so para o teste poder
    fixar a janela sem depender do relogio da maquina."""
    if hoje is None:
        hoje = datetime.datetime.now(datetime.timezone.utc).date()
    dias_alvo = [
        (hoje - datetime.timedelta(days=i)).isoformat()
        for i in range(max(1, dias_pedidos))
    ]
    dias_lidos = []
    agregados = {}
    for dia in dias_alvo:
        caminho = os.path.join(root, "data", "ops", "eventos", "eventos-%s.jsonl" % dia)
        if not os.path.isfile(caminho):
            continue
        dias_lidos.append(dia)
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                d = json.loads(linha)
                path_bruto = d.get("path")
                if not path_bruto or path_bruto == "_dia":
                    continue
                if d.get("route_class") not in ("page", "markdown"):
                    continue
                path = caminho_pagina_logico(path_bruto)
                req = int(d.get("requisicoes") or 0)
                acc = agregados.setdefault(path, {
                    "requisicoes": 0, "agentes_de_ia": 0, "humano_estimado": 0,
                    "pct_markdown_soma": 0.0, "dias_com_dado": 0,
                })
                acc["requisicoes"] += req
                acc["agentes_de_ia"] += int(d.get("agentes_de_ia") or 0)
                acc["humano_estimado"] += int(d.get("humano_estimado") or 0)
                acc["pct_markdown_soma"] += float(d.get("pct_markdown_da_pagina") or 0.0) * req
                acc["dias_com_dado"] += 1
    return agregados, dias_lidos


def carrega_paginas(root):
    """path -> registro completo de content/pages.json (uma unica leitura)."""
    caminho = os.path.join(root, "content", "pages.json")
    with open(caminho, encoding="utf-8") as handle:
        dados = json.load(handle)
    return {item["path"]: item for item in dados if item.get("path")}


def texto_completo_da_pagina(registro):
    partes = [
        registro.get("title") or "",
        registro.get("meta_description") or "",
        registro.get("heading") or "",
        registro.get("summary") or "",
    ]
    for secao in registro.get("body_sections") or []:
        partes.append(secao.get("title") or "")
        partes.append(secao.get("body") or "")
    for item in registro.get("faq") or []:
        partes.append(item.get("question") or "")
        partes.append(item.get("answer") or "")
    return " ".join(partes)


_RE_PARENTESE_FINAL = re.compile(r"^(?P<classe_numero>.+?)\s*\([^)]*\)\s*$")
_RE_NUMERO_FINAL = re.compile(r"(\d[\d.]*\d|\d)\s*$")


def extrai_processo(rotulo):
    """De 'AgInt no REsp 1953626 (STJ, PRIMEIRA TURMA, 2021-12-13)' devolve
    ('AgInt no REsp 1953626', '1953626'). Sem numero extraivel, devolve
    numero vazio -- o chamador entao NAO pode afirmar que a pagina ja cita
    o acordao, e pula o candidato (corretude > recall)."""
    m = _RE_PARENTESE_FINAL.match(rotulo or "")
    classe_numero = m.group("classe_numero").strip() if m else (rotulo or "").strip()
    m2 = _RE_NUMERO_FINAL.search(classe_numero)
    numero_digits = re.sub(r"\D", "", m2.group(0)) if m2 else ""
    return classe_numero, numero_digits


def carrega_grafo(root, caminho_db=None):
    """pagina_normas: path -> lista ordenada de norma_chave citadas via
    dispositivo. norma_acordaos: norma_chave -> lista ordenada de acordaos
    (com ementa) que citam essa norma inteira OU um dispositivo dela (o campo
    `dispositivos` guarda quais). pagina_dispositivos: path -> set de
    dispositivos citados, para a evidencia `dispositivos_em_comum`.
    dispositivo_acordaos: dispositivo_chave -> lista ordenada de acordaos que
    citam AQUELE ARTIGO -- e o indice que `candidato_precedente` percorre.

    POR QUE O INDICE POR DISPOSITIVO EXISTE (2026-09-16). `norma_acordaos` e
    um indice por NORMA INTEIRA, e norma inteira nao e laco: o CPC sozinho
    puxa dezenas de milhares de acordaos, e percorre-los por pagina fazia o
    cosseno TF-IDF rodar ~10^8 vezes. O gerador simplesmente NAO TERMINAVA
    sobre o corpus atual -- o lote de 2026-09-08 e o unico que existe, e ele
    foi tirado de um grafo menor. O indice por artigo e o mesmo dado visto
    pela chave certa.
    """
    caminho = caminho_db or os.path.join(root, "data", "ai", "grafo.sqlite")
    conn = sqlite3.connect("file:%s?mode=ro" % caminho, uri=True)
    try:
        pagina_normas = {}
        pagina_dispositivos = {}
        for pagina_chave, norma_chave, disp_chave in conn.execute(
            """
            SELECT np.chave, nn.chave, nd.chave
            FROM arestas a
            JOIN nos np ON np.id = a.origem AND np.tipo = 'pagina'
            JOIN nos nd ON nd.id = a.destino AND nd.tipo = 'dispositivo'
            JOIN arestas b ON b.origem = nd.id AND b.tipo = 'pertence_a'
            JOIN nos nn ON nn.id = b.destino AND nn.tipo = 'norma'
            WHERE a.tipo = 'cita'
            """
        ):
            pagina_normas.setdefault(pagina_chave, set()).add(norma_chave)
            pagina_dispositivos.setdefault(pagina_chave, set()).add(disp_chave)
        pagina_normas = {p: sorted(s) for p, s in pagina_normas.items()}

        norma_acordaos = {}
        # DUAS rotas ate a norma, de proposito. So a primeira (acordao -> norma
        # inteira) deixava 296 de 9.199 acordaos no pool -- as 7.089 arestas
        # acordao -> dispositivo (artigo) nunca viravam candidato, enquanto a
        # pagina sobe por dispositivo -> pertence_a -> norma. A segunda rota
        # traz o laco FORTE (mesmo artigo) e o guarda em `dispositivo`.
        # Refutacao de 2026-09-08.
        vistos = set()
        for acordao_chave, acordao_rotulo, atributos_json, norma_chave, dispositivo in conn.execute(
            """
            SELECT na.chave, na.rotulo, na.atributos, nn.chave, ''
            FROM arestas a
            JOIN nos na ON na.id = a.origem AND na.tipo = 'acordao'
            JOIN nos nn ON nn.id = a.destino AND nn.tipo = 'norma'
            WHERE a.tipo = 'cita'
            UNION ALL
            SELECT na.chave, na.rotulo, na.atributos, nn.chave, nd.chave
            FROM arestas a
            JOIN nos na ON na.id = a.origem AND na.tipo = 'acordao'
            JOIN nos nd ON nd.id = a.destino AND nd.tipo = 'dispositivo'
            JOIN arestas b ON b.origem = nd.id AND b.tipo = 'pertence_a'
            JOIN nos nn ON nn.id = b.destino AND nn.tipo = 'norma'
            WHERE a.tipo = 'cita'
            """
        ):
            if (acordao_chave, norma_chave) in vistos:
                if dispositivo:
                    for r in norma_acordaos.get(norma_chave, ()):
                        if r["acordao_chave"] == acordao_chave:
                            r["dispositivos"].add(dispositivo)
                continue
            vistos.add((acordao_chave, norma_chave))
            atributos = json.loads(atributos_json) if atributos_json else {}
            ementa = (atributos.get("ementa") or "").strip()
            if not ementa:
                continue
            classe_numero, numero_digits = extrai_processo(acordao_rotulo)
            if not numero_digits:
                continue
            norma_acordaos.setdefault(norma_chave, []).append({
                "norma_chave": norma_chave,
                "acordao_chave": acordao_chave,
                "acordao_rotulo": acordao_rotulo,
                "classe": atributos.get("classe"),
                "numero_registro": atributos.get("numero_registro"),
                "relator": atributos.get("relator"),
                "ementa": ementa,
                "fonte_url": atributos.get("fonte_url"),
                "sha256_conteudo": atributos.get("sha256_conteudo"),
                "classe_numero": classe_numero,
                "numero_digits": numero_digits,
                "dispositivos": {dispositivo} if dispositivo else set(),
            })
        for norma_chave in norma_acordaos:
            norma_acordaos[norma_chave].sort(key=lambda r: r["acordao_chave"])
        dispositivo_acordaos = {}
        for acordaos in norma_acordaos.values():
            for ac in acordaos:
                for disp in ac["dispositivos"]:
                    dispositivo_acordaos.setdefault(disp, []).append(ac)
        for disp in dispositivo_acordaos:
            dispositivo_acordaos[disp].sort(key=lambda r: r["acordao_chave"])
        return pagina_normas, norma_acordaos, pagina_dispositivos, dispositivo_acordaos
    finally:
        conn.close()


