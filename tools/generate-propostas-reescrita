def gera_propostas(root, dias_pedidos, limite, grafo_db=None, timings=False, hoje=None, similaridade_minima=0.0):
    t0 = time.monotonic()
    manifest = carrega_manifest(root)
    if timings:
        print("propostas-reescrita: manifest lido em %.3fs (%d paginas)"
              % (time.monotonic() - t0, len(manifest)), file=sys.stderr)

    t1 = time.monotonic()
    severidade = carrega_severidade(root)
    if timings:
        print("propostas-reescrita: severidade lida em %.3fs (%d registros)"
              % (time.monotonic() - t1, len(severidade)), file=sys.stderr)

    t2 = time.monotonic()
    eventos, dias_lidos = carrega_eventos(root, dias_pedidos, hoje=hoje)
    if timings:
        print("propostas-reescrita: eventos lidos em %.3fs (%d paginas com trafego, dias=%s)"
              % (time.monotonic() - t2, len(eventos), dias_lidos), file=sys.stderr)

    t3 = time.monotonic()
    paginas = carrega_paginas(root)
    if timings:
        print("propostas-reescrita: pages.json lido em %.3fs (%d paginas)"
              % (time.monotonic() - t3, len(paginas)), file=sys.stderr)

    t4 = time.monotonic()
    pagina_normas, norma_acordaos, pagina_dispositivos, dispositivo_acordaos = carrega_grafo(root, grafo_db)
    if timings:
        pares = sum(len(dispositivo_acordaos.get(d) or set())
                    for disps in pagina_dispositivos.values() for d in disps)
        print("propostas-reescrita: grafo lido em %.3fs (%d paginas com norma citada, %d normas com acordao, "
              "%d dispositivos com acordao, %d pagina(s) com dispositivo citado, %d par(es) a avaliar)"
              % (time.monotonic() - t4, len(pagina_normas), len(norma_acordaos), len(dispositivo_acordaos),
                 len(pagina_dispositivos), pares), file=sys.stderr)

    max_agentes_de_ia = max([e["agentes_de_ia"] for e in eventos.values()] or [0]) or 1

    brutos = []  # (path, intent_id, title, motivo, evidencia, patch, demanda_agentes)
    cache_texto = {}
    similaridade = monta_similaridade(paginas, pagina_normas, norma_acordaos)
    for intent_id in sorted(manifest):
        info = manifest[intent_id]
        path = info["path"]
        if not path:
            continue
        sev = severidade.get(intent_id)
        evento = eventos.get(path)
        demanda_agentes = evento["agentes_de_ia"] if evento else 0

        c = candidato_demanda_de_agente(evento, dias_lidos)
        if c:
            motivo, evidencia, patch = c
            exige_numero_medido(evidencia)
            brutos.append((path, intent_id, info["title"], motivo, evidencia, patch, demanda_agentes))

        c = candidato_corpo_curto(sev)
        if c:
            motivo, evidencia, patch = c
            exige_numero_medido(evidencia)
            brutos.append((path, intent_id, info["title"], motivo, evidencia, patch, demanda_agentes))

        c = candidato_fonte_insuficiente(sev)
        if c:
            motivo, evidencia, patch = c
            exige_numero_medido(evidencia)
            brutos.append((path, intent_id, info["title"], motivo, evidencia, patch, demanda_agentes))

        registro_pagina = paginas.get(path)
        if registro_pagina:
            c = candidato_precedente(path, registro_pagina, dispositivo_acordaos, cache_texto, similaridade, similaridade_minima, pagina_dispositivos)
            if c:
                motivo, evidencia, patch = c
                exige_numero_medido(evidencia)
                brutos.append((path, intent_id, info["title"], motivo, evidencia, patch, demanda_agentes))

    agora = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    propostas = []
    for path, intent_id, title, motivo, evidencia, patch, demanda_agentes in brutos:
        demanda_norm = min(1.0, demanda_agentes / max_agentes_de_ia)
        prioridade = round(min(1.0, PESO_MOTIVO[motivo] * (0.6 + 0.4 * demanda_norm)), 4)
        proposta_id = hashlib.sha256(("%s|%s" % (path, motivo)).encode("utf-8")).hexdigest()[:16]
        propostas.append({
            "schema_version": SCHEMA,
            "id": proposta_id,
            "path": path,
            "intent_id": intent_id,
            "title": title,
            "motivo": motivo,
            "evidencia": evidencia,
            "prioridade": prioridade,
            "patch_sugerido": patch,
            "aplicar_por": APLICAR_POR,
            "publicacao": PUBLICACAO,
            "gerado_em": agora,
        })

    propostas.sort(key=lambda p: (-p["prioridade"], p["path"], p["motivo"]))
    selecionadas = propostas[:limite]

    contagem_motivo = {}
    for p in propostas:
        contagem_motivo[p["motivo"]] = contagem_motivo.get(p["motivo"], 0) + 1

    print("propostas-reescrita: precedentes descartados por similaridade < %.2f: %d (propostos: %d)"
          % (similaridade_minima, similaridade.descartados_por_similaridade,
             sum(1 for b in brutos if b[3] == "precedente_disponivel_nao_citado")), file=sys.stderr)
    return selecionadas, contagem_motivo, len(propostas)


def escreve_atomico(caminho, conteudo_bytes):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    temporario = caminho + ".tmp"
    with open(temporario, "wb") as handle:
        handle.write(conteudo_bytes)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporario, caminho)


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=raiz_padrao())
    ap.add_argument("--dias", type=int, default=7, help="janela de dias dos eventos (padrao 7)")
    ap.add_argument("--limite", type=int, default=100, help="teto de propostas na saida (padrao 100)")
    ap.add_argument("--saida", default=None, help="caminho de saida (padrao data/ai/propostas_reescrita.jsonl)")
    ap.add_argument("--grafo-db", default=None, help="override de data/ai/grafo.sqlite (uso em teste)")
    ap.add_argument("--similaridade-minima", type=float, default=SIMILARIDADE_MINIMA_PADRAO,
                    help="cosseno TF-IDF minimo entre ementa e pagina para propor precedente (padrao %.2f, escolhido sobre a distribuicao medida)" % SIMILARIDADE_MINIMA_PADRAO)
    ap.add_argument("--timings", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    t_geral = time.monotonic()
    root = args.root
    saida = args.saida or os.path.join(root, "data", "ai", "propostas_reescrita.jsonl")

    selecionadas, contagem_motivo, total_bruto = gera_propostas(
        root, args.dias, args.limite, grafo_db=args.grafo_db, timings=args.timings, similaridade_minima=args.similaridade_minima)

    conteudo = "".join(
        json.dumps(p, ensure_ascii=False, sort_keys=True) + "\n" for p in selecionadas
    ).encode("utf-8")

    if args.dry_run:
        print("propostas-reescrita: [dry-run] %d propostas (de %d candidatas) -> %s"
              % (len(selecionadas), total_bruto, saida))
    else:
        escreve_atomico(saida, conteudo)
        print("propostas-reescrita: %d propostas (de %d candidatas) escritas em %s"
              % (len(selecionadas), total_bruto, saida))

    print("propostas-reescrita: por motivo (candidatas antes do teto): %s"
          % json.dumps(contagem_motivo, ensure_ascii=False, sort_keys=True))
    sims = sorted(p["evidencia"]["similaridade_tfidf"] for p in selecionadas if p["motivo"] == "precedente_disponivel_nao_citado")
    if sims:
        print("propostas-reescrita: similaridade TF-IDF dos precedentes propostos: n=%d min=%.3f p25=%.3f mediana=%.3f p75=%.3f max=%.3f (minimo aplicado %.2f)"
              % (len(sims), sims[0], sims[len(sims) // 4], sims[len(sims) // 2], sims[(3 * len(sims)) // 4], sims[-1], args.similaridade_minima))
    for p in selecionadas[:5]:
        print("propostas-reescrita: top -> %s | %s | prioridade=%.4f | %s"
              % (p["path"], p["motivo"], p["prioridade"],
                 json.dumps(p["evidencia"], ensure_ascii=False, sort_keys=True)))

    if args.timings:
        print("propostas-reescrita: total em %.3fs" % (time.monotonic() - t_geral), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
