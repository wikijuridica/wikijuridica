def _tokens(texto):
    """Minusculas, sem acento, palavras de 3+ letras fora da lista vazia e
    numeros de 3+ digitos (sem ponto de milhar: "1.694" -> "n1694") -- o numero
    do artigo e o portador do tema em texto juridico, e a versao anterior o
    descartava (refutacao de 2026-09-08)."""
    folded = unicodedata.normalize("NFKD", texto or "").encode("ascii", "ignore").decode().lower()
    folded = re.sub(r"(\d)\.(\d{3})", r"\1\2", folded)
    saida = []
    for t in re.findall(r"[a-z]{3,}|\d{3,}", folded):
        if t.isdigit():
            saida.append("n" + t)
        elif t not in _PALAVRAS_VAZIAS:
            saida.append(t)
    return saida


class SimilaridadeTFIDF:
    """Vetores TF-IDF (tf logaritmico, idf suavizado, norma L2) sobre os
    documentos adicionados; cosseno entre dois ids. IDF fecha na primeira
    consulta — adicionar depois e erro de uso."""

    def __init__(self):
        self._contagens = {}
        self._df = collections.Counter()
        self._vetores = {}
        self.descartados_por_similaridade = 0

    def adiciona(self, doc_id, texto):
        if doc_id in self._contagens:
            return
        if self._vetores:
            raise RuntimeError("SimilaridadeTFIDF: idf ja fechado; adicione todos os documentos antes de consultar")
        toks = collections.Counter(_tokens(texto))
        self._contagens[doc_id] = toks
        for t in toks:
            self._df[t] += 1

    def _vetor(self, doc_id):
        v = self._vetores.get(doc_id)
        if v is not None:
            return v
        toks = self._contagens.get(doc_id)
        if not toks:
            self._vetores[doc_id] = {}
            return {}
        n = len(self._contagens)
        v = {t: (1.0 + math.log(c)) * (math.log((n + 1.0) / (self._df[t] + 1.0)) + 1.0) for t, c in toks.items()}
        norma = math.sqrt(sum(x * x for x in v.values())) or 1.0
        v = {t: x / norma for t, x in v.items()}
        self._vetores[doc_id] = v
        return v

    def cosseno(self, a, b):
        va, vb = self._vetor(a), self._vetor(b)
        if len(va) > len(vb):
            va, vb = vb, va
        return round(sum(x * vb.get(t, 0.0) for t, x in va.items()), 4)


def monta_similaridade(paginas, pagina_normas, norma_acordaos):
    """IDF sobre as paginas com norma citada + todas as ementas candidatas."""
    sim = SimilaridadeTFIDF()
    for path in pagina_normas:
        registro = paginas.get(path)
        if registro:
            sim.adiciona("p:" + path, texto_completo_da_pagina(registro))
    for acordaos in norma_acordaos.values():
        for ac in acordaos:
            sim.adiciona("a:" + ac["acordao_chave"], ac.get("ementa") or "")
    return sim


# MEDIDO em 2026-09-08 (dry-run, 3 dias, 100 propostas de precedente sem minimo):
# a MELHOR similaridade de cada pagina com seus candidatos deu min 0,000, p25
# 0,004, mediana 0,020, p75 0,034, max 0,084 — isto e, a fila inteira de
# precedentes era par sem vocabulario em comum alem da norma. Com 0,15 sobram 10
# (0,150–0,186), todas em paginas de jurisprudencia/glossario tributario, que e o
# que a Primeira Turma julga. O piso e deliberadamente alto: precedente errado
# custa mais que precedente ausente. O 0,15 e ESCOLHA sobre essa distribuicao
# medida, nao um numero medido: acima dele so ficou par com vocabulario proprio
# em comum; mexer aqui exige nova distribuicao.
SIMILARIDADE_MINIMA_PADRAO = 0.15

# O LACO E O DISPOSITIVO, NUNCA A NORMA INTEIRA (2026-09-16).
#
# Ate esta data o candidato vinha de `norma_acordaos`: todo acordao que citasse
# a mesma NORMA que a pagina cita. Dois defeitos num so indice.
#
# (1) DESEMPENHO, e e por isso que o gerador nao terminava. O CPC sozinho reune
#     dezenas de milhares de acordaos; percorrer isso por pagina punha o cosseno
#     TF-IDF na casa de 10^8 chamadas. O lote de 2026-09-08 (100 propostas) e o
#     unico que existe porque o corpus era menor -- nao porque alguem decidiu
#     parar.
# (2) ATRIBUICAO, que e o defeito caro. "A pagina cita o Codigo Civil e este
#     acordao tambem" nao e precedente: e coincidencia de diploma. O piso de
#     0,20 que este arquivo aplicava aos pares so-norma era remendo sobre o
#     indice errado, e ainda assim 37 das 100 propostas do lote de 2026-09-08
#     nasceram sem UM artigo em comum (medido no proprio JSONL). Precedente mal
#     atribuido e o P1 permanente do CLAUDE.md secao 5.
#
# O que ISSO NAO E: poda por area. Toda area do Direito continua elegivel --
# o filtro e sobre o LACO entre pagina e acordao, nao sobre a materia.


def candidato_precedente(path, registro_pagina, dispositivo_acordaos, cache_texto, similaridade=None, similaridade_minima=0.0, pagina_dispositivos=None):
    disp_pagina = set((pagina_dispositivos or {}).get(path, set()))
    if not disp_pagina:
        return None
    if path not in cache_texto:
        texto = texto_completo_da_pagina(registro_pagina)
        cache_texto[path] = (texto.lower(), re.sub(r"\D", "", texto))
    texto_lower, texto_digits = cache_texto[path]
    # Um acordao por chave: o mesmo acordao citando duas normas da pagina
    # entrava duas vezes e inflava candidatos_avaliados (e fazia a "segunda
    # similaridade" ser ele mesmo — achado do revisor em 2026-09-08).
    por_acordao = {}
    for disp_chave in sorted(disp_pagina):
        for ac in dispositivo_acordaos.get(disp_chave) or []:
            if ac["numero_digits"] in texto_digits or ac["classe_numero"].lower() in texto_lower:
                continue
            chave = ac["acordao_chave"]
            if chave not in por_acordao:
                score = similaridade.cosseno("p:" + path, "a:" + chave) if similaridade else 0.0
                por_acordao[chave] = [score, chave, set(), ac]
            por_acordao[chave][2].add(ac["norma_chave"])
    if not por_acordao:
        return None
    # Piso unico (amostra por faixa de 2026-09-08, data/ops/precedentes_amostra_por_faixa_daily.jsonl):
    # com dispositivo em comum, todo par >= 0,15 da amostra era do mesmo tema.
    # O piso de 0,20 que existia para o par so-norma morreu junto com a rota
    # so-norma: aqui, por construcao, todo candidato compartilha um artigo.
    candidatos = sorted(por_acordao.values(), key=lambda c: (-c[0], c[1]))
    # minimo 0 = so ranquear, sem piso nenhum (uso de biblioteca e teste); a CLI
    # sempre passa um minimo > 0.
    if similaridade is not None and similaridade_minima > 0:
        aptos = [c for c in candidatos if c[0] >= similaridade_minima]
        if not aptos:
            similaridade.descartados_por_similaridade += 1
            return None
        candidatos = aptos + [c for c in candidatos if c[0] < similaridade_minima]
    score, _, normas_em_comum, ac = candidatos[0]
    normas_em_comum = sorted(normas_em_comum)
    norma_chave = normas_em_comum[0]
    evidencia = {
        "norma_citada_pela_pagina": norma_chave,
        "acordaos_disponiveis_por_dispositivo": sum(
            len(dispositivo_acordaos.get(d) or []) for d in sorted(disp_pagina)),
        "acordao_chave": ac["acordao_chave"],
        "acordao_rotulo": ac["acordao_rotulo"],
        "acordao_relator": ac["relator"],
        "fonte_url": ac["fonte_url"],
        "sha256_conteudo": ac["sha256_conteudo"],
        "numero_processo_extraido": ac["numero_digits"],
        "normas_em_comum": normas_em_comum,
        "dispositivos_em_comum": sorted((ac.get("dispositivos") or set()) & disp_pagina),
        "similaridade_tfidf": score,
        "candidatos_avaliados": len(candidatos),
        "segunda_similaridade": candidatos[1][0] if len(candidatos) > 1 else 0.0,
    }
    patch = (
        "Pagina cita %s mas nao menciona o acordao %s, disponivel no grafo "
        "(data/ai/grafo.sqlite) com ementa e ja associado a essa norma. Conferir a "
        "fonte oficial (%s, sha256 %s...) e, se pertinente, citar o acordao como "
        "precedente identificado, em bloco proprio separado do comentario autoral "
        "(CLAUDE.md secao 8, DEC-032)."
        % (norma_chave, ac["acordao_rotulo"], ac["fonte_url"],
           (ac["sha256_conteudo"] or "")[:12])
    )
    patch += (" Similaridade TF-IDF ementa x pagina: %.3f (melhor de %d candidato(s); segunda: %.3f); "
              "abaixo de %.2f o gerador nem propoe." % (score, len(candidatos), evidencia["segunda_similaridade"], similaridade_minima))
    return "precedente_disponivel_nao_citado", evidencia, patch



