def raiz_padrao():
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def exige_numero_medido(evidencia):
    """Recusa evidencia sem nenhum numero medido -- regra literal do mandato:
    'nenhuma proposta sem pelo menos um numero medido'."""
    for valor in evidencia.values():
        if isinstance(valor, bool):
            continue
        if isinstance(valor, (int, float)):
            return
    raise AssertionError("evidencia sem numero medido: %r" % (evidencia,))


