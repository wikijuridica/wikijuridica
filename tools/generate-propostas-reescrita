def carrega_manifest(root):
    """unique_intent_id -> {path, title}."""
    caminho = os.path.join(root, "data", "editorial", "published_manifest.jsonl")
    out = {}
    with open(caminho, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if not linha:
                continue
            d = json.loads(linha)
            intent_id = d.get("unique_intent_id")
            if not intent_id or d.get("page_status") != "published":
                continue
            out[intent_id] = {"path": d.get("path"), "title": d.get("title")}
    return out


def carrega_severidade(root):
    """intent_id -> registro (so os campos usados como evidencia)."""
    caminho = os.path.join(root, "data", "editorial", "v2_publication_severity.jsonl")
