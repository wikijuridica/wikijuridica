#!/usr/bin/env python3
"""check-bot-ip-ranges-frescor — a idade DECLARADA das faixas de IP de crawler.

READ-ONLY (convenção `tools/check-*`): lê `data/ops/bot_ip_ranges/*.json` e não
escreve nada.

POR QUE ELE EXISTE. Toda medição de bot deste repositório separa "é mesmo o
Googlebot" de "é alguém escrevendo Googlebot no User-Agent" conferindo o IP
contra essas faixas — contar por string de User-Agent infla (medido: 3.535
linhas por string contra 20 com IP conferido). Faixa vencida não deixa nada
vermelho: o bot legítimo que trocou de bloco simplesmente cai fora de todos os
prefixos, é contado como não-verificável, e a série conclui "o bot sumiu".
Ausência de dado é indistinguível de ausência do fato — por isso a idade precisa
de gate próprio.

POR QUE `fetched_at`, E NÃO O QUE JÁ EXISTIA.

  - mtime (`check-bot-telemetry-honesty:332`, limiar de 7 dias) é metadado de
    sistema de arquivos. `git clone`, `git checkout`, `cp` e `rsync` reescrevem
    os doze mtimes para o instante da cópia, e um `touch` falsifica todos em um
    comando. Ele mede a data da CÓPIA, não a da COLETA. Esta perna é
    complementar, não substituta: as duas medem coisas diferentes.

  - `creation_time_upstream` é a data em que o OPERADOR montou a lista, e não
    tem relação com a nossa. Medido em 2026-08-28, nos 12 arquivos, ordenados
    por idade: perplexitybot 2025-02-07 (567 d), perplexity-user 2025-10-17
    (315 d), openai-gptbot 2025-10-30 (302 d), openai-searchbot 2026-01-02
    (238 d), openai-adsbot 2026-05-12 (108 d) — e bingbot 2024-01-03, que sozinho
    tem 968 dias. São SEIS arquivos com mais de 100 dias de `creationTime`, e
    CINCO com mais de meio ano, todos rigorosamente em dia do nosso lado.

    A primeira redação deste cabeçalho dizia "quatro" e enumerava quatro,
    omitindo `perplexity-user.json`. Número que não reproduz é número inventado
    (R3), e num cabeçalho que vai a commit ele vira a próxima medição errada de
    alguém. Um detector de frescor que lesse esse campo reprovaria 5 dos 12 pelo
    critério de meio ano — 7 pelo de trinta dias —, e é esse o falso positivo que
    `tools/test_check_bot_ip_ranges_frescor.py` fixa como caso inocente.

O LIMIAR, E DE ONDE VEM O NÚMERO. Padrão 3 dias, derivado da cadência REAL de
publicação do operador mais rápido, não de gosto. Medido no histórico do
`creation_time_upstream` do arquivo do Google (`git log` de
`data/ops/bot_ip_ranges/googlebot.json`): 2026-08-07T14:45:43, 2026-08-11T14:45:51,
2026-08-19T14:46:11, 2026-08-26T14:46:15, 2026-08-27T14:46:16 — o Google
republica a lista TODO DIA, por volta de 14:46 UTC (a própria doc de crawlers
comuns pede releitura diária), e ela responde por 1.641 dos 2.450 prefixos deste
diretório. Contra isso, `wikijuridica-bot-ipranges.timer` roda `OnUnitActiveSec=1d`
com `RandomizedDelaySec=10min`. Três dias é, então, o ponto em que DUAS coletas
diárias consecutivas falharam — ruído de uma noite não fica vermelho, e uma fonte
quebrada não passa a semana em silêncio. É mais apertado que os 7 dias do mtime
de propósito: aquele limiar foi calibrado quando nada agendava a coleta.

CÓDIGO DE SAÍDA (regra da casa):
  0  todas as faixas dentro do limiar.
  1  VEREDITO MEDIDO — alguma faixa vencida, sem `fetched_at`, com carimbo
     ilegível ou no futuro. É o que esta ferramenta existe para encontrar.
  2  NÃO CONSEGUI MEDIR — diretório ausente, nenhum arquivo de faixa legível,
     JSON inválido. Nunca se confunde com o 1: "a faixa está velha" e "não
     consegui abrir a faixa" pedem ações diferentes de quem lê o exit.
"""

import argparse
import datetime
import json
import os
import sys

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
FAIXAS_PADRAO = os.path.join(RAIZ, "data/ops/bot_ip_ranges")

# Ver o bloco "O LIMIAR" no cabeçalho: 3 dias = duas coletas diárias
# consecutivas perdidas, com o Google republicando diariamente.
MAX_DIAS_PADRAO = 3.0

# Tolerância para carimbo adiante do relógio. Não é folga de agenda — é a margem
# de um passo de NTP. Acima disso, um `fetched_at` no futuro só pode vir de
# relógio errado ou de arquivo editado à mão, e nos dois casos a idade que o
# gate calcularia seria mentira, então vira veredito em vez de passar verde.
SKEW_TOLERADO_S = 300


def carregar(caminho):
    """(registro, erro_de_leitura). Erro aqui é sempre 'não consegui medir'."""
    try:
        with open(caminho, encoding="utf-8") as handle:
            dados = json.load(handle)
    except OSError as erro:
        return None, "ilegivel: %s" % erro
    except ValueError as erro:
        return None, "JSON invalido: %s" % str(erro)[:120]
    if not isinstance(dados, dict):
        return None, "JSON nao e objeto (%s)" % type(dados).__name__
    return dados, ""


def e_arquivo_de_faixa(registro):
    """Distingue faixa de qualquer outro JSON que apareça no diretório.

    Guarda de FALSO POSITIVO: o dia em que alguém deixar um índice ou uma nota
    ao lado das faixas, esse arquivo não tem `fetched_at` e seria reprovado como
    "faixa sem idade declarada" — acusando um arquivo que nunca prometeu ser uma
    faixa. O critério é o que o gerador sempre escreve: `operator` mais a lista
    `prefixes`.
    """
    return (isinstance(registro.get("operator"), str)
            and isinstance(registro.get("prefixes"), list))


def idade_em_dias(registro, agora):
    """(dias, problema). `problema` != "" é veredito, nunca falha de medição."""
    bruto = registro.get("fetched_at")
    if not bruto:
        return None, "sem campo fetched_at (coletada por versao anterior do gerador)"
    if not isinstance(bruto, str):
        return None, "fetched_at nao e texto (%s)" % type(bruto).__name__
    try:
        # Python 3.11 aceita o sufixo `Z` em fromisoformat; o gerador grava
        # exatamente nessa forma, e a forma com `+00:00` continua sendo aceita
        # para não reprovar arquivo escrito por outra ferramenta ISO 8601.
        instante = datetime.datetime.fromisoformat(bruto)
    except ValueError:
        return None, "fetched_at nao e ISO 8601: %r" % bruto[:40]
    if instante.tzinfo is None:
        # Sem fuso não dá para saber se são 3 h a mais ou a menos, e 3 h importa
        # num limiar de dias. Recusar é mais honesto que supor UTC.
        return None, "fetched_at sem fuso horario: %r" % bruto[:40]
    segundos = (agora - instante).total_seconds()
    if segundos < -SKEW_TOLERADO_S:
        return None, "fetched_at no futuro (%.0f s adiante do relogio)" % (-segundos)
    return max(segundos, 0.0) / 86400.0, ""


def main():
    parser = argparse.ArgumentParser(
        description="Idade declarada (fetched_at) das faixas de IP de crawler.")
    parser.add_argument("--dir", default=FAIXAS_PADRAO,
                        help="diretorio das faixas (padrao: data/ops/bot_ip_ranges)")
    parser.add_argument("--max-dias", type=float, default=MAX_DIAS_PADRAO,
                        help="limiar de idade em dias (padrao: %g)" % MAX_DIAS_PADRAO)
    parser.add_argument("--json", action="store_true", dest="como_json")
    args = parser.parse_args()

    diretorio = args.dir
    if not os.path.isdir(diretorio):
        print("check-bot-ip-ranges-frescor: NAO MEDIDO — diretorio ausente: %s"
              % diretorio, file=sys.stderr)
        return 2
    if args.max_dias <= 0:
        print("check-bot-ip-ranges-frescor: NAO MEDIDO — --max-dias precisa ser > 0",
              file=sys.stderr)
        return 2

    agora = datetime.datetime.now(datetime.timezone.utc)
    faixas, vencidas, nao_medidos, ignorados = [], [], [], []

    for nome in sorted(os.listdir(diretorio)):
        if not nome.endswith(".json"):
            continue
        registro, erro = carregar(os.path.join(diretorio, nome))
        if erro:
            nao_medidos.append((nome, erro))
            continue
        if not e_arquivo_de_faixa(registro):
            ignorados.append(nome)
            continue
        dias, problema = idade_em_dias(registro, agora)
        if problema:
            vencidas.append((nome, problema))
            faixas.append({"file": nome, "age_days": None, "problem": problema})
            continue
        faixas.append({"file": nome, "age_days": round(dias, 3),
                       "fetched_at": registro["fetched_at"],
                       "prefix_count": len(registro["prefixes"])})
        if dias > args.max_dias:
            vencidas.append((nome, "coletada ha %.2f dia(s), limiar %g" % (dias, args.max_dias)))

    if not faixas:
        # Diretório existente e vazio é NÃO MEDIDO, nunca verde: verde aqui
        # seria exatamente o "gate verde por ausência de dado" que o gerador
        # descreve — nenhuma faixa passa em qualquer teste de idade.
        print("check-bot-ip-ranges-frescor: NAO MEDIDO — nenhum arquivo de faixa "
              "legivel em %s (%d ilegivel(is), %d ignorado(s))"
              % (diretorio, len(nao_medidos), len(ignorados)), file=sys.stderr)
        for nome, erro in nao_medidos:
            print("  - %-32s %s" % (nome, erro), file=sys.stderr)
        return 2

    for item in faixas:
        if item["age_days"] is None:
            print("  VENCIDA  %-32s %s" % (item["file"], item["problem"]))
        else:
            marca = "VENCIDA " if item["age_days"] > args.max_dias else "ok      "
            print("  %s %-32s %6.2f dia(s)  %s  %d prefixo(s)"
                  % (marca, item["file"], item["age_days"],
                     item["fetched_at"], item["prefix_count"]))
    for nome in ignorados:
        print("  --       %-32s nao e arquivo de faixa (sem operator/prefixes)" % nome)

    mais_velha = max((i["age_days"] for i in faixas if i["age_days"] is not None),
                     default=None)
    print("\n%d faixa(s) | limiar %g dia(s) | mais velha: %s"
          % (len(faixas), args.max_dias,
             "%.2f dia(s)" % mais_velha if mais_velha is not None else "indeterminada"))

    if args.como_json:
        print(json.dumps({"threshold_days": args.max_dias, "ranges": faixas,
                          "stale": [{"file": n, "why": p} for n, p in vencidas],
                          "unreadable": [{"file": n, "why": e} for n, e in nao_medidos]},
                         ensure_ascii=False, indent=2))

    if nao_medidos:
        # Arquivo ilegível no meio de outros legíveis continua sendo "não
        # consegui medir ESTE" — e um único operador que eu não sei conferir já
        # basta para eu não poder afirmar que o diretório está fresco.
        print("check-bot-ip-ranges-frescor: NAO MEDIDO", file=sys.stderr)
        for nome, erro in nao_medidos:
            print("  - %-32s %s" % (nome, erro), file=sys.stderr)
        return 2
    if vencidas:
        print("check-bot-ip-ranges-frescor: FAIL")
        for nome, motivo in vencidas:
            print("  - %-32s %s" % (nome, motivo))
        return 1
    print("check-bot-ip-ranges-frescor: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
