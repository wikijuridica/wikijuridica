#!/usr/bin/env python3
"""Gera internal/siteicon/favicon.ico a partir da mesma geometria do favicon.svg.

O portal nao usa CDN nem servico externo de icone: o favicon e self-hosted e
versionado no repo. Este gerador existe para que o .ico (binario) seja
REPRODUZIVEL — ninguem precisa confiar num blob opaco commitado uma vez.

Geometria (grade 32x32, identica ao internal/siteicon/favicon.svg):
  fundo   rounded rect rx=6, #14213d (mesma cor de .brand no baseCSS)
  balanca circulo (16,8) r=2.2; viga y=9.9..11.9; haste x=15..17 ate y=24;
          base y=24..26.5; pratos triangulares nas pontas da viga.

Desenha em 8x (256px) com supersampling e reduz por LANCZOS, gerando um .ico
multi-resolucao (16/32/48) — 16 e o tamanho real da aba do navegador, 48 e o
que o rastreador de favicon do Google prefere.

Uso: ./tools/generate-site-favicon
"""

from __future__ import annotations

import pathlib
import sys

from PIL import Image, ImageDraw

SCALE = 8
SIDE = 32 * SCALE
BACKGROUND = (20, 33, 61, 255)  # #14213d
FOREGROUND = (255, 255, 255, 255)
ICO_SIZES = (16, 32, 48)


def s(value: float) -> float:
    """Converte coordenada da grade 32x32 para o canvas supersampled."""
    return value * SCALE


def draw_icon() -> Image.Image:
    image = Image.new("RGBA", (SIDE, SIDE), (0, 0, 0, 0))
    draw = ImageDraw.Draw(image)

    draw.rounded_rectangle([0, 0, SIDE - 1, SIDE - 1], radius=s(6), fill=BACKGROUND)

    # Fiel da balanca (circulo superior).
    draw.ellipse(
        [s(16 - 2.2), s(8 - 2.2), s(16 + 2.2), s(8 + 2.2)],
        fill=FOREGROUND,
    )
    # Viga horizontal.
    draw.rounded_rectangle([s(5), s(9.9), s(27), s(11.9)], radius=s(1), fill=FOREGROUND)
    # Haste vertical.
    draw.rectangle([s(15), s(11.9), s(17), s(24)], fill=FOREGROUND)
    # Base.
    draw.rounded_rectangle(
        [s(9.5), s(24), s(22.5), s(26.5)], radius=s(1.2), fill=FOREGROUND
    )
    # Pratos triangulares pendurados nas pontas da viga.
    draw.polygon([(s(5), s(12.4)), (s(1.8), s(18.6)), (s(8.2), s(18.6))], fill=FOREGROUND)
    draw.polygon(
        [(s(27), s(12.4)), (s(23.8), s(18.6)), (s(30.2), s(18.6))], fill=FOREGROUND
    )
    return image


def main() -> int:
    target = pathlib.Path(__file__).resolve().parent.parent / "internal" / "siteicon" / "favicon.ico"
    icon = draw_icon()
    frames = [
        icon.resize((size, size), Image.LANCZOS) for size in ICO_SIZES
    ]
    frames[-1].save(target, format="ICO", sizes=[(s_, s_) for s_ in ICO_SIZES])
    print(f"gravado {target} ({target.stat().st_size} bytes, tamanhos {ICO_SIZES})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
