#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
check_args=()
for arg in "$@"; do
	case "$arg" in
	--timings)
		check_args+=("$arg")
		;;
	*)
		echo "check-codex2-datajud-observations: unsupported argument: $arg" >&2
		exit 2
		;;
	esac
done
go test -count=1 ./internal/codex2datajudobservations ./internal/contract/codex2 -run TestCodex2DataJudObservations
exec "$ROOT/tools/run-check" codex2-datajud-observations "${check_args[@]}"
