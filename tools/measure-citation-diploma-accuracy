#!/usr/bin/env python3
"""measure-citation-diploma-accuracy — a atribuição de lei do inventário é confiável?

POR QUE EXISTE: conferir "o art. 27 fixa cinco anos" contra o texto oficial só
faz sentido se o inventário souber DE QUAL LEI é o art. 27. Esse campo
(`diploma`) é inferido, não lido — e está a montante de toda a conferência.
Errar nele produz o pior defeito possível numa ferramenta de verificação:
comparar a afirmação da página com o texto de OUTRA lei e acusar uma página
correta.

O RISCO É SILENCIOSO. Conferir contra o corpus só pega o caso em que o artigo
NÃO EXISTE na lei atribuída — 54 de 9.084. Quando os dois diplomas têm o
dispositivo (CPC e Constituição têm art. 5º), o erro passa invisível.

COMO MEDE: hold-out sobre o gabarito que a própria língua dá. Em "art. 1.723 do
Código Civil" a lei está escrita depois do artigo, na forma possessiva — não há
o que inferir. Essas viram gabarito. Desliga-se a regra de posse e mede-se se a
regra de PROXIMIDADE, que é quem decide em todo o resto, chegaria à mesma
resposta.

Foi assim que a inferência por contexto já foi medida e REPROVADA (61,3%,
documentado em docs/DADOS_CONFIAVEIS_E_ARMADILHAS.md §4c). Esta ferramenta
aplica o mesmo rigor ao ramo que ficou em uso.

Uso:
    tools/measure-citation-diploma-accuracy
    tools/measure-citation-diploma-accuracy --exemplos 30
"""
from __future__ import annotations

import argparse
import collections
import datetime
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
INVENTARIO = os.path.join(ROOT, "data/ops/citation_inventory.jsonl")
CORPUS = os.path.join(ROOT, "data/legal-corpus")
EVIDENCIA = os.path.join(ROOT, "data/ops/citation_diploma_accuracy.json")


def carregar(nome_arquivo, nome_modulo):
    caminho = os.path.join(ROOT, "tools", nome_arquivo)
    spec = importlib.util.spec_from_loader(
        nome_modulo,
        importlib.machinery.SourceFileLoader(nome_modulo, caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def carregar_corpus():
    corpus = {}
    for caminho in glob.glob(os.path.join(CORPUS, "*.json")):
        slug = os.path.basename(caminho)[:-5]
        with open(caminho, encoding="utf-8") as handle:
            corpus[slug] = json.load(handle)["articles"]
    return corpus


def maior_artigo(artigos):
    numeros = [int(chave) for chave in artigos if chave.isdigit()]
    return max(numeros) if numeros else 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--exemplos", type=int, default=12)
    args = parser.parse_args()

    gerador = carregar("generate-citation-inventory", "gci")
    corpus = carregar_corpus()
    teto = {slug: maior_artigo(artigos) for slug, artigos in corpus.items()}

    # A regra de posse ("art. N do X") é o gabarito; a de proximidade é o que
    # está sob teste. Reproduzimos as duas separadamente, sem tocar no gerador.
    def por_posse(frase, posicao):
        depois = frase[posicao:posicao + 90]
        posse = re.match(
            r"(?:arts?\.?|artigos?)?\s*[\d.]+\s*[ºo°]?\s*"
            r"(?:[,\s]*(?:§+\s*[\d.ºo°]+|inc(?:iso)?s?\.?\s*[IVXLC]+"
            r"|al[íi]neas?\s*[a-z]\)?|[IVXLC]+\b|[a-z]\)))*\s*,?\s*d[oaes]s?\s+",
            depois, re.IGNORECASE)
        if not posse:
            return ""
        resto = depois[posse.end():]
        for padrao, nome in gerador.DIPLOMA_RE:
            achado = padrao.match(resto)
            if not achado:
                continue
            if nome in ("lei_especifica", "lei_complementar"):
                numero = gerador.LEI_NUMERO_RE.search(resto[:60])
                if numero:
                    return gerador.LEIS_NO_CORPUS.get(
                        numero.group(1).replace(".", ""), nome)
            return nome
        return ""

    def por_proximidade(frase, posicao):
        inicio = max(0, posicao - 160)
        janela = frase[inicio:posicao + 160]
        relativa = posicao - inicio
        melhor_nome, melhor_distancia, melhor_trecho = "", None, ""
        for padrao, nome in gerador.DIPLOMA_RE:
            for achado in padrao.finditer(janela):
                if achado.end() <= relativa:
                    distancia = relativa - achado.end()
                elif achado.start() >= relativa:
                    distancia = achado.start() - relativa
                else:
                    distancia = 0
                if melhor_distancia is None or distancia < melhor_distancia:
                    melhor_nome, melhor_distancia = nome, distancia
                    melhor_trecho = janela[max(0, achado.start() - 5):achado.end() + 25]
        if melhor_nome in ("lei_especifica", "lei_complementar"):
            numero = gerador.LEI_NUMERO_RE.search(melhor_trecho)
            if numero:
                return gerador.LEIS_NO_CORPUS.get(
                    numero.group(1).replace(".", ""), melhor_nome)
        return melhor_nome

    total = 0
    com_gabarito = 0
    acertos = 0
    erros = []
    confusao = collections.Counter()
    sem_gabarito = 0
    acima_do_teto = []

    with open(INVENTARIO, encoding="utf-8") as handle:
        for linha in handle:
            registro = json.loads(linha)
            total += 1
            frase = registro.get("claim") or ""
            artigo = (registro.get("article") or "")
            if not artigo:
                continue

            # Localiza o marcador desta citação dentro da frase.
            posicao = None
            for marcador in gerador.ARTICLE_RE.finditer(frase):
                numero = gerador.NUMBER_RE.match(frase[marcador.end():])
                if numero and numero.group(1) == artigo:
                    posicao = marcador.start()
                    break
            if posicao is None:
                continue

            gabarito = por_posse(frase, posicao)
            if not gabarito:
                sem_gabarito += 1
            else:
                com_gabarito += 1
                inferido = por_proximidade(frase, posicao)
                if inferido == gabarito:
                    acertos += 1
                else:
                    confusao[(gabarito, inferido or "(nenhum)")] += 1
                    erros.append({
                        "path": registro.get("path"),
                        "artigo": artigo,
                        "correto": gabarito,
                        "inferido": inferido or "(nenhum)",
                        "frase": frase[:170],
                    })

            # Sinal independente: artigo acima do último do diploma atribuído.
            atribuido = registro.get("diploma") or ""
            base = re.match(r"\d+", artigo.replace(".", ""))
            if atribuido in teto and base and teto[atribuido]:
                if int(base.group()) > teto[atribuido]:
                    acima_do_teto.append({
                        "path": registro.get("path"),
                        "artigo": artigo,
                        "atribuido": atribuido,
                        "ultimo_artigo_do_diploma": teto[atribuido],
                    })

    print("=== ATRIBUIÇÃO DE LEI: A REGRA DE PROXIMIDADE ACERTA? ===")
    print("citações no inventário            : %d" % total)
    print("com gabarito (forma possessiva)   : %d" % com_gabarito)
    print("sem gabarito (decididas por proximidade, sem como conferir): %d" % sem_gabarito)
    if com_gabarito:
        taxa = 100.0 * acertos / com_gabarito
        print("\nproximidade acerta                : %d/%d = %.1f%%"
              % (acertos, com_gabarito, taxa))
    else:
        taxa = 0.0
        print("\nsem gabarito suficiente para medir.")

    if confusao:
        print("\n--- confusões mais frequentes (correto -> inferido) ---")
        for (correto, inferido), quantas in confusao.most_common(10):
            print("  %5d  %-18s -> %s" % (quantas, correto, inferido))

    if erros:
        print("\n--- exemplos de erro ---")
        for erro in erros[:args.exemplos]:
            print("  %s  art. %s: %s -> %s"
                  % (erro["path"], erro["artigo"], erro["correto"], erro["inferido"]))
            print("      %s" % erro["frase"])

    print("\n=== SINAL INDEPENDENTE: artigo acima do último do diploma atribuído ===")
    print("citações provavelmente atribuídas à lei errada: %d" % len(acima_do_teto))
    for caso in acima_do_teto[:args.exemplos]:
        print("  %-58s art. %-7s -> %s (vai até %d)"
              % (caso["path"][:58], caso["artigo"], caso["atribuido"],
                 caso["ultimo_artigo_do_diploma"]))

    print("\n--- leitura ---")
    if com_gabarito and taxa < 90:
        print("  A proximidade erra %.1f%% das vezes em que dá para conferir." % (100 - taxa))
        print("  Conferir citação cujo diploma veio SÓ da proximidade contamina o")
        print("  resultado: a afirmação da página seria comparada com outra lei.")
        print("  Confira apenas as %d com diploma explícito na frase." % com_gabarito)
    elif com_gabarito:
        print("  A proximidade acerta %.1f%%. Conferir o conjunto inteiro é defensável," % taxa)
        print("  desde que divergência isolada seja lida antes de virar acusação.")

    registro_final = {
        "schema_version": "citation_diploma_accuracy_v1",
        "measured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "citacoes_totais": total,
        "com_gabarito_possessivo": com_gabarito,
        "sem_gabarito": sem_gabarito,
        "acertos_da_proximidade": acertos,
        "acuracia_pct": round(taxa, 2),
        "confusoes": [{"correto": c, "inferido": i, "quantas": q}
                      for (c, i), q in confusao.most_common(30)],
        "erros_amostra": erros[:80],
        "artigo_acima_do_teto_do_diploma": acima_do_teto,
    }
    os.makedirs(os.path.dirname(EVIDENCIA), exist_ok=True)
    with open(EVIDENCIA, "w", encoding="utf-8") as handle:
        json.dump(registro_final, handle, ensure_ascii=False, indent=1, sort_keys=True)
    print("\nevidência: %s" % os.path.relpath(EVIDENCIA, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
