#!/bin/bash
# Publica ops/mcp/server.json no MCP Registry oficial (registry.modelcontextprotocol.io)
# com autenticacao HTTP: o servidor ja serve /.well-known/mcp-registry-auth com a chave
# publica ed25519 derivada de MCP_REGISTRY_PRIVATE_KEY (.env.local) — sem conta de
# terceiro, sem chave nova. Ferramenta oficial pinada: github.com/modelcontextprotocol/registry
# cmd/publisher v1.8.1 (Apache-2.0), instalada em .toolchains/bin/publisher.
# Feito pela primeira vez em 2026-09-08 20:41 (versao 1.2.0, status active).
set -euo pipefail
cd "$(dirname "$0")/.."
PUB="$PWD/.toolchains/bin/publisher"
if [ ! -x "$PUB" ]; then
	GOBIN="$PWD/.toolchains/bin" GOFLAGS='' ./tools/go-modern install github.com/modelcontextprotocol/registry/cmd/publisher@v1.8.1
fi
KEY="$(grep '^MCP_REGISTRY_PRIVATE_KEY=' .env.local | cut -d= -f2- | tr -d '"')"
[ -n "$KEY" ] || {
	echo "MCP_REGISTRY_PRIVATE_KEY ausente em .env.local" >&2
	exit 2
}
cd ops/mcp
"$PUB" validate
if [ "${1:-}" = "--dry-run" ]; then
	echo "dry-run: nao publica"
	exit 0
fi
"$PUB" login http --domain wikijuridica.com.br --private-key "$KEY" >/dev/null
SAIDA="$("$PUB" publish 2>&1)"
RC=$?
echo "$SAIDA" | tail -3
VERSAO="$(python3 -c 'import json;print(json.load(open("server.json"))["version"])')"
python3 - "$RC" "$VERSAO" <<'PY'
import json,sys,datetime
rc,versao=int(sys.argv[1]),sys.argv[2]
linha={"schema_version":"mcp_registry_publish_v1","publicado_em":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
       "servidor":"br.com.wikijuridica/acervo-juridico","versao":versao,"registry":"https://registry.modelcontextprotocol.io","auth":"http (/.well-known/mcp-registry-auth)","publisher":"v1.8.1","sucesso":rc==0}
open("../../data/ops/mcp_registry_publish.jsonl","a").write(json.dumps(linha,sort_keys=True)+"\n")
PY
exit $RC
