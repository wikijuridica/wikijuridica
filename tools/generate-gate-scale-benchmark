#!/usr/bin/env bash
# Mede somente o gate Go internal/quality sobre corpus sintetico mantido em
# memoria. A saida e evidencia interna bloqueada/noindex em data/ops; este
# wrapper declara o artefato exato, budget, throughput e stop condition antes
# de entrar no runner pesado. Evidencia e imutavel: repeticao usa --out com
# basename versionado e nunca sobrescreve uma medicao anterior.
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_GATE_SCALE_PROJECT_ROOT="$ROOT"
cd "$ROOT"

die() {
	echo "generate-gate-scale-benchmark: $*" >&2
	exit 2
}

output="data/ops/gate_scale_benchmark_evidence.json"
budget_ms="${WIKI_HEAVY_BUDGET_MS:-120000}"
seen_output=0
seen_budget=0

args=("$@")
for ((index = 0; index < ${#args[@]}; index++)); do
	arg="${args[index]}"
	case "$arg" in
	--timings | -timings | --timings=* | -timings=*)
		die "--timings e gerenciado pelo wrapper"
		;;
	--out | -out)
		((seen_output += 1))
		[[ "$seen_output" -eq 1 ]] || die "--out duplicado"
		((index += 1))
		[[ "$index" -lt "${#args[@]}" ]] || die "--out exige valor"
		output="${args[index]}"
		;;
	--out=* | -out=*)
		((seen_output += 1))
		[[ "$seen_output" -eq 1 ]] || die "--out duplicado"
		output="${arg#*=}"
		;;
	--budget-ms | -budget-ms)
		((seen_budget += 1))
		[[ "$seen_budget" -eq 1 ]] || die "--budget-ms duplicado"
		((index += 1))
		[[ "$index" -lt "${#args[@]}" ]] || die "--budget-ms exige valor"
		budget_ms="${args[index]}"
		;;
	--budget-ms=* | -budget-ms=*)
		((seen_budget += 1))
		[[ "$seen_budget" -eq 1 ]] || die "--budget-ms duplicado"
		budget_ms="${arg#*=}"
		;;
	esac
done

[[ "$output" =~ ^data/ops/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.json$ ]] ||
	die "--out deve ser um JSON simples sob data/ops/"
case "$budget_ms" in
"" | *[!0-9]*) die "--budget-ms deve ser inteiro positivo" ;;
esac
[[ "$budget_ms" -ge 1000 && "$budget_ms" -le 1800000 ]] ||
	die "--budget-ms deve ficar entre 1000 e 1800000"

if [[ -n "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-}" && "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH" != "$output" ]]; then
	die "artifact claim path diverge de --out"
fi
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="$output"

if [[ -n "${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-}" && "$WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER" != "tools/generate-gate-scale-benchmark" ]]; then
	die "artifact claim producer divergente"
fi
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="tools/generate-gate-scale-benchmark"

expected_output="atomic_blocked_noindex_json:$output"
if [[ -n "${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-}" && "$WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED" != "$expected_output" ]]; then
	die "output fingerprint esperado diverge de --out"
fi
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="$expected_output"
expected_lock_scope="generate:gate-scale-benchmark:artifact:$output"
if [[ -n "${WIKI_HEAVY_LOCK_SCOPE:-}" && "$WIKI_HEAVY_LOCK_SCOPE" != "$expected_lock_scope" ]]; then
	die "lock scope diverge do artefato autenticado"
fi
export WIKI_HEAVY_LOCK_SCOPE="$expected_lock_scope"
export WIKI_HEAVY_BUDGET_MS="$budget_ms"

if [[ -z "${WIKI_HEAVY_EXPECTED_DURATION_MS:-}" ]]; then
	expected_duration_ms=$((budget_ms / 2))
	if [[ "$expected_duration_ms" -lt 1 ]]; then
		expected_duration_ms=1
	fi
	export WIKI_HEAVY_EXPECTED_DURATION_MS="$expected_duration_ms"
fi
case "$WIKI_HEAVY_EXPECTED_DURATION_MS" in
"" | *[!0-9]*) die "WIKI_HEAVY_EXPECTED_DURATION_MS deve ser inteiro positivo" ;;
esac
[[ "$WIKI_HEAVY_EXPECTED_DURATION_MS" -ge 1 && "$WIKI_HEAVY_EXPECTED_DURATION_MS" -le "$budget_ms" ]] ||
	die "expected duration deve ser positiva e nao superar o budget"

stop_condition="atomic_blocked_evidence_promoted_or_failed_with_explicit_error"
if [[ -n "${WIKI_HEAVY_STOP_CONDITION:-}" && "$WIKI_HEAVY_STOP_CONDITION" != "$stop_condition" ]]; then
	die "stop condition divergente"
fi
export WIKI_HEAVY_STOP_CONDITION="$stop_condition"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-pages_per_second=100}"
[[ "$WIKI_HEAVY_THROUGHPUT_EXPECTED" =~ ^pages_per_second=[1-9][0-9]*$ ]] ||
	die "throughput esperado deve usar pages_per_second=N positivo"

# Reserva no máximo metade da memória atualmente disponível. Um override só
# pode reduzir esse teto; nunca transforma memória inexistente em autorização
# para materializar 100k/1M páginas em RAM.
available_kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)"
case "$available_kb" in
"" | *[!0-9]*) die "nao foi possivel autenticar MemAvailable" ;;
esac
detected_memory_budget_bytes=$((available_kb * 1024 / 2))
requested_memory_budget_bytes="${WIKI_GATE_SCALE_MEMORY_BUDGET_BYTES:-$detected_memory_budget_bytes}"
case "$requested_memory_budget_bytes" in
"" | *[!0-9]*) die "WIKI_GATE_SCALE_MEMORY_BUDGET_BYTES deve ser inteiro positivo" ;;
esac
[[ "$requested_memory_budget_bytes" -ge 1 &&
	"$requested_memory_budget_bytes" -le "$detected_memory_budget_bytes" ]] ||
	die "memory budget deve ser positivo e nao superar metade de MemAvailable ($detected_memory_budget_bytes bytes)"
export WIKI_GATE_SCALE_MEMORY_BUDGET_BYTES="$requested_memory_budget_bytes"

claim_source_dirs=(
	"$ROOT/cmd/generate-gate-scale-benchmark"
	"$ROOT/internal/gatescalebench"
	"$ROOT/internal/quality"
	"$ROOT/internal/content"
	"$ROOT/internal/contentstore"
	"$ROOT/internal/jsoncodec"
	"$ROOT/internal/densepairset"
	"$ROOT/internal/editorial"
	"$ROOT/internal/legalsignature"
	"$ROOT/internal/ptbrtext"
	"$ROOT/internal/router"
	"$ROOT/internal/seo"
	"$ROOT/internal/sources"
	"$ROOT/internal/hashdigest"
	"$ROOT/internal/fasthash"
	"$ROOT/internal/legalminhash"
	"$ROOT/internal/ptbrdisplaybudget"
)
for source_dir in "${claim_source_dirs[@]}"; do
	[[ -d "$source_dir" && ! -L "$source_dir" ]] || die "diretorio de fonte nao autenticado: $source_dir"
done
mapfile -d '' claim_source_files < <(
	find "${claim_source_dirs[@]}" -maxdepth 1 -type f -name '*.go' ! -name '*_test.go' -print0 |
		LC_ALL=C sort -z
)
[[ "${#claim_source_files[@]}" -gt 0 ]] || die "nenhuma fonte Go encontrada para input fingerprint"

# Declarar e atribuir separado: com `export VAR="$(...)"`, o exit do subshell
# e mascarado pelo exit do proprio export, e uma falha na impressao digital
# passaria como sucesso.
WIKI_HEAVY_ARTIFACT_INPUT_FINGERPRINT="$({
	printf 'package:%s\n' './cmd/generate-gate-scale-benchmark'
	printf 'arg-count:%d\n' "$#"
	printf 'memory-budget-bytes:%s\n' "$WIKI_GATE_SCALE_MEMORY_BUDGET_BYTES"
	for arg in "$@"; do
		printf 'arg:%q\n' "$arg"
	done
	LC_ALL=C sha256sum "${claim_source_files[@]}" \
		"$ROOT"/tools/generate-gate-scale-benchmark \
		"$ROOT"/go.mod "$ROOT"/go.sum
} | sha256sum | awk '{print "sha256:" $1}')"
[[ -n "$WIKI_HEAVY_ARTIFACT_INPUT_FINGERPRINT" ]] || die "impressao digital de entrada vazia"
export WIKI_HEAVY_ARTIFACT_INPUT_FINGERPRINT

if [[ -z "${WIKI_HEAVY_TIMEOUT_SECONDS:-}" ]]; then
	export WIKI_HEAVY_TIMEOUT_SECONDS="$(((budget_ms + 999) / 1000 + 30))"
fi

exec "$ROOT/tools/run-heavy-throttled" \
	"$ROOT/tools/run-go-cmd-cached" ./cmd/generate-gate-scale-benchmark --timings "$@"
