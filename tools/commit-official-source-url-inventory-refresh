#!/usr/bin/env bash
# Commita o refresco diario do inventario de URLs de fonte oficial.
#
# POR QUE ISTO EXISTE (2026-09-05)
# ================================
# O timer wikijuridica-official-source-url-inventory-refresh reescreve TODO
# DIA quatro arquivos TRACKED em data/source-registry/. Sem alguem
# commitando, eles viram um "M" perpetuo no git status -- e "M" perpetuo tem
# dois destinos, os dois ruins: ou outra sessao o engole dentro de um commit
# alheio, misturando frentes, ou algum agente o trata como ruido de fundo e
# ignora (mesmo defeito de cegueira dos untracked, ao contrario). E o mesmo
# raciocinio de tools/commit-revalidacao-de-fontes, escopado aos QUATRO
# arquivos que esta cadeia (e so ela) escreve.
#
# Commit de dado e LEVE neste repo (nao dispara build), entao commitar todo
# dia custa quase nada e mantem auditavel a historia do proprio inventario:
# da para ver quando um lote editorial novo entrou e mudou a contagem de
# referencias de uma fonte oficial.
set -uo pipefail
cd /opt/wiki || exit 2

ALVOS=(
	"data/source-registry/official_source_url_inventory.jsonl"
	"data/source-registry/official_source_url_inventory_manifest.json"
	"data/source-registry/official_source_url_live_metadata_attempts.jsonl"
	"data/source-registry/official_source_url_live_evidence.jsonl"
)

if git diff --quiet -- "${ALVOS[@]}" 2>/dev/null; then
	echo "sem mudanca nos quatro arquivos do inventario — nada a commitar"
	exit 0
fi

resumo="$(git diff --numstat -- "${ALVOS[@]}" | awk '{a+=$1; r+=$2} END {print "+"a" -"r}')"
mensagem="$(mktemp)"
cat >"$mensagem" <<MSG
chore(fontes): refresco diario do inventario de URLs de fonte oficial ($resumo)

Gravado por wikijuridica-official-source-url-inventory-refresh.timer: os tres
geradores oficiais (inventory, live-metadata-attempts, live-evidence)
regenerados na ordem que a cadeia exige, com run_date de hoje.
MSG
# SEM trailer de co-autoria de modelo desde 2026-09-23. O CLAUDE.md fixa que
# "nenhum commit leva co-autoria de modelo", e .githooks/commit-msg passou a
# REPROVAR a linha `Co-Authored-By: Claude ...`. Ate hoje esta mensagem a
# trazia: com o hook, o ExecStartPost do timer das 04:20 falharia no primeiro
# disparo e a unit iria a `failed`, com OnFailure para o dono.

# O index.lock e transitorio (commit de dado dura ~1s). Retry curto, nunca
# apagar lock alheio -- outra sessao pode estar commitando agora.
# A TENTATIVA E IMPRESSA, e nao e enfeite: sem o numero, "commitou" e
# "commitou na quinta, com 8 s de espera" sao a mesma linha no log, e a segunda
# e a que diz que o index.lock esta disputado.
for tentativa in 1 2 3 4 5; do
	if git add -- "${ALVOS[@]}" 2>/dev/null && git commit -F "$mensagem" -- "${ALVOS[@]}" 2>&1 | tail -2; then
		[ "$tentativa" -gt 1 ] && echo "  (commitado na tentativa $tentativa; o index.lock estava ocupado)"
		rm -f "$mensagem"
		exit 0
	fi
	echo "  tentativa $tentativa nao commitou; o index.lock pode estar com outra sessao" >&2
	sleep 2
done

rm -f "$mensagem"
echo "ATENCAO: nao consegui commitar o inventario de fonte oficial depois de $tentativa tentativas." >&2
exit 1
