#!/usr/bin/env python3
"""generate-baseline-testes-vermelhos — registra os testes JÁ vermelhos por pacote.

POR QUE EXISTE, medido em 2026-08-30. O gate de teste focado do pre-commit roda a
suíte dos pacotes que o commit toca e reprova se ela falhar. `internal/v2ingest`
tem 19 testes vermelhos que NÃO vieram do commit que os encontrou: medidos em
worktree isolada sobre `c01f0685`, eles já falhavam antes — a família
`TestCurrentLegalFacts*` e `TestTema987*`, que refletem 140 rejeições reais de
`current_legal_fact_source_missing` no ingest do acervo.

O efeito era um gate que reprova commit CORRETO por vermelho alheio: nenhuma
mudança em `internal/v2ingest` conseguia mais entrar. Falso positivo em massa é a
família de defeito que mais custou nesta casa, e o dono foi explícito na mesma
sessão: "se o hook está bloqueando trabalho legítimo, você deve corrigir o hook e
não travar trabalho".

O QUE ISTO **NÃO** É. Não é desligar teste, nem marcar `t.Skip`, nem baixar
exigência: os testes continuam rodando e o vermelho continua aparecendo na saída.
O que muda é o VEREDITO do commit — ele reprova por REGRESSÃO (falha fora do
baseline), e não por dívida já nomeada. E o baseline não pode apodrecer: teste que
volta a passar SAI dele por `check-baseline-testes-vermelhos`, que reprova baseline
inflado.

Uso:
    ./tools/generate-baseline-testes-vermelhos ./internal/v2ingest/ [outro/pacote/]
    ./tools/generate-baseline-testes-vermelhos --do-log <log-do-go-test>

`--do-log` registra a partir de uma execução que JÁ aconteceu, em vez de gastar
outra. A suíte de `internal/v2ingest` leva ~10 minutos: recomputá-la só para
transcrever o mesmo resultado é o tipo de gasto que o contrato chama de
desperdício. O log tem de ser de execução completa — se ela estourou o tempo, o
resultado não descreve o pacote e o registro é recusado.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
BASELINE = RAIZ / "data/ops/testes_vermelhos_conhecidos.json"
FALHA = re.compile(r"^--- FAIL: (\S+)")
PACOTE = re.compile(r"^(?:ok|FAIL)\s+(\S+)\s+([\d.]+)s")


def main(argv: list[str]) -> int:
    if not argv:
        print("uso: generate-baseline-testes-vermelhos <pacote> [pacote...]", file=sys.stderr)
        return 2
    if argv[0] == "--do-log":
        if len(argv) != 2:
            print("uso: generate-baseline-testes-vermelhos --do-log <log>", file=sys.stderr)
            return 2
        origem = Path(argv[1])
        if not origem.exists():
            print(f"REPROVADO: log {origem} nao existe", file=sys.stderr)
            return 1
        texto = origem.read_text(encoding="utf-8", errors="replace")
        if "test timed out after" in texto:
            print("REPROVADO: o log e de execucao que estourou o tempo; o veredito nao descreve o pacote",
                  file=sys.stderr)
            return 1
        # ★ LOG DE HOOK VEM TRUNCADO, E ACEITA-LO GERA BASELINE INCOMPLETO
        # (2026-08-30). O pre-commit imprime `tail -n 25` do log do teste focado.
        # Passar essa saida para ca produziu um baseline com 4 dos 21 vermelhos
        # reais de `internal/contract/misc` — e o commit seguinte reprovou 17
        # testes como "regressao" que sempre estiveram vermelhos. Baseline
        # incompleto e pior que baseline nenhum: ele acusa quem nao errou.
        for marca in ("pre-commit:", "REPROVADO:", "go-index-compile-closure:"):
            if marca in texto:
                print(f"REPROVADO: o log contem saida de hook ({marca!r}) e pode estar truncado. "
                      "Rode `go test` direto e passe ESSE log.", file=sys.stderr)
                return 1
    else:
        saida = subprocess.run(
            [str(RAIZ / "tools/go-modern"), "test", "-count=1", "-timeout", "1800s", *argv],
            cwd=RAIZ, capture_output=True, text=True,
        )
        texto = saida.stdout + saida.stderr

    duracoes: dict[str, float] = {}
    for linha in texto.splitlines():
        casa = PACOTE.match(linha.strip())
        if casa:
            duracoes[casa.group(1)] = float(casa.group(2))

    # Uma execução por pacote: o nome do pacote de cada falha vem da linha de
    # sumário que a segue, então processa-se o texto em ordem, acumulando.
    pendentes: list[str] = []
    por_pacote: dict[str, list[str]] = {}
    for linha in texto.splitlines():
        casa = FALHA.match(linha.strip())
        if casa:
            nome = casa.group(1)
            if "/" not in nome:
                pendentes.append(nome)
            continue
        casa = PACOTE.match(linha.strip())
        if casa and pendentes:
            por_pacote.setdefault(casa.group(1), []).extend(pendentes)
            pendentes = []

    # ★ ARTEFATO GERADO STALE NAO E DIVIDA — E INCONSISTENCIA MECANICA
    # (medido em 2026-08-30).
    #
    # Rodei a baseline com `validator_fingerprint_attestation_generated.go`
    # desatualizado (eu tinha mexido em `internal/structureddata`, que esta no
    # fecho de importacao do validador, DEPOIS do ultimo `go generate`). O
    # resultado: `internal/v2ingest` registrou **81** vermelhos em 145,9s, contra
    # os **6** reais de uma suite que leva ~500s. Setenta e cinco testes de
    # atestacao teriam entrado na lista como "divida nomeada" — e divida nomeada
    # e ANISTIA: o proximo commit que os quebrasse de verdade passaria.
    #
    # A falha diz de si mesma o que e ("run go generate"), entao a baseline se
    # recusa a grava-la. Nao e tolerancia nova: e a distincao entre um teste que
    # falha porque o repositorio tem divida e um que falha porque falta rodar um
    # comando de duas linhas.
    STALE_GERADO = (
        "does not match authenticated source graph",
        "run go generate",
    )
    for marca in STALE_GERADO:
        if marca in texto:
            print(f"REPROVADO: a execucao tem falha de ARTEFATO GERADO STALE "
                  f"({marca!r}), que nao e divida e nao entra no baseline — "
                  f"75 testes de atestacao entrariam como anistia. "
                  f"Rode `./tools/go-modern generate ./internal/v2ingest` e "
                  f"repita a medicao.", file=sys.stderr)
            return 1

    commit = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=RAIZ, capture_output=True, text=True,
        env={k: v for k, v in os.environ.items()
             if k not in {"GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE", "GIT_COMMON_DIR",
                          "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"}},
    ).stdout.strip()

    documento = {}
    if BASELINE.exists():
        documento = json.loads(BASELINE.read_text(encoding="utf-8"))
    documento.setdefault("schema", 1)
    documento["medido_em"] = date.today().isoformat()
    documento["commit"] = commit
    pacotes = documento.setdefault("por_pacote", {})
    for pacote, duracao in duracoes.items():
        testes = sorted(set(por_pacote.get(pacote, [])))
        if not testes:
            pacotes.pop(pacote, None)
            continue
        pacotes[pacote] = {
            "medido_em": documento["medido_em"],
            "commit": commit,
            "duracao_s": duracao,
            "testes": testes,
        }
    BASELINE.parent.mkdir(parents=True, exist_ok=True)
    BASELINE.write_text(json.dumps(documento, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
                        encoding="utf-8")
    for pacote, dados in sorted(pacotes.items()):
        print(f"{pacote}: {len(dados['testes'])} vermelho(s) conhecido(s), {dados['duracao_s']:.1f}s")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
