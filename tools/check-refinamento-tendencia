#!/usr/bin/env python3
"""Lê a fila de refinamento e responde a única pergunta que ela existe para responder:
a dívida de achado médio está crescendo ou caindo?

POR QUE ESTE CONSUMIDOR EXISTE. `data/ops/refinement_queue.jsonl` tinha, em
2026-08-29, UMA referência em todo o repositório — a de escrita, em
`tools/run-daily-content`. Ninguém lia. O produtor registrava fielmente, todo
dia, a contagem de achados médios da onda, e o registro morria ali: fila sem
consumidor não é fila, é log.

E o dono decidiu, em 2026-08-06, que médio PUBLICA e se refina depois. Essa
decisão só é honesta se o "depois" for medido — senão "publicar e corrigir" vira
"publicar". Este gate é o instrumento que falta para saber se o refino acompanha
a produção.

O QUE ELE REPROVA, e o que deliberadamente NÃO reprova:

  - reprova DUPLICATA de (data, origem): o produtor fazia append por execução, e
    a onda roda mais de uma vez por dia. A data 2026-08-26 chegou a aparecer
    quatro vezes com o mesmo conteúdo, e qualquer soma sobre a fila multiplicava
    a dívida por quatro. Série que conta o mesmo dia várias vezes não mede
    tendência;
  - reprova CRESCIMENTO SUSTENTADO: dívida que sobe em três leituras
    consecutivas sem cair uma vez significa que se publica mais rápido do que se
    refina;
  - NÃO reprova a dívida existir. Médio publica, por decisão do dono. Um gate
    que reprovasse o estoque de dívida seria um gate permanentemente vermelho
    contra uma política deliberada — e gate assim é desligado, não obedecido.
"""
import json
import os
import sys

FILA = "data/ops/refinement_queue.jsonl"
CRESCIMENTOS_SEGUIDOS_QUE_REPROVAM = 3


def carrega(raiz):
    caminho = os.path.join(raiz, FILA)
    if not os.path.exists(caminho):
        return None, f"{FILA} não existe — a onda diária deveria escrevê-la"
    registros = []
    for numero, linha in enumerate(open(caminho, encoding="utf-8"), 1):
        linha = linha.strip()
        if not linha:
            continue
        try:
            registros.append(json.loads(linha))
        except json.JSONDecodeError as erro:
            return None, f"{FILA}:{numero} ilegível: {erro}"
    return registros, None


def main():
    raiz = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    registros, erro = carrega(raiz)
    if erro:
        print(f"check-refinamento-tendencia: {erro}", file=sys.stderr)
        return 2
    if not registros:
        # Ausência de dívida NÃO é anomalia aqui: significa onda sem achado médio.
        print("check-refinamento-tendencia: fila vazia — nenhuma onda registrou achado médio")
        return 0

    problemas = []

    chaves = [(r.get("data"), r.get("origem")) for r in registros]
    duplicadas = {c for c in chaves if chaves.count(c) > 1}
    for chave in sorted(duplicadas, key=lambda c: str(c)):
        problemas.append(
            f"duplicata na fila: {chave[0]} / {chave[1]} aparece {chaves.count(chave)} vezes — "
            "o produtor deve substituir a linha do dia, não acrescentar outra")

    serie = sorted(
        ((r.get("data") or "", int(r.get("total") or 0)) for r in registros),
        key=lambda par: par[0])
    crescimentos = 0
    pior = 0
    for anterior, atual in zip(serie, serie[1:]):
        if atual[1] > anterior[1]:
            crescimentos += 1
            pior = max(pior, crescimentos)
        else:
            crescimentos = 0
    if pior >= CRESCIMENTOS_SEGUIDOS_QUE_REPROVAM:
        problemas.append(
            f"a dívida cresceu em {pior} leituras consecutivas sem cair uma vez — "
            "publica-se mais rápido do que se refina")

    print("  série da dívida de achado médio:")
    for data, total in serie:
        print(f"    {data}  total={total}")
    classes = {}
    for r in registros:
        for codigo, quantos in (r.get("classes") or {}).items():
            classes[codigo] = max(classes.get(codigo, 0), int(quantos))
    if classes:
        print("  pico por classe:")
        for codigo, quantos in sorted(classes.items(), key=lambda par: -par[1]):
            print(f"    {codigo:44s} {quantos}")

    if problemas:
        for problema in problemas:
            print(f"check-refinamento-tendencia: {problema}", file=sys.stderr)
        return 1
    print(f"check-refinamento-tendencia: OK — {len(serie)} leitura(s), sem duplicata e sem crescimento sustentado")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
