#!/usr/bin/env bash
# tools/check-v2-stock-epoch — READ-ONLY (wrapper de ./cmd/check-v2-stock-epoch).
#
# Uso:
#   tools/check-v2-stock-epoch [flags do cmd]
#   tools/check-v2-stock-epoch --quiet            # ou WIKI_QUIET=1
#
# Por que existe o --quiet: o cmd emite uma linha por ocorrencia no stderr e
# reprovacao real chega a ~20 KB por chamada, quase toda ela repeticao do MESMO
# codigo de issue com dois sha256 completos por linha. Em contexto de agente
# isso e ~5 mil tokens gastos para dizer o que 3 exemplos + a contagem dizem.
#
# O que --quiet | -q faz (SO verbosidade):
#   - silencia as duas linhas de bookkeeping do runner (repo_awareness /
#     artifact_claim), que sao declaracao do produtor, nao veredito;
#   - imprime no maximo WIKI_QUIET_DETAIL_CAP (default 3) linhas POR CODIGO de
#     issue e resume o restante daquele codigo em uma linha com o TOTAL real.
# Nenhum codigo de issue e escondido: todo codigo que apareceu continua saindo,
# com exemplo concreto e contagem. O stdout permanece byte-a-byte identico, o
# exit code e o mesmo, nenhuma verificacao muda e o modo padrao (sem a flag)
# continua identico ao anterior.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
QUIET=0
if [ "${WIKI_QUIET:-0}" = "1" ]; then
	QUIET=1
fi
ARGS=()
prev=""
for arg in "$@"; do
	case "$arg" in
	--quiet | -q)
		# nao capturar quando o token e o VALOR de uma flag que exige valor
		if [ "$prev" = "--root" ] || [ "$prev" = "-root" ]; then
			ARGS+=("$arg")
		else
			QUIET=1
		fi
		;;
	*) ARGS+=("$arg") ;;
	esac
	prev="$arg"
done

if [ "$QUIET" != 1 ]; then
	exec "$ROOT/tools/run-go-cmd-cached" ./cmd/check-v2-stock-epoch --root "$ROOT" "$@"
fi

DETAIL_CAP="${WIKI_QUIET_DETAIL_CAP:-3}"
case "$DETAIL_CAP" in
'' | *[!0-9]*) DETAIL_CAP=3 ;;
esac

# stdout do cmd segue direto pelo fd 3 (intacto); so o stderr passa pelo filtro.
# O exit code real volta pelo fd 5, capturado na substituicao de comando.
set +e +o pipefail
exec 3>&1
status="$({ {
	"$ROOT/tools/run-go-cmd-cached" ./cmd/check-v2-stock-epoch --root "$ROOT" ${ARGS[@]+"${ARGS[@]}"}
	echo "$?" >&5
} 2>&1 1>&3 |
	awk -v cap="$DETAIL_CAP" '
    /^run-go-cmd-cached: (repo_awareness|artifact_claim) / { next }
    {
      key = $1
      if (NF > 1) { key = key " " $2 }
      if (!(key in count)) { order[++keys] = key }
      count[key]++
      if (count[key] <= cap) { print; next }
      hidden[key]++
    }
    END {
      for (i = 1; i <= keys; i++) {
        k = order[i]
        if (hidden[k] > 0) {
          printf "  (+%d linha(s) de %s omitida(s) por --quiet; total=%d — rode sem --quiet para a lista completa)\n", hidden[k], k, count[k]
        }
      }
    }' >&2; } 5>&1)"
exec 3>&-
case "$status" in
'' | *[!0-9]*) status=2 ;; # exit code ilegivel nunca vira verde inventado
esac
exit "$status"
