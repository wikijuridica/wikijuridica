#!/usr/bin/env python3
"""check-edge-vary-falsificacao — prova que check-edge-vary-contract REPROVA
quando deve, e que NÃO grita quando não deve. READ-ONLY, sem rede.

POR QUE EXISTE, e o episódio que o obrigou

A Cache Rule da zona foi esvaziada em 2026-08-22T13:10Z (ruleset v14, zero
regras) e só voltou em 2026-08-26T15:55Z. Durante os quatro dias
`check-edge-vary-contract` saiu VERDE, porque o veredito dele nunca olhava a
camada 1 — iterava sobre a lista de regras, e uma lista vazia não contradiz
nada. Quem pegou o problema foi outro gate.

Gate verde não é prova (R2 do Contrato do Dado Real). A única maneira de saber
que um detector detecta é alimentá-lo com o defeito e exigir que ele reprove —
e alimentá-lo com o caso INOCENTE parecido, exigindo que ele passe. Detector
novo deste repositório nasce com teste de falso positivo por ordem expressa:
já houve um que acusou 46 páginas sendo que as 46 eram falso positivo.

Não faz rede: exercita `veredito()` com registros sintéticos.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import os
import sys

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
ALVO = os.path.join(RAIZ, "tools", "check-edge-vary-contract")


def carrega_veredito():
    """Importa o gate, que não tem extensão .py."""
    spec = importlib.util.spec_from_loader(
        "check_edge_vary_contract",
        importlib.machinery.SourceFileLoader("check_edge_vary_contract", ALVO),
    )
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo.veredito


def registro(**ajustes) -> dict:
    """Registro SADIO, que é o estado medido no ar em 2026-08-28: regra com
    allowlist ['text/markdown'], origem declarando Vary: Accept, Markdown
    negociado, HTML intacto e q=0 sem colidir."""
    base = {
        "camada_1_cache_rule": {
            "verificada": True,
            "acao": "normalize",
            "media_types": ["text/markdown"],
            "allowlist_fecha_em_duas_variantes": True,
        },
        "camada_2_origem_declara_vary_accept": True,
        "camada_3_html_intacto_apos_pedido_markdown": True,
        "camada_4_qvalue_zero_nao_colide": True,
        "markdown_negociado": True,
        "sondas_que_nao_completaram": [],
    }
    base.update(ajustes)
    return base


REGRA_VAZIA = {
    "verificada": True,
    "acao": None,
    "allowlist_fecha_em_duas_variantes": False,
    "motivo": "nenhuma regra declara vary.headers.accept",
}

CASOS = [
    # (nome, registro, codigo esperado, por que)
    ("estado sadio medido no ar", registro(), 0,
     "com as quatro camadas coerentes o gate nao pode gritar"),

    ("REGRA ESVAZIADA com negociacao LIGADA", registro(camada_1_cache_rule=REGRA_VAZIA), 1,
     "e o estado exato de 22-26/08, que passou verde por quatro dias"),

    ("regra esvaziada com negociacao DESLIGADA", registro(
        camada_1_cache_rule=REGRA_VAZIA, markdown_negociado=False,
        camada_4_qvalue_zero_nao_colide=None, camada_2_origem_declara_vary_accept=False), 0,
     "FALSO POSITIVO: sem negociacao a ausencia da regra e 'ainda nao implantado', nao defeito"),

    ("sem credencial, negociacao ligada", registro(camada_1_cache_rule={
        "verificada": False, "motivo": "credencial ausente em .env.local"}), 0,
     "FALSO POSITIVO: indisponibilidade de API nao e drift; nao medir nao e reprovar"),

    ("rede caiu no meio da sonda", registro(
        camada_3_html_intacto_apos_pedido_markdown=False,
        sondas_que_nao_completaram=["html_depois"]), 2,
     "corpo vazio por erro de rede NAO pode ser diagnosticado como envenenamento"),

    ("HTML deixou de ser servido, com a rede OK", registro(
        camada_3_html_intacto_apos_pedido_markdown=False), 1,
     "envenenamento de verdade continua sendo falha dura"),

    ("negocia Markdown sem declarar Vary", registro(
        camada_2_origem_declara_vary_accept=False), 1,
     "e a combinacao que envenena, e nao se manifesta na mesma requisicao"),

    ("q=0 colide com q=1", registro(camada_4_qvalue_zero_nao_colide=False), 1,
     "as duas chaves de variante caindo na mesma envenenam o canal de Markdown"),

    ("negociacao desligada e tudo mais em branco", registro(
        markdown_negociado=False, camada_2_origem_declara_vary_accept=False,
        camada_4_qvalue_zero_nao_colide=None), 0,
     "FALSO POSITIVO: antes do deploy que liga a negociacao, isto e estado legitimo"),
]


def main() -> int:
    try:
        veredito = carrega_veredito()
    except (OSError, SyntaxError, AttributeError) as erro:
        print("nao consegui carregar veredito() de %s: %s" % (ALVO, erro), file=sys.stderr)
        return 2

    falhas = 0
    for nome, reg, esperado, porque in CASOS:
        obtido, _ = veredito(reg)
        if obtido == esperado:
            print("  OK    %-42s exit %d" % (nome, obtido))
        else:
            falhas += 1
            print("  FALHA %-42s exit %d, esperado %d" % (nome, obtido, esperado))
            print("        %s" % porque)

    print("\n%d de %d casos" % (len(CASOS) - falhas, len(CASOS)))
    if falhas:
        print("check-edge-vary-falsificacao: %d caso(s) reprovaram — o detector nao "
              "detecta o que diz detectar" % falhas, file=sys.stderr)
        return 1
    print("check-edge-vary-falsificacao: o detector reprova o defeito e passa nos "
          "quatro casos inocentes")
    return 0


if __name__ == "__main__":
    sys.exit(main())
