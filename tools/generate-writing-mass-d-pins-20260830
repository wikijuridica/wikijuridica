#!/usr/bin/env python3
"""Re-pina os lotes D do inventario integral na ordem do shard vivo.

★ O QUE ESTAVA ERRADO (medido em 2026-08-30)

Os oito lotes "D" preservados de `scripts/workflows/writing-mass-full.js`
tinham, em quatro casos, `intent_ids` numa ordem que NAO e a do shard
correspondente em `data/editorial/v2_pages/`:

    consumidor-d01  pino == shard
    glossario2-d01  pino == shard
    glossario2-d02  pino == shard
    glossario2-d04  pino == shard
    glossario2-d03  pino != shard   <- re-pinado aqui
    glossario2-d05  pino != shard   <- re-pinado aqui
    seguros-d01     pino != shard   <- re-pinado aqui
    tributario-d02  pino != shard   <- re-pinado aqui

O conjunto de intents e IDENTICO nos oito — nenhum ganhou ou perdeu membro.
Divergia so a ORDEM, e ordem nao e escolha editorial: e propriedade do artefato.
Ela importa porque `wellFormedBatchClaim` (writing-mass.js) exige
`JSON.stringify(result.intent_ids) === JSON.stringify(batch.intent_ids)` — um
pino fora de ordem faz o redator reescrever o shard so para reordenar linhas,
queimando o CAS e gerando churn de bytes sem mudanca semantica.

`families` e derivado do pino: a ordem em que cada familia aparece pela primeira
vez percorrendo os intents. Deriva-la e o unico jeito de os dois campos nao se
contradizerem, e era exatamente onde os quatro divergiam (`seguros-d01` trazia
as sete familias em ordem alfabetica enquanto o pino estava noutra ordem).

★ POR QUE ISTO NAO E "RODAR A MIGRACAO DE 2026-07-15"

`tools/migrate_v2_writing_inventory_pins_20260715.py` planejava outra coisa —
remover `seguros-17`, crescer `seguros-04` de 15 para 20, criar slices
`consumidor-21`/`tributario-26`/`tributario-29`. Ela foi PREPARADA E NUNCA
APLICADA, e ha tres provas disso no disco: o recibo
`data/editorial/v2_writing_inventory_pin_migration_20260715.json` NAO existe; o
manifesto de preimagem traz `"approval": false`; e a preimagem arquivada
(9ff9cce0…) ja nao bate com o arquivo vivo (bc0a96c9…). Aplica-la hoje
contradiria producao: `seguros-17` tem 14 paginas escritas e ZERO intersecao com
`seguros-d01`, e o shard de `seguros-04` tem 15 linhas, nao 20.

Uso:
    ./tools/generate-writing-mass-d-pins-20260830 [--verificar]
"""
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
INVENTARIO = RAIZ / "scripts/workflows/writing-mass-full.js"
PADRAO = re.compile(r"const batches = (\[.*?\])\n", re.S)
LOTES_D = (
    "consumidor-d01", "glossario2-d01", "glossario2-d02", "glossario2-d03",
    "glossario2-d04", "glossario2-d05", "seguros-d01", "tributario-d02",
)


def ordem_do_shard(slug):
    caminho = RAIZ / "data/editorial/v2_pages" / f"{slug}.jsonl"
    ids = []
    for linha in caminho.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        intent = registro.get("intent_id")
        if not intent:
            raise ValueError(f"{slug}: linha sem intent_id")
        ids.append(intent)
    return ids


def familia_por_intent(rel_path):
    mapa = {}
    for linha in (RAIZ / rel_path).read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        mapa[registro["intent_id"]] = registro["family"]
    return mapa


def familias_do_pino(intent_ids, mapa):
    """Ordem de PRIMEIRA APARICAO, sem intercalar familia ja fechada."""
    ordem = []
    vistas = set()
    for intent in intent_ids:
        familia = mapa.get(intent)
        if familia is None:
            raise ValueError(f"intent fora do portfolio: {intent}")
        if not ordem or ordem[-1] != familia:
            if familia in vistas:
                raise ValueError(
                    f"pino intercala a familia {familia}: o shard nao agrupa")
            ordem.append(familia)
            vistas.add(familia)
    return ordem


def main(argv):
    verificar = "--verificar" in argv
    texto = INVENTARIO.read_text(encoding="utf-8")
    achado = PADRAO.search(texto)
    if not achado:
        print("inventario nao parseavel", file=sys.stderr)
        return 2
    lotes = json.loads(achado.group(1))
    por_slug = {lote["slug"]: lote for lote in lotes}
    mudados = []
    for slug in LOTES_D:
        lote = por_slug.get(slug)
        if lote is None:
            print(f"REPROVADO: lote D ausente do inventario: {slug}")
            return 1
        ids_vivos = ordem_do_shard(slug)
        if sorted(ids_vivos) != sorted(lote["intent_ids"]):
            # Membership diverge: isto NAO e reordenacao, e mudanca de conteudo.
            # O gerador se recusa — quem decide membro de lote D e a esteira
            # editorial, nao uma ferramenta de ordenacao.
            print(f"REPROVADO {slug}: o shard e o pino tem MEMBROS diferentes, "
                  f"nao so ordem — shard={len(ids_vivos)} pino="
                  f"{len(lote['intent_ids'])}; diferenca="
                  f"{sorted(set(ids_vivos) ^ set(lote['intent_ids']))}")
            return 1
        familias = familias_do_pino(ids_vivos, familia_por_intent(lote["file"]))
        if lote["intent_ids"] == ids_vivos and lote["families"] == familias:
            continue
        mudados.append((slug, list(lote["intent_ids"]), ids_vivos,
                        list(lote["families"]), familias))
        lote["intent_ids"] = ids_vivos
        lote["families"] = familias
        lote["n"] = len(ids_vivos)
    if verificar:
        for slug, _, _, _, _ in mudados:
            print(f"RE-PINO PENDENTE: {slug}")
        print(f"{len(mudados)} de {len(LOTES_D)} lotes D fora da ordem do shard")
        return 1 if mudados else 0
    if not mudados:
        print("inalterado: os oito lotes D ja seguem a ordem do shard vivo")
        return 0
    # EDICAO PONTUAL, NAO RE-DUMP DO ARRAY INTEIRO.
    #
    # Re-serializar os 802 lotes normalizaria duas junções `}},{{` que o arquivo
    # tem sem espaço — churn de bytes em 798 lotes que ninguém pediu, num
    # arquivo que outras frentes editam. Cada objeto alterado e substituido no
    # texto cru pelo seu proprio recorte, e a substituicao so acontece se o
    # recorte reserializar EXATAMENTE igual ao original antes da mudanca.
    saida = texto
    for slug, antes_ids, _, antes_fam, _ in mudados:
        lote = por_slug[slug]
        antigo_obj = dict(lote)
        antigo_obj["intent_ids"] = antes_ids
        antigo_obj["families"] = antes_fam
        antigo_obj["n"] = len(antes_ids)
        recorte = json.dumps(antigo_obj, ensure_ascii=False,
                             separators=(", ", ": "))
        if saida.count(recorte) != 1:
            print(f"REPROVADO {slug}: recorte do lote nao e unico no texto "
                  f"({saida.count(recorte)} ocorrencia(s)); nada foi gravado")
            return 1
        saida = saida.replace(
            recorte,
            json.dumps(lote, ensure_ascii=False, separators=(", ", ": ")), 1)
    INVENTARIO.write_text(saida, encoding="utf-8")
    for slug, antes_ids, depois_ids, antes_fam, depois_fam in mudados:
        print(f"re-pinado {slug}: {len(depois_ids)} intents na ordem do shard "
              f"(familias {antes_fam} -> {depois_fam})")
    print(f"{len(mudados)} lote(s) re-pinado(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
