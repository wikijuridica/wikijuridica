#!/usr/bin/env python3
"""check-body-word-count-formula — a contagem de palavras bate com a do gate?

POR QUE EXISTE: a fórmula de contagem do corpo já divergiu do gate DUAS vezes,
nos dois casos silenciosamente e com consequência cara.

1. Em 2026-08-04 (commit 3fd10fca) um gerador de reparo somava só abertura +
   texto das seções, declarou 439 onde o ingest contava 550 e derrubou a página.
2. Em 2026-08-06 descobriu-se que o CENSO DE SEVERIDADE tinha o mesmo defeito, e
   ele é quem prioriza todo o trabalho editorial: classificava 3.243 páginas
   como "corpo entre 250 e 400 palavras" quando a fórmula oficial vê 1.258, e
   marcava 37 páginas como CRÍTICAS — proibidas de publicar — tendo elas entre
   339 e 437 palavras.

A fórmula oficial é `bodyWordCount`, em internal/v2ingest/validate.go:984:
abertura + heading e texto de CADA seção + q e a de CADA item de FAQ,
tokenizando sobre o texto sem acentos.

O check também prova que o FAQ é lido pelas chaves certas. As chaves são `q` e
`a`; pedir `question`/`answer` devolve vazio em silêncio, e foi assim que a
função `visible_text` do censo ficou cega ao FAQ inteiro — junto com todo
detector que se apoia nela, incluindo o de promessa de resultado do Provimento
OAB 205/2021.

Read-only. Roda em segundos sobre o estoque inteiro.

Uso:
    tools/check-body-word-count-formula
"""
from __future__ import annotations

import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import unicodedata

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
PAGES = os.path.join(ROOT, "data/editorial/v2_pages/*.jsonl")
VALIDATE_GO = os.path.join(ROOT, "internal/v2ingest/validate.go")

# Tolerância que o gate aplica antes de reprovar (validate.go:636):
# |declarado - real| * 10 > real
TOLERANCIA = 10


def referencia(record):
    """Reimplementação literal de bodyWordCount, para servir de referência."""
    def tokens(value):
        folded = unicodedata.normalize("NFKD", (value or "").lower())
        folded = "".join(c for c in folded if not unicodedata.combining(c))
        return re.findall(r"[^\W_]+", folded, re.UNICODE)

    total = len(tokens(record.get("opening")))
    for section in record.get("sections") or []:
        total += len(tokens(section.get("heading")))
        total += len(tokens(section.get("text")))
    for item in record.get("faq") or []:
        total += len(tokens(item.get("q")))
        total += len(tokens(item.get("a")))
    return total


# Geradores de canal derivado que rodam todo dia por tools/run-daily-content e
# gravam word_count direto no shard canônico.
PRODUTORES = (
    "generate-diario-pages",
    "generate-noticia-pages",
    "generate-stf-informativo-pages",
    "generate-stj-sumula-pages",
    "generate-stj-tema-pages",
)


def falhas_dos_produtores(raiz=None):
    """Os geradores declaram word_count pela fórmula ÚNICA (ptbrtext.BodyWords)?

    Este é o elo que faltava, e foi por ele que o BUG-048 durou meses. O check
    conferia a fórmula do CENSO (um leitor) e o campo declarado no estoque (o
    resultado), nunca os PRODUTORES. Cinco geradores rodam todo dia e cada um
    carregava a própria cópia da contagem: quatro usavam `strings.Fields`, que
    não quebra número pontuado, e por isso "Lei 9.494/97" valia uma palavra em
    vez de quatro. Resultado medido em 2026-08-29: 950 páginas vivas com
    word_count diferente do corpo real, concentradas nesses canais (65 de 83 em
    stj-sumula-derivada-01, 53 de 54 em stf-informativo-derivado-01).

    A verificação é de FONTE porque o defeito é de fonte: converger o estoque
    sem converger o produtor deixa a próxima execução diária reabrindo a
    divergência. Gerador novo que copiar o molde antigo reprova aqui.
    """
    raiz = raiz or ROOT
    encontradas = []
    for nome in PRODUTORES:
        caminho_gerador = os.path.join(raiz, "cmd", nome, "main.go")
        if not os.path.exists(caminho_gerador):
            encontradas.append("gerador %s sumiu — este check precisa ser "
                               "revisto antes de continuar valendo" % nome)
            continue
        with open(caminho_gerador, encoding="utf-8") as handle:
            fonte_gerador = handle.read()
        encontradas.extend(falhas_da_formula_do_produtor(nome, fonte_gerador))
    encontradas.extend(falhas_dos_produtores_python(raiz))
    return encontradas


# Atribuição de word_count em Python: record["word_count"] = <expressão>.
ATRIBUICAO_PY = re.compile(r"""\[["']word_count["']\]\s*=\s*(.+)""")
# Um gerador DATADO (sufixo -AAAAMMDD) é reparo de uma vez, já executado; o
# estoque dele já foi conferido pela igualdade exata mais abaixo neste check.
# O que precisa convergir na FONTE é o gerador vivo, que roda de novo.
GERADOR_DATADO = re.compile(r"-\d{8}(\.py)?$")


def falhas_dos_produtores_python(raiz=None):
    """Gerador Python VIVO que declara word_count usa a fórmula do auditor?

    O caso concreto: tools/generate-v2-rescued-pages integrava as páginas
    resgatadas de /tmp e declarava `len(body.split())` sobre abertura +
    sections[].text — errado nas DUAS pontas (sem heading, sem FAQ, e sem
    quebrar número pontuado). Numa amostra com "Lei 9.494/97" e uma FAQ ele
    declarava 14 onde o auditor conta 32.
    """
    raiz = raiz or ROOT
    encontradas = []
    for caminho in sorted(glob.glob(os.path.join(raiz, "tools", "generate-*"))):
        nome = os.path.basename(caminho)
        if os.path.isdir(caminho) or GERADOR_DATADO.search(nome):
            continue
        try:
            with open(caminho, encoding="utf-8") as handle:
                fonte = handle.read()
        except (OSError, UnicodeDecodeError):
            continue
        for atribuicao in ATRIBUICAO_PY.finditer(fonte):
            expressao = atribuicao.group(1).strip()
            if "body_word_count" in expressao:
                continue
            # Variável intermediária: aceita se ela nasce de body_word_count.
            if re.fullmatch(r"[A-Za-z_]\w*", expressao) and re.search(
                    r"\b%s\s*=\s*[^=\n]*body_word_count\(" % re.escape(expressao),
                    fonte):
                continue
            encontradas.append(
                "%s declara word_count por `%s` — gerador vivo tem de usar "
                "body_word_count (tools/audit_v2_pages.py), a fórmula do gate; "
                "qualquer outra conta reabre a divergência do BUG-048"
                % (nome, expressao))
    return encontradas


def falhas_da_formula_do_produtor(nome, fonte_gerador):
    """Analisa a fonte Go de UM gerador e devolve as falhas de fórmula."""
    encontradas = []
    atribuicao = re.search(r"\.WordCount = (\w+)\(", fonte_gerador)
    if not atribuicao:
        return ["%s não declara mais WordCount por chamada de função — a "
                "verificação da fórmula do produtor cegou" % nome]
    funcao = atribuicao.group(1)
    corpo = re.search(r"func %s\(.*?\n\}" % re.escape(funcao), fonte_gerador,
                      re.DOTALL)
    if not corpo:
        return ["%s: não achei o corpo de %s()" % (nome, funcao)]
    corpo_texto = corpo.group(0)
    if "strings.Fields(" in corpo_texto:
        encontradas.append(
            "%s conta word_count com strings.Fields: número pontuado (Lei "
            "9.494/97) vira UMA palavra e o campo declarado nasce menor que o "
            "corpo real" % nome)
        return encontradas
    if "ptbrtext.BodyWords(" in corpo_texto:
        return encontradas
    # A cadeia pode passar por uma função intermediária do próprio gerador;
    # segue a chamada mais um nível antes de reprovar.
    for intermediaria in re.findall(r"len\((\w+)\(", corpo_texto):
        seguinte = re.search(r"func %s\(.*?\n\}" % re.escape(intermediaria),
                             fonte_gerador, re.DOTALL)
        if not seguinte:
            continue
        if "strings.Fields(" in seguinte.group(0):
            encontradas.append(
                "%s conta word_count com strings.Fields (via %s): número "
                "pontuado (Lei 9.494/97) vira UMA palavra e o campo declarado "
                "nasce menor que o corpo real" % (nome, intermediaria))
            return encontradas
        if "ptbrtext.BodyWords(" in seguinte.group(0):
            return encontradas
    encontradas.append(
        "%s não conta word_count por ptbrtext.BodyWords — toda contagem de "
        "corpo tem UMA implementação, e copiá-la é o defeito que o BUG-048 "
        "fechou" % nome)
    return encontradas


def carregar(nome_arquivo, nome_modulo):
    caminho = os.path.join(ROOT, "tools", nome_arquivo)
    spec = importlib.util.spec_from_loader(
        nome_modulo, importlib.machinery.SourceFileLoader(nome_modulo, caminho))
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def main():
    falhas = []

    # 1. A fórmula do Go ainda soma as mesmas partes?
    with open(VALIDATE_GO, encoding="utf-8") as handle:
        fonte_go = handle.read()
    corpo_go = fonte_go.split("func bodyWordCount")[1].split("\n}")[0]
    for parte in ("page.Opening", "section.Heading", "section.Text", "item.Q", "item.A"):
        if parte not in corpo_go:
            falhas.append("bodyWordCount não soma mais %s — a referência mudou "
                          "e este check precisa ser reescrito" % parte)

    # 2. O censo usa a mesma fórmula?
    censo = carregar("generate-v2-publication-severity", "gvps")
    if not hasattr(censo, "body_word_count"):
        falhas.append("o censo não expõe body_word_count")

    # 3. E as chaves do FAQ estão certas em quem lê texto visível?
    amostra_faq = {"opening": "", "sections": [],
                   "faq": [{"q": "pergunta unica xyz", "a": "resposta unica xyz"}]}
    if hasattr(censo, "visible_text"):
        visivel = censo.visible_text(amostra_faq)
        if "pergunta unica xyz" not in visivel or "resposta unica xyz" not in visivel:
            falhas.append("visible_text não lê o FAQ — as chaves são 'q' e 'a', "
                          "não 'question'/'answer'")

    # 3-bis. Os geradores de canal derivado declaram word_count pela fórmula única?
    falhas.extend(falhas_dos_produtores())

    divergentes = 0
    estouram = 0
    fora_do_exato = 0
    exemplos_exatos = []
    total = 0
    exemplos = []
    for caminho in sorted(glob.glob(PAGES)):
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                if not linha.strip():
                    continue
                registro = json.loads(linha)
                if not registro.get("intent_id"):
                    continue
                total += 1
                esperado = referencia(registro)
                if hasattr(censo, "body_word_count"):
                    obtido = censo.body_word_count(registro)
                    if obtido != esperado:
                        divergentes += 1
                        if len(exemplos) < 5:
                            exemplos.append((registro["intent_id"], esperado, obtido))
                declarado = registro.get("word_count")
                if declarado and esperado > 0 and abs(declarado - esperado) * TOLERANCIA > esperado:
                    estouram += 1
                # IGUALDADE EXATA, não só a tolerância do ingest.
                #
                # A regra do repositório é que `word_count` COPIA bodyWordCount.
                # Enquanto o check só cobrava os 10% do ingest, 950 páginas
                # divergiam em silêncio dentro da faixa — p50 de 4 palavras,
                # máximo de 91 — e nenhuma delas reprovava. A faixa é o limite do
                # que o ingest tolera, não a definição do campo.
                if (not registro.get("skipped") and esperado > 0
                        and declarado != esperado):
                    fora_do_exato += 1
                    if len(exemplos_exatos) < 5:
                        exemplos_exatos.append(
                            (registro["intent_id"], declarado, esperado))

    print("=== FÓRMULA DE CONTAGEM DO CORPO ===")
    print("registros no estoque              : %d" % total)
    print("censo diverge da referência       : %d" % divergentes)
    print("word_count declarado fora dos 10%% : %d" % estouram)
    print("word_count declarado != real      : %d" % fora_do_exato)
    for intent, esperado, obtido in exemplos:
        print("  %-46s referência=%-5d censo=%d" % (intent, esperado, obtido))
    for intent, declarado, real in exemplos_exatos:
        print("  %-46s declarado=%-5s real=%d" % (intent, declarado, real))

    if fora_do_exato:
        falhas.append("%d páginas vivas têm word_count declarado diferente do "
                      "corpo real — o campo COPIA bodyWordCount; conserte pelo "
                      "gerador datado: tools/generate-v2-word-count-refresh"
                      % fora_do_exato)
    if divergentes:
        falhas.append("o censo conta diferente do gate em %d registros" % divergentes)
    if estouram:
        falhas.append("%d registros têm word_count declarado fora da tolerância "
                      "do ingest" % estouram)

    if falhas:
        print("\nREPROVADO:")
        for falha in falhas:
            print("  - %s" % falha)
        return 1
    print("\nAPROVADO — censo, geradores e gate contam a mesma coisa.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
