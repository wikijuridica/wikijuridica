#!/usr/bin/env python3
"""Recusa publicar com censo mais velho que o estoque — e regenera se pedido.

POR QUE ISTO EXISTE (ordem do dono, 2026-08-27)
==============================================
"E o censo tem que acompanhar automaticamente, se não os conteúdos diários vão
falhar."

INVESTIGADO A FUNDO, e o achado corrige a suposição: **a onda diária já está
certa**. `tools/run-daily-content` roda, nesta ordem, geração (2/9) → censo
(7/9) → publicação (8/9) → brotli (8.5/9). O conteúdo diário nunca perde o
censo, porque ele é refeito depois de gerar e antes de publicar.

O FURO É A PUBLICAÇÃO FORA DA ONDA. Medido no mesmo dia: agentes regeneraram
390 páginas às ~10:00; o censo era das 04:36; a publicação manual das 11:00
recusou 5 páginas com `sem_linha_no_censo`. Elas existiam no estoque, estavam
corretas, e simplesmente não constavam de um censo anterior a elas.

Quem publica à mão — depois de um lote de correção, de uma reescrita, de um
gerador novo — não tem por que lembrar disso. Por isso a guarda é um gate, não
uma anotação em documento.

O QUE ELE FAZ
=============
Compara o mtime do censo com o do shard v2 mais recente. Censo mais velho que
qualquer shard significa que existe página que ele nunca viu, e publicar assim
recusa exatamente as páginas novas — as que mais importam.

Ele NÃO regenera: `tools/check-*` é read-only por contrato. Quem confere e
refaz numa passada é `tools/generate-censo-acompanha-estoque`.
"""
import argparse
import glob
import os
import sys

CENSO = "data/editorial/v2_publication_severity.jsonl"
SHARDS = "data/editorial/v2_pages/*.jsonl"
GERADOR = "tools/generate-v2-publication-severity"


def main() -> int:
    ap = argparse.ArgumentParser()
    args = ap.parse_args()

    if not os.path.exists(CENSO):
        print(f"{CENSO} nao existe — o censo nunca foi gerado", file=sys.stderr)
        return 1

    censo_em = os.path.getmtime(CENSO)
    mais_novos = []
    for caminho in glob.glob(SHARDS):
        if caminho.endswith(".partial.jsonl"):
            continue
        if os.path.getmtime(caminho) > censo_em:
            mais_novos.append((os.path.getmtime(caminho), caminho))

    if not mais_novos:
        print(f"censo em dia — nenhum shard v2 mais novo que {CENSO}")
        return 0

    mais_novos.sort(reverse=True)
    print(f"CENSO ATRASADO: {len(mais_novos)} shard(s) v2 mais novos que o censo.",
          file=sys.stderr)
    for quando, caminho in mais_novos[:5]:
        atraso = (quando - censo_em) / 60
        print(f"  {os.path.basename(caminho)} — {atraso:.0f} min mais novo",
              file=sys.stderr)
    print("Publicar assim recusa as paginas novas com `sem_linha_no_censo` — "
          "justamente as que motivaram a publicacao.", file=sys.stderr)

    # ★ ESTE CHECK NAO REGENERA, e a razao e de contrato (2026-08-29).
    #
    # Ate aqui ele aceitava `--regenerar` e chamava o gerador com `--write`.
    # A capacidade era util e veio de ordem do dono em 2026-08-27; o que estava
    # errado era o LUGAR. O contrato do repositorio separa os papeis:
    # `tools/check-*` e READ-ONLY, `tools/generate-*` escreve, e misturar os
    # dois num arquivo so e bug — porque um check que escreve pode ser chamado
    # por qualquer gatilho de leitura e mutar o repositorio sem que ninguem
    # tenha pedido.
    #
    # A capacidade NAO se perdeu: ela mora em tools/generate-censo-acompanha-
    # estoque, que faz a mesma verificacao e regenera quando ela reprova. Este
    # check continua sendo o unico que o pipeline de publicacao consulta.
    #
    # O achado veio do detector de `TestCheckWrappersDoNotGenerateTrackedArtifacts`,
    # que estava escondendo este caso atras de 188 falsos positivos — ele parava
    # no primeiro nome em ordem alfabetica, e o primeiro era falso.
    print(f"Rode `{GERADOR} --write`, ou `tools/generate-censo-acompanha-estoque`, "
          "que confere e regenera numa passada.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
