#!/usr/bin/env python3
"""generate-v2-cdc-art26-prazo-repair-20260806 — o prazo de noventa dias é do art. 26, não do art. 18.

O DEFEITO. Duas páginas de consumidor atribuem ao art. 18 do CDC o prazo de
noventa dias para reclamar do vício. O art. 18 não fixa esse prazo: ele
estabelece a responsabilidade solidária dos fornecedores pelo vício de qualidade
e, no § 1º, dá ao FORNECEDOR trinta dias para saná-lo. O prazo de que o
CONSUMIDOR dispõe para reclamar está no art. 26, II.

FONTE PRIMÁRIA, conferida em planalto.gov.br em 2026-08-06 e gravada em
data/legal-corpus/cdc.json:

  "Art. 26. O direito de reclamar pelos vícios aparentes ou de fácil constatação
   caduca em: I - trinta dias, tratando-se de fornecimento de serviço e de
   produtos não duráveis; II - noventa dias, tratando-se de fornecimento de
   serviço e de produtos duráveis."

  "Art. 18. [...] § 1° Não sendo o vício sanado no prazo máximo de trinta dias,
   pode o consumidor exigir, alternativamente e à sua escolha: [...]"

Os dois prazos existem, são de trinta e noventa dias, e correm para pessoas
diferentes. Confundi-los faz o leitor procurar no artigo errado quando for
conferir — e, num texto jurídico, a citação é o que permite conferir.

O NÚMERO DE DIAS ESTAVA CERTO. A correção não muda o prazo que o leitor precisa
observar; muda a atribuição, que estava no dispositivo errado. Por isso ela não
altera a orientação prática de nenhuma das duas páginas.

COMO FORAM ENCONTRADAS: tools/measure-citation-conformance, que confere o prazo
afirmado contra o texto oficial do artigo citado. Foram as DUAS únicas
divergências reais entre 719 citações de prazo conferidas no acervo — as outras
cinco da fila eram idade em anos lida como prazo, limite conhecido da
ferramenta.

CONTRATO DE ESCRITA (mesmo de generate-v2-prescricao-cdc27-repair-20260806):
lease de época, lock exclusivo, CAS pelo sha256 da LINHA viva, CAS por TRECHO
(exatamente uma ocorrência), demais linhas preservadas byte a byte, word_count
recalculado pela fórmula do ingest, escrita atômica com fsync, idempotente.
NÃO commita e NÃO republica.

Uso:
    tools/generate-v2-cdc-art26-prazo-repair-20260806 --dry-run
    tools/generate-v2-cdc-art26-prazo-repair-20260806
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.cdc-art26-prazo-repair-20260806.lock"

CITACAO = "art. 26, II, do CDC"

# intent_id -> (shard, trecho atual, trecho novo)
REPAROS: dict[str, tuple[str, str, str]] = {
    "cons-devolver-carro-comprado-na-loja-7-dias": (
        "data/editorial/v2_pages/consumidor-10.jsonl",
        "Se o carro apresentar vício de qualidade, o art. 18 do CDC garante o direito de reclamar dentro do prazo de noventa dias.",
        "Se o carro apresentar vício de qualidade, o art. 18 do CDC obriga a loja a responder por ele, e o prazo para reclamar é o do "
        + CITACAO + ": noventa dias, contados da entrega, por se tratar de produto durável.",
    ),
    "cons-atraso-na-entrega-de-carro-pcd": (
        "data/editorial/v2_pages/consumidor-10.jsonl",
        "Sim; qualquer vício na adaptação entregue com o carro é vício de qualidade coberto pelo art. 18 do CDC, com o mesmo prazo de noventa dias e as mesmas alternativas de conserto, troca ou devolução.",
        "Sim; qualquer vício na adaptação entregue com o carro é vício de qualidade coberto pelo art. 18 do CDC, com as mesmas alternativas de conserto, troca ou devolução; o prazo para reclamar é o do "
        + CITACAO + ", de noventa dias, por se tratar de produto durável.",
    ),
}

# O texto novo não pode afirmar mais do que a fonte primária sustenta.
TEXTOS_PROIBIDOS = ("jurisprudência pacífica", "entendimento pacificado", "sempre",
                    "garantido", "com certeza")


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go.

    O texto novo é mais longo que o antigo; declarar sem recalcular derruba a
    página no ingest (declared_word_count_incoherent).
    """
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def _contar(record: dict, trecho: str) -> int:
    total = (record.get("opening") or "").count(trecho)
    for section in record.get("sections") or []:
        total += (section.get("heading") or "").count(trecho)
        total += (section.get("text") or "").count(trecho)
    for item in record.get("faq") or []:
        total += (item.get("q") or "").count(trecho)
        total += (item.get("a") or "").count(trecho)
    return total


def _substituir(record: dict, antes: str, depois: str) -> bool:
    if antes in (record.get("opening") or ""):
        record["opening"] = record["opening"].replace(antes, depois)
        return True
    for section in record.get("sections") or []:
        if antes in (section.get("heading") or ""):
            section["heading"] = section["heading"].replace(antes, depois)
            return True
        if antes in (section.get("text") or ""):
            section["text"] = section["text"].replace(antes, depois)
            return True
    for item in record.get("faq") or []:
        if antes in (item.get("q") or ""):
            item["q"] = item["q"].replace(antes, depois)
            return True
        if antes in (item.get("a") or ""):
            item["a"] = item["a"].replace(antes, depois)
            return True
    return False


def preflight() -> None:
    problemas: list[str] = []
    for intent, (_shard, antes, depois) in sorted(REPAROS.items()):
        if antes == depois:
            problemas.append(f"{intent}: texto novo idêntico ao atual")
        if not antes or not depois:
            problemas.append(f"{intent}: trecho vazio")
        if CITACAO not in depois:
            problemas.append(f"{intent}: texto novo não cita o art. 26, II, do CDC")
        if "noventa dias" not in depois:
            problemas.append(f"{intent}: texto novo perdeu o prazo de noventa dias")
        if "art. 18 do CDC" not in depois:
            problemas.append(
                f"{intent}: texto novo apagou o art. 18, que continua sendo a base "
                f"da responsabilidade pelo vício")
        for proibido in TEXTOS_PROIBIDOS:
            if proibido in depois.lower():
                problemas.append(
                    f"{intent}: texto novo afirma mais do que se conferiu ({proibido!r})")
    if problemas:
        for problema in problemas:
            print(f"PREFLIGHT FALHOU: {problema}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(REPAROS)} correção(ões), "
          f"todas ancoradas no art. 26, II, do CDC e preservando o art. 18")


def aplicar(shard_rel: str, alvos: dict[str, tuple[str, str]], dry_run: bool) -> tuple[int, int]:
    path = ROOT / shard_rel
    linhas = path.read_bytes().decode("utf-8").split("\n")
    fim_com_newline = bool(linhas) and linhas[-1] == ""
    if fim_com_newline:
        linhas = linhas[:-1]

    saida: list[str] = []
    alterados = 0
    ja_feitos = 0
    for numero, raw in enumerate(linhas, 1):
        if not raw.strip():
            raise SystemExit(f"{shard_rel}: linha em branco {numero}")
        registro = json.loads(raw)
        intent = registro.get("intent_id")
        if intent not in alvos:
            saida.append(raw)
            continue

        antes, depois = alvos[intent]
        if _contar(registro, depois) == 1 and _contar(registro, antes) == 0:
            ja_feitos += 1
            saida.append(raw)
            continue

        ocorrencias = _contar(registro, antes)
        if ocorrencias != 1:
            raise SystemExit(
                f"CAS DE TRECHO FALHOU em {shard_rel}:{numero} ({intent}): "
                f"o trecho aparece {ocorrencias} vez(es), esperado exatamente 1. "
                f"Reler o conteúdo vivo antes de reaplicar.")

        digest_antes = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        if not _substituir(registro, antes, depois):
            raise SystemExit(f"{shard_rel}:{numero} ({intent}): substituição não aplicada")
        registro["word_count"] = word_count(registro)
        nova = json.dumps(registro, ensure_ascii=False, sort_keys=True)
        atual = hashlib.sha256(
            path.read_bytes().decode("utf-8").split("\n")[numero - 1].strip().encode("utf-8")
        ).hexdigest()
        if atual != digest_antes:
            raise SystemExit(
                f"CAS DE LINHA FALHOU em {shard_rel}:{numero} ({intent}): "
                f"outra frente tocou este registro durante a execução.")
        saida.append(nova)
        alterados += 1
        print(f"  corrigido: {intent} -> word_count={registro['word_count']}")

    if alterados and not dry_run:
        payload = "\n".join(saida) + ("\n" if fim_com_newline else "")
        atomic_write(path, payload.encode("utf-8"))
    return alterados, ja_feitos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    preflight()

    por_shard: dict[str, dict[str, tuple[str, str]]] = {}
    for intent, (shard, antes, depois) in REPAROS.items():
        por_shard.setdefault(shard, {})[intent] = (antes, depois)

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                total_alterados = 0
                total_ja = 0
                for shard in sorted(por_shard):
                    alterados, ja = aplicar(shard, por_shard[shard], args.dry_run)
                    total_alterados += alterados
                    total_ja += ja
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if args.dry_run:
        print(f"\n--dry-run: {total_alterados} correção(ões) aplicáveis, "
              f"{total_ja} já feita(s). Nada escrito.")
        return 0
    print(f"\n{total_alterados} corrigida(s), {total_ja} já estava(m) correta(s).")
    if total_alterados:
        print("Reingerir o estoque e republicar para o espelho refletir a correção.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
