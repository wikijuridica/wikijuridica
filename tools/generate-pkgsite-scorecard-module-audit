#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/pkgsite_scorecard_module_audit.jsonl}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/pkgsite_scorecard_module_audit.jsonl}"
exec "$ROOT/tools/generate-pkgsite-module-audit" \
	--modfile tools/sca/scorecard/go.mod \
	--go-sum tools/sca/scorecard/go.sum \
	--output data/ops/pkgsite_scorecard_module_audit.jsonl \
	--tool-directives \
	"$@"
