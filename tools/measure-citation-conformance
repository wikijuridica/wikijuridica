def autoteste(corpus):
    falhas = []
    print("=== AUTOTESTE: %d frases reais ===" % len(CASOS))
    for frase, artigo, qualificador, diploma, esperado in CASOS:
        resultado = avaliar({"article": artigo, "qualifier": qualificador,
                             "diploma": diploma, "claim": frase}, corpus)
        obtido = resultado["estado"]
        marca = "ok   " if obtido == esperado else "FALHA"
        if obtido != esperado:
            falhas.append((frase[:70], esperado, obtido, resultado.get("motivo", "")))
        print("  %s art. %-6s %-14s %s" % (marca, artigo, obtido, frase[:66]))
    if falhas:
        print("\nREPROVADO — %d caso(s):" % len(falhas))
        for frase, esperado, obtido, motivo in falhas:
            print("  esperado %s, obtido %s (%s)" % (esperado, obtido, motivo))
            print("    %s" % frase)
        return 1
    print("\nAPROVADO — inclusive os 5 casos que NÃO podem virar acusação.")
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--lane", default="", choices=["", "comercial", "informativa"])
    parser.add_argument("--exemplos", type=int, default=25)
    parser.add_argument("--autoteste", action="store_true")
    args = parser.parse_args()

    corpus = carregar_corpus()
    if not corpus:
        print("corpus vazio — rode tools/generate-legal-corpus", file=sys.stderr)
        return 1
    if args.autoteste:
        return autoteste(corpus)

    if autoteste(corpus):
        print("\nautoteste reprovou; medição abortada para não gerar dado falso.",
              file=sys.stderr)
        return 1
    print()

    estados = collections.Counter()
    divergentes = []
    linhas = []
    with open(INVENTARIO, encoding="utf-8") as handle:
        for linha in handle:
            registro = json.loads(linha)
            if args.lane and (registro.get("lane") or "") != args.lane:
                continue
            resultado = avaliar(registro, corpus)
            estados[resultado["estado"]] += 1
            if resultado["estado"] in ("DIVERGENTE", "CONFERIDO_OK"):
                saida = {
                    "intent_id": registro.get("intent_id"),
                    "path": registro.get("path"),
                    "lane": registro.get("lane"),
                    "article": registro.get("article"),
                    "qualifier": registro.get("qualifier"),
                    "diploma": registro.get("diploma"),
                    "diploma_explicito_na_frase": diploma_explicito(
                        registro.get("claim") or "", registro.get("article") or ""),
                }
                saida.update(resultado)
                linhas.append(saida)
                if resultado["estado"] == "DIVERGENTE":
                    divergentes.append(saida)

    total = sum(estados.values())
    print("=== CONFORMIDADE DA CITAÇÃO COM O TEXTO OFICIAL ===")
    print("escopo   : prazo, prescrição e decadência%s"
          % (" — lane %s" % args.lane if args.lane else ""))
    print("citações : %d" % total)
    print()
    for estado in ("CONFERIDO_OK", "DIVERGENTE", "NAO_CONFERIVEL", "AMBIGUO"):
        print("  %-16s %6d  (%.1f%%)"
              % (estado, estados[estado], 100.0 * estados[estado] / max(total, 1)))

    conferidas = estados["CONFERIDO_OK"] + estados["DIVERGENTE"]
    if conferidas:
        print("\nde %d citações efetivamente conferidas, %d divergem (%.1f%%)"
              % (conferidas, estados["DIVERGENTE"],
                 100.0 * estados["DIVERGENTE"] / conferidas))

    explicitas = [d for d in divergentes if d["diploma_explicito_na_frase"]]
    print("divergências com a lei ESCRITA na frase (sinal forte): %d de %d"
          % (len(explicitas), len(divergentes)))

    def formata(prazo):
        return ", ".join("%d %s" % (q, "meses" if u == "m" else "dias") for u, q in prazo)

    print("\n--- fila de LEITURA (não é veredito) ---")
    for caso in (explicitas + [d for d in divergentes if not d["diploma_explicito_na_frase"]])[:args.exemplos]:
        print("  %s  art. %s %s (%s)%s"
              % (caso["path"], caso["article"], caso["qualifier"], caso["diploma"],
                 "" if caso["diploma_explicito_na_frase"] else "  [diploma inferido]"))
        print("      pagina diz: %s | artigo tem: %s"
              % (formata(caso["prazo_afirmado"]), formata(caso["prazo_no_artigo"])))
        print("      %s" % caso["clausula"][:170])

    os.makedirs(os.path.dirname(EVIDENCIA), exist_ok=True)
    with open(EVIDENCIA, "w", encoding="utf-8") as handle:
        for linha in linhas:
            handle.write(json.dumps(linha, ensure_ascii=False) + "\n")
    with open(RESUMO, "w", encoding="utf-8") as handle:
        json.dump({
            "schema_version": "citation_conformance_v1",
            "measured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "escopo": "prazo_prescricao_decadencia",
            "lane": args.lane or "todas",
            "estados": dict(estados),
            "divergentes": len(divergentes),
            "divergentes_com_diploma_explicito": len(explicitas),
            "paginas_com_divergencia": len({d["path"] for d in divergentes}),
        }, handle, ensure_ascii=False, indent=1, sort_keys=True)
    print("\nevidência: %s" % os.path.relpath(EVIDENCIA, ROOT))
    print("            %s" % os.path.relpath(RESUMO, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
