#!/bin/sh
set -eu

# CDPATH='' e nao `CDPATH= `: o shell le os dois igual, mas o linter avisa
# SC1007 na forma com espaco ("Remove space after = if trying to assign a
# value"), porque ela tambem e o erro de digitacao classico de quem queria
# `CDPATH=x`. Neutralizar CDPATH e obrigatorio aqui: com ele definido, `cd --`
# pode imprimir o destino e mudar para diretorio de outro lugar da arvore.
#
# E a linha acima NAO comeca por "# shell"+"check": comentario que comeca assim e
# lido como DIRETIVA, e a primeira versao deste comentario derrubou o arquivo
# inteiro com SC1073/SC1072 ("Couldn't parse this shellcheck directive").
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
exec "$ROOT/tools/run-go-cmd-cached" ./cmd/quarantine-v2-portfolio-wip "$@"
