		committed_history="$(repo_metric_for git log --oneline -5)"
		head_show="$(repo_head_show_metric)"
	else
		repo_root=unavailable
		worktree_filesystem=unavailable
		status_short=unavailable
		unstaged_diff=unavailable
		staged_diff=unavailable
		untracked_files=unavailable
		committed_history=unavailable
		head_show=unavailable
	fi
	if [ "$inside_git" = true ]; then
		for required_metric in "$worktree_filesystem" "$status_short" "$unstaged_diff" "$staged_diff" "$untracked_files" "$committed_history" "$head_show"; do
			if [ "$required_metric" = unavailable ]; then
				echo "run-heavy-throttled: repo_awareness_unavailable required_git_metric_failed timeout=$repo_awareness_timeout" >&2
				exit 75
			fi
