	repo_fingerprint="$(
		sha256_token "$(
			printf '%s\n' \
				"$worktree_filesystem" "$status_short" "$unstaged_diff" "$staged_diff" \
				"$untracked_files" "$committed_history" "$head_show"
		)"
	)"
	if [ -z "$repo_fingerprint" ]; then
		repo_fingerprint=unavailable
	fi
	claim_budget_ms="${WIKI_HEAVY_BUDGET_MS:-$((command_timeout_seconds * 1000))}"
	claim_stop_condition="${WIKI_HEAVY_STOP_CONDITION:-command_exits_or_timeout_or_lock_wait_timeout}"
