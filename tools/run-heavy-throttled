#!/bin/sh
# shellcheck disable=SC2317
set -eu

if [ "$#" -eq 0 ]; then
	echo "usage: run-heavy-throttled COMMAND [ARGS...]" >&2
	exit 2
fi

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"

# Go 1.25+ already derives GOMAXPROCS from affinity/cgroup quota and updates it
# while the process runs.  Exporting a guessed value disables that adaptation.
# Preserve an inherited value and support only an explicit operator override.
if [ -n "${WIKI_HEAVY_GOMAXPROCS+x}" ]; then
	case "$WIKI_HEAVY_GOMAXPROCS" in
	'' | *[!0-9]* | 0 | ???????????*)
		echo "run-heavy-throttled: WIKI_HEAVY_GOMAXPROCS must be a positive integer" >&2
		exit 2
		;;
	esac
	if [ "$WIKI_HEAVY_GOMAXPROCS" -gt 2147483647 ]; then
		echo "run-heavy-throttled: WIKI_HEAVY_GOMAXPROCS exceeds the runtime integer range" >&2
		exit 2
	fi
	export GOMAXPROCS="$WIKI_HEAVY_GOMAXPROCS"
fi

# Neutral scheduling is the scalable default.  Throttling is an explicit,
# measured operator choice rather than a permanent penalty on every producer.
nice_level="${WIKI_HEAVY_NICE:-0}"
case "$nice_level" in
'' | *[!0-9]* | ???*)
	echo "run-heavy-throttled: WIKI_HEAVY_NICE must be an integer between 0 and 19" >&2
	exit 2
	;;
esac
if [ "$nice_level" -gt 19 ]; then
	echo "run-heavy-throttled: WIKI_HEAVY_NICE must be an integer between 0 and 19" >&2
	exit 2
fi
# ★ DEFAULT `ionice -c2 -n7`, E ELE VOLTOU EM 2026-08-30 (BUG-188).
#
# Ao parametrizar classe e nivel, o default da CLASSE ficou VAZIO — e como o
# bloco de aplicacao e `if [ -n "$ionice_class" ]`, o efeito pratico foi
# desligar a despriorizacao de I/O por padrao. Comando pesado voltou a disputar
# disco em pe de igualdade com quem esta trabalhando ao lado, que e exatamente o
# que este wrapper existe para impedir.
#
# `TestHeavyCommandThrottleWrapperExistsForAgentUse` cobra o literal
# `ionice -c2 -n7` desde que o wrapper nasceu; ele estava vermelho e ninguem o
# executava (commit acima de seis pacotes pula o teste focado em silencio). O
# gate estava certo e o wrapper e que tinha regredido.
#
# A parametrizacao FICA — ela e util e `WIKI_HEAVY_IONICE_CLASS=3` continua
# dando idle real. O que muda e o default: classe 2 (best-effort), nivel 7 (o
# mais baixo dela).
ionice_class="${WIKI_HEAVY_IONICE_CLASS:-2}"
ionice_level="${WIKI_HEAVY_IONICE_LEVEL:-7}"
case "$ionice_class" in
'' | 1 | 2 | 3) ;;
*)
	echo "run-heavy-throttled: WIKI_HEAVY_IONICE_CLASS must be 1, 2, 3 or unset" >&2
	exit 2
	;;
esac
if [ -n "$ionice_class" ]; then
	case "$ionice_level" in
	'' | *[!0-7]* | ??*)
		echo "run-heavy-throttled: WIKI_HEAVY_IONICE_LEVEL must be an integer between 0 and 7" >&2
		exit 2
		;;
	esac
fi
if [ -n "${WIKI_HEAVY_LOCK_DIR:-}" ]; then
	lock_root_explicit=1
	lock_root="$WIKI_HEAVY_LOCK_DIR"
else
	lock_root_explicit=0
	lock_repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel 2>/dev/null || printf '%s' "$script_dir/..")"
	lock_repo_root="$(realpath -e -- "$lock_repo_root" 2>/dev/null || true)"
	lock_repo_identity="$(stat -Lc '%d:%i' -- "$lock_repo_root" 2>/dev/null || true)"
	lock_uid="$(id -u 2>/dev/null || true)"
	if [ -z "$lock_repo_root" ] || [ -z "$lock_repo_identity" ] || [ -z "$lock_uid" ]; then
		echo "run-heavy-throttled: cannot derive stable repository lock identity" >&2
		exit 75
	fi
	lock_repo_key="$(printf '%s\n' "$lock_repo_identity" | sha256sum | awk '{print $1}')"
	if [ -d "/run/user/$lock_uid" ] && [ ! -L "/run/user/$lock_uid" ] &&
		[ "$(stat -Lc '%u' -- "/run/user/$lock_uid" 2>/dev/null || true)" = "$lock_uid" ]; then
		lock_runtime_root="/run/user/$lock_uid"
	else
		lock_runtime_root="/tmp"
	fi
	lock_root="$lock_runtime_root/portaljuridico-heavy-$lock_uid-$lock_repo_key"
fi
command_identity="$(
	{
		printf 'argc:%s\n' "$#"
		for arg in "$@"; do
			printf 'arg:%s\n' "$arg"
		done
	}
)"
command_text="$*"
if [ -n "${WIKI_HEAVY_LOCK_SCOPE:-}" ]; then
	lock_scope="scope:${WIKI_HEAVY_LOCK_SCOPE}"
else
	lock_scope="command:${command_identity}"
fi
lock_key="$(
	printf '%s\n' "$lock_scope" | sha256sum | awk '{print $1}'
)"
lock_dir="$lock_root/$lock_key.lock"
lock_meta="$lock_dir/meta"
lock_wait_seconds="${WIKI_HEAVY_LOCK_WAIT_SECONDS:-600}"
lock_wait_notice_seconds="${WIKI_HEAVY_LOCK_WAIT_NOTICE_SECONDS:-30}"
lock_stale_seconds="${WIKI_HEAVY_LOCK_STALE_SECONDS:-21600}"
lock_heartbeat_seconds="${WIKI_HEAVY_LOCK_HEARTBEAT_SECONDS:-30}"
lock_heartbeat_stale_seconds="${WIKI_HEAVY_LOCK_HEARTBEAT_STALE_SECONDS:-180}"
command_timeout_seconds="${WIKI_HEAVY_TIMEOUT_SECONDS:-540}"
command_timeout_kill_after_seconds="${WIKI_HEAVY_TIMEOUT_KILL_AFTER_SECONDS:-30}"
repo_awareness_timeout="${WIKI_REPO_AWARENESS_TIMEOUT:-2s}"
repo_awareness_timeout_explicit=0
progress_monitor_mode="${WIKI_HEAVY_PROGRESS_MONITOR:-auto}"
progress_monitor_window_seconds="${WIKI_HEAVY_PROGRESS_WINDOW_SECONDS:-}"
progress_monitor_alert_windows="${WIKI_HEAVY_PROGRESS_ALERT_WINDOWS:-2}"
progress_monitor_tool="$script_dir/check-command-progress"
progress_watchdog_tool="$script_dir/run-heavy-progress-watchdog"
process_tree_supervisor="$script_dir/supervise-process-tree"
progress_monitor_pid=""
progress_expected_duration_ms=""
progress_monitor_initial_delay_seconds=0
if [ -n "${WIKI_REPO_AWARENESS_TIMEOUT+x}" ]; then
	repo_awareness_timeout_explicit=1
fi

case "$lock_wait_notice_seconds" in
'' | *[!0-9]* | ??????*)
	echo "run-heavy-throttled: WIKI_HEAVY_LOCK_WAIT_NOTICE_SECONDS must be numeric seconds or 0" >&2
	exit 2
	;;
esac
case "$lock_wait_seconds" in
'' | *[!0-9]* | ??????*)
	echo "run-heavy-throttled: WIKI_HEAVY_LOCK_WAIT_SECONDS must be numeric seconds or 0" >&2
	exit 2
	;;
esac
case "$lock_stale_seconds" in
'' | *[!0-9]* | ???????*)
	echo "run-heavy-throttled: WIKI_HEAVY_LOCK_STALE_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
case "$lock_heartbeat_seconds" in
'' | *[!0-9]* | ??????*)
	echo "run-heavy-throttled: WIKI_HEAVY_LOCK_HEARTBEAT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
case "$lock_heartbeat_stale_seconds" in
'' | *[!0-9]* | ???????*)
	echo "run-heavy-throttled: WIKI_HEAVY_LOCK_HEARTBEAT_STALE_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
case "$command_timeout_seconds" in
'' | *[!0-9]* | ??????*)
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
if [ "$command_timeout_seconds" -le 0 ]; then
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if [ "$command_timeout_seconds" -gt 86400 ]; then
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_SECONDS must not exceed 86400 seconds" >&2
	exit 2
fi
case "$command_timeout_kill_after_seconds" in
'' | *[!0-9]* | ????*)
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_KILL_AFTER_SECONDS must be a positive integer seconds" >&2
	exit 2
	;;
esac
if [ "$command_timeout_kill_after_seconds" -le 0 ]; then
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_KILL_AFTER_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if [ "$command_timeout_kill_after_seconds" -gt 300 ]; then
	echo "run-heavy-throttled: WIKI_HEAVY_TIMEOUT_KILL_AFTER_SECONDS must not exceed 300 seconds" >&2
	exit 2
fi
if [ ! -f "$process_tree_supervisor" ] || [ ! -x "$process_tree_supervisor" ] || [ -L "$process_tree_supervisor" ]; then
	echo "run-heavy-throttled: bounded process-tree supervisor missing, non-executable or symlink: $process_tree_supervisor" >&2
	exit 2
fi

positive_integer() {
	case "$1" in
	'' | *[!0-9]*) return 1 ;;
	esac
	awk -v value="$1" 'BEGIN {
		exit !(value ~ /^[0-9]+$/ && (value + 0) >= 1 && (value + 0) <= 9000000000000000)
	}'
}

process_start_ticks() {
	process_identity_pid="$1"
	case "$process_identity_pid" in
	'' | *[!0-9]* | 0) return 1 ;;
	esac
	process_identity_stat="$(cat "/proc/$process_identity_pid/stat" 2>/dev/null || true)"
	case "$process_identity_stat" in
	*') '*) ;;
	*) return 1 ;;
	esac
	# /proc/PID/stat field 2 is parenthesized and may itself contain ')' or
	# spaces.  Removing through the last ") " leaves field 3 first; starttime
	# (field 22) is therefore the twentieth token in the remaining payload.
	process_identity_tail="${process_identity_stat##*) }"
	set -- $process_identity_tail
	if [ "$#" -lt 20 ]; then
		return 1
	fi
	shift 19
	case "$1" in
	'' | *[!0-9]* | 0) return 1 ;;
	esac
	printf '%s' "$1"
}

process_identity_active_or_unknown() {
	process_identity_pid="$1"
	process_identity_expected_start="$2"
	if ! kill -0 "$process_identity_pid" 2>/dev/null; then
		process_identity_state=dead
		return 1
	fi
	case "$process_identity_expected_start" in
	exited_before_identity_pin)
		process_identity_state=exited_before_identity_pin
		return 1
		;;
	'' | *[!0-9]* | 0)
		# Compatibility for a lock written by an already-running older wrapper:
		# never reclaim a numerically live but unpinned legacy PID.
		process_identity_state=alive_unpinned
		return 0
		;;
	esac
	process_identity_current_start="$(process_start_ticks "$process_identity_pid" || true)"
	case "$process_identity_current_start" in
	'' | *[!0-9]* | 0)
		# Procfs becoming unreadable must fail safe rather than release a live
		# writer's lock.
		process_identity_state=alive_identity_unreadable
		return 0
		;;
	esac
	if [ "$process_identity_current_start" = "$process_identity_expected_start" ]; then
		process_identity_state=alive_identity_match
		return 0
	fi
	process_identity_state=pid_reused
	return 1
}

positive_duration() {
	case "$1" in
	*ms) duration_number="${1%ms}" ;;
	*s) duration_number="${1%s}" ;;
	*m) duration_number="${1%m}" ;;
	*h) duration_number="${1%h}" ;;
	*) return 1 ;;
	esac
	positive_integer "$duration_number"
}

valid_stop_condition() {
	case "$1" in
	'' | *'
'*) return 1 ;;
	esac
	stop_condition_lower="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
	case "$stop_condition_lower" in
	placeholder | later | todo | unknown | absent | missing | ausente | desconhecido | \
		*placeholder* | *todo*)
		return 1
		;;
	esac
	printf '%s' "$stop_condition_lower" | grep -Eq '[[:alnum:]]'
}

valid_throughput_expected() {
	throughput_key="${1%%=*}"
	throughput_value="${1#*=}"
	if [ "$throughput_key" = "$1" ]; then
		return 1
	fi
	case "$throughput_key" in
	records_per_second | pages_per_second | urls_per_second | items_per_second | records/s | pages/s | throughput) ;;
	*) return 1 ;;
	esac
	case "$throughput_value" in
	'' | *[!0-9.]* | *.*.*) return 1 ;;
	esac
	awk -v value="$throughput_value" 'BEGIN { exit !(value ~ /^[0-9]+([.][0-9]+)?$/ && (value + 0) > 0) }'
}

duration_to_ms() {
	duration_value="$1"
	positive_duration "$duration_value" || return 1
	case "$duration_value" in
	*ms)
		duration_number="${duration_value%ms}"
		duration_factor=1
		;;
	*s)
		duration_number="${duration_value%s}"
		duration_factor=1000
		;;
	*m)
		duration_number="${duration_value%m}"
		duration_factor=60000
		;;
	*h)
		duration_number="${duration_value%h}"
		duration_factor=3600000
		;;
	esac
	# 9e15 ms keeps integer conversion exact in awk and is far beyond any
	# practical wrapper timeout, while rejecting arithmetic overflow inputs.
	awk -v number="$duration_number" -v factor="$duration_factor" 'BEGIN {
		milliseconds = number * factor
		if (milliseconds < 1 || milliseconds > 9000000000000000) exit 1
		printf "%.0f", milliseconds
	}'
}

shared_artifact_claim_path() {
	path="$1"
	case "$path" in
	data/* | ./data/* | content/* | ./content/* | public/* | ./public/* | .agents/* | ./.agents/* | .release-staging/* | ./.release-staging/*)
		return 0
		;;
	esac
	repo_root_for_claim="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
	case "$path" in
	"$repo_root_for_claim"/data/* | "$repo_root_for_claim"/content/* | "$repo_root_for_claim"/public/* | "$repo_root_for_claim"/.agents/* | "$repo_root_for_claim"/.release-staging/*)
		return 0
		;;
	esac
	return 1
}

artifact_claim_resolved_path() {
	path="$1"
	repo_root_for_claim="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
	case "$path" in
	/*) printf '%s\n' "$path" ;;
	./*) printf '%s/%s\n' "$repo_root_for_claim" "${path#./}" ;;
	*) printf '%s/%s\n' "$repo_root_for_claim" "$path" ;;
	esac
}

artifact_claim_path_exists() {
	path="$1"
	[ -n "$path" ] || return 1
	resolved_path="$(artifact_claim_resolved_path "$path")"
	[ -e "$resolved_path" ]
}

contains_shell_wrapped_direct_generate() {
	case "$1" in
	*"go run ./cmd/generate-"* | *"go run cmd/generate-"* | \
		*"go-modern run ./cmd/generate-"* | *"go-modern run cmd/generate-"*)
		return 0
		;;
	esac
	return 1
}

validate_heavy_project_command_contract() {
	project_heavy_command=0
	explicit_heavy_monitor_contract=0
	project_heavy_cached_runner=0
	project_direct_generate_command=0
	project_cached_generate_command=0
	project_shell_direct_generate_command=0
	has_timings=0
	has_supervisor_wall_clock=0
	has_budget=0
	has_expected_duration=0
	has_stop_condition=0
	has_throughput_expected=0
	has_explicit_artifact_claim=0
	expect_budget_value=0
	expect_duration_value=0
	argument_expected_duration_ms=0
	previous_arg=""
	previous_base=""
	previous2_base=""
	# COMPILAR OU TESTAR UM GERADOR NAO E EXECUTAR UM GERADOR, e a diferenca
	# nao cabia na janela de dois argumentos que o resto deste laco usa:
	# `go-modern test -count=1 ./internal/x/ ./cmd/generate-y/` chega no
	# caminho do gerador com o subcomando ja tres posicoes atras. Sem este
	# estado, o catch-all abaixo classificava a passada como execucao de
	# gerador e exigia `cached_runner`, que `go test` nao tem como
	# satisfazer -- entao NENHUM teste de `cmd/generate-*` podia rodar
	# dentro do envelope, e o envelope e obrigatorio para suite pesada.
	# `go generate` fica DE FORA da lista de proposito: aquilo escreve.
	visto_toolchain_go=0
	subcomando_apenas_analisa=0

	if [ -n "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-}" ] &&
		[ -n "${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-}" ] &&
		[ -n "${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-}" ]; then
		has_explicit_artifact_claim=1
	fi
	case "${WIKI_HEAVY_TIMING_MODE:-}" in
	'') ;;
	supervisor_wall_clock_v1) has_supervisor_wall_clock=1 ;;
	child_flag_v1) ;;
	*)
		echo "run-heavy-throttled: WIKI_HEAVY_TIMING_MODE must be supervisor_wall_clock_v1 or child_flag_v1" >&2
		exit 2
		;;
	esac

	for arg in "$@"; do
		base="${arg##*/}"
		parent="${arg%/*}"
		parent_base="${parent##*/}"
		if contains_shell_wrapped_direct_generate "$arg"; then
			project_heavy_command=1
			project_direct_generate_command=1
			project_shell_direct_generate_command=1
		fi
		if [ "$expect_budget_value" = "1" ]; then
			if positive_integer "$arg"; then
				has_budget=1
			fi
			expect_budget_value=0
		fi
		if [ "$expect_duration_value" = "1" ]; then
			if converted_duration_ms="$(duration_to_ms "$arg")"; then
				has_expected_duration=1
				argument_expected_duration_ms="$converted_duration_ms"
			fi
			expect_duration_value=0
		fi

		case "$base" in
		go-modern | go) visto_toolchain_go=1 ;;
		esac
		if [ "$visto_toolchain_go" = 1 ]; then
			case "$arg" in
			test | build | vet) subcomando_apenas_analisa=1 ;;
			esac
		fi
		case "$base" in
		run-check)
			project_heavy_command=1
			project_heavy_cached_runner=1
			;;
		esac
		if [ "$previous_base" = "run-go-cmd-cached" ]; then
			case "$arg" in
			./cmd/check | ./cmd/check-* | ./cmd/generate | ./cmd/generate-* | ./cmd/probe-* | cmd/generate | cmd/probe-*)
				project_heavy_command=1
				project_heavy_cached_runner=1
				case "$arg" in
				./cmd/generate | ./cmd/generate-* | cmd/generate | cmd/generate-*) project_cached_generate_command=1 ;;
				esac
				;;
			esac
		fi
		if { [ "$previous2_base" = "go-modern" ] || [ "$previous2_base" = "go" ]; } && [ "$previous_arg" = "run" ]; then
			case "$arg" in
			./cmd/check | ./cmd/check-* | ./cmd/generate | ./cmd/generate-* | ./cmd/probe-* | cmd/generate | cmd/probe-*)
				project_heavy_command=1
				case "$arg" in
				./cmd/generate | ./cmd/generate-* | cmd/generate | cmd/generate-*) project_direct_generate_command=1 ;;
				esac
				;;
			esac
		fi
		case "$arg" in
		./cmd/generate | ./cmd/generate-* | cmd/generate | cmd/generate-*)
			if [ "$subcomando_apenas_analisa" != 1 ] &&
				[ "$previous_base" != "run-go-cmd-cached" ] &&
				! { { [ "$previous2_base" = "go-modern" ] || [ "$previous2_base" = "go" ]; } && [ "$previous_arg" = "run" ]; }; then
				project_heavy_command=1
				project_direct_generate_command=1
			fi
			;;
		esac
		case "$parent_base/$base" in
		generate-*/generate-*)
			project_heavy_command=1
			project_direct_generate_command=1
			;;
		esac

		case "$arg" in
		--timings)
			has_timings=1
			;;
		--budget-ms=*)
			if positive_integer "${arg#--budget-ms=}"; then
				has_budget=1
			fi
			;;
		--max-duration=*)
			if converted_duration_ms="$(duration_to_ms "${arg#--max-duration=}")"; then
				has_expected_duration=1
				argument_expected_duration_ms="$converted_duration_ms"
			fi
			;;
		--budget-ms | --max-duration)
			if [ "$arg" = "--budget-ms" ]; then
				expect_budget_value=1
			else
				expect_duration_value=1
			fi
			;;
		esac

		previous2_base="$previous_base"
		previous_arg="$arg"
		previous_base="$base"
	done

	if [ -n "${WIKI_HEAVY_BUDGET_MS:-}" ] && positive_integer "$WIKI_HEAVY_BUDGET_MS"; then
		has_budget=1
	fi
	if [ -n "${WIKI_HEAVY_EXPECTED_DURATION_MS:-}" ] && positive_integer "$WIKI_HEAVY_EXPECTED_DURATION_MS"; then
		has_expected_duration=1
	fi
	if valid_stop_condition "${WIKI_HEAVY_STOP_CONDITION:-}"; then
		has_stop_condition=1
	fi
	if valid_throughput_expected "${WIKI_HEAVY_THROUGHPUT_EXPECTED:-}"; then
		has_throughput_expected=1
	fi
	if [ "$has_budget" = "1" ] &&
		[ "$has_expected_duration" = "1" ] &&
		[ "$has_stop_condition" = "1" ] &&
		[ "$has_throughput_expected" = "1" ]; then
		explicit_heavy_monitor_contract=1
	fi
	if [ "$project_heavy_command" != "1" ]; then
		return 0
	fi

	missing=""
	if [ "$project_heavy_cached_runner" != "1" ]; then
		missing="${missing} cached_runner"
	fi
	if { [ "$project_direct_generate_command" = "1" ] || [ "$project_cached_generate_command" = "1" ]; } &&
		[ "$has_explicit_artifact_claim" != "1" ]; then
		missing="${missing} artifact_claim(./cmd/generate-* shared artifact)"
	fi
	if { [ "$project_direct_generate_command" = "1" ] || [ "$project_cached_generate_command" = "1" ]; } &&
		[ "$has_explicit_artifact_claim" = "1" ] &&
		! shared_artifact_claim_path "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH"; then
		missing="${missing} artifact_claim(./cmd/generate-* shared artifact)"
	fi
	if { [ "$project_direct_generate_command" = "1" ] || [ "$project_cached_generate_command" = "1" ]; } &&
		[ "$has_explicit_artifact_claim" = "1" ] &&
		shared_artifact_claim_path "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH" &&
		! artifact_claim_path_exists "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH"; then
		# Cold start (ULTRAPLAN E3/E5): o generate-* e o PRODUTOR do artefato
		# reivindicado — a ausencia do arquivo e o estado inicial legitimo da
		# regeneracao do zero (DEC-015 moveu o stale para o lado). O que
		# precisa existir e o diretorio de destino.
		if [ -d "$(dirname "$(artifact_claim_resolved_path "$WIKI_HEAVY_ARTIFACT_CLAIM_PATH")")" ]; then
			echo "run-heavy-throttled: artifact_claim_path_cold_start path=$WIKI_HEAVY_ARTIFACT_CLAIM_PATH producer_will_create=1 command=$*" >&2
		else
			echo "run-heavy-throttled: work_reuse_artifact_claim_path_missing path=$WIKI_HEAVY_ARTIFACT_CLAIM_PATH action=create_or_correct_artifact_claim_path_before_run command=$*" >&2
			exit 2
		fi
	fi
	if [ "$project_shell_direct_generate_command" = "1" ]; then
		missing="${missing} direct go run ./cmd/generate-* shell-wrapper-bypass"
	fi
	if [ "$has_timings" != "1" ] && [ "$has_supervisor_wall_clock" != "1" ]; then
		missing="${missing} timing_evidence(--timings or supervisor_wall_clock_v1) throughput"
	fi
	if [ "${WIKI_HEAVY_TIMING_MODE:-}" = "child_flag_v1" ] && [ "$has_timings" != "1" ]; then
		missing="${missing} --timings(child_flag_v1 capability)"
	fi
