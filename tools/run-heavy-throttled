budget_ms_from_args() {
	expect_budget_value=0
	for arg in "$@"; do
		if [ "$expect_budget_value" = "1" ]; then
			if positive_integer "$arg"; then
				printf '%s' "$arg"
				return 0
			fi
			expect_budget_value=0
		fi
		case "$arg" in
		--budget-ms=*)
			value="${arg#--budget-ms=}"
			if positive_integer "$value"; then
				printf '%s' "$value"
				return 0
			fi
			;;
		--budget-ms)
			expect_budget_value=1
			;;
		esac
	done
	printf '0'
}

timeout_seconds_from_budget_ms() {
	budget_ms="$1"
	seconds=$(((budget_ms + 999) / 1000))
	if [ "$seconds" -lt 1 ]; then
		seconds=1
	fi
	printf '%s' "$seconds"
}

budget_timeout_candidate="${WIKI_HEAVY_BUDGET_MS:-}"
if ! positive_integer "$budget_timeout_candidate"; then
	budget_timeout_candidate="$(budget_ms_from_args "$@")"
fi
# O timeout efetivo é o MENOR entre WIKI_HEAVY_BUDGET_MS e
# WIKI_HEAVY_TIMEOUT_SECONDS. O clamp é correto (budget é o contrato de custo),
# mas era SILENCIOSO: ~97 wrappers em tools/ declaram os dois e o
# TIMEOUT_SECONDS explícito quase nunca está em vigor. Guardamos aqui o valor
# sobrescrito para orientar o operador NA HORA DO TIMEOUT (fim do script) —
# sem ruído no caminho de sucesso, onde o clamp é esperado e irrelevante.
budget_clamped_from_timeout_seconds=""
if positive_integer "$budget_timeout_candidate"; then
	budget_timeout_seconds="$(timeout_seconds_from_budget_ms "$budget_timeout_candidate")"
	if [ "$budget_timeout_seconds" -lt "$command_timeout_seconds" ]; then
		if [ -n "${WIKI_HEAVY_TIMEOUT_SECONDS:-}" ]; then
			budget_clamped_from_timeout_seconds="$command_timeout_seconds"
		fi
		command_timeout_seconds="$budget_timeout_seconds"
	fi
fi

if [ -z "${WIKI_REPO_AWARENESS_TIMEOUT+x}" ]; then
	budget_candidate="${WIKI_HEAVY_BUDGET_MS:-}"
	if ! positive_integer "$budget_candidate"; then
		budget_candidate="$(budget_ms_from_args "$@")"
	fi
	expected_candidate="${WIKI_HEAVY_EXPECTED_DURATION_MS:-}"
	if { positive_integer "$budget_candidate" && [ "$budget_candidate" -le 2000 ]; } ||
		{ positive_integer "$expected_candidate" && [ "$expected_candidate" -le 2000 ]; }; then
		repo_awareness_timeout=0.2s
	fi
fi

configure_progress_monitor() {
	case "$progress_monitor_mode" in
	auto | off) ;;
	*)
		echo "run-heavy-throttled: WIKI_HEAVY_PROGRESS_MONITOR must be auto or off" >&2
		exit 2
		;;
	esac
	case "$progress_monitor_alert_windows" in
	'' | *[!0-9]* | 0 | ????????*)
		echo "run-heavy-throttled: WIKI_HEAVY_PROGRESS_ALERT_WINDOWS must be a positive integer" >&2
		exit 2
		;;
	esac
	if [ "$progress_monitor_alert_windows" -gt 1000000 ]; then
		echo "run-heavy-throttled: WIKI_HEAVY_PROGRESS_ALERT_WINDOWS must not exceed 1000000" >&2
		exit 2
	fi
	if [ -n "$progress_monitor_window_seconds" ]; then
		case "$progress_monitor_window_seconds" in
		'' | *[!0-9]* | 0 | ???*)
			echo "run-heavy-throttled: WIKI_HEAVY_PROGRESS_WINDOW_SECONDS must be an integer from 1 to 60" >&2
			exit 2
			;;
		esac
		if [ "$progress_monitor_window_seconds" -gt 60 ]; then
			echo "run-heavy-throttled: WIKI_HEAVY_PROGRESS_WINDOW_SECONDS must be an integer from 1 to 60" >&2
			exit 2
		fi
	fi

	if [ "${project_heavy_command:-0}" != "1" ] &&
		[ "${explicit_heavy_monitor_contract:-0}" != "1" ]; then
		echo "run-heavy-throttled: progress_monitor=off reason=no_explicit_heavy_contract command=$*" >&2
		progress_monitor_mode=off
		progress_monitor_window_seconds=0
		progress_monitor_initial_delay_seconds=0
		return 0
	fi
	if [ "$progress_monitor_mode" = "off" ]; then
		echo "run-heavy-throttled: progress_monitor=off explicit diagnostic opt-out command=$*" >&2
		progress_monitor_window_seconds=0
		progress_monitor_initial_delay_seconds=0
		return 0
	fi
	if [ ! -f "$progress_monitor_tool" ] || [ ! -x "$progress_monitor_tool" ] || [ -L "$progress_monitor_tool" ]; then
		echo "run-heavy-throttled: progress monitor missing, non-executable or symlink: $progress_monitor_tool" >&2
		exit 2
	fi
	if [ ! -f "$progress_watchdog_tool" ] || [ ! -x "$progress_watchdog_tool" ] || [ -L "$progress_watchdog_tool" ]; then
		echo "run-heavy-throttled: progress watchdog missing, non-executable or symlink: $progress_watchdog_tool" >&2
		exit 2
	fi
	progress_expected_duration_ms="${WIKI_HEAVY_EXPECTED_DURATION_MS:-}"
	if ! positive_integer "$progress_expected_duration_ms"; then
		progress_expected_duration_ms="${argument_expected_duration_ms:-0}"
	fi
	if ! positive_integer "$progress_expected_duration_ms"; then
		progress_expected_duration_ms="$budget_timeout_candidate"
	fi
	if ! positive_integer "$progress_expected_duration_ms"; then
		progress_expected_duration_ms=$((command_timeout_seconds * 1000))
	fi
	progress_timeout_ms=$((command_timeout_seconds * 1000))
	if [ "$progress_expected_duration_ms" -gt "$progress_timeout_ms" ]; then
		echo "run-heavy-throttled: expected duration must not exceed effective command timeout (${progress_timeout_ms}ms)" >&2
		exit 2
	fi
	if [ -z "$progress_monitor_window_seconds" ]; then
		# ceil(expected/4) converted to seconds, clamped to 1..30. The first
		# observation finishes only when the declared expected duration is due.
		progress_monitor_window_seconds=$(((progress_expected_duration_ms + 3999) / 4000))
		if [ "$progress_monitor_window_seconds" -lt 1 ]; then
			progress_monitor_window_seconds=1
		elif [ "$progress_monitor_window_seconds" -gt 30 ]; then
			progress_monitor_window_seconds=30
		fi
	fi
	progress_expected_duration_seconds=$(((progress_expected_duration_ms + 999) / 1000))
	progress_monitor_initial_delay_seconds=$((progress_expected_duration_seconds - progress_monitor_window_seconds))
	if [ "$progress_monitor_initial_delay_seconds" -lt 0 ]; then
		progress_monitor_initial_delay_seconds=0
	fi
}

