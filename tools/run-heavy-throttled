	claim_output="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-command_status_and_lock_release}"
	claim_output_fingerprint="$(sha256_token "$claim_output")"

	echo "run-heavy-throttled: repo_awareness data_read_paths=worktree_filesystem;git status --short;git diff;git diff --cached;git ls-files --others --exclude-standard;git log;git show --stat HEAD;committed_history;staged;unstaged;untracked repo_root=$(inline_token "$repo_root") worktree_filesystem=$worktree_filesystem status=$status_short diff=$unstaged_diff diff_cached=$staged_diff untracked=$untracked_files committed_history=$committed_history log=$committed_history show=$head_show timeout=$(inline_token "$repo_awareness_timeout") timeout_explicit=$repo_awareness_timeout_explicit input_fingerprint=$repo_fingerprint" >&2
	echo "run-heavy-throttled: artifact_claim path=$(inline_token "$claim_path") producer=$(inline_token "$claim_producer") input_fingerprint=$repo_fingerprint output_fingerprint_expected=$claim_output_fingerprint output_fingerprint_description=$(inline_token "$claim_output") lock_scope=$(inline_token "$lock_scope") budget_ms=$(inline_token "$claim_budget_ms") stop_condition=$(inline_token "$claim_stop_condition")" >&2
}

