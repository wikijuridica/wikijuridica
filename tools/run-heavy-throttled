fi
chmod 0700 -- "$lock_root"

write_lock_meta() {
	child_pid_value="${1:-}"
	child_start_ticks_value=""
	if [ -n "$child_pid_value" ]; then
		child_start_ticks_value="$(process_start_ticks "$child_pid_value" || true)"
		case "$child_start_ticks_value" in
		'' | *[!0-9]* | 0)
			if kill -0 "$child_pid_value" 2>/dev/null; then
				# An apparently live child without a pinned procfs identity cannot
				# be represented safely in reclaimable lock metadata.
				return 1
			fi
			child_start_ticks_value=exited_before_identity_pin
			;;
		esac
	fi
	{
		printf 'pid:%s\n' "$$"
		printf 'pid_start_ticks:%s\n' "$owner_start_ticks"
		if [ -n "$child_pid_value" ]; then
			printf 'child_pid:%s\n' "$child_pid_value"
			printf 'child_pid_start_ticks:%s\n' "${child_start_ticks_value:-missing}"
			printf 'child_command:%s\n' "$command_text"
		fi
		printf 'started_epoch:%s\n' "$start_epoch"
		printf 'heartbeat_seconds:%s\n' "$lock_heartbeat_seconds"
		printf 'heartbeat_stale_seconds:%s\n' "$lock_heartbeat_stale_seconds"
		printf 'timeout_seconds:%s\n' "$command_timeout_seconds"
		printf 'budget_ms:%s\n' "${WIKI_HEAVY_BUDGET_MS:-missing}"
		printf 'expected_duration_ms:%s\n' "${WIKI_HEAVY_EXPECTED_DURATION_MS:-missing}"
		printf 'stop_condition:%s\n' "$(printf '%s' "${WIKI_HEAVY_STOP_CONDITION:-missing}" | tr '\n' ' ')"
		printf 'artifact_claim_path:%s\n' "$(printf '%s' "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-.agents/runtime/command-ledger.jsonl}" | tr '\n' ' ')"
		printf 'artifact_claim_producer:%s\n' "$(printf '%s' "${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/run-heavy-throttled}" | tr '\n' ' ')"
		printf 'artifact_claim_output_fingerprint_expected:%s\n' "$(sha256_token "${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-command_status_and_lock_release}")"
		printf 'progress_monitor_mode:%s\n' "$progress_monitor_mode"
		printf 'progress_monitor_window_seconds:%s\n' "$progress_monitor_window_seconds"
		printf 'progress_monitor_alert_windows:%s\n' "$progress_monitor_alert_windows"
		printf 'progress_monitor_expected_duration_ms:%s\n' "${progress_expected_duration_ms:-missing}"
		printf 'progress_monitor_initial_delay_seconds:%s\n' "$progress_monitor_initial_delay_seconds"
		printf 'scope:%s\n' "$lock_scope"
		printf 'command:%s\n' "$command_text"
	} >"$lock_meta" 2>/dev/null
}

write_provisional_lock_meta() {
	{
		printf 'pid:%s\n' "$$"
		printf 'pid_start_ticks:%s\n' "$owner_start_ticks"
		printf 'started_epoch:%s\n' "$start_epoch"
		printf 'timeout_seconds:%s\n' "$command_timeout_seconds"
		printf 'budget_ms:%s\n' "${WIKI_HEAVY_BUDGET_MS:-missing}"
		printf 'expected_duration_ms:%s\n' "${WIKI_HEAVY_EXPECTED_DURATION_MS:-missing}"
		printf 'stop_condition:%s\n' "$(printf '%s' "${WIKI_HEAVY_STOP_CONDITION:-missing}" | tr '\n' ' ')"
		printf 'artifact_claim_path:%s\n' "$(printf '%s' "${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-.agents/runtime/command-ledger.jsonl}" | tr '\n' ' ')"
		printf 'artifact_claim_producer:%s\n' "$(printf '%s' "${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/run-heavy-throttled}" | tr '\n' ' ')"
		printf 'artifact_claim_output_fingerprint_expected:%s\n' "$(sha256_token "${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-command_status_and_lock_release}")"
		printf 'progress_monitor_mode:%s\n' "$progress_monitor_mode"
		printf 'progress_monitor_window_seconds:%s\n' "$progress_monitor_window_seconds"
		printf 'progress_monitor_alert_windows:%s\n' "$progress_monitor_alert_windows"
		printf 'progress_monitor_expected_duration_ms:%s\n' "${progress_expected_duration_ms:-missing}"
		printf 'progress_monitor_initial_delay_seconds:%s\n' "$progress_monitor_initial_delay_seconds"
		printf 'scope:%s\n' "$lock_scope"
		printf 'command:%s\n' "$command_text"
		printf 'lifecycle:%s\n' "lock_acquired_before_supervised_command"
	} >"$lock_meta" 2>/dev/null
}

lock_dir_mtime_epoch() {
	stat -c %Y "$lock_dir" 2>/dev/null || printf '0'
}

lock_meta_mtime_epoch() {
	stat -c %Y "$lock_meta" 2>/dev/null || printf '0'
}

lock_holder_summary() {
	if [ ! -f "$lock_meta" ]; then
		printf 'holder=metadata_missing'
		return 0
	fi
	holder_pid="$(sed -n 's/^pid://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	holder_started="$(sed -n 's/^started_epoch://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	case "$holder_pid" in
	'' | *[!0-9]*) holder_pid=unknown ;;
	esac
	case "$holder_started" in
	'' | *[!0-9]*) holder_started=unknown ;;
	esac
	printf 'holder_pid=%s holder_started_epoch=%s' "$holder_pid" "$holder_started"
}

lock_meta_first() {
	lock_meta_key="$1"
	sed -n "s/^${lock_meta_key}://p" "$lock_meta" 2>/dev/null | sed -n '1p'
}

lock_wait_budget_ms() {
	case "$lock_wait_seconds" in
	'' | *[!0-9]*) printf 'missing' ;;
	*) printf '%s' "$((lock_wait_seconds * 1000))" ;;
	esac
}

lock_holder_active_analysis() {
	waiter_budget_ms="$(lock_wait_budget_ms)"
	if [ ! -f "$lock_meta" ]; then
		echo "run-heavy-throttled: analise_comando_ativo pid=unknown command=unknown artifact=.agents/runtime/command-ledger.jsonl lock_scope=$lock_scope elapsed_ms=0 cpu_percent=unknown throughput=absent owner_budget_ms=missing waiter_budget_ms=$waiter_budget_ms stop_condition=lock_wait_timeout_or_lock_released hypothesis=lock_metadata_missing next_action=reorient_to_independent_p0_or_wait_only_if_critical_dependency" >&2
		return 0
	fi
	holder_pid="$(lock_meta_first pid)"
	holder_child_pid="$(lock_meta_first child_pid)"
	holder_started="$(lock_meta_first started_epoch)"
	holder_command="$(lock_meta_first command)"
	holder_timeout_seconds="$(lock_meta_first timeout_seconds)"
	holder_budget_ms="$(lock_meta_first budget_ms)"
	holder_stop_condition="$(lock_meta_first stop_condition)"
	holder_artifact_claim_path="$(lock_meta_first artifact_claim_path)"
	case "$holder_pid" in
	'' | *[!0-9]*) holder_pid=unknown ;;
	esac
	case "$holder_child_pid" in
	'' | *[!0-9]*) holder_child_pid=unknown ;;
	esac
	case "$holder_started" in
	'' | *[!0-9]*) holder_started=0 ;;
	esac
	if [ -z "$holder_command" ]; then
		holder_command=unknown
	fi
	case "$holder_budget_ms" in
	'' | *[!0-9]*) owner_budget_ms=missing ;;
	*) owner_budget_ms="$holder_budget_ms" ;;
	esac
	if [ -z "$holder_stop_condition" ]; then
		holder_stop_condition=missing
	fi
	if [ -z "$holder_artifact_claim_path" ]; then
		holder_artifact_claim_path=.agents/runtime/command-ledger.jsonl
	fi
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	elapsed_ms=0
	if [ "$holder_started" -gt 0 ] && [ "$now_epoch" -gt 0 ] && [ "$now_epoch" -ge "$holder_started" ]; then
		elapsed_ms=$(((now_epoch - holder_started) * 1000))
	fi
	cpu_percent=unknown
	tree_processes=unknown
	analysis_pid="$holder_child_pid"
	if [ "$analysis_pid" = "unknown" ]; then
		analysis_pid="$holder_pid"
	fi
	if [ "$analysis_pid" != "unknown" ] && [ -x "$progress_monitor_tool" ]; then
		analysis_output="$({
			"$process_tree_supervisor" \
				--timeout-seconds 3 \
				--kill-after-seconds 1 \
				--term-grace-seconds 1 \
				--kill-grace-seconds 1 \
				--fail-on-descendant-cleanup \
				--close-fd8 \
				-- "$progress_monitor_tool" "$analysis_pid" --window-seconds 1
		} 2>/dev/null 8>&- || true)"
		analysis_schema="$(printf '%s\n' "$analysis_output" | sed -n 's/.* schema=\([^ ]*\).*/\1/p' | tail -n 1)"
		if [ "$analysis_schema" = "command-progress/v4" ]; then
			cpu_percent="$(printf '%s\n' "$analysis_output" | sed -n 's/.* cpu_percent=\([^ ]*\).*/\1/p' | tail -n 1)"
			tree_processes="$(printf '%s\n' "$analysis_output" | sed -n 's/.* tree_processes_after=\([^ ]*\).*/\1/p' | tail -n 1)"
			[ -n "$cpu_percent" ] || cpu_percent=unknown
			[ -n "$tree_processes" ] || tree_processes=unknown
		fi
	fi
	echo "run-heavy-throttled: analise_comando_ativo pid=$analysis_pid owner_pid=$holder_pid command=$holder_command artifact=$holder_artifact_claim_path lock_scope=$lock_scope elapsed_ms=$elapsed_ms cpu_percent=$cpu_percent tree_processes=$tree_processes throughput=absent owner_budget_ms=$owner_budget_ms owner_timeout_seconds=$holder_timeout_seconds waiter_budget_ms=$waiter_budget_ms stop_condition=$holder_stop_condition hypothesis=active_heavy_command_or_stale_lock next_action=reorient_to_independent_p0_or_wait_only_if_critical_dependency" >&2
}

validate_lock_wait_classification_or_exit() {
	classification="${WIKI_HEAVY_WAIT_CLASSIFICATION:-}"
	case "$classification" in
	non_critical_wait)
		echo "run-heavy-throttled: non_critical_wait forbids passive lock sleep; reorient to independent P0 front lock_scope=$lock_scope command=$*" >&2
		exit 75
		;;
	critical_dependency)
		missing=""
		case "${WIKI_HEAVY_DEPENDENCY_ID:-}" in '' | *placeholder* | *later*) missing="${missing} dependency_id" ;; esac
		case "${WIKI_HEAVY_OWNER_PID:-}" in '' | *[!0-9]*) missing="${missing} owner_pid" ;; esac
		case "${WIKI_HEAVY_WAIT_TIMEOUT_MS:-}" in '' | *[!0-9]* | 0) missing="${missing} timeout_ms" ;; esac
		case "${WIKI_HEAVY_LAST_EVIDENCE:-}" in '' | *placeholder* | *later*) missing="${missing} ultima_evidencia" ;; esac
		case "${WIKI_HEAVY_REORIENTATION_COMMAND:-}" in '' | *placeholder* | *later*) missing="${missing} comando_reorientacao" ;; esac
		if [ -z "$missing" ]; then
			dependency_wait_seconds="$(awk -v milliseconds="$WIKI_HEAVY_WAIT_TIMEOUT_MS" 'BEGIN {
				if (milliseconds !~ /^[0-9]+$/ || milliseconds < 1 || milliseconds > 86400000) exit 1
				printf "%.0f", int((milliseconds + 999) / 1000)
			}' 2>/dev/null || true)"
			case "$dependency_wait_seconds" in
			'' | *[!0-9]* | 0) missing="${missing} timeout_ms_bounded" ;;
			esac
		fi
		if [ -z "$missing" ]; then
			holder_owner_pid="$(lock_meta_first pid)"
			holder_child_pid="$(lock_meta_first child_pid)"
			case "$holder_owner_pid" in '' | *[!0-9]*) holder_owner_pid=unknown ;; esac
			case "$holder_child_pid" in '' | *[!0-9]*) holder_child_pid=unknown ;; esac
			if [ "${WIKI_HEAVY_OWNER_PID:-}" != "$holder_owner_pid" ] &&
				[ "${WIKI_HEAVY_OWNER_PID:-}" != "$holder_child_pid" ]; then
				missing="${missing} owner_pid_matches_active_lock"
			fi
		fi
		if [ -n "$missing" ]; then
			echo "run-heavy-throttled: critical_dependency lock wait missing structured fields:$missing lock_scope=$lock_scope command=$*" >&2
			exit 75
		fi
		if [ "$dependency_wait_seconds" -lt "$lock_wait_seconds" ]; then
			lock_wait_seconds="$dependency_wait_seconds"
		fi
		;;
	*)
		echo "run-heavy-throttled: active lock requires WIKI_HEAVY_WAIT_CLASSIFICATION=critical_dependency with dependency_id/owner_pid/timeout_ms/ultima_evidencia/comando_reorientacao or non_critical_wait reorientation; refusing passive sleep lock_scope=$lock_scope command=$*" >&2
		exit 75
		;;
	esac
}

reclaim_missing_meta_lock() {
	if [ -f "$lock_meta" ] || [ ! -d "$lock_dir" ]; then
		return 1
	fi
	case "$lock_stale_seconds" in
	'' | *[!0-9]*) return 1 ;;
	esac
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	meta_started="$(lock_dir_mtime_epoch)"
	if [ "$now_epoch" -le 0 ]; then
		return 1
	fi
	if [ "$meta_started" -le 0 ]; then
		return 1
	fi
	age=$((now_epoch - meta_started))
	if [ "$age" -lt "$lock_stale_seconds" ]; then
		return 1
	fi
	rmdir "$lock_dir" >/dev/null 2>&1 || return 1
	echo "run-heavy-throttled: reclaimed stale heavy lock with missing metadata scope=$lock_scope age=${age}s" >&2
	return 0
}

reclaim_stale_lock() {
	if [ ! -f "$lock_meta" ]; then
		reclaim_missing_meta_lock
		return $?
	fi
	meta_pid="$(sed -n 's/^pid://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_pid_start_ticks="$(sed -n 's/^pid_start_ticks://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_child_pid="$(sed -n 's/^child_pid://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_child_pid_start_ticks="$(sed -n 's/^child_pid_start_ticks://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_started="$(sed -n 's/^started_epoch://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_heartbeat_seconds="$(sed -n 's/^heartbeat_seconds://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	meta_heartbeat_stale_seconds="$(sed -n 's/^heartbeat_stale_seconds://p' "$lock_meta" 2>/dev/null | sed -n '1p')"
	case "$meta_pid" in
	'' | *[!0-9]*) meta_pid=0 ;;
	esac
	case "$meta_child_pid" in
	'' | *[!0-9]*) meta_child_pid=0 ;;
	esac
	case "$meta_started" in
	'' | *[!0-9]*) meta_started="$(lock_dir_mtime_epoch)" ;;
	esac
	case "$meta_heartbeat_seconds" in
	'' | *[!0-9]*) meta_heartbeat_seconds=0 ;;
	esac
	case "$meta_heartbeat_stale_seconds" in
	'' | *[!0-9]*) meta_heartbeat_stale_seconds="$lock_heartbeat_stale_seconds" ;;
	esac
	case "$lock_stale_seconds" in
	'' | *[!0-9]*) return 1 ;;
	esac
	meta_pid_identity_state=absent
	if [ "$meta_pid" -gt 0 ] && process_identity_active_or_unknown "$meta_pid" "$meta_pid_start_ticks"; then
		meta_pid_identity_state="$process_identity_state"
		if [ "$meta_heartbeat_seconds" -gt 0 ] && [ "$meta_heartbeat_stale_seconds" -gt 0 ]; then
			now_epoch="$(date +%s 2>/dev/null || printf '0')"
			meta_mtime="$(lock_meta_mtime_epoch)"
			if [ "$now_epoch" -gt 0 ] && [ "$meta_mtime" -gt 0 ]; then
				age=$((now_epoch - meta_mtime))
				if [ "$age" -ge "$meta_heartbeat_stale_seconds" ]; then
					echo "run-heavy-throttled: active_pid_expired_heartbeat scope=$lock_scope pid=$meta_pid age=${age}s; refusing to reclaim active lock" >&2
					return 1
				fi
			fi
		fi
		return 1
	fi
	if [ "$meta_pid" -gt 0 ]; then
		meta_pid_identity_state="$process_identity_state"
	fi
	meta_child_pid_identity_state=absent
	if [ "$meta_child_pid" -gt 0 ] && process_identity_active_or_unknown "$meta_child_pid" "$meta_child_pid_start_ticks"; then
		meta_child_pid_identity_state="$process_identity_state"
		echo "run-heavy-throttled: owner_dead_child_active scope=$lock_scope owner_pid=$meta_pid owner_identity=$meta_pid_identity_state child_pid=$meta_child_pid child_identity=$meta_child_pid_identity_state; refusing to reclaim active child lock" >&2
		return 1
	fi
	if [ "$meta_child_pid" -gt 0 ]; then
		meta_child_pid_identity_state="$process_identity_state"
	fi
	if [ "$meta_pid" -gt 0 ]; then
		dead_pid_heartbeat_age=0
		rm -f "$lock_meta" >/dev/null 2>&1 || return 1
		rmdir "$lock_dir" >/dev/null 2>&1 || return 1
		echo "run-heavy-throttled: reclaimed stale heavy lock with dead pid and expired heartbeat scope=$lock_scope pid=$meta_pid owner_identity=$meta_pid_identity_state child_identity=$meta_child_pid_identity_state age=${dead_pid_heartbeat_age}s" >&2
		return 0
	fi
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	if [ "$now_epoch" -le 0 ]; then
		return 1
	fi
	if [ "$meta_heartbeat_seconds" -gt 0 ] && [ "$meta_heartbeat_stale_seconds" -gt 0 ]; then
		meta_mtime="$(lock_meta_mtime_epoch)"
		if [ "$meta_mtime" -gt 0 ]; then
			dead_pid_heartbeat_age=$((now_epoch - meta_mtime))
			if [ "$dead_pid_heartbeat_age" -ge "$meta_heartbeat_stale_seconds" ]; then
				rm -f "$lock_meta" >/dev/null 2>&1 || return 1
				rmdir "$lock_dir" >/dev/null 2>&1 || return 1
				echo "run-heavy-throttled: reclaimed stale heavy lock with dead pid and expired heartbeat scope=$lock_scope pid=$meta_pid age=${dead_pid_heartbeat_age}s" >&2
				return 0
			fi
		fi
	fi
	if [ "$meta_started" -le 0 ]; then
		return 1
	fi
	age=$((now_epoch - meta_started))
	if [ "$age" -lt "$lock_stale_seconds" ]; then
		return 1
	fi
	rm -f "$lock_meta" >/dev/null 2>&1 || return 1
	rmdir "$lock_dir" >/dev/null 2>&1 || return 1
	echo "run-heavy-throttled: reclaimed stale heavy lock scope=$lock_scope pid=$meta_pid age=${age}s" >&2
	return 0
}

last_lock_wait_notice_epoch="$start_epoch"
active_lock_analysis_emitted=0
while ! mkdir "$lock_dir" 2>/dev/null; do
	if reclaim_stale_lock; then
		continue
	fi
	now_epoch="$(date +%s 2>/dev/null || printf '0')"
	if [ "$active_lock_analysis_emitted" = "0" ]; then
		lock_holder_active_analysis
		active_lock_analysis_emitted=1
		validate_lock_wait_classification_or_exit "$@"
	fi
	if [ "$start_epoch" -gt 0 ] && [ "$now_epoch" -gt 0 ]; then
		elapsed=$((now_epoch - start_epoch))
		if [ "$elapsed" -ge "$lock_wait_seconds" ]; then
			echo "run-heavy-throttled: identical heavy command already running or shared heavy scope blocked after ${lock_wait_seconds}s: $lock_scope: $*" >&2
			exit 75
		fi
	fi
	if [ "$lock_wait_notice_seconds" -gt 0 ] && [ "$now_epoch" -gt 0 ] && [ "$last_lock_wait_notice_epoch" -gt 0 ]; then
		notice_elapsed=$((now_epoch - last_lock_wait_notice_epoch))
		if [ "$notice_elapsed" -ge "$lock_wait_notice_seconds" ]; then
			echo "run-heavy-throttled: waiting for heavy lock scope=$lock_scope elapsed=${elapsed:-0}s wait_limit=${lock_wait_seconds}s $(lock_holder_summary)" >&2
			lock_holder_active_analysis
			last_lock_wait_notice_epoch="$now_epoch"
		fi
	fi
	sleep 2 8>&-
done

if ! chmod 0700 "$lock_dir"; then
	rmdir "$lock_dir" >/dev/null 2>&1 || true
	echo "run-heavy-throttled: failed to make progress/lock directory private: $lock_dir" >&2
	exit 75
fi

write_provisional_lock_meta || {
	rm -f "$lock_meta" >/dev/null 2>&1 || true
	rmdir "$lock_dir" >/dev/null 2>&1 || true
	echo "run-heavy-throttled: failed to write provisional heavy lock metadata for $lock_scope" >&2
	exit 75
}

write_lock_meta "" || {
	rm -f "$lock_meta" >/dev/null 2>&1 || true
	rmdir "$lock_dir" >/dev/null 2>&1 || true
	echo "run-heavy-throttled: failed to write heavy lock metadata for $lock_scope" >&2
	exit 75
}

lock_heartbeat_pid=""

wait_owned_child_bounded() {
	wait_owned_pid="$1"
	wait_owned_grace_seconds="$2"
	case "$wait_owned_pid" in
	'' | *[!0-9]*) return 0 ;;
	esac
	if ! kill -0 "$wait_owned_pid" 2>/dev/null; then
		if wait "$wait_owned_pid" 2>/dev/null; then
			wait_owned_status=0
		else
			wait_owned_status=$?
		fi
		return "$wait_owned_status"
	fi
	wait_owned_timer_timeout=$((wait_owned_grace_seconds + 3))
	# A raw background subshell around `sleep` is not sufficient: killing that
	# shell can orphan the external sleep process with the caller's output FDs
	# open, making an already-finished command appear hung for the whole grace
	# period.  Supervise the timer tree too and disconnect all of its streams.
	"$process_tree_supervisor" \
		--timeout-seconds "$wait_owned_timer_timeout" \
		--kill-after-seconds 1 \
		--term-grace-seconds 1 \
		--kill-grace-seconds 1 \
		--fail-on-descendant-cleanup \
		--close-fd8 \
		-- sh -c '
			target_pid=$1
			grace_seconds=$2
			sleep "$grace_seconds"
			if kill -0 "$target_pid" 2>/dev/null; then
				kill -TERM "$target_pid" 2>/dev/null || true
				sleep 1
				kill -KILL "$target_pid" 2>/dev/null || true
			fi
		' run-heavy-owned-timer "$wait_owned_pid" "$wait_owned_grace_seconds" \
		</dev/null >/dev/null 2>&1 8>&- &
	wait_owned_watchdog_pid=$!
	# The background fork briefly inherits this wrapper's TERM trap before
	# exec resets signal dispositions.  Do not send the cancellation signal in
	# that window: the inherited trap could consume it and leave the full grace
	# timer running.  A changed /proc/PID/exe proves that exec has happened.
	wait_owned_parent_exe="$(readlink -f "/proc/$$/exe" 2>/dev/null || true)"
	wait_owned_timer_ready=0
	wait_owned_timer_ready_attempt=0
	while [ "$wait_owned_timer_ready_attempt" -lt 50 ]; do
		wait_owned_timer_exe="$(readlink -f "/proc/$wait_owned_watchdog_pid/exe" 2>/dev/null || true)"
		if [ -n "$wait_owned_timer_exe" ] && [ "$wait_owned_timer_exe" != "$wait_owned_parent_exe" ]; then
			wait_owned_timer_ready=1
			break
		fi
		if ! kill -0 "$wait_owned_watchdog_pid" 2>/dev/null; then
			break
		fi
		sleep 0.01 8>&-
		wait_owned_timer_ready_attempt=$((wait_owned_timer_ready_attempt + 1))
	done
	if [ "$wait_owned_timer_ready" != "1" ]; then
		kill -KILL "$wait_owned_watchdog_pid" >/dev/null 2>&1 || true
		wait "$wait_owned_watchdog_pid" >/dev/null 2>&1 || true
		kill -KILL "$wait_owned_pid" >/dev/null 2>&1 || true
	fi
	if wait "$wait_owned_pid" 2>/dev/null; then
		wait_owned_status=0
	else
		wait_owned_status=$?
	fi
	kill -TERM "$wait_owned_watchdog_pid" >/dev/null 2>&1 || true
	wait "$wait_owned_watchdog_pid" >/dev/null 2>&1 || true
	return "$wait_owned_status"
}

start_lock_heartbeat() {
	if [ "$lock_heartbeat_seconds" -le 0 ]; then
		return 0
	fi
	heartbeat_timeout_seconds=$((command_timeout_seconds + command_timeout_kill_after_seconds + 60))
	if [ "$heartbeat_timeout_seconds" -gt 86400 ]; then
		heartbeat_timeout_seconds=86400
	fi
	"$process_tree_supervisor" \
		--timeout-seconds "$heartbeat_timeout_seconds" \
		--kill-after-seconds 2 \
		--term-grace-seconds 1 \
		--kill-grace-seconds 2 \
		--fail-on-descendant-cleanup \
		--close-fd8 \
		-- sh -c '
			meta=$1
			interval=$2
			while :; do
				remaining=$interval
				while [ "$remaining" -gt 0 ]; do
					sleep 1
					[ -f "$meta" ] || exit 0
					remaining=$((remaining - 1))
				done
				touch "$meta" >/dev/null 2>&1 || exit 0
			done
		' run-heavy-heartbeat "$lock_meta" "$lock_heartbeat_seconds" 8>&- &
	lock_heartbeat_pid=$!
}

stop_lock_heartbeat() {
	if [ -n "$lock_heartbeat_pid" ]; then
		kill "$lock_heartbeat_pid" >/dev/null 2>&1 || true
		wait_owned_child_bounded "$lock_heartbeat_pid" 5 >/dev/null 2>&1 || true
		lock_heartbeat_pid=""
	fi
}

start_progress_monitor() {
	if [ "$progress_monitor_mode" = "off" ] || [ -z "$child_pid" ]; then
		return 0
	fi
	watchdog_deadline_seconds="$command_timeout_seconds"
	watchdog_supervisor_deadline_seconds=$((watchdog_deadline_seconds + 5))
	if [ "$watchdog_supervisor_deadline_seconds" -gt 86400 ]; then
		watchdog_supervisor_deadline_seconds=86400
	fi
	"$process_tree_supervisor" \
		--timeout-seconds "$watchdog_supervisor_deadline_seconds" \
		--kill-after-seconds 2 \
		--term-grace-seconds 1 \
		--kill-grace-seconds 2 \
		--fail-on-descendant-cleanup \
		--close-fd8 \
		-- "$progress_watchdog_tool" \
		--target-pid "$child_pid" \
		--check-command-progress "$progress_monitor_tool" \
		--supervise-process-tree "$process_tree_supervisor" \
		--lock-dir "$lock_dir" \
		--lock-scope "$lock_scope" \
		--initial-delay-seconds "$progress_monitor_initial_delay_seconds" \
		--window-seconds "$progress_monitor_window_seconds" \
		--alert-windows "$progress_monitor_alert_windows" \
		--deadline-seconds "$watchdog_deadline_seconds" 8>&- &
	progress_monitor_pid=$!
}

stop_progress_monitor() {
	if [ -n "$progress_monitor_pid" ]; then
		# Signal only the watchdog created by this wrapper, never the producer.
		kill "$progress_monitor_pid" >/dev/null 2>&1 || true
		wait_owned_child_bounded "$progress_monitor_pid" 8 >/dev/null 2>&1 || true
		progress_monitor_pid=""
	fi
}

cleanup_lock() {
	set +e
	stop_progress_monitor
	stop_lock_heartbeat
	rm -f "$lock_meta" >/dev/null 2>&1
	rmdir "$lock_dir" >/dev/null 2>&1
	cleanup_factory_chain_lock
}

cleanup_factory_chain_lock() {
	factory_meta="${P0_FACTORY_CHAIN_LOCK_META_PATH:-}"
	case "$factory_meta" in
	'')
		return 0
		;;
	esac
	case "$factory_meta" in
	*/portaljuridico-p0-factory-chain-v2-*/p0-factory-chain.lock.meta)
		;;
	*)
		return 0
		;;
	esac
	[ -f "$factory_meta" ] || return 0
	factory_meta_pid="$(sed -n 's/^pid[:=]//p' "$factory_meta" 2>/dev/null | sed -n '1p')"
	if [ "$factory_meta_pid" = "$$" ]; then
		rm -f "$factory_meta" >/dev/null 2>&1 || true
	fi
}

child_pid=""

signal_child() {
	signal_name="$1"
	if [ -z "$child_pid" ]; then
		return 0
	fi
	if ! kill -0 "$child_pid" 2>/dev/null; then
		return 0
	fi
	kill "-$signal_name" "$child_pid" 2>/dev/null || true
}

wait_for_child_after_signal() {
	if [ -z "$child_pid" ]; then
		return 0
	fi
	fallback_kill_seconds=$((command_timeout_kill_after_seconds + 12))
	wait_owned_child_bounded "$child_pid" "$fallback_kill_seconds" >/dev/null 2>&1 || true
}

forward_signal() {
	signal_name="$1"
	status="$2"
	trap - HUP INT QUIT TERM
	signal_child "$signal_name"
	wait_for_child_after_signal
	cleanup_lock
	exit "$status"
}

run_supervised() {
	child_pid=""
	"$process_tree_supervisor" \
		--timeout-seconds "$command_timeout_seconds" \
		--kill-after-seconds "$command_timeout_kill_after_seconds" \
		--term-grace-seconds 2 \
		--kill-grace-seconds 5 \
		--fail-on-descendant-cleanup \
		--close-fd8 \
		-- /bin/sh -c 'umask "$WIKI_HEAVY_CHILD_UMASK"; exec "$@"' sh "$@" &
	child_pid=$!
	if ! write_lock_meta "$child_pid"; then
		echo "run-heavy-throttled: failed to write real child process metadata for $lock_scope child_pid=$child_pid" >&2
		signal_child TERM
		wait_for_child_after_signal
		return 75
	fi
	start_progress_monitor
	wait "$child_pid"
	child_status=$?
	stop_progress_monitor
	child_pid=""
	return "$child_status"
}

run_command() {
	export WIKI_RUN_GO_CMD_CACHED_UNDER_HEAVY=1
	if [ -n "$ionice_class" ]; then
		if ! command -v ionice >/dev/null 2>&1; then
			echo "run-heavy-throttled: ionice is required when WIKI_HEAVY_IONICE_CLASS is set" >&2
			return 2
		fi
		if [ "$ionice_class" = "3" ]; then
			if [ "$nice_level" -gt 0 ]; then
				run_with_timeout ionice -c3 nice -n "$nice_level" "$@"
			else
				run_with_timeout ionice -c3 "$@"
			fi
		else
			if [ "$nice_level" -gt 0 ]; then
				run_with_timeout ionice -c"$ionice_class" -n"$ionice_level" nice -n "$nice_level" "$@"
			else
				run_with_timeout ionice -c"$ionice_class" -n"$ionice_level" "$@"
			fi
		fi
		return $?
	fi

	if [ "$nice_level" -gt 0 ]; then
		if ! command -v nice >/dev/null 2>&1; then
			echo "run-heavy-throttled: nice is required when WIKI_HEAVY_NICE is positive" >&2
			return 2
		fi
		run_with_timeout nice -n "$nice_level" "$@"
		return $?
	fi

	run_with_timeout "$@"
}

run_with_timeout() {
	run_supervised "$@"
}

trap cleanup_lock EXIT
trap 'forward_signal HUP 129' HUP
trap 'forward_signal INT 130' INT
trap 'forward_signal QUIT 131' QUIT
trap 'forward_signal TERM 143' TERM

supervisor_timing_started_ms="$(date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s 2>/dev/null || printf '0')")"
set +e
start_lock_heartbeat
run_command "$@"
status=$?
set -e
if [ "${WIKI_HEAVY_TIMING_MODE:-}" = "supervisor_wall_clock_v1" ]; then
	supervisor_timing_finished_ms="$(date +%s%3N 2>/dev/null || printf '%s000' "$(date +%s 2>/dev/null || printf '0')")"
	case "$supervisor_timing_started_ms:$supervisor_timing_finished_ms" in
	*[!0-9:]*) supervisor_duration_ms=0 ;;
	*) supervisor_duration_ms=$((supervisor_timing_finished_ms - supervisor_timing_started_ms)) ;;
	esac
	if [ "$supervisor_duration_ms" -lt 1 ]; then
		supervisor_duration_ms=1
	fi
	echo "run-heavy-throttled: timing mode=supervisor_wall_clock_v1 duration_ms=$supervisor_duration_ms exit_code=$status lock_scope=$lock_scope" >&2
fi
# 124 = COMMAND_TIMEOUT do supervise-process-tree; 137 = SIGKILL do kill-after.
# Sem esta linha o operador vê só "timeout" e sobe WIKI_HEAVY_TIMEOUT_SECONDS —
# que NÃO tem efeito enquanto o budget for menor, gerando repetição do mesmo
# comando sem progresso.
case "$status" in
124 | 137)
	if [ -n "${budget_clamped_from_timeout_seconds:-}" ]; then
		echo "run-heavy-throttled: timeout efetivo=${command_timeout_seconds}s vindo de WIKI_HEAVY_BUDGET_MS=${budget_timeout_candidate}; o WIKI_HEAVY_TIMEOUT_SECONDS=${budget_clamped_from_timeout_seconds} declarado NAO estava em vigor (vence o menor dos dois). Para dar mais tempo a este comando AUMENTE WIKI_HEAVY_BUDGET_MS — subir so WIKI_HEAVY_TIMEOUT_SECONDS nao muda nada." >&2
	fi
	;;
esac
cleanup_lock
trap - EXIT HUP INT QUIT TERM
exit "$status"
