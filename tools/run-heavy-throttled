	fi
	if [ "$has_throughput_expected" != "1" ]; then
		missing="${missing} throughput_expected(WIKI_HEAVY_THROUGHPUT_EXPECTED numeric)"
	fi
	if [ -n "$missing" ]; then
		echo "run-heavy-throttled: heavy project 10k command requires cached runner, real child --timings capability or supervisor wall-clock timing, explicit numeric throughput_expected via WIKI_HEAVY_THROUGHPUT_EXPECTED, budget_ms/expected_duration_ms and stop_condition before lock/run; missing:$missing command=$*" >&2
