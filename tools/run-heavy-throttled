inline_token() {
	printf '%s' "$1" | tr '\n' ' ' | sed 's/[[:space:]][[:space:]]*/_/g'
}

sha256_token() {
	case "$1" in
	sha256:????????????????????????????????????????????????????????????????)
		printf '%s' "$1"
		return 0
		;;
	esac
	printf '%s' "$1" | sha256sum | awk '{print "sha256:" $1}'
}

repo_metric_for() {
	tmp="$(mktemp "${TMPDIR:-/tmp}/wiki-repo-awareness.XXXXXX" 2>/dev/null || printf '')"
	if [ -z "$tmp" ]; then
		printf 'unavailable'
		return 0
	fi
	if command -v timeout >/dev/null 2>&1; then
		if timeout "$repo_awareness_timeout" "$@" >"$tmp" 2>/dev/null; then
			metric="$(cksum "$tmp" 2>/dev/null | awk '{print "cksum:" $1 ":bytes:" $2}')"
		else
			if [ "$repo_awareness_timeout_explicit" = "1" ]; then
				metric=unavailable
			else
				metric="$(
					printf 'timed_out:%s\n' "$*" |
						cksum 2>/dev/null | awk '{print "timed_out:cksum:" $1 ":bytes:" $2}'
				)"
			fi
		fi
	else
		if "$@" >"$tmp" 2>/dev/null; then
			metric="$(cksum "$tmp" 2>/dev/null | awk '{print "cksum:" $1 ":bytes:" $2}')"
		else
			metric=unavailable
		fi
	fi
	rm -f "$tmp"
	if [ -z "$metric" ]; then
		metric=unavailable
	fi
	printf '%s' "$metric"
}

