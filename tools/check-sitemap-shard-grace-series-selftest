#!/usr/bin/env python3
"""check-sitemap-shard-grace-series-selftest — prova que a serie de carencia
ANEXA sem duplicar e sem jamais tocar os eventos de remocao.

Read-only sobre o repositorio: o ledger de teste nasce em tempfile e some no
fim. O gerador e IMPORTADO e o `main()` REAL e executado — reimplementar a
gravacao aqui provaria a copia, nao o gerador.

O QUE NAO PODE QUEBRAR, e o que cada propriedade reprova:

  A. A PRIMEIRA MEDICAO REAL ANEXA, mesmo com a linha de abertura ja no ledger.
     A abertura de 2026-08-28 e PROSA: os numeros dela vivem dentro do campo
     `motivo` e nenhum campo de estado existe na linha. Um comparador ingenuo
     leria "campo ausente == campo ausente" nos dois lados, concluiria "nada
     mudou" e suprimiria justamente a medicao que corrige o ledger. Reprova o
     gerador que compara campos sem verificar se eles existem.

  B. ESTADO IGUAL NO MESMO DIA NAO DUPLICA.
     `crawl_coverage_daily.jsonl` acumulou 21 linhas para uma unica chave
     (data, crawler) por nao ter essa disciplina, e o detector de estagnacao que
     lia "as ultimas N linhas" passou a ler o replay de um run so. Reprova o
     gerador append-cego.

  C. ESTADO DIFERENTE NO MESMO DIA ANEXA.
     Um shard que entra em carencia as 18h depois da medicao das 10h e um fato
     novo, nao uma duplicata. Reprova a idempotencia por data pura, que
     apagaria a metade do dia em que o estado muda — e e exatamente a mudanca
     que a serie existe para registrar.

  D. EVENTO `removido` SOBREVIVE BYTE A BYTE.
     `tools/deploy-publico:830` monta a purga de borda a partir desses nomes
     (`--listar-removidos`). Nome perdido = shard 200 quente na borda por ate
     sete dias contra uma origem que responde 410. Reprova qualquer gerador que
     reescreva o arquivo em vez de anexar.

  E. A GUARDA NAO OLHA SO A ULTIMA LINHA.
     Os eventos `removido` da publicacao se intercalam com os inventarios. Quem
     comparasse contra a ultima linha do arquivo compararia com um `removido`,
     que nao tem campo de estado nenhum, e anexaria sempre. Reprova a leitura de
     cauda.

Uso:
    tools/check-sitemap-shard-grace-series-selftest
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import io
import json
import os
import pathlib
import sys
import tempfile
from contextlib import redirect_stdout

RAIZ = pathlib.Path(__file__).resolve().parent.parent
GERADOR = RAIZ / "tools" / "generate-sitemap-shard-grace-series"

# A linha real que abriu o ledger em 2026-08-28, reduzida ao que importa para a
# propriedade A: evento=inventario, numeros so na prosa, nenhum campo de estado.
ABERTURA_EM_PROSA = {
    "schema_version": "sitemap_shard_grace_v1",
    "evento": "inventario",
    "motivo": "abertura_do_ledger: 35 shards em public/sitemaps/, 35 no indice, 0 fora do indice",
    "shard": "",
    "em": "2026-08-28T20:39:02Z",
}

REMOCAO = {
    "schema_version": "sitemap_shard_grace_v1",
    "evento": "removido",
    "motivo": "carencia_vencida",
    "shard": "/sitemaps/pages-0099.xml",
    "em": "2026-08-29T01:02:03Z",
}


def carrega_gerador():
    loader = importlib.machinery.SourceFileLoader("grace_series", str(GERADOR))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    modulo = importlib.util.module_from_spec(spec)
    loader.exec_module(modulo)
    return modulo


def medicao(disco: int, indice: int, carencia: list[str], divergentes: int) -> dict:
    return {
        "ativos": indice,
        "em_carencia": carencia,
        "vencidos": [],
        "locs_ativas": 10341,
        "shards_em_disco": disco,
        "shards_no_indice": indice,
        "locs_em_carencia": 8436,
        "locs_carencia_divergentes": divergentes,
        "locs_carencia_orfas": 0,
        "falhas": [],
        "avisos": [],
    }


def roda(modulo, ledger: pathlib.Path, med: dict, argv: list[str]) -> str:
    """Executa o main() REAL do gerador contra um ledger de teste."""
    modulo.LEDGER = ledger
    modulo.mede = lambda: med
    anterior = sys.argv
    sys.argv = ["generate-sitemap-shard-grace-series", *argv]
    buffer = io.StringIO()
    try:
        with redirect_stdout(buffer):
            codigo = modulo.main()
    finally:
        sys.argv = anterior
    if codigo != 0:
        raise AssertionError(f"o gerador saiu {codigo}: {buffer.getvalue()}")
    return buffer.getvalue()


def linhas(ledger: pathlib.Path) -> list[dict]:
    if not ledger.is_file():
        return []
    return [json.loads(l) for l in ledger.read_text(encoding="utf-8").splitlines() if l.strip()]


def main() -> int:
    modulo = carrega_gerador()
    falhas: list[str] = []

    with tempfile.TemporaryDirectory() as tmp:
        ledger = pathlib.Path(tmp) / "sitemap_shard_grace.jsonl"
        abertura = json.dumps(ABERTURA_EM_PROSA, ensure_ascii=False)
        remocao = json.dumps(REMOCAO, ensure_ascii=False)
        ledger.write_text(abertura + "\n" + remocao + "\n", encoding="utf-8")
        bytes_originais = ledger.read_bytes()

        estado_a = medicao(62, 34, [f"pages-{n:04d}.xml" for n in range(33, 61)], 8387)

        # A. a primeira medicao real anexa apesar da abertura em prosa
        roda(modulo, ledger, estado_a, [])
        depois = linhas(ledger)
        if len(depois) != 3:
            falhas.append(f"A: esperava 3 linhas apos a primeira medicao, tenho {len(depois)}")
        elif depois[-1].get("shards_em_disco") != 62 or depois[-1].get("locs_carencia_divergentes") != 8387:
            falhas.append(f"A: a linha anexada nao carrega o estado medido: {depois[-1]}")

        # A2. a guarda da prosa, isolada: com a abertura carimbada com a data de
        # HOJE, a checagem de data nao salva mais ninguem e o unico que impede a
        # supressao e o teste de "nenhum campo de estado existe do outro lado".
        prosa_de_hoje = dict(ABERTURA_EM_PROSA, data=depois[-1]["data"])
        if not modulo.mudou(depois[-1], prosa_de_hoje):
            falhas.append("A2: a guarda leu 'campo ausente == campo ausente' como estado inalterado "
                          "e suprimiria a primeira medicao de verdade")

        # B. mesmo estado, mesmo dia: nao duplica
        saida = roda(modulo, ledger, estado_a, [])
        if len(linhas(ledger)) != 3:
            falhas.append(f"B: estado inalterado duplicou a linha ({len(linhas(ledger))} linhas)")
        if "inalterado" not in saida:
            falhas.append(f"B: o gerador nao anunciou que o estado esta inalterado: {saida!r}")

        # C. estado diferente no mesmo dia: anexa
        estado_c = medicao(34, 34, [], 0)
        roda(modulo, ledger, estado_c, [])
        depois = linhas(ledger)
        if len(depois) != 4:
            falhas.append(f"C: estado novo nao foi registrado ({len(depois)} linhas)")
        elif depois[-1].get("shards_em_carencia") != 0 or depois[-1].get("locs_carencia_divergentes") != 0:
            falhas.append(f"C: a linha nova nao reflete o estado curado: {depois[-1]}")

        # D. o evento de remocao sobreviveu byte a byte, no lugar original
        atual = ledger.read_bytes()
        if not atual.startswith(bytes_originais):
            falhas.append("D: o gerador reescreveu o inicio do ledger; eventos 'removido' correm risco de perda")
        if remocao.encode("utf-8") not in atual:
            falhas.append("D: o evento 'removido' sumiu do ledger — a purga de borda perderia o nome")

        # E. a guarda ignora o 'removido' que vier DEPOIS do ultimo inventario:
        # ela tem de comparar com a linha 4 (estado_c, identica) e NAO anexar.
        with open(ledger, "a", encoding="utf-8") as saida_arquivo:
            saida_arquivo.write(remocao + "\n")
        roda(modulo, ledger, estado_c, [])
        if len(linhas(ledger)) != 5:
            falhas.append(
                f"E: a guarda comparou contra o evento 'removido' e anexou a toa ({len(linhas(ledger))} linhas, quero 5)")

        # --forcar anexa mesmo sem mudanca
        roda(modulo, ledger, estado_c, ["--forcar"])
        if len(linhas(ledger)) != 6:
            falhas.append(f"--forcar nao anexou ({len(linhas(ledger))} linhas, quero 6)")

        # --dry-run nao escreve
        antes = ledger.read_bytes()
        roda(modulo, ledger, medicao(99, 1, ["pages-0001.xml"], 12), ["--dry-run"])
        if ledger.read_bytes() != antes:
            falhas.append("--dry-run escreveu no ledger")

    if falhas:
        print("check-sitemap-shard-grace-series-selftest: FAIL")
        for f in falhas:
            print(f"  - {f}")
        return 1
    print("check-sitemap-shard-grace-series-selftest: pass (7 propriedades)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
