#!/usr/bin/env python3
"""generate-v2-link-topics-piso-de-entrada-20260829 — dá ENTRADA de malha às quatro páginas que o pipeline deixaria abaixo do piso.

O DEFEITO, e por que ele só apareceu agora. `tools/check-internal-link-floor`
cobra um piso de 3 links de ENTRADA por página indexável. Medido sobre o
`-mesh-report` do ensaio completo de `cmd/publish-v2-direct` — isto é, sobre o
grafo que a PRÓXIMA publicação vai produzir, não sobre o disco de hoje — quatro
páginas ficariam com 2 entradas:

    /jurisprudencia/stf-adi-7868/   (iniciativa privativa do Executivo em orçamento)
    /jurisprudencia/stf-adi-7888/   (competência da União para telecomunicações)
    /jurisprudencia/stf-adi-7922/   (teto de gastos e o Novo Arcabouço Fiscal)
    /jurisprudencia/stf-are-1477280/ (lei municipal sem dotação orçamentária)

Publicar assim levaria o gate de uma reprovação para quatro. Elas são a mesma
família das 29 que ganharam ponte de SAÍDA em
generate-v2-link-topics-ponte-cross-area-20260829, vistas pelo outro lado: o
título é rótulo de processo, então ninguém as encontra por vocabulário e ninguém
aponta para elas.

A DIREÇÃO AQUI É INVERTIDA, e é o que separa este gerador do irmão. Lá o tópico
ia na página SEM ponte e nomeava o vizinho. Aqui ele vai na página FONTE e nomeia
a ÓRFÃ — é a forma (a) de generate-v2-link-topics-enrich-20260812, e é a única
que produz entrada: declarar tópico numa página cria link de SAÍDA dela.

E O DESTINO É DA MESMA ÁREA, de propósito. O gerador irmão recusa destino
same-area porque o que ele constrói é PONTE. Este constrói ENTRADA, e entrada não
tem lado: o que o piso cobra é que alguém aponte para a página. Procurei fonte
cross-área genuína no índice das 10.116 publicadas — antena, ERB, radiação,
plano de carreira do magistério, teto de gastos, dotação orçamentária — e o
acervo, que é de direito do consumidor e do trabalho, não tem nenhuma. Inventar
uma seria o link manipulativo que a malha existe para não produzir.

A relação que EXISTE é entre as próprias decisões, e é forte: as quatro tratam de
competência privativa da União ou de disciplina constitucional do orçamento, e as
fontes escolhidas decidem exatamente as mesmas questões. Cada par carrega o
recorte verbatim da tese da FONTE que o sustenta, conferido contra o texto vivo.

CONTRATO DE ESCRITA: o de tools/v2_link_topics_writer, idêntico ao do irmão —
lease de época do estoque canônico, lock próprio, CAS pelo sha256 da linha viva,
demais chaves byte a byte, escrita atômica, idempotente, estado anterior
preservado antes da escrita. NÃO commita e NÃO republica.

Uso:
    tools/generate-v2-link-topics-piso-de-entrada-20260829 --dry-run
    tools/generate-v2-link-topics-piso-de-entrada-20260829
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease  # noqa: E402
from tools.v2_link_topics_writer import (  # noqa: E402
    Destinos,
    aplicar,
    escrever_evidencia,
    exclusive_lock,
    indexar_acervo,
    preflight,
)

DADOS = Path(__file__).with_suffix(".data.json")
DESTINOS = Destinos(
    root=ROOT,
    lock=ROOT / "data/editorial/.link-topics-piso-de-entrada-20260829.lock",
    pages=ROOT / "data/editorial/v2_pages",
    backup=ROOT / ".agents/runtime/backup-link-topics-piso-20260829",
    evidencia=ROOT / "data/editorial/v2_link_topics_piso_de_entrada_evidence_20260829.jsonl",
    gerador=Path(__file__).name,
)


def carregar_dados() -> list[dict]:
    if not DADOS.is_file():
        raise SystemExit(f"arquivo de dados ausente: {DADOS.name}")
    dados = json.loads(DADOS.read_text(encoding="utf-8"))
    topicos = dados.get("topicos")
    if not isinstance(topicos, list) or not topicos:
        raise SystemExit(f"{DADOS.name}: 'topicos' vazio ou ausente")
    return topicos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    topicos = carregar_dados()
    onde, registros = indexar_acervo(DESTINOS)
    por_shard = preflight(topicos, onde, registros)

    total_alterados = 0
    total_ja = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(DESTINOS.lock):
                for shard in sorted(por_shard):
                    print(f"\n{shard}")
                    alterados, ja = aplicar(
                        DESTINOS, shard, por_shard[shard], args.dry_run)
                    total_alterados += alterados
                    total_ja += ja
                if not args.dry_run:
                    escrever_evidencia(DESTINOS, topicos, onde)
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if args.dry_run:
        print(f"\n--dry-run: {total_alterados} página(s) alterável(is), "
              f"{total_ja} tópico(s) já presente(s). Nada escrito.")
        return 0
    print(f"\n{total_alterados} página(s) fonte com entrada declarada, "
          f"{total_ja} tópico(s) já estava(m) presente(s).")
    if total_alterados:
        print("Remedir com: ./tools/go-modern run ./cmd/publish-v2-direct "
              "-mesh-report /tmp/mesh.json  e conferir as entradas das quatro órfãs")
    return 0


if __name__ == "__main__":
    sys.exit(main())
