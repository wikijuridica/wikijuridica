#!/usr/bin/env python3
"""generate-v2-correcao-lei8213-art27a-20260829 — corrige a citação de um artigo
que NÃO EXISTE na Lei 8.213/1991.

★ O DEFEITO (BUG-116 da caça aos bugs, 2026-08-29)

Duas páginas do glossário fundamentam a perda da qualidade de segurado no
"art. 24-A da Lei 8.213/1991". Esse dispositivo não existe.

Prova, no corpus legal do próprio repositório (data/legal-corpus/lei_8213_1991.json,
177 artigos):

    chaves que começam por "24": ['24']          -> não há 24-A
    chaves que começam por "27": ['27', '27-A']  -> o 27-A existe

E o texto do art. 27-A é exatamente o que as páginas descrevem:
"Na hipótese de perda da qualidade de segurado, para fins da concessão dos
benefícios de auxílio-doença, de aposentadoria por invalidez, de salário-
maternidade..."

Citação legal mal atribuída é a classe que o contrato deste projeto chama de
P1 PERMANENTE: nenhuma medição automática a detecta e é a única com risco real
sob a OAB. Aqui ela estava servida ao público em duas rotas indexáveis.

★ POR QUE UM GERADOR DATADO, E NÃO uma edição do JSONL

O contrato é explícito: página reprovada se conserta por gerador datado, com
lease e CAS, nunca editando o shard à mão. A razão é concorrência — outra frente
pode estar gravando o mesmo shard, e uma edição manual sobrescreveria o trabalho
dela sem aviso. O CAS abaixo compara o sha256 do arquivo lido com o do arquivo
no instante da gravação: se alguém mexeu no meio, o gerador aborta em vez de
vencer a corrida.

Uso:
    tools/generate-v2-correcao-lei8213-art27a-20260829 --seco   # mostra sem gravar
    tools/generate-v2-correcao-lei8213-art27a-20260829
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import sys
import tempfile

RAIZ = pathlib.Path(__file__).resolve().parent.parent
SHARD = RAIZ / "data" / "editorial" / "v2_pages" / "glossario-10.jsonl"
CORPUS = RAIZ / "data" / "legal-corpus" / "lei_8213_1991.json"

ERRADO = "art. 24-A"
CERTO = "art. 27-A"
INTENTS = {"gloss-carencia", "gloss-qualidade-de-segurado"}


def sha256(caminho: pathlib.Path) -> str:
    return hashlib.sha256(caminho.read_bytes()).hexdigest()


def confere_corpus() -> None:
    """Recusa correr se a premissa não se sustentar no corpus."""
    try:
        artigos = json.loads(CORPUS.read_text(encoding="utf-8")).get("articles", {})
    except OSError as erro:
        raise SystemExit(f"corpus legal ilegível em {CORPUS}: {erro}")
    if "24-A" in artigos:
        raise SystemExit(
            "ABORTADO: o corpus agora TEM o art. 24-A da Lei 8.213 — a premissa "
            "desta correção caiu. Reveja antes de aplicar."
        )
    if "27-A" not in artigos:
        raise SystemExit(
            "ABORTADO: o corpus não tem o art. 27-A — sem o dispositivo correto "
            "confirmado, trocar seria substituir um erro por outro."
        )


def corrige_valor(valor: str) -> tuple[str, int]:
    if ERRADO not in valor:
        return valor, 0
    return valor.replace(ERRADO, CERTO), valor.count(ERRADO)


def corrige_registro(registro: dict) -> int:
    trocas = 0
    for campo, valor in registro.items():
        if isinstance(valor, str):
            novo, n = corrige_valor(valor)
            if n:
                registro[campo] = novo
                trocas += n
        elif isinstance(valor, list):
            for item in valor:
                if not isinstance(item, dict):
                    continue
                for chave, texto in item.items():
                    if not isinstance(texto, str):
                        continue
                    novo, n = corrige_valor(texto)
                    if n:
                        item[chave] = novo
                        trocas += n
    return trocas


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--seco", action="store_true", help="relata sem gravar")
    args = ap.parse_args()

    confere_corpus()

    if not SHARD.exists():
        raise SystemExit(f"shard ausente: {SHARD}")

    # LEASE por CAS: guarda a impressão do arquivo lido.
    sha_lido = sha256(SHARD)
    linhas = SHARD.read_text(encoding="utf-8").splitlines()

    saida: list[str] = []
    total = 0
    tocados: list[str] = []
    for linha in linhas:
        if not linha.strip():
            saida.append(linha)
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") in INTENTS:
            trocas = corrige_registro(registro)
            if trocas:
                total += trocas
                tocados.append(f"{registro['intent_id']} ({trocas})")
            saida.append(json.dumps(registro, ensure_ascii=False))
            continue
        saida.append(linha)

    print(f"correção art. 24-A -> art. 27-A (Lei 8.213/1991)")
    print(f"  shard        : {SHARD.relative_to(RAIZ)}")
    print(f"  ocorrências  : {total}")
    print(f"  páginas      : {', '.join(tocados) if tocados else '(nenhuma)'}")

    if total == 0:
        print("  nada a fazer — a citação já está correta")
        return 0
    if args.seco:
        print("  --seco: nada gravado")
        return 0

    # CAS: se o arquivo mudou desde a leitura, outra frente gravou. Abortar.
    if sha256(SHARD) != sha_lido:
        print(
            "ABORTADO: o shard mudou entre a leitura e a gravação — outra frente "
            "está escrevendo. Rode de novo.",
            file=sys.stderr,
        )
        return 2

    conteudo = "\n".join(saida) + "\n"
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=str(SHARD.parent), prefix=".art27a_", delete=False
    ) as tmp:
        tmp.write(conteudo)
        temporario = pathlib.Path(tmp.name)
    os.replace(temporario, SHARD)  # rename é atômico no mesmo filesystem
    print(f"  gravado (atômico) — sha {sha_lido[:12]} -> {sha256(SHARD)[:12]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
