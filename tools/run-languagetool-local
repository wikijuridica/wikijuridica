#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
VERSION="${WIKI_LANGUAGETOOL_VERSION:-6.8}"
PORT="${WIKI_LANGUAGETOOL_PORT:-8082}"
CACHE_DIR="$ROOT/.cache/languagetool/$VERSION"
MAIN_JAR="${WIKI_LANGUAGETOOL_JAR:-$CACHE_DIR/languagetool-server-$VERSION.jar}"
CLASSPATH_FILE="${WIKI_LANGUAGETOOL_CLASSPATH:-$CACHE_DIR/classpath.txt}"
JAVA="${WIKI_JAVA_BIN:-java}"

if [[ ! -f "$MAIN_JAR" || ! -f "$CLASSPATH_FILE" ]]; then
	echo "run-languagetool-local: missing local LanguageTool $VERSION artifacts; run ./tools/install-languagetool first" >&2
	exit 1
fi

exec "$JAVA" -cp "$MAIN_JAR:$(cat "$CLASSPATH_FILE")" org.languagetool.server.HTTPServer --port "$PORT"
