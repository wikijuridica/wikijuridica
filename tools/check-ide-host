# ── glob do files.watcherExclude ──────────────────────────────────────────
def _fecha_chave(p, i):
    nivel = 0
    for j in range(i, len(p)):
        if p[j] == "{":
            nivel += 1
        elif p[j] == "}":
            nivel -= 1
            if nivel == 0:
                return j
    return -1


def _divide_no_nivel(s):
    partes, nivel, atual = [], 0, []
    for c in s:
        if c == "," and nivel == 0:
            partes.append("".join(atual))
            atual = []
            continue
        if c == "{":
            nivel += 1
        elif c == "}":
            nivel -= 1
        atual.append(c)
    partes.append("".join(atual))
    return partes


def _glob_corpo(p):
    out = []
    i, n = 0, len(p)
    if p.startswith("**/"):
        out.append("(?:.*/)?")
        i = 3
    while i < n:
        if p.startswith("/**/", i):
            out.append("/(?:.*/)?")
            i += 4
        elif p.startswith("/**", i) and i + 3 == n:
            out.append("(?:/.*)?")
            i += 3
        elif p.startswith("**", i):
            out.append(".*")
            i += 2
        elif p[i] == "*":
            out.append("[^/]*")
            i += 1
        elif p[i] == "?":
            out.append("[^/]")
            i += 1
        elif p[i] == "{" and _fecha_chave(p, i) > 0:
            fim = _fecha_chave(p, i)
            out.append("(?:" + "|".join(_glob_corpo(a) for a in _divide_no_nivel(p[i + 1:fim])) + ")")
            i = fim + 1
        elif p[i] == "[" and p.find("]", i + 1) > 0:
            fim = p.find("]", i + 1)
            classe = p[i + 1:fim]
            if classe.startswith("!"):
                classe = "^" + classe[1:]
            out.append("[" + classe.replace("\\", "\\\\") + "]")
            i = fim + 1
        else:
            out.append(re.escape(p[i]))
            i += 1
    return "".join(out)


def glob_para_regex(padrao):
    return re.compile("^" + _glob_corpo(padrao) + "$")


def regexes_do_escopo(settings):
    """[(regex, absoluto)] dos padroes ligados no escopo, mais os defaults."""
    efetivo = {p: True for p in DEFAULTS_WATCHER_EXCLUDE}
    bloco = (settings or {}).get("files.watcherExclude")
    if isinstance(bloco, dict):
        efetivo.update(bloco)
    return [(glob_para_regex(p), p.startswith("/")) for p, ligado in efetivo.items() if ligado is True]


def casa(regexes, relativo, absoluto):
    return any(rx.match(absoluto if eh_abs else relativo) for rx, eh_abs in regexes)


def conta_subdiretorios(inicio, podar, teto):
    """Subdiretorios de `inicio` (sem ele), sem seguir symlink, sem descer no que
    `podar(caminho)` exclui; para no primeiro acima de `teto`."""
    n = 0
    pilha = [inicio]
    while pilha:
        d = pilha.pop()
        try:
            it = os.scandir(d)
        except OSError:
            continue
        with it:
            for e in it:
                try:
                    if not e.is_dir(follow_symlinks=False):
                        continue
                except OSError:
                    continue
                if podar(e.path):
                    continue
                n += 1
                if n > teto:
                    return n
                pilha.append(e.path)
    return n


def verifica_f20(r, raiz, limiar, escopos):
    """escopos: [(nome, settings ou None, caminho)]."""
    t0 = time.monotonic()
    raiz_txt = str(raiz)
    pesadas = []
    try:
        entradas = sorted(os.scandir(raiz_txt), key=lambda e: e.name)
    except OSError as erro:
        r.falha(f"F20: nao consegui listar {raiz}: {erro}")
        return
    for e in entradas:
        if e.name in RAIZES_ISENTAS_F20:
            continue
        try:
            if not e.is_dir(follow_symlinks=False):
                continue
        except OSError:
            continue
        if conta_subdiretorios(e.path, lambda _p: False, limiar) > limiar:
            pesadas.append(e)
    nomes = ", ".join(e.name for e in pesadas) or "nenhuma"
    r.medidas["f20_raizes_pesadas"] = [e.name for e in pesadas]
    r.ok(f"F20: {len(pesadas)} raiz(es) de 1o nivel acima de {limiar} subdiretorios: {nomes} (medido em {time.monotonic() - t0:.2f} s)")
    prefixo = len(raiz_txt) + 1
    for nome_escopo, settings, caminho in escopos:
        if settings is None:
            r.falha(f"F20: {nome_escopo} ilegivel ou ausente ({caminho}) — as raizes pesadas ({nomes}) ficam vigiadas nesse escopo")
            continue
        regs = regexes_do_escopo(settings)
        faltam = []
        for e in pesadas:
            if casa(regs, e.name, e.path):
                continue

            def podar(caminho, regs=regs):
                return casa(regs, caminho[prefixo:], caminho)

            n = conta_subdiretorios(e.path, podar, limiar)
            if n > limiar:
                faltam.append(e.name)
        if faltam:
            r.falha(f"F20: fora do files.watcherExclude do {nome_escopo} ({caminho}): {', '.join(faltam)} — cada uma com mais de {limiar} subdiretorios vigiados")
        else:
            r.ok(f"F20: o {nome_escopo} cobre todas as raizes pesadas")


