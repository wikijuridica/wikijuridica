def watches_do_uid(proc, uid):
    total = 0
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return None
    for pid in pids:
        base = os.path.join(proc, pid)
        try:
            if os.stat(base).st_uid != uid:
                continue
            fds = os.listdir(os.path.join(base, "fd"))
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(os.path.join(base, "fd", fd)) != "anon_inode:inotify":
                    continue
                with open(os.path.join(base, "fdinfo", fd), encoding="utf-8", errors="replace") as f:
                    total += sum(1 for linha in f if linha.startswith("inotify wd:"))
            except OSError:
                continue
    return total


def arquivos_citando(pasta, agulha):
    achados, ilegiveis = [], 0
    for dirpath, _dirs, arquivos in os.walk(pasta):
        for nome in arquivos:
            caminho = os.path.join(dirpath, nome)
            try:
                with open(caminho, "rb") as f:
                    if agulha in f.read():
                        achados.append(caminho)
            except OSError:
                ilegiveis += 1
    return sorted(achados), ilegiveis


def le_toolchain(gomod):
    try:
        for linha in Path(gomod).read_text(encoding="utf-8").splitlines():
            m = re.match(r"^toolchain\s+(go\S+)", linha.strip())
            if m:
                return m.group(1)
    except OSError:
        return None
    return None


def ambiente_go_sem_telemetria(home, temporario):
    """O go (>= 1.23) e o gopls gravam contadores de telemetria em
    $XDG_CONFIG_HOME/go/telemetry mesmo no modo `local` — medido em 2026-09-23: um
    `go version -m` num home vazio deixa tres arquivos em
    ~/.config/go/telemetry/local/. Este check so le; entao a config do go vai para
    um temporario, e o GOENV continua apontando para o arquivo real do dono, para
    nao perder um `go env -w` dele."""
    config_real = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    return {"XDG_CONFIG_HOME": temporario, "GOENV": os.path.join(config_real, "go", "env")}


def campos_do_marcador(marcador):
    """As linhas chave=valor do ~/.config/VSCodium/.kit-ide, que o kit grava."""
    campos = {}
    try:
        for linha in Path(marcador).read_text(encoding="utf-8").splitlines():
            if "=" in linha:
                chave, valor = linha.split("=", 1)
                campos[chave.strip()] = valor.strip()
    except OSError:
        pass
    return campos


def pino_do_gopls(raiz):
    """(versao, origem). Uma fonte so, a do instalador: a constante
    GOPLS_VERSAO=vX do ops/ide/instalar-ide.sh (decisao do orquestrador,
    2026-09-23: o pino vive la e em nenhum outro arquivo); sem ela, o literal
    UNICO golang.org/x/tools/gopls@vX do mesmo script. Duas versoes diferentes
    sao ambiguidade, e ambiguidade devolve None (o chamador avisa)."""
    instalador = Path(raiz) / "ops/ide/instalar-ide.sh"
    try:
        texto = instalador.read_text(encoding="utf-8")
    except OSError:
        return None, str(instalador)
    constantes = set(re.findall(r"^\s*GOPLS_VERSAO=[\"']?(v\d+\.\d+\.\d+)", texto, re.M))
    if len(constantes) == 1:
        return constantes.pop(), f"GOPLS_VERSAO de {instalador}"
    literais = set(re.findall(r"golang\.org/x/tools/gopls@(v\d+\.\d+\.\d+)", texto))
    if not constantes and len(literais) == 1:
        return literais.pop(), str(instalador)
    return None, str(instalador)


def fingerprints_primarios(saida_colons):
    """So o fpr que segue uma linha pub: (os das subchaves nao contam)."""
    primarios, depois_de_pub = [], False
    for linha in saida_colons.splitlines():
        campos = linha.split(":")
        if campos[0] == "pub":
            depois_de_pub = True
        elif campos[0] == "fpr" and depois_de_pub and len(campos) > 9:
            primarios.append(campos[9])
            depois_de_pub = False
        elif campos[0] in ("sub", "uid"):
            depois_de_pub = False
    return primarios


def main(argv=None):
    ap = argparse.ArgumentParser(description="Invariantes do IDE (VSCodium) deste host.")
    ap.add_argument("--antes-da-remocao", action="store_true",
                    help="fase 6 do instalar-ide.sh: nao confere code ausente, fonte da Microsoft nem arquivo datado")
    ap.add_argument("--com-gpu", action="store_true",
                    help="exige ops/ide/extensoes-gpu.txt instalada (sem a flag, so confere o pino do que estiver instalado)")
    ap.add_argument("--json", action="store_true", help="so o resumo em JSON")
    ap.add_argument("--home", default=os.environ.get("HOME") or str(Path.home()))
    ap.add_argument("--raiz", default=str(Path(__file__).resolve().parent.parent))
    ap.add_argument("--etc-apt", default="/etc/apt")
    ap.add_argument("--keyring", default="/usr/share/keyrings/vscodium-archive-keyring.gpg")
    ap.add_argument("--proc", default="/proc")
    ap.add_argument("--go", default=None, help="binario go do toolchain (padrao: .toolchains/<toolchain do go.mod>/bin/go)")
    ap.add_argument("--gopls", default=None, help="padrao: <raiz>/.toolchains/bin/gopls")
    ap.add_argument("--limiar-f20", type=int, default=LIMIAR_F20)
    ap.add_argument("--sem-gopls-funcional", action="store_true",
                    help="nao roda o `gopls check` (a parte estatica do gopls continua)")
    ap.add_argument("--prazo-gopls", type=int, default=180, help="segundos do `gopls check`")
    a = ap.parse_args(argv)

    r = Relatorio(silencioso=a.json)
    home, raiz = Path(a.home), Path(a.raiz)
    marcador = home / ".config/VSCodium/.kit-ide"
    status_codium = status_pacote("codium")
    tem_codium = pacote_instalado(status_codium)

    if not tem_codium and not marcador.exists():
        motivo = ("pulada: codium nao instalado e sem o marcador ~/.config/VSCodium/.kit-ide — "
                  "o kit do IDE ainda nao rodou neste host (estado, nao defeito)")
        if a.json:
            print(json.dumps({"veredito": "pulada", "motivo": motivo}, ensure_ascii=False))
        else:
            print(motivo)
        return 75

    r.secao("instalacao")
    if not tem_codium:
        r.falha(f"marcador do kit presente ({marcador}) e codium NAO instalado (dpkg: {status_codium or 'sem registro'}) — o kit registrou uma instalacao que nao existe mais")
    else:
        r.medidas["codium"] = versao_pacote("codium")
        r.ok(f"codium instalado: {r.medidas['codium']}")
        if not marcador.exists():
            r.aviso(f"codium instalado sem o marcador {marcador} — instalado fora do kit, ou o kit nao terminou")

    r.secao("extensoes")
    instaladas, origem, pastas = extensoes_instaladas(home / ".vscode-oss/extensions")
    if instaladas is None:
        r.falha(origem)
        instaladas = {}
    else:
        r.ok(f"instaladas lidas de {origem}: {len(instaladas)}")
    pares = {f"{i}@{v}" for i, vs in instaladas.items() for v in vs}
    obrigatorias = le_lista(raiz / "ops/ide/extensoes.txt", OBRIGATORIAS_EMBUTIDAS, r, "ops/ide/extensoes.txt")
    lista_gpu = le_lista(raiz / "ops/ide/extensoes-gpu.txt", GPU_EMBUTIDAS, r, "ops/ide/extensoes-gpu.txt")
    if a.com_gpu:
        obrigatorias += lista_gpu
    else:
        # Sem --com-gpu o Continue NAO e exigido — o instalador nao o instala
        # (telemetria anonima ligada por padrao; a frente 5 a desliga antes da
        # primeira janela) —, mas, se estiver instalado, tem de estar no pino.
        for e in lista_gpu:
            ident, versao = e.split("@", 1)
            if ident not in instaladas:
                r.ok(f"{ident} nao instalada, e sem --com-gpu nao e exigida")
            elif instaladas[ident] == {versao}:
                r.ok(f"{ident} instalada no pino {versao}")
            else:
                r.falha(f"extensao {ident}: instalada {', '.join(sorted(instaladas[ident]))}, pino {versao} (ops/ide/extensoes-gpu.txt)")
    obrigatorias = [e for e in obrigatorias if e.split("@", 1)[0] != ID_CLAUDE_CODE]
    faltam = [e for e in obrigatorias if e not in pares]
    for e in faltam:
        ident, versao = e.split("@", 1)
        if ident in instaladas:
            r.falha(f"extensao {ident}: instalada {', '.join(sorted(instaladas[ident]))}, exigida {versao}")
        else:
            r.falha(f"extensao obrigatoria ausente: {e}")
    if obrigatorias and not faltam:
        r.ok(f"obrigatorias ⊆ instaladas ({len(obrigatorias)})")
    proibidas, origem_proibidas = le_proibidas(raiz / "ops/ide/extensoes-proibidas.txt")
    presentes = sorted(set(instaladas) & proibidas)
    for p in presentes:
        r.falha(f"extensao proibida instalada: {p} ({origem_proibidas})")
    if not presentes:
        r.ok(f"proibidas ∩ instaladas = ∅ ({len(proibidas)} proibidas, {origem_proibidas})")
    ids_obrig = {e.split("@", 1)[0] for e in obrigatorias} | {ID_CLAUDE_CODE}
    extras = sorted(set(instaladas) - ids_obrig - {e.split("@", 1)[0] for e in lista_gpu} - proibidas)
    if extras:
        r.ok(f"extras permitidas (gate de subconjunto): {', '.join(extras)}")
    if tem_codium:
        piso, origem_piso = piso_do_codium(pastas, ids_obrig | {e.split("@", 1)[0] for e in lista_gpu})
        if tupla_de_versao(r.medidas["codium"]) < piso:
            r.falha(f"codium {r.medidas['codium']} abaixo de {'.'.join(map(str, piso))} ({origem_piso})")
        else:
            r.ok(f"codium {r.medidas['codium']} >= {'.'.join(map(str, piso))} ({origem_piso})")

    r.secao("paridade extensao ⇄ CLI")
    link = home / ".local/bin/claude"
    if not os.path.lexists(link):
        r.falha(f"{link} ausente — sem a versao do CLI nao ha paridade")
    else:
        cli = os.path.basename(os.path.realpath(link))
        vers = sorted(instaladas.get(ID_CLAUDE_CODE, set()))
        r.medidas["claude_cli"] = cli
        if not vers:
            r.falha(f"{ID_CLAUDE_CODE} ausente (CLI {cli})")
        elif vers != [cli]:
            r.falha(f"paridade: extensao {ID_CLAUDE_CODE} {', '.join(vers)}, CLI {cli} (basename do readlink de {link})")
        else:
            r.ok(f"{ID_CLAUDE_CODE} {cli} == CLI {cli}")

    r.secao("remocao do VS Code")
    # `sudo instalar-ide.sh --sem-remover` deixa o VSCodium verificado e o VS Code
    # DE PE, de proposito: a E2E roda antes da remocao. Esse intervalo pode durar
    # dias na maquina nova, e a qualidade diaria roda este check SEM
    # --antes-da-remocao: sem o campo abaixo, ela ficaria vermelha toda noite por
    # um estado que o proprio kit declarou. Com `remocao_vscode=pendente` no
    # marcador, a secao so AVISA — e diz o comando que falta.
    remocao_pendente = campos_do_marcador(marcador).get("remocao_vscode") == "pendente"
    falha_remocao = r.aviso if remocao_pendente else r.falha
    if a.antes_da_remocao:
        r.ok("--antes-da-remocao: code, fonte da Microsoft e arquivo datado nao conferidos (a fase 7 ainda nao rodou)")
    else:
        if remocao_pendente:
            r.aviso("remocao do VS Code PENDENTE (o kit rodou com --sem-remover, marcador remocao_vscode=pendente): "
                    "feche o VS Code e rode sudo ops/ide/instalar-ide.sh --so-remover-vscode")
        st = status_pacote("code")
        if pacote_instalado(st):
            falha_remocao("pacote code (VS Code) ainda instalado")
        else:
            r.ok(f"pacote code fora do dpkg ({st or 'sem registro'})")
        onde = shutil.which("code")
        if onde:
            falha_remocao(f"binario code ainda no PATH: {onde}")
        citam, ilegiveis = arquivos_citando(a.etc_apt, b"packages.microsoft.com")
        if citam:
            falha_remocao(f"packages.microsoft.com ainda em {a.etc_apt}: {', '.join(citam)}")
        else:
            r.ok(f"nenhum arquivo em {a.etc_apt} cita packages.microsoft.com ({ilegiveis} ilegivel(is) sem permissao)")
        datados = sorted(home.glob(".local/share/archive-vscode-*"))
        bons = [d for d in datados if (d / "MANIFESTO.sha256").is_file() and (d / "MANIFESTO.sha256").stat().st_size > 0]
        if bons:
            r.ok(f"arquivo datado presente: {', '.join(d.name for d in bons)}")
        elif datados:
            falha_remocao(f"arquivo datado sem MANIFESTO.sha256 nao vazio: {', '.join(d.name for d in datados)}")
        else:
            falha_remocao(f"nenhum arquivo datado em {home / '.local/share'}/archive-vscode-*")

    r.secao("perfil")
    repo_perfil = raiz / "ops/ide/perfil/settings.json"
    disco_perfil = home / ".config/VSCodium/User/settings.json"
    perfil_repo, erro_repo = le_jsonc(repo_perfil)
    perfil_disco, erro_disco = (None, None)
    if disco_perfil.is_symlink():
        r.falha(f"{disco_perfil} e symlink ({os.readlink(disco_perfil)}): o perfil tem de ser copia gerida por merge — com link, o editor escreveria dentro do repositorio")
    else:
        perfil_disco, erro_disco = le_jsonc(disco_perfil)
        if perfil_disco is not None and not isinstance(perfil_disco, dict):
            perfil_disco, erro_disco = None, "o topo nao e objeto"
    if perfil_repo is None:
        r.falha(f"perfil do repositorio {repo_perfil}: {erro_repo}")
    elif perfil_disco is None and not disco_perfil.is_symlink():
        r.falha(f"perfil do disco {disco_perfil}: {erro_disco}")
    elif perfil_disco is not None:
        invariantes = [k for k in perfil_repo if k in PERFIL_INVARIANTES or k.startswith(PREFIXO_INVARIANTE)]
        for chave in PERFIL_INVARIANTES:
            if chave not in perfil_repo:
                r.falha(f"perfil do repositorio sem a invariante {chave!r} ({repo_perfil})")
        # search.exclude e files.exclude sao RELATIVOS a pasta do workspace: chave
        # absoluta ali nao exclui nada (medido pelo ide-workspace com o rg embutido,
        # 2026-09-23). So o files.watcherExclude aceita caminho absoluto. Mesma
        # regua do instalador (defeito do kit, rc 4 do subcomando invariantes).
        for bloco in ("search.exclude", "files.exclude"):
            valor = perfil_repo.get(bloco)
            for padrao in sorted(valor) if isinstance(valor, dict) else []:
                if padrao.startswith("/"):
                    r.falha(f"perfil do repositorio: {bloco} com chave absoluta {padrao!r} nao exclui nada (e relativo a pasta do workspace)")
        divergentes = 0
        for chave in invariantes:
            if chave not in perfil_disco:
                r.falha(f"perfil: chave {chave!r} ausente em {disco_perfil}")
                divergentes += 1
            elif not subconjunto(perfil_repo[chave], perfil_disco[chave]):
                r.falha(f"perfil: chave {chave!r} diverge — repo {curto(perfil_repo[chave])} · disco {curto(perfil_disco[chave])}")
                divergentes += 1
        for chave in PERFIL_AUSENTES:
            if chave in perfil_disco:
                r.falha(f"perfil: {chave} definido no disco ({curto(perfil_disco[chave])}) — tem de ficar ausente (plano §12.1)")
                divergentes += 1
        if not divergentes:
            r.ok(f"as {len(invariantes)} invariantes do perfil estao no disco com os valores do repositorio, e {', '.join(PERFIL_AUSENTES)} ausentes")
        preferencias = [k for k in perfil_repo if k not in invariantes
                        and (k not in perfil_disco or not subconjunto(perfil_repo[k], perfil_disco[k]))]
        if preferencias:
            r.aviso(f"preferencia do dono diverge do perfil do repositorio fora das invariantes: {', '.join(preferencias)} (o kit as repoe no proximo merge)")

    r.secao("apt")
    rc, out, _ = roda(["apt-mark", "showhold"])
    if rc is None:
        r.aviso("apt-mark ausente: hold do codium nao conferido")
    elif "codium" in out.split():
        r.ok("codium em hold")
    else:
        r.falha("codium sem hold (apt-mark hold codium) — a versao sobe so por decisao explicita")
    rc, out, _ = roda(["apt-cache", "policy", "codium"])
    instalado = re.search(r"^\s*Installed:\s*(\S+)", out, re.M)
    candidato = re.search(r"^\s*Candidate:\s*(\S+)", out, re.M)
    if rc is None or not instalado or not candidato:
        r.aviso("apt-cache policy codium sem Installed/Candidate legiveis")
    elif instalado.group(1) != candidato.group(1):
        r.aviso(f"codium: Installed {instalado.group(1)} != Candidate {candidato.group(1)} — versao nova no repositorio; atualizar e decisao explicita: apt-mark unhold -> install -> hold -> bancada")
    else:
        r.ok(f"codium: Installed == Candidate ({instalado.group(1)})")
    keyring = Path(a.keyring)
    if not keyring.exists():
        r.falha(f"keyring do VSCodium ausente: {keyring}")
    else:
        with tempfile.TemporaryDirectory(prefix="check-ide-host-gpg.") as gnupg:
            rc, out, err = roda(["gpg", "--homedir", gnupg, "--batch", "--show-keys", "--with-colons", str(keyring)])
        primarios = fingerprints_primarios(out) if rc == 0 else []
        if rc is None:
            r.aviso("gpg ausente: fingerprint do keyring nao conferido")
        elif primarios == [PINO_VSCODIUM]:
            r.ok(f"keyring com uma chave primaria, a pinada ({PINO_VSCODIUM})")
        else:
            r.falha(f"keyring {keyring}: chaves primarias {primarios or '(nenhuma legivel)'} — esperado so {PINO_VSCODIUM} {err.strip()[:120]}")

    r.secao("Claude Code")
    claude_settings = home / ".claude/settings.json"
    cfg, erro_cfg = le_jsonc(claude_settings)
    if not isinstance(cfg, dict):
        r.falha(f"{claude_settings}: {erro_cfg or 'o topo nao e objeto'}")
    else:
        env_cfg = cfg.get("env") if isinstance(cfg.get("env"), dict) else {}
        if env_cfg.get("CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL") == "1":
            r.ok("env.CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL = \"1\"")
        else:
            r.falha(f"{claude_settings}: env.CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL != \"1\" (veio {curto(env_cfg.get('CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL'))}) — sem ele o CLI instala a extensao por conta propria e quebra a paridade")
        plugins = cfg.get("pluginConfigs") if isinstance(cfg.get("pluginConfigs"), dict) else {}
        if "agents-md@builtin" in plugins:
            r.aviso("pluginConfigs.\"agents-md@builtin\" ainda presente em ~/.claude/settings.json (frente 4, item 1)")

    r.secao("F20 — raizes pesadas fora do watcher")
    workspace = raiz / ".vscode/settings.json"
    workspace_obj, _erro_ws = le_jsonc(workspace)
    verifica_f20(r, raiz, a.limiar_f20, [
        ("perfil do disco", perfil_disco if isinstance(perfil_disco, dict) else None, disco_perfil),
        ("workspace", workspace_obj if isinstance(workspace_obj, dict) else None, workspace),
    ])

    r.secao("medidas (nao sao gate)")
    try:
        teto = int(Path(a.proc, "sys/fs/inotify/max_user_watches").read_text().strip())
    except (OSError, ValueError):
        teto = None
    uso = watches_do_uid(a.proc, os.getuid())
    r.medidas["inotify_max_user_watches"] = teto
    r.medidas["inotify_watches_do_uid"] = uso
    if teto and uso is not None:
        r.ok(f"inotify: {uso} watches do uid {os.getuid()} em uso, teto {teto} ({100 * uso / teto:.1f}%)")
    else:
        r.ok(f"inotify: teto {teto}, uso {uso} (leitura parcial de {a.proc})")

    r.secao("gopls-do-toolchain")
    config_go = tempfile.mkdtemp(prefix="check-ide-host-go.")
    # Com o marcador do kit, gopls fora do lugar e FALHA; sem ele (codium posto
    # fora do kit), AVISO — decisao A1 do orquestrador, 2026-09-23.
    grave = r.falha if marcador.exists() else r.aviso
    toolchain = le_toolchain(raiz / "go.mod")
    gopls = Path(a.gopls) if a.gopls else raiz / ".toolchains/bin/gopls"
    go = a.go or (str(raiz / ".toolchains" / toolchain / "bin/go") if toolchain else shutil.which("go"))
    pino, origem_pino = pino_do_gopls(raiz)
    if pino is None:
        pino = GOPLS_EMBUTIDO
        r.aviso(f"sem GOPLS_VERSAO legivel em {origem_pino}: usando o pino embutido {pino}")
    estatico_ok = False
    if not gopls.exists():
        grave(f"gopls-do-toolchain: gopls ausente em {gopls} — o editor ficaria sem o gopls do toolchain do repositorio")
    elif not go or not os.path.exists(go):
        grave(f"gopls-do-toolchain: go do toolchain ausente ({go}): sem ele nao ha `go version -m` do gopls")
    else:
        rc, out, _ = roda([go, "version", "-m", str(gopls)],
                          env_extra={"GOTOOLCHAIN": "local", **ambiente_go_sem_telemetria(str(home), config_go)})
        compilador = re.match(r"^[^\n]*?:\s*(go\S+)", out)
        modulo = re.search(r"^\s*mod\s+golang\.org/x/tools/gopls\s+(\S+)", out, re.M)
        if rc != 0 or not compilador:
            grave(f"gopls-do-toolchain: go version -m {gopls} ilegivel (rc={rc})")
        else:
            erros = []
            if toolchain and compilador.group(1) != toolchain:
                erros.append(f"compilado com {compilador.group(1)}, esperado {toolchain} (go.mod)")
            if not modulo:
                erros.append("sem a linha `mod golang.org/x/tools/gopls`")
            elif modulo.group(1) != pino:
                erros.append(f"modulo golang.org/x/tools/gopls@{modulo.group(1)}, esperado @{pino} ({origem_pino})")
            if erros:
                grave(f"gopls-do-toolchain: {gopls}: " + "; ".join(erros))
            else:
                r.ok(f"gopls-do-toolchain: gopls {pino} compilado com {compilador.group(1)} ({origem_pino})")
                estatico_ok = True
    if estatico_ok and a.sem_gopls_funcional:
        r.ok("gopls check funcional pulado (--sem-gopls-funcional)")
    elif estatico_ok:
        t0 = time.monotonic()
        rc, out, err = roda([str(gopls), "check", "cmd/build/main.go"], timeout=a.prazo_gopls, cwd=str(raiz), gentil=True,
                            env_extra={"PATH": os.path.dirname(go) + os.pathsep + os.environ.get("PATH", ""),
                                       "GOFLAGS": "-tags=devcmds", "GOTOOLCHAIN": "local",
                                       **ambiente_go_sem_telemetria(str(home), config_go)})
        duracao = time.monotonic() - t0
        r.medidas["gopls_check_s"] = round(duracao, 1)
        saida = (out + err).strip()
        if ERRO_DE_TAG in saida:
            grave(f"gopls check cmd/build/main.go: \"{ERRO_DE_TAG}\" — o par gopls x toolchain x -tags=devcmds nao carrega o pacote")
        elif rc != 0:
            grave(f"gopls check cmd/build/main.go saiu {rc} em {duracao:.1f} s: {saida[-200:]}")
        else:
            r.ok(f"gopls check cmd/build/main.go: rc 0, sem \"{ERRO_DE_TAG}\" ({duracao:.1f} s)")

    shutil.rmtree(config_go, ignore_errors=True)
    veredito = "reprovado" if r.falhas else "verde"
    if a.json:
        print(json.dumps({"veredito": veredito, "falhas": r.falhas, "avisos": r.avisos, "medidas": r.medidas},
                         ensure_ascii=False, sort_keys=True))
    elif r.falhas:
        print(f"check-ide-host: REPROVADO — {len(r.falhas)} falha(s), {len(r.avisos)} aviso(s)")
    else:
        print(f"check-ide-host: VERDE — {len(r.oks)} verificacao(oes), {len(r.avisos)} aviso(s)")
    return 1 if r.falhas else 0


if __name__ == "__main__":
    sys.exit(main())
