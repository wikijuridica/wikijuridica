class Relatorio:
    def __init__(self, silencioso):
        self.silencioso = silencioso
        self.falhas, self.avisos, self.oks, self.medidas = [], [], [], {}

    def _diz(self, linha):
        if not self.silencioso:
            print(linha, flush=True)

    def ok(self, texto):
        self.oks.append(texto)
        self._diz(f"  ✓ {texto}")

    def aviso(self, texto):
        self.avisos.append(texto)
        self._diz(f"  ! AVISO  {texto}")

    def falha(self, texto):
        self.falhas.append(texto)
        self._diz(f"  ✗ FALHA  {texto}")

    def secao(self, titulo):
        self._diz(f"── {titulo}")


def roda(cmd, timeout=60, cwd=None, env_extra=None, gentil=False):
    """(rc, stdout, stderr); rc None quando o binario nao existe no PATH. LC_ALL=C
    porque `apt-cache policy` sai traduzido ("Instalado:") no locale do dono.
    gentil=True baixa a prioridade (nice 10) sem depender do binario `nice`."""
    env = dict(os.environ, LC_ALL="C", LANG="C", **(env_extra or {}))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env, cwd=cwd,
                           preexec_fn=(lambda: os.nice(10)) if gentil else None)
    except FileNotFoundError:
        return None, "", "ausente"
    except subprocess.TimeoutExpired:
        return 124, "", f"estourou {timeout}s"
    return p.returncode, p.stdout, p.stderr


def status_pacote(pacote):
    rc, out, _ = roda(["dpkg-query", "-W", "-f=${Status}", pacote])
    return out.strip() if rc == 0 else ""


def pacote_instalado(status):
    """O Status do dpkg e "<desejo> <erro> <estado>", e so o ESTADO diz se o
    pacote esta no disco. Depois de `apt-mark hold` ele vira "hold ok installed":
    comparar a frase inteira com "install ok installed" daria o codium em hold —
    o estado normal depois do kit — como nao instalado (medido pelo ide-kit em
    2026-09-23)."""
    partes = status.split()
    return len(partes) == 3 and partes[2] == "installed"


def versao_pacote(pacote):
    rc, out, _ = roda(["dpkg-query", "-W", "-f=${Version}", pacote])
    return out.strip() if rc == 0 else ""


def tupla_de_versao(texto):
    partes = re.findall(r"\d+", texto.split("-")[0])
    return tuple(int(p) for p in partes[:3])


# ── JSONC ──────────────────────────────────────────────────────────────────
def _sem_comentarios(texto):
    """Tira // e /* */ FORA de string. Tokenizador, nao regex: os valores do
    perfil tem `/**` e `*/` DENTRO de string ("**/node_modules/*/**"), e uma
    regex de bloco comeria o padrao inteiro sem dar erro nenhum."""
    saida = []
    i, n = 0, len(texto)
    em_string = False
    while i < n:
        c = texto[i]
        if em_string:
            saida.append(c)
            if c == "\\" and i + 1 < n:
                saida.append(texto[i + 1])
                i += 2
                continue
            if c == '"':
                em_string = False
            i += 1
            continue
        if c == '"':
            em_string = True
            saida.append(c)
            i += 1
            continue
        if texto.startswith("//", i):
            fim = texto.find("\n", i)
            i = n if fim < 0 else fim
            continue
        if texto.startswith("/*", i):
            fim = texto.find("*/", i + 2)
            i = n if fim < 0 else fim + 2
            saida.append(" ")
            continue
        saida.append(c)
        i += 1
    return "".join(saida)


def _sem_virgula_final(texto):
    """Tira a virgula que precede } ou ], fora de string."""
    saida = []
    i, n = 0, len(texto)
    em_string = False
    while i < n:
        c = texto[i]
        if em_string:
            saida.append(c)
            if c == "\\" and i + 1 < n:
                saida.append(texto[i + 1])
                i += 2
                continue
            if c == '"':
                em_string = False
            i += 1
            continue
        if c == '"':
            em_string = True
            saida.append(c)
            i += 1
            continue
        if c == ",":
            j = i + 1
            while j < n and texto[j] in " \t\r\n":
                j += 1
            if j < n and texto[j] in "}]":
                i += 1
                continue
        saida.append(c)
        i += 1
    return "".join(saida)


def carrega_jsonc(texto):
    return json.loads(_sem_virgula_final(_sem_comentarios(texto)))


def le_jsonc(caminho):
    """(objeto, erro). Erro e texto para o relatorio, nunca excecao."""
    try:
        return carrega_jsonc(Path(caminho).read_text(encoding="utf-8")), None
    except OSError as erro:
        return None, f"ilegivel: {erro}"
    except ValueError as erro:
        return None, f"nao e JSON/JSONC valido: {erro}"


def igual(a, b):
    """Igualdade de JSON com tipo: em Python `True == 1`, e `false` no repo
    contra `0` no disco nao e o mesmo valor para o editor."""
    if isinstance(a, bool) or isinstance(b, bool):
        return type(a) is type(b) and a == b
    if isinstance(a, list) and isinstance(b, list):
        return len(a) == len(b) and all(igual(x, y) for x, y in zip(a, b))
    if isinstance(a, dict) and isinstance(b, dict):
        return a.keys() == b.keys() and all(igual(a[k], b[k]) for k in a)
    return a == b


def subconjunto(repo, disco):
    """Toda chave do repo presente no disco com o mesmo valor; objeto aninhado
    por subconjunto (o dono pode ter mais), escalar e lista por igualdade."""
    if isinstance(repo, dict):
        return isinstance(disco, dict) and all(k in disco and subconjunto(v, disco[k]) for k, v in repo.items())
    return igual(repo, disco)


def curto(valor, teto=140):
    texto = json.dumps(valor, ensure_ascii=False, sort_keys=True)
    return texto if len(texto) <= teto else texto[: teto - 1] + "…"


# ── extensoes ──────────────────────────────────────────────────────────────
def extensoes_instaladas(pasta):
    """({id minusculo: {versoes}}, origem, {id@versao: pasta}). Le o manifesto
    extensions.json; sem ele, o package.json de cada pasta, descontado o .obsolete
    (desinstalada que o editor ainda nao limpou do disco)."""
    res, pastas = {}, {}
    manifesto = pasta / "extensions.json"
    if manifesto.is_file():
        try:
            dados = json.loads(manifesto.read_text(encoding="utf-8"))
        except (OSError, ValueError) as erro:
            return None, f"manifesto ilegivel ({manifesto}): {erro}", {}
        for entrada in dados if isinstance(dados, list) else []:
            try:
                ident = str(entrada["identifier"]["id"]).lower()
                versao = str(entrada["version"]).lower()
            except (KeyError, TypeError):
                continue
            res.setdefault(ident, set()).add(versao)
            relativa = entrada.get("relativeLocation") or ""
            local = (entrada.get("location") or {}).get("path") if isinstance(entrada.get("location"), dict) else None
            pastas[f"{ident}@{versao}"] = str(pasta / relativa) if relativa else (local or "")
        return res, str(manifesto), pastas
    if not pasta.is_dir():
        return res, f"{pasta} inexistente", pastas
    obsoletas = set()
    try:
        obsoletas = set(json.loads((pasta / ".obsolete").read_text(encoding="utf-8")))
    except (OSError, ValueError, TypeError):
        pass
    for sub in sorted(pasta.iterdir()):
        if sub.name in obsoletas:
            continue
        try:
            pacote = json.loads((sub / "package.json").read_text(encoding="utf-8"))
            ident = f"{pacote['publisher']}.{pacote['name']}".lower()
            versao = str(pacote["version"]).lower()
        except (OSError, ValueError, KeyError, TypeError):
            continue
        res.setdefault(ident, set()).add(versao)
        pastas[f"{ident}@{versao}"] = str(sub)
    return res, f"package.json em {pasta} (sem extensions.json)", pastas


def piso_do_codium(pastas, ids_da_lista):
    """(piso, origem): o MAIOR engines.vscode entre as extensoes da lista que estao
    instaladas; sem nenhuma, o piso embutido."""
    piso, origem, achou = PISO_CODIUM_SEM_EXTENSAO, "piso embutido 1.107.0 (nenhuma extensao da lista instalada)", False
    for chave, pasta in sorted(pastas.items()):
        if chave.split("@", 1)[0] not in ids_da_lista or not pasta:
            continue
        try:
            engine = str(json.loads((Path(pasta) / "package.json").read_text(encoding="utf-8"))["engines"]["vscode"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        versao = tupla_de_versao(re.sub(r"^[^0-9]*", "", engine))
        if len(versao) == 3 and (not achou or versao > piso):
            piso, origem, achou = versao, f"engines.vscode {engine} de {chave}", True
    return piso, origem


def le_lista(caminho, embutida, r, rotulo):
    """Linhas `id@versao` em minusculas. Linha sem @ reprova: a lista e fechada,
    e uma linha sem versao instalaria o que o Open VSX tiver no dia."""
    if not caminho.is_file():
        r.aviso(f"{rotulo} ausente ({caminho}): usando a lista embutida do plano §8 frente 1.2")
        return [e.lower() for e in embutida]
    itens = []
    for num, bruta in enumerate(caminho.read_text(encoding="utf-8").splitlines(), 1):
        linha = bruta.split("#", 1)[0].strip()
        if not linha:
            continue
        if "@" not in linha:
            r.falha(f"{rotulo}:{num} sem @ ({linha!r}) — a lista e fechada: id@versao")
            continue
        itens.append(linha.lower())
    return itens


