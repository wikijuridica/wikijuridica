#!/usr/bin/env python3
"""update-frontboard-task — atualiza UMA tarefa do frontboard, in-place e atômico.

POR QUE EXISTE: o `p0_frontboard.jsonl` é append-only para tarefas NOVAS, mas o
estado de uma tarefa vive na própria linha (`closed_at`, `closed_by` já são
gravados assim nas 144 linhas históricas). Sem uma ferramenta, cada transição
vira um `sed` improvisado — e o board é o instrumento de continuidade da
operação: perdê-lo por escrita malfeita custa a sessão inteira.

R20 do plano de bots: "task que muda de estado sem gravar é operação perdida".
Esta é a ferramenta que torna o registro barato o bastante para ser feito sempre.

GARANTIAS:
  • escrita atômica (tmp + os.replace) — nunca deixa o board truncado;
  • só a linha do `id` pedido é tocada; as outras são copiadas byte a byte a
    partir do JSON reparseado, preservando as chaves que esta ferramenta não
    conhece;
  • recusa id inexistente em vez de criar linha nova em silêncio (criar tarefa
    é trabalho do gerador, não desta ferramenta);
  • grava `closed_at` automaticamente quando o status vira terminal, porque foi
    esse o padrão que as 61 linhas `done` do board já usavam.

Uso:
    tools/update-frontboard-task bots-t0.1 --estado promovido \\
        --status done --nota "texto" \\
        --campo medicao_antes="..." --campo evidencia="commit abc123"
"""

import argparse
import json
import os
import sys
import tempfile
from datetime import datetime, timezone, timedelta

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
BOARD = os.path.join(RAIZ, ".agents/runtime/p0_frontboard.jsonl")
TZ = timezone(timedelta(hours=-3))

# Estados do PROTOCOLO DE VERIFICAÇÃO AO VIVO (6 passos) do plano de bots.
ESTADOS = [
    "pendente",
    "medindo-antes",
    "reproduzindo",
    "aplicando",
    "verificando",
    "promovido",
    "bloqueado",
    "derrubado",
]
# Status terminais no vocabulário que os consumidores do board leem.
TERMINAIS = {"done", "closed", "superseded"}


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("id", help="id da tarefa no board (ex.: bots-t0.1)")
    p.add_argument("--estado", choices=ESTADOS, help="estado_protocolo")
    p.add_argument("--status", help="status do board (queued/in_progress/done/blocked/...)")
    p.add_argument("--nota", help="acrescenta ao campo note, com carimbo de hora")
    p.add_argument("--dono", help="quem executou")
    p.add_argument(
        "--campo",
        action="append",
        default=[],
        metavar="CHAVE=VALOR",
        help="grava um campo arbitrário (medicao_antes, contra_teste, evidencia, ...)",
    )
    args = p.parse_args()

    if not os.path.exists(BOARD):
        print(f"frontboard ausente: {BOARD}", file=sys.stderr)
        return 2

    agora = datetime.now(TZ).replace(microsecond=0).isoformat()
    linhas, achou = [], False
    with open(BOARD, encoding="utf-8") as f:
        for bruta in f:
            crua = bruta.rstrip("\n")
            if not crua.strip():
                continue
            try:
                r = json.loads(crua)
            except Exception:
                # Linha que não parseia é PRESERVADA como está — nunca descartada.
                linhas.append(crua)
                continue
            if r.get("id") != args.id:
                linhas.append(json.dumps(r, ensure_ascii=False))
                continue
            achou = True
            if args.estado:
                r["estado_protocolo"] = args.estado
            if args.status:
                r["status"] = args.status
                if args.status in TERMINAIS and not r.get("closed_at"):
                    r["closed_at"] = agora
                    r["closed_by"] = args.dono or r.get("opened_by", "?")
            if args.dono:
                r["quem_executou"] = args.dono
            for par in args.campo:
                if "=" not in par:
                    print(f"--campo precisa de CHAVE=VALOR, veio {par!r}", file=sys.stderr)
                    return 2
                chave, valor = par.split("=", 1)
                r[chave.strip()] = valor
            if args.nota:
                anterior = r.get("note", "") or ""
                r["note"] = (anterior + f" | [{agora}] " + args.nota).strip(" |")
            r["updated_at"] = agora
            linhas.append(json.dumps(r, ensure_ascii=False))

    if not achou:
        print(f"id {args.id!r} nao existe no board — criar tarefa e trabalho do gerador", file=sys.stderr)
        return 3

    d = os.path.dirname(BOARD)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".frontboard-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            for l in linhas:
                out.write(l + "\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(tmp, BOARD)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    print(f"{args.id}: atualizada ({len(linhas)} linhas preservadas)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
