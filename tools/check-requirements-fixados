#!/usr/bin/env python3
"""Confere TODO requirements-*.txt de tools/ contra o interpretador que o EXECUTA.

POR QUE ESTE GATE NASCEU (2026-09-10).

`ptbr-lexical-diversity` reprovava com `nltk version mismatch: 3.10.3` — o
requirements fixa `nltk==3.9.4`, e alguem instalou 3.10.3 em 2026-09-08 10:06.
Restaurar a versao fixada bastou: o gate passou sem tocar em uma linha de codigo.
O defeito nao era de conteudo nem de detector; era o ambiente derivando do que o
repositorio declara. Fui ver se era caso isolado e nao era — nenhum instrumento
olhava o CONJUNTO dos doze requirements, so cada gate o seu, e so quando rodava.

O PRIMEIRO DESENHO DESTE GATE ESTAVA ERRADO, E A CORRECAO E A RAZAO DE ELE TER
UM MAPA (2026-09-10, mesma data).

O paragrafo abaixo e o que este cabecalho afirmava, preservado porque contrato
superado se data e se explica, nunca se apaga:

    "Conferindo os doze requirements contra o disco: CINCO versoes divergentes e
    doze pacotes ausentes. A pior e `torch`, que os requirements fixam em
    `2.12.1+cpu` e o disco tem em 2.13.0+cu130 — build CUDA, 1,2 GB, com
    `torch.cuda.is_available()` devolvendo False neste host. Sao 1,2 GB de
    biblioteca CUDA que nunca serao usados, instalados por cima de um pin que
    dizia `+cpu`."

QUATRO DAQUELAS CINCO DIVERGENCIAS ERAM FALSAS, e a causa e uma so: o gate lia
`importlib.metadata` do proprio interpretador — o python3 do SISTEMA — e comparava
com pins que, na maioria dos arquivos, pertencem a um venv proprio. Medido:

  - `trafilatura==2.1.0` acusava 2.2.0. `.cache/demand-extraction-venv` tem
    exatamente 2.1.0, e `docs/goal/PLANO_FRESCOR_DIARIO.md:919` ja registrava
    que o python3 do sistema nao tem trafilatura.
  - `torch==2.12.1+cpu` acusava 2.13.0 em `requirements-ptbr-morphsyntax-oracle`.
    `.cache/ptbr-morphsyntax-venv` tem exatamente `2.12.1+cpu`, e
    `internal/ptbrmorphsyntaxoracle/oracle.go:79` RECUSA cair para o sistema com
    todas as letras. O 2.13.0 do sistema e uma segunda copia, nao um pin violado —
    e o `+cu130` da frase antiga tambem nao se confirma: `md.version()` devolve
    `2.13.0` seco.
  - `pip==26.1.2` e `setuptools==81.0.0` acusavam 26.2.1 e 84.0.0. Esses pins sao
    do venv que `tools/python-quality-sca-env` cria; o pip do sistema nunca foi
    o sujeito deles. Baixar a versao do sistema para "consertar" teria sido
    trabalho feito contra um achado falso.

Sobrou UMA divergencia real, e ela e real justamente porque o mapa a resolve:
`torch==2.12.1+cpu` em `requirements-oss-install-matrix.txt`, cujo venv
`.cache/oss-python-venv` nao esta provisionado e cujos consumidores Go caem para
o python3 do sistema por desenho declarado
(`internal/ossinstallmatrix/matrix.go:1952-1968`, `adapters.go:1090,1116`). Ali o
sistema E o interpretador que roda, e ele carrega 2.13.0.

Nove dos doze "ausentes" tinham a mesma causa: ruff, mypy, pip-audit,
pip-licenses e zizmor moram no venv de ferramenta; confusable-homoglyphs e
lxml_html_clean estao instalados nos venvs deles.

O QUE MUDOU NO DESENHO

`tools/requirements_interpretadores.json` declara, por arquivo, o venv que o
serve e em que regime o python3 do sistema entra — `sempre` (consumidor que cai
direto nele sem olhar o venv), `quando_sem_venv` (consumidor que consulta o venv
antes) ou `nunca` — cada entrada com a prova em arquivo:linha. O gate mede TODO interpretador VIVO da entrada, e nao um vencedor
escolhido: pin violado em qualquer interpretador que possa rodar e execucao
irreproduzivel. `tools/test_check_requirements_fixados.py` confere o mapa contra
o disco, entao entrada que apodrecer reprova o teste em vez de cegar o gate.

O QUE REPROVA, E O QUE NAO

Reprova DIVERGENCIA de versao num interpretador vivo: o pin existe para ser
respeitado, e versao diferente da declarada torna a execucao irreproduzivel — a
evidencia gravada diz uma coisa e o que rodou foi outra.

NAO reprova AUSENCIA de pacote, e a distincao e deliberada. Pacote ausente e
"ferramenta nao instalada", que o gate especifico dela ja acusa com a mensagem
certa quando roda (`ptbr-morphsyntax-evidence` diz o comando de provisionamento
na propria mensagem). Reprovar aqui duplicaria esse vermelho e transformaria este
gate num segundo lugar para desligar a mesma coisa.

NAO reprova AMBIENTE NAO PROVISIONADO — venv declarado que nao existe no disco.
Nao ha o que divergir de um interpretador que ninguem criou; o conserto e rodar
o comando de materializacao, que este gate imprime por entrada.

Uso:
    ./tools/check-requirements-fixados
    ./tools/check-requirements-fixados --json
"""
from __future__ import annotations

import argparse
import glob
import importlib.metadata as md
import json
import os
import re
import subprocess
import sys
import tempfile

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PADRAO = "tools/requirements-*.txt"
MAPA_REL = "tools/requirements_interpretadores.json"
# `nome==versao`, com comentario e marcador de ambiente ja removidos.
FIXACAO = re.compile(r"^([A-Za-z0-9._-]+)==([^\s;]+)$")
# Consulta uma versao por nome no interpretador ALVO. `md.version` resolve pela
# precedencia de `sys.path` daquele interpretador, que e o que o `import` dele
# vai carregar — e ja normaliza o nome por PEP 503.
SONDA = (
    "import importlib.metadata as m, json, sys\n"
    "achado = {}\n"
    "for nome in sys.argv[1:]:\n"
    "    try:\n"
    "        achado[nome] = m.version(nome)\n"
    "    except Exception:\n"
    "        achado[nome] = None\n"
    "print(json.dumps(achado))\n"
)


def versao_viva(nome: str) -> str | None:
    """A versao que o `import` DESTE interpretador realmente encontraria.

    ESTE FOI O PRIMEIRO DEFEITO DESTE GATE, e ele quase publicou 22 divergencias
    falsas. A primeira versao montava um dicionario com `md.distributions()`, que
    enumera TODOS os caminhos de `sys.path` — inclusive
    `/usr/lib/python3/dist-packages`, onde o Debian mantem copias antigas. O
    ultimo achado sobrescrevia o primeiro, entao o gate anunciava `nltk 3.8` e
    `matplotlib 3.6.3` enquanto o `import` do mesmo interpretador entregava
    3.9.4 e 3.11.0, medidos minutos antes.

    `md.version()` resolve pela precedencia de `sys.path`: devolve a distribuicao
    que vence, que e a que o codigo vai carregar. E a versao que importa e a que
    o codigo carrega, nao a que sobrou num diretorio.

    E ela ja normaliza o nome por PEP 503 — medido: `python_dateutil`,
    `Python.Dateutil` e `PIP` resolvem todos. Por isso NAO ha normalizacao
    propria aqui. Uma existiu na primeira versao e era codigo morto: o fallback
    que a chamava nunca era alcancado, porque a chamada anterior ja tinha
    resolvido. Codigo que nunca executa nao fica, e
    test_pontuacao_do_nome_nao_inventa_ausencia guarda o comportamento.
    """
    try:
        return md.version(nome)
    except md.PackageNotFoundError:
        return None


def versoes_em(python: str, nomes: list[str]) -> dict:
    """As versoes que `python` carregaria para `nomes`.

    Interpretador igual ao que roda este gate resolve em processo, pelo mesmo
    `versao_viva` — mesma resposta, sem custo de subprocesso. Interpretador
    estrangeiro (venv de ferramenta) so pode ser consultado de dentro dele: o
    `sys.path` de um venv nao e visivel daqui.

    A comparacao e por caminho LITERAL, nunca por `os.path.realpath`, e isso
    custou uma medicao errada em 2026-09-10. `.cache/<venv>/bin/python` e um
    SYMLINK para /usr/bin/python3: com `realpath` os dois viravam o mesmo
    arquivo, o curto-circuito disparava, e o gate media o sistema achando que
    media o venv — devolvendo `trafilatura 2.2.0` e `torch 2.13.0` onde o venv
    tem 2.1.0 e 2.12.1+cpu. Quem define o venv e o `pyvenv.cfg` ao lado do
    caminho INVOCADO, nao o binario para onde o link aponta.
    """
    if os.path.abspath(python) == os.path.abspath(sys.executable):
        return {nome: versao_viva(nome) for nome in nomes}
    try:
        saida = subprocess.run([python, "-c", SONDA, *nomes],
                               capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return {nome: None for nome in nomes}
    if saida.returncode != 0 or not saida.stdout.strip():
        return {nome: None for nome in nomes}
    try:
        return json.loads(saida.stdout)
    except json.JSONDecodeError:
        return {nome: None for nome in nomes}


def carrega_mapa(raiz: str) -> dict:
    with open(os.path.join(raiz, MAPA_REL), encoding="utf-8") as arquivo:
        return json.load(arquivo)["arquivos"]


def interpretadores(raiz: str, entrada: dict) -> tuple[list, list]:
    """Os interpretadores VIVOS da entrada, e os declarados que faltam.

    Ordem de candidatos: override de ambiente, venv persistente em `.cache/`,
    venv legado em TMPDIR, e o python3 do sistema conforme o campo `sistema`.
    Entre os venvs nao ha escolha de vencedor — todo vivo e medido, porque pin
    violado em qualquer um deles ja torna a execucao irreproduzivel. O sistema
    e o unico que depende do desenho do consumidor, e por isso tem estado
    proprio no mapa em vez de um booleano.
    """
    vivos, faltando = [], []
    for variavel in (entrada.get("variavel_python"), entrada.get("variavel_venv")):
        valor = os.environ.get(variavel or "", "").strip()
        if not valor:
            continue
        # A variavel aponta ora para o interpretador (WIKI_*_PYTHON), ora para
        # a raiz do venv (WIKI_*_VENV). Diretorio vira `bin/python`.
        caminho = valor
        if os.path.isdir(caminho):
            caminho = os.path.join(caminho, "bin", "python")
        if os.path.isfile(caminho) and os.access(caminho, os.X_OK):
            vivos.append({"rotulo": f"${variavel}", "python": caminho})

    persistente = entrada.get("venv_persistente", "")
    if persistente:
        caminho = os.path.join(raiz, persistente, "bin", "python")
        if os.access(caminho, os.X_OK):
            vivos.append({"rotulo": persistente, "python": caminho})
        else:
            faltando.append(persistente)

    legado = entrada.get("venv_legado", "")
    if legado:
        caminho = os.path.join(tempfile.gettempdir(), legado, "bin", "python")
        if os.access(caminho, os.X_OK):
            vivos.append({"rotulo": os.path.join(tempfile.gettempdir(), legado),
                          "python": caminho})

    # Tres estados, nao um booleano, e a diferenca decide vermelho legitimo de
    # dividia inventada. "sempre": o consumidor le a variavel e cai direto no
    # python3 sem NUNCA consultar o venv, entao o sistema e interpretador vivo
    # mesmo com o venv criado — `cmd/check <nome>` chamado direto nao passa pelo
    # wrapper que exporta WIKI_*_PYTHON, e foi por esse caminho que o nltk do
    # sistema derivou. "quando_sem_venv": o consumidor consulta o venv antes, e
    # provisionar o venv tira o sistema da conta. "nunca": o consumidor recusa.
    sistema = entrada.get("sistema", "nunca")
    if sistema == "sempre" or (sistema == "quando_sem_venv" and not vivos):
        vivos.append({"rotulo": "python3 do sistema", "python": sys.executable})
    return vivos, faltando


def fixacoes_de(caminho: str) -> list:
    achadas = []
    with open(caminho, encoding="utf-8") as arquivo:
        for linha in arquivo:
            linha = linha.split("#")[0].strip()
            achado = FIXACAO.match(linha)
            if achado:
                achadas.append((achado.group(1), achado.group(2)))
    return achadas


def confere(raiz: str) -> dict:
    mapa = carrega_mapa(raiz)
    divergencias, ausencias, nao_provisionados, sem_mapa = [], [], [], []
    fixacoes = 0
    arquivos = sorted(glob.glob(os.path.join(raiz, PADRAO)))
    for caminho in arquivos:
        rel = os.path.relpath(caminho, raiz).replace(os.sep, "/")
        pins = fixacoes_de(caminho)
        fixacoes += len(pins)
        entrada = mapa.get(rel)
        if entrada is None:
            # Arquivo novo sem entrada no mapa: nao se adivinha o interpretador.
            # O teste do mapa reprova este caso; aqui ele fica visivel.
            sem_mapa.append(rel)
            continue
        if not pins:
            continue
        vivos, faltando = interpretadores(raiz, entrada)
        if not vivos:
            nao_provisionados.append({
                "arquivo": rel,
                "venvs": faltando,
                "pacotes": len(pins),
                "materializar": entrada.get("materializar", ""),
            })
            continue
        nomes = [nome for nome, _ in pins]
        lidas = {vivo["rotulo"]: versoes_em(vivo["python"], nomes) for vivo in vivos}
        for nome, fixada in pins:
            onde_diverge = {r: v[nome] for r, v in lidas.items()
                            if v.get(nome) is not None and v[nome] != fixada}
            if onde_diverge:
                for rotulo, viva in onde_diverge.items():
                    divergencias.append({"arquivo": rel, "pacote": nome,
                                         "fixada": fixada, "viva": viva,
                                         "interpretador": rotulo})
                continue
            if all(v.get(nome) is None for v in lidas.values()):
                ausencias.append({"arquivo": rel, "pacote": nome,
                                  "fixada": fixada,
                                  "interpretadores": sorted(lidas)})
    return {
        "arquivos": len(arquivos),
        "fixacoes": fixacoes,
        "divergencias": divergencias,
        "ausencias": ausencias,
        "nao_provisionados": nao_provisionados,
        "sem_mapa": sem_mapa,
    }


def main(argv: list[str] | None = None) -> int:
    analisador = argparse.ArgumentParser(
        description="confere os requirements fixados contra quem os executa")
    analisador.add_argument("--json", action="store_true")
    analisador.add_argument("--raiz", default=RAIZ)
    argumentos = analisador.parse_args(argv)

    estado = confere(argumentos.raiz)
    reprova = bool(estado["divergencias"] or estado["sem_mapa"])
    if argumentos.json:
        print(json.dumps(estado, ensure_ascii=False, indent=2, sort_keys=True))
        return 1 if reprova else 0

    print(f"requirements conferidos: {estado['arquivos']} arquivo(s), "
          f"{estado['fixacoes']} versao(oes) fixada(s)")
    if estado["nao_provisionados"]:
        # Reportado, nunca reprovado — ver o cabecalho.
        print(f"\nambiente nao provisionado ({len(estado['nao_provisionados'])}) — "
              f"o venv declarado nao existe no disco, entao nao ha versao viva a "
              f"divergir:")
        for item in estado["nao_provisionados"]:
            venvs = ", ".join(item["venvs"]) or "(sem venv declarado)"
            print(f"  {item['arquivo']}  ({item['pacotes']} pin(s)) — falta {venvs}")
            if item["materializar"]:
                print(f"      materializar: {item['materializar']}")
    if estado["ausencias"]:
        print(f"\nnao instalados ({len(estado['ausencias'])}) — o gate de cada um "
              f"acusa isso com a mensagem certa, aqui e so inventario:")
        for item in estado["ausencias"]:
            onde = ", ".join(item["interpretadores"])
            print(f"  {item['pacote']}=={item['fixada']}  ({item['arquivo']}) "
                  f"[ausente em: {onde}]")
    if estado["sem_mapa"]:
        print(f"\ncheck-requirements-fixados: FAIL — requirements sem entrada em "
              f"{MAPA_REL}:")
        for rel in estado["sem_mapa"]:
            print(f"  - {rel}")
        print("\n  Sem a entrada nao se sabe QUAL interpretador executa esses "
              "pins, e\n  adivinhar foi o defeito que este mapa existe para "
              "impedir. Declare o venv,\n  o fallback e a prova em arquivo:linha.")
    if not estado["divergencias"]:
        if not estado["sem_mapa"]:
            print("\ncheck-requirements-fixados: OK — todo interpretador vivo "
                  "carrega a versao que o repositorio declara.")
        return 1 if reprova else 0
    print("\ncheck-requirements-fixados: FAIL")
    for item in estado["divergencias"]:
        print(f"  - {item['pacote']}: fixada={item['fixada']} "
              f"viva={item['viva']} em {item['interpretador']}  "
              f"({item['arquivo']})")
    print("\n  O pin existe para ser respeitado: versao diferente da declarada "
          "torna a\n  execucao irreproduzivel, e a evidencia gravada passa a "
          "descrever outro ambiente.\n  Conserto: instale a versao fixada NO "
          "INTERPRETADOR ACUSADO, ou mova o pin com\n  licenca e motivo escritos.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
