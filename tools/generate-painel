def _ultimo(itens, chave):
    for item in reversed(itens):
        if item.get(chave) is not None:
            return item
    return None


def secao_resumo(ctx: Contexto, secoes: dict) -> dict:
    borda, bots, bing, humanos, cerebro, social = (
        secoes["borda"], secoes["bots"], secoes["bing"], secoes["humanos"], secoes["cerebro"], secoes["social"])
    dia = ctx.ultimo_dia_completo
    traf = next((t for t in borda["trafego_por_dia"] if t.get("date") == dia and t.get("presente")), None)
    cache = _ultimo(borda["cache_por_dia"], "hit_pct")
    lei = next((l for l in bots["leituras_por_dia"] if l["date"] == dia), None)
    busca = _ultimo(bing["busca_por_dia"], "impressions")
    rastreio = _ultimo(bing["rastreio_por_dia"], "in_index")
    janela = humanos["janelas"][-1] if humanos["janelas"] else None
    cer = next((e for e in cerebro["por_dia"] if e["date"] == dia), None)
    fila = {}
    for item in cerebro["fila"]["por_tipo_estado"]:
