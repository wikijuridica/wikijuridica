# gravação
# ---------------------------------------------------------------------------

VOLATEIS = frozenset({"gerado_em", "mtime", "commit"})


def _sem_volateis(obj):
    """`commit` é volátil de propósito: HEAD avança várias vezes por hora neste
    repositório, e o JSON só deve mudar quando o CONTEÚDO mudou. Assim,
    `gerado_em`/`commit` do JSON são os da última mudança de conteúdo; o HTML
    leva sempre o HEAD corrente."""
    if isinstance(obj, dict):
        return {k: _sem_volateis(v) for k, v in obj.items() if k not in VOLATEIS}
    if isinstance(obj, list):
        return [_sem_volateis(v) for v in obj]
    return obj


def grava_json(caminho: str, dados: dict) -> bool:
    """Grava só quando o conteúdo mudou (ignorando gerado_em/mtime)."""
    if os.path.isfile(caminho):
        try:
            with open(caminho, encoding="utf-8") as handle:
                antigo = json.load(handle)
        except (OSError, ValueError):
            antigo = None
        if antigo is not None and _sem_volateis(antigo) == _sem_volateis(dados):
            return False
    grava_atomico(caminho, json.dumps(dados, ensure_ascii=False, indent=1) + "\n")
    return True


def grava_atomico(caminho: str, texto: str) -> None:
    os.makedirs(os.path.dirname(caminho) or ".", exist_ok=True)
    tmp = caminho + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(texto)
    os.replace(tmp, caminho)


def gerar(raiz: str, hoje: dt.date, dias: int, saida: str, json_dir: str, commit: str | None = None) -> dict:
    inicio = time.monotonic()
    ctx = Contexto(raiz, hoje, dias, commit or commit_atual(raiz))
    secoes = {"borda": secao_borda(ctx)}
    secoes["bots"] = secao_bots(ctx)
    secoes["bing"] = secao_bing(ctx)
    secoes["humanos"] = secao_humanos(ctx)
    secoes["cerebro"] = secao_cerebro(ctx)
    secoes["social"] = secao_social(ctx)
    resumo = secao_resumo(ctx, secoes)
    pagina = monta_html(ctx, secoes, resumo)
    tamanho = len(pagina.encode("utf-8"))
    gravados = []
    for nome, dados in list(secoes.items()) + [("resumo", resumo)]:
        caminho = os.path.join(json_dir, nome + ".json")
        if grava_json(caminho, dados):
            gravados.append(caminho)
    if tamanho > TETO_HTML_BYTES:
        return {"ok": False, "motivo": "HTML com %d bytes excede o teto de %d" % (tamanho, TETO_HTML_BYTES),
                "html_bytes": tamanho, "json_gravados": gravados, "segundos": round(time.monotonic() - inicio, 2)}
    grava_atomico(saida, pagina)
    return {"ok": True, "html": saida, "html_bytes": tamanho, "json_gravados": gravados,
            "segundos": round(time.monotonic() - inicio, 2), "commit": ctx.commit,
            "ultimo_dia_completo": ctx.ultimo_dia_completo}


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="gera o painel local (HTML + JSON) a partir dos ledgers de data/ops")
    parser.add_argument("--dias", type=int, default=30, help="janela em dias, terminando hoje (padrão 30)")
    parser.add_argument("--saida", default="var/painel/index.html", help="HTML de saída (relativo à raiz)")
    parser.add_argument("--json-dir", default="data/ops/painel", help="diretório dos JSON (relativo à raiz)")
    parser.add_argument("--raiz", default=RAIZ_PADRAO, help="raiz do repositório")
    parser.add_argument("--hoje", default=None, help="data de referência AAAA-MM-DD (padrão: hoje em UTC)")
    parser.add_argument("--commit", default=None, help="identificador do commit (padrão: git rev-parse --short HEAD)")
    args = parser.parse_args(argv)
    if args.dias < 1:
        parser.error("--dias precisa ser >= 1")
    try:
        hoje = dt.date.fromisoformat(args.hoje) if args.hoje else dt.datetime.now(dt.timezone.utc).date()
    except ValueError:
        parser.error("--hoje precisa ser AAAA-MM-DD")
    raiz = os.path.abspath(args.raiz)
    saida = args.saida if os.path.isabs(args.saida) else os.path.join(raiz, args.saida)
    json_dir = args.json_dir if os.path.isabs(args.json_dir) else os.path.join(raiz, args.json_dir)
    try:
        resultado = gerar(raiz, hoje, args.dias, saida, json_dir, args.commit)
    except OSError as erro:
        print("generate-painel: falha ao gravar: %s" % erro, file=sys.stderr)
        return 2
    print(json.dumps(resultado, ensure_ascii=False))
    return 0 if resultado["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
