# ---------------------------------------------------------------------------
# formatação e SVG
# ---------------------------------------------------------------------------

def esc(v) -> str:
    return html.escape("" if v is None else str(v), quote=True)


def fmt_int(v) -> str:
    if v is None:
        return "—"
    if isinstance(v, float) and not v.is_integer():
        return fmt_dec(v, 1)
    return "{:,}".format(int(v)).replace(",", ".")


def fmt_dec(v, casas=1) -> str:
    if v is None:
        return "—"
    return ("{:,.%df}" % casas).format(v).replace(",", "\x00").replace(".", ",").replace("\x00", ".")


def fmt_pct(v, casas=1) -> str:
    return "—" if v is None else fmt_dec(v, casas) + " %"


def compacto(v) -> str:
    if v is None:
        return "—"
    a = abs(v)
    if a >= 1_000_000:
        return fmt_dec(v / 1_000_000, 2) + " mi"
    if a >= 10_000:
        return fmt_dec(v / 1_000, 1) + " mil"
    return fmt_int(v)


def ddmm(data: str) -> str:
    return data[8:10] + "/" + data[5:7] if len(data) >= 10 else data


def passo_bonito(maximo: float, alvo: int = 4) -> float:
    if maximo <= 0:
        return 1.0
    bruto = maximo / alvo
    exp = 10 ** math.floor(math.log10(bruto))
    for m in (1, 2, 2.5, 5, 10):
        if m * exp >= bruto:
            return m * exp
    return 10 * exp


def fmt_tick(v: float) -> str:
    if v == int(v):
        return fmt_int(int(v))
    return fmt_dec(v, 1)


# MR reserva espaço para o rótulo direto do último ponto (até "150.943 %", ~60 px a 11 px).
SVG_W, SVG_H, ML, MR, MT, MB = 760, 230, 56, 66, 14, 30
SLOTS = ("var(--s1)", "var(--s2)", "var(--s3)", "var(--s4)", "var(--s5)", "var(--s6)", "var(--s7)", "var(--s8)")


def cor_slot(i: int, nome: str) -> str:
    if nome == "outros":
        return "var(--outros)"
    return SLOTS[i % len(SLOTS)]


def _eixos(top: float, passo: float, n: int, datas: list, xs) -> str:
    partes = []
    plot_h = SVG_H - MT - MB
    t = 0.0
    while t <= top + 1e-9:
        y = MT + plot_h * (1 - t / top)
        partes.append('<line class="grade" x1="%d" x2="%d" y1="%.1f" y2="%.1f"/>' % (ML, SVG_W - MR, y, y))
        partes.append('<text class="tick" x="%d" y="%.1f" text-anchor="end">%s</text>' % (ML - 6, y + 3.5, fmt_tick(t)))
        t += passo
    partes.append('<line class="eixo" x1="%d" x2="%d" y1="%.1f" y2="%.1f"/>' % (ML, SVG_W - MR, MT + plot_h, MT + plot_h))
    k = max(1, math.ceil(n / 6))
    for i, d in enumerate(datas):
        if i % k == 0 or i == n - 1:
            partes.append('<text class="tick" x="%.1f" y="%d" text-anchor="middle">%s</text>'
                          % (xs(i), SVG_H - 8, esc(ddmm(d))))
    return "".join(partes)


def svg_linhas(datas: list, series: list, provisorio: list | None = None, fmt=fmt_int) -> str:
    """series: [{"nome", "valores": [num|None]*n, "slot": int}]; provisorio: [bool]*n."""
    n = len(datas)
    if n == 0 or not series:
        return '<p class="vazio">' + SEM_SERIE + "</p>"
    todos = [v for s in series for v in s["valores"] if v is not None]
    maximo = max(todos) if todos else 0
    passo = passo_bonito(maximo)
    top = max(passo, math.ceil(maximo / passo) * passo) if maximo > 0 else passo
    plot_h = SVG_H - MT - MB
    plot_w = SVG_W - ML - MR
    xs = (lambda i: ML + (plot_w * i / (n - 1) if n > 1 else plot_w / 2))
    ys = (lambda v: MT + plot_h * (1 - v / top))
    partes = ['<svg class="graf" viewBox="0 0 %d %d" role="img" aria-label="%s">'
              % (SVG_W, SVG_H, esc("; ".join(s["nome"] for s in series)))]
    partes.append(_eixos(top, passo, n, datas, xs))
    banda = plot_w / (n - 1) if n > 1 else plot_w
    for i, d in enumerate(datas):
        linhas = ["%s%s" % (ddmm(d), " (provisório)" if provisorio and provisorio[i] else "")]
        for s in series:
            linhas.append("%s: %s" % (s["nome"], fmt(s["valores"][i])))
        partes.append('<rect class="alvo" x="%.1f" y="%d" width="%.1f" height="%d"><title>%s</title></rect>'
                      % (xs(i) - banda / 2, MT, banda, plot_h, esc("\n".join(linhas))))
    rotulos = []
    for s in series:
        cor = cor_slot(s["slot"], s["nome"])
        seg = []
        d_atual = []
        for i, v in enumerate(s["valores"]):
            if v is None:
                if d_atual:
                    seg.append(d_atual)
                d_atual = []
                continue
            d_atual.append((xs(i), ys(v)))
        if d_atual:
            seg.append(d_atual)
        for pontos in seg:
            if len(pontos) == 1:
                continue
            path = "M" + " L".join("%.1f %.1f" % p for p in pontos)
            partes.append('<path class="linha" d="%s" stroke="%s"/>' % (path, cor))
        for i, v in enumerate(s["valores"]):
            if v is None:
                continue
            oco = bool(provisorio and provisorio[i])
            # A COR VAI EM ATRIBUTO DE APRESENTACAO SVG (fill/stroke), nunca em
            # style="": o painel e servido sob a CSP do nginx, que so admite
            # folha por hash e nada de estilo inline (nem 'unsafe-hashes').
            # Atributo de apresentacao nao e estilo inline para a CSP, e o CSS
            # abaixo deixa fill/stroke da marca livres para ele valer.
            partes.append('<circle class="marca%s" cx="%.1f" cy="%.1f" r="4" %s="%s"/>'
                          % (" oca" if oco else "", xs(i), ys(v), "stroke" if oco else "fill", cor))
        ultimo = next((i for i in range(n - 1, -1, -1) if s["valores"][i] is not None), None)
        if ultimo is not None:
            rotulos.append((ys(s["valores"][ultimo]), xs(ultimo), fmt(s["valores"][ultimo])))
    usados = []
    for y, x, texto in sorted(rotulos):
        if any(abs(y - u) < 12 for u in usados):
            continue
        usados.append(y)
        partes.append('<text class="rotulo" x="%.1f" y="%.1f">%s</text>' % (x + 8, y + 4, esc(texto)))
    partes.append("</svg>")
    return "".join(partes)


def svg_colunas(datas: list, series: list, provisorio: list | None = None, fmt=fmt_int) -> str:
    """Colunas empilhadas (1 série = colunas simples). Teto de 24 px, vão de 2 px
    entre segmentos, topo arredondado de 4 px no segmento de cima."""
    n = len(datas)
    if n == 0 or not series:
        return '<p class="vazio">' + SEM_SERIE + "</p>"
    totais = [sum((s["valores"][i] or 0) for s in series) for i in range(n)]
    maximo = max(totais) if totais else 0
    passo = passo_bonito(maximo)
    top = max(passo, math.ceil(maximo / passo) * passo) if maximo > 0 else passo
    plot_h = SVG_H - MT - MB
    plot_w = SVG_W - ML - MR
    banda = plot_w / n
    largura = min(24.0, banda * 0.7)
    xs = (lambda i: ML + banda * i + banda / 2)
    base = MT + plot_h
    partes = ['<svg class="graf" viewBox="0 0 %d %d" role="img" aria-label="%s">'
              % (SVG_W, SVG_H, esc("; ".join(s["nome"] for s in series)))]
    partes.append(_eixos(top, passo, n, datas, xs))
    for i, d in enumerate(datas):
        prov = bool(provisorio and provisorio[i])
        linhas = ["%s%s" % (ddmm(d), " (provisório)" if prov else "")]
        for s in series:
            linhas.append("%s: %s" % (s["nome"], fmt(s["valores"][i])))
        if len(series) > 1:
            linhas.append("total: %s" % fmt(totais[i] if any(s["valores"][i] is not None for s in series) else None))
        partes.append('<g class="coluna%s"><title>%s</title>' % (" prov" if prov else "", esc("\n".join(linhas))))
        partes.append('<rect class="alvo" x="%.1f" y="%d" width="%.1f" height="%d"/>'
                      % (xs(i) - banda / 2, MT, banda, plot_h))
        acumulado = 0.0
        presentes = [(s, s["valores"][i]) for s in series if s["valores"][i]]
        x0 = xs(i) - largura / 2
        for j, (s, v) in enumerate(presentes):
            h = plot_h * v / top
            topo = j == len(presentes) - 1
            y_top = base - acumulado - h
            cor = cor_slot(s["slot"], s["nome"])
            if topo:
                r = min(4.0, h / 2, largura / 2)
                partes.append(
                    '<path class="seg" fill="%s" d="M%.1f %.1f a%.1f %.1f 0 0 1 %.1f -%.1f h%.1f a%.1f %.1f 0 0 1 %.1f %.1f V%.1f H%.1f Z"/>'
                    % (cor, x0, y_top + r, r, r, r, r, largura - 2 * r, r, r, r, r, base - acumulado, x0))
            else:
                alt = max(0.0, h - 2)
                if alt > 0:
                    partes.append('<rect class="seg" fill="%s" x="%.1f" y="%.1f" width="%.1f" height="%.1f"/>'
                                  % (cor, x0, y_top + 2, largura, alt))
            acumulado += h
        partes.append("</g>")
    partes.append("</svg>")
    return "".join(partes)


def legenda(series: list, tipo: str = "linha") -> str:
    if len(series) < 2:
        return ""
    # Amostra de cor como SVG com fill em atributo (ver a marca do grafico):
    # <i style="background:..."> seria estilo inline barrado pela CSP.
    itens = "".join('<li><svg class="chave chave-%s" aria-hidden="true" focusable="false">'
                    '<rect width="100%%" height="100%%" fill="%s"/></svg>%s</li>'
                    % (tipo, cor_slot(s["slot"], s["nome"]), esc(s["nome"])) for s in series)
    return '<ul class="legenda">%s</ul>' % itens


def tabela(cabecalho: list, linhas: list, resumo: str = "Tabela") -> str:
    if not linhas:
        return ""
    th = "".join("<th>%s</th>" % esc(c) for c in cabecalho)
    corpo = []
    for l in linhas:
        corpo.append("<tr>" + "".join(
            '<td class="%s">%s</td>' % ("num" if isinstance(v, (int, float)) or v is None else "txt", esc(_cel(v)))
            for v in l) + "</tr>")
    return ('<details class="tabela"><summary>%s</summary><div class="rolagem"><table><thead><tr>%s</tr></thead>'
            "<tbody>%s</tbody></table></div></details>" % (esc(resumo), th, "".join(corpo)))


def _cel(v):
    if v is None:
        return "—"
    if isinstance(v, bool):
        return "sim" if v else "não"
    if isinstance(v, float):
        return fmt_dec(v, 2)
    if isinstance(v, int):
        return fmt_int(v)
    return v


def tile(rotulo: str, valor: str, fonte: str, nota: str = "") -> str:
    return ('<div class="tile"><div class="rotulo">%s</div><div class="valor">%s</div>'
            '<div class="fonte">%s%s</div></div>'
            % (esc(rotulo), esc(valor), esc(fonte), (" · " + esc(nota)) if nota else ""))


def figura(titulo: str, svg: str, leg: str, tab: str, fonte: str, nota: str = "") -> str:
    return ('<figure class="grafico"><figcaption><strong>%s</strong> <span class="fonte">%s</span>%s</figcaption>'
            "%s%s%s</figure>"
            % (esc(titulo), esc(fonte), (' <span class="nota">%s</span>' % esc(nota)) if nota else "",
               svg, leg, tab))


def lista_ressalvas(itens: list) -> str:
    if not itens:
        return ""
    return '<details class="ressalvas"><summary>O que cada número é — e não é</summary><ul>%s</ul></details>' % "".join(
        "<li>%s</li>" % esc(i) for i in itens)


