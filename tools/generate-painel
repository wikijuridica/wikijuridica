    tf = tabela(["tipo", "estado", "n"], [[i["tipo"], i["estado"], i["n"]] for i in fila["por_tipo_estado"]],
                "Fila por tipo e estado (%s)" % ft["fila"]) or '<p class="vazio">fila: %s</p>' % esc(fila["motivo"])
    tt = tabela(["tipo", "modelo", "lotes", "itens", "prompt tokens", "eval tokens", "segundos", "tok/s total",
                 "prompt tok/s", "eval tok/s", "s/item"],
                [[t["tipo"], t["modelo"], t["lotes"], t["itens"], t["prompt_tokens"], t["eval_tokens"], t["segundos"],
                  t["tok_s_total"], t["prompt_tok_s"], t["eval_tok_s"], t["segundos_por_item"]] for t in s["taxa_por_modelo"]],
                "Taxa por (tipo, modelo) na janela — Σ tokens ÷ Σ segundos") or '<p class="vazio">taxas: %s</p>' % SEM_SERIE
    return '<div class="kpis">%s</div>%s%s%s%s%s' % (kpis, tf, f1, f2, tt, lista_ressalvas(s["ressalvas"]))


def html_social(s: dict) -> str:
    ft = s["fontes"]
    b = s["banco"]
    kpis = "".join(tile(t, fmt_int(b["contagens"].get(t)), ft["social_db"], "" if b["disponivel"] else str(b["motivo"]))
                   for t in TABELAS_SOCIAL)
    tm = tabela(["dia", "estado", "coletas", "banco presente", "piso de agregação"],
                [[m["data"], m["estado"], m["coletas"], m["banco_presente"], m["piso_de_agregacao"]] for m in s["moderacao_por_dia"]],
                "Transparência da moderação por dia (%s)" % ft["moderacao"]) or '<p class="vazio">moderação: %s</p>' % SEM_SERIE
    return '<div class="kpis">%s</div>%s%s' % (kpis, tm, lista_ressalvas(s["ressalvas"]))


def html_frescor(resumo: dict) -> str:
    partes = []
    for titulo, bloco in (("Frescor da borda", resumo["frescor"]), ("Experimentos", resumo["experimentos"])):
        if bloco["estado"] == SEM_SERIE:
            partes.append('<p class="vazio">%s: %s <span class="fonte">%s</span></p>' % (esc(titulo), SEM_SERIE, esc(bloco["arquivo"])))
            continue
        partes.append('<h3>%s <span class="fonte">%s</span></h3>' % (esc(titulo), esc(bloco["arquivo"])))
        partes.append(tabela(["dia", "linhas"], [[l["date"], l["linhas"]] for l in bloco["linhas_por_dia"]], "Linhas por dia")
                      or '<p class="vazio">nenhuma linha na janela</p>')
        if bloco["ultima_linha"]:
            partes.append(tabela(["campo", "valor"], [[k, v] for k, v in bloco["ultima_linha"].items()], "Última linha (campos escalares)"))
    return "".join(partes)


def monta_html(ctx: Contexto, secoes: dict, resumo: dict) -> str:
    corpo = {
        "borda": html_borda(secoes["borda"]),
        "bots": html_bots(secoes["bots"]),
        "bing": html_bing(secoes["bing"]),
        "previsao": html_previsao(le_previsao(ctx)),
        "humanos": html_humanos(secoes["humanos"]),
        "cerebro": html_cerebro(secoes["cerebro"]),
        "social": html_social(secoes["social"]),
        "frescor": html_frescor(resumo),
    }
    nav = "".join('<a href="#%s">%s</a>' % (i, esc(t)) for i, t in SECOES)
    partes = [
        "<!doctype html>",
        '<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
        "<title>Painel wikijuridica</title><meta name=\"robots\" content=\"noindex,nofollow\">",
        "<style>%s</style></head><body>" % CSS,
        '<header class="topo"><h1>Painel local — wikijuridica.com.br</h1><div class="meta">gerado_em %s · commit %s · hoje %s · '
        "janela %d dia(s) (%s → %s) · último dia completo %s</div></header>"
        % (esc(ctx.gerado_em), esc(ctx.commit), esc(ctx.hoje_iso), ctx.dias, esc(ctx.datas[0]), esc(ctx.datas[-1]),
           esc(ctx.ultimo_dia_completo)),
        '<nav class="secoes">%s</nav>' % nav,
    ]
    for ident, titulo in SECOES:
        partes.append('<section class="secao" id="%s"><h2>%s</h2>%s</section>' % (ident, esc(titulo), corpo[ident]))
    linhas_fontes = [[f["arquivo"], f["existe"], f["linhas"], f["linhas_invalidas"], f["mtime"]] for f in resumo["fontes"]]
    partes.append('<footer class="fontes">%s%s</footer>' % (
        tabela(["arquivo", "existe", "linhas", "inválidas", "mtime (UTC)"], linhas_fontes, "Fontes lidas nesta geração"),
        lista_ressalvas(resumo["ressalvas"])))
    partes.append("</body></html>")
    return "\n".join(partes)


