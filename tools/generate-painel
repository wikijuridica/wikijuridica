def _provisorio(r: dict, data: str, ctx: Contexto) -> bool:
    if data >= ctx.hoje_iso:
        return True
    nota = str(r.get("self_warming_note") or "")
    base = str(r.get("organic_requests_basis") or "")
    return "dia em curso" in nota or base.startswith("provisional")


def secao_borda(ctx: Contexto) -> dict:
    et = ctx.fonte("edge_traffic")
    por_dia = ultima_por_chave(et.registros, lambda r: r.get("date"))
    trafego = []
    completos = []
    for d in ctx.datas:
        r = por_dia.get(d)
        if r is None:
            trafego.append({"date": d, "presente": False})
            continue
        prov = _provisorio(r, d, ctx)
        if not prov:
            completos.append(d)
        trafego.append({
            "date": d, "presente": True, "provisorio": prov,
            "requests": numero(r.get("requests")),
            "self_warming_requests": numero(r.get("self_warming_requests")),
            "organic_requests": numero(r.get("organic_requests")),
            "page_views": numero(r.get("page_views")),
            "uniques": numero(r.get("uniques")),
            "schema_version": r.get("schema_version"),
        })
    if completos:
        ctx.ultimo_dia_completo = max(completos)

    cb = ctx.fonte("cache_baseline")
    base_por_dia = ultima_por_chave(cb.registros, lambda r: r.get("date"))
    cache = []
    for d in ctx.datas:
        r = base_por_dia.get(d)
        if r is None:
            continue
        cs = (r.get("cache_status") or {}).get("por_status") or {}
        csp = (r.get("cache_status_sem_trafego_proprio") or {}).get("por_status") or {}
        share = r.get("share_autoaquecimento") or {}
        aq = r.get("misses_do_aquecedor") or {}
        pu = r.get("purgas_url") or {}
        pt = r.get("purgas_tag") or {}
        cache.append({
            "date": d,
            "graphql_disponivel": r.get("graphql_disponivel"),
            "hit": numero((cs.get("hit") or {}).get("requests")),
            "miss": numero((cs.get("miss") or {}).get("requests")),
            "total": numero((r.get("cache_status") or {}).get("total_requests")),
            "hit_pct": numero((cs.get("hit") or {}).get("pct")),
            "miss_pct": numero((cs.get("miss") or {}).get("pct")),
            "hit_pct_sem_trafego_proprio": numero((csp.get("hit") or {}).get("pct")),
            "misses_do_aquecedor": numero(aq.get("requests")),
            "misses_total": numero((r.get("misses_total") or {}).get("requests")),
            "share_autoaquecimento": numero(share.get("share")),
            "purgas_tudo": numero(r.get("purgas_tudo")),
            "purgas_url_execucoes": numero(pu.get("execucoes")) if isinstance(pu, dict) else numero(pu),
            "purgas_tag_execucoes": numero(pt.get("execucoes")) if isinstance(pt, dict) else numero(pt),
        })

    ew = ctx.fonte("edge_warm")
    por_dia_aq: dict[str, dict] = {}
    for r in ew.registros:
        d = str(r.get("finished_at") or r.get("started_at") or "")[:10]
        if not ctx.na_janela(d):
            continue
        e = por_dia_aq.setdefault(d, {
            "date": d, "execucoes": 0, "urls": 0, "hit": 0, "miss": 0, "revalidated": 0,
            "outro": 0, "so_frios": False, "pre_head_hit_pct": None, "pre_head_total": None,
        })
        cs = r.get("cache_status") or {}
        e["execucoes"] += 1
        e["urls"] += numero(r.get("urls")) or 0
        for k in ("hit", "miss", "revalidated", "outro"):
            e[k] += numero(cs.get(k)) or 0
        e["so_frios"] = e["so_frios"] or bool(r.get("so_frios"))
        pre = r.get("cobertura_pre_head")
        if isinstance(pre, dict):
            total = sum((numero(v) or 0) for k, v in pre.items() if k != "sem_head")
            if total > 0:
                e["pre_head_hit_pct"] = round(100.0 * (numero(pre.get("hit")) or 0) / total, 2)
                e["pre_head_total"] = total
    aquecimento = [por_dia_aq[d] for d in ctx.datas if d in por_dia_aq]

    ep = ctx.fonte("edge_purge")
    por_dia_pu: dict[str, dict] = {}
    for r in ep.registros:
        d = str(r.get("purged_at") or "")[:10]
        if not ctx.na_janela(d):
            continue
        e = por_dia_pu.setdefault(d, {"date": d, "tudo": 0, "url": 0, "tag": 0,
                                      "urls_total": 0, "tags_total": 0, "falhas": 0})
        if r.get("success") is not True:
            e["falhas"] += 1
            continue
        escopo = str(r.get("scope") or "")
        cl = classifica_escopo_purga(escopo)
        e["tudo"] += cl["tudo"]
        e["url"] += cl["url"]
        e["tag"] += cl["tag"]
        e["urls_total"] += cl["urls_total"]
        e["tags_total"] += cl["tags_total"]
    purgas = [por_dia_pu[d] for d in ctx.datas if d in por_dia_pu]

    ressalvas = [
        "requests/page_views/uniques de edge_traffic_daily incluem o tráfego do próprio portal "
        "(aquecedor, sondas); organic_requests = requests − self_warming_requests do ledger de aquecimento.",
        "A linha final do dia D nasce em D+1 (06:20 UTC): o último ponto é provisório.",
        "hit/miss por dia vêm de cache_baseline_daily (GraphQL, TODO o tráfego da zona); "
        "cobertura_pre_head do aquecedor mede quanto estava quente ANTES do aquecedor tocar, "
        "e as execuções so_frios cobrem só as URLs frias — são grandezas diferentes.",
        "Purga por escopo conta EXECUÇÕES por tipo (tudo / por URL / por tag) e, ao lado, o total "
        "de URLs e tags declaradas no escopo.",
    ]
    if not cb.existe:
        ressalvas.append("cache_baseline_daily.jsonl ausente: hit/miss por dia " + SEM_SERIE + ".")
    return {
        "schema_version": SCHEMA,
        "gerado_em": ctx.gerado_em,
        "commit": ctx.commit,
        "dias": ctx.dias,
        "ultimo_dia_completo": ctx.ultimo_dia_completo,
        "fontes": {k: ctx.rel(k) for k in ("edge_traffic", "cache_baseline", "edge_warm", "edge_purge")},
        "trafego_por_dia": trafego,
        "cache_por_dia": cache,
        "aquecimento_por_dia": aquecimento,
        "purgas_por_dia": purgas,
        "ressalvas": ressalvas,
    }


def classifica_escopo_purga(escopo: str) -> dict:
    """'tudo' → purga total; 'N URL(s) em …; M tag(s) em …' → por URL e/ou por tag."""
    saida = {"tudo": 0, "url": 0, "tag": 0, "urls_total": 0, "tags_total": 0}
    if escopo.strip().lower() == "tudo":
        saida["tudo"] = 1
        return saida
    m_url = _RE_URLS.search(escopo)
    m_tag = _RE_TAGS.search(escopo)
    if m_url and int(m_url.group(1)) > 0:
        saida["url"] = 1
        saida["urls_total"] = int(m_url.group(1))
    if m_tag and int(m_tag.group(1)) > 0:
        saida["tag"] = 1
        saida["tags_total"] = int(m_tag.group(1))
    return saida


def _borda_por_chave(ctx: Contexto):
    """edge_bot_agents_daily lido como o produtor manda: serie_saneada quando o
    módulo existe; senão, a mesma dedupe (última linha por (date, agent_key))."""
    caminho = os.path.join(ctx.raiz, FONTES["edge_bots"])
    tools_dir = os.path.join(RAIZ_PADRAO, "tools")
    if tools_dir not in sys.path:
        sys.path.insert(0, tools_dir)
    try:
        import edgetelemetry  # noqa: E402
        por_chave, descartadas = edgetelemetry.serie_saneada(ctx.raiz, caminho=caminho)
        return por_chave, len(descartadas), "tools/edgetelemetry.serie_saneada"
    except ImportError as erro:
        ctx.ressalvas.append("edgetelemetry indisponível (%s): borda deduplicada localmente" % erro)
    fonte = ctx.fonte("edge_bots")
    por_chave = ultima_por_chave(
        fonte.registros, lambda r: (r.get("date"), r.get("agent_key")) if r.get("agent_key") else None)
    return por_chave, 0, "última linha por (date, agent_key), sem saneamento"


def _borda_valor(r: dict) -> tuple:
    """Mesma escolha de campo de tools/generate-cache-baseline: o count
    (`requests_sampled`) é a contagem; a faixa de IP entra quando a Cloudflare
    não verifica o agente; `requests_estimated` só resta nas linhas antigas."""
    total = numero(r.get("requests_sampled"))
    faixa = numero(r.get("requests_sampled_ip_range")) or 0
    if total is not None and total > 0:
        return total, "requests_sampled"
    if faixa > 0:
        return faixa, "requests_sampled_ip_range"
    if total is not None:
        return 0, "requests_sampled"
    est = numero(r.get("requests_estimated"))
    est_ip = numero(r.get("requests_estimated_ip_range")) or 0
    if est is not None and est > 0:
        return est, "requests_estimated"
    if est_ip > 0:
        return est_ip, "requests_estimated_ip_range"
    if est is not None:
        return 0, "requests_estimated"
    return None, None


def secao_bots(ctx: Contexto) -> dict:
    por_chave, descartadas, metodo = _borda_por_chave(ctx)
    borda: dict[str, dict[str, dict]] = {}
    for (d, agente), r in por_chave.items():
        if not ctx.na_janela(d) or not agente:
            continue
        valor, campo = _borda_valor(r)
        borda.setdefault(agente, {})[d] = {
            "valor": valor, "campo": campo,
            "ip_range": numero(r.get("requests_sampled_ip_range")) if "requests_sampled_ip_range" in r
            else numero(r.get("requests_estimated_ip_range")),
            "cloudflare_verified": numero(r.get("requests_sampled_cloudflare_verified")),
            "function": r.get("function"),
        }

    ob = ctx.fonte("origin_bots")
    origem: dict[str, dict[str, dict]] = {}
    for r in ob.registros:
        d = r.get("date")
        agente = r.get("agent_key")
        if not ctx.na_janela(d) or not agente or r.get("summable") is False:
            continue
        e = origem.setdefault(agente, {}).setdefault(d, {"valor": 0, "campo": None, "linhas": 0})
        if r.get("requests_authentic") is not None:
            e["valor"] += numero(r.get("requests_authentic")) or 0
            e["campo"] = e["campo"] or "requests_authentic"
        else:
            e["valor"] += numero(r.get("requests")) or 0
            e["campo"] = e["campo"] or "requests"
        e["linhas"] += 1

    funcoes = {}
    for a, dias in borda.items():
        for d in sorted(dias):
            if dias[d].get("function"):
                funcoes[a] = dias[d]["function"]
    totais = {a: sum((v["valor"] or 0) for v in dias.values()) for a, dias in borda.items()}
    ordenados = sorted(totais, key=lambda a: (-totais[a], a))
    # O gráfico é de bots de IA: treino, busca e agente de usuário. SEO, social,
    # diagnóstico e scanner ficam em `outros` (e inteiros na tabela de travessia).
    de_ia = [a for a in ordenados if funcoes.get(a) in FUNCOES_IA]
    principais = de_ia[:AGENTES_NO_GRAFICO]
    demais = [a for a in ordenados if a not in principais]
    leituras = []
    for d in ctx.datas:
        linha = {"date": d, "provisorio": d > ctx.ultimo_dia_completo, "por_agente": {}}
        for a in principais:
            v = borda.get(a, {}).get(d)
            linha["por_agente"][a] = None if v is None else v["valor"]
        outros = [borda[a][d]["valor"] for a in demais if d in borda.get(a, {})]
        linha["por_agente"]["outros"] = soma(outros) if demais else None
        leituras.append(linha)

    dia = ctx.ultimo_dia_completo
    cb = ctx.fonte("cache_baseline")
    base_dia = ultima_por_chave(cb.registros, lambda r: r.get("date")).get(dia)
    base_trav = (base_dia or {}).get("travessia_por_bot") or {}
    travessia = []
    for a in sorted(set(borda) | set(origem)):
        b = borda.get(a, {}).get(dia)
        o = origem.get(a, {}).get(dia)
        bv = None if b is None else b["valor"]
        ov = None if o is None else o["valor"]
        if bv is None and ov is None:
            continue
        item = {
            "agente": a, "funcao": funcoes.get(a),
            "borda": bv, "borda_campo": None if b is None else b["campo"],
            "origem": ov, "origem_campo": None if o is None else o["campo"],
            "origem_linhas": 0 if o is None else o["linhas"],
            "travessia": razao(ov if ov is not None else 0, bv) if bv else None,
            "status": "ok" if bv else "nao_mensuravel",
            "baseline_travessia": (base_trav.get(a) or {}).get("travessia") if a in base_trav else None,
        }
        travessia.append(item)
    travessia.sort(key=lambda i: (-(i["borda"] or 0), i["agente"]))

    radar = ctx.fonte("radar_ia")
    radar_por_dia = ultima_por_chave(radar.registros, lambda r: r.get("date"))
    radar_serie = []
    for d in ctx.datas:
        r = radar_por_dia.get(d)
        if r is None:
            continue
        lp = r.get("leituras_por_agente") or {}
        mp = r.get("markdown_por_agente") or {}
        radar_serie.append({
            "date": d,
            "leituras_total": soma(numero(v) for v in lp.values()),
            "markdown_total": soma(numero(v) for v in mp.values()),
            "leituras_por_agente": {k: numero(v) for k, v in sorted(lp.items())},
            "markdown_por_agente": {k: numero(v) for k, v in sorted(mp.items())},
            "descontos": r.get("descontos") or {},
        })

    br = ctx.fonte("bot_return")
    br_chave = ultima_por_chave(
        br.registros, lambda r: (r.get("date"), r.get("agent_key")) if r.get("agent_key") else None)
    datas_br = sorted({d for (d, _a) in br_chave if ctx.na_janela(d)})
    dia_br = datas_br[-1] if datas_br else None
    retorno = []
    if dia_br:
        for (d, a), r in sorted(br_chave.items()):
            if d != dia_br:
                continue
            retorno.append({
                "agente": a, "funcao": r.get("funcao"), "veio_hoje": r.get("veio_hoje"),
                "dias_desde_visita_anterior": numero(r.get("dias_desde_visita_anterior")),
                "requisicoes": numero(r.get("requisicoes")),
                "cobertura_acumulada_pct": numero(r.get("cobertura_acumulada_pct")),
                "urls_novas_no_dia": numero(r.get("urls_novas_no_dia")),
                "citacao_clique_de_volta": numero(r.get("citacao_clique_de_volta")),
                "identidade": r.get("identidade"),
            })
        retorno.sort(key=lambda i: (-(i["requisicoes"] or 0), i["agente"]))

    ressalvas = [
        "Leituras por agente = campo `%s` de edge_bot_agents_daily via %s "
        "(%d linha(s) descartada(s) pela série saneada). O gráfico mostra os %d maiores agentes de IA "
        "(function em %s); todo o resto — SEO, social, diagnóstico, scanner e IA menores — soma em `outros`."
        % ("requests_sampled (senão requests_estimated nas linhas antigas)", metodo, descartadas,
           AGENTES_NO_GRAFICO, ", ".join(sorted(FUNCOES_IA))),
        "Travessia = origem ÷ borda no último dia completo (%s): origem = Σ requests_authentic das "
        "janelas summable de origin_bot_traffic_daily; mesma fórmula de cache_baseline_daily, cujo valor "
        "aparece em `baseline_travessia` quando a linha do dia existe. Acima de 1 significa que o bot "
        "chegou à origem mais vezes do que a borda contou (cache MISS, Markdown dinâmico ou identidade "
        "não verificada na borda)." % dia,
        "radar_ia_daily conta leituras VERIFICADAS na origem (descontando forjadas); não é a mesma "
        "grandeza da borda.",
        "bot_return_daily: `citacao_clique_de_volta` é limite inferior de interesse, nunca contagem de citação.",
    ]
    return {
        "schema_version": SCHEMA,
        "gerado_em": ctx.gerado_em,
        "commit": ctx.commit,
        "dias": ctx.dias,
        "ultimo_dia_completo": dia,
        "fontes": {k: ctx.rel(k) for k in ("edge_bots", "origin_bots", "cache_baseline", "radar_ia", "bot_return")},
        "agentes_no_grafico": principais + (["outros"] if demais else []),
        "agentes_em_outros": demais,
        "funcoes_por_agente": dict(sorted(funcoes.items())),
        "funcoes_de_ia": sorted(FUNCOES_IA),
        "leituras_por_dia": leituras,
        "travessia": travessia,
        "radar_ia_por_dia": radar_serie,
        "retorno_ultimo_dia": {"date": dia_br, "agentes": retorno},
        "ressalvas": ressalvas,
    }


def secao_bing(ctx: Contexto) -> dict:
    bw = ctx.fonte("bing")
    por_tipo: dict[str, list] = {}
    for r in bw.registros:
        por_tipo.setdefault(str(r.get("tipo") or ""), []).append(r)

    busca = ultima_por_chave(por_tipo.get("busca_diaria", []), lambda r: r.get("Date"))
    rastreio = ultima_por_chave(por_tipo.get("rastreio_diario", []), lambda r: r.get("Date"))
    busca_serie = []
    rastreio_serie = []
    for d in ctx.datas:
        r = busca.get(d)
        if r is not None:
            busca_serie.append({"date": d, "impressions": numero(r.get("Impressions")),
                                "clicks": numero(r.get("Clicks"))})
        r = rastreio.get(d)
        if r is not None:
            rastreio_serie.append({
                "date": d, "in_index": numero(r.get("InIndex")),
                "crawled_pages": numero(r.get("CrawledPages")),
                "code_5xx": numero(r.get("Code5xx")), "crawl_errors": numero(r.get("CrawlErrors")),
                "in_links": numero(r.get("InLinks")),
            })

    def top(tipo):
        linhas = [r for r in por_tipo.get(tipo, []) if ctx.na_janela(r.get("Date"))]
        if not linhas:
            return None, []
        dia = max(r["Date"] for r in linhas)
        chave = ultima_por_chave([r for r in linhas if r["Date"] == dia],
                                 lambda r: (r.get("Query") or "").strip() or None)
        itens = [{
            "query": q, "impressions": numero(r.get("Impressions")) or 0,
            "clicks": numero(r.get("Clicks")) or 0,
            "avg_impression_position": numero(r.get("AvgImpressionPosition")),
        } for q, r in chave.items()]
        itens.sort(key=lambda i: (-i["impressions"], -i["clicks"], i["query"]))
        return dia, itens[:TOP_N]

    dia_consultas, consultas = top("consulta_diaria")
    dia_paginas, paginas = top("pagina_diaria")

    infos = ultima_por_chave(por_tipo.get("url_info", []), lambda r: r.get("Url"))
    url_info = None
    if infos:
        com_rastreio = sum(1 for r in infos.values()
                           if str(r.get("LastCrawledDate") or "").strip().lower() not in ("", "none"))
        status: dict[str, int] = {}
        for r in infos.values():
            k = str(r.get("HttpStatus"))
            status[k] = status.get(k, 0) + 1
        url_info = {
            "urls_consultadas": len(infos), "com_last_crawled_date": com_rastreio,
            "http_status": dict(sorted(status.items())),
            "coletado_em": max(str(r.get("coletado_em") or "") for r in infos.values()) or None,
        }

    submit = ctx.fonte("bing_submit")
    submit_por_dia = None
    if submit.existe:
        cont: dict[str, int] = {}
        for r in submit.registros:
            # A CHAVE REAL DO LEDGER VEM PRIMEIRO (2026-09-10). As três chaves
            # inglesas abaixo foram escritas por suposição e NENHUMA existe em
            # data/ops/bing_submit_ledger.jsonl, que grava `submetido_em`. O
            # efeito era silencioso do pior jeito: `submit.existe` é true, então
            # o painel mostrava a seção com `envios_por_dia: []` e nenhuma
            # ressalva — 200 submissões reais ao Bing, em dois lotes, invisíveis
            # para quem lê o painel. As chaves inglesas ficam como tolerância a
            # ledger antigo, nunca como fonte principal.
            d = str(r.get("submetido_em") or r.get("date") or r.get("submitted_at") or r.get("ts") or "")[:10]
            if ctx.na_janela(d):
                cont[d] = cont.get(d, 0) + 1
        submit_por_dia = [{"date": d, "linhas": n} for d, n in sorted(cont.items())]

    ressalvas = [
        "Impressions/Clicks = Bing Webmaster `busca_diaria` (última coleta por Date vence); "
        "InIndex/CrawledPages/Code5xx = `rastreio_diario`. O Bing publica com atraso de dias: "
        "os últimos dias podem vir zerados por ainda não terem sido computados, não por ausência de busca.",
        "Top consultas/páginas = `consulta_diaria`/`pagina_diaria` do último Date presente na janela, "
        "ordenadas por Impressions; `avg_impression_position` −1 significa sem dado.",
    ]
    if url_info is None:
        ressalvas.append("`url_info` " + SEM_SERIE + ".")
    if submit_por_dia is None:
        ressalvas.append("bing_submit_ledger.jsonl ausente: envios " + SEM_SERIE + ".")
    return {
        "schema_version": SCHEMA,
        "gerado_em": ctx.gerado_em,
        "commit": ctx.commit,
        "dias": ctx.dias,
        "fontes": {k: ctx.rel(k) for k in ("bing", "bing_submit")},
        "busca_por_dia": busca_serie,
        "rastreio_por_dia": rastreio_serie,
        "top_consultas": {"date": dia_consultas, "itens": consultas},
        "top_paginas": {"date": dia_paginas, "itens": paginas},
        "url_info": url_info,
        "envios_por_dia": submit_por_dia,
        "ressalvas": ressalvas,
    }


def _metrica(registro: dict, nome: str) -> list:
    for m in registro.get("metricas") or []:
        if m.get("metricName") == nome:
            return m.get("information") or []
    return []


def secao_humanos(ctx: Contexto) -> dict:
    cl = ctx.fonte("clarity")
    janelas = ultima_por_chave(
        [r for r in cl.registros if r.get("dimensoes") == ["Device"]],
        lambda r: (str(r.get("coletado_em") or "")[:10], numero(r.get("janela_dias"))))
    serie = []
    for (d, janela), r in sorted(janelas.items(), key=lambda kv: (kv[0][0], kv[0][1] or 0)):
        if not ctx.na_janela(d):
            continue
        traf = _metrica(r, "Traffic")
        item = {
            "coletado_em_dia": d, "janela_dias": janela,
            "sessoes": soma(numero(x.get("totalSessionCount")) for x in traf),
            "sessoes_bot": soma(numero(x.get("totalBotSessionCount")) for x in traf),
            "usuarios_distintos": soma(numero(x.get("distinctUserCount")) for x in traf),
            "por_dispositivo": {str(x.get("Device")): numero(x.get("totalSessionCount")) for x in traf},
        }
        for chave, nome in (("dead_clicks", "DeadClickCount"), ("rage_clicks", "RageClickCount"),
                            ("quickback_clicks", "QuickbackClick"), ("script_errors", "ScriptErrorCount"),
                            ("error_clicks", "ErrorClickCount"), ("excessive_scroll", "ExcessiveScroll")):
            item[chave] = soma(numero(x.get("subTotal")) for x in _metrica(r, nome))
        eng = _metrica(r, "EngagementTime")
        item["tempo_total_s"] = soma(numero(x.get("totalTime")) for x in eng)
        item["tempo_ativo_s"] = soma(numero(x.get("activeTime")) for x in eng)
        prof = [numero(x.get("averageScrollDepth")) for x in _metrica(r, "ScrollDepth")]
        prof = [p for p in prof if p is not None]
        item["scroll_depth_media_pct"] = round(sum(prof) / len(prof), 2) if prof else None
        serie.append(item)

    urls_linhas = [r for r in cl.registros if r.get("dimensoes") == ["URL"]]
    top_urls = None
    if urls_linhas:
        r = urls_linhas[-1]
        dead = {x.get("Url"): numero(x.get("subTotal")) for x in _metrica(r, "DeadClickCount")}
        itens = []
        for x in _metrica(r, "Traffic"):
            url = x.get("Url")
            if not url:
                continue
            itens.append({
                "url": url, "sessoes": numero(x.get("totalSessionCount")) or 0,
                "sessoes_bot": numero(x.get("totalBotSessionCount")),
                "usuarios_distintos": numero(x.get("distinctUserCount")),
                "dead_clicks": dead.get(url),
            })
        itens.sort(key=lambda i: (-i["sessoes"], i["url"]))
        top_urls = {"coletado_em": r.get("coletado_em"), "janela_dias": numero(r.get("janela_dias")),
                    "itens": itens[:TOP_N]}

    ressalvas = [
        "Clarity entrega JANELA deslizante de `janela_dias` dias coletada no dia D (dimensão Device): "
        "não é 'sessões por dia' e não se soma entre dias. Cada ponto é a janela inteira.",
        "dead/rage/quickback = Σ `subTotal` das dimensões Device; `sessoes_bot` é a contagem do próprio Clarity.",
    ]
    if top_urls is None:
        ressalvas.append("Linha com dimensão URL ausente: top URLs " + SEM_SERIE + ".")
    return {
        "schema_version": SCHEMA,
        "gerado_em": ctx.gerado_em,
        "commit": ctx.commit,
        "dias": ctx.dias,
        "fontes": {"clarity": ctx.rel("clarity")},
        "janelas": serie,
        "top_urls": top_urls,
        "ressalvas": ressalvas,
    }


def le_fila(ctx: Contexto) -> dict:
    caminho = os.path.join(ctx.raiz, FONTES["fila"])
    if not os.path.isfile(caminho):
        return {"disponivel": False, "motivo": "arquivo ausente", "por_tipo_estado": []}
    try:
        con = sqlite3.connect("file:%s?mode=ro" % caminho, uri=True, timeout=5)
        try:
            linhas = con.execute(
                "select tipo, estado, count(*) from tarefa group by 1, 2 order by 1, 2").fetchall()
        finally:
            con.close()
    except sqlite3.Error as erro:
        return {"disponivel": False, "motivo": "sqlite: %s" % erro, "por_tipo_estado": []}
    return {"disponivel": True, "motivo": None,
            "por_tipo_estado": [{"tipo": t, "estado": e, "n": n} for t, e, n in linhas]}


def secao_cerebro(ctx: Contexto) -> dict:
    il = ctx.fonte("ia_local")
    por_dia: dict[str, dict] = {}
    taxa: dict[tuple, dict] = {}
    for r in il.registros:
        d = r.get("date") or str(r.get("ts") or "")[:10]
        if not ctx.na_janela(d):
            continue
        e = por_dia.setdefault(d, {"date": d, "lotes": 0, "itens": 0, "segundos_maquina": 0.0,
                                   "erros": 0, "por_tipo": {}})
        tipo = str(r.get("tipo") or "")
        lote = numero(r.get("lote")) or 0
        seg = numero(r.get("custo_segundos_maquina"))
        if seg is None:
            seg = (numero(r.get("parede_ms")) or 0) / 1000.0
        ok = r.get("resultado") == "ok"
        e["lotes"] += 1
        e["itens"] += lote
        e["segundos_maquina"] += seg
        if not ok:
            e["erros"] += 1
        pt = e["por_tipo"].setdefault(tipo, {"itens": 0, "segundos_maquina": 0.0})
        pt["itens"] += lote
        pt["segundos_maquina"] += seg
        modelo = str(r.get("modelo") or "")
        if ok and modelo:
            t = taxa.setdefault((tipo, modelo), {"tipo": tipo, "modelo": modelo, "lotes": 0, "itens": 0,
                                                 "prompt_tokens": 0, "eval_tokens": 0, "segundos": 0.0})
            t["lotes"] += 1
            t["itens"] += lote
            t["prompt_tokens"] += numero(r.get("prompt_tokens")) or 0
            t["eval_tokens"] += numero(r.get("eval_tokens")) or 0
            t["segundos"] += (numero(r.get("parede_ms")) or 0) / 1000.0
    serie = []
    for d in ctx.datas:
        if d in por_dia:
            e = por_dia[d]
            e["segundos_maquina"] = round(e["segundos_maquina"], 1)
            for pt in e["por_tipo"].values():
                pt["segundos_maquina"] = round(pt["segundos_maquina"], 1)
            serie.append(e)
    taxas = []
    for t in sorted(taxa.values(), key=lambda t: (t["tipo"], t["modelo"])):
        seg = t["segundos"]
        taxas.append({
            **t, "segundos": round(seg, 1),
            "tok_s_total": razao(t["prompt_tokens"] + t["eval_tokens"], seg, 2),
            "prompt_tok_s": razao(t["prompt_tokens"], seg, 2),
            "eval_tok_s": razao(t["eval_tokens"], seg, 2) if t["eval_tokens"] else None,
            "segundos_por_item": razao(seg, t["itens"], 2),
        })
    tipos = sorted({tipo for e in serie for tipo in e["por_tipo"]})
    ressalvas = [
        "itens = Σ `lote` por dia (páginas embutidas, acórdãos extraídos…); segundos-máquina = Σ "
        "`custo_segundos_maquina` (parede do lote). Lotes com `resultado` ≠ ok contam em `erros` e "
        "ficam fora das taxas.",
        "tok/s = Σ tokens ÷ Σ segundos de parede por (tipo, modelo) — média ponderada, não média das "
        "taxas por lote. Embeddings têm eval_tokens = 0 por natureza; `eval_tok_s` só existe quando houve geração.",
        "fila = `select tipo, estado, count(*) from tarefa` em data/ai/fila.sqlite (mode=ro), estado no "
        "instante da geração — não é série.",
    ]
    return {
        "schema_version": SCHEMA,
        "gerado_em": ctx.gerado_em,
        "commit": ctx.commit,
        "dias": ctx.dias,
        "fontes": {"ia_local": ctx.rel("ia_local"), "fila": ctx.rel("fila")},
        "tipos": tipos,
        "por_dia": serie,
        "taxa_por_modelo": taxas,
        "fila": le_fila(ctx),
        "ressalvas": ressalvas,
    }


TABELAS_SOCIAL = ("perfis", "duvidas", "respostas", "posts_blog", "follows")


def contagens_social(ctx: Contexto) -> dict:
    caminho = os.path.join(ctx.raiz, FONTES["social_db"])
    saida = {"disponivel": False, "motivo": None, "contagens": {t: None for t in TABELAS_SOCIAL}}
    if not os.path.isfile(caminho):
        saida["motivo"] = "arquivo ausente"
        return saida
    try:
        con = sqlite3.connect("file:%s?mode=ro" % caminho, uri=True, timeout=5)
    except sqlite3.Error as erro:
        saida["motivo"] = "sqlite: %s" % erro
        return saida
    try:
        existentes = {n for (n,) in con.execute("select name from sqlite_master where type='table'")}
        for t in TABELAS_SOCIAL:
            if t not in existentes:
                continue
            try:
                saida["contagens"][t] = con.execute('select count(*) from "%s"' % t).fetchone()[0]
            except sqlite3.Error as erro:
                saida["motivo"] = "sqlite em %s: %s" % (t, erro)
        saida["disponivel"] = True
    except sqlite3.Error as erro:
        saida["motivo"] = "sqlite: %s" % erro
    finally:
        con.close()
    return saida


