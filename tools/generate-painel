class Fonte:
    """Um arquivo JSONL lido inteiro, com o estado que o painel declara."""

    def __init__(self, raiz: str, rel: str):
        self.rel = rel
        self.caminho = os.path.join(raiz, rel)
        self.existe = os.path.isfile(self.caminho)
        self.registros: list[dict] = []
        self.invalidas = 0
        self.mtime = None
        if not self.existe:
            return
        self.mtime = dt.datetime.fromtimestamp(
            os.path.getmtime(self.caminho), dt.timezone.utc).isoformat(timespec="seconds")
        with open(self.caminho, encoding="utf-8") as handle:
            for bruto in handle:
                bruto = bruto.strip()
                if not bruto:
                    continue
                try:
                    registro = json.loads(bruto)
                except json.JSONDecodeError:
                    self.invalidas += 1
                    continue
                if isinstance(registro, dict):
                    self.registros.append(registro)
                else:
                    self.invalidas += 1

    def estado(self) -> dict:
        return {
            "arquivo": self.rel,
            "existe": self.existe,
            "linhas": len(self.registros),
            "linhas_invalidas": self.invalidas,
            "mtime": self.mtime,
        }


def ultima_por_chave(registros, chave):
    """Convenção dos ledgers append-only: a ÚLTIMA linha de uma chave vence."""
    saida = {}
    for r in registros:
        k = chave(r)
        if k is None:
            continue
        saida[k] = r
    return saida


def numero(v):
    """Número ou None — string numérica do Bing vira número; lixo vira None."""
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return v
    if isinstance(v, str):
        s = v.strip()
        if not s or s.lower() == "none":
            return None
        try:
            return int(s)
        except ValueError:
            try:
                return float(s)
            except ValueError:
                return None
    return None


def soma(valores):
    """Soma ignorando None; devolve None quando NENHUM valor existe."""
    presentes = [v for v in valores if v is not None]
    if not presentes:
        return None
    return sum(presentes)


def razao(num, den, casas=4):
    if num is None or den is None or den == 0:
        return None
    return round(num / den, casas)


def commit_atual(raiz: str) -> str:
    try:
        saida = subprocess.run(
            ["git", "-C", raiz, "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        return "sem-git"
    if saida.returncode != 0 or not saida.stdout.strip():
        return "sem-git"
    return saida.stdout.strip()


class Contexto:
    def __init__(self, raiz: str, hoje: dt.date, dias: int, commit: str):
        self.raiz = raiz
        self.hoje = hoje
        self.hoje_iso = hoje.isoformat()
        self.dias = dias
        self.datas = [(hoje - dt.timedelta(days=i)).isoformat() for i in range(dias - 1, -1, -1)]
        self.commit = commit
        self.gerado_em = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        self._fontes: dict[str, Fonte] = {}
        self.ressalvas: list[str] = []
        self.ultimo_dia_completo = (hoje - dt.timedelta(days=1)).isoformat()

    def fonte(self, nome: str) -> Fonte:
        if nome not in self._fontes:
            self._fontes[nome] = Fonte(self.raiz, FONTES[nome])
        return self._fontes[nome]

    def rel(self, nome: str) -> str:
        return FONTES[nome]

    def na_janela(self, data) -> bool:
        return isinstance(data, str) and self.datas[0] <= data <= self.datas[-1]

    def estados(self) -> list[dict]:
        saida = []
        for nome, rel in FONTES.items():
            caminho = os.path.join(self.raiz, rel)
            if rel.endswith(".jsonl"):
                saida.append(self.fonte(nome).estado())
            else:
                existe = os.path.isfile(caminho)
                saida.append({
                    "arquivo": rel, "existe": existe, "linhas": None, "linhas_invalidas": None,
                    "mtime": dt.datetime.fromtimestamp(os.path.getmtime(caminho), dt.timezone.utc)
                    .isoformat(timespec="seconds") if existe else None,
                })
        return saida


