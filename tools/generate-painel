def _fmt_grande(v) -> str:
    """Projeção pode passar de 1e9 (extrapolação de série em rampa): notação
    científica em vez de uma fila de pontos de milhar."""
    if v is None:
        return "—"
    if isinstance(v, (int, float)) and not isinstance(v, bool) and abs(v) >= 1e9:
        return "%.2e" % v
    return compacto(v)


def _ic_txt(par, casas=1) -> str:
    if not par or len(par) != 2:
        return "—"
    return "%s a %s" % (fmt_dec(par[0], casas), fmt_dec(par[1], casas))


def html_previsao(p: dict) -> str:
    """Só lê o que tools/generate-previsao-audiencia gravou; por série: último
    valor, taxa semanal com IC e as três projeções, em texto e em tabela."""
    if not p["disponivel"]:
        return '<p class="vazio">ainda sem previsão: %s <span class="fonte">%s</span></p>' % (
            esc(p["motivo"]), esc(p["arquivo"]))
    d = p["dados"]
    series = {k: v for k, v in d["series"].items() if isinstance(v, dict)}
    janela = d.get("janela") or {}
    cab = ('<p class="nota">gerado_em %s · janela de %s dia(s) (%s → %s) · último dia completo %s · modelo: %s '
           '<span class="fonte">%s</span></p>'
           % (esc(d.get("gerado_em")), esc(d.get("janela_dias")), esc(janela.get("inicio")), esc(janela.get("fim")),
              esc(d.get("ultimo_dia_completo")), esc(d.get("modelo")), esc(p["arquivo"])))
    kpis = []
    for nome in PREVISAO_EM_DESTAQUE:
        s = series.get(nome)
        if s is None:
            continue
        pv = s.get("previsao") or {}
        if pv:
            valor = fmt_pct(s.get("taxa_semanal_pct")) + " / semana"
            nota = "IC80 %s · 30 d ≈ %s" % (_ic_txt(s.get("ic80")), _fmt_grande((pv.get("30") or {}).get("ponto")))
        else:
            valor = "—"
            nota = str(s.get("motivo") or "")
        kpis.append(tile(nome, valor, p["arquivo"], nota))
    frases = []
    for nome, s in series.items():
        pv = s.get("previsao") or {}
        if pv:
            partes = []
            for h in ("30", "90", "180"):
                item = pv.get(h) or {}
                partes.append("%s d (%s) ≈ %s [IC80 %s]" % (
                    h, esc(item.get("data")), _fmt_grande(item.get("ponto")),
                    _ic_txt(item.get("ic80"), 0) if item.get("ic80") and all(
                        isinstance(x, (int, float)) for x in item["ic80"]) else "—"))
            frases.append("<li><strong>%s</strong>: último %s em %s; taxa semanal %s (IC80 %s; IC95 %s); %s; r² %s.</li>"
                          % (esc(nome), _fmt_grande(s.get("ultimo_valor")), esc(s.get("ultimo_dia")),
                             fmt_pct(s.get("taxa_semanal_pct")), _ic_txt(s.get("ic80")), _ic_txt(s.get("ic95")),
                             "; ".join(partes), fmt_dec(s.get("r2"), 2)))
        else:
            frases.append("<li><strong>%s</strong>: %s — %s (n = %s, último %s em %s).</li>"
                          % (esc(nome), esc(s.get("motivo")), esc(s.get("detalhe")), esc(s.get("n")),
                             _fmt_grande(s.get("ultimo_valor")), esc(s.get("ultimo_dia"))))
    texto = "<ul>%s</ul>" % "".join(frases)
    linhas = []
    for nome, s in series.items():
        pv = s.get("previsao") or {}
        linhas.append([nome, s.get("n"), s.get("ultimo_dia"), _fmt_grande(s.get("ultimo_valor")),
                       s.get("taxa_semanal_pct"), _ic_txt(s.get("ic80")), _ic_txt(s.get("ic95")),
                       _fmt_grande((pv.get("30") or {}).get("ponto")), _fmt_grande((pv.get("90") or {}).get("ponto")),
                       _fmt_grande((pv.get("180") or {}).get("ponto")), s.get("r2"), s.get("motivo")])
    tab = tabela(["série", "n", "último dia", "último valor", "taxa/sem %", "IC80 da taxa", "IC95 da taxa",
                  "30 d", "90 d", "180 d", "r² (log)", "motivo"], linhas,
                 "Tabela por série (ponto = mediana condicional; %s séries)" % len(linhas))
    meta = d.get("areas_meta") or {}
    ja = meta.get("janela") or {}
    itens_areas = [a for a in (d.get("areas") or []) if isinstance(a, dict)][:TOP_N]
    areas = tabela(["#", "área", "páginas", "leituras 14 d", "por página", "fator", "valor esperado", "por agente"],
                   [[a.get("posicao"), a.get("area"), a.get("paginas_publicadas"), a.get("leituras_14d"),
                     a.get("leituras_por_pagina"), meta.get("fator"), a.get("valor_esperado"),
                     ", ".join("%s %s" % (k, v) for k, v in list((a.get("por_agente") or {}).items())[:3])]
                    for a in itens_areas],
                   "Top %d áreas por valor esperado (%s → %s; leituras × (1 + taxa de %s), fator %s)"
                   % (TOP_N, ja.get("inicio"), ja.get("fim"), meta.get("fator_serie"), fmt_dec(meta.get("fator"), 4)))
    if not areas:
        areas = '<p class="vazio">áreas: %s</p>' % esc(meta.get("motivo") or SEM_SERIE)
    return '%s<div class="kpis">%s</div>%s%s%s%s' % (
        cab, "".join(kpis), texto, tab, areas, lista_ressalvas(d.get("ressalvas") or []))


