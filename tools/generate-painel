PREVISAO_SCHEMA = "previsao_v1"
PREVISAO_EM_DESTAQUE = ("borda.organic_requests", "borda.uniques", "bots.total", "bing.impressions")


def le_previsao(ctx: Contexto) -> dict:
    """data/ops/painel/previsao.json é escrito por tools/generate-previsao-audiencia
    --gravar (unit wikijuridica-previsao, 07:10 UTC) — o painel só LÊ. Ausente
    ou ilegível vira "ainda sem previsão" com o motivo, nunca zero."""
    if "_previsao" in ctx.__dict__:
        return ctx._previsao
    caminho = os.path.join(ctx.raiz, FONTES["previsao"])
    saida = {"disponivel": False, "motivo": None, "dados": None, "arquivo": FONTES["previsao"]}
    if not os.path.isfile(caminho):
        saida["motivo"] = ("arquivo ausente — tools/generate-previsao-audiencia --gravar ainda não rodou "
                           "(unit wikijuridica-previsao.timer, 07:10 UTC)")
    else:
        dados = None
        try:
            with open(caminho, encoding="utf-8") as handle:
                dados = json.load(handle)
        except (OSError, ValueError) as erro:
            saida["motivo"] = "arquivo ilegível: %s" % erro
        if dados is not None:
            if not isinstance(dados, dict) or dados.get("schema_version") != PREVISAO_SCHEMA:
                saida["motivo"] = "schema_version %r, esperado %r" % (
                    dados.get("schema_version") if isinstance(dados, dict) else type(dados).__name__, PREVISAO_SCHEMA)
            elif not isinstance(dados.get("series"), dict):
                saida["motivo"] = "objeto sem o campo `series`"
            else:
                saida["disponivel"] = True
                saida["dados"] = dados
    ctx._previsao = saida
    return saida


def resumo_previsao(p: dict) -> dict:
    dados = p["dados"] or {}
    series = dados.get("series") or {}
    return {
        "disponivel": p["disponivel"],
        "motivo": p["motivo"],
