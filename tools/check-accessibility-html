#!/usr/bin/env bash
# check-accessibility-html — auditoria READ-ONLY de acessibilidade e semântica do
# HTML público (WCAG 2.2 A/AA + ARIA Landmarks). Não escreve nada em disco.
# Exit 1 quando há achado de gravidade >= --fail-on (padrão IMPORTANTE).
#
# Audita o HTML REAL renderizado pelo caminho de produção de internal/render,
# incluindo o TEMPLATE das páginas jurídicas do acervo v2 — que não está em
# content/pages.json e por isso escapa de qualquer check que varra só public/.
#
#   tools/check-accessibility-html
#   tools/check-accessibility-html --json
#   tools/check-accessibility-html --fail-on MELHORIA
#   tools/check-accessibility-html --url http://127.0.0.1:8089/
#   tools/check-accessibility-html --file public/index.html
#
# O motor vive em internal/accessibilityaudit e é o MESMO que o gate
# "accessibility-html" de internal/checks executa (./tools/go-modern run
# ./cmd/check accessibility-html). Este wrapper é o modo de DIAGNÓSTICO: mostra
# achado por documento, aceita --file/--url e permite baixar o limiar até
# MELHORIA. O gate usa o limiar fixo IMPORTANTE.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

exec nice -n 10 "$ROOT/tools/go-modern" run ./cmd/check-accessibility-html --root "$ROOT" "$@"
