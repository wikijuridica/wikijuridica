#!/usr/bin/env python3
"""check-nginx-log-vivo — o log que a config declara e o que esta sendo escrito.

READ-ONLY. Exit 1 quando o `access_log` da config EFETIVA do nginx aponta para um
arquivo que nao esta sendo escrito, ou quando um fragmento de config nao-carregado
declara um caminho diferente e passa a enganar quem o le.

O PRECEDENTE, de 2026-08-27, e uma conclusao errada e grave: *"o Googlebot fez
ZERO requisicoes em 8 dias"*. Era falsa -- ele rastreia todo dia, 21 a 33
requisicoes verificadas pela Cloudflare, e o bingbot faz de 160 a 672.

O erro comecou por ler o ledger do processo Go para responder sobre o acervo, que
o nginx serve estatico (armadilha A2, ja catalogada). Mas ao ir buscar o log do
nginx para corrigir, o caminho obvio DENTRO do repositorio estava morto:

    var/nginx/wikijuridica.access.log        48 KB, mtime 2026-08-06
    /var/log/nginx/wikijuridica/access.log   8,5 MB, escrito agora

Porque `ops/nginx/standalone/server.conf`, que declara o primeiro em duas linhas,
NAO E CARREGADO: a unit executa `nginx -c .../nginx.conf`, e o nginx.conf declara
o segundo. `server.conf` e fragmento historico -- config que mente, na forma que
o R1 do Contrato do Dado Real proibe.

Dois arquivos com o mesmo assunto e caminhos diferentes, um deles vivo: quem
abre o errado mede o vazio e conclui ausencia. Este gate existe para que a
proxima pessoa (ou o proximo agente) nao repita.
"""

import os
import re
import subprocess
import sys
import time

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
UNIT = "wikijuridica-nginx"
# Se a config efetiva escreve, ela tem de ter escrito no ultimo dia -- o portal
# recebe trafego continuo, inclusive de bot verificado.
IDADE_MAXIMA_SEGUNDOS = 26 * 3600


def config_efetiva():
    """O arquivo que a unit realmente passa ao nginx com -c."""
    try:
        saida = subprocess.run(["systemctl", "cat", UNIT],
                               capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return None
    achado = re.search(r"ExecStart=.*?-c\s+(\S+)", saida)
    return achado.group(1) if achado else None


def caminhos_declarados(conf):
    """Todo `access_log <caminho>` de um arquivo de config."""
    try:
        with open(conf, encoding="utf-8", errors="replace") as arquivo:
            texto = arquivo.read()
    except OSError:
        return []
    caminhos = []
    for linha in texto.splitlines():
        limpa = linha.strip()
        if limpa.startswith("#"):
            continue
        achado = re.match(r"access_log\s+(\S+)", limpa)
        if achado and achado.group(1) not in ("off",):
            caminhos.append(achado.group(1))
    return caminhos


def main() -> int:
    problemas = []
    conf = config_efetiva()
    if not conf:
        print("check-nginx-log-vivo: SKIP (nao consegui ler a unit %s)" % UNIT)
        return 0
    print("config efetiva (a que a unit passa com -c): %s" % conf)

    efetivos = sorted(set(caminhos_declarados(conf)))
    if not efetivos:
        problemas.append("a config efetiva nao declara nenhum access_log")

    agora = time.time()
    for caminho in efetivos:
        if not os.path.exists(caminho):
            problemas.append("%s: declarado na config efetiva e NAO EXISTE" % caminho)
            continue
        idade = agora - os.path.getmtime(caminho)
        tamanho = os.path.getsize(caminho)
        estado = "vivo" if idade <= IDADE_MAXIMA_SEGUNDOS else "PARADO"
        print("  %-46s %10d bytes  escrito ha %5.1f h  %s"
              % (caminho, tamanho, idade / 3600, estado))
        if idade > IDADE_MAXIMA_SEGUNDOS:
            problemas.append("%s: declarado na config efetiva mas parado ha %.0f h"
                             % (caminho, idade / 3600))

    # FRAGMENTO QUE ENGANA: outro arquivo de config no repositorio declarando um
    # access_log DIFERENTE do efetivo. Ele nao quebra o servico -- quebra quem o
    # le procurando o log.
    diretorio = os.path.dirname(os.path.abspath(conf))
    for nome in sorted(os.listdir(diretorio)):
        outro = os.path.join(diretorio, nome)
        if not nome.endswith(".conf") or os.path.abspath(outro) == os.path.abspath(conf):
            continue
        # ARQUIVO EXPLICITAMENTE MARCADO como nao-carregado nao reprova SOZINHO --
        # o repositorio ja usa esse marcador e ele e honesto. O que reprova e o
        # marcador CONVIVER com um caminho de log que nao existe ou esta parado:
        # foi exatamente essa combinacao que enganou em 2026-08-27, porque quem
        # procura um caminho le o caminho, nao o cabecalho.
        try:
            with open(outro, encoding="utf-8", errors="replace") as arquivo:
                marcado = "NAO-CARREGADO-EM-PRODUCAO" in arquivo.read(4096)
        except OSError:
            marcado = False
        divergentes = []
        for c in caminhos_declarados(outro):
            if c in efetivos:
                continue
            if marcado and os.path.exists(c) and (agora - os.path.getmtime(c)) <= IDADE_MAXIMA_SEGUNDOS:
                continue
            divergentes.append(c)
        if divergentes:
            problemas.append(
                "%s declara access_log que a config efetiva NAO usa (%s): fragmento "
                "nao-carregado manda quem o le para o arquivo errado"
                % (os.path.relpath(outro, RAIZ), ", ".join(sorted(set(divergentes)))))

    if not problemas:
        print("check-nginx-log-vivo: OK (o log declarado e o que esta sendo escrito)")
        return 0
    print("check-nginx-log-vivo: FAIL")
    for p in problemas:
        print("  - %s" % p)
    print("  Config que aponta para log morto nao quebra o servico: quebra a MEDICAO.")
    print("  Em 2026-08-27 isso produziu a conclusao falsa de que o Googlebot nao rastreava.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
