#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:external-dedupe-oracle:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/external_dedupe_oracle.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-external-dedupe-oracle}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/external_dedupe_oracle.jsonl}"
cd "$ROOT"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-external-dedupe-oracle --timings "$@"
