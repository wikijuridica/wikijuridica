#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""generate-wave1-quality-hold.

Emite a hold-list da PRIMEIRA ONDA de publicacao: paginas que passam em todos
os gates, mas que nao devem estrear o dominio.

## Por que segurar paginas validas

Nao e reprovacao — e sequenciamento. As paginas listadas aqui sao VALIDAS: elas
atravessam anti-template, paid-intent, compatibilidade contextual e revisao
juridico-editorial. O motivo de segura-las e outro:

O dominio nunca teve pagina publica. Num dominio sem historico, a primeira
impressao de rastreamento E a avaliacao do site. A politica oficial de spam do
Google define scaled content abuse por PROPOSITO E VALOR — nao por volume, nem
por ritmo de publicacao, nem por data uniforme (nao existe uma linha oficial
sobre "publicar N por semana"; quem afirma isso cita folclore de SEO). O risco
real e outro: subir junto a fracao mais fraca do acervo dilui o julgamento de
valor exatamente na janela em que ele e formado.

Some-se a isso que o conteudo e YMYL e leva o nome e a inscricao OAB do autor
em cada pagina: a coorte fraca e onde um fiscal, um concorrente ou um rater
olharia primeiro.

## Os tres criterios (todos medidos, nenhum herdado)

1. `word_count < 400` — nao e "thin content" pela regra do Google, que declara
   textualmente nao ter contagem de palavras preferida. E uma barra editorial
   interna, prudente para a estreia. (1.130 paginas na coorte)
2. `len(official_sources) < 2` — viola o proprio contrato do repo (`fontes_min`)
   e o art. 3o, II do Provimento OAB 205/2021 fica mais exposto quando a
   sustentacao e fraca. (0 na coorte: o gate de fonte ja as excluira antes)
3. Ancora de fonte AUTORREFERENTE — `anchor_claim` que descreve a norma em vez
   da afirmacao que ela sustenta ("texto oficial vigente da norma no Planalto",
   "identificada pela URN LexML"). Sao 654 paginas no acervo, 103 dentro da
   coorte pronta. A proveniencia e a UNICA camada que nenhum detector
   anti-template varre — os seis medem corpo —, e e justamente onde o portal
   afirma ao leitor, ao Google e a OAB "isto foi verificado". Ancora que nao
   nomeia a afirmacao nao sustenta nada.

Estas paginas voltam assim que reparadas: as de fonte pelo resolvedor de
proveniencia, as curtas por ampliacao editorial. A hold-list e fila de reparo,
nao cemiterio.

## Formato

Compativel com `data/ops/promote_hold_20260722.jsonl` e com
`cmd/check-promote-hold-intersection`: um objeto por linha com
`intent_id`, `shard`, `reason`. Read-only sobre o acervo; so escreve o proprio
artefato de saida. NAO committa.
"""

from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PAGES_DIR = ROOT / "data/editorial/v2_pages"
OUT = ROOT / "data/ops/wave1_quality_hold_20260805.jsonl"

MIN_WORDS = 400
MIN_SOURCES = 2

# Textos de anchor_claim que descrevem a NORMA em vez da afirmacao sustentada.
SELF_REFERENTIAL = (
    "texto oficial vigente da norma no planalto",
    "identificada pela urn lexml",
    "portal oficial consolidado",
)


def atomic_write(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def self_referential_anchor(sources: list) -> bool:
    for source in sources:
        claim = (source.get("anchor_claim") or "").strip().lower()
        if not claim:
            return True
        if any(term in claim for term in SELF_REFERENTIAL):
            return True
    return False


def main() -> int:
    if not PAGES_DIR.is_dir():
        print(f"generate-wave1-quality-hold: {PAGES_DIR} ausente", file=sys.stderr)
        return 1

    held: list[dict] = []
    counts = {"short": 0, "sources": 0, "anchor": 0}
    scanned = 0

    for shard in sorted(PAGES_DIR.glob("*.jsonl")):
        for line in shard.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            record = json.loads(line)
            # Tombstone nao tem corpo: nao e pagina, nao entra na conta.
            if not record.get("sections"):
                continue
            scanned += 1
            intent = record.get("intent_id") or ""
            sources = record.get("official_sources") or []
            words = record.get("word_count") or 0

            reason = ""
            if words < MIN_WORDS:
                reason = f"wave1-abaixo-de-{MIN_WORDS}-palavras:{words}"
                counts["short"] += 1
            elif len(sources) < MIN_SOURCES:
                reason = f"wave1-fontes-insuficientes:{len(sources)}"
                counts["sources"] += 1
            elif self_referential_anchor(sources):
                reason = "wave1-ancora-de-fonte-autorreferente"
                counts["anchor"] += 1

            if reason:
                held.append({"intent_id": intent, "shard": shard.name, "reason": reason})

    held.sort(key=lambda item: item["intent_id"])
    payload = "".join(json.dumps(item, ensure_ascii=False, sort_keys=True) + "\n" for item in held)
    atomic_write(OUT, payload.encode("utf-8"))

    print(f"paginas varridas:            {scanned}")
    print(f"seguradas na onda 1:         {len(held)}")
    print(f"  abaixo de {MIN_WORDS} palavras:  {counts['short']}")
    print(f"  menos de {MIN_SOURCES} fontes:       {counts['sources']}")
    print(f"  ancora autorreferente:     {counts['anchor']}")
    print(f"liberadas para a onda 1:     {scanned - len(held)}")
    print(f"escrito: {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
