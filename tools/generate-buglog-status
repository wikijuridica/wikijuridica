#!/usr/bin/env python3
"""generate-buglog-status — reconcilia a linha `- **Status:**` de cada bug do
BUGLOG com o estado REAL do frontboard.

★ POR QUE ESTE GERADOR EXISTE (2026-08-29).

O BUGLOG e o registro narrativo dos defeitos; o frontboard
(`.agents/runtime/p0_frontboard.jsonl`) e o estado operacional. Os dois eram
atualizados A MAO, e por isso divergiam — medido hoje: **31 linhas do BUGLOG
diziam "aberto" para bug JA FECHADO**, inclusive para dez que a varredura de
vivacidade derrubou por medicao e para seis fechados por refutacao.

Isso e o proprio BUG-125, e ele nao se resolve editando as 31 linhas: elas
divergem de novo na proxima sessao. A causa e nao haver produtor unico.

O frontboard e a FONTE: ele e append-only, cada linha carrega a evidencia do
desfecho, e e ele que as tasks leem. O BUGLOG passa a ser derivado quanto ao
STATUS — a narrativa (sintoma, causa raiz, correcao) continua sendo escrita a
mao, que e onde ela tem valor.

CONVENCAO DO REPOSITORIO: `tools/generate-*` ESCREVE, `tools/check-*` e
read-only. O par deste arquivo e `tools/check-buglog-status-coerente`, que
reprova a divergencia sem consertar.

  tools/generate-buglog-status            # aplica
  tools/generate-buglog-status --seco     # so mostra o que mudaria
"""
import io
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BUGLOG = os.path.join(RAIZ, "docs", "goal", "BUGLOG.md")
FRONTBOARD = os.path.join(RAIZ, ".agents", "runtime", "p0_frontboard.jsonl")

CABECALHO = re.compile(r"^##\s+(BUG-[A-Za-z0-9]+)\b")
STATUS = re.compile(r"^-\s+\*\*Status:\*\*")

# Como cada desfecho do frontboard se le no BUGLOG. O texto diz o que o leitor
# precisa saber para NAO reabrir a investigacao: bug morto por medicao nunca
# teve correcao, e bug refutado nao deve ser executado como escrito.
FRASE = {
    "fechado": "corrigido e commitado",
    "morto_por_medicao": "MORTO POR MEDICAO — a afirmacao nao se sustentava no dado; nao houve correcao",
    "refutado": "REFUTADO — o codigo faz isto de proposito; executar o enunciado REVERTERIA trabalho",
    "reescopado": "REESCOPADO — parte morreu, parte segue aberta com escopo menor",
    "causa_raiz_encontrada": "aberto, com a CAUSA-RAIZ ja identificada",
    "parcial": "parcial",
}


def estado_do_frontboard():
    estado = {}
    with io.open(FRONTBOARD, encoding="utf-8") as f:
        for linha in f:
            linha = linha.strip()
            if not linha:
                continue
            try:
                registro = json.loads(linha)
            except ValueError:
                continue
            bug = registro.get("bug")
            if bug and str(bug).startswith("BUG-"):
                estado[bug] = registro  # append-only: a ultima linha vence
    return estado


# ★ FECHO NAO E "TUDO QUE NAO E todo" (corrigido em 2026-08-30).
#
# A primeira versao classificava com `status == "todo"` de um lado e TODO O
# RESTO do outro. O frontboard usa treze status distintos, e `parcial`,
# `in_progress`, `queued`, `open` e `bloqueado` sao trabalho ABERTO. O efeito
# apareceu na primeira vez que o gerador rodou contra bug parcial: ele queria
# reescrever "aberto quanto a lentidao — 611 s continua caro" como "fechado",
# apagando a divida do registro. Gate que escreve mentira no registro e pior que
# gate nenhum, porque a mentira fica assinada.
STATUS_DE_FECHO = {"done", "closed", "fechado", "refutado", "derrubado", "superseded"}


def fechado_no_board(registro):
    return (registro.get("status") or "").strip().lower() in STATUS_DE_FECHO


def afirma_o_contrario(linha, registro):
    """Diz se a linha do BUGLOG contradiz o estado do frontboard.

    Fechado no frontboard e a linha dizendo "aberto" (sem negacao), ou aberto no
    frontboard e a linha dizendo "fechado"/"corrigido". Qualquer outra diferenca
    e redacao, e redacao nao se sobrescreve.
    """
    texto = linha.lower()
    aberto_no_board = not fechado_no_board(registro)
    diz_fechado = any(p in texto for p in ("fechado", "corrigido", "resolvido", "morto", "refutado"))
    # "aberto" tem de ser palavra, para nao casar dentro de outra
    diz_aberto = re.search(r"\baberto\b|\bparcial(?:mente)?\b|\bsegue\s+aberta\b|\bem\s+curso\b", texto) is not None
    if aberto_no_board:
        return diz_fechado and not diz_aberto
    return diz_aberto and not diz_fechado


def linha_de_status(bug, registro):
    status = registro.get("status") or ""
    desfecho = registro.get("desfecho") or ""
    if not fechado_no_board(registro):
        extra = FRASE.get(desfecho)
        corpo = extra if extra else "aberto"
        if not extra:
            corpo = "aberto — task `caca-%s` no frontboard. PASSO ZERO: reproduzir a medição antes de corrigir." % bug
        return "- **Status:** %s" % corpo
    frase = FRASE.get(desfecho, "fechado")
    commit = str(registro.get("commit") or "").strip()
    if commit:
        return "- **Status:** %s (commit `%s`)" % (frase, commit)
    return "- **Status:** %s" % frase


def main():
    seco = "--seco" in sys.argv
    estado = estado_do_frontboard()
    with io.open(BUGLOG, encoding="utf-8") as f:
        linhas = f.read().split("\n")

    atual = None
    trocas = []
    for i, linha in enumerate(linhas):
        cabecalho = CABECALHO.match(linha)
        if cabecalho:
            atual = cabecalho.group(1)
            continue
        if atual and STATUS.match(linha):
            registro = estado.get(atual)
            if not registro:
                atual = None
                continue
            # ★ SO TROCA O QUE ESTA FACTUALMENTE ERRADO.
            #
            # A primeira versao reescrevia TODA linha de status que diferisse do
            # texto derivado — e o --seco mostrou o estrago antes de acontecer:
            # 118 linhas seriam trocadas, e a maioria delas carrega narrativa
            # que vale mais que o rotulo. Uma dizia "FECHADO — unit ja
            # Result=success apos 42c6ea40; a FONTE tambem foi corrigida:
            # paginas vem do indice", e viraria "corrigido e commitado".
            #
            # Isso destruiria informacao paga, que e o oposto do que este
            # repositorio manda fazer. O gerador so age onde o BUGLOG AFIRMA O
            # CONTRARIO DO FATO: diz aberto para bug fechado, ou fechado para
            # bug aberto. Redacao diferente nao e divergencia — e autoria.
            if not afirma_o_contrario(linha, registro):
                atual = None
                continue
            nova = linha_de_status(atual, registro)
            trocas.append((i, atual, linha.strip(), nova))
            atual = None

    if not trocas:
        print("generate-buglog-status: BUGLOG ja coerente com o frontboard")
        return 0

    print("generate-buglog-status: %d linha(s) de status divergentes" % len(trocas))
    for _, bug, antiga, nova in trocas[:12]:
        print("  %s" % bug)
        print("    antes : %s" % antiga[:110])
        print("    depois: %s" % nova[:110])
    if len(trocas) > 12:
        print("  ... e mais %d" % (len(trocas) - 12))

    if seco:
        print("(--seco: nada foi escrito)")
        return 0

    for i, _, _, nova in trocas:
        linhas[i] = nova
    with io.open(BUGLOG, "w", encoding="utf-8") as f:
        f.write("\n".join(linhas))
    print("BUGLOG atualizado: %d linhas" % len(linhas))
    return 0


if __name__ == "__main__":
    sys.exit(main())
