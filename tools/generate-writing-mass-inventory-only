#!/usr/bin/env python3
"""Converte executor de escrita com fila stale em INVENTARIO preservado.

★ POR QUE ESTA FERRAMENTA EXISTE (medido em 2026-08-30, BUG-195)

`scripts/workflows/writing-mass-todo-part1.js`, `-part2.js` e `-part3.js` eram
tres workflows EXECUTAVEIS — `agent(`, `parallel(`, `phase(` e o bloco de
resultado completo — carregando duas coisas que ninguem certificava:

1. **Fila CAS stale.** Medido lote a lote contra o shard vivo:
   part1 40/48 stale, part2 124/141, part3 51/53 — **215 de 242 pinos mortos**.
   Depois da particao por-lote de `7eacdd98`, cada lote stale e DROPADO, entao
   rodar qualquer uma delas hoje e queima de token com 27 lotes sobrando cuja
   fila nenhum registro declara.
2. **O executor congelado que DELETAVA PAGINA BOA.** As tres compartilham UM
   executor (sha 028217ed…), diferente do canonico (c820b7a6…), anterior a
   `f6149aaf` (2026-07-29). Falta nele a regra que separa "sem fonte real no
   mundo" de "defeito de sistema": sem ela o redator grava tombstone quando o
   CAS recusa por catalogo furado, o que descarta a pagina JA ESCRITA e marca a
   intencao como resolvida — perda silenciosa e permanente. Tambem faltam o
   `f6149aaf` de sandbox, o `a43e24ee` (contabilidade honesta pos-janela), o
   `62af7d94` (77/95 lotes dropados por falso-positivo) e o `0c41367d` (regex de
   fragmento `#artN`).

**O inventario NAO se descarta** — os 242 lotes sao trabalho pago. O que sai e o
executor DUPLICADO e desatualizado; o canonico vive em `writing-mass-todo.js`.
E exatamente a forma que `writing-mass-full.js`, `-resume`, `-safe`, `-zero2` e
`-zeroareas` ja tem: inventario preservado + fail-fast apontando a regeneracao.

A checagem que guarda isso e
`internal/contract/misc/writing_mass_workflow_test.go:assertFailFastWritingMassInventory`.

Uso:
    ./tools/generate-writing-mass-inventory-only <arquivo.js> [...]
    ./tools/generate-writing-mass-inventory-only --verificar <arquivo.js> [...]
"""
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
INVENTARIO = re.compile(r"const batches = (\[.*?\])\n", re.S)
FAIL_FAST = (
    "throw new Error('{nome} e inventory-only; regenere a fila CAS com "
    "ops/relaunch-writing.sh para vincular semantic_contract_sha256/"
    "semantic_relocation_removals e execute writing-mass-todo.js')"
)
PROIBIDOS = (
    "const PERSONAS =", "function ", "phase(", "pipeline(", "parallel(",
    "agent(", "await ", "return ", "flock", ".partial.jsonl", "verified_at",
    "http_status", "title: 'Escrever'",
)


def cabecalho_ja_conforme(prefixo, nome):
    """O arquivo ja tem metadata inventory-only propria e valida?

    Preservar a metadata existente importa: os cinco inventarios legados dizem
    "Inventario legado preservado ... regenere a fila CAS antes de executar",
    que descreve o papel deles com mais precisao do que qualquer texto que esta
    ferramenta sintetize. Sobrescrever seria apagar informacao correta para
    uniformizar aparencia — o oposto do que a conversao existe para fazer.
    """
    if f"name: '{nome}'" not in prefixo:
        return False
    if "nao e executor de escrita" not in prefixo:
        return False
    if "title: 'Inventario'" not in prefixo:
        return False
    return not any(proibido in prefixo for proibido in PROIBIDOS)


def converter(texto, nome):
    """Devolve o arquivo inventory-only equivalente, ou levanta ValueError."""
    achado = INVENTARIO.search(texto)
    if not achado:
        raise ValueError("sem inventario `const batches = [...]` parseavel")
    lotes = json.loads(achado.group(1))
    if not lotes:
        raise ValueError("inventario vazio: nada a preservar")
    prefixo = texto[:achado.start()]
    if cabecalho_ja_conforme(prefixo, nome):
        cabecalho = prefixo
    else:
        cabecalho = (
            "export const meta = {\n"
            f"  name: '{nome}',\n"
            "  description: 'Inventario preservado dos lotes v2; "
            "nao e executor de escrita',\n"
            "  phases: [{ title: 'Inventario', "
            "detail: 'preservado somente para auditoria; "
            "regenere a fila CAS antes de executar' }],\n"
            "}\n\n"
        )
    corpo = "const batches = " + achado.group(1) + "\n"
    return cabecalho + corpo + "\n" + FAIL_FAST.format(nome=nome) + "\n", lotes


def conferir(saida, nome):
    """Aplica a MESMA regua do gate Go antes de gravar."""
    achado = INVENTARIO.search(saida)
    if not achado:
        return "inventario gerado nao e parseavel pelo gate"
    if json.loads(achado.group(1)) == []:
        return "inventario gerado ficou vazio"
    cauda = saida[achado.end():].strip()
    esperado = FAIL_FAST.format(nome=nome)
    if cauda != esperado:
        return f"cauda divergente do gate: {cauda!r}"
    for proibido in PROIBIDOS:
        if proibido in saida:
            return f"fragmento de executor remanescente: {proibido!r}"
    if "nao e executor de escrita" not in saida:
        return "metadata nao declara o contrato inventory-only"
    if "title: 'Inventario'" not in saida:
        return "metadata nao declara a fase Inventario"
    return None


def main(argv):
    verificar = "--verificar" in argv
    alvos = [a for a in argv if not a.startswith("--")]
    if not alvos:
        print(__doc__, file=sys.stderr)
        return 2
    falhas = 0
    for alvo in alvos:
        caminho = pathlib.Path(alvo)
        if not caminho.is_absolute():
            caminho = RAIZ / alvo
        nome = caminho.name[:-3] if caminho.name.endswith(".js") else caminho.name
        texto = caminho.read_text(encoding="utf-8")
        try:
            saida, lotes = converter(texto, nome)
        except ValueError as erro:
            print(f"REPROVADO {nome}: {erro}")
            falhas += 1
            continue
        problema = conferir(saida, nome)
        if problema:
            print(f"REPROVADO {nome}: {problema}")
            falhas += 1
            continue
        if verificar:
            estado = "ja convertido" if texto == saida else "CONVERSAO PENDENTE"
            print(f"{estado}: {nome} ({len(lotes)} lotes preservados)")
            if texto != saida:
                falhas += 1
            continue
        if texto == saida:
            print(f"inalterado: {nome} ({len(lotes)} lotes)")
            continue
        caminho.write_text(saida, encoding="utf-8")
        print(f"convertido: {nome} — {len(lotes)} lotes preservados, "
              f"executor duplicado removido "
              f"({len(texto)} -> {len(saida)} bytes)")
    return 1 if falhas else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
