#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export WIKI_REPO_AWARENESS_TIMEOUT="${WIKI_REPO_AWARENESS_TIMEOUT:-30s}"
# BUG-098: o shfmt construido passa a morar em .cache/tools, ao lado de
# htmltest e muffet (BUG-067) — /tmp e limpo no boot e o binario levava um
# `go build` inteiro para voltar. O caminho legado em /tmp continua valendo
# enquanto existir, e WIKI_SHFMT_BIN vence os dois.
SHFMT_PERSISTENT_DEFAULT="$ROOT/.cache/tools/shfmt-v3.13.1"
SHFMT_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-shfmt-bin/shfmt-v3.13.1"
if [[ -n "${WIKI_SHFMT_BIN:-}" ]]; then
	SHFMT_BIN="$WIKI_SHFMT_BIN"
elif [[ -x "$SHFMT_LEGACY_DEFAULT" ]]; then
	SHFMT_BIN="$SHFMT_LEGACY_DEFAULT"
else
	SHFMT_BIN="$SHFMT_PERSISTENT_DEFAULT"
fi
if [[ ! -x "$SHFMT_BIN" ]]; then
	mkdir -p "$(dirname "$SHFMT_BIN")"
	(cd "$ROOT/tools/ci" && "$ROOT/tools/go-modern" build -o "$SHFMT_BIN" mvdan.cc/sh/v3/cmd/shfmt)
fi
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:shell-script-quality-evidence:gocache:${GOCACHE:-$HOME/.cache/go-build}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-items_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/shell_script_quality_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-shell-script-quality-evidence}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/shell_script_quality_evidence.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-180}"
WIKI_SHFMT_BIN="$SHFMT_BIN" exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-shell-script-quality-evidence --timings "$@"
