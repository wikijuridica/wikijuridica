#!/usr/bin/env python3
"""check-promise-detector — o detector de promessa OAB ainda reprova o que deve?

POR QUE EXISTE: em 2026-08-06 o detector de `promessa_oab` foi corrigido porque
bloqueava 29 páginas e as 29 eram falso positivo — onze delas com
`human_verdict: APROVADA` no próprio censo, ou seja, o detector contradizia
auditoria humana já feita. É o segundo episódio: o CLAUDE.md registra um anterior
com 46 páginas, todas inocentes.

Afrouxar um detector é fácil e some no diff. Este check existe para que a
correção seja distinguível de um gate desligado: ele roda o detector contra
frases que DEVEM reprovar (controle positivo) e contra frases que NÃO PODEM
reprovar (controle negativo), e falha se qualquer lado sair do lugar.

Promessa de resultado é vedada pelo Provimento 205/2021 da OAB e é a única
classe de defeito deste acervo com exposição legal real para o titular.

Read-only. Sem rede, sem tocar dado.

Uso:
    tools/check-promise-detector
"""
import importlib.util
import os
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
DETECTOR = os.path.join(ROOT, "tools/generate-v2-publication-severity")

# DEVEM REPROVAR. Promessa dirigida ao leitor ou feita em nome de quem escreve.
# Sem isto, a correção do falso positivo seria indistinguível de desligar o gate.
PROIBIDAS = [
    "Garantimos o êxito da sua ação contra o banco.",
    "Asseguramos a devolução integral do valor pago.",
    "Prometemos reverter a negativa em todos os casos.",
    "O resultado é garantido para quem procura o escritório.",
    "Trabalhamos com garantia de resultado na revisão do benefício.",
    "Você vai receber a indenização assim que entrar com a ação.",
    "Você receberá o valor em dobro, é certo.",
    "Com certeza você consegue a aposentadoria neste ano.",
    "Temos 100% de êxito nas ações de família.",
    "Sempre é possível reverter a decisão administrativa.",
    # ADVERSARIAIS: promessa REAL do autor numa frase que também fala de
    # terceiro. Os filtros de contexto (negação, promessa alheia) são amplos de
    # propósito; estas frases provam que amplitude não virou porta de saída.
    "Diferente dos cursos que prometem milagre, nós garantimos o êxito da sua ação.",
    "Não caia em golpe: garantimos a devolução integral do seu dinheiro.",
    "Ao contrário da publicidade enganosa de outros escritórios, aqui o resultado é garantido.",
]

# NÃO PODEM REPROVAR. Todas extraídas do acervo real ou do vocabulário jurídico
# corrente — é o texto sóbrio que o Provimento 205/2021 justamente exige.
PERMITIDAS = [
    # negação, a forma mais comum no acervo
    "A avaliação jurídica serve para escolher remédio proporcional, sem confundir chance processual com garantia de resultado.",
    "Nenhuma dessas ferramentas transforma uma pista incompleta em resultado garantido: a qualidade dos dados continua decisiva.",
    "O pedido deve apontar a falha e os elementos do caso, em vez de tratar o verbete como garantia de vitória.",
    "Pedido não tem resultado garantido e depende da prova produzida.",
    "A lei não garante que a revisão seja feita por uma pessoa natural.",
    "Organização documental sem promessa de resultado.",
    "Prioridade não é garantia de ganho de causa.",
    # promessa de TERCEIRO, descrita como objeto da análise
    "O anúncio da clínica prometia resultado garantido em quatro sessões, o que caracteriza publicidade enganosa.",
    "A garantia de êxito oferecida pelo suposto recuperador é sinal de golpe.",
    "Publicidade de advocacia não pode explorar a doença nem oferecer resultado certo.",
    # vocabulário técnico-jurídico
    "A ordem começa pelos créditos trabalhistas e segue para os créditos com garantia real.",
    "O art. 618 do Código Civil traz garantia irredutível de cinco anos quanto à solidez e segurança.",
    "O fundo garantidor de crédito cobre o valor depositado até o limite legal.",
    # enunciado de direito positivo
    "A empreitada é voltada a um resultado certo e delimitado, com entrega final.",
    # DOIS FUROS FINOS, achados ao reprocessar o acervo e fixados aqui:
    # (a) a citação literal usa primeira pessoa — é o anúncio de terceiro que
    #     fala, não o autor; a imunidade de primeira pessoa não pode valer
    #     dentro de aspas.
    'Um bootcamp de programação anuncia "garantimos sua contratação em até 6 meses após a formatura ou devolvemos 100% do investimento", sem citar condição de frequência.',
    # (b) o ponto de "art." encerrava a sentença e escondia a negação que a
    #     abria, deixando o filtro ver apenas "20 da LGPD como".
    "Formule o pedido de revisão sobre aquela decisão concreta, sem exigir abertura de segredo comercial nem tratar o art. 20 da LGPD como garantia de resultado.",
]


def carregar_detector():
    spec = importlib.util.spec_from_loader("severity", loader=None)
    modulo = importlib.util.module_from_spec(spec)
    with open(DETECTOR, encoding="utf-8") as handle:
        fonte = handle.read()
    # O arquivo é um script: corta a execução do main para importar só as
    # funções, sem rodar o censo inteiro.
    fonte = fonte.replace("sys.exit(main())", "pass")
    # O script resolve caminhos a partir de __file__, que não existe em exec().
    modulo.__dict__["__file__"] = DETECTOR
    exec(compile(fonte, DETECTOR, "exec"), modulo.__dict__)
    return modulo


def main():
    detector = carregar_detector()
    detect = detector.detect_promise

    falsos_negativos = [f for f in PROIBIDAS if not detect(f)]
    falsos_positivos = [(f, sorted(detect(f))) for f in PERMITIDAS if detect(f)]

    print("=== DETECTOR DE PROMESSA (Provimento OAB 205/2021) ===")
    print("controle POSITIVO (devem reprovar) : %d/%d detectadas"
          % (len(PROIBIDAS) - len(falsos_negativos), len(PROIBIDAS)))
    print("controle NEGATIVO (não podem)      : %d/%d liberadas"
          % (len(PERMITIDAS) - len(falsos_positivos), len(PERMITIDAS)))

    if falsos_negativos:
        print("\n--- PROMESSA REAL NÃO DETECTADA (gate afrouxado) ---")
        for frase in falsos_negativos:
            print("  %s" % frase)
    if falsos_positivos:
        print("\n--- TEXTO SÓBRIO REPROVADO (falso positivo) ---")
        for frase, tags in falsos_positivos:
            print("  [%s] %s" % (",".join(tags), frase))

    if falsos_negativos or falsos_positivos:
        print("\nREPROVADO: %d falso(s) negativo(s), %d falso(s) positivo(s)."
              % (len(falsos_negativos), len(falsos_positivos)))
        return 1
    print("\nOK: reprova promessa real e libera texto sóbrio.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
