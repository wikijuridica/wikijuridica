def atomic_replace_cas(path, before, after):
    """Substitui um arquivo regular somente se a preimagem continuar igual."""
    path = Path(path)
    info = os.lstat(path)
    if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or
            info.st_nlink != 1 or path.read_bytes() != before):
        raise RuntimeError(f'CAS inicial falhou: {path}')
    fd, temporary = tempfile.mkstemp(
        dir=path.parent, prefix=f'.{path.name}.', suffix='.tmp')
    try:
        os.fchmod(fd, stat.S_IMODE(info.st_mode))
        with os.fdopen(fd, 'wb') as target:
            target.write(after)
            target.flush()
            os.fsync(target.fileno())
        if path.read_bytes() != before:
            raise RuntimeError(f'CAS final falhou: {path}')
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def apply_wave2():
    # ---------- validacao: dedup global + campos ----------
    existing = set()
    for portfolio_file in sorted(glob.glob('data/editorial/portfolio_v2/*.jsonl')):
        with open(portfolio_file, encoding='utf-8') as source:
            for line in source:
                try:
                    existing.add(json.loads(line)['intent_id'])
                except (json.JSONDecodeError, KeyError, TypeError):
                    pass
    duplicates = [
        record['intent_id'] for record in new_leis + new_sumulas
        if record['intent_id'] in existing
    ]
    assert not duplicates, f'COLISAO com portfolio existente: {duplicates}'
    seen = set()
    for record in new_leis + new_sumulas:
        assert record['intent_id'] not in seen, f'duplicado interno: {record["intent_id"]}'
        seen.add(record['intent_id'])
        assert re.fullmatch(r'[a-z0-9-]+', record['intent_id']), record['intent_id']
        assert 20 <= len(record['working_title']) <= 65, (
            record['intent_id'], len(record['working_title']), record['working_title'])
        assert record['reader_problem'] and record['distinct_because'] and record['long_tail_query']

    leis_path = Path('data/editorial/portfolio_v2/leis.jsonl')
    sumulas_path = Path('data/editorial/portfolio_v2/sumulas.jsonl')
    full_path = Path('scripts/workflows/writing-mass-full.js')
    leis_before = leis_path.read_bytes()
    sumulas_before = sumulas_path.read_bytes()
    full_before = full_path.read_bytes()
    if ((leis_before and not leis_before.endswith(b'\n')) or
            (sumulas_before and not sumulas_before.endswith(b'\n'))):
        raise RuntimeError('portfolio JSONL sem LF terminal; append recusado')
    leis_addition = ''.join(
        json.dumps(record, ensure_ascii=False) + '\n' for record in new_leis
    ).encode('utf-8')
    sumulas_addition = ''.join(
        json.dumps(record, ensure_ascii=False) + '\n' for record in new_sumulas
    ).encode('utf-8')

    # ---------- lotes novos no writing-mass-full.js ----------
    full = full_before.decode('utf-8')
    match = re.search(r'const batches = (\[.*?\])\n', full, re.DOTALL)
    if match is None:
        raise RuntimeError('const batches ausente em writing-mass-full.js')
    batches = json.loads(match.group(1))
    have_slugs = {batch['slug'] for batch in batches}

    def next_idx(prefix):
        numbers = [
            int(slug.split('-')[-1]) for slug in have_slugs
            if re.fullmatch(prefix + r'-\d+', slug)
        ]
        return max(numbers) + 1 if numbers else 1

    new_batches = []
    by_fam_leis = {}
    for record in new_leis:
        by_fam_leis.setdefault(record['family'], []).append(record)
    index = next_idx('leis')
    for family, records in by_fam_leis.items():
        for start in range(0, len(records), 22):
            chunk = records[start:start + 22]
            new_batches.append({
                'slug': f'leis-{index:02d}', 'area': 'leis',
                'file': 'data/editorial/portfolio_v2/leis.jsonl',
                'families': [family], 'skip': start,
                'take': len(chunk) if len(records) > 22 else 0,
                'n': len(chunk),
            })
            if len(records) <= 22:
                new_batches[-1]['take'] = 0
                new_batches[-1]['skip'] = 0
            index += 1
    by_fam_sumulas = {}
    for record in new_sumulas:
        by_fam_sumulas.setdefault(record['family'], []).append(record)
    index = next_idx('sumulas')
    for family, records in by_fam_sumulas.items():
        new_batches.append({
            'slug': f'sumulas-{index:02d}', 'area': 'sumulas',
            'file': 'data/editorial/portfolio_v2/sumulas.jsonl',
            'families': [family], 'skip': 0, 'take': 0, 'n': len(records),
        })
        index += 1
    batches.extend(new_batches)
    new_full = (
        full[:match.start(1)] + json.dumps(batches, ensure_ascii=False) +
        full[match.end(1):]
    ).encode('utf-8')

    # O antigo append in-place deixava portfolios parciais em crash. Cada
    # destino agora usa preimagem autenticada, temp fsync, rename e dir fsync.
    atomic_replace_cas(leis_path, leis_before, leis_before + leis_addition)
    atomic_replace_cas(
        sumulas_path, sumulas_before, sumulas_before + sumulas_addition)
    atomic_replace_cas(full_path, full_before, new_full)

    print(
        f"onda 2: +{len(new_leis)} leis, +{len(new_sumulas)} sumulas; "
        f"lotes novos: {[batch['slug'] for batch in new_batches]}"
    )
    print(
        f"portfolio total agora: {len(existing) + len(new_leis) + len(new_sumulas)}")


