def lei_record(fam, sigla, query_tpl, hints, num, topico, problema, prep='de'):
    base = fam.replace('-w2', '')
    iid = f"lei-{base.replace('lei-','')}-art-{num}" if base.startswith('lei-') else f"lei-{base}-art-{num}"
    shown = num.upper() if ('-' in num and base == 'cf') else num
    title = f"Art. {shown} {prep} {sigla}: {topico}" if prep != 'de' else f"{sigla}, art. {shown}: {topico}"
    if len(title) > 65:
        title = title[:62].rstrip() + '...'
    return {
        'intent_id': iid, 'page_type': 'verbete', 'practice_area': 'leis', 'family': fam,
        'long_tail_query': f"{query_tpl.format(n=num)} {topico}".lower(),
        'working_title': title, 'reader_problem': problema, 'lane': 'informativa',
        'source_hints': hints, 'needs_source_research': False,
        'distinct_because': f"comenta o art. {num} ({topico}) — dispositivo proprio, nao coberto por outra pagina",
    }

