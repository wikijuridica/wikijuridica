#!/usr/bin/env bash
# check-redesocial-culpa-do-commit — separa a divida que ESTE commit causou da
# que ele apenas encontrou pelo caminho.
#
# POR QUE ISTO EXISTE
# -------------------
# O guardiao da rede social (tools/check-redesocial-completude) roda no
# pre-commit sempre que o commit toca internal/, cmd/ ou ops/nginx/. O gatilho e
# amplo de proposito -- gate sem gatilho nao protege --, mas ate 2026-09-05 o
# VEREDITO era igualmente amplo: qualquer entrega sem prova barrava qualquer
# commit.
#
# Medido no dia: 8 provas ausentes, todas da frente de rede social, em
# content/pages.json, cmd/social/rotas.go e docs/goal/DECISIONS.md. Elas
# barraram QUATRO commits sem relacao nenhuma com rede social -- corpus
# juridico, deadlock de scanner de segredos, gemea Markdown, ferramenta de
# deploy -- e deixaram 25 arquivos presos no indice COMPARTILHADO, que e'
# exatamente a condicao em que o pathspec de uma sessao varre o trabalho nao
# commitado de outra.
#
# Gate que trava a correcao certa nao esta protegendo: esta cobrando de quem
# passava na rua.
#
# O QUE ISTO NAO FAZ
# ------------------
# Nao afrouxa nada. A prova ausente continua devida e continua impressa. O que
# muda e' QUEM responde por ela: se o arquivo onde a prova deveria estar foi
# tocado por ESTE commit, e' regressao deste commit e barra; se nao foi, e'
# divida pre-existente de outra frente e sai como aviso. E' a mesma regra que o
# resto do repositorio aplica -- gate reprova por REGRESSAO, nao por divida
# alheia.
#
# FAIL-CLOSED
# -----------
# Linha de falha em que NENHUM caminho de arquivo e' reconhecido conta como
# deste commit e BARRA. Na duvida sobre de quem e' a divida, o commit para.
#
# USO
#   check-redesocial-culpa-do-commit <arquivo-com-a-saida-do-guardiao> <arquivo-com-os-caminhos-staged>
# SAIDA
#   linhas "MINHA: ..." e "ALHEIA: ..." em stdout
# EXIT
#   0 = nenhuma linha e' deste commit (so' aviso)
#   1 = ha' linha deste commit (o chamador barra)
#   2 = uso incorreto

set -uo pipefail

if [ "$#" -ne 2 ]; then
	echo "uso: $0 <saida-do-guardiao> <caminhos-staged>" >&2
	exit 2
fi

SAIDA="$1"
STAGED="$2"
for arquivo in "$SAIDA" "$STAGED"; do
	if [ ! -f "$arquivo" ]; then
		echo "$0: arquivo inexistente: $arquivo" >&2
		exit 2
	fi
done

tem_linha_minha=0

while IFS= read -r linha; do
	[ -n "$linha" ] || continue
	# So' as linhas de veredito do guardiao entram na conta. Ruido de progresso
	# ou cabecalho nao pode virar reprovacao -- nem absolvicao.
	case "$linha" in
	*redesocial_prova_* | *redesocial_entrega_*) ;;
	*) continue ;;
	esac

	achou_caminho=0
	e_minha=1
	for caminho in $(printf '%s\n' "$linha" |
		grep -oE '[A-Za-z0-9_./-]+\.(go|json|jsonl|md|py|sh|conf|txt|toml|yml|yaml)' || true); do
		achou_caminho=1
		if grep -qxF "$caminho" "$STAGED"; then
			e_minha=0
			break
		fi
	done

	if [ "$achou_caminho" -eq 1 ] && [ "$e_minha" -ne 0 ]; then
		printf 'ALHEIA: %s\n' "$linha"
	else
		printf 'MINHA: %s\n' "$linha"
		tem_linha_minha=1
	fi
done <"$SAIDA"

exit "$tem_linha_minha"
