#!/usr/bin/env bash
# tools/wj-claims — placar do Knowledge Claim (TASKLIST F2.O3): o schema do claim
# (JSON Schema 2020-12 com $ref à fonte única de enums), os 11 exemplos reais, os
# 27 ataques, os 58 positivos, as facetas, o CBOR contra a CDDL e o contexto JSON-LD.
#
# PORQUE: o Pronto do F2.O3 é número medido ("11 exemplos, 0 erro de schema;
# 27/27 ataques recusados; 58/58 positivos aceitos; CBOR válido pela CDDL;
# JSON-LD ok"), e contagem é saída de execução, nunca resumo (CANON, regra 5).
#
# Uso: tools/wj-claims            (= --check)
#      tools/wj-claims --check -raiz .
#
# SAIDA: uma linha FALHA por caso que não casou, uma linha por eixo do placar e,
# quando confere, a linha "placar F2.O3: ...". Exit 0 = confere; 2 = algum número
# diverge do esperado, algo não carregou, ou o dev-main não compilou.
#
# POR QUE COMPILA EM VEZ DE `go run`: o mesmo de tools/wj-enums — `go run` de um
# main que sai 2 sai 1 (medido em 2026-09-24 com go1.26.6). O binário vai para
# .cache/ (no .gitignore), num diretório próprio por execução, e sai no fim.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Egresso zero em build (S4): nenhum download de toolchain.
export GOTOOLCHAIN=local

mkdir -p "$ROOT/.cache/wj-claims"
BIN_DIR="$(mktemp -d "$ROOT/.cache/wj-claims/bin.XXXXXX")"
trap 'rm -rf "$BIN_DIR"' EXIT

if ! ./tools/go-modern build -tags devcmds -o "$BIN_DIR/wj-claims" ./wj/cmd/wj-claims; then
	echo "wj-claims: o dev-main não compilou" >&2
	exit 2
fi

if [ "$#" -eq 0 ]; then
	set -- --check
fi
"$BIN_DIR/wj-claims" "$@"
