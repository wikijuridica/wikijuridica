#!/usr/bin/env python3
"""Troca o HOMÓGLIFO CIRÍLICO U+0435 pelo "e" latino na cadeia de prosa pública
e no acervo publicado.

O QUE ESTAVA NO AR, medido em 2026-09-11 em `/sucessoes/investimentos-b3-falecido/`:

    "…ouvidos os interessados e com autorização do juiz, alienе bens do espólio
     quando necessário…"

O último caractere de "alienе" é U+0435 CYRILLIC SMALL LETTER IE, não o "e"
latino (U+0065). Ao olho os dois são idênticos.

POR QUE ISTO É DEFEITO, e por que ele é pior que um erro de digitação visível.
Para o leitor, "alienе" e "aliene" são a mesma palavra; para qualquer índice,
busca ou modelo que tokenize o texto, são palavras diferentes. A página estava
publicada com um termo que ninguém encontra procurando por ele — e o defeito não
aparece em revisão humana, porque não há o que ver. `internal/ptbrconfusables`
o classifica pela biblioteca `confusable-homoglyphs` como `mixed_script` e
`dangerous`, e blocker não publica.

ONDE ELE ESTAVA, e os três lugares são a mesma correção em camadas diferentes:

    data/editorial/refined_public_prose.jsonl   linha 6494, public_body_sections[1].text
    data/editorial/v2_pages/sucessoes-14.jsonl  linha 4, o estoque canônico
    content/pages.json                          o publicado, de onde o HTML sai

A TROCA É NO TEXTO BRUTO, NÃO POR REserialização de JSON, e isso é deliberado:
o produtor destes arquivos é Go, que escapa `&` como `&`; reserializar em
Python reescreveria 7.959 linhas por um caractere e o diff passaria a mentir
sobre o que mudou. Trocar no bruto preserva byte a byte tudo o que não é o
homóglifo.

A GUARDA É ARITMÉTICA, e aborta antes de escrever: por arquivo, exige que haja
exatamente o número esperado de caracteres cirílicos, que todos sejam U+0435,
que sobre zero depois da troca e que o tamanho em CARACTERES não mude.
Substituição cega em dado editorial é como se perde texto redigido.

IDEMPOTENTE: a segunda passada encontra zero e diz isso, sem escrever.

Uso:
    tools/generate-v2-homoglifo-cirilico-20260911 --dry-run
    tools/generate-v2-homoglifo-cirilico-20260911
"""
from __future__ import annotations

import argparse
import os
import re
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent

CIRILICO_E = "е"  # CYRILLIC SMALL LETTER IE
LATINO_E = "e"
QUALQUER_CIRILICO = re.compile(r"[Ѐ-ӿ]")

# (caminho, ocorrências esperadas na primeira passada)
ARQUIVOS = (
    ("data/editorial/refined_public_prose.jsonl", 1),
    ("data/editorial/v2_pages/sucessoes-14.jsonl", 1),
    ("content/pages.json", 1),
)


def escreve_atomico(arquivo: Path, conteudo: str) -> None:
    """Temporário no MESMO diretório, fsync e rename: um kill no meio da escrita
    não pode deixar meio arquivo de estoque no disco."""
    destino = arquivo.parent
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=destino,
                                     delete=False) as temporario:
        temporario.write(conteudo)
        temporario.flush()
        os.fsync(temporario.fileno())
        caminho_temporario = temporario.name
    os.replace(caminho_temporario, arquivo)


def corrige(rel: str, esperado: int, dry_run: bool) -> tuple[int, int]:
    """Devolve (código de saída, trocas feitas)."""
    arquivo = RAIZ / rel
    if not arquivo.exists():
        print("arquivo ausente: %s" % arquivo, file=sys.stderr)
        return 2, 0

    bruto = arquivo.read_text(encoding="utf-8")
    cirilicos = QUALQUER_CIRILICO.findall(bruto)
    if not cirilicos:
        print("%-46s ja limpo" % rel)
        return 0, 0
    if len(cirilicos) != esperado:
        print("%-46s ABORTA: %d cirilico(s), esperado %d"
              % (rel, len(cirilicos), esperado), file=sys.stderr)
        return 1, 0
    if set(cirilicos) != {CIRILICO_E}:
        print("%-46s ABORTA: cirilico diferente de U+0435: %r"
              % (rel, sorted(set(cirilicos))), file=sys.stderr)
        return 1, 0

    novo = bruto.replace(CIRILICO_E, LATINO_E)
    if QUALQUER_CIRILICO.search(novo):
        print("%-46s ABORTA: sobrou cirilico depois da troca" % rel, file=sys.stderr)
        return 1, 0
    if len(novo) != len(bruto):
        # U+0435 ocupa 2 bytes em UTF-8 e "e" ocupa 1; em CARACTERES o tamanho
        # tem de ser igual, e é isso que se compara aqui.
        print("%-46s ABORTA: o tamanho em caracteres mudou" % rel, file=sys.stderr)
        return 1, 0

    if dry_run:
        print("%-46s %d troca(s) (dry-run)" % (rel, esperado))
        return 0, esperado
    escreve_atomico(arquivo, novo)
    print("%-46s %d troca(s)" % (rel, esperado))
    return 0, esperado


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true",
                        help="mede e imprime, sem escrever")
    argumentos = parser.parse_args()

    codigo, total = 0, 0
    for rel, esperado in ARQUIVOS:
        resultado, trocas = corrige(rel, esperado, argumentos.dry_run)
        codigo = max(codigo, resultado)
        total += trocas
    print("total: %d troca(s) em %d arquivo(s)" % (total, len(ARQUIVOS)))
    if codigo == 0 and not argumentos.dry_run:
        # A prova final lê o disco de novo, nunca a variável em memória.
        for rel, _ in ARQUIVOS:
            restante = QUALQUER_CIRILICO.findall((RAIZ / rel).read_text(encoding="utf-8"))
            if restante:
                print("%-46s AINDA tem %d cirilico(s)" % (rel, len(restante)),
                      file=sys.stderr)
                codigo = 1
    return codigo


if __name__ == "__main__":
    raise SystemExit(main())
