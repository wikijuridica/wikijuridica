#!/usr/bin/env bash
# tools/collect-djen — ESCREVE (não é read-only).
#
# Aciona o coletor do Diário de Justiça Eletrônico Nacional (CNJ). A prosa
# completa — por que a paginação só para na página vazia, por que o ensaio não
# grava batimento e por que a estratégia se decide por medição — está no
# cabeçalho de cmd/collect-djen/main.go, que é onde o código mora.
#
# ★ O QUE ELE RESOLVE, medido em 2026-09-05 antes desta ferramenta:
#
#   internal/djen  → 12 arquivos, 9 pacotes o importam, e NENHUM o aciona
#   data/ops/djen_coleta_heartbeat.jsonl → não existia
#   systemctl list-timers | grep -i djen  → nada
#
# Biblioteca de coleta correta e sem coletor é intimação que não chega. Pior:
# sem batimento, coletor parado é indistinguível de "não houve intimação" — a
# pior falha silenciosa possível num painel de prazos.
#
# ★ RITMO DECLARADO CONTRA A FONTE OFICIAL. Entre páginas da mesma consulta,
# 250 ms (4 req/s); entre consultas distintas, 1 s. Medido em 2026-09-05: uma
# página responde em 0,28 s com 33,8 KB, então o ritmo efetivo fica em torno de
# 2 req/s. Coletor que martela fonte oficial é abuso; este declara o próprio
# ritmo e o expõe em bandeira (--pausa, --intervalo).
#
# ★ O TAMANHO REAL DO DIÁRIO, medido por este coletor em 2026-09-05:
#
#   janela de 2 dias no TJRJ:  96 páginas,  47.244 comunicações,  65,6 s
#   janela de 4 dias no TJRJ: 351 páginas, 174.960 comunicações, 258,3 s
#
# ~43.700 comunicações por DIA, e não as 5.000 que a documentação do pacote
# estimava. Throughput medido: 677 a 720 registros/s.
#
# ★ REMEDIDO EM 2026-09-16, POR DIA E NÃO POR JANELA. Os números acima mediam a
# JANELA inteira numa consulta só — e nela entravam fins de semana, que não têm
# publicação. Com a varredura partida por dia, o censo contou no TJRJ:
#
#   2026-09-14 (segunda): 95.257 comunicações em 192 páginas, 575 s
#   2026-09-15 (terça):   64.615 em 131 páginas, 322 s
#   2026-09-16 (quarta):  57.638 em 117 páginas, 301 s
#   2026-09-13 (domingo):      0 — o diário não sai
#
# E o TJRJ não é o maior: a busca binária pela última página mediu o TJSP em
# ~429.500 comunicações em 2026-09-14. Artefatos em data/research/djen/.
#
# ★ O QUE VAI PARA O DISCO DEPENDE DO REGIME (desde 2026-09-16). No regime
# MONITOR, que é o padrão e o do painel de prazos, só o que tem titular nesta
# base é guardado (minimização: na medição de 2026-09-05, 168.337 das 174.960
# foram lidas e descartadas). No regime ACERVO, o ato público é guardado —
# Regra 9 do contrato, que nomeia o DJEN —, menos o que a lei veda divulgar,
# que a régua de internal/publicidadenome recusa com o dispositivo. Medido:
# 2,47% do diário do TJRJ em 2026-09-16 caiu na vedação expressa.
#
# ★ IDENTIDADE DE SAÍDA. O CNJ recebe
#   Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/; coleta-oficial)
# vinda de internal/wikijuridicabot, nunca de string escrita à mão. Medido
# contra a API real: os dois agentes (o antigo e este) devolvem HTTP 200 e os
# mesmos 33.842 bytes — sair identificado não custa nada.
#
# ★ ENSAIO É O PADRÃO. Sem --aplicar o comando lê a fonte e NÃO escreve nada:
# nem armazém, nem batimento. Ensaio que gravasse batimento deixaria o vigia
# verde com zero coleta aplicada.
#
#   ./tools/collect-djen --conta minha:227191/RJ --probe     # 1 requisição, mede a fonte
#   ./tools/collect-djen --conta minha:227191/RJ             # ensaio completo
#   ./tools/collect-djen --conta minha:227191/RJ --aplicar   # coleta de verdade
#   ./tools/collect-djen --tribunal TJRJ --modo por_tribunal --aplicar
#
# ★ ONDE O DADO POUSA. Intimação traz nome de parte e teor de ato: o armazém
# fica em var/djen/ (0700/0600, fora do git). Para data/ops/ vai só o batimento
# — contagens, sem uma linha de teor.
#
# ★ O ENVELOPE. run-heavy-throttled exige contrato de custo e evidência de
# tempo do próprio filho, por isso --timings vai sempre. O throughput declarado
# (20 registros/s) é PISO conservador: a consulta por OAB do dono traz 121
# registros em duas requisições (~0,6 s medidos), o que dá duas ordens de
# grandeza acima. Contrato de custo não é recorde.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-collect:djen:gocache:${GOCACHE}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-660000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-60000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=20}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_heartbeat_written}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/djen_coleta_heartbeat.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/collect-djen}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/djen_coleta_heartbeat.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-720}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/collect-djen --timings "$@"
