#!/usr/bin/env python3
"""check-answerfirst-publicado — o gate answer-first medido contra o ACERVO NO AR.

READ-ONLY. Não escreve arquivo, não corrige texto, não altera limite. Existe
para produzir o número que a decisão precisa, e nada além disso.

POR QUE ELE EXISTE. `internal/answerfirst` é um gate bom e não fiscaliza nada:
ele roda em `internal/pagefactory`, que só é chamado num binário de prova. O
limite `MaxAnswerWords = 60` foi herdado sem que ninguém tivesse medido o
parágrafo-resposta das páginas publicadas. Duas leituras dessa situação são
possíveis e OPOSTAS — ou o acervo abre longo demais, ou o número está errado — e
reescrever 9.710 aberturas com base na leitura errada seria caro e irreversível.
Medir primeiro é a única ordem defensável.

A ARMADILHA DE DEFINIÇÃO, e é ela que decide o resultado. O gate documenta que
`opening` é "o primeiro parágrafo (a resposta)". O acervo guarda a abertura no
campo `summary`, que NEM SEMPRE é um parágrafo só. Contar o campo inteiro e
contar o primeiro parágrafo dão respostas diferentes, e uma delas mede a coisa
errada. Esta ferramenta imprime AS DUAS, lado a lado, e diz qual é qual — não
escolhe por conta própria.

Uso:
    tools/check-answerfirst-publicado
    tools/check-answerfirst-publicado --json

VEREDITO (adicionado em 2026-08-27 — até então a ferramenta media e nunca
reprovava, nem quando pages.json estava ausente). Ela nasceu deliberadamente
para NÃO decidir o debate teto/definição: se metade do acervo abre "longo
demais" pelo teto de 60, a causa pode ser o teto errado OU a abertura errada,
e a própria ferramenta diz que reescrever 9.710 páginas com base na leitura
errada seria caro e irreversível. Forçar um veredito sobre ISSO seria inventar
o critério que falta para o debate, o que o contrato proíbe — por isso o
TETO continua sem veredito, só reportado (campo_inteiro e primeiro_parágrafo,
lado a lado, como sempre foi).

O que a ferramenta documenta como incontroverso, e por isso É verdict-grade:
o PISO de 40 palavras. "abertura curta demais não responde de cara, e disso
ninguém duvidou" (comentário original desta ferramenta) — subir o teto é
debate, descer do piso não é. O veredito reprova quando a fração de páginas
com o primeiro parágrafo (a unidade que o gate documenta) abaixo de 40
palavras ultrapassa um teto de tolerância.

Calibração medida em 2026-08-27: 473 de 10.109 páginas indexáveis (4,68%)
têm o primeiro parágrafo abaixo do piso. O corte fica em 8% — quase o dobro
da medição atual, dando margem a flutuação editorial normal sem deixar de
pegar uma regressão real (ex.: um lote novo com abertura sistematicamente
curta).

Falha de MEDIÇÃO (pages.json ausente/corrompido, ou zero página indexável
encontrada — o que nunca deveria acontecer com >10 mil páginas no ar) é
distinta de reprovação editorial: usa exit 2, nunca "aprovado por default".
"""
from __future__ import annotations

import argparse
import json
import os
import re
import statistics
import sys
import unicodedata
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Overridável só pelo teste de falso-positivo/defeito sintético desta
# ferramenta (tools/test_check_answerfirst_publicado.py).
PAGES_JSON = Path(os.environ.get("WIKI_ANSWERFIRST_PAGES_JSON",
                                  str(ROOT / "content/pages.json")))

# internal/answerfirst — a única fração que este gate ARBITRA (ver
# docstring do módulo, seção VEREDITO): abaixo do piso de 40 palavras no
# primeiro parágrafo. Medido em 2026-08-27: 4,68% (473/10.109); teto de
# tolerância com margem quase dupla.
PISO_MAX_PCT_TOLERADO = 8.0

# Os mesmos valores e as mesmas listas de internal/answerfirst/answerfirst.go.
# Reimplementados aqui de propósito: a ferramenta tem de medir o gate COMO ELE É,
# e importar a decisão do Go exigiria um binário — o que faria a medição depender
# do build, que é justamente o passo que o contrato manda deixar por último.
MIN_ANSWER_WORDS = 40
MAX_ANSWER_WORDS = 60

INTERROGATIVOS = [
    "o que", "qual", "quais", "como", "quando", "quanto", "quantos", "quantas",
    "onde", "quem", "por que", "porque", "para que", "vale a pena", "posso", "preciso",
]
CONECTIVOS_PENDURADOS = [
    "e ", "mas ", "porem", "porém", "portanto", "assim,", "alem disso", "além disso",
    "por isso", "logo,", "entao", "então", "ou seja", "nesse sentido", "dessa forma",
    "dito isso", "com isso", "por fim", "ademais",
]


def conta_palavras(texto: str) -> int:
    return len(texto.split())


def primeiro_paragrafo(texto: str) -> str:
    """O primeiro bloco separado por linha em branco. É esta a unidade que o
    gate documenta como 'o parágrafo-resposta'."""
    for bloco in re.split(r"\n\s*\n", texto.strip()):
        if bloco.strip():
            return bloco.strip()
    return ""


def heading_e_pergunta(h: str) -> bool:
    t = h.strip().lower()
    if not t:
        return False
    if t.endswith("?"):
        return True
    return any(t.startswith(q) for q in INTERROGATIVOS)


def abre_autossuficiente(abertura: str) -> bool:
    t = abertura.strip()
    if not t:
        return False
    primeira = t[0]
    if primeira.isalpha() and not primeira.isupper():
        return False
    baixa = t.lower()
    return not any(baixa.startswith(c) for c in CONECTIVOS_PENDURADOS)


def indexavel(pagina: dict) -> bool:
    return (pagina.get("index_policy") == "index"
            and pagina.get("status") == "published"
            and bool(pagina.get("unique_intent_id")))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true", help="saída em JSON")
    args = parser.parse_args()

    try:
        with open(PAGES_JSON, encoding="utf-8") as handle:
            paginas = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"check-answerfirst-publicado: não deu para medir — {PAGES_JSON} "
              f"ausente ou corrompido ({exc})", file=sys.stderr)
        return 2

    palavras_campo: list[int] = []
    palavras_paragrafo: list[int] = []
    com_heading_pergunta = 0
    autossuficientes = 0
    passariam_campo = 0
    passariam_paragrafo = 0
    multiparagrafo = 0
    total = 0

    for pagina in paginas:
        if not indexavel(pagina):
            continue
        abertura_campo = (pagina.get("summary") or "").strip()
        if not abertura_campo:
            continue
        total += 1
        abertura_par = primeiro_paragrafo(abertura_campo)
        if abertura_par != abertura_campo:
            multiparagrafo += 1

        n_campo = conta_palavras(abertura_campo)
        n_par = conta_palavras(abertura_par)
        palavras_campo.append(n_campo)
        palavras_paragrafo.append(n_par)

        headings = [(s.get("title") or "") for s in pagina.get("body_sections") or []]
        headings += [(f.get("question") or "") for f in pagina.get("faq") or []]
        tem_pergunta = any(heading_e_pergunta(h) for h in headings)
        if tem_pergunta:
            com_heading_pergunta += 1
        autonoma = abre_autossuficiente(abertura_par)
        if autonoma:
            autossuficientes += 1

        na_faixa_campo = MIN_ANSWER_WORDS <= n_campo <= MAX_ANSWER_WORDS
        na_faixa_par = MIN_ANSWER_WORDS <= n_par <= MAX_ANSWER_WORDS
        if na_faixa_campo and tem_pergunta and autonoma:
            passariam_campo += 1
        if na_faixa_par and tem_pergunta and autonoma:
            passariam_paragrafo += 1

    if total == 0:
        print("check-answerfirst-publicado: não deu para medir — zero página "
              "indexável com abertura encontrada em pages.json (esperado >10 mil)",
              file=sys.stderr)
        return 2

    def faixa(valores: list[int], teto: int) -> int:
        return sum(1 for v in valores if MIN_ANSWER_WORDS <= v <= teto)

    abaixo_do_piso_par = sum(1 for v in palavras_paragrafo if v < MIN_ANSWER_WORDS)
    pct_abaixo_do_piso = 100 * abaixo_do_piso_par / total
    aprovado = pct_abaixo_do_piso <= PISO_MAX_PCT_TOLERADO

    resultado = {
        "ferramenta": "check-answerfirst-publicado",
        "paginas_indexaveis_com_abertura": total,
        "definicao": {
            "campo_inteiro": "content/pages.json .summary, sem recorte",
            "primeiro_paragrafo": "o primeiro bloco separado por linha em branco, que é a unidade "
                                  "que internal/answerfirst documenta como parágrafo-resposta",
            "aberturas_com_mais_de_um_paragrafo": multiparagrafo,
        },
        "gate_atual": {"min_palavras": MIN_ANSWER_WORDS, "max_palavras": MAX_ANSWER_WORDS},
        "campo_inteiro": {
            "mediana_palavras": statistics.median(palavras_campo) if palavras_campo else 0,
            "media_palavras": round(statistics.fmean(palavras_campo), 1) if palavras_campo else 0,
            "p90_palavras": sorted(palavras_campo)[int(0.9 * (len(palavras_campo) - 1))] if palavras_campo else 0,
            "acima_do_teto": sum(1 for v in palavras_campo if v > MAX_ANSWER_WORDS),
            "abaixo_do_piso": sum(1 for v in palavras_campo if v < MIN_ANSWER_WORDS),
            "passariam_no_gate": passariam_campo,
        },
        "primeiro_paragrafo": {
            "mediana_palavras": statistics.median(palavras_paragrafo) if palavras_paragrafo else 0,
            "media_palavras": round(statistics.fmean(palavras_paragrafo), 1) if palavras_paragrafo else 0,
            "p90_palavras": sorted(palavras_paragrafo)[int(0.9 * (len(palavras_paragrafo) - 1))] if palavras_paragrafo else 0,
            "acima_do_teto": sum(1 for v in palavras_paragrafo if v > MAX_ANSWER_WORDS),
            "abaixo_do_piso": sum(1 for v in palavras_paragrafo if v < MIN_ANSWER_WORDS),
            "passariam_no_gate": passariam_paragrafo,
        },
        "componentes": {
            "com_heading_em_forma_de_pergunta": com_heading_pergunta,
            "abertura_autossuficiente": autossuficientes,
        },
        # A pergunta que decide se o defeito é do acervo ou do número: quanto o
        # teto teria de subir para a maioria passar? Sobe só o teto, o piso de
        # 40 continua — abertura curta demais não responde de cara, e disso
        # ninguém duvidou.
        "cobertura_por_teto_hipotetico": {
            str(teto): {
                "campo_inteiro": faixa(palavras_campo, teto),
                "primeiro_paragrafo": faixa(palavras_paragrafo, teto),
            }
            for teto in (60, 70, 80, 90, 100, 120)
        },
        # ÚNICO corte que este gate arbitra (ver docstring — VEREDITO): o
        # teto continua só reportado, é debate em aberto. O piso de 40
        # palavras no primeiro parágrafo é o que "ninguém duvidou".
        "veredito": {
            "aprovado": aprovado,
            "abaixo_do_piso_primeiro_paragrafo": abaixo_do_piso_par,
            "pct_abaixo_do_piso_primeiro_paragrafo": round(pct_abaixo_do_piso, 2),
            "pct_maxima_tolerada": PISO_MAX_PCT_TOLERADO,
        },
    }

    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=1))
        return 0 if aprovado else 1

    print("check-answerfirst-publicado — READ-ONLY, nada foi alterado\n")
    print(f"páginas indexáveis com abertura: {total}")
    print(f"aberturas com mais de um parágrafo: {multiparagrafo}")
    print(f"gate atual: {MIN_ANSWER_WORDS}-{MAX_ANSWER_WORDS} palavras\n")
    for rotulo, chave in (("campo .summary inteiro", "campo_inteiro"),
                          ("primeiro parágrafo", "primeiro_paragrafo")):
        d = resultado[chave]
        print(f"{rotulo}:")
        print(f"  mediana {d['mediana_palavras']} · média {d['media_palavras']} · p90 {d['p90_palavras']}")
        print(f"  acima do teto: {d['acima_do_teto']} ({100*d['acima_do_teto']/total:.1f}%)")
        print(f"  abaixo do piso: {d['abaixo_do_piso']} ({100*d['abaixo_do_piso']/total:.1f}%)")
        print(f"  passariam no gate inteiro: {d['passariam_no_gate']} ({100*d['passariam_no_gate']/total:.1f}%)")
    c = resultado["componentes"]
    print(f"\ncom heading em forma de pergunta: {c['com_heading_em_forma_de_pergunta']} "
          f"({100*c['com_heading_em_forma_de_pergunta']/total:.1f}%)")
    print(f"abertura autossuficiente: {c['abertura_autossuficiente']} "
          f"({100*c['abertura_autossuficiente']/total:.1f}%)")
    print("\ncobertura da faixa 40-N, por teto hipotético:")
    for teto, d in resultado["cobertura_por_teto_hipotetico"].items():
        print(f"  40-{teto:>3}: campo {100*d['campo_inteiro']/total:5.1f}% · "
              f"1º parágrafo {100*d['primeiro_paragrafo']/total:5.1f}%")

    print(f"\nveredito (só o piso de 40 palavras é arbitrado; o teto continua em "
          f"debate e só é reportado acima):")
    print(f"  abaixo do piso (1º parágrafo): {abaixo_do_piso_par}/{total} "
          f"({pct_abaixo_do_piso:.2f}%) · tolerância {PISO_MAX_PCT_TOLERADO:.1f}%")
    if aprovado:
        print("  APROVADO")
    else:
        print("  REPROVADO — fração abaixo do piso excede a tolerância")
    return 0 if aprovado else 1


if __name__ == "__main__":
    sys.exit(main())
