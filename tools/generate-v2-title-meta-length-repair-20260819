#!/usr/bin/env python3
"""generate-v2-title-meta-length-repair-20260819 — tres campos de <head> fora da faixa do contrato.

O DEFEITO. A varredura integral dos 9.930 HTMLs de `public/` (title e meta lidos
com `html.unescape`, medidos em code points Unicode) achou tres violacoes do
contrato de HTML leve do CLAUDE.md — `<title>` de 20-65 e meta description de
70-160:

  /sucessoes/holding-imovel-rural-georreferenciamento/   title 69
  /tributario/aduana-drawback-isencao-reposicao-estoque/ title 69, description 167

Nao e cosmetica: title longo demais e cortado pelo Google no resultado, e o corte
cai justamente na parte final — que nestas duas paginas carrega o verbo que
distingue a intencao ("integralizar", "na exportacao"). Quem le o snippet cortado
nao sabe se a pagina responde a pergunta dele.

`/buscar/` tambem fica fora da faixa (title 13, meta 65) e NAO entra aqui: e
noindex e fora de sitemap, e o contrato vale para pagina publica indexavel.

POR QUE UM GERADOR NOVO, E NAO UM EXISTENTE. `tools/refine-batch-seo` e
`tools/resolve-review-seo-fix` sao comandos Go que operam as cadeias `batch_*`
(default `-batch batch-consumidor-financeiro-digital`), o acervo legado — nao
tocam `data/editorial/v2_pages/`, que e o estoque canonico destas duas paginas.
Editar JSONL do estoque na mao e proibido (CLAUDE.md). O caminho sancionado para
correcao pontual em v2 e o gerador datado com CAS, aberto por
`generate-v2-citation-attribution-repair-20260807` e repetido em
`generate-v2-acento-provisoria-repair-20260813`; este arquivo replica o mesmo
contrato de escrita, com uma diferenca deliberada: a troca aqui e de CAMPO
INTEIRO (`title`, `meta_description`), nao de trecho dentro do corpo, entao o CAS
compara o valor exato do campo em vez de contar ocorrencias de substring.

REESCREVER, NUNCA TRUNCAR. Cortar no 65o caractere produziria "...antes de doar
ou integral" — fragmento truncado e falha P0 do proprio contrato. Cada texto novo
e uma reescrita que preserva os termos discriminantes da intencao e o sentido
juridico; o racional campo a campo esta no `.data.json` ao lado, junto com a
medicao de comprimento.

O QUE ESTE GERADOR GARANTE, antes de escrever um byte:
  - comprimento do texto NOVO dentro da faixa do campo (fail-closed);
  - unicidade do texto NOVO contra todo o estoque v2 (exata e por casefold),
    porque title/meta duplicados sao defeito de indexacao;
  - nenhuma expressao de promessa de resultado (Provimento OAB 205/2021);
  - `word_count` INALTERADO — title e meta nao entram na formula do corpo
    (opening + sections + faq, internal/v2ingest/validate.go). O recalculo e
    feito e comparado mesmo assim: se mudasse, o reparo teria tocado o corpo sem
    querer, e isso aborta.

CONTRATO DE ESCRITA (identico aos precedentes): lease de epoca do estoque, lock
exclusivo proprio, CAS pelo sha256 da LINHA viva, demais linhas preservadas byte
a byte, escrita atomica com fsync, idempotente. Com um endurecimento que o ensaio
exigiu: a linha corrigida NAO e reserializada. `tributario-viz1-01.jsonl` mistura
duas formas de separador na mesma linha (o objeto externo com espaco, entradas de
`official_sources` de um reparo anterior na forma compacta), entao reemitir
normalizaria 8 bytes fora do escopo. A troca e de fatia — par chave+valor ja
codificado, ocorrencia unica — e o resultado e provado por round-trip
(`json.loads(nova) == registro`) e por delta de comprimento exato. O texto anterior e copiado para `.agents/runtime/` antes de qualquer
escrita — pagina redigida nunca se perde.

NAO COMMITA E NAO REPUBLICA. Enquanto `cmd/publish-v2-direct` nao rodar, `public/`,
`content/pages.json` e o `published_manifest` seguem servindo o texto antigo. A
rota tocada sai no `.data.json`, que e exatamente o que
`tools/generate-page-content-revision --revisadas-hoje` consome para carimbar o
lastmod honesto depois da republicacao.

Uso:
    tools/generate-v2-title-meta-length-repair-20260819 --dry-run
    tools/generate-v2-title-meta-length-repair-20260819
"""
from __future__ import annotations

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import unicodedata
from collections import defaultdict
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.title-meta-length-repair-20260819.lock"
DADOS = Path(__file__).with_suffix(".data.json")
BACKUP = ROOT / ".agents/runtime/backup-paginas-20260819-title-meta"
ESTOQUE = ROOT / "data/editorial/v2_pages"

# As faixas do contrato de HTML leve (CLAUDE.md, secao "HTML leve"). O mesmo par
# vive no lado Go em internal/editorial; aqui ele e cobrado sobre o dado de
# origem, que e onde a correcao nasce.
FAIXA = {"title": (20, 65), "meta_description": (70, 160)}

TEXTOS_PROIBIDOS = (
    "jurisprudência pacífica", "entendimento pacificado", "com certeza",
    "sempre ganha", "garantimos", "asseguramos o êxito", "êxito garantido",
    "certeza de ganho", "resultado garantido", "sem risco",
)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(handle)
        raise SystemExit(f"outro processo detém {path}; nada foi escrito")
    try:
        yield
    finally:
        fcntl.flock(handle, fcntl.LOCK_UN)
        os.close(handle)


def atomic_write(path: Path, payload: bytes) -> None:
    handle, tmp = tempfile.mkstemp(dir=os.fspath(path.parent), prefix=".tmp-repair-")
    try:
        with os.fdopen(handle, "wb") as saida:
            saida.write(payload)
            saida.flush()
            os.fsync(saida.fileno())
        os.replace(tmp, path)
        dir_fd = os.open(os.fspath(path.parent), os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def word_count(record: dict) -> int:
    """Reproduz bodyWordCount de internal/v2ingest/validate.go."""
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def substitui_campo_na_linha(linha: str, campo: str, antes: str, depois: str) -> str:
    """Troca o valor de UM campo dentro da linha crua, sem reserializar o resto.

    POR QUE NÃO REEMITIR A LINHA INTEIRA. `tributario-viz1-01.jsonl` não é saída
    de um único `json.dumps`: o objeto externo usa os separadores com espaço
    (", " / ": ") e algumas entradas de `official_sources`, escritas por um
    reparo anterior, usam a forma compacta (","/":"). Reemitir normalizaria esses
    trechos e mudaria 8 bytes que este reparo não tem nada que tocar — e byte
    mexido sem causa é exatamente o que o CAS existe para impedir. Trocando só a
    fatia do campo, todo o resto da linha permanece idêntico.

    O ancoramento é pelo par chave+valor JÁ CODIFICADO em JSON, nas duas formas
    de separador, e exige ocorrência ÚNICA: se o mesmo texto aparecesse também
    dentro de uma seção, a troca seria ambígua e aborta.
    """
    codificado_antes = json.dumps(antes, ensure_ascii=False)
    codificado_depois = json.dumps(depois, ensure_ascii=False)
    chave = json.dumps(campo, ensure_ascii=False)
    alvos = [f"{chave}: {codificado_antes}", f"{chave}:{codificado_antes}"]
    achados = [alvo for alvo in alvos if linha.count(alvo) == 1]
    total = sum(linha.count(alvo) for alvo in alvos)
    if total != 1 or len(achados) != 1:
        raise SystemExit(
            f"ancoragem de {campo} falhou: o par chave+valor aparece {total} vez(es) "
            "na linha, esperado exatamente 1. Nada foi escrito.")
    alvo = achados[0]
    substituto = alvo.replace(codificado_antes, codificado_depois, 1)
    return linha.replace(alvo, substituto, 1)


def carrega_correcoes() -> list[dict]:
    with open(DADOS, encoding="utf-8") as handle:
        dados = json.load(handle)
    correcoes = dados.get("correcoes") or []
    if not correcoes:
        raise SystemExit(f"{DADOS.name} não tem correções")
    for correcao in correcoes:
        for chave in ("intent_id", "shard", "campo", "old", "new", "porque"):
            if not correcao.get(chave):
                raise SystemExit(f"correção sem {chave}: {correcao}")
        if correcao["campo"] not in FAIXA:
            raise SystemExit(f"campo fora do escopo deste reparo: {correcao['campo']}")
    return correcoes


def valida_textos_novos(correcoes: list[dict]) -> None:
    """Fail-closed ANTES de abrir o estoque: faixa, promessa e colisão."""
    for correcao in correcoes:
        novo = correcao["new"]
        minimo, maximo = FAIXA[correcao["campo"]]
        if not minimo <= len(novo) <= maximo:
            raise SystemExit(
                f"{correcao['intent_id']}/{correcao['campo']}: texto novo tem "
                f"{len(novo)} code points, fora da faixa {minimo}-{maximo}")
        baixo = novo.lower()
        for proibido in TEXTOS_PROIBIDOS:
            if proibido in baixo:
                raise SystemExit(f"texto novo contém expressão proibida: {proibido!r}")

    # Unicidade contra o estoque inteiro. O registro que está sendo corrigido é
    # excluído da comparação: ele é o dono do valor antigo, não um concorrente.
    donos = {(c["intent_id"], c["campo"]) for c in correcoes}
    vistos: dict[str, set[str]] = {campo: set() for campo in FAIXA}
    for shard in sorted(ESTOQUE.glob("*.jsonl")):
        for linha in shard.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            registro = json.loads(linha)
            for campo in FAIXA:
                valor = registro.get(campo)
                if valor and (registro.get("intent_id"), campo) not in donos:
                    vistos[campo].add(valor.strip().casefold())
    novos_entre_si: dict[str, set[str]] = {campo: set() for campo in FAIXA}
    for correcao in correcoes:
        campo, chave = correcao["campo"], correcao["new"].strip().casefold()
        if chave in vistos[campo]:
            raise SystemExit(
                f"{correcao['intent_id']}/{campo}: o texto novo já existe no estoque")
        if chave in novos_entre_si[campo]:
            raise SystemExit(f"dois textos novos iguais para {campo} neste reparo")
        novos_entre_si[campo].add(chave)


def repara_shard(shard_rel: str, correcoes: list[dict], dry_run: bool) -> tuple[int, int]:
    path = ROOT / shard_rel
    if not path.is_file():
        raise SystemExit(f"shard ausente: {shard_rel}")

    bruto = path.read_bytes().decode("utf-8")
    linhas = bruto.split("\n")
    termina_com_newline = bool(linhas) and linhas[-1] == ""
    if termina_com_newline:
        linhas = linhas[:-1]

    por_intent: dict[str, list[dict]] = defaultdict(list)
    for correcao in correcoes:
        por_intent[correcao["intent_id"]].append(correcao)

    saida: list[str] = []
    aplicadas = ja_feitas = 0
    vistos_intents: set[str] = set()
    backup_feito = False

    for numero, raw in enumerate(linhas, 1):
        if not raw.strip():
            raise SystemExit(f"{shard_rel}: linha em branco {numero}")
        registro = json.loads(raw)
        intent = registro.get("intent_id")
        pendentes = por_intent.get(intent)
        if not pendentes:
            saida.append(raw)
            continue
        vistos_intents.add(intent)

        viva = raw.strip()
        digest_antes = hashlib.sha256(viva.encode("utf-8")).hexdigest()
        corpo_antes = word_count(registro)
        nova = viva
        aplicadas_nesta_linha: list[dict] = []
        mudou = False

        for correcao in pendentes:
            campo, antes, depois = correcao["campo"], correcao["old"], correcao["new"]
            atual = registro.get(campo)
            # IDEMPOTÊNCIA antes do CAS: rodar duas vezes não pode falhar.
            if atual == depois:
                ja_feitas += 1
                continue
            if atual != antes:
                raise SystemExit(
                    f"CAS DE CAMPO FALHOU em {shard_rel}:{numero} ({intent}/{campo}): "
                    f"o valor vivo tem {len(atual or '')} code points e não é o "
                    "medido. O estoque mudou desde a medição; nada foi escrito.")
            nova = substitui_campo_na_linha(nova, campo, antes, depois)
            registro[campo] = depois
            aplicadas_nesta_linha.append(correcao)
            mudou = True
            aplicadas += 1
            print(f"  {intent}/{campo}: {len(antes)} -> {len(depois)} code points")

        if not mudou:
            saida.append(raw)
            continue

        # title/meta não entram na fórmula do corpo: se o total moveu, o reparo
        # tocou o que não devia.
        corpo_depois = word_count(registro)
        if corpo_depois != corpo_antes:
            raise SystemExit(
                f"{intent}: word_count do corpo mudou ({corpo_antes} -> {corpo_depois}); "
                "title/meta não deveriam afetá-lo. Abortado.")
        declarado = registro.get("word_count")
        if declarado != corpo_depois:
            raise SystemExit(
                f"{intent}: word_count declarado ({declarado}) já divergia do corpo "
                f"({corpo_depois}) ANTES deste reparo. É defeito pré-existente, de outro "
                "gerador; corrigi-lo aqui mexeria em byte fora do escopo. Nada foi escrito.")

        # ROUND-TRIP: a linha cirurgiada tem de decodificar exatamente no registro
        # esperado. É o que prova que a troca de fatia não corrompeu o JSON nem
        # alterou qualquer outro campo.
        if json.loads(nova) != registro:
            raise SystemExit(f"round-trip falhou em {intent}; nada foi escrito")
        if hashlib.sha256(nova.encode("utf-8")).hexdigest() == digest_antes:
            raise SystemExit(f"linha de {intent} não mudou; abortado")
        esperado = len(viva)
        for correcao in aplicadas_nesta_linha:
            esperado += len(json.dumps(correcao["new"], ensure_ascii=False))
            esperado -= len(json.dumps(correcao["old"], ensure_ascii=False))
        if len(nova) != esperado:
            raise SystemExit(
                f"{intent}: a linha mudou {len(nova) - len(viva)} caracteres, esperado "
                f"{esperado - len(viva)}. Byte fora do escopo; nada foi escrito.")

        if not backup_feito and not dry_run:
            BACKUP.mkdir(parents=True, exist_ok=True)
            carimbo = datetime.datetime.now().strftime("%H%M%S")
            shutil.copy2(path, BACKUP / f"{path.name}.{carimbo}.antes")
            backup_feito = True

        saida.append(nova)

    faltando = set(por_intent) - vistos_intents
    if faltando:
        raise SystemExit(f"{shard_rel}: intent(s) não encontrado(s): {sorted(faltando)}")

    if aplicadas and not dry_run:
        payload = "\n".join(saida) + ("\n" if termina_com_newline else "")
        atomic_write(path, payload.encode("utf-8"))
    return aplicadas, ja_feitas


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    correcoes = carrega_correcoes()
    valida_textos_novos(correcoes)

    por_shard: dict[str, list[dict]] = defaultdict(list)
    for correcao in correcoes:
        por_shard[correcao["shard"]].append(correcao)

    total = ja = 0
    try:
        with canonical_stock_write_lease(ROOT), exclusive_lock(LOCK):
            for shard_rel in sorted(por_shard):
                aplicadas, ja_feitas = repara_shard(shard_rel, por_shard[shard_rel], args.dry_run)
                total += aplicadas
                ja += ja_feitas
    except StockEpochBusy as erro:
        raise SystemExit(f"estoque canônico ocupado: {erro}")

    if total == 0:
        print(f"nada a fazer ({ja} correção(ões) já aplicada(s))")
        return 0
    if args.dry_run:
        print(f"ENSAIO — {total} correção(ões) seriam aplicadas; nada foi escrito")
        return 0
    print(f"{total} correção(ões) aplicada(s) em {len(por_shard)} shard(s)")
    print(f"texto anterior preservado em {BACKUP.relative_to(ROOT)}/")
    print("public/ ainda serve o texto antigo: a republicação transacional é passo separado")
    return 0


if __name__ == "__main__":
    sys.exit(main())
