#!/usr/bin/env bash
# check-ancora-redesocial -- mede a ancora institucional para /redesocial/ nas
# paginas publicas de public/, em DUAS dimensoes:
#
#   COBERTURA    -- toda pagina tem a ancora? (sem ela, a pagina e um beco:
#                   quem chega pela busca nao sabe que a rede social existe)
#   CARDINALIDADE-- nenhuma pagina tem a ancora DUAS vezes?
#
# POR QUE A SEGUNDA DIMENSAO EXISTE, e o que custou nao existir. Ate 2026-09-05
# este gate media so a primeira, com `grep -rl`, que LISTA O ARQUIVO e nao conta
# ocorrencias -- entao ele dava "APROVADO: cobertura total" sobre um public/ em
# que 10.141 das 10.370 paginas traziam a ancora repetida. Duas consequencias, e
# as duas caras: o leitor via o mesmo paragrafo duas vezes, e a copia extra caia
# FORA do bloco `conteudos-relacionados` que generate-page-content-revision
# neutraliza -- fazendo o served_sha256 de todo o acervo mudar sem uma palavra de
# texto editorial ter mudado, e a guarda de churn recusar o deploy com
# "re-datacao em massa: 100,0%, teto 5,0%".
#
# O invariante estrutural (o render emitir uma vez) e provado por
# internal/render/ancora_redesocial_unica_test.go, em memoria e por mutacao.
# ESTE gate prova o outro lado: o que esta REALMENTE no disco servido. Os dois
# sao necessarios -- artefato velho no disco passa em teste de render e reprova
# aqui, e e assim que se descobre que falta republicar.
#
# READ-ONLY: le o disco, nao escreve nada.
# Exit 0 = cobertura total e nenhuma duplicata; 1 = falta ancora ou ha
# duplicata; 2 = arvore ausente.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PUB="${1:-$ROOT/public}"
[ -d "$PUB" ] || {
	echo "check-ancora-redesocial: sem $PUB"
	exit 2
}

# A ANCORA INSTITUCIONAL, e a aspa final e o que a separa do espelho de tema.
# `href="/redesocial/"` casa so a ancora institucional; sem a aspa, casaria
# tambem `href="/redesocial/tema/{area}/{slug}/"`, que e OUTRO link, legitimo e
# presente na mesma pagina -- e a contagem passaria a acusar duplicata onde nao
# ha.
ALVO='href="/redesocial/"'

total=$(find "$PUB" -name index.html -printf . | wc -c)
# -c conta LINHAS casadas por arquivo; o render emite cada ancora na propria
# linha (`ancoraDaRedeSocial() + "\n"`), entao linha e ocorrencia aqui.
contagens=$({ grep -rc --include=index.html -F "$ALVO" "$PUB" || true; })
com=$(printf '%s\n' "$contagens" | awk -F: '$NF>0' | wc -l)
duplicadas=$(printf '%s\n' "$contagens" | awk -F: '$NF>1' | wc -l)
falta=$((total - com))
pct=$(awk -v c="$com" -v t="$total" 'BEGIN{printf "%.2f",(t?100*c/t:0)}')

echo "paginas index.html: $total"
echo "com ancora /redesocial/: $com ($pct%)"
echo "sem ancora: $falta"
echo "com ancora DUPLICADA: $duplicadas"

falhou=0
if [ "$falta" -ne 0 ]; then
	echo "REPROVADO: $falta pagina(s) sem ancora para /redesocial/"
	# AWK LIMITA POR DENTRO, e nao `| head -5`: com `set -o pipefail`, o head
	# fecha o pipe cedo, o awk morre de SIGPIPE e o script sai com 141 em vez de 1
	# -- um exit code que mente para quem chama o gate. Medido nesta sessao.
	printf '%s\n' "$contagens" | awk -F: '$NF==0 && ++n<=5{print "  sem ancora: "$1}'
	falhou=1
fi
if [ "$duplicadas" -ne 0 ]; then
	echo "REPROVADO: $duplicadas pagina(s) com a ancora institucional REPETIDA."
	printf '%s\n' "$contagens" | awk -F: '$NF>1 && ++n<=5{print "  "$NF"x  "$1}'
	echo "  A ancora tem dois emissores legitimos, cada um para um tipo de pagina:"
	echo "    render.go, no corpo            -> pagina SEM bloco de malha (a home)"
	echo "    renderRelatedContent, no bloco -> toda pagina COM malha"
	echo "  Os dois disparando juntos repetem o paragrafo para o leitor e poem a copia"
	echo "  do corpo fora do @NAV@ neutralizado, re-datando o acervo inteiro."
	echo "  O conserto e a CONDICAO em render.go -- nunca apagar um dos emissores,"
	echo "  que deixaria metade do acervo sem ancora -- seguido de republicacao."
	falhou=1
fi
# TERCEIRA DIMENSAO: A POSICAO, e ela e a que tem consequencia economica direta.
#
# Cobertura e cardinalidade nao bastam. Uma ancora UNICA, mas emitida no corpo de
# uma pagina que TEM bloco de relacionados, passa nas duas de cima e continua
# re-datando as ~10.141 rotas -- porque o que custa nao e a repeticao, e a
# posicao: so o que esta dentro de `<section aria-labelledby="conteudos-
# relacionados">` vira @NAV@ antes de o served_sha256 ser calculado.
#
# O invariante estrutural correspondente e provado em memoria por
# internal/render/TestAncoraDaRedeSocialNaoCaiForaDoBlocoNaPaginaDeAcervo. ESTE
# aqui mede o DISCO servido, que e outra pergunta: artefato velho passa no teste
# de render e reprova aqui, e e assim que se descobre que falta republicar.
fora=$(
	python3 - "$PUB" <<'PYEOF'
import sys, pathlib
raiz = pathlib.Path(sys.argv[1])
ANCORA = '<p><a href="/redesocial/">'
BLOCO = '<section aria-labelledby="conteudos-relacionados">'
fora = []
for arquivo in raiz.rglob("index.html"):
    texto = arquivo.read_text(encoding="utf-8", errors="replace")
    pos_bloco = texto.find(BLOCO)
    if pos_bloco < 0:
        # Sem bloco, a ancora TEM de estar no corpo: e o unico lugar possivel, e
        # e para isso que a emissao do corpo existe (a home era um beco).
        continue
    pos_ancora = texto.find(ANCORA)
    if 0 <= pos_ancora < pos_bloco:
        fora.append(f"{pos_ancora}<{pos_bloco}  {arquivo}")
for linha in fora[:5]:
    print(linha)
print(f"TOTAL={len(fora)}")
PYEOF
)
total_fora=$(printf '%s
' "$fora" | sed -n 's/^TOTAL=//p')
echo "com ancora FORA do bloco (em pagina que tem bloco): ${total_fora:-?}"
if [ "${total_fora:-0}" -ne 0 ]; then
	echo "REPROVADO: ${total_fora} pagina(s) servem a ancora ANTES do bloco de conteudos relacionados."
	printf '%s
' "$fora" | grep -v '^TOTAL=' | sed 's/^/  offset /'
	echo "  Fora do bloco ela nao e neutralizada por generate-page-content-revision, e cada"
	echo "  republicacao passa a re-datar as ~10.141 rotas -- reanunciando ao Googlebot, como"
	echo "  conteudo novo, paginas cujo texto editorial nao mudou."
	falhou=1
fi

[ "$falhou" -eq 0 ] || exit 1
echo "APROVADO: cobertura total, nenhuma duplicata, nenhuma ancora fora do bloco"
