#!/usr/bin/env python3
"""check-bin-versao-do-toolchain — binario promovivel nao pode ser mais velho que o toolchain.

READ-ONLY. Exit 1 quando algum executavel em `bin/` foi compilado com uma versao
do Go anterior a que o `go.mod` declara.

POR QUE ESTE GATE EXISTE, e o precedente e de 2026-08-26.

O toolchain subiu para go1.26.6 porque GO-2026-6179 e GO-2026-6180 listam o
TOOLCHAIN como afetado, com `fixed 1.26.6`. Uma critica adversarial daquele dia
foi olhar o diretorio `bin/` e achou la um binario oculto -- `.wjs-guarda`, modo
700, sem uma unica referencia em tools/, docs/, systemd ou crontab -- compilado
com go1.26.5, isto e, com a versao que as vulnerabilidades listam.

A medicao propria ampliou o achado: nao era um binario, eram NOVE. `bin/` tinha
`.anterior`, `.prev`, `.new`, `.bak-*` e companhia, sete deles em go1.26.5, todos
a um `cp` de distancia de virar producao. Nenhum estava em execucao, e nao houve
dano -- o risco era o proximo operador (ou o proximo agente) promover um deles
como rollback e regredir a versao do Go EM SILENCIO, porque nada avisaria.

O DIRETORIO E O ESCOPO CERTO, e nao so o binario ativo: um gate que conferisse
apenas `bin/wikijuridica-server` diria "verde" com sete armadilhas ao lado. O que
se promove por engano e justamente o que ninguem esta olhando.

Binario aposentado nao se apaga -- este repositorio nao descarta artefato. Ele
sai de `bin/` para `.agents/runtime/binarios-aposentados/<data>/`, onde continua
recuperavel e deixa de ser promovivel por acidente.
"""

import os
import re
import subprocess
import sys

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
BIN = os.path.join(RAIZ, "bin")
GOMOD = os.path.join(RAIZ, "go.mod")
GO = os.path.join(RAIZ, "tools", "go-modern")


def versao_do_toolchain():
    """A versao que o go.mod declara em `toolchain`, ou em `go` se nao houver."""
    try:
        with open(GOMOD, encoding="utf-8") as arquivo:
            texto = arquivo.read()
    except OSError:
        return None
    achado = re.search(r"^toolchain\s+go(\d+\.\d+(?:\.\d+)?)", texto, re.M)
    if achado:
        return achado.group(1)
    achado = re.search(r"^go\s+(\d+\.\d+(?:\.\d+)?)", texto, re.M)
    return achado.group(1) if achado else None


def como_tupla(versao):
    partes = [int(p) for p in versao.split(".")]
    while len(partes) < 3:
        partes.append(0)
    return tuple(partes)


def versao_do_binario(caminho):
    """A versao Go gravada no executavel, ou None se nao for binario Go."""
    try:
        saida = subprocess.run([GO, "version", "-m", caminho],
                               capture_output=True, text=True, timeout=90, cwd=RAIZ)
    except Exception:
        return None
    achado = re.search(r"go(\d+\.\d+(?:\.\d+)?)", saida.stdout or "")
    return achado.group(1) if achado else None


def main() -> int:
    esperada = versao_do_toolchain()
    if not esperada:
        print("check-bin-versao-do-toolchain: FAIL\n  - nao consegui ler a versao do go.mod")
        return 1
    if not os.path.isdir(BIN):
        print("check-bin-versao-do-toolchain: OK (nao ha diretorio bin/)")
        return 0

    atrasados, conferidos = [], 0
    for nome in sorted(os.listdir(BIN)):
        caminho = os.path.join(BIN, nome)
        if not os.path.isfile(caminho) or not os.access(caminho, os.X_OK):
            continue
        versao = versao_do_binario(caminho)
        if not versao:
            continue
        conferidos += 1
        if como_tupla(versao) < como_tupla(esperada):
            atrasados.append((nome, versao))

    print("go.mod declara toolchain go%s | %d executavel(is) Go em bin/"
          % (esperada, conferidos))
    if not atrasados:
        print("check-bin-versao-do-toolchain: OK (nenhum binario promovivel atras do toolchain)")
        return 0

    print("check-bin-versao-do-toolchain: FAIL")
    print("  - %d binario(s) em bin/ compilado(s) com Go anterior ao declarado. Nenhum"
          % len(atrasados))
    print("    precisa estar em execucao para fazer mal: basta um `cp` de rollback para")
    print("    a versao do Go regredir sem que nada avise.")
    for nome, versao in atrasados:
        print("      bin/%-44s go%s" % (nome, versao))
    print("  Aposente-os SEM APAGAR: mova para .agents/runtime/binarios-aposentados/<data>/")
    return 1


if __name__ == "__main__":
    sys.exit(main())
