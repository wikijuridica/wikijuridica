#!/usr/bin/env bash
# run-cerebro-enfileirar — enfileira no cérebro o que mudou, sem mão humana.
#
# O QUE FALTAVA (medido em 2026-09-09, plano frente B4): nenhum timer ou hook
# chamava `cerebro enfileirar-*`. O acervo recarregava em memória, mas página
# nova ou reescrita só entrava no índice de embeddings quando alguém rodava o
# comando à mão — e a fila acumulava tarefa em `erro` do tipo "texto mudou
# depois de enfileirar" (#4769, /jurisprudencia/stj-tema-17/), que só se resolve
# enfileirando de novo com o hash novo.
#
# QUEM CHAMA: wikijuridica-cerebro-enfileirar.path (content/pages.json e o
# manifesto do corpus STJ mudaram) e o timer diário de segurança. Pode rodar com
# o daemon vivo: a fila é SQLite em WAL com busy_timeout de 5 s, e o INSERT OR
# IGNORE torna a chamada idempotente — página já embutida com o mesmo hash não
# vira tarefa (indice.Tem), ementa já extraída com o mesmo texto_sha256 e modelo
# é pulada (puladas_por_cache).
#
# SAÍDA: uma linha JSON em data/ops/cerebro_enfileirar.jsonl por execução, com o
# resumo impresso por cada subcomando e o exit real. Exit 0 só se os dois
# subcomandos saírem 0; senão o exit do primeiro que falhou.
set -u
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$RAIZ/bin/cerebro"
LEDGER="$RAIZ/data/ops/cerebro_enfileirar.jsonl"
GATILHO="${1:-manual}"
if [ ! -x "$BIN" ]; then
	echo "run-cerebro-enfileirar: binario ausente em $BIN (./tools/go-modern build -o bin/cerebro ./cmd/cerebro/)" >&2
	exit 2
fi
inicio="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
t0=$(date +%s)
saida_emb="$("$BIN" enfileirar-embeddings --root "$RAIZ" 2>&1)"
exit_emb=$?
saida_ext="$("$BIN" enfileirar-extracoes --root "$RAIZ" 2>&1)"
exit_ext=$?
dur=$(($(date +%s) - t0))
python3 - "$LEDGER" "$inicio" "$GATILHO" "$exit_emb" "$exit_ext" "$dur" "$saida_emb" "$saida_ext" <<'PY'
import json, sys
ledger, inicio, gatilho, e1, e2, dur, s1, s2 = sys.argv[1:9]
def ultima(s):
    linhas = [l for l in s.strip().splitlines() if l.strip()]
    return linhas[-1][:400] if linhas else ""
with open(ledger, "a", encoding="utf-8") as f:
    f.write(json.dumps({
        "schema_version": "cerebro_enfileirar_v1",
        "inicio": inicio, "gatilho": gatilho, "duracao_s": int(dur),
        "embeddings": {"exit": int(e1), "resumo": ultima(s1)},
        "extracoes": {"exit": int(e2), "resumo": ultima(s2)},
    }, ensure_ascii=False) + "\n")
PY
printf '%s\n' "$saida_emb" | tail -3
printf '%s\n' "$saida_ext" | tail -3
if [ "$exit_emb" -ne 0 ]; then exit "$exit_emb"; fi
exit "$exit_ext"
