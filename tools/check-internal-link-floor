#!/usr/bin/env python3
"""check-internal-link-floor — piso de links de ENTRADA por página indexável.

O QUE ELE MEDE, E POR QUE SOBRE O DISCO. Cada página indexável precisa de no
mínimo 3 links de entrada (origens DISTINTAS, self-link fora) vindos do próprio
acervo público. A medição é sobre o artefato REAL em public/ — o HTML que o
nginx serve —, nunca sobre plano ou intenção: foi medindo o disco que se achou o
defeito que motivou este check (2026-08-11: 1.755 páginas penduradas num único
link, 62% do acervo com 3 ou menos, PageRank interno concentrado num grafo que
o BFS percorre em 3 níveis mas quase não redistribui).

DE ONDE VEM O PISO 3. Todo artigo do acervo recebe exatamente 1 link estrutural
(a fatia paginada da hub da sua área) + o piso de 2 entradas de malha temática
que o publicador garante (v2publish.EnforceInboundFloor). 1 + 2 = 3. Página
com menos que isso é página que o pipeline abandonou.

EXCEÇÃO ESTRUTURAL, IMPRESSA EM TODA EXECUÇÃO — nunca silenciosa. Fatia de
paginação (/area/pagina/N/) só é linkável pela navegação da própria área: o hub
raiz e as outras fatias (a barra "Ir para uma página desta área"). Numa área
com K páginas de hub (raiz + fatias), cada fatia pode receber no máximo K-1
origens. Área pequena (K<4) torna o piso 3 estruturalmente inatingível SEM
link não-temático — e link forçado degrada mais do que a ausência dele. Para
essas fatias o piso é K-1, e o check IMPRIME cada exceção com a conta, para que
a régua rebaixada nunca passe despercebida.

Read-only (contrato tools/check-*): não escreve nada, só mede e reprova.
Saída 0 = todas as páginas no piso; 1 = há página abaixo; 2 = erro de uso.
"""
from __future__ import annotations

import os
import re
import sys
from collections import defaultdict

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import wikiuniverso  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUBLIC = os.path.join(ROOT, "public")
SITEMAP_DIR = os.path.join(PUBLIC, "sitemaps")
FLOOR = 3

HREF = re.compile(r'href="(/[^"#?]*)(?:[^"]*)"')
LOC = re.compile(r"<loc>https://wikijuridica\.com\.br(/[^<]*)</loc>")
PAGINATION = re.compile(r"^/([a-z0-9-]+)/pagina/(\d+)/$")


def fail(msg: str) -> "SystemExit":
    print(f"check-internal-link-floor: {msg}", file=sys.stderr)
    return SystemExit(2)


def main() -> int:
    if not os.path.isdir(PUBLIC):
        raise fail(f"{PUBLIC} não existe — nada publicado para medir")
    if not os.path.isdir(SITEMAP_DIR):
        raise fail("public/sitemaps ausente — sem universo indexável declarado")

    # Universo indexável: o que o sitemap anuncia E existe em disco. Anunciado
    # sem HTML é defeito de outro check (coerência de artefato); aqui só se mede
    # a malha do que está de fato no ar.
    # FAMÍLIA-A (2026-08-29): este bloco fazia os.listdir(SITEMAP_DIR) e abria
    # TUDO como UTF-8. O diretório tem 58 gêmeas .br além dos 62 .xml, e o
    # primeiro .br derrubava o gate inteiro com
    # "UnicodeDecodeError: 'utf-8' codec can't decode byte 0xf1 in position 0".
    # O exit 1 resultante era lido como "reprovou por conteúdo": o gate do piso
    # de links internos — SEO puro — não media nada há tempo indeterminado.
    # Pior ainda, mesmo sem o .br ele somaria os 28 shards em CARÊNCIA, que
    # existem no disco de propósito e NÃO são anunciados.
    # A fonte única deriva do índice; ver tools/wikiuniverso.py.
    try:
        declared = set(wikiuniverso.caminhos_publicos(ROOT))
    except wikiuniverso.UniversoIndisponivel as erro:
        raise fail(str(erro))

    pages: dict[str, str] = {}
    for dirpath, _dirnames, filenames in os.walk(PUBLIC):
        if "index.html" not in filenames:
            continue
        rel = os.path.relpath(dirpath, PUBLIC)
        route = "/" if rel == "." else "/" + rel.replace(os.sep, "/") + "/"
        pages[route] = os.path.join(dirpath, "index.html")

    indexable = {route for route in declared if route in pages}
    if not indexable:
        raise fail("nenhuma rota do sitemap tem HTML em disco")

    # Grafo de entrada: origens DISTINTAS por alvo, self-link fora. Um único
    # passe pelos ~9,8 mil arquivos (~200 MB) — regex compilada, sem parser.
    inbound: dict[str, set[str]] = defaultdict(set)
    for route, path in pages.items():
        with open(path, encoding="utf-8", errors="replace") as handle:
            html = handle.read()
        for match in HREF.finditer(html):
            target = match.group(1)
            if not target.endswith("/"):
                # href de asset (xml, txt, ico, svg) não é link de página.
                if "." in target.rsplit("/", 1)[-1]:
                    continue
                target += "/"
            if target != route:
                inbound[target].add(route)

    # Capacidade estrutural das fatias de paginação: K páginas de hub por área
    # (raiz + fatias) => cada fatia alcança no máximo K-1 origens de navegação.
    slices_by_area: dict[str, int] = defaultdict(int)
    for route in pages:
        matched = PAGINATION.match(route)
        if matched:
            number = int(matched.group(2))
            if number > slices_by_area[matched.group(1)]:
                slices_by_area[matched.group(1)] = number

    def floor_for(route: str) -> tuple[int, str]:
        matched = PAGINATION.match(route)
        if not matched:
            return FLOOR, ""
        total_hub_pages = slices_by_area[matched.group(1)]
        capacity = total_hub_pages - 1
        if capacity >= FLOOR:
            return FLOOR, ""
        return capacity, (
            f"área {matched.group(1)!r} tem {total_hub_pages} páginas de hub; "
            f"capacidade estrutural de entrada da fatia = {capacity}"
        )

    histogram: dict[int, int] = defaultdict(int)
    offenders: list[tuple[str, int, int]] = []
    exceptions: list[str] = []
    total_links = 0
    for route in sorted(indexable):
        got = len(inbound.get(route, ()))
        histogram[got if got < 8 else 8] += 1
        total_links += got
        required, reason = floor_for(route)
        if reason:
            exceptions.append(f"  exceção estrutural: {route} exige >={required} ({reason})")
        if got < required:
            offenders.append((route, got, required))

    mean = total_links / len(indexable)
    counts = sorted(len(inbound.get(route, ())) for route in indexable)
    median = counts[len(counts) // 2]
    print("== check-internal-link-floor ==")
    print(f"páginas indexáveis medidas : {len(indexable)}")
    print(f"inlinks: média {mean:.2f}, mediana {median}")
    for bucket in sorted(histogram):
        label = f"{bucket}" if bucket < 8 else "8+"
        print(f"  {label} inlink(s): {histogram[bucket]} páginas")
    for line in exceptions:
        print(line)

    if offenders:
        print(f"\nREPROVADO: {len(offenders)} página(s) indexável(is) abaixo do piso de entrada:")
        for route, got, required in offenders[:20]:
            print(f"  {route} tem {got}, piso {required}")
        if len(offenders) > 20:
            print(f"  ... e mais {len(offenders) - 20}")
        print("\ncorreção: republicar com o piso de entradas "
              "(cmd/publish-v2-direct aplica v2publish.EnforceInboundFloor); página que "
              "persistir é órfã de afinidade — enriquecer internal_link_topics dela por "
              "gerador datado, nunca relaxar o critério de afinidade.")
        return 1
    print("\nOK: todas as páginas indexáveis atendem o piso de links de entrada.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
