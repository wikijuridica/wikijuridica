#!/usr/bin/env python3
"""generate-v2-blocked-drafts-resolved-hash-refresh-20260812 — realinha o sha256 de evidência com a linha viva.

O DEFEITO. `generate-v2-blocked-drafts-promotion-20260812` gravou, em cada
registro de `data/editorial/v2_blocked_drafts/`, um marcador `resolved` com
`post_provenance_sha256` = sha256 da linha promovida. Em seguida,
`generate-v2-cidadania-italiana-fonte-revoca-20260812` acrescentou uma fonte
oficial à linha viva de `cid-italiana-por-casamento` — e o hash gravado passou a
apontar para uma linha que não existe mais.

Campo de evidência que não corresponde à realidade é exatamente a classe de
coisa que, descoberta depois, se lê como dado forjado. Esta ferramenta recalcula
o hash a partir da LINHA VIVA ATUAL, para todos os marcadores desta onda, e só
grava o que estiver defasado.

CONTRATO DE ESCRITA: lease de época, lock exclusivo, leitura da linha viva como
fonte da verdade, demais campos preservados, forma de serialização preservada,
escrita atômica com fsync, idempotente. NÃO commita e NÃO publica.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.blocked-drafts-hash-refresh-20260812.lock"
PAGES = ROOT / "data/editorial/v2_pages"
BLOQUEADAS = ROOT / "data/editorial/v2_blocked_drafts"
ONDA = "W7-recuperacao-bloqueados-20260812"


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def forma(linha: str):
    original = json.loads(linha)
    for separadores in ((", ", ": "), (",", ":")):
        if json.dumps(original, ensure_ascii=False,
                      separators=separadores) == linha:
            return separadores
    return (", ", ": ")


def hashes_vivos() -> dict[str, str]:
    vivos: dict[str, str] = {}
    for caminho in sorted(PAGES.glob("*.jsonl")):
        with caminho.open(encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    intent = json.loads(linha).get("intent_id")
                except json.JSONDecodeError:
                    continue
                if intent:
                    vivos[intent] = hashlib.sha256(
                        linha.encode("utf-8")).hexdigest()
    return vivos


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                vivos = hashes_vivos()
                total = 0
                for caminho in sorted(BLOQUEADAS.glob("*.jsonl")):
                    linhas = caminho.read_text(encoding="utf-8").splitlines()
                    saida: list[str] = []
                    alterados = 0
                    for linha in linhas:
                        if not linha.strip():
                            saida.append(linha)
                            continue
                        registro = json.loads(linha)
                        marcador = registro.get("resolved") or {}
                        intent = registro.get("intent_id")
                        if marcador.get("wave") != ONDA or intent not in vivos:
                            saida.append(linha)
                            continue
                        atual = vivos[intent]
                        if marcador.get("post_provenance_sha256") == atual:
                            saida.append(linha)
                            continue
                        antigo = marcador.get("post_provenance_sha256", "")
                        marcador["post_provenance_sha256"] = atual
                        marcador["post_provenance_sha256_superseded"] = antigo
                        marcador["note"] = (
                            marcador.get("note", "") +
                            " | hash realinhado em 2026-08-12 apos acrescimo de "
                            "fonte oficial na linha viva")
                        saida.append(json.dumps(registro, ensure_ascii=False,
                                                separators=forma(linha)))
                        alterados += 1
                        print(f"  {intent}: {antigo[:16]} -> {atual[:16]}")
                    if not alterados:
                        continue
                    if not args.dry_run:
                        atomic_write(caminho,
                                     ("\n".join(saida) + "\n").encode("utf-8"))
                    print(f"{caminho.name}: {alterados} marcador(es) "
                          f"{'realinhável(is)' if args.dry_run else 'realinhado(s)'}")
                    total += alterados
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    if total == 0:
        print("todos os marcadores já correspondem à linha viva (idempotente).")
    elif args.dry_run:
        print(f"--dry-run: {total} marcador(es) defasado(s). Nada escrito.")
    else:
        print(f"{total} marcador(es) realinhado(s). NÃO commitado.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
