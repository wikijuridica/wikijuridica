#!/usr/bin/env python3
"""generate-public-orphan-quarantine-20260806 — tira do ar o HTML orfao de public/.

O QUE E ORFAO AQUI: arquivo index.html servivel em public/ que nao corresponde a
NENHUMA pagina de content/pages.json nem a linha do published_manifest. Sao
residuo de colisao de rota: paginas de direito administrativo e aereo que foram
renderizadas sob /educacao/, /sucessoes/ e /autonomos/ numa publicacao anterior.

POR QUE SAIR:
  1. Violam a coerencia de artefato que o CLAUDE.md declara inegociavel — HTML
     sem manifesto, sem sitemap, sem proveniencia e invisivel a qualquer fila de
     correcao.
  2. Sao CANIBALIZACAO: medido, 43 de 43 tem a versao correta publicada em outra
     area (/administrativo/desapropriacao/ existe; /educacao/desapropriacao/ e o
     residuo). Dois enderecos com o mesmo conteudo competem entre si no buscador.
  3. O cutover do nginx para releases/current/public congelaria esse residuo
     dentro de um release imutavel promovido.

POR QUE QUARENTENA E NAO `rm`: o contrato do projeto proibe descartar trabalho.
O conteudo-fonte esta vivo no estoque v2 (verificado: intent_id adm-*, aer-* em
data/editorial/v2_pages/codex-*-portfolio-adm-*.jsonl), mas o HTML renderizado
nao e reproduzivel pelo publish — essas paginas foram recusadas pelo censo por
rota_duplicada, entao republicar nao as regenera. Mover preserva a evidencia com
o hash; deletar destruiria a unica copia renderizada.

Idempotente: rodar de novo nao move nada (as rotas ja sairam de public/).
Read-only sobre o estoque; so escreve na quarentena e no inventario.

Uso:
    tools/generate-public-orphan-quarantine-20260806 --dry-run
    tools/generate-public-orphan-quarantine-20260806
"""
import argparse
import datetime
import hashlib
import json
import os
import shutil
import sys

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
PUBLIC = os.path.join(ROOT, "public")
PAGES = os.path.join(ROOT, "content/pages.json")
MANIFEST = os.path.join(ROOT, "data/editorial/published_manifest.jsonl")
QUARENTENA = os.path.join(ROOT, "data/ops/public_orphan_quarantine_20260806")
INVENTARIO = os.path.join(ROOT, "data/ops/public_orphan_quarantine_20260806.jsonl")


def rotas_conhecidas():
    with open(PAGES, encoding="utf-8") as handle:
        conhecidas = {p["path"] for p in json.load(handle)}
    with open(MANIFEST, encoding="utf-8") as handle:
        for linha in handle:
            linha = linha.strip()
            if linha:
                conhecidas.add(json.loads(linha)["path"])
    return conhecidas


def encontrar_orfaos(conhecidas):
    orfaos = []
    for raiz, _, arquivos in os.walk(PUBLIC):
        if "index.html" not in arquivos:
            continue
        relativo = os.path.relpath(raiz, PUBLIC)
        rota = "/" if relativo == "." else "/" + relativo.strip("/") + "/"
        if rota not in conhecidas:
            orfaos.append((rota, os.path.join(raiz, "index.html")))
    return sorted(orfaos)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    conhecidas = rotas_conhecidas()
    orfaos = encontrar_orfaos(conhecidas)
    if not orfaos:
        print("nenhum HTML orfao em public/ — nada a fazer.")
        return 0

    # Onde vive a versao legitima do mesmo slug. Sem substituto conhecido o
    # arquivo NAO sai: seria a unica copia de um conteudo, e o ganho de limpeza
    # nao paga a perda.
    substituto = {}
    for rota, _ in orfaos:
        slug = rota.strip("/").split("/")[-1]
        alternativas = sorted(p for p in conhecidas if p.endswith("/" + slug + "/") and p != rota)
        substituto[rota] = alternativas[0] if alternativas else ""

    moveis = [(r, a) for r, a in orfaos if substituto[r]]
    retidos = [(r, a) for r, a in orfaos if not substituto[r]]

    print("HTML orfao encontrado : %d" % len(orfaos))
    print("com versao legitima   : %d (serao movidos para quarentena)" % len(moveis))
    if retidos:
        print("SEM versao legitima   : %d (permanecem — unica copia)" % len(retidos))
        for rota, _ in retidos:
            print("    %s" % rota)

    if args.dry_run:
        print("\n--dry-run: nada foi movido.")
        for rota, _ in moveis[:10]:
            print("  %s  ->  substituto: %s" % (rota, substituto[rota]))
        return 0

    os.makedirs(QUARENTENA, exist_ok=True)
    agora = datetime.datetime.now(datetime.timezone.utc).isoformat()
    registros = []
    for rota, origem in moveis:
        with open(origem, "rb") as handle:
            dados = handle.read()
        destino = os.path.join(QUARENTENA, rota.strip("/").replace("/", "__") + ".html")
        shutil.move(origem, destino)
        # O diretorio so e removido se ficar vazio: nunca leva junto um irmao.
        try:
            os.rmdir(os.path.dirname(origem))
        except OSError:
            pass
        registros.append({
            "schema_version": "public_orphan_quarantine_v1",
            "quarantined_at": agora,
            "public_path": rota,
            "reason": "html_sem_pagina_correspondente_residuo_de_colisao_de_rota",
            "legitimate_equivalent": substituto[rota],
            "html_sha256": hashlib.sha256(dados).hexdigest(),
            "bytes": len(dados),
            "quarantine_file": os.path.relpath(destino, ROOT),
        })

    with open(INVENTARIO, "a", encoding="utf-8") as handle:
        for registro in registros:
            handle.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")

    print("\nmovidos para quarentena: %d" % len(registros))
    print("inventario             : %s" % os.path.relpath(INVENTARIO, ROOT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
