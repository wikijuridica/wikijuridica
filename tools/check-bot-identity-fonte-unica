#!/usr/bin/env python3
"""check-bot-identity-fonte-unica — a telemetria não pode conhecer bot que a política não governa.

READ-ONLY. Sai != 0 quando as cópias da lista de bots divergem fora do que este
arquivo declara, com data e motivo, como divergência CONHECIDA.

O PROBLEMA, MEDIDO EM 2026-08-26.

A lista de bots existe em três lugares:

    content/crawl_policy.json  (governança: robots.txt + tier de rate limit)  32 tokens
    internal/crawl/crawl.go    (DefaultBotRegistry, fonte do JSON acima)      32 tokens
    tools/botagents.py         (identidade da telemetria: AGENTES + FUNCAO)   45 chaves

As duas primeiras NÃO divergem: o JSON é gerado da segunda por
`cmd/generate-crawl-policy` e há teste byte a byte. A divergência real é a
terceira: **16 tokens que a TELEMETRIA conta e a POLÍTICA não governa**. (O plano
da sessão dizia 18; medido, são 16 — `bingpreview` é *marca* de `bingbot`, não
chave própria, e o plano contou marcas como se fossem chaves.)

POR QUE ISSO IMPORTA, e não é purismo. Um agente que a política não governa não
tem grupo em robots.txt, não tem tier de rate limit e não tem classe — ele cai no
curinga por omissão, não por decisão. Quatro dos 16 recebem, hoje, **pista
ilimitada no nginx** sem autorização nenhuma da política, e foi um gate irmão
(`check-bot-allowlist-derivada`) que descobriu isso. Os outros doze podem repetir
o mesmo caminho sem que nada acuse.

POR QUE ESTE GATE NÃO EXIGE FUSÃO IMEDIATA. Promover um token de observação a
token de governança tem consequência: `ValidatePolicy` passa a exigir grupo
próprio em robots.txt, e **criar grupo nomeado REMOVE dele as guardas do
curinga** (RFC 9309 §2.2.1 — é a armadilha que `validateGuardaDoCuringa` fecha).
Promover em bloco 16 tokens mudaria o robots.txt servido em 16 grupos de uma vez.
A decisão é por token, com doc oficial e refutação adversarial — o que este gate
faz é impedir que a lista cresça em SILÊNCIO, transformando drift novo em
vermelho e deixando o conhecido explícito, datado e com motivo.

REGRA: divergência nova reprova. Para declarar uma nova, acrescente-a a
DIVERGENCIA_CONHECIDA com motivo e data — o que obriga quem a cria a dizer por
que ela existe, em vez de descobri-la um mês depois num relatório.
"""

import argparse
import json
import os
import sys

RAIZ = os.environ.get("WIKI_ROOT", "/opt/wiki")
sys.path.insert(0, os.path.join(RAIZ, "tools"))
import botagents  # noqa: E402

POLITICA = os.path.join(RAIZ, "content", "crawl_policy.json")

# Token que a TELEMETRIA identifica e a POLÍTICA não governa, com o motivo de
# ainda não ter sido promovido. Data = quando a divergência foi conferida.
DIVERGENCIA_CONHECIDA = {
    # Os quatro com pista ilimitada no nginx sem autorização. Classificá-los é
    # trabalho pendente com bloqueio declarado: cada um exige grupo próprio em
    # robots.txt, e o do Yandex dispara a armadilha da substring (a doc oficial
    # diz, verbatim, que o robô procura "the substring Yandex (the case doesn't
    # matter) or *" e que, achando Yandex, "the User-agent: * string is
    # ignored") — um grupo com "Yandex" no nome desliga o curinga para a
    # FAMÍLIA inteira.
    # Os tres que estavam aqui -- google-inspectiontool, googleother e
    # storebot-google -- SAIRAM em 2026-08-30: foram CLASSIFICADOS no
    # content/crawl_policy.json, com classe valuable_search_or_user_bot e tier
    # unlimited_no_rate_limit, que e o que os dois nginx ja praticavam. A
    # divergencia era exatamente essa (o check-bot-allowlist-derivada contava 24
    # com pista ilimitada no conf contra 21 no registry); resolvida a causa, a
    # declaracao de divergencia vira ruido que reprova o gate por nada.
    # O `yandexbot` SAIU desta lista em 2026-08-30: ele entrou no registry, a
    # divergencia foi resolvida, e declaracao de divergencia que ja nao existe e
    # ruido que faz o gate reprovar por nada.
    #
    # ★ MAS A ARMADILHA QUE ELE DOCUMENTAVA CONTINUA VALENDO, e por isso o
    # conhecimento fica aqui: a doc oficial do Yandex diz, verbatim, que o robo
    # procura "the substring Yandex (the case doesn't matter) or *" e que, achando
    # Yandex, "the User-agent: * string is ignored". Um grupo com "Yandex" no nome
    # dentro do robots.txt DESLIGA o curinga para a familia inteira do Yandex --
    # entao criar esse grupo nao e detalhe de organizacao, e mudanca de politica
    # para todos os robos deles de uma vez.
    # Sub-agentes do Googlebot: o token de governança é `Googlebot`, e o grupo
    # dele já os cobre porque o casamento do REP é por prefixo de token. Separar
    # na telemetria é DELIBERADO — colapsá-los esconderia qual superfície do
    # Google está lendo o acervo.
    #
    # ★ `googlebot-image`, `googlebot-news`, `googlebot-video` e
    # `google-site-verification` SAÍRAM desta lista em 2026-09-10, pelo MESMO
    # motivo que os quatro de 2026-08-30: entraram em content/crawl_policy.json,
    # a divergência deixou de existir, e declaração de divergência resolvida é
    # ruído que reprova o gate por nada — foi exatamente o que ele acusou,
    # `divergencia_declarada_que_ja_foi_resolvida`, quatro vezes.
    #
    # O CONHECIMENTO FICA, porque ele não caducou: os três sub-agentes seguem
    # cobertos pelo grupo `Googlebot` no robots.txt por prefixo de token, e a
    # separação na telemetria continua deliberada. E `google-site-verification`
    # é fetcher disparado por usuário — a doc oficial do Google diz que esses
    # IGNORAM robots.txt, então a linha no robots seria decorativa e o
    # instrumento real continua sendo a faixa de IP
    # (data/ops/bot_ip_ranges/google-user-triggered.json).
    # Fetcher disparado por usuário: a doc do Google diz que esses IGNORAM
    # robots.txt. Linha no robots seria decorativa; o instrumento real para eles
    # é a faixa de IP, que já existe (data/ops/bot_ip_ranges/google-user-triggered.json).
    # Ferramenta do próprio operador do site, rodando de IP do Google. Tem
    # entrada de identidade para NÃO ser contada como Googlebot — foi assim que
    # 61 hits do PageSpeed viraram 13 quando a separação entrou.
    "chrome-lighthouse": ("2026-08-26", "ferramenta de diagnostico do proprio dono; identidade existe para nao inflar Googlebot"),
    # Sonda de prontidão da Cloudflare: infraestrutura, não crawler de conteúdo.
    "cloudflare-agentreadiness": ("2026-08-26", "sonda de infraestrutura, nao rastreia acervo"),
    # Ferramentas de SEO de terceiro. `semrushbot`, `ahrefsbot` e `mj12bot`
    # SAÍRAM DESTA LISTA em 2026-09-03: entraram no registry na classe nova
    # `seo_tool` (BotClassSEOTool, tier próprio de 300 r/m — ver
    # internal/crawl/crawl.go), junto de `DataForSeoBot`. `dotbot`, `blexbot`
    # e `dataforseo` (o produto sem o sufixo "bot" no token) continuam no
    # curinga: sem tráfego medido que justifique promover.
    "dotbot": ("2026-08-26", "SEO de terceiro, segue no curinga"),
    "blexbot": ("2026-08-26", "SEO de terceiro, segue no curinga"),
    "dataforseo": ("2026-08-26", "SEO de terceiro (produto sem o sufixo bot no token), segue no curinga"),
    # Monitores de MCP (liveness de /mcp e /a2a/v1), acrescentados em
    # 2026-09-03 SÓ em tools/botagents.py (função "mcp_scanner"), de propósito
    # fora do registry: não rastreiam o acervo, então não têm política de
    # crawl para declarar — content/crawl_policy.json governa acesso a
    # PÁGINA, e eles não pedem nenhuma.
    "sentineloracle": ("2026-09-03", "monitor de liveness de MCP, nao rastreia acervo, sem crawl a governar"),
    "mcpbeat": ("2026-09-03", "monitor de liveness de MCP, nao rastreia acervo, sem crawl a governar"),
    "zevruna-monitor": ("2026-09-03", "monitor de liveness de MCP, nao rastreia acervo, sem crawl a governar"),
    # ENTRARAM EM 2026-09-16 na telemetria (tools/botagents.py) e de proposito
    # AINDA NAO no registry. Os tres sao os agentes declarados de maior volume
    # que a telemetria nao conhecia -- medido na borda, janela de 24h ate
    # encerrada em 2026-09-16T16:00:00Z: AhrefsSiteAudit 5.859 requisicoes,
    # Baiduspider 1.147, Baiduspider-render 31.
    #
    # POR QUE NAO PROMOVER JUNTO, e o bloqueio e concreto: promover cria grupo
    # nomeado em public/robots.txt, e grupo nomeado REMOVE do agente as guardas
    # do curinga (RFC 9309 s2.2.1). No caso do Baidu isso e mudanca de politica
    # de SEO servida a um buscador vivo, sem ordem -- e a regra de zero
    # regressao do contrato proibe mexer em robots sem ordem. Medir primeiro,
    # promover com a medicao na mao, e a rota conservadora que ainda entrega:
    # a identidade ja existe, entao o volume dos tres para de ser invisivel HOJE.
    "ahrefssiteaudit": ("2026-09-16", "auditoria de site contratada por terceiro; promover exige grupo proprio em robots.txt, que remove as guardas do curinga"),
    "baiduspider": ("2026-09-16", "buscador vivo; grupo nomeado em robots.txt muda a politica servida a ele, e isso e ordem, nao efeito colateral de telemetria"),
    "baiduspider-render": ("2026-09-16", "mesmo operador do baiduspider, mesma razao; separado na telemetria para nao colapsar render com rastreio"),
}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    with open(POLITICA, encoding="utf-8") as handle:
        politica = json.load(handle)
    governados = {e["user_agent"].lower() for e in politica["bot_registry"]}
    governados.discard("*")

    identificados = {chave for chave, _ in botagents.AGENTES}
    com_funcao = set(botagents.FUNCAO)

    problemas = []

    # (1) Consumidor conhece token que a fonte não tem — a direção que produziu
    #     os quatro com pista ilimitada.
    for token in sorted(identificados - governados):
        if token not in DIVERGENCIA_CONHECIDA:
            problemas.append(("telemetria_conhece_bot_que_a_politica_nao_governa", token,
                              "acrescente a DIVERGENCIA_CONHECIDA com motivo e data, ou classifique no registry"))

    # (2) Fonte tem token que o consumidor não identifica: bot governado cujo
    #     tráfego a telemetria não sabe contar — governança sem medição.
    for token in sorted(governados - identificados):
        problemas.append(("politica_governa_bot_que_a_telemetria_nao_identifica", token,
                          "acrescente a marca em tools/botagents.AGENTES"))

    # (3) Coerência interna do consumidor: identidade sem função declarada cai em
    #     "unknown" e some dos relatórios agrupados por função.
    for token in sorted(identificados - com_funcao):
        problemas.append(("identidade_sem_funcao_declarada", token,
                          "acrescente em tools/botagents.FUNCAO"))
    for token in sorted(com_funcao - identificados):
        problemas.append(("funcao_sem_identidade_correspondente", token,
                          "FUNCAO declara token que AGENTES nao reconhece"))

    # (4) Divergência declarada que já não existe: entrada morta em
    #     DIVERGENCIA_CONHECIDA mente sobre o estado atual, e comentário que
    #     mente é bug.
    for token in sorted(DIVERGENCIA_CONHECIDA):
        if token in governados:
            problemas.append(("divergencia_declarada_que_ja_foi_resolvida", token,
                              "o token entrou no registry; remova de DIVERGENCIA_CONHECIDA"))
        elif token not in identificados:
            problemas.append(("divergencia_declarada_para_token_inexistente", token,
                              "a telemetria nao identifica mais este token"))

    print("politica governa %d token(s) | telemetria identifica %d | divergencia declarada %d"
          % (len(governados), len(identificados), len(DIVERGENCIA_CONHECIDA)))
    for tipo, token, detalhe in problemas:
        print("  - %-52s %-26s %s" % (tipo, token, detalhe))
    if args.json:
        print(json.dumps({"governados": sorted(governados),
                          "identificados": sorted(identificados),
                          "problemas": problemas}, ensure_ascii=False, indent=2))
    if problemas:
        print("check-bot-identity-fonte-unica: FAIL")
        return 1
    print("check-bot-identity-fonte-unica: OK — nenhuma divergencia nova")
    return 0


if __name__ == "__main__":
    sys.exit(main())
