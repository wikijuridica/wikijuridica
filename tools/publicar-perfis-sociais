#!/usr/bin/env bash
# publicar-perfis-sociais — publica as pecas do acervo nos perfis oficiais
# (Instagram, Facebook e LinkedIn) do portal.
#
# Wrapper na convencao de tools/: roda de QUALQUER diretorio. Sem ele o comando
# so funcionava depois de um `cd tools/publicador-social`, e a primeira coisa
# que aconteceu foi exatamente o `node publicar.mjs` na raiz falhar com
# MODULE_NOT_FOUND. Caminho que exige lembrar de um cd e caminho que quebra.
#
# Instala a dependencia sozinho na primeira execucao: playwright-core, versao
# fixada no package.json, sem baixar navegador (usa o Chrome ja instalado).
#
# USO
#   ./tools/publicar-perfis-sociais --login                   uma vez, o titular autentica
#   ./tools/publicar-perfis-sociais --listar
#   ./tools/publicar-perfis-sociais --rede instagram --todas --dry-run
#   ./tools/publicar-perfis-sociais --rede facebook  --todas
#   ./tools/publicar-perfis-sociais --rede linkedin  --peca 01
#
# Redes: instagram | facebook | linkedin
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$RAIZ/tools/publicador-social"

if [ ! -f "$APP/publicar.mjs" ]; then
	echo "ERRO: $APP/publicar.mjs nao encontrado — a arvore do repo esta incompleta." >&2
	exit 1
fi

command -v node >/dev/null 2>&1 || {
	echo "ERRO: node nao esta no PATH." >&2
	exit 1
}

# DISPLAY VIRTUAL OBRIGATORIO. O navegador do agente NUNCA roda em :0 — a tela
# do dono tem uma VM anexada por `virt-viewer --attach` com PJe/e-SAJ e o token
# de assinatura dele, e virt-viewer encaminha teclado e mouse para dentro do
# guest. Em :99 isso fica inalcancavel POR CONSTRUCAO: sao servidores X
# distintos, com sockets distintos (/tmp/.X11-unix/X0 e X99). Ver
# docs/adr/2026-08-27-xvfb-display-virtual-para-agente.md
#
# EXCECAO UNICA: --login, onde o TITULAR digita credencial e precisa ver a tela.
DISPLAY_AGENTE=":99"
if [ "${1:-}" != "--login" ]; then
	if ! pgrep -x Xvfb >/dev/null 2>&1; then
		command -v Xvfb >/dev/null 2>&1 || {
			echo "ERRO: Xvfb ausente. sudo apt install xvfb" >&2
			exit 1
		}
		echo "subindo display virtual $DISPLAY_AGENTE ..." >&2
		setsid Xvfb "$DISPLAY_AGENTE" -screen 0 1440x1000x24 -nolisten tcp </dev/null >/tmp/xvfb99.log 2>&1 &
		sleep 2
	fi
	export DISPLAY="$DISPLAY_AGENTE"
fi

# A dependencia se instala sozinha na primeira vez: pedir ao dono que rode
# `npm install` antes e terceirizar um passo que o script sabe fazer.
if [ ! -d "$APP/node_modules/playwright-core" ]; then
	echo "instalando a dependencia (playwright-core, sem baixar navegador)..." >&2
	(cd "$APP" && npm install --no-audit --no-fund --silent) || {
		echo "ERRO: falhou instalar playwright-core em $APP" >&2
		exit 1
	}
fi

# --gravar: abre o navegador e ANOTA os cliques do titular, para que os
# seletores saiam de medicao e nao de tentativa. Nao publica nada sozinho.
if [ "${1:-}" = "--gravar" ]; then
	shift
	exec node "$APP/gravar-fluxo.mjs" "$@"
fi

exec node "$APP/publicar.mjs" "$@"
