#!/usr/bin/env python3
"""generate-v2-portfolio-hint-restore-20260805 — refaz a normalizacao de
source_hints do portfolio_v2 SEM perder granularidade juridica.

POR QUE EXISTE. A passada de 2026-08-04 deixou a worktree de
data/editorial/portfolio_v2 com 2.900 registros alterados e 2.595 mapeamentos
distintos que nao sao apenas grosseiros — sao FONTE TROCADA:
    'RN 195/2009 (ANS)'   -> ans-rn-557-2022-...   (outra norma)
    'RN 438/2018 (ANS)'   -> ans-carencia          (outra fonte)
    'leis-estaduais-itcmd'-> cf-1988-art-155-i     (outra fonte)
    'mec'                 -> cf-1988               (outra fonte)
    'Policia Federal'     -> lei-13445-2017        (outra fonte)
    'TNU'                 -> jurisprudencia-stj    (outro tribunal)
    'stf-tema-987'        -> stf                   (perde o tema)
Apontar a intencao para norma diferente da pesquisada e inventar proveniencia,
o pior erro do projeto. Aquele resultado e derivado e regeneravel: esta
ferramenta o substitui ESCREVENDO POR CIMA a partir dos source_hints do HEAD,
so para frente, sem nenhum comando de retorno de estado do controle de versao.

O QUE FAZ. Para cada registro: mantem a linha da WORKTREE (preserva trabalho
concorrente nao commitado, como long_tail_query) e troca somente source_hints
pelo valor do HEAD com alias de IDENTIDADE EXATA aplicado. O alias so casa
quando diploma, orgao, numero do ato, ano, artigo (com sufixo de letra) e
qualificadores coincidem; qualquer perda ou troca reprova e o hint permanece
literal, para curadoria de catalogo. Nunca inventa fonte, nunca grosseiriza.

PREIMAGEM. Toda alteracao vira registro em
data/editorial/portfolio_v2_freetext_hint_preimage.jsonl com hints do HEAD,
hints da worktree suja e hints finais — a passada anterior fica auditavel.

Uso:
  tools/generate-v2-portfolio-hint-restore-20260805 --dry-run
  tools/generate-v2-portfolio-hint-restore-20260805 --apply
"""
import argparse
import collections
import contextlib
import datetime as dt
import json
import os
import pathlib
import subprocess
import sys
import tempfile

ROOT = pathlib.Path("/opt/wiki")
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / ".agents/runtime/staging"))

from hint_alias_resolve_20260805 import Resolver  # noqa: E402
from tools.v2_stock_epoch import (  # noqa: E402
    StockEpochBusy, canonical_stock_write_lease,
)

PORTFOLIO = ROOT / "data/editorial/portfolio_v2"
CATALOG = ROOT / "data/editorial/v2_source_hint_catalog.json"
PREIMAGE = ROOT / "data/editorial/portfolio_v2_freetext_hint_preimage.jsonl"
REPORT = ROOT / ".agents/runtime/staging/freetext_resolution_report.json"


def atomic_write(path, payload):
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise


def head_hints(rel_path):
    done = subprocess.run(["git", "-C", str(ROOT), "show", f"HEAD:{rel_path}"],
                          capture_output=True, text=True)
    if done.returncode != 0:
        return None
    out = {}
    for line in done.stdout.splitlines():
        if line.strip():
            record = json.loads(line)
            out[record.get("intent_id")] = record.get("source_hints")
    return out


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if args.apply == args.dry_run:
        parser.error("escolha --apply ou --dry-run")

    catalog = json.loads(CATALOG.read_text(encoding="utf-8"))["source_hints"]
    resolver = Resolver(catalog)
    aplicados = {}
    sem_match = collections.Counter()
    preimages = []
    resumo = collections.Counter()

    stack = contextlib.ExitStack()
    if args.apply:
        try:
            stack.enter_context(canonical_stock_write_lease(ROOT))
        except StockEpochBusy as error:
            print(f"estoque canonico ocupado: {error}", file=sys.stderr)
            return 75

    for path in sorted(PORTFOLIO.glob("*.jsonl")):
        rel = path.relative_to(ROOT).as_posix()
        base = head_hints(rel)
        if base is None:
            resumo["shard_ausente_no_head"] += 1
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        changed = 0
        for index, line in enumerate(lines):
            if not line.strip():
                continue
            record = json.loads(line, object_pairs_hook=collections.OrderedDict)
            intent = record.get("intent_id")
            origem = base.get(intent)
            atual = record.get("source_hints")
            if not isinstance(origem, list) or not isinstance(atual, list):
                continue
            final = []
            for hint in origem:
                alvo, motivo = resolver.resolve(hint)
                if alvo is None:
                    final.append(hint)
                    sem_match[hint] += 1
                else:
                    if alvo != hint:
                        aplicados[hint] = alvo
                    final.append(alvo)
            final = list(dict.fromkeys(final))
            if final == atual:
                continue
            preimages.append({
                "shard": path.name,
                "intent_id": intent,
                "source_hints_head": list(origem),
                "source_hints_worktree_20260804": list(atual),
                "source_hints_final": list(final),
            })
            record["source_hints"] = final
            lines[index] = json.dumps(record, ensure_ascii=False,
                                      separators=(", ", ": "))
            changed += 1
        resumo["registros_alterados"] += changed
        if changed and args.apply:
            atomic_write(path, ("\n".join(lines) + "\n").encode("utf-8"))
            print(f"{path.name}: {changed} registros")
        elif changed:
            print(f"[dry-run] {path.name}: {changed} registros")

    stack.close()

    if args.apply:
        stamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        with open(PREIMAGE, "a", encoding="utf-8") as ledger:
            for item in preimages:
                item["registrado_em"] = stamp
                ledger.write(json.dumps(item, ensure_ascii=False) + "\n")
        REPORT.write_text(json.dumps({
            "gerado_em": stamp,
            "ferramenta": "generate-v2-portfolio-hint-restore-20260805",
            "registros_alterados": resumo["registros_alterados"],
            "preimagem": PREIMAGE.relative_to(ROOT).as_posix(),
            "aplicados": dict(sorted(aplicados.items())),
            "sem_match_top": sorted(sem_match.items(),
                                    key=lambda kv: (-kv[1], kv[0]))[:120],
            "sem_match_distintos": len(sem_match),
            "sem_match_ocorrencias": sum(sem_match.values()),
        }, ensure_ascii=False, indent=1), encoding="utf-8")
        print("relatorio:", REPORT)
    print("registros alterados:", resumo["registros_alterados"])
    print("aliases aplicados (distintos):", len(aplicados))
    print("hints sem catalogo:", len(sem_match), "distintos /",
          sum(sem_match.values()), "ocorrencias")
    return 0


if __name__ == "__main__":
    sys.exit(main())
