#!/bin/bash
# check-claude-working-repaint — um Claude ESPERANDO a API repinta o pane?
#
# É a medição que decide se o `ai-session-reaper` pode existir como automatismo.
#
# Já se sabe (tools/check-claude-idle-repaint.sh) que o TUI parado NO PROMPT fica
# mudo: `window_activity` não avança em 120s. E sabe-se que os outros sinais não
# alcançam trabalho LLM-bound: subagente não vira processo, o CPU de uma sessão
# com agente ativo mediu 6 jiffies/s (contra 1,5 do ocioso — faixa estreita), e a
# contagem de conexões mede idade da sessão, não atividade.
#
# Resta a pergunta que separa as duas situações que PARECEM iguais para o reaper:
# "parado no prompt" e "aguardando resposta". Se o spinner de espera repinta o
# pane, `window_activity` e o hash da tela distinguem as duas, e o predicado é
# seguro. Se não repinta, nenhum sinal local distingue — e o automatismo não deve
# existir na forma atual.
#
# Manda uma pergunta ao TUI e observa o pane enquanto a resposta é gerada.
# Sessão própria com prefixo `workprobe-`, removida ao sair.

set -uo pipefail
S="workprobe-$$"

limpar() { tmux kill-session -t "=$S" 2>/dev/null; }
trap limpar EXIT INT TERM

# ATENÇÃO ao target: o prefixo `=` (match exato) funciona em `list-panes`,
# `has-session` e `kill-session`, mas devolve VAZIO em `capture-pane`,
# `show-options` e `display-message` (medido, tmux 3.5a). A primeira versão deste
# script usava `-t "=$S"` no capture-pane e recebia string vazia — cujo sha256 é
# o famoso e3b0c442… — em toda amostra. O hash "não mudava" porque não havia
# hash: a medição parecia provar que o Claude não repinta, e não media nada.
wa() { tmux display-message -p -t "$S" '#{window_activity}' 2>/dev/null; }
hash_tela() { tmux capture-pane -p -t "$S" 2>/dev/null | sha256sum | cut -c1-12; }

tmux new-session -d -s "$S" -x 120 -y 40 \
	'cd /opt/wiki && claude --permission-mode bypassPermissions' 2>/dev/null || {
	echo "não foi possível criar a sessão"
	exit 2
}

echo "aguardando o startup assentar..."
command sleep 50

w0=$(wa)
h0=$(hash_tela)
echo "estado ocioso:  window_activity=$w0  hash=$h0"

# pergunta longa o bastante para a resposta levar dezenas de segundos
tmux send-keys -t "$S" 'Explique em tres paragrafos o que e o teorema de Godel, sem pressa.' 2>/dev/null
command sleep 1
tmux send-keys -t "$S" Enter 2>/dev/null
echo "pergunta enviada; observando enquanto responde"
echo

t0=$(date +%s)
mudou_wa=0
mudou_hash=0
for _ in $(seq 1 12); do
	command sleep 5
	w=$(wa)
	h=$(hash_tela)
	dt=$(($(date +%s) - t0))
	[ "$w" != "$w0" ] && mudou_wa=1
	[ "$h" != "$h0" ] && mudou_hash=1
	printf '  t=%3ss  window_activity %s  hash %s\n' "$dt" \
		"$([ "$w" != "$w0" ] && echo "MUDOU (Δ$((w - w0))s)" || echo "igual")" \
		"$([ "$h" != "$h0" ] && echo MUDOU || echo igual)"
done

echo
if [ "$mudou_wa" -eq 1 ] || [ "$mudou_hash" -eq 1 ]; then
	echo "  VEREDITO: um Claude TRABALHANDO repinta o pane."
	echo "            window_activity e/ou o hash da tela distinguem 'aguardando"
	echo "            resposta' de 'parado no prompt'. O predicado do reaper alcança"
	echo "            o estado que o CPU e a contagem de processos não veem."
	exit 0
fi
echo "  VEREDITO: um Claude trabalhando NÃO repinta de forma detectável."
echo "            Nenhum sinal local separa 'trabalhando' de 'parado'. Um reaper"
echo "            automático mataria trabalho; ele deve ficar em modo relatório."
exit 1
