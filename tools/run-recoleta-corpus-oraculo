#!/usr/bin/env bash
# run-recoleta-corpus-oraculo — recoleta o corpus-oraculo vencido e deixa o
# gate consistente na MESMA execucao.
#
# POR QUE ESTE RUNNER EXISTE (2026-09-04)
#
# O corpus-oraculo (data/source-snapshots) sustenta toda afirmacao juridica do
# acervo. Medido em 2026-09-04, antes desta automacao:
#
#   - manifest.jsonl estava congelado em 21/07/2026 19:49;
#   - as 6.775 linhas tinham next_check_at VAZIO: nada sabia quando revisitar;
#   - last_verified_at parado em 21/07 e a idade maxima do auditor e de 90
#     dias, entao o acervo INTEIRO passaria a acusar verification_stale em
#     19/10/2026 - sozinho, sem ninguem mexer em nada;
#   - o gate source-snapshot-corpus ja estava vermelho com 121 dispositivos
#     REVOGADOS gravados como vigentes.
#
# Ou seja: mais um estado em que o sistema entra sozinho (o tempo passa) e do
# qual so sai se alguem lembrar. E a mesma familia do recheck de evidencia de
# fonte e do shard de sitemap em carencia.
#
# A ORDEM DOS TRES PASSOS NAO E OPCIONAL
#
# Recoletar muda o manifest, e o repair-journal fixa (CAS) o sha256 do
# manifest que ele cobre. Um manifest novo com journal velho deixa
# EvaluateQuarantineCoverage sem cobertura, e OpenGroundingStore falha FECHADO
# - o que derruba o boot do grounding. Por isso recoleta, replanejamento do
# journal e verificacao vivem numa unidade so: se o passo 1 rodou, os passos 2
# e 3 TEM de rodar.
#
# Tudo sob o mesmo flock que o repo usa para comando pesado: a maquina roda
# varios agentes e ja chegou a load 52 por nao serializar.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# ---- PROTECAO CRASH->2 (2026-09-16). A unit que chama este script mascara
# exit 1 (`SuccessExitStatus=0 1`), porque 1 e VEREDITO do gate de corpus. Sem
# esta protecao, qualquer comando que morresse com 1 sob `set -e` sairia 1
# tambem, a mascara o converteria em `Result=success` e o OnFailure ficaria mudo.
#
# Aqui a variante e a trap ERR, e nao a EXIT, porque este script TEM `set -e`:
# a ERR trap so ve a falha de comando, e deixa os `exit` deliberados do fim
# (`exit 2` da coleta, `exit "$gate"` do veredito) passarem intactos — sem
# precisar anotar nenhum deles.
. "$ROOT/tools/lib/saida_de_medidor.sh"
medidor_protege_err

GO="$ROOT/tools/go-modern"
CORPUS_ROOT="${CORPUS_ROOT:-data/source-snapshots}"
JOURNAL="$CORPUS_ROOT/repair-journal.jsonl"
BUDGET="${BUDGET:-25m}"

log() { printf '%s recoleta-corpus: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

# --- passo 1: recoleta o que venceu, canal por canal --------------------------
# Cada canal e uma fonte oficial publica, sem chave de API. Um canal fora do ar
# NAO pode impedir os outros nem, principalmente, impedir os passos 2 e 3: a
# falha e registrada e a execucao segue.
#
# POR QUE --normas-fulltext NAO ESTA NA LISTA PADRAO (medido em 2026-09-04)
#
# A varredura ampla do canal normas.leg.br foi ENSAIADA numa copia isolada do
# corpus antes de qualquer escrita no acervo real: 843 documentos, 518 com
# rede, 256 alterados. O resultado auditado pelo proprio gate:
#
#   total de issues       451 -> 868
#   placeholder_head       58 -> 351   (+293)
#   device_heading_mismatch 48 -> 175   (+127)
#   revoked_head_marked_vigente 121 -> 117 (so -4)
#
# Ou seja: a varredura ampla PIORA o corpus quase o dobro, trazendo centenas
# de series cujo texto consolidado vira placeholder ou cabecalho divergente,
# em troca de quatro correcoes. Ligar isso num timer semanal injetaria a
# regressao toda semana. O canal fica fora do padrao ate a segmentacao do
# consolidado de normas.leg.br ser tratada; a evidencia da ensaiada esta
# registrada no relatorio da frente.
#
# ESSA JUSTIFICATIVA MORREU EM 2026-09-10, e o paragrafo fica porque a
# decisao continua valendo por OUTRO motivo. Os dois numeros que a
# sustentavam vinham de detectores desde entao provados falso-positivos:
#
#   - placeholder_head media CONTENCAO de omissao pontilhada onde o
#     comentario dela dizia "dominado por essa notacao". Medido caso a caso
#     sobre os 58 do acervo: 47 eram artigo ALTERADOR completo, com os pontos
#     dentro da transcricao. Corrigido em 3151d21a, a contagem viva caiu para
#     8 (commit com teste de falso positivo);
#   - device_heading_mismatch era falso positivo em 60 de 60 ocorrencias
#     ("Art. 6o-A" recortado como "6"), corrigido no detector no mesmo dia e
#     declarado em ZERO no teto de known_issue_ceiling_test.go.
#
# Logo, "+293 placeholder_head e +127 device_heading_mismatch" media, em boa
# parte, os proprios detectores - nao o corpus.
#
# O QUE FOI MEDIDO DE NOVO, e o que NAO foi. Ensaio dirigido em copia isolada
# em 2026-09-10, com o detector corrigido, sobre as 11 URNs da familia do
# fatiamento na citacao (6194, 8078, 8245, 10522, 10820, 11096, 11340, 11445,
# 13105, 13709, 14544): 17 documentos planejados, 17 com rede, 8 alterados,
# 107 linhas novas no manifest. O gate foi de 266 para 253 issues -
# amending_head_truncated_at_quote 30 -> 19 e placeholder_head 8 -> 5, sem
# mover closed_version_still_vigente nem successor_retroactive_start (53/53
# nos dois lados). Isto e: a recoleta DIRIGIDA melhora o corpus.
#
# Isso NAO mede a varredura ampla. O ensaio de 2026-09-04 rodou 843
# documentos, 518 com rede e 256 alterados; este rodou 17 e alterou 8.
# Apresentar 8 documentos como populacao seria exatamente o que a R3 do
# contrato proibe. Entao: a razao escrita acima esta morta, o numero da
# varredura ampla continua NAO MEDIDO com os detectores de hoje, e por isso o
# canal continua fora da lista padrao ate alguem re-ensaiar os 843.
#
# Para rodar outro conjunto de canais deliberadamente:
#   CANAIS="--camara-legin --normas-fulltext" tools/run-recoleta-corpus-oraculo
falhas=0
for canal in ${CANAIS:---camara-legin}; do
	log "coletando $canal"
	if ! "$GO" run ./cmd/collect-oracle "$canal" \
		--corpus-root "$CORPUS_ROOT" \
		--somente-vencidos \
		--budget "$BUDGET"; then
		log "FALHA no canal $canal (segue para os proximos passos)"
		falhas=$((falhas + 1))
	fi
done

# --- passo 2: reconcilia o journal com o manifest novo ------------------------
# O CAS e obrigatorio: --append so grava se o sha lido agora for o mesmo que o
# planejador viu, o que impede duas execucoes concorrentes de intercalar
# registros.
log "reconciliando repair-journal"
# O sha esperado e o hash do arquivo inteiro, no mesmo formato que
# sourcesnapshotaudit.hashBytes produz ("sha256:" + hex). Journal ausente usa
# o hash do vazio, que e o que ReadJournalRecords devolve nesse caso.
if [ -s "$JOURNAL" ]; then
	journal_sha="sha256:$(sha256sum "$JOURNAL" | awk '{print $1}')"
else
	journal_sha="sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
fi
"$GO" run ./cmd/plan-source-snapshot-repair \
	--root "$CORPUS_ROOT" \
	--journal "$JOURNAL" \
	--append \
	--expected-journal-sha256 "$journal_sha"

# --- passo 3: prova que o corpus ficou consistente ----------------------------
# Exit 1 aqui significa "gate vermelho", que e informacao, nao crash: a unit
# declara SuccessExitStatus=1 e o relatorio fica no journal do systemd.
log "verificando o corpus"
# `set -e` aborta antes de ler $?; o `|| gate=$?` preserva o codigo do gate.
gate=0
"$GO" run ./cmd/check-source-snapshot-corpus --root "$CORPUS_ROOT" >/dev/null || gate=$?

if [ "$falhas" -gt 0 ]; then
	log "$falhas canal(is) falharam na coleta"
	exit 2
fi
exit "$gate"
