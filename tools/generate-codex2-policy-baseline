#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
# O artefato material e o baseline em si. Declarado explicitamente porque a
# resolucao automatica de run-generate-supervised so procura *.jsonl, e este
# artefato e um JSON unico e datado, nao uma serie de linhas.
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/codex2_policy_baseline.json}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-codex2-policy-baseline}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/codex2_policy_baseline.json}"
exec "$ROOT/tools/run-generate-supervised" ./cmd/generate codex2-policy-baseline "$@"
