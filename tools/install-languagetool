#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
VERSION="${WIKI_LANGUAGETOOL_VERSION:-6.8}"
# Repo M2 e Maven em .toolchains/ (persistente): em /tmp eles são varridos e o
# classpath.txt do run-languagetool-local passa a apontar para jars inexistentes
# (ClassNotFoundException: org.slf4j.LoggerFactory ao subir o servidor).
M2_REPO="${WIKI_M2_REPO:-$ROOT/.toolchains/m2}"
MAVEN="${WIKI_MAVEN_BIN:-$ROOT/.toolchains/maven/apache-maven-3.9.16/bin/mvn}"
CACHE_DIR="$ROOT/.cache/languagetool/$VERSION"
MAIN_JAR="$M2_REPO/org/languagetool/languagetool-server/$VERSION/languagetool-server-$VERSION.jar"

mkdir -p "$CACHE_DIR"

POM="$(mktemp /tmp/opt-wiki-languagetool-pom.XXXXXX.xml)"
cleanup() {
	rm -f "$POM"
}
trap cleanup EXIT

cat >"$POM" <<XML
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>portaljuridico.ops</groupId>
  <artifactId>languagetool-local-classpath</artifactId>
  <version>1.0.0</version>
  <dependencies>
    <dependency>
      <groupId>org.languagetool</groupId>
      <artifactId>languagetool-server</artifactId>
      <version>$VERSION</version>
    </dependency>
  </dependencies>
</project>
XML

"$MAVEN" -q -Dmaven.repo.local="$M2_REPO" -f "$POM" dependency:get -Dartifact="org.languagetool:languagetool-server:$VERSION"
"$MAVEN" -q -Dmaven.repo.local="$M2_REPO" -f "$POM" dependency:build-classpath -Dmdep.outputFile="$CACHE_DIR/classpath.txt" -DincludeScope=runtime

cp "$MAIN_JAR" "$CACHE_DIR/languagetool-server-$VERSION.jar"
sha256sum "$CACHE_DIR/languagetool-server-$VERSION.jar" >"$CACHE_DIR/languagetool-server-$VERSION.jar.sha256"

printf 'languagetool: version=%s jar=%s m2=%s publication=false\n' "$VERSION" "$CACHE_DIR/languagetool-server-$VERSION.jar" "$M2_REPO"
