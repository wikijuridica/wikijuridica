#!/usr/bin/env python3
"""check-robots-parser-real — o robots.txt conferido por PARSER, não por leitura.

POR QUE EXISTE, e o episódio que o obrigou: em 2026-08-12 acrescentei
`Content-Signal:` aos 28 grupos do robots.txt e declarei o risco como "≈ zero",
apoiado na RFC 9309 §2.2.3 — que manda o parser ignorar linha desconhecida — e em
dois parsers do próprio repositório que de fato a ignoram. O Bing Webmaster
passou a reportar **erro de sintaxe**, com a URL em "Discovered but not crawled".
Ignorar a linha e não acusar erro por causa dela são coisas diferentes.

No mesmo trabalho ficaram dois defeitos que a leitura não mostra e o parser sim:
`Allow: /` emitido ANTES de `Disallow: /buscar/` (para a família *first-match*,
ainda viva, isso LIBERA o caminho) e `Applebot` declarado antes de
`Applebot-Extended` (parser que casa user-agent por prefixo dá o grupo genérico
ao bot específico). Os dois foram corrigidos em f71a0f3e.

Esta ferramenta existe para que a próxima mudança no robots seja medida antes de
ir ao ar, e não depois que um operador de busca reclama. READ-ONLY.
"""
from __future__ import annotations

import argparse
import io
import os
import sys
import urllib.robotparser

ROOT = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))

# As diretivas que o padrão define (RFC 9309) mais as duas extensões que TODO
# operador relevante entende e documenta. Qualquer outra é "não-padrão": pode ser
# ignorada por um parser e virar erro no validador de outro — que foi exatamente
# o que aconteceu com Content-Signal.
DIRETIVAS_CONHECIDAS = {"user-agent", "disallow", "allow", "sitemap", "crawl-delay"}

# Quem PRECISA ler o acervo. A lista sai do papel que cada um cumpre: buscar,
# responder pergunta de pessoa, ou citar a fonte.
BOTS_QUE_PRECISAM_DO_ACERVO = [
    "Googlebot", "bingbot", "adidxbot", "Applebot", "Amazonbot",
    "ChatGPT-User", "OAI-SearchBot", "Claude-User", "Claude-SearchBot",
    "PerplexityBot", "Perplexity-User", "DuckDuckBot", "DuckAssistBot",
    "meta-externalfetcher", "Amzn-SearchBot", "Amzn-User",
    "MistralAI-Index", "MistralAI-User",
    # Cadastrados em 2026-08-13: Meta-WebIndexer (busca/citação do Meta AI) e
    # os unfurlers de rede social (card de compartilhamento é caminho de
    # descoberta e de backlink).
    "Meta-WebIndexer", "facebookexternalhit", "Slackbot-LinkExpanding",
]

# Bots de treinamento: o acervo é liberado (DEC-023, ordem do titular), mas a
# busca interna não — ela é noindex e gera URL infinita.
BOTS_DE_TREINAMENTO = [
    "GPTBot", "ClaudeBot", "CCBot", "Bytespider", "Google-Extended",
    "Applebot-Extended", "meta-externalagent", "MistralAI-Training", "Amazonbot",
]

ROTA_DE_ACERVO = "/consumidor/"
ROTA_DE_BUSCA = "/buscar/?q=teste"


def carrega(caminho: str) -> tuple[str, urllib.robotparser.RobotFileParser]:
    texto = io.open(caminho, encoding="utf-8").read()
    parser = urllib.robotparser.RobotFileParser()
    parser.parse(texto.splitlines())
    return texto, parser


# Grupos de User-agent que NAO podem receber diretiva nao-padrao, por dano medido.
#
# Em 2026-08-12/13 o site emitia "Content-Signal:" em 28 grupos, entre eles o do
# proprio Bingbot; o Bing Webmaster passou a reportar erro de sintaxe e a URL caiu
# para "Discovered but not crawled" (revertido em f71a0f3e). A diretiva voltou em
# 2026-08-19 por ordem do dono, na forma seletiva: sai em todo grupo MENOS nestes.
#
# Esta lista espelha content/crawl_policy.json -> content_signal_skip_groups. A
# duplicacao e proposital: este check le o ARQUIVO SERVIDO, sem carregar a config,
# porque e o arquivo que o validador do operador enxerga.
GRUPOS_SEM_DIRETIVA_NAO_PADRAO = {"bingbot", "adidxbot"}


def diretivas_nao_padrao(texto: str) -> list[str]:
    """Acusa diretiva fora da RFC 9309 SO onde ela custa caro.

    A versao anterior acusava qualquer ocorrencia no arquivo, e por isso reprovava
    a declaracao inteira. Mas a RFC 9309 §2.2.4 ("Other Records") manda o parser
    ignorar registro que nao reconhece -- "Parsing of other records MUST NOT
    interfere with the parsing of explicitly defined records" --, e os dois parsers
    reais deste repositorio fazem isso, o que este mesmo arquivo comprova mais
    abaixo. O problema nunca foi o parser: foi o VALIDADOR de um operador
    especifico. Entao o que se protege e o grupo dele, nao o arquivo todo.
    """
    achadas = []
    grupo_atual = ""
    for numero, linha in enumerate(texto.splitlines(), 1):
        limpa = linha.split("#", 1)[0].strip()
        if not limpa or ":" not in limpa:
            if not limpa:
                grupo_atual = ""  # linha em branco encerra o grupo
            continue
        chave, _, valor = limpa.partition(":")
        chave = chave.strip().lower()
        if chave == "user-agent":
            grupo_atual = valor.strip().lower()
            continue
        if chave in DIRETIVAS_CONHECIDAS:
            continue
        if grupo_atual in GRUPOS_SEM_DIRETIVA_NAO_PADRAO:
            achadas.append(
                "linha %d, no grupo %r (validador deste operador ja acusou erro): %r"
                % (numero, grupo_atual, limpa[:80])
            )
    return achadas


def grupos_fora_de_ordem(texto: str) -> list[str]:
    """User-agent específico tem de vir ANTES do genérico que o prefixa.

    Parser que casa por prefixo — e eles existem — atribui o primeiro grupo cujo
    token seja prefixo do user-agent. Com `Applebot` antes de
    `Applebot-Extended`, o bot de treinamento herda o grupo do bot de busca.
    """
    agentes = []
    for linha in texto.splitlines():
        limpa = linha.split("#", 1)[0].strip()
        if limpa.lower().startswith("user-agent:"):
            agentes.append(limpa.split(":", 1)[1].strip())
    problemas = []
    for i, atual in enumerate(agentes):
        for posterior in agentes[i + 1:]:
            if posterior != atual and posterior.lower().startswith(atual.lower()) and atual != "*":
                problemas.append("%r vem antes de %r, que é mais específico" % (atual, posterior))
    return problemas


def main() -> int:
    parser_cli = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser_cli.add_argument("--arquivo", default=os.path.join(ROOT, "public", "robots.txt"))
    argumentos = parser_cli.parse_args()

    try:
        texto, robots = carrega(argumentos.arquivo)
    except OSError as erro:
        print("nao consegui ler %s: %s" % (argumentos.arquivo, erro), file=sys.stderr)
        return 2

    falhas = 0
    print("conferindo %s (%d bytes)" % (argumentos.arquivo, len(texto.encode("utf-8"))))

    naopadrao = diretivas_nao_padrao(texto)
    if naopadrao:
        falhas += 1
        print("  FALHA diretiva nao-padrao (validador de operador acusa erro de sintaxe):")
        for linha in naopadrao[:8]:
            print("        " + linha)
    else:
        print("  OK    so diretivas do padrao (RFC 9309) + sitemap/crawl-delay")

    ordem = grupos_fora_de_ordem(texto)
    if ordem:
        falhas += 1
        print("  FALHA grupo generico antes do especifico (parser por prefixo pega o errado):")
        for problema in ordem[:6]:
            print("        " + problema)
    else:
        print("  OK    grupos ordenados por especificidade")

    bloqueados = [b for b in BOTS_QUE_PRECISAM_DO_ACERVO if not robots.can_fetch(b, ROTA_DE_ACERVO)]
    if bloqueados:
        falhas += 1
        print("  FALHA %d bot(s) de busca/citacao sem acesso ao acervo: %s" % (len(bloqueados), bloqueados))
    else:
        print("  OK    %d de %d bots de busca/citacao com o acervo liberado"
              % (len(BOTS_QUE_PRECISAM_DO_ACERVO), len(BOTS_QUE_PRECISAM_DO_ACERVO)))

    vazando = [b for b in BOTS_DE_TREINAMENTO if robots.can_fetch(b, ROTA_DE_BUSCA)]
    if vazando:
        falhas += 1
        print("  FALHA %d bot(s) de treinamento com a busca interna LIBERADA: %s" % (len(vazando), vazando))
        print("        (sintoma classico de `Allow: /` declarado ANTES do `Disallow: /buscar/`)")
    else:
        print("  OK    %d de %d bots de treinamento com /buscar/ bloqueado"
              % (len(BOTS_DE_TREINAMENTO), len(BOTS_DE_TREINAMENTO)))

    sem_acervo = [b for b in BOTS_DE_TREINAMENTO if not robots.can_fetch(b, ROTA_DE_ACERVO)]
    if sem_acervo:
        falhas += 1
        print("  FALHA %d bot(s) de treinamento sem acesso ao acervo, contra a DEC-023: %s" % (len(sem_acervo), sem_acervo))
    else:
        print("  OK    treinamento com o acervo liberado (DEC-023)")

    if falhas:
        print("\n%d verificacao(oes) reprovaram" % falhas, file=sys.stderr)
        return 1
    print("\nrobots.txt conferido por parser: sem defeito")
    return 0


if __name__ == "__main__":
    sys.exit(main())
