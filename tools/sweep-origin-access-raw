#!/usr/bin/env python3
"""sweep-origin-access-raw — a guarda de seis meses do art. 15, com prazo e varredor.

O `tools/generate-origin-access-ledger` grava duas cópias do registro de acesso
da superfície social (ver o cabeçalho dele):

  1. `data/ops/access/nginx-<dia>.jsonl` — versionado, com o `remote_addr`
     PSEUDONIMIZADO nas linhas de `superficie=redesocial`;
  2. `var/ops/access-raw/nginx-<dia>.jsonl` — fora do git, 0600, com o IP real.

A cópia 2 existe porque o **Marco Civil da Internet (Lei 12.965/2014), art. 15**
obriga o provedor de aplicação a manter os registros de acesso a aplicações "sob
sigilo, em ambiente controlado e de segurança, pelo prazo de 6 (seis) meses".
Apagar o IP na hora seria descumprir a lei — tão irregular quanto versioná-lo
para sempre no git.

ESTE ARQUIVO É O OUTRO LADO DA MESMA REGRA: guarda obrigatória tem começo E FIM.
Passados os seis meses, o dado não tem mais base legal de retenção (LGPD art. 15,
I, e art. 16 — término do tratamento quando alcançada a finalidade ou o prazo) e
sai do disco. O varredor apaga:

  - o bruto `nginx-<dia>.jsonl` de `var/ops/access-raw/`;
  - a chave `pseudonimo-<dia>.key` de `var/ops/access-keys/`, do MESMO dia.

Apagar a chave junto não é zelo decorativo: é o que torna o pseudônimo que ficou
no git IRREVERSÍVEL. Enquanto a chave existe, quem tem a máquina pode testar
endereço por endereço até casar o HMAC (o espaço de IPv4 inteiro cabe em minutos);
sem a chave, não pode ninguém. Por isso o fim do prazo apaga as duas coisas.

O PRAZO É CONTADO EM MESES DE CALENDÁRIO, não em 180 dias. O art. 15 diz "6
(seis) meses" e o Código Civil, art. 132, § 3º, manda contar mês a mês. Onde não
há dia correspondente (31/03 menos 6 meses), o limite recua para o último dia
existente (30/09) — o erro cai sempre para o lado de guardar mais, nunca de
apagar antes da hora.

O QUE ELE NUNCA TOCA: `data/`. O ledger versionado é história do git e fica onde
está — a correção de privacidade é para frente, e apagar linha commitada exigiria
reescrever história, o que o contrato do repositório proíbe. A guarda abaixo
recusa qualquer diretório dentro de `data/`.

Uso:
    tools/sweep-origin-access-raw                # varre de verdade
    tools/sweep-origin-access-raw --simular      # diz o que apagaria, sem apagar
    tools/sweep-origin-access-raw --json
"""

import argparse
import datetime
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BRUTO_DIR = os.environ.get("WIKI_ACCESS_RAW_DIR", os.path.join(RAIZ, "var/ops/access-raw"))
CHAVES_DIR = os.environ.get("WIKI_ACCESS_KEYDIR", os.path.join(RAIZ, "var/ops/access-keys"))
MESES_DE_GUARDA = 6

NOME_BRUTO = re.compile(r"^nginx-(?P<dia>\d{4}-\d{2}-\d{2})\.jsonl$")
NOME_CHAVE = re.compile(r"^pseudonimo-(?P<dia>\d{4}-\d{2}-\d{2})\.key$")


def subtrai_meses(data, meses):
    """`data` menos `meses` meses de calendário, recuando o dia quando ele não
    existe no mês de destino (31/03 - 6 => 30/09).

    Recuar o dia adia a exclusão em até três dias. É o lado certo do erro: guardar
    a mais é conformidade com o art. 15; apagar a menos é descumprimento.
    """
    ano = data.year
    mes = data.month - meses
    while mes <= 0:
        mes += 12
        ano -= 1
    dia = data.day
    while dia > 0:
        try:
            return datetime.date(ano, mes, dia)
        except ValueError:
            dia -= 1
    raise ValueError("data impossível ao subtrair %d meses de %s" % (meses, data))


def limite_de_guarda(hoje=None, meses=MESES_DE_GUARDA):
    """O dia a partir do qual o bruto ainda TEM de existir. Anterior a ele, sai."""
    hoje = hoje or datetime.datetime.now(datetime.timezone.utc).date()
    return subtrai_meses(hoje, meses)


def _dentro_de_data(caminho):
    """True se o caminho cair dentro de `data/` do repositório."""
    alvo = os.path.realpath(caminho)
    protegido = os.path.realpath(os.path.join(RAIZ, "data"))
    return alvo == protegido or alvo.startswith(protegido + os.sep)


def _varre_pasta(pasta, padrao, limite, simular, erros):
    apagados = []
    if not os.path.isdir(pasta):
        return apagados
    if _dentro_de_data(pasta):
        erros.append("recusado: %s está dentro de data/ — ledger versionado nunca é varrido" % pasta)
        return apagados
    for nome in sorted(os.listdir(pasta)):
        casou = padrao.match(nome)
        if not casou:
            continue
        try:
            dia = datetime.date.fromisoformat(casou.group("dia"))
        except ValueError:
            erros.append("nome com data ilegível, mantido: %s" % os.path.join(pasta, nome))
            continue
        if dia >= limite:
            continue
        caminho = os.path.join(pasta, nome)
        if simular:
            apagados.append(caminho)
            continue
        try:
            os.unlink(caminho)
        except OSError as erro:
            erros.append("%s: %s" % (caminho, erro))
            continue
        apagados.append(caminho)
    return apagados


def varre(hoje=None, bruto_dir=None, chaves_dir=None, simular=False, meses=MESES_DE_GUARDA):
    """Apaga bruto e chave dos dias que já cumpriram a guarda. Devolve o que fez."""
    limite = limite_de_guarda(hoje, meses)
    erros = []
    brutos = _varre_pasta(bruto_dir or BRUTO_DIR, NOME_BRUTO, limite, simular, erros)
    chaves = _varre_pasta(chaves_dir or CHAVES_DIR, NOME_CHAVE, limite, simular, erros)
    return {
        "limite": limite.isoformat(),
        "meses_de_guarda": meses,
        "fundamento": "Lei 12.965/2014 (Marco Civil) art. 15; CC art. 132, par. 3o",
        "simulado": bool(simular),
        "brutos_apagados": brutos,
        "chaves_apagadas": chaves,
        "erros": erros,
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--simular", action="store_true", help="não apaga nada; só lista")
    ap.add_argument("--meses", type=int, default=MESES_DE_GUARDA,
                    help="meses de guarda (padrão 6, o do art. 15 — reduzir descumpre a lei)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.meses < MESES_DE_GUARDA:
        print("sweep-origin-access-raw: guarda de %d meses é menor que os 6 meses do art. 15 "
              "do Marco Civil; recusado" % args.meses, file=sys.stderr)
        return 2

    resultado = varre(simular=args.simular, meses=args.meses)
    if args.json:
        print(json.dumps(resultado, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print("sweep-origin-access-raw: guarda de %d meses · o bruto anterior a %s sai do disco"
              % (resultado["meses_de_guarda"], resultado["limite"]))
        print("  %s: %d arquivo(s) de IP bruto" % ("apagaria" if args.simular else "apagados",
                                                   len(resultado["brutos_apagados"])))
        print("  %s: %d chave(s) de pseudonimização" % ("apagaria" if args.simular else "apagadas",
                                                        len(resultado["chaves_apagadas"])))
        for caminho in resultado["brutos_apagados"] + resultado["chaves_apagadas"]:
            print("    %s" % caminho)
    for erro in resultado["erros"]:
        print("sweep-origin-access-raw: %s" % erro, file=sys.stderr)
    return 1 if resultado["erros"] else 0


if __name__ == "__main__":
    sys.exit(main())
