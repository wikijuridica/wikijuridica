#!/usr/bin/env python3
"""Faz a página /bot/ imprimir a diretiva de robots.txt em DUAS linhas.

O DEFEITO, medido em 2026-09-10
--------------------------------
`content/pages.json` traz o corpo da seção "Como bloquear o agente" com as duas
diretivas separadas por `\n` simples:

    Acrescente ao robots.txt do seu site:

    User-agent: WikijuridicaBot
    Disallow: /

`internal/render` (render.go:1595) quebra parágrafo em linha EM BRANCO e colapsa
a quebra simples em espaço. O HTML servido saía assim:

    <p>User-agent: WikijuridicaBot Disallow: /</p>

`User-agent: X Disallow: /` numa linha só NÃO é robots.txt válido: cada diretiva
ocupa uma linha. Quem copiasse da página colava uma linha que o próprio parser do
robots.txt descarta — a página que o CLAUDE.md §11 exige ("a URL do agente tem de
responder: /bot/ documenta escopo, limites e a linha de robots.txt que nos
bloqueia") estava dando a instrução errada, e a instrução errada é pior que
nenhuma: o operador acha que nos barrou.

Achado por `tools/check-text-truncation` — o único sobrevivente depois que a
isenção de bloco link-only entrou em `54603753`. O detector estava certo: aquilo
não é período, e não era para ser parágrafo.

O CONSERTO, e por que NÃO é `<pre>`
------------------------------------
`- ` no começo da linha vira `<ul><li>` no mesmo render (render.go:1626), markup
que as 11.287 páginas do acervo já usam. `<pre>` e `<code>` não existem em
NENHUMA delas (medido: `grep -rl '<pre\|<code' public/ --include=index.html` = 0),
e estrear uma tag por uma página faria a folha de contrato, a auditoria de
acessibilidade, a fidelidade da gêmea Markdown e o teto de 50 KB passarem a
julgar markup que ninguém mais emite. Em `<li>` cada diretiva fica na sua linha,
que é o que o operador precisa copiar.

GUARDA POR MARCA
-----------------
O gerador aborta se a frase que ele REMOVE não estiver no disco — nunca
sobrescreve o que não reconhece. Rodar duas vezes troca zero campos.

    tools/generate-pagina-bot-robots-em-lista-20260910 --seco
    tools/generate-pagina-bot-robots-em-lista-20260910
"""

import argparse
import datetime
import json
import os
import pathlib
import shutil
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
PAGES = RAIZ / "content" / "pages.json"
GUARDA = RAIZ / ".agents" / "runtime" / "pages-json-antes"
CAMINHO = "/bot/"
SECAO = "Como bloquear o agente"

ANTES = "User-agent: WikijuridicaBot\nDisallow: /"
DEPOIS = "- User-agent: WikijuridicaBot\n- Disallow: /"


def serializa_como_o_go(paginas):
    """Serializa com os MESMOS escapes que o produtor Go emite.

    `content/pages.json` é escrito por Go (`encoding/json`), e o `Encoder` de Go
    tem `SetEscapeHTML(true)` por padrão: `&`, `<` e `>` saem como `\\u0026`,
    `\\u003c` e `\\u003e`. `json.dump` do Python não escapa nenhum dos três.

    Medido em 2026-09-10, e é por isso que esta função existe: a primeira
    gravação deste gerador trocou 2 campos de propósito e **1.834 linhas sem
    querer**, todas `\\u0026` virando `&` em `source_url` de acórdão do STF
    (`…?base=30&sumula=1602`). O JSON é equivalente e nenhum leitor se importa;
    o diff é que deixa de dizer a verdade — 1.838 linhas mudadas onde duas
    mudaram, e a próxima gravação do produtor Go desfaz tudo de volta, cobrando
    o mesmo ruído duas vezes. É o precedente `jsonl-de-produtor-go-reserializado
    -em-python`, que este repositório já pagou com 7.959 linhas do corpus.

    A substituição é textual e segura: `&`, `<` e `>` não aparecem na sintaxe do
    JSON (que usa `{}[]",:` e espaço), só dentro de valores string.
    """
    bruto = json.dumps(paginas, ensure_ascii=False, indent=2)
    for literal, escapado in (("&", "\\u0026"), ("<", "\\u003c"), (">", "\\u003e")):
        bruto = bruto.replace(literal, escapado)
    return bruto + "\n"


def grava(paginas):
    tmp = PAGES.with_suffix(".json.tmp-bot-robots")
    tmp.write_text(serializa_como_o_go(paginas), encoding="utf-8")
    os.replace(tmp, PAGES)


def serializacao_precisa_de_reparo():
    """True quando o disco tem `&`, `<` ou `>` crus — resíduo de uma gravação
    Python anterior a esta correção. Reparar aqui é o que torna o gerador
    idempotente de verdade: rodar de novo devolve o arquivo à forma do produtor,
    em vez de deixar o ruído para o próximo diff."""
    bruto = PAGES.read_text(encoding="utf-8")
    return any(c in bruto for c in ("&", "<", ">"))


def secao_alvo(pagina):
    for secao in pagina.get("body_sections") or []:
        if (secao.get("heading") or secao.get("title") or "").strip() == SECAO:
            return secao
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--seco", action="store_true",
                        help="mostra o que mudaria e não escreve")
    argumentos = parser.parse_args()

    paginas = json.loads(PAGES.read_text(encoding="utf-8"))
    alvos = [p for p in paginas if p.get("path") == CAMINHO]
    if len(alvos) != 1:
        print("esperava exatamente 1 pagina %s, achei %d" % (CAMINHO, len(alvos)),
              file=sys.stderr)
        return 2
    pagina = alvos[0]
    secao = secao_alvo(pagina)
    if secao is None:
        print("secao %r nao existe em %s" % (SECAO, CAMINHO), file=sys.stderr)
        return 2

    corpo = secao.get("body") or ""
    if DEPOIS in corpo:
        print("ja corrigida: %s / %s (0 campo trocado)" % (CAMINHO, SECAO))
        if serializacao_precisa_de_reparo() and not argumentos.seco:
            grava(paginas)
            print("serializacao reparada: `&`, `<` e `>` voltaram a `\\u0026`, "
                  "`\\u003c` e `\\u003e`, como o produtor Go escreve")
        return 0
    # GUARDA POR MARCA: sem a frase exata, não se escreve nada.
    if ANTES not in corpo:
        print("guarda: a frase que este gerador remove nao esta no disco.\n"
              "  esperado: %r\n"
              "  Alguem ja editou a secao. Leia antes de rodar de novo."
              % ANTES, file=sys.stderr)
        return 1

    novo_corpo = corpo.replace(ANTES, DEPOIS)
    print("%s / %s" % (CAMINHO, SECAO))
    print("  - %s" % ANTES.replace("\n", " \\n "))
    print("  + %s" % DEPOIS.replace("\n", " \\n "))
    if argumentos.seco:
        print("(seco: nada escrito)")
        return 0

    secao["body"] = novo_corpo
    # `content_revised_at` NAO se escreve aqui, e a primeira versao deste gerador
    # escrevia.
    #
    # O campo e DERIVADO: `tools/generate-page-content-revision` o preenche a
    # partir de `data/ops/page_content_revision.jsonl`, que guarda o `revised_on`
    # de cada rota junto com o `served_sha256` que o justifica. Quem escreve a
    # data a mao esta afirmando um fato — "o conteudo servido mudou nesta data" —
    # que so o hash do HTML servido pode estabelecer.
    #
    # Medido em 2026-09-10, e o efeito foi VISIVEL: este gerador carimbou
    # `2026-09-10` no /bot/, o deploy #4 republicou, e o publicador reescreveu o
    # campo com o `revised_on` do ledger, que ainda era `2026-09-06` — porque o
    # ledger so avanca DEPOIS da purga, por desenho declarado
    # (tools/deploy-publico:1240). No diff, a data RETROCEDEU de 2026-09-10 para
    # 2026-09-06, e um retrocesso de data de revisao e exatamente o tipo de coisa
    # que se investiga como corrupcao antes de descobrir que foi autoinfligida.
    #
    # Sem a escrita a mao o resultado final e o mesmo — o ledger carimba a data
    # certa no fecho deste deploy e o `pages.json` a recebe na republicacao
    # seguinte — e o diff deixa de mentir no meio do caminho.

    GUARDA.mkdir(parents=True, exist_ok=True)
    preservado = GUARDA / ("pages-%s-bot-robots.json" % datetime.date.today().isoformat())
    if not preservado.exists():
        shutil.copy2(PAGES, preservado)

    grava(paginas)
    print("gravado. anterior preservado em %s" % preservado.relative_to(RAIZ))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
