#!/usr/bin/env python3
"""Sonda a produção depois do deploy: 30 rotas humanas + a superfície de máquina.

★ POR QUE ESTA FERRAMENTA EXISTE

Depois de um deploy, "o site está no ar" não é resposta: o portal serve 10 mil
rotas estáticas E um canal de máquina (Markdown gêmeo, MCP, A2A, /api, os
descritores em /.well-known). Já houve caso medido em que o Go em :8089
respondia 200 e o nginx em :8088 devolvia 404 para o mesmo caminho, porque a
allowlist de extensão não conhecia `.gz` (BUG-015) — um lado saudável esconde o
outro quebrado.

A amostra de rotas humanas sai do `published_manifest` por passo determinístico
(nunca aleatório sem semente): a mesma invocação sonda as mesmas rotas, então
duas execuções são comparáveis. E toda sonda usa o UA próprio do projeto com
`X-Warming-Request: true` — usar UA de bot real é fraude com consequência legal,
e o contrato é explícito.

Uso:
    ./tools/check-producao-pos-deploy [--rotas 30] [--base https://...]
"""
import argparse
import json
import pathlib
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
MANIFESTO = RAIZ / "data/editorial/published_manifest.jsonl"
UA = "wikijuridica-superficie-probe/1.0"

# Caminhos de máquina: o que um agente/bot pede antes de ler o acervo.
MAQUINA = (
    "/robots.txt",
    "/sitemap.xml",
    "/llms.txt",
    "/index.md",
    "/.well-known/agent-skills/index.json",
    "/api/politica-de-uso.json",
)


def sonda(url, timeout=25):
    saida = subprocess.run(
        ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code} %{size_download} %{content_type}",
         "-A", UA, "-H", "X-Warming-Request: true", "--max-time", str(timeout), url],
        capture_output=True, text=True)
    if saida.returncode != 0:
        return None, 0, f"curl_rc={saida.returncode}"
    partes = saida.stdout.split(None, 2)
    codigo = int(partes[0]) if partes and partes[0].isdigit() else None
    tamanho = int(partes[1]) if len(partes) > 1 and partes[1].isdigit() else 0
    tipo = partes[2].strip() if len(partes) > 2 else ""
    return codigo, tamanho, tipo


def rotas_do_manifesto(quantas):
    caminhos = []
    for linha in MANIFESTO.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        caminho = registro.get("public_path") or registro.get("path")
        if caminho:
            caminhos.append(caminho)
    if not caminhos:
        return []
    # Passo determinístico: cobre o manifesto inteiro e repete entre execuções.
    passo = max(1, len(caminhos) // quantas)
    return caminhos[::passo][:quantas]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--rotas", type=int, default=30)
    parser.add_argument("--base", default="https://wikijuridica.com.br")
    args = parser.parse_args()

    falhas = []
    print(f"=== {args.rotas} rotas do acervo (passo determinístico sobre o manifesto) ===")
    rotas = rotas_do_manifesto(args.rotas)
    if not rotas:
        print("REPROVADO: o published_manifest não rendeu nenhuma rota")
        return 1
    ok = 0
    for caminho in rotas:
        url = args.base + caminho
        codigo, tamanho, tipo = sonda(url)
        if codigo == 200 and tamanho > 0:
            ok += 1
        else:
            falhas.append((url, codigo, tamanho, tipo))
            print(f"  FALHA {codigo} bytes={tamanho} {caminho}")
    print(f"  {ok}/{len(rotas)} responderam 200 com corpo")

    print("=== superfície de máquina ===")
    okm = 0
    for caminho in MAQUINA:
        url = args.base + caminho
        codigo, tamanho, tipo = sonda(url)
        marca = "ok " if (codigo == 200 and tamanho > 0) else "FALHA"
        if codigo == 200 and tamanho > 0:
            okm += 1
        else:
            falhas.append((url, codigo, tamanho, tipo))
        print(f"  {marca} {codigo} {tamanho:>8} b  {tipo[:28]:28s} {caminho}")

    # A gêmea Markdown de uma rota real: o canal de máquina do acervo.
    if rotas:
        gemea = args.base + rotas[0].rstrip("/") + "/index.md"
        codigo, tamanho, tipo = sonda(gemea)
        marca = "ok " if (codigo == 200 and tamanho > 0) else "FALHA"
        if codigo != 200 or tamanho <= 0:
            falhas.append((gemea, codigo, tamanho, tipo))
        print(f"  {marca} {codigo} {tamanho:>8} b  {tipo[:28]:28s} {rotas[0].rstrip('/')}/index.md")

    if falhas:
        print(f"\nREPROVADO: {len(falhas)} sonda(s) sem 200 com corpo")
        return 1
    print(f"\ncheck-producao-pos-deploy: pass — {ok} rotas do acervo e "
          f"{okm} caminhos de máquina, todos 200 com corpo")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
