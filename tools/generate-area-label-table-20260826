#!/usr/bin/env python3
"""generate-area-label-table-20260826 — o rotulo da area sai do dado, nao do codigo.

POR QUE EXISTE. Ate 2026-08-26 o nome visivel de cada area vivia num mapa
CURADO A MAO dentro de internal/structureddata, e area fora do mapa caia num
title-case ASCII mecanico. Resultado medido: 7 slugs com pagina publicada nao
tinham entrada -- e tres deles PRECISAM de acento. "Diarios", "Noticias" e
"Jurisprudencia" apareciam sem acento no breadcrumb VISIVEL e no JSON-LD de 283
URLs. Acrescentar tres linhas ao mapa consertaria essas tres e deixaria a
proxima area nova repetir o defeito.

O QUE ELE FAZ. Le content/area_labels.json (a unica fonte do texto) e
content/pages.json (as areas que existem de verdade), confere as duas nos DOIS
sentidos e gera internal/structureddata/area_labels_generated.go. Area publicada
sem rotulo aborta a geracao -- e o gate tools/check-area-label-cobertura reprova
o mesmo estado sem precisar gerar nada.

A tabela vai em FONTE GO e nao em //go:embed pelo mesmo motivo de
tools/generate-siteicon-source: o grafo autenticado do fingerprint de ingestao
so aceita .go no snapshot de codigo.

Uso:
    tools/generate-area-label-table-20260826
"""
from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "content/area_labels.json"
PAGINAS = ROOT / "content/pages.json"
TABELA = ROOT / "internal/structureddata/area_labels_generated.go"


def areas_publicadas() -> dict[str, int]:
    paginas = json.loads(PAGINAS.read_text(encoding="utf-8"))
    contagem: dict[str, int] = {}
    for pagina in paginas:
        segmentos = [s for s in (pagina.get("path") or "").split("/") if s]
        if len(segmentos) >= 2:
            contagem[segmentos[0]] = contagem.get(segmentos[0], 0) + 1
    return contagem


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporario = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporario, path)
    finally:
        if os.path.exists(temporario):
            os.unlink(temporario)


def main() -> int:
    config = json.loads(CONFIG.read_text(encoding="utf-8"))
    rotulos: dict[str, str] = config["rotulos"]
    publicadas = areas_publicadas()

    sem_rotulo = sorted(set(publicadas) - set(rotulos))
    if sem_rotulo:
        print("area(s) com pagina publicada e SEM rotulo em content/area_labels.json:",
              file=sys.stderr)
        for slug in sem_rotulo:
            print(f"  {slug} ({publicadas[slug]} pagina(s))", file=sys.stderr)
        return 1
    vazios = sorted(s for s, r in rotulos.items() if not r.strip())
    if vazios:
        print(f"rotulo vazio nao e rotulo: {vazios}", file=sys.stderr)
        return 1

    linhas = [
        "// Code generated by tools/generate-area-label-table-20260826; DO NOT EDIT.",
        "",
        "package structureddata",
        "",
        "// rotulosDeArea e o nome visivel PT-BR de cada area, por slug. A fonte do",
        "// texto e content/area_labels.json -- nunca este arquivo, que e gerado.",
        "//",
        "// Ate 2026-08-26 este mapa era curado A MAO aqui dentro, e area fora dele",
        "// caia num title-case ASCII: 'Diarios', 'Noticias' e 'Jurisprudencia'",
        "// apareciam sem acento no breadcrumb visivel e no JSON-LD de 283 URLs, e",
        "// sete slugs com pagina publicada nao tinham entrada nenhuma.",
        "//",
        "// TestRotulosDeAreaBatemComAConfig reprova divergencia entre este arquivo e",
        "// a config; tools/check-area-label-cobertura reprova area publicada sem",
        "// rotulo, que e o estado em que o title-case volta a ser alcancavel.",
        "var rotulosDeArea = map[string]string{",
    ]
    for slug in sorted(rotulos):
        linhas.append(f'\t{json.dumps(slug)}: {json.dumps(rotulos[slug], ensure_ascii=False)},')
    linhas.append("}")
    linhas.append("")
    atomic_write(TABELA, ("\n".join(linhas)).encode("utf-8"))
    # gofmt alinha o mapa; sem isso o pre-commit reprova o arquivo gerado.
    os.system(f"cd {ROOT} && gofmt -w {TABELA.relative_to(ROOT)}")
    print(f"{len(rotulos)} rotulo(s) para {len(publicadas)} area(s) publicada(s)")
    print(f"tabela: {os.path.relpath(TABELA, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
