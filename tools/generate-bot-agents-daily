# sem isso um check de honestidade nao tem como saber se o produtor corrigido
# ja rodou de fato, so que as linhas antigas continuam do jeito que estavam.
#
# v3 (2026-08-12): a premissa do v2 era falsa — `verifiedBotCategory` FUNCIONA
# no plano Free. A contagem passou a exigir a verificacao da Cloudflare, e
# `requests_sampled`/`requests_estimated` passaram a significar SOMENTE bot
# verificado pela Cloudflare.
#
# v4 (2026-09-02): a Cloudflare nao verifica TODO operador honesto — medido
# com o PerplexityBot, 100% verifiedBotCategory vazia apesar de 100% dos
# clientIP dentro da faixa oficial publicada. `requests_sampled`/
# `requests_estimated` passam a significar TOTAL verificado — Cloudflare OU
# faixa de IP do operador —, com as duas pernas nomeadas em campo proprio. Ver
# o cabecalho do modulo para a medicao completa e o racional do filtro.
SCHEMA = "edge_bot_agents_daily_v4"

# Vocabulario de `authenticity` (v4). O v2 gravava sempre "unverifiable_at_edge"
# (premissa errada); o v3 gravava "unverified_at_edge" quando nada verificava.
# O v4 volta a palavra do v2 para "nada verificou" (unverifiable_at_edge) e
# acrescenta as duas novas pernas — a mudanca de grafia e deliberada: o bump de
# schema tem que vir com vocabulario que ninguem confunda com o do v3 por
# semelhanca de string.
AUTENTICIDADE_CLOUDFLARE = "cloudflare_verified_bot_category"
AUTENTICIDADE_IP_RANGE = "ip_range_at_edge"
AUTENTICIDADE_AMBAS = "cloudflare_and_ip_range"
AUTENTICIDADE_NENHUMA = "unverifiable_at_edge"

# Retenção do dataset adaptativo, medida empiricamente contra a API em
# 2026-08-07: pedir data anterior devolve `code: quota`, "cannot request data
# older than 1w1d".
RETENCAO_DIAS = 8

# Teto por consulta. A API recusa janela maior que 1 dia neste conjunto.
# Vale tanto para a consulta primaria quanto para as secundarias (por faixa de
# IP) — a mesma regua, para nao abrir uma segunda nocao de "grande demais".
LIMITE_GRUPOS = 5000

CONSULTA = """
query($zone: String!, $since: Time!, $until: Time!, $limite: Int!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: $limite,
        filter: {datetime_geq: $since, datetime_leq: $until},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      dimensions { userAgent clientCountryName verifiedBotCategory }
    }
  } }
}
"""

# Tabelas em tools/botagents.py: a medição da BORDA e a da ORIGEM têm de falar
# dos MESMOS agentes, senão a série histórica compara coisas diferentes sem que
# ninguém perceba. Ver o cabeçalho do módulo para o racional da separação entre
# bot de treino e bot de busca.
AGENTES = botagents.AGENTES
FUNCAO = botagents.FUNCAO
OPERADORES_SEMPRE_ESTRANGEIROS = botagents.OPERADORES_SEMPRE_ESTRANGEIROS
agente_de = botagents.agente_de

# Token seguro para interpolar dentro do filtro GraphQL da segunda consulta
# (ver _filtro_or_userAgent). Só chega aqui o que passou por este crivo — o
# trecho extraído de uma amostra real de User-Agent, nunca texto de fora.
_TOKEN_SEGURO = re.compile(r"^[A-Za-z0-9_.\-]+$")


def ler_env():
    return cloudflare_auth.ambiente(ENV)


def cabecalhos(env):
    """Cabecalhos de leitura -- CLOUDFLARE_ZONE_TOKEN (menor privilegio) com
    fallback para CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN (Global API Key).
    Delegado a tools/cloudflare_auth.py desde 2026-09-03: ate entao esta
    funcao exigia CLOUDFLARE_API_TOKEN presente mesmo com o token de zona no
    ambiente (checava `if not token` antes de olhar o escopado) -- abortava
    com "credencial ausente" tendo uma credencial valida na mao."""
    cab, _ = cloudflare_auth.cabecalhos("leitura", env=env)
    return cab


def graphql(headers, consulta, variaveis):
    corpo = json.dumps({"query": consulta, "variables": variaveis}).encode()
    pedido = urllib.request.Request(API + "/graphql", data=corpo, headers=headers)
    try:
        with urllib.request.urlopen(pedido, timeout=90) as resposta:
            dados = json.loads(resposta.read().decode("utf-8"))
    except urllib.error.HTTPError as erro:
        return None, "HTTP %s" % erro.code
    except Exception as erro:
        return None, str(erro)[:160]
    if dados.get("errors"):
        return None, "; ".join(e.get("message", "?") for e in dados["errors"][:2])
    zonas = (dados.get("data") or {}).get("viewer", {}).get("zones") or []
    return (zonas[0] if zonas else {}), ""


def resolver_zona(headers, dominio):
    pedido = urllib.request.Request(API + "/zones?name=" + dominio, headers=headers)
    try:
        with urllib.request.urlopen(pedido, timeout=30) as resposta:
            dados = json.loads(resposta.read().decode("utf-8"))
    except Exception as erro:
        return "", str(erro)[:160]
    resultado = dados.get("result") or []
    if not resultado:
        return "", "zona %s nao encontrada na conta" % dominio
    return resultado[0]["id"], ""


def _acumular_primario(grupos):
    """A partição de sempre — Cloudflare, depois sonda-local-do-BR, depois
    sem verificação nenhuma — isolada em função própria para poder ser
    testada com grupos SINTÉTICOS, sem bater na API. Devolve
    {agent_key: acumulado}.
    """
    por_agente = {}
    for grupo in grupos:
        dimensoes = grupo.get("dimensions") or {}
        chave = agente_de(dimensoes.get("userAgent"))
        if chave is None:
            continue
        pais = (dimensoes.get("clientCountryName") or "").upper()
        amostrado = grupo.get("count", 0)
        intervalo = ((grupo.get("avg") or {}).get("sampleInterval") or 1.0)
        acumulado = por_agente.setdefault(chave, {
            "requests_sampled": 0,
            "requests_estimated": 0.0,
            "requests_local_verification": 0,
            "requests_sampled_unverified_ua": 0,
            "requests_estimated_unverified_ua": 0.0,
            "requests_sampled_ip_range": 0,
            "requests_estimated_ip_range": 0.0,
            "countries": {},
            "countries_unverified": {},
            "verified_bot_categories": {},
            "user_agents": set(),
            "user_agents_unverified": set(),
        })
        # ORDEM DOS CRITÉRIOS, e por quê:
        #
        # 1º a verificação da Cloudflare. Categoria vazia = a borda NÃO
        #    autenticou aquele cliente como bot do operador que o User-Agent
        #    alega. É o critério forte, e apanha tanto a sonda desta casa
        #    quanto o forjador que rastreia de qualquer país.
        # 2º o heurístico de origem. Entre as não-verificadas, operador que só
        #    rastreia do exterior chegando do BRASIL é a verificação local
        #    saindo desta máquina — separada e nomeada desde o v2.
        # 3º o resto das não-verificadas: UA de bot sem autenticação e sem
        #    origem local. Reclassificado, em parte, pela FASE 2 (faixa de IP)
        #    logo abaixo em coletar_dia — o que sobrar dessa reclassificação é
        #    que fica em requests_sampled_unverified_ua no registro final.
        categoria = (dimensoes.get("verifiedBotCategory") or "").strip()
        if categoria:
            acumulado["requests_sampled"] += amostrado
            acumulado["requests_estimated"] += amostrado * intervalo
            acumulado["countries"][pais] = acumulado["countries"].get(pais, 0) + amostrado
            acumulado["verified_bot_categories"][categoria] = \
                acumulado["verified_bot_categories"].get(categoria, 0) + amostrado
        elif pais == "BR" and chave in OPERADORES_SEMPRE_ESTRANGEIROS:
            acumulado["requests_local_verification"] += amostrado
        else:
            acumulado["requests_sampled_unverified_ua"] += amostrado
            acumulado["requests_estimated_unverified_ua"] += amostrado * intervalo
            acumulado["countries_unverified"][pais] = \
                acumulado["countries_unverified"].get(pais, 0) + amostrado
            ua_bruto = dimensoes.get("userAgent") or ""
            # Cap maior que o de user_agents (250, nao 160): esta amostra
            # alimenta _tokens_de_familia, e truncar cedo demais cortaria a
            # marca do agente fora da amostra em User-Agent longo.
            if len(acumulado["user_agents_unverified"]) < 4:
                acumulado["user_agents_unverified"].add(ua_bruto[:250])
        ua = dimensoes.get("userAgent") or ""
        if len(acumulado["user_agents"]) < 4:
            acumulado["user_agents"].add(ua[:160])
    return por_agente


def _candidatos_ip_range(por_agente, faixas):
    """agent_key com tráfego sem verificação da Cloudflare E faixa oficial de
    IP conhecida — os únicos para quem vale pagar uma segunda consulta.
    """
    return sorted(chave for chave, dados in por_agente.items()
                  if dados["requests_sampled_unverified_ua"] > 0 and chave in faixas)


def _tokens_de_familia(agent_key, amostras):
    """Extrai, das amostras REAIS capturadas nesta mesma coleta, o trecho com
    a grafia EXATA (maiúscula/minúscula) que identifica `agent_key` dentro de
    uma string de User-Agent — para usar como `userAgent_like` na segunda
    consulta.

    POR QUE NÃO USAR A MARCA DE botagents.AGENTES DIRETO: ela é sempre
    minúscula (`agente_de()` compara em `.lower()`), e a API GraphQL da
    Cloudflare faz LIKE SENSÍVEL A MAIÚSCULA/MINÚSCULA — não existe
    `userAgent_ilike` (medido em 2026-09-02: pedir o argumento devolve "error
    parsing args ... unknown arg userAgent_ilike"). "%googlebot%" (tudo
    minúsculo) devolveu ZERO grupos contra a mesma zona onde "%Googlebot%"
    devolveu 29: a string real na borda é "Googlebot", sem nenhuma cópia em
    caixa baixa em lugar nenhum. PerplexityBot é o caso enganoso:
    "%perplexitybot%" TAMBÉM bateu, mas só porque a URL de referência
    (".../perplexitybot") carrega uma cópia minúscula dentro da MESMA string —
    não porque o filtro ignora caixa. Uma tabela de grafia adivinhada acertaria
    por acidente hoje e erraria no próximo bot cuja URL não repete o nome em
    minúsculo.
    """
    marcas = [marca for chave, marcas_lista in AGENTES if chave == agent_key
              for marca in marcas_lista]
    tokens = set()
    for amostra in amostras:
        baixo = amostra.lower()
        for marca in marcas:
            pos = baixo.find(marca)
            if pos == -1:
                continue
            trecho = amostra[pos:pos + len(marca)]
            if trecho and _TOKEN_SEGURO.match(trecho):
                tokens.add(trecho)
    return sorted(tokens)


def _filtro_or_userAgent(tokens):
    """Monta o fragmento `OR: [...]` do filtro GraphQL para os tokens dados.

    Os tokens só chegam aqui depois de passar por `_TOKEN_SEGURO` (alfanumérico
    + ponto/hífen/underscore) — nunca texto arbitrário de fora —, então a
    interpolação direta na string da consulta não abre injeção.
    """
    partes = ", ".join('{userAgent_like: "%%%s%%"}' % token for token in tokens)
    return "OR: [%s]" % partes


def _consulta_secundaria(or_filtro):
    """Consulta com `clientIP`, restrita pelo filtro OR de User-Agent do
    agente candidato. Mesma forma da consulta primária, dimensão a mais.
    """
    return ("""
query($zone: String!, $since: Time!, $until: Time!, $limite: Int!) {
  viewer { zones(filter: {zoneTag: $zone}) {
    httpRequestsAdaptiveGroups(limit: $limite,
        filter: {datetime_geq: $since, datetime_leq: $until, """ + or_filtro + """},
        orderBy: [count_DESC]) {
      count
      avg { sampleInterval }
      dimensions { userAgent clientIP clientCountryName verifiedBotCategory }
    }
  } }
}
""")


def _processar_grupos_secundarios(grupos, agent_key, redes):
    """Reparticiona os grupos da segunda consulta (por `clientIP`) entre o
    que a faixa oficial do operador autentica e o que continua sem
    verificação nenhuma.

    A MESMA partição de três vias da consulta primária, na mesma ordem:

    1. grupo com `verifiedBotCategory` preenchida já foi contado no lote
       PRIMÁRIO (a Cloudflare verificou) — contá-lo de novo aqui duplicaria o
       mesmo tráfego.
    2. BR vindo de operador de `OPERADORES_SEMPRE_ESTRANGEIROS` já foi
       roteado para `requests_local_verification` na consulta primária,
       NUNCA para `unverified_ua` — sem este passo, a segunda consulta
       "moveria" tráfego que nunca esteve na perna que estamos tentando
       reclassificar.
    3. o que sobra: `clientIP` dentro da faixa oficial vira `ip_range`; fora
       dela continua sem verificação nenhuma.

    Devolve (amostrado_movido, estimado_movido, países_movidos).
    """
    amostrado = 0
    estimado = 0.0
    paises = {}
    for grupo in grupos:
        dimensoes = grupo.get("dimensions") or {}
        ua = dimensoes.get("userAgent")
        if agente_de(ua) != agent_key:
            # o filtro OR pode ter sido mais largo que este agente exato (duas
            # marcas do mesmo token); descarta o que não é dele em vez de
            # arriscar atribuir tráfego de outro operador.
            continue
        if (dimensoes.get("verifiedBotCategory") or "").strip():
            continue
        pais = (dimensoes.get("clientCountryName") or "").upper()
        if pais == "BR" and agent_key in OPERADORES_SEMPRE_ESTRANGEIROS:
            continue
        ip = dimensoes.get("clientIP")
        if not ip or not botagents.em_faixa(ip, redes):
            continue
        contagem = grupo.get("count", 0)
        intervalo = ((grupo.get("avg") or {}).get("sampleInterval") or 1.0)
        amostrado += contagem
        estimado += contagem * intervalo
        paises[pais] = paises.get(pais, 0) + contagem
    return amostrado, estimado, paises


def _aplicar_fase2_ip_range(dados, movido_amostrado, movido_estimado, paises_movidos):
    """Aplica, sobre o acumulado da fase 1, o que a fase 2 (faixa de IP)
    reclassificou — mesma função usada por `coletar_dia` e pelo teste, para
    que a lógica de clamp nunca divirja entre produção e prova.

    Muta `dados` em vez de devolver cópia: `dados` já é o dict mutável
    guardado em `por_agente[chave]`, e a mutação em lugar único evita duas
    fontes de verdade para o mesmo acumulado.
    """
    antes_amostrado = dados["requests_sampled_unverified_ua"]
    antes_estimado = dados["requests_estimated_unverified_ua"]
    # Clamp: a segunda consulta reparte o MESMO tráfego numa granularidade
    # mais fina (por clientIP), então o total movido nunca pode passar do que
    # a primária já havia contado como sem verificação — se passar (a janela
    # de "hoje" segue acumulando entre as duas chamadas), é drift de poucos
    # segundos, não um agente novo aparecendo.
    movido_amostrado = min(movido_amostrado, antes_amostrado)
    movido_estimado = min(movido_estimado, antes_estimado) if antes_estimado > 0 else 0.0
    dados["requests_sampled_ip_range"] = movido_amostrado
    dados["requests_estimated_ip_range"] = movido_estimado
    dados["requests_sampled_unverified_ua"] = antes_amostrado - movido_amostrado
    dados["requests_estimated_unverified_ua"] = antes_estimado - movido_estimado
    for pais, contagem in paises_movidos.items():
        restante = dados["countries_unverified"].get(pais, 0)
        novo = max(0, restante - contagem)
        if novo:
            dados["countries_unverified"][pais] = novo
        else:
            dados["countries_unverified"].pop(pais, None)
        # O que saiu de "sem verificação" entra em `countries` — o mesmo
        # campo que já recebe o país da perna Cloudflare. Sem isto, tráfego
        # verificado por faixa de IP ficava com país nenhum em lugar nenhum:
        # não em countries (só a perna Cloudflare escrevia ali) nem em
        # countries_unverified (que acabou de ser descontado) — descarte
        # silencioso da geografia, o mesmo defeito que este módulo existe
        # para impedir, só que no campo errado.
        dados["countries"][pais] = dados["countries"].get(pais, 0) + contagem
    return dados


def _operadores_de_faixa(root):
    """agent_key -> (nome_do_arquivo_que_autentica, total_de_prefixos_publicados).

    Lê os MESMOS arquivos que `botagents.ler_faixas`, mas guarda o que ela
    descarta de propósito (o nome do arquivo e a contagem de prefixos): os
    outros 8 chamadores de `ler_faixas` só precisam da lista de redes para
    `em_faixa`, e mudar o retorno dela quebraria contrato. Duplicar a leitura
    aqui é mais barato que arriscar isso — são ~12 arquivos pequenos.
    """
    diretorio = os.path.join(root, "data", "ops", "bot_ip_ranges")
    resultado = {}
    if not os.path.isdir(diretorio):
        return resultado
    for nome in sorted(os.listdir(diretorio)):
        if not nome.endswith(".json"):
            continue
        try:
            with open(os.path.join(diretorio, nome), encoding="utf-8") as handle:
                dados = json.load(handle)
        except (OSError, ValueError):
            continue
        base = nome[:-5]
        total = len(dados.get("prefixes") or [])
        for agente in dados.get("authenticates_agents", []):
            if agente in resultado:
                arquivo_ant, total_ant = resultado[agente]
                resultado[agente] = (arquivo_ant + "," + base, total_ant + total)
            else:
                resultado[agente] = (base, total)
    return resultado


def _autenticidade_de(cf_sampled, ip_sampled):
    if cf_sampled and ip_sampled:
        return AUTENTICIDADE_AMBAS
    if cf_sampled:
        return AUTENTICIDADE_CLOUDFLARE
    if ip_sampled:
        return AUTENTICIDADE_IP_RANGE
    return AUTENTICIDADE_NENHUMA


def _montar_registro(dia_iso, chave, dados, operadores, ini_str, fim_str, truncado):
    """Monta o registro final de um agente para um dia — pura, testável sem
    rede: recebe o acumulado já processado (fases 1 e 2) e as metadata de
    faixa de IP, devolve o dict pronto para `json.dumps`.
    """
    cf_sampled = dados["requests_sampled"]
    cf_estimated = round(dados["requests_estimated"])
    ip_sampled = dados.get("requests_sampled_ip_range", 0)
    ip_estimated = round(dados.get("requests_estimated_ip_range", 0.0))
    operador, prefixos_total = operadores.get(chave, (None, 0))
    return {
        "schema_version": SCHEMA,
        "date": dia_iso,
        "agent_key": chave,
        "function": FUNCAO.get(chave, "unknown"),
        # ★ v4: TOTAL verificado — Cloudflare OU faixa de IP oficial do
        # operador. As duas pernas continuam nomeadas abaixo, para quem
        # precisar da origem de cada uma.
        "requests_sampled": cf_sampled + ip_sampled,
        "requests_estimated": cf_estimated + ip_estimated,
        "requests_sampled_cloudflare_verified": cf_sampled,
        "requests_estimated_cloudflare_verified": cf_estimated,
        "requests_sampled_ip_range": ip_sampled,
        "requests_estimated_ip_range": ip_estimated,
        # None quando este agente não tem faixa oficial publicada — ausência
        # de operador NUNCA vira "0" silencioso, que pareceria "faixa
        # conhecida e vazia" em vez de "faixa desconhecida".
        "ip_range_operator": operador,
        "ip_range_prefixes_total": prefixos_total,
        "requests_local_verification": dados["requests_local_verification"],
        # O que saiu da conta, nomeado: UA de bot que nem a Cloudflare nem a
        # faixa de IP oficial autenticaram, e que não veio do Brasil.
        "requests_sampled_unverified_ua": dados["requests_sampled_unverified_ua"],
        "requests_estimated_unverified_ua": round(dados["requests_estimated_unverified_ua"]),
        "countries_unverified_ua": dict(sorted(
            dados["countries_unverified"].items(), key=lambda kv: -kv[1])),
        "authenticity": _autenticidade_de(cf_sampled, ip_sampled),
        "verified_bot_categories": dict(sorted(dados["verified_bot_categories"].items())),
        "countries": dict(sorted(dados["countries"].items(), key=lambda kv: -kv[1])),
        "user_agent_samples": sorted(dados["user_agents"]),
        "window_start": ini_str,
        "window_end": fim_str,
        "query_truncated": truncado,
        "sampled_dataset": True,
    }


def coletar_dia(headers, zona, dia, root=None):
    """Uma janela de 24h UTC. Devolve (registros, aviso_de_truncagem, erro).

    Duas fases: (1) a consulta primária, por User-Agent, particiona em
    verificado-pela-Cloudflare / sonda-local-do-BR / sem-verificação; (2) para
    quem sobrou sem verificação E tem faixa oficial de IP conhecida, uma
    segunda consulta por `clientIP` reclassifica o que cai dentro da faixa.
    """
    if root is None:
        root = ROOT
    ini = datetime.datetime.combine(dia, datetime.time.min, datetime.timezone.utc)
    fim = ini + datetime.timedelta(hours=23, minutes=59, seconds=59)
    agora = datetime.datetime.now(datetime.timezone.utc)
    if fim > agora:
        fim = agora
    ini_str = ini.strftime("%Y-%m-%dT%H:%M:%SZ")
    fim_str = fim.strftime("%Y-%m-%dT%H:%M:%SZ")

    zona_dados, erro = graphql(headers, CONSULTA, {
        "zone": zona, "since": ini_str, "until": fim_str, "limite": LIMITE_GRUPOS})
    if erro:
        return [], False, erro

    grupos = zona_dados.get("httpRequestsAdaptiveGroups", [])
    truncado = len(grupos) >= LIMITE_GRUPOS
    por_agente = _acumular_primario(grupos)

    # ★ FASE 2 (2026-09-02): reverifica por FAIXA DE IP OFICIAL quem sobrou
    # sem verificação da Cloudflare. Ver o docstring do módulo para o porquê —
    # em resumo, PerplexityBot: 100% verifiedBotCategory vazia, 100% dos
    # clientIP dentro dos 8 prefixos oficiais.
    faixas = botagents.ler_faixas(root)
    operadores = _operadores_de_faixa(root)
    for chave in _candidatos_ip_range(por_agente, faixas):
        dados = por_agente[chave]
        tokens = _tokens_de_familia(chave, dados["user_agents_unverified"])
        if not tokens:
            # Sem grafia real capturada para montar o filtro — não há como
            # pedir a segunda consulta com segurança. Fica sem verificação de
            # IP neste dia, nomeado no stderr, nunca escondido.
            print("  AVISO: %s sem amostra de User-Agent para montar o filtro "
                  "de faixa de IP em %s" % (chave, dia.isoformat()), file=sys.stderr)
            continue
        consulta = _consulta_secundaria(_filtro_or_userAgent(tokens))
        zona_dados_2, erro_2 = graphql(headers, consulta, {
            "zone": zona, "since": ini_str, "until": fim_str, "limite": LIMITE_GRUPOS})
        if erro_2:
            # Falha da SEGUNDA consulta não derruba o dia inteiro — o dado
            # primário continua valendo, só a reverificação por IP não
            # aconteceu para este agente. Fica declarado, nunca silencioso.
            print("  AVISO: consulta de faixa de IP falhou para %s em %s: %s"
                  % (chave, dia.isoformat(), erro_2), file=sys.stderr)
            continue
        grupos_2 = zona_dados_2.get("httpRequestsAdaptiveGroups", [])
        if len(grupos_2) >= LIMITE_GRUPOS:
            truncado = True
        movido_amostrado, movido_estimado, paises_movidos = \
            _processar_grupos_secundarios(grupos_2, chave, faixas.get(chave, []))
        _aplicar_fase2_ip_range(dados, movido_amostrado, movido_estimado, paises_movidos)

    registros = [_montar_registro(dia.isoformat(), chave, dados, operadores,
                                   ini_str, fim_str, truncado)
                 for chave, dados in sorted(por_agente.items())]
    return registros, truncado, ""


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dias", type=int, default=RETENCAO_DIAS,
                        help="janelas retroativas de 24h (teto de retencao: %d)" % RETENCAO_DIAS)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.dias > RETENCAO_DIAS:
        print("generate-bot-agents-daily: --dias %d acima da retencao de %d dias do dataset; "
              "a API recusaria o resto" % (args.dias, RETENCAO_DIAS), file=sys.stderr)
        args.dias = RETENCAO_DIAS

    env = ler_env()
    headers = cabecalhos(env)
    if not headers:
        print("generate-bot-agents-daily: sem credencial Cloudflare em .env.local "
              "(CLOUDFLARE_ZONE_TOKEN ou CLOUDFLARE_EMAIL + CLOUDFLARE_API_TOKEN)",
              file=sys.stderr)
        return 2

    with open(SITE, encoding="utf-8") as handle:
        dominio = json.load(handle)["base_url"].rstrip("/").split("//", 1)[-1]
    zona, erro = resolver_zona(headers, dominio)
    if erro:
        print("generate-bot-agents-daily: %s" % erro, file=sys.stderr)
        return 2

    hoje = datetime.datetime.now(datetime.timezone.utc).date()
    registros = []
    falhas = []
    truncadas = []
    for recuo in range(args.dias):
        dia = hoje - datetime.timedelta(days=recuo)
        do_dia, truncado, erro = coletar_dia(headers, zona, dia)
        if erro:
            # Falha de janela NÃO é silenciosa e NÃO vira exit 0: o
            # check-edge-traffic imprime "indisponivel" e sai 0, e foi assim que
            # a série por bot nunca existiu sem ninguém notar.
            falhas.append((dia.isoformat(), erro))
            continue
        if truncado:
            truncadas.append(dia.isoformat())
        registros.extend(do_dia)

    if falhas:
        for dia, erro in falhas:
            print("  FALHA %s: %s" % (dia, erro), file=sys.stderr)
    if truncadas:
        print("  AVISO: consulta no teto de %d grupos em %s — a cauda foi cortada."
              % (LIMITE_GRUPOS, ", ".join(truncadas)), file=sys.stderr)

    # Relatório humano, separado por FUNÇÃO — o eixo que importa.
    por_funcao = {}
    for registro in registros:
        if registro["date"] != hoje.isoformat():
            continue
        por_funcao.setdefault(registro["function"], []).append(registro)
    print("bot VERIFICADO (Cloudflare ou faixa de IP), por User-Agent EXATO — %s"
          % hoje.isoformat())
    print("(dataset amostrado; estimado = amostra x sampleInterval)")
    for funcao in botagents.ORDEM_FUNCAO:
        linhas = sorted(por_funcao.get(funcao, []), key=lambda r: -r["requests_estimated"])
        if not linhas:
            continue
        print("\n  [%s]" % funcao)
        for linha in linhas:
            paises = ",".join(list(linha["countries"])[:3]) or "-"
            local = linha["requests_local_verification"]
            nao_verificado = linha["requests_sampled_unverified_ua"]
            faixa_ip = linha["requests_sampled_ip_range"]
            marcas_fora = []
            if local:
                marcas_fora.append("+%d sonda local" % local)
            if nao_verificado:
                marcas_fora.append("+%d UA sem verificacao" % nao_verificado)
            sufixo_fora = ("   (%s — fora da metrica)" % ", ".join(marcas_fora)) \
                if marcas_fora else ""
            sufixo_ip = ("   [%d via faixa de IP oficial: %s]"
                         % (faixa_ip, linha.get("ip_range_operator") or "?")) if faixa_ip else ""
            print("    %-28s verificado=%-6d estimado=%-7d %-10s%s%s"
                  % (linha["agent_key"], linha["requests_sampled"],
                     linha["requests_estimated"], paises, sufixo_ip, sufixo_fora))

    fora_total = sum(r["requests_sampled_unverified_ua"] + r["requests_local_verification"]
                     for r in registros if r["date"] == hoje.isoformat())
    dentro_total = sum(r["requests_sampled"] for r in registros if r["date"] == hoje.isoformat())
    print("\n  identidade: verifiedBotCategory da Cloudflare (rDNS + faixa de IP do operador)")
    print("  OU clientIP dentro da faixa oficial do operador, quando a Cloudflare nao verifica.")
    print("  hoje: %d requisicao(oes) amostrada(s) VERIFICADA(S) contra %d com User-Agent de bot"
          % (dentro_total, fora_total))
    print("  sem verificacao — estas ultimas sao, em larga medida, a sonda de auditoria deste")
    print("  repositorio: o cabecalho X-Bot-Simulation so chega ao nginx, nunca a borda.")

    ausentes = [c for c, f in FUNCAO.items() if f == "search"
                and c not in {r["agent_key"] for r in registros}]
    if ausentes:
        print("\n  bots de BUSCA/CITACAO sem nenhuma requisicao na janela: %s"
              % ", ".join(sorted(ausentes)))

    if registros:
        os.makedirs(os.path.dirname(SERIE), exist_ok=True)
        # Append-only, como check-edge-traffic: o arquivo nunca é reescrito para
        # não competir com outra frente. Uma chave (date, agent_key) pode ter
        # várias linhas — a ÚLTIMA é a boa, e quem consumir deduplica assim.
        #
        # O FLOCK ENTROU EM 2026-08-26, junto com o compactador. Append de um
        # processo só nunca precisou de trava; o que precisa é a EXCLUSÃO MÚTUA
        # com `tools/generate-edge-ledger-compaction`, que reescreve o arquivo
        # inteiro. Sem a trava, um append caindo no meio da reescrita entraria
        # num arquivo que está sendo substituído — e o dado perdido seria
        # justamente uma janela de rastreio que não volta, porque a borda não
        # reexpõe o passado. A trava é sobre o arquivo `.lock` ao lado, e não
        # sobre o próprio ledger, para que leitor nenhum precise conhecê-la.
        with open(SERIE + ".lock", "w", encoding="utf-8") as trava:
            fcntl.flock(trava, fcntl.LOCK_EX)
            with open(SERIE, "a", encoding="utf-8") as handle:
                for registro in registros:
                    handle.write(json.dumps(registro, ensure_ascii=False, sort_keys=True) + "\n")
        print("\nserie gravada em %s (%d registro(s), %d dia(s))"
              % (os.path.relpath(SERIE, ROOT), len(registros),
                 len({r["date"] for r in registros})))
        print("append-only: dedupe por (date, agent_key) mantendo a ULTIMA linha")

    if args.json:
        print(json.dumps(registros, ensure_ascii=False, indent=2))

    # Falha de janela é erro de verdade: sem exit≠0 um timer quebrado passaria
    # despercebido e a série morreria em silêncio, que é exatamente o defeito
    # que esta ferramenta veio corrigir.
    return 1 if falhas else 0


if __name__ == "__main__":
    sys.exit(main())
