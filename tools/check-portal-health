def unidades_dependentes(servico):
    """Nomes em Requires= e Wants= da unit viva, pelo systemd (nao pelo arquivo)."""
    try:
        r = subprocess.run(["systemctl", "show", servico, "-p", "Requires,Wants"],
                           capture_output=True, text=True, timeout=20)
    except Exception:
        return []
    nomes = []
    for linha in r.stdout.splitlines():
        _, _, valor = linha.partition("=")
        nomes.extend(v for v in valor.split() if v.startswith("wikijuridica-"))
    return nomes


def load_state(nome):
    """LoadState pelo systemd, ou "" quando nao da para perguntar."""
    try:
        r = subprocess.run(["systemctl", "show", nome, "-p", "LoadState", "--value"],
                           capture_output=True, text=True, timeout=20)
    except Exception:
        return ""
    return r.stdout.strip()


def nome_de_arquivo(unit):
    """`wikijuridica-server` -> `wikijuridica-server.service`.

    O systemd aceita o nome sem sufixo e resolve para .service; ops/systemd nao:
    la o arquivo tem o sufixo. Sem esta traducao, instalar a unit do PROPRIO
    servico procuraria `ops/systemd/wikijuridica-server` e nao acharia nada.
    """
    return unit if unit.endswith(SUFIXOS_UNIT) else unit + ".service"


def dependencias_nao_carregadas(servico):
    """As units que o systemd carrega como `not-found` — a do proprio servico
    PRIMEIRO, depois as que ele exige.

    A ordem e obrigatoria e nao e detalhe: com a unit do servico ausente,
    `systemctl show <servico> -p Requires` devolve vazio, e a dependencia dela
    fica invisivel. Instalada a unit do servico e recarregado o systemd, o
    Requires= aparece — e e a segunda passada de quem chama que a apanha.
    """
    faltam = []
    if load_state(servico) == "not-found":
        faltam.append(nome_de_arquivo(servico))
    for nome in unidades_dependentes(servico):
        if load_state(nome) == "not-found":
            faltam.append(nome)
    return faltam


def instalar_unit(nome):
    """`systemctl enable <caminho no repo>` + daemon-reload. Devolve (ok, detalhe).

    ENABLE, e nao o `ln -sf` que estava aqui ate 2026-09-05. O `ln` criava so o
    symlink em /etc/systemd/system, que e o estado `linked`: o systemd passa a
    CONHECER a unit e `systemctl start` a sobe — mas nada a sobe no boot, porque
    o symlink que o boot le e o de <target>.wants/, e so o `enable` o cria. O
    reparo devolvia o portal ao ar e deixava a unit fora do proximo reboot; o
    defeito sobreviveria calado ate a maquina reiniciar, que e o pior momento
    para descobri-lo. `enable` com caminho absoluto faz as duas coisas numa
    chamada. Quem prova o resultado e tools/check-social-units-enabled.
    """
    origem = os.path.join(DIR_UNITS_REPO, nome)
    if not os.path.isfile(origem):
        return False, "sem arquivo em ops/systemd"
    try:
        r = subprocess.run(["sudo", "-n", "systemctl", "enable", "--", origem],
                           capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            return False, (r.stderr.strip() or "enable falhou")[:120]
        r = subprocess.run(["sudo", "-n", "systemctl", "daemon-reload"],
                           capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            return False, (r.stderr.strip() or "daemon-reload falhou")[:120]
    except Exception as erro:
        return False, str(erro)[:120]
    # Codigo de saida zero nao e prova (R2 do contrato do dado real): pergunta ao
    # systemd, depois do reload, se ele agora CARREGA a unit e se ela sobe no
    # BOOT. Um `enable` que sai 0 sem pousar o symlink deixaria o vigia
    # declarando cura que nao houve, e a proxima noticia seria o portal fora do
    # ar depois de um reboot — com o journal repetindo `Unit ... not found`.
    if load_state(nome) == "not-found":
        return False, "enable saiu 0 e o systemd segue com %s not-found (conferir %s)" % (nome, DIR_UNITS_ETC)
    estado = is_enabled(nome)
    if estado and estado != "enabled":
        return False, "enable saiu 0 e is-enabled devolveu `%s`: a unit nao sobe no boot" % estado
    return True, "enable + daemon-reload"


def is_enabled(unit):
    """Palavra literal de `systemctl is-enabled`, ou "" quando nao da para medir.

    O comando sai != 0 para disabled/not-found e ainda assim imprime a palavra:
    o que vale e a saida, nao o codigo.
    """
    try:
        r = subprocess.run(["systemctl", "is-enabled", "--", unit],
                           capture_output=True, text=True, timeout=20)
    except Exception:
        return ""
    linhas = (r.stdout or r.stderr).strip().splitlines()
    return linhas[-1].strip() if linhas else ""


def servico_exige_socket(servico):
    return any(n.endswith(".socket") for n in unidades_dependentes(servico))


def binario_herda_socket():
    try:
        with open(BINARIO, "rb") as fh:
            return b"LISTEN_FDS" in fh.read()
    except OSError:
