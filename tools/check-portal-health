def disparar_deploy(agora):
    """Um deploy --sem-republicar, desacoplado, sob flock -n: se outro deploy ou
    comando pesado segura o lock, nao faz nada (e diz)."""
    os.makedirs(os.path.join(ROOT, ".agents/runtime"), exist_ok=True)
    log = os.path.join(ROOT, ".agents/runtime/watchdog-deploy-%s.log" % agora.strftime("%Y%m%d-%H%M%S"))
    cmd = "flock -n %s %s --sem-republicar > %s 2>&1" % (LOCK_PESADO, DEPLOY, log)
    try:
        subprocess.Popen(["bash", "-c", cmd], cwd=ROOT, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as erro:
        return "deploy_nao_disparou:%s" % str(erro)[:80]
    return "deploy_disparado:%s" % os.path.relpath(log, ROOT)


def pedir(url, host=None, timeout=10.0):
    cabecalhos = {"User-Agent": USER_AGENT, "X-Warming-Request": "true"}
    if host:
        cabecalhos["Host"] = host
    pedido = urllib.request.Request(url, headers=cabecalhos)
    try:
        with urllib.request.urlopen(pedido, timeout=timeout) as resposta:
            return resposta.status, len(resposta.read())
    except urllib.error.HTTPError as erro:
        return erro.code, 0
    except Exception:
        return 0, 0


# Falhas de leitura do systemd nesta execucao. Lista e nao booleano porque o
# vigia consulta VARIAS propriedades de DUAS units, e a mensagem tem de dizer
# qual leitura falhou — "systemd ilegivel" sem o nome manda o proximo leitor
# reproduzir a investigacao inteira.
FALHAS_SYSTEMD = []


def systemd_propriedade(nome, unidade=None):
    """Le uma propriedade do systemd. `unidade` default e o servico do acervo.

    O parametro nasceu quando a rede social virou o segundo alvo do vigia
    (2026-09-05): sem ele, perguntar o ActiveState do wikijuridica-social
    devolveria o do wikijuridica-server, e o vigia diria que a rede social esta
    de pe lendo o estado de OUTRO processo. O default preserva as chamadas que
    ja existiam, que nao passam unidade nenhuma.
    """
    try:
        saida = subprocess.run(
            ["systemctl", "show", unidade or SERVICO, "-p", nome, "--value"],
            capture_output=True, text=True, timeout=10)
        return saida.stdout.strip()
    except Exception as erro:
        # A FALHA PASSA A DEIXAR RASTRO, e este `return ""` deixa de ser mudo.
        #
        # Ate 2026-09-16 a excecao era engolida e a funcao devolvia "". O efeito
        # no chamador era invisivel e grave: `int("" or 0)` = 0, entao NRestarts
        # virava 0, o delta virava 0 e o detector de LACO DE RESTART — que e o
        # unico instrumento da classe (A) descrita em
        # ops/systemd/wikijuridica-social.service:85-95, e o que pegou os 87
        # restarts da rede social — ficava permanentemente cego dizendo "OK".
        #
        # `systemctl show` devolve rc 0 ate para unit inexistente (medido em
        # 2026-09-16), entao rc nao serve de sinal. So a excepcao (binario
        # ausente, timeout) distingue INSTRUMENTO INDISPONIVEL de unit parada, e
        # e essa distincao que vira exit 2 no fim do main.
        FALHAS_SYSTEMD.append("%s de %s: %s" % (nome, unidade or SERVICO, erro))
        return ""


def carregar_estado():
    try:
        with open(ESTADO, encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}


def ler_estado_anterior():
    try:
        with open(ESTADO, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
