#!/usr/bin/env bash
# run-moderacao-revisar-prazos — marca como "atrasada" toda fila de moderação
# cujo prazo venceu, e grava na trilha append-only o que mudou de estado.
#
# POR QUE ISTO EXISTE. `moderacao.Banco.RevisarPrazos` fazia o UPDATE e o
# SELECT desde que o pacote foi escrito e NUNCA ERA CHAMADO fora dos dois
# testes de internal/moderacao/denuncia_test.go. Enquanto nenhum processo o
# executasse, `estado = 'atrasada'` nunca nascia no banco de produção, e
# `moderacaotransparencia` mede a mesma fila por dois caminhos independentes
# (estado gravado vs. prazo comparado ao relógio) — a divergência entre os
# dois nasceria permanentemente verdadeira no primeiro prazo vencido, e a
# página pública /redesocial/transparencia/ já a publica como fato.
#
# O BINÁRIO É CONSTRUÍDO AQUI, como em run-lgpd-expurgo: a revisão roda todo
# dia e um binário desatualizado revisaria com a regra velha em silêncio.
#
# FALHA FECHADA: qualquer erro sai com código diferente de zero, e a unit tem
# `OnFailure=` — uma revisão que falha em silêncio deixa a divergência de
# transparência aberta enquanto o painel continua verde.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
raiz="$PWD"

binario="$raiz/bin/wikijuridica-moderacao-revisar-prazos"
mkdir -p "$raiz/bin"

# `nice` porque a revisão não corre contra ninguém: ela pode esperar o disco.
nice -n 10 ./tools/go-modern build -o "$binario" ./cmd/moderacao-revisar-prazos

# O comando lê WIKI_SOCIAL_DATA_DIR sozinho (mesma variável da unit da rede
# social e da de lgpd-expurgo) e recusa diretório sem banco em vez de criar um
# vazio e relatar sucesso. `-raiz` aponta para content/social_policy.json, que
# o comando precisa ler para validar a política antes de abrir o banco.
# Repassar os argumentos permite `-agora` e `-json` em conferência manual.
exec "$binario" "-raiz" "$raiz" "$@"
