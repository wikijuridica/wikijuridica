#!/usr/bin/env bash
# generate-moderacao-transparencia-diaria — a série diária agregada e sem PII da
# moderação, insumo do relatório de transparência que o STF passou a exigir da
# plataforma em 26/06/2025 (RE 1.037.396 / Tema 987 e RE 1.057.258 / Tema 533).
#
# ★ O QUE ELA PUBLICA QUE QUASE NINGUÉM PUBLICA — itens que o filtro do dever de
# cuidado ativo (tese 4) SINALIZOU contra quantos, depois de olhados por um
# humano, viraram remoção: a taxa de falso positivo do próprio filtro, aberta por
# código de detector. É o único número do relatório que pode ficar feio por culpa
# da plataforma, e é por isso que ele é o que torna o relatório honesto.
#
# ★ SEPARAÇÃO DE PAPÉIS — Este é um `generate-*`: ele ESCREVE a amostra em
# data/ops/moderacao_transparencia_diaria.jsonl. Quem julga e reprova é
# `tools/check-moderacao-transparencia-serie`, que é read-only.
#
# ★ FALHA FECHADA — dia sem banco da moderação vira linha `estado: "sem_banco"`,
# `coletas: 0`, todas as células `medida: false`. Nunca uma linha de zeros (que
# diria "dia tranquilo") e nunca a ausência da linha (que sumiria com a lacuna).
#
# ★ SÓ DIA FECHADO — o padrão é gerar ontem (UTC) e recuperar os dias que
# faltarem, até o teto de 31 por execução. O dia corrente ainda recebe decisões, e
# a série é append-only: linha que nasce provisória teria de ser corrigida depois.
#
# ★ SOMENTE LEITURA — o banco da moderação é aberto com `_pragma=query_only(1)`.
# Este comando não escreve no estado canônico da moderação, e não CRIA o banco se
# ele não existir: um banco vazio criado aqui transformaria "a rede social ainda
# não subiu" em "a moderação não teve movimento".
#
#   tools/generate-moderacao-transparencia-diaria
#   tools/generate-moderacao-transparencia-diaria --dia 2026-09-03
#   tools/generate-moderacao-transparencia-diaria --banco /tmp/x.db --saida /tmp/s.jsonl
#   tools/generate-moderacao-transparencia-diaria --refazer --dia 2026-09-03
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"

# ENVELOPE OBRIGATORIO, e nao enfeite: `go-modern run` direto passa por fora do
# orcamento, do stop_condition, do cache de binario e do artifact_claim. O
# claim e a parte que importa aqui -- ele registra QUEM escreveu
# data/ops/moderacao_transparencia_diaria.jsonl, e sem isso duas sessoes podem
# gravar a serie sem que ninguem saiba de onde veio a linha.
# TestMaterialGenerateWrappersDoNotCallGoRunDirectly cobra isto.
#
# Os numeros sao MEDIDOS (2026-09-05), nao estimados: a passada real leva 0,30s
# e produz 1 linha por dia. O orcamento de 30s e a folga para compilacao com
# cache frio e para a maquina compartilhada; nao e' teto de trabalho.
#
# WIKI_HEAVY_TIMING_MODE FALTAVA (medido 2026-09-10, unit failed exit
# 2/INVALIDARGUMENT): o commit 9f882b31 (2026-09-05) trouxe todo o resto do
# envelope mas nao esta variavel, e `run-heavy-throttled` a exige desde
# 19b7f1f3 -- sem `--timings` no comando filho nem `WIKI_HEAVY_TIMING_MODE`,
# ele recusa com "missing: timing_evidence(...)" antes mesmo do lock. O
# gerador nao tem flag `--timings` propria; `supervisor_wall_clock_v1` e o
# modo que `tools/generate-legal-corpus-article-index` ja usa para o mesmo
# caso (relogio medido pelo supervisor, nao pelo binario).
export WIKI_HEAVY_TIMING_MODE="${WIKI_HEAVY_TIMING_MODE:-supervisor_wall_clock_v1}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:moderacao-transparencia-diaria:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-30000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-1000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=3}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/moderacao_transparencia_diaria.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-moderacao-transparencia-diaria}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/moderacao_transparencia_diaria.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-120}"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-moderacao-transparencia-diaria "$@"
