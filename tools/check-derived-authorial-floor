    if incertas_estoque:
        print(f"  banda de incerteza ({TETO_CITADO_INCERTO:.1%}–{TETO_CITADO_NO_ESTOQUE:.1%} citado no JSONL): "
              f"{len(incertas_estoque)} pagina(s) — o JSONL nao decide, meça depois do render")
        for m in sorted(incertas_estoque, key=lambda x: -x[6])[
                : len(incertas_estoque) if args.verbose else 5]:
            print(f"      {m[1]}:{m[2]} — {m[6]:.1%} citado no JSONL, {m[5]} palavras proprias")

    if not abaixo_do_piso and not acima_do_teto and not reprovados_unicidade and not fora_do_estoque:
        print("check-derived-authorial-floor: OK (as duas camadas da DEC-032 se sustentam, e nenhum molde se repete)")
