            continue
        print(
            f"    {familia}: {len(paginas_familia)} paginas | mediana {statistics.median(pares_familia):.4f} "
            f"| max {max(pares_familia):.4f} (limiar {LIMIAR_UNICIDADE:.2f})"
        )

    medidas_estoque, fora_do_estoque, incertas_estoque = duas_camadas_no_estoque(sys.stderr)
    if medidas_estoque is None:
        return 1
    if not medidas_estoque:
        print("check-derived-authorial-floor: FAIL")
        print("  - nenhuma pagina com citacao oficial no estoque dos canais derivados")
        print("    (data/editorial/v2_pages), e em 2026-09-16 havia 1.434. Silencio e")
        print("    defeito: ou o estoque sumiu, ou a regua parou de casar com o JSONL.")
        return 1
    proporcoes_estoque = sorted(m[6] for m in medidas_estoque)
    autorais_estoque = sorted(m[5] for m in medidas_estoque)
    print(
