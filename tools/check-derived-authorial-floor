        print("  quebrar o bloco transcrito em excertos comentados um a um, ou ampliar a")
        print("  camada autoral. Editar o JSONL na mao e relaxar o limite estao os dois")
        print("  proibidos: o limite veio da medicao do acervo, nao de escolha.")
    if fora_do_estoque:
        print(f"  - duas camadas fora da regua NO ESTOQUE (ainda nao publicadas): "
              f"{len(fora_do_estoque)} de {len(medidas_estoque)}")
        for m in sorted(fora_do_estoque, key=lambda x: -x[6])[
                : len(fora_do_estoque) if args.verbose else 5]:
            print(f"      {m[1]}:{m[2]} — {m[6]:.1%} citado, {m[5]} palavras proprias "
                  f"(corpo {m[3]}, maior bloco {m[7]})")
        print("  Este eixo mede o JSONL, nao o HTML: ele existe para a familia NOVA")
        print("  ser medida ANTES da primeira publicacao. Publicar assim leva o")
        print("  defeito para o ar e so entao acende os eixos de public/.")
    if reprovados_unicidade:
        paginas_afetadas = set()
        for _, familia, shard_a, intent_a, shard_b, intent_b in reprovados_unicidade:
            paginas_afetadas.add((shard_a, intent_a))
            paginas_afetadas.add((shard_b, intent_b))
        print(
