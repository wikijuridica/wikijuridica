# geradores derivados emitem antes da transcrição ("fixou a seguinte tese:",
# "registra a decisão nestes termos:", "a controvérsia foi delimitada assim:").
ATO_OFICIAL = re.compile(
    r"(?i)\b(tese|s[úu]mula|ac[óo]rd[ãa]o|informativo|enunciado|controv[ée]rsia"
    r"|dispositivo|tribunal|STF|STJ|TST|TRF|texto oficial|reda[çc][ãa]o"
    r"|orienta[çc][ãa]o|precedente|julgamento|repetitiv|reperc)"
)

# Blocos do <main> que existem em toda página e não são comentário autoral.
CHROME = (
    r"(?is)<nav.*?</nav>",
    r'(?is)<p class="byline".*?</p>',
    r'(?is)<section class="prov".*?</section>',
    r'(?is)<p class="legal-notice".*?</p>',
    r'(?is)<section aria-labelledby="conteudos-relacionados".*?</section>',
)


def corpo_editorial(bruto: str) -> str:
    """Texto do <main> sem o chrome — é sobre ele que a camada autoral se mede."""
    corpo = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", " ", bruto)
    principal = re.search(r"(?is)<main.*?</main>", corpo)
    marcado = principal.group(0) if principal else corpo
    for padrao in CHROME:
        marcado = re.sub(padrao, " ", marcado)
    despido = re.sub(r"(?s)<[^>]+>", " ", marcado)
    return re.sub(r"\s+", " ", html.unescape(despido)).strip()


def mede(texto: str):
    """Devolve (palavras_totais, palavras_citadas, reproduz_texto_oficial, maior_bloco)."""
    total = len(texto.split())
    citadas = 0
    maior = 0
    oficial = False
    for achado in CITACAO.finditer(texto):
        palavras = len(achado.group(1).split())
        citadas += palavras
        if palavras >= MINIMO_CITACAO_OFICIAL:
            antes = texto[max(0, achado.start() - JANELA_CONTEXTO):achado.start()]
            if ATO_OFICIAL.search(antes):
                oficial = True
                maior = max(maior, palavras)
    return total, citadas, oficial, maior


