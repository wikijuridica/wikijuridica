        limite = len(reprovados_unicidade) if args.verbose else 5
        for score, familia, shard_a, intent_a, shard_b, intent_b in reprovados_unicidade[:limite]:
            print(f"      {score:.4f}  {familia}  {shard_a}:{intent_a}  x  {shard_b}:{intent_b}")
        print("  Molde repetido com numero trocado no meio (edicao/tema/data) e o que")
