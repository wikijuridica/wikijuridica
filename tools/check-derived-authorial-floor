    print("check-derived-authorial-floor: FAIL")
    if abaixo_do_piso:
        print(f"  - comentario autoral abaixo do piso: {len(abaixo_do_piso)} de {len(derivadas)}")
        for d in sorted(abaixo_do_piso, key=lambda x: x[3])[: len(abaixo_do_piso) if args.verbose else 5]:
