#!/usr/bin/env python3
"""Baixa do Wikidata (SPARQL público, sem chave) o mapa URN LexML → QID pela propriedade
P9119 "LexML Brazil ID" e grava data/corpus/wikidata/lexml_qids.jsonl com proveniência.

POR QUE (2026-09-08): 38.018 itens do Wikidata carregam URN LexML; 197 das 231 normas do
grafo jurídico já têm QID. `sameAs` para o QID coloca cada norma do portal no grafo de
conhecimento que todo LLM consulta para desambiguar entidade — de graça, por padrão aberto.
Consumidores: dumps de /datasets/ (nós do grafo), /api/v1/citar e /api/v1/citacoes; o JSON-LD
das páginas ganha `sameAs` no próximo --ressemear.

DETERMINISMO: linhas ordenadas por URN; o arquivo só é reescrito quando o conteúdo muda.
MEDIÇÃO: data/ops/wikidata_lexml_daily.jsonl (itens, cobertura das normas e dispositivos do grafo).
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import sqlite3
import sys
import tempfile
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SPARQL = "https://query.wikidata.org/sparql"
CONSULTA = "SELECT ?item ?lexml WHERE { ?item wdt:P9119 ?lexml . }"
UA = "Mozilla/5.0 (compatible; WikijuridicaBot/1.0; +https://wikijuridica.com.br/bot/; wikidata-lexml)"
SAIDA = "data/corpus/wikidata/lexml_qids.jsonl"
MEDICAO = "data/ops/wikidata_lexml_daily.jsonl"


def consulta(timeout=180):
    url = SPARQL + "?format=json&query=" + urllib.parse.quote(CONSULTA)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/sparql-results+json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        bruto = resp.read()
    dados = json.loads(bruto)["results"]["bindings"]
    return bruto, dados


def normaliza(dados):
    mapa = {}
    for b in dados:
        qid = b["item"]["value"].rsplit("/", 1)[-1]
        urn = b["lexml"]["value"].strip().lower()
        if urn.startswith("urn:lex:"):
            mapa.setdefault(urn, qid)  # primeiro QID por URN, ordem estável do SPARQL
    return mapa


def cobertura_do_grafo(root, mapa):
    caminho = os.path.join(root, "data", "ai", "grafo.sqlite")
    if not os.path.isfile(caminho):
        return {"grafo": "ausente"}
    conn = sqlite3.connect("file:%s?mode=ro" % caminho, uri=True)
    normas = [r[0] for r in conn.execute("SELECT chave FROM nos WHERE tipo='norma'")]
    disp = [r[0] for r in conn.execute("SELECT chave FROM nos WHERE tipo='dispositivo'")]
    conn.close()

    def base(chave):
        u = chave.split("norma:", 1)[-1] if chave.startswith("norma:") else chave
        u = u.split("dispositivo:", 1)[-1] if u.startswith("dispositivo:") else u
        return u.split("!", 1)[0].lower()

    normas_ok = sum(1 for k in normas if base(k) in mapa)
    disp_ok = sum(1 for k in disp if base(k) in mapa)
    return {"normas": len(normas), "normas_com_qid": normas_ok, "dispositivos": len(disp), "dispositivos_com_qid": disp_ok}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=ROOT)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    bruto, dados = consulta()
    mapa = normaliza(dados)
    agora = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    linhas = [json.dumps({"urn": u, "qid": mapa[u], "wikidata": "https://www.wikidata.org/wiki/" + mapa[u]}, sort_keys=True) for u in sorted(mapa)]
    corpo = "\n".join(linhas) + "\n"
    cobertura = cobertura_do_grafo(args.root, mapa)
    resumo = {"schema_version": "wikidata_lexml_v1", "date": agora[:10], "consultado_em": agora, "fonte": SPARQL,
              "propriedade": "P9119", "consulta": CONSULTA, "sha256_resposta": hashlib.sha256(bruto).hexdigest(),
              "itens": len(dados), "urns_distintas": len(mapa), "cobertura_grafo": cobertura}
    print(json.dumps(resumo, ensure_ascii=False))
    if args.dry_run:
        return 0
    saida = os.path.join(args.root, SAIDA)
    os.makedirs(os.path.dirname(saida), exist_ok=True)
    anterior = open(saida, encoding="utf-8").read() if os.path.isfile(saida) else ""
    if anterior != corpo:
        fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=os.path.dirname(saida))
        with os.fdopen(fd, "w", encoding="utf-8") as h:
            h.write(corpo)
        os.chmod(tmp, 0o644)
        os.replace(tmp, saida)
        with open(saida + ".proveniencia.json", "w", encoding="utf-8") as h:
            json.dump(resumo, h, ensure_ascii=False, indent=1, sort_keys=True)
    caminho_med = os.path.join(args.root, MEDICAO)
    os.makedirs(os.path.dirname(caminho_med), exist_ok=True)
    with open(caminho_med, "a", encoding="utf-8") as h:
        h.write(json.dumps(resumo, ensure_ascii=False, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
