#!/usr/bin/env python3
"""Repara UTF-8 lido como Latin-1 no corpus do STJ e no estoque v2.

POR QUE ISTO NAO FALSEIA PROVENIENCIA, e a distincao e o ponto todo.

A fonte oficial publicou "Justica" (com cedilha). Os bytes C3 A7 que o STJ
emitiu foram lidos como Latin-1 em algum ponto da coleta e gravados como a
sequencia de dois caracteres que o gate acusa -- que a fonte nunca escreveu.
Reparar isso RESTAURA o texto oficial; deixar como esta e que publica algo que o
tribunal nao disse. E o oposto do caso de `semLetraSoltaNaAbertura` em
cmd/generate-acordao-pages, onde a corrupcao esta NA FONTE e a citacao a
preserva de proposito.

O reparo e o roundtrip exato do defeito: a string vai a bytes por Latin-1 e
volta por UTF-8. Ele e SELETIVO por construcao, e sao tres guardas:

  1. so se a string casa a assinatura do defeito (C3/C2 seguido de continuacao);
  2. so se `encode("latin-1")` nao falha -- string com caractere fora de
     Latin-1 nao pode ter vindo desse caminho, e fica intacta;
  3. so se `decode("utf-8")` nao falha -- sequencia que nao e UTF-8 valido nao
     era UTF-8 mal lido, e fica intacta.

E uma quarta, que e a que impede reparo pela metade: o candidato so vale se
ELIMINOU a assinatura. Roundtrip que a mantem nao consertou nada.

MEDIDO EM 2026-09-16, e o numero honesto e pequeno: 3 linhas do corpus
(registros-2024-10.jsonl) e 1 pagina do estoque v2 (`jur-stj-resp-1834975`,
"Superior Tribunal de Justi<mojibake>a, em Sess<mojibake>o Virtual").

Correcao de uma medicao minha, porque o erro e instrutivo: eu havia contado
"32 linhas em 7 arquivos" com um padrao mais largo, que casava tambem
QUESTAO e ACORDAO -- palavras corretas em versal, onde A-til e seguido de
letra, nao de byte de continuacao. Mesma classe do falso positivo que este
reparo foi investigar. O numero que vale e o que o reparador de fato aplica.

Achado porque `cmd/check text-truncation` passou a separar FATO de JUIZO: as
461 ocorrencias de sufixo de titulo escondiam este de charset.

Read-only por padrao, no formato sancionado do repo (ver
.claude/rules/ferramenta-de-medicao.md): `--aplicar` e a unica forma de tocar o
disco. Exit 1 quando ha reparo pendente e nada foi escrito.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# C3 ou C2 seguido de byte de continuacao: a marca de UTF-8 lido como Latin-1.
ASSINATURA = re.compile("[\u00c3\u00c2][\u0080-\u00bf]")

# Um RUN e um trecho contiguo de caracteres que caberiam em Latin-1. O reparo
# acontece por run, nunca na string inteira, e a razao e medida: a secao de
# `jur-stj-resp-1834975` mistura o mojibake com a ASPA CURVA que o nosso proprio
# gerador insere (U+201C), que esta fora de Latin-1 -- `encode("latin-1")` sobre
# a secao toda levanta UnicodeEncodeError e o reparo nao acontecia nunca.
# Reparando por run, a aspa fica de fora e e preservada byte a byte.
RUN_LATIN1 = re.compile("[\u0001-\u00ff]+")


def repara_run(run: str) -> str:
    """Repara um trecho que cabe em Latin-1, ou devolve o original."""
    if not ASSINATURA.search(run):
        return run
    try:
        candidato = run.encode("latin-1").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return run
    # O reparo so vale se ELIMINOU a assinatura. Roundtrip que a mantem nao
    # consertou nada e pode ter movido o defeito de lugar.
    if ASSINATURA.search(candidato):
        return run
    return candidato


def repara(texto: str) -> str:
    """Devolve o texto reparado, ou o original quando o reparo nao se aplica."""
    if not ASSINATURA.search(texto):
        return texto
    return RUN_LATIN1.sub(lambda m: repara_run(m.group()), texto)


def repara_arvore(valor):
    """Aplica o reparo em toda string do documento, preservando a forma."""
    if isinstance(valor, str):
        return repara(valor)
    if isinstance(valor, list):
        return [repara_arvore(v) for v in valor]
    if isinstance(valor, dict):
        return {k: repara_arvore(v) for k, v in valor.items()}
    return valor


def processa(caminho: str, aplicar: bool) -> tuple[int, list[str]]:
    """Devolve (linhas reparadas, amostras). Nao escreve sem `aplicar`."""
    reparadas = 0
    amostras: list[str] = []
    saida: list[str] = []
    with open(caminho, encoding="utf-8") as arquivo:
        for numero, linha in enumerate(arquivo, 1):
            crua = linha.rstrip("\n")
            if not crua.strip():
                saida.append(crua)
                continue
            try:
                doc = json.loads(crua)
            except json.JSONDecodeError:
                # Linha ilegivel nao se toca: reparo nao e lugar de adivinhar
                # esquema, e perder a linha seria pior que o mojibake.
                saida.append(crua)
                continue
            novo = repara_arvore(doc)
            if novo == doc:
                saida.append(crua)
                continue
            reparadas += 1
            if len(amostras) < 3:
                ident = novo.get("intent_id") or novo.get("numeroRegistro") or f"linha {numero}"
                amostras.append(f"{os.path.basename(caminho)}:{numero} {ident}")
            saida.append(json.dumps(novo, ensure_ascii=False, sort_keys=True))
    if reparadas and aplicar:
        temporario = caminho + ".reparo"
        with open(temporario, "w", encoding="utf-8") as destino:
            for linha in saida:
                destino.write(linha + "\n")
        os.replace(temporario, caminho)
    return reparadas, amostras


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--aplicar", action="store_true",
                        help="escreve os arquivos; sem esta flag apenas relata")
    parser.add_argument("--raiz", default=RAIZ)
    argumentos = parser.parse_args()

    alvos = sorted(
        glob.glob(os.path.join(argumentos.raiz, "data/corpus/jurisprudencia/stj-espelhos/*.jsonl"))
        + glob.glob(os.path.join(argumentos.raiz, "data/editorial/v2_pages/*.jsonl"))
    )
    total = 0
    arquivos_tocados = 0
    for caminho in alvos:
        reparadas, amostras = processa(caminho, argumentos.aplicar)
        if not reparadas:
            continue
        arquivos_tocados += 1
        total += reparadas
        rotulo = "reparadas" if argumentos.aplicar else "reparaveis"
        print(f"repair-mojibake-v2: {os.path.relpath(caminho, argumentos.raiz)}: "
              f"{reparadas} linha(s) {rotulo}")
        for amostra in amostras:
            print(f"    {amostra}")

    verbo = "reparada(s)" if argumentos.aplicar else "reparavel(is)"
    print(f"repair-mojibake-v2: {total} linha(s) {verbo} em {arquivos_tocados} arquivo(s) "
          f"de {len(alvos)} varrido(s)")
    if total and not argumentos.aplicar:
        print("repair-mojibake-v2: nada foi escrito. Use --aplicar para gravar.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
