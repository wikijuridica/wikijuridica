#!/usr/bin/env bash
# tools/check-v2-public-path-collision — READ-ONLY.
#
# Atalho da casa para o gate registrado em internal/checks
# ("v2-public-path-collision"), implementado em internal/v2publicpathcollision.
# O gate reprova em duas classes:
#
#   v2_public_path_collision_live                 2+ paginas VIVAS materializam
#                                                 a mesma rota publica.
#   v2_public_path_collision_portfolio_unresolved 2+ intent_ids DISTINTOS do
#                                                 portfolio derivam a mesma rota
#                                                 e o par ainda nao foi resolvido
#                                                 por tombstone (deteccao ANTES
#                                                 de a pagina chegar ao acervo).
#
# Por que existe, se ja ha v2-cross-shard-collision: aquele compara intent_id,
# title e h1 exatos. A rota nasce de seedTermIDFromIntentID, que remove apenas o
# PRIMEIRO segmento do intent_id — dois intent_ids diferentes na mesma
# practice_area ("amb-direito-de-superficie" e "imob-direito-de-superficie")
# derivam a MESMA URL e passavam limpos pelo gate de intent_id.
#
# Tombstone (skipped=true ou superseded_by preenchido) e honrado: par ja
# consolidado nao reprova. Nao escreve nada; usa run-check, que recompila
# ./cmd/check quando a fonte muda.
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
exec "$ROOT/tools/run-check" v2-public-path-collision "$@"
