"""


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true",
                        help="mede e imprime, sem gravar")
    parser.add_argument("--json", action="store_true", help="saida para consumo por script")
    parser.add_argument("--self-test", action="store_true",
                        help="teste de falso positivo da regra de remocao (nao grava nada)")
    parser.add_argument("--unit", action="store_true",
                        help="imprime o trecho de unit systemd que agenda esta reconciliacao")
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if args.unit:
        print(UNIT_SUGERIDA)
        return 0
    try:
        return executar(args)
    except NaoConsigoMedir as erro:
        # exit 2 = NAO CONSEGUI MEDIR. Ver o cabecalho: exit 1 esta reservado a
        # veredito, e aqui nao ha veredito nenhum a dar.
        print("NAO CONSEGUI MEDIR: %s" % erro, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
