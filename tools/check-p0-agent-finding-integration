#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

cd "$ROOT"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# Gate for useful agent findings: declared material files must exist, and backlog/optional/future cannot replace an artifact.
exec "$ROOT/tools/run-check" p0-agent-finding-integration --timings "$@"
