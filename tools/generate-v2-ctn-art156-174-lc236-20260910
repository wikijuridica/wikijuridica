def confere(atual, antigo, onde: str) -> None:
    """`antigo` e o valor exato, ou "contem:<marca>" quando o texto e longo.

    A marca escolhida e sempre a frase que a correcao REMOVE, entao ela nao
    sobrevive a uma execucao ja aplicada — a guarda vale nas duas direcoes.
    """
    if antigo is None:
        return
    if isinstance(antigo, str) and antigo.startswith("contem:"):
        marca = antigo[len("contem:"):]
        if marca not in (atual or ""):
            raise SystemExit(f"marca esperada ausente em {onde}: {marca!r}")
        return
    if atual != antigo:
        raise SystemExit(f"valor inesperado em {onde}: {atual!r}")


def aplica(registro: dict, campo: str, antigo, novo_valor) -> int:
    if campo.startswith("fonte:"):
        # ANCHOR_CLAIM E PROVENIENCIA: ele afirma o que a fonte oficial DIZ. O
        # desta pagina dizia "art. 174 e seu paragrafo unico ... as quatro
        # causas de interrupcao", e a fonte hoje diz § 1o e oito causas. Ancora
        # que diverge da fonte deixa de ser ancora — atualiza-la nao e fabricar
        # proveniencia, e devolver-lhe a verdade.
        #
        # `verified_at` NAO se toca, e isso e regra e nao esquecimento: eu nao
        # busquei esta URL nesta sessao, e carimbar verificacao que nao fiz e a
        # fraude que o contrato proibe. A data continua sendo 2026-07-08, que e
        # quando alguem de fato conferiu.
        _, sufixo_url, atributo = campo.split(":", 2)
        for fonte in registro.get("official_sources", []):
            if not (fonte.get("url") or "").endswith(sufixo_url):
                continue
            if fonte.get(atributo) == novo_valor:
                return 0
            confere(fonte.get(atributo), antigo, f"fonte {sufixo_url!r}.{atributo}")
            fonte[atributo] = novo_valor
            return 1
        return 0
    if campo.startswith("faq:"):
        # A pergunta identifica o par; o atributo diz qual lado se troca. FAQ
        # entra aqui porque o "paragrafo unico do art. 174" tambem estava LA, e
        # corrigir so o corpo deixaria o endereco extinto na resposta — meia
        # correcao e pior que nenhuma, porque parece feita.
        _, pergunta, atributo = campo.split(":", 2)
        for par in registro.get("faq", []):
            if par.get("q") != pergunta:
                continue
            if par.get(atributo) == novo_valor:
                return 0
            confere(par.get(atributo), antigo, f"faq {pergunta!r}.{atributo}")
            par[atributo] = novo_valor
            return 1
        return 0
    _, heading, atributo = campo.split(":", 2)
    for secao in registro.get("sections", []):
        if secao.get("heading") != heading:
            continue
        if secao.get(atributo) == novo_valor:
            return 0
        confere(secao.get(atributo), antigo, f"{heading!r}.{atributo}")
        secao[atributo] = novo_valor
        return 1
    return 0


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    por_shard: dict[str, list] = {}
    for shard_rel, intent, campo, antigo, novo in CORRECOES:
        por_shard.setdefault(shard_rel, []).append((intent, campo, antigo, novo))

    total = 0
    for shard_rel, itens in por_shard.items():
        shard = RAIZ / shard_rel
        if not shard.exists():
            print(f"shard ausente: {shard}", file=sys.stderr)
            return 2
        saida: list[str] = []
        trocados = 0
        vistos: set[str] = set()
        for linha in shard.read_text(encoding="utf-8").splitlines():
            if not linha.strip():
                continue
            registro = json.loads(linha)
            for intent, campo, antigo, novo in itens:
                if registro.get("intent_id") != intent:
                    continue
                vistos.add(intent)
                trocados += aplica(registro, campo, antigo, novo)
            saida.append(json.dumps(registro, ensure_ascii=False))
        faltando = {intent for intent, _, _, _ in itens} - vistos
        if faltando:
            print(f"intent ausente em {shard.name}: {sorted(faltando)}", file=sys.stderr)
            return 1
        print(f"{shard_rel}: {trocados} campo(s) atualizado(s)")
        total += trocados
        if trocados == 0 or argumentos.dry_run:
            continue
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=shard.parent,
                                         prefix=".tmp-", delete=False) as temporario:
            temporario.write("\n".join(saida) + "\n")
            temporario.flush()
            os.fsync(temporario.fileno())
            caminho = temporario.name
        os.replace(caminho, shard)
        print(f"  gravado: {shard_rel}")

    if argumentos.dry_run:
        print("\n--dry-run: nada gravado")
    elif total:
        print("\nPROXIMO PASSO, obrigatorio — o texto cresceu:")
        print("  ./tools/generate-v2-word-count-refresh \\")
        for shard_rel in por_shard:
            print(f"      {shard_rel} \\")
    return 0


if __name__ == "__main__":
    sys.exit(main())
