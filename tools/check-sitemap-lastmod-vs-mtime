#!/usr/bin/env python3
"""check-sitemap-lastmod-vs-mtime — o indice e o arquivo tem que dizer a MESMA
data sobre o mesmo shard. READ-ONLY.

O DEFEITO QUE ELE EXISTE PARA IMPEDIR, medido em 2026-08-28 no acervo no ar:

  32 dos 35 shards anunciavam no indice uma data e respondiam outra no HTTP.

    pages-0001.xml  indice 2026-08-27   arquivo 2026-08-28
    pages-0002.xml  indice 2026-08-06   arquivo 2026-08-27
    pages-0003.xml  indice 2026-08-20   arquivo 2026-08-27

Sao duas grandezas diferentes que ninguem tinha comparado: o `<lastmod>` do
indice e ShardLastMod (o maximo das paginas do shard), e o `Last-Modified` vem
do mtime, que era a hora da ultima ESCRITA. O crawler que revalida um shard com
base no que o indice disse recebia 200 + shard inteiro em vez de 304.

E a causa medida de o Googlebot ter 6% de hit+revalidated no sitemap contra 55%
no robots.txt: a unica superficie estavel do portal era a unica que ele
conseguia revalidar barato. Corrigido em cmd/publish-v2-direct, que passou a
escrever os shards com gravaDatado em vez de grava.

NAO E SOBRE "DAR 304 E PETRIFICAR". E sobre o indice nao mentir: quando um shard
REALMENTE muda, o mtime avanca e o crawler baixa o novo. O que se elimina e o
caso em que ele baixa 1,4 MB de mapa para descobrir que nada mudou.

TOLERANCIA DE UM DIA, e ela nao e frouxidao: o `<lastmod>` do indice tem
granularidade de DIA e o mtime tem granularidade de segundo. Um shard escrito as
21:35 UTC de 28/08 e um lastmod de 2026-08-28 sao a MESMA coisa; comparar
instante contra dia acusaria 100% como divergente.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.abspath(os.path.dirname(__file__)))
INDICE = os.path.join(RAIZ, "public", "sitemap.xml")
SHARDS = os.path.join(RAIZ, "public", "sitemaps")
ENTRADA = re.compile(r"<loc>([^<]+)</loc>\s*<lastmod>([^<]+)</lastmod>")


def main() -> int:
    cli = argparse.ArgumentParser(description=__doc__,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    cli.add_argument("--json", action="store_true")
    cli.add_argument("--tolerancia-dias", type=int, default=0,
                     help="folga em dias entre o lastmod anunciado e o mtime do arquivo")
    argumentos = cli.parse_args()

    if not os.path.exists(INDICE):
        print("NAO MEDIDO: public/sitemap.xml ausente — o site foi publicado?", file=sys.stderr)
        return 2
    try:
        indice = open(INDICE, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError) as erro:
        print("NAO MEDIDO: %s" % erro, file=sys.stderr)
        return 2

    entradas = ENTRADA.findall(indice)
    if not entradas:
        print("NAO MEDIDO: o indice nao declara nenhum shard com lastmod", file=sys.stderr)
        return 2

    divergentes, coincidentes, ausentes = [], 0, []
    for loc, lastmod in entradas:
        nome = loc.rsplit("/", 1)[-1]
        caminho = os.path.join(SHARDS, nome)
        if not os.path.exists(caminho):
            # Shard anunciado e ausente do disco e outro defeito, e o gate de
            # carencia ja o cobre. Aqui ele so nao entra na conta.
            ausentes.append(nome)
            continue
        try:
            anunciado = datetime.date.fromisoformat(lastmod[:10])
        except ValueError:
            divergentes.append((nome, lastmod, "lastmod ilegivel"))
            continue
        # UTC, NAO hora local — e a primeira versao deste gate errou aqui.
        #
        # `dataEditorialComoMtime` carimba a MEIA-NOITE UTC da data editorial, e
        # o nginx emite `Last-Modified` em GMT. Lendo o mtime com
        # `date.fromtimestamp`, que usa o fuso local (-0300), a meia-noite UTC de
        # 2026-08-26 aparecia como 2026-08-25 e o gate acusava divergencia de um
        # dia em shards perfeitamente alinhados. Foi assim que a primeira
        # medicao depois da correcao reportou 8 divergentes quando varios eram
        # artefato do proprio medidor.
        arquivo = datetime.datetime.fromtimestamp(
            os.path.getmtime(caminho), datetime.timezone.utc).date()
        folga = abs((arquivo - anunciado).days)
        if folga > argumentos.tolerancia_dias:
            divergentes.append((nome, anunciado.isoformat(), arquivo.isoformat()))
        else:
            coincidentes += 1

    registro = {
        "schema_version": "sitemap_lastmod_vs_mtime_v1",
        "shards_no_indice": len(entradas),
        "coincidentes": coincidentes,
        "divergentes": len(divergentes),
        "anunciados_e_ausentes_do_disco": len(ausentes),
        "tolerancia_dias": argumentos.tolerancia_dias,
    }
    if argumentos.json:
        print(json.dumps(registro, ensure_ascii=False, sort_keys=True))
    else:
        print("indice x arquivo, shard a shard")
        print("  shards no indice : %d" % len(entradas))
        print("  coincidentes     : %d" % coincidentes)
        print("  divergentes      : %d" % len(divergentes))
        if ausentes:
            print("  anunciados e ausentes do disco: %d (%s)" % (len(ausentes), ", ".join(ausentes[:4])))

    if divergentes:
        print("\nREPROVADO: %d shard(s) anunciam no indice uma data e respondem outra no HTTP."
              % len(divergentes), file=sys.stderr)
        print("       O crawler que revalidar pelo indice recebe 200 + shard inteiro em vez de 304.",
              file=sys.stderr)
        for nome, anunciado, arquivo in divergentes[:8]:
            print("       %-18s indice %s  arquivo %s" % (nome, anunciado, arquivo), file=sys.stderr)
        return 1
    print("\ncheck-sitemap-lastmod-vs-mtime: o indice e o arquivo dizem a mesma data")
    return 0


if __name__ == "__main__":
    sys.exit(main())
