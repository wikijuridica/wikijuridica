#!/usr/bin/env python3
"""Remove a ancora de data que faz a abertura envelhecer sozinha.

O DEFEITO. A pagina `proc-titulo-regularizar` abre assim:

    "Em 11 de julho de 2026, o cadastro eleitoral esta fechado para
     alistamento, transferencia e revisao."

A frase esta no PRESENTE, ancorada num dia especifico. Ela era verdadeira em 11
de julho, continua verdadeira hoje -- e vira FALSA sozinha em 3 de novembro,
quando o cadastro reabre, sem ninguem olhando e sem nenhum gate acusando. Um
portal juridico que afirma "esta fechado" precisa que isso continue verdade
enquanto a pagina estiver no ar.

Foi o veredito REPROVADA:4 do auditor de banda 5 que apontou, citando a frase
literal -- e a pagina esta fora do ar desde entao por veredito_conflitante,
porque outro agente a havia aprovado.

A CORRECAO e de forma, nao de fato: o mesmo conteudo, dito de maneira que nao
depende de quando se le. "O cadastro fechou em 7 de maio de 2026 e sera
reaberto em 3 de novembro" e verdadeiro antes, durante e depois -- e informa
MAIS, porque da as duas datas em vez de uma foto de um dia qualquer.

De quebra, a data conflitante: a abertura dizia "o prazo terminou em 6 de maio"
e a secao de datas, "o cadastro fechou em 7 de maio". As duas estao certas e se
referem a coisas diferentes (ultimo dia para requerer x data do fechamento),
mas o leitor ve contradicao. O texto novo diz as duas coisas com o nome de cada
uma.

Escrita atomica e idempotente.

Uso:
    tools/generate-v2-titulo-eleitoral-data-ancorada-20260820 --dry-run
    tools/generate-v2-titulo-eleitoral-data-ancorada-20260820
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
SHARD = RAIZ / "data/editorial/v2_pages/procedimentos-12.jsonl"
INTENT = "proc-titulo-regularizar"

ANTIGA = (
    "Em 11 de julho de 2026, o cadastro eleitoral está fechado para alistamento, "
    "transferência e revisão. O prazo para participar das Eleições Gerais de 2026 "
    "terminou em 6 de maio, e essas operações só serão retomadas em 3 de novembro."
)
NOVA = (
    "O cadastro eleitoral fechou em 7 de maio de 2026 para alistamento, transferência "
    "e revisão, e será reaberto em 3 de novembro. O último dia para requerer essas "
    "operações a tempo das Eleições Gerais de 2026 foi 6 de maio — as duas datas são "
    "diferentes e valem para coisas diferentes: 6 de maio era o prazo do requerente, "
    "7 de maio é quando o cadastro efetivamente fechou."
)


def main() -> int:
    analisador = argparse.ArgumentParser(description=__doc__)
    analisador.add_argument("--dry-run", action="store_true")
    argumentos = analisador.parse_args()

    if not SHARD.exists():
        print(f"shard ausente: {SHARD}", file=sys.stderr)
        return 2

    saida, trocados, achou = [], 0, False
    for linha in SHARD.read_text(encoding="utf-8").splitlines():
        if not linha.strip():
            continue
        registro = json.loads(linha)
        if registro.get("intent_id") == INTENT:
            achou = True
            abertura = registro.get("opening") or ""
            if ANTIGA in abertura:
                registro["opening"] = abertura.replace(ANTIGA, NOVA)
                trocados += 1
        saida.append(json.dumps(registro, ensure_ascii=False))

    if not achou:
        print(f"intent {INTENT} nao esta no shard", file=sys.stderr)
        return 1
    if trocados == 0:
        print("nada a fazer: a abertura ja esta corrigida (idempotente)")
        return 0

    print("abertura reescrita:")
    print(f"  de : {ANTIGA[:96]}…")
    print(f"  para: {NOVA[:96]}…")
    if argumentos.dry_run:
        print("\n--dry-run: nada gravado")
        return 0

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=SHARD.parent,
                                     prefix=".tmp-", delete=False) as temporario:
        temporario.write("\n".join(saida) + "\n")
        temporario.flush()
        os.fsync(temporario.fileno())
        caminho = temporario.name
    os.replace(caminho, SHARD)
    print(f"gravado: {SHARD.relative_to(RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
