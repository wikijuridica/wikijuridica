#!/bin/sh
# generate-v2-writing-briefs — estágio de BRIEF determinístico (zero rede,
# zero LLM): resolve fonte oficial de cada intent faltante via corpus local
# (data/source-snapshots) + catálogo curado, e materializa briefs em
# data/editorial/v2_writing_briefs/. Escrita de arquivo inteiro serializada
# sob o lock pesado do repo; CPU sob nice (política de agentes).
set -eu
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
exec flock -w 600 /tmp/opt-wiki-agent-heavy.lock \
	nice -n 19 python3 "$ROOT/tools/generate_v2_writing_briefs.py" \
	--root "$ROOT" "$@"
