def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--modo", choices=("baseline", "reconferencia", "replay"),
                        default="baseline")
    parser.add_argument("--passes", default="",
                        help="diretório com pass1/2/3.jsonl das buscas repetidas (--modo replay)")
    parser.add_argument("--cache", default=str(CACHE_PADRAO))
    parser.add_argument("--urls-de", default="", help="arquivo com uma URL por linha")
    parser.add_argument("--rede", action="store_true", help="busca o que não está em cache")
    parser.add_argument("--rps-por-host", type=float, default=1.0)
    parser.add_argument("--hosts-paralelos", type=int, default=8)
    parser.add_argument("--limite", type=int, default=0)
    parser.add_argument("--baseline", default=str(BASELINE))
    parser.add_argument("--saida", default="")
    args = parser.parse_args()

    coerente, aviso = teto_do_gate_confere()
    if not coerente:
        print("ABORTA: " + aviso, file=sys.stderr)
        return 2
    if aviso:
        print("aviso: " + aviso, file=sys.stderr)

    cache = Path(args.cache)
    caminho_baseline = Path(args.baseline)

    if args.modo == "replay":
        if not args.passes:
            print("ABORTA: --modo replay exige --passes DIR", file=sys.stderr)
            return 2
        linhas_replay, resumo_replay = replay_das_buscas(Path(args.passes))
        if not linhas_replay:
            print("ABORTA: nenhum pass{1,2,3}.jsonl legível em %s" % args.passes,
                  file=sys.stderr)
            return 2
        saida = Path(args.saida) if args.saida else (
            ROOT / "data/ops/official_source_normative_fingerprint_pass_replay_20260812.jsonl")
        carga = "".join(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n"
                        for linha in [esquema_do_registro()] + linhas_replay + [resumo_replay])
        escrita_atomica(saida, carga.encode("utf-8"))
        print("URLs com 2+ buscas comparáveis: %d" % resumo_replay["urls_comparaveis"])
        print("  sha256 do corpo instável entre buscas: %d" % resumo_replay["sha256_instavel"])
        print("  impressão normativa instável:          %d" % resumo_replay["impressao_instavel"])
        for linha in linhas_replay:
            marca = []
            if not linha["sha256_estavel"]:
                marca.append("SHA-INSTAVEL")
            if not linha["impressao_estavel"]:
                marca.append("IMPRESSAO-INSTAVEL")
            if linha["buscas_sem_impressao"]:
                marca.append("sem impressão em " + ",".join(linha["buscas_sem_impressao"]))
            print("  %-22s %s" % (" ".join(marca) or "estável", linha["url"][:88]))
        print("\n%d registro(s) em %s" % (len(linhas_replay) + 2, os.path.relpath(saida, ROOT)))
        return 0

    if args.urls_de:
        fonte_urls = args.urls_de
        urls = [linha.strip() for linha in Path(args.urls_de).read_text(encoding="utf-8").splitlines()
                if linha.strip() and not linha.startswith("#")]
    elif args.modo == "reconferencia":
        fonte_urls = str(caminho_baseline.relative_to(ROOT))
        urls = sorted(carrega_baseline(caminho_baseline))
    else:
        fonte_urls = str(SEMENTE.relative_to(ROOT))
        urls = urls_da_semente()
    urls = sorted(dict.fromkeys(urls))
    if args.limite:
        urls = urls[: args.limite]
    if not urls:
        print("nenhuma URL para processar", file=sys.stderr)
        return 2

    print("documentos: %d | cache: %s | rede: %s"
          % (len(urls), cache, "sim" if args.rede else "não"))
    inicio = time.time()
    registros = coleta(urls, cache, args.rede, args.rps_por_host, args.hosts_paralelos)
    grupos = marca_colisoes(registros)
    resumo = resumo_de(registros, grupos, fonte_urls)

    if args.modo == "baseline":
        saida = Path(args.saida) if args.saida else caminho_baseline
        linhas = [esquema_do_registro()] + registros + [resumo]
    else:
        base = carrega_baseline(caminho_baseline)
        if not base:
            print("ABORTA: linha de base ausente em %s" % caminho_baseline, file=sys.stderr)
            return 2
        vereditos = []
        contagem: collections.Counter = collections.Counter()
        for registro in registros:
            anterior = base.get(registro["url"])
            if not anterior:
                julgamento = {"veredito": "indeterminado", "motivo": "URL fora da linha de base"}
            else:
                julgamento = veredito(anterior, registro)
            contagem[julgamento["veredito"]] += 1
            vereditos.append({
                "schema": ESQUEMA, "tipo": "reconferencia",
                "ferramenta": Path(__file__).name,
                "url": registro["url"],
                "consultado_em": registro["consultado_em"],
                "impressao_anterior": (anterior or {}).get("impressao_normativa"),
                "impressao_atual": registro["impressao_normativa"],
                "sha256_anterior": (anterior or {}).get("sha256_documento", ""),
                "sha256_atual": registro["sha256_documento"],
                "classe_de_evidencia": registro["classe_de_evidencia"],
                "colisao_de_impressao": registro["colisao_de_impressao"],
                **julgamento,
            })
        resumo["tipo"] = "resumo_reconferencia"
        resumo["vereditos"] = dict(contagem)
        saida = Path(args.saida) if args.saida else (
            ROOT / ("data/ops/official_source_normative_fingerprint_recheck_%s.jsonl"
                    % datetime.date.today().strftime("%Y%m%d")))
        linhas = [esquema_do_registro()] + vereditos + [resumo]
        print("\n=== vereditos ===")
        for nome, quantas in contagem.most_common():
            print("  %6d  %s" % (quantas, nome))

    carga = "".join(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n"
                    for linha in linhas)
    escrita_atomica(saida, carga.encode("utf-8"))

    print("\n=== classes de evidência ===")
    for nome, quantas in sorted(resumo["classes_de_evidencia"].items()):
        print("  %6d  %s" % (quantas, nome))
    if resumo["motivos_sem_impressao"]:
        print("=== sem impressão (fail-closed) ===")
        for nome, quantas in sorted(resumo["motivos_sem_impressao"].items()):
            print("  %6d  %s" % (quantas, nome))
    if grupos:
        print("=== colisões (nunca concluem 'inalterado') ===")
        for impressao, grupo in sorted(grupos.items()):
            print("  %s  %s  %d URLs" % (impressao[:12], grupo["tipo"], len(grupo["urls"])))
            for url in grupo["urls"]:
                print("        %s" % url)
    print("\n%d registro(s) em %s (%.0f s)"
          % (len(linhas), os.path.relpath(saida, ROOT), time.time() - inicio))
    return 0


if __name__ == "__main__":
    sys.exit(main())
