#!/usr/bin/env python3
"""generate-previsao-audiencia — previsão de audiência a 30, 90 e 180 dias, com
intervalo, e ranking de áreas por valor esperado (frente F6, 2026-09-09).

O QUE RESPONDE. "Se a tendência dos últimos 60 dias continuar, quantas
requisições orgânicas, visitantes únicos, leituras de bot de IA, impressões e
cliques no Bing o portal terá daqui a 30, 90 e 180 dias — e com que
incerteza?" E: "em qual área do acervo os bots de IA valiosos leem mais, por
página publicada?" É o insumo da fila de extração e da escolha de temas do
cérebro (plano de 2026-09-09, F6 → B7/C7).

MODELO, por série diária:   log(y + 1) = a + b·t + Σ dummies(dia da semana)
  - mínimos quadrados (numpy.linalg.lstsq); graus de liberdade = n − posto(X);
  - intervalo de PREVISÃO a 80 % e 95 % pela distribuição t (scipy.stats.t)
    sobre o resíduo, com a alavancagem do ponto projetado;
  - crescimento reportado como taxa SEMANAL, (e^(7b) − 1)·100, com IC pelo
    erro-padrão de b;
  - ponto = e^ŷ − 1: é a MEDIANA condicional, não a média (a volta do log
    subestima a média quando a variância é grande);
  - previsao[h] = valor diário esperado em (último dia ajustado + h dias), com
    o dummy daquele dia da semana; `acumulado` = Σ dos pontos diários de 1..h;
  - r2 é o R² no espaço do log.

REGRAS DE DADO — copiadas dos leitores canônicos, nunca reinterpretadas:
  - borda: data/ops/edge_traffic_daily.jsonl, última linha por `date`; dia
    provisório pela MESMA regra de tools/generate-painel (data ≥ hoje, nota
    "dia em curso" ou `organic_requests_basis` começando por `provisional`)
    fica FORA do ajuste — inclusive quando não é o último dia;
  - bots: data/ops/edge_bot_agents_daily.jsonl SÓ via
    tools/edgetelemetry.serie_saneada (última linha por (date, agent_key),
    linha fisicamente impossível descartada); valor pelo `requests_sampled`
    com a mesma escolha de campo do painel; provisório = dia posterior ao
    último dia completo da borda (o ledger é cumulativo intradiário);
  - Bing: data/ops/bing_webmaster_daily.jsonl, última linha por `Date`;
    impressions/clicks de `busca_diaria`; rastreio (CrawledPages) e indexadas
    (InIndex) de `rastreio_diario`;
  - dia ausente é ausente, nunca zero; < 21 dias com dado = `sem_serie_suficiente`;
    ≥ 50 % de zeros = `serie_esparsa` (relata, não projeta);
  - áreas: ledger de origem data/ops/access/nginx-AAAA-MM-DD.jsonl, 14 dias
    completos, só os 9 agentes valiosos, `route_class` ∈ {page, markdown},
    `status` ∈ {200, 304}, sem `bot_simulation` e sem `warming`; área =
    primeiro segmento do path, `/redesocial/tema/<área>/` → a área do tema;
    páginas publicadas contadas em content/pages.json por primeiro segmento
    (status == published). Valor esperado = leituras × (1 + taxa semanal da
    série `bots.total`, quando ela tem ajuste).

SAÍDA. Sem `--gravar` só imprime (`--dry-run` idem, explícito). Com `--gravar`:
  data/ops/previsao_daily.jsonl   uma linha por execução; linha idêntica à
                                  última (fora `gerado_em`) não se regrava
  data/ops/painel/previsao.json   o mesmo objeto, sobrescrito; o painel o lê
Exit 0 gerou (mesmo que toda série fique sem_serie_suficiente); exit 2 é
instrumento quebrado: edgetelemetry ausente, raiz ilegível, gravação falhou.

Uso:
  tools/generate-previsao-audiencia [--dias 60] [--dry-run | --gravar]
                                    [--raiz /opt/wiki] [--hoje AAAA-MM-DD]
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import sys
import time

import numpy as np
from scipy import stats

RAIZ_PADRAO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMA = "previsao_v1"
JANELA_PADRAO = 60
MINIMO_DIAS = 21
FRACAO_ZEROS_ESPARSA = 0.5
HORIZONTES = (30, 90, 180)
JANELA_AREAS_DIAS = 14
# Os agentes de IA cuja leitura vale: citação, busca por IA e agente disparado
# por usuário, mais os dois buscadores que alimentam assistentes (Bing, Google).
AGENTES_VALIOSOS = ("perplexitybot", "oai-searchbot", "chatgpt-user", "bingbot", "amazonbot",
                    "googlebot", "claudebot", "claude-user", "perplexity-user")
ROUTE_CLASSES_LEITURA = ("page", "markdown")
STATUS_LEITURA = (200, 304)
SERIE_FATOR_AREAS = "bots.total"
FONTES = {
    "edge_traffic": "data/ops/edge_traffic_daily.jsonl",
    "edge_bots": "data/ops/edge_bot_agents_daily.jsonl",
    "bing": "data/ops/bing_webmaster_daily.jsonl",
    "acesso_nginx": "data/ops/access/nginx-AAAA-MM-DD.jsonl",
    "pages": "content/pages.json",
}
SAIDA_JSONL = "data/ops/previsao_daily.jsonl"
SAIDA_JSON = "data/ops/painel/previsao.json"
MODELO = "log(y+1) = a + b·t + Σ dummies(dia da semana); MQO; IC por t com df = n − posto(X)"
VOLATEIS = frozenset({"gerado_em"})
# Acima disto e^x estoura o float64; a projeção vira None com `estouro: true`
# em vez de um Infinity que o JSON não representa.
EXPOENTE_MAXIMO = 700.0
# Bloco de leitura de content/pages.json (caracteres); cada página tem ~8 KB.
TAMANHO_BLOCO = 1 << 22


class InstrumentoQuebrado(Exception):
    """Fonte ou dependência que a ferramenta não pode substituir: exit 2."""


# ---------------------------------------------------------------------------
# leitura
# ---------------------------------------------------------------------------

def le_jsonl(caminho):
    registros = []
    if not os.path.isfile(caminho):
        return registros, False
    with open(caminho, encoding="utf-8") as handle:
        for bruto in handle:
            bruto = bruto.strip()
            if not bruto:
                continue
            try:
                registro = json.loads(bruto)
            except json.JSONDecodeError:
                continue
            if isinstance(registro, dict):
                registros.append(registro)
    return registros, True


def ultima_por_chave(registros, chave):
    """Convenção dos ledgers append-only: a ÚLTIMA linha de uma chave vence."""
    saida = {}
    for r in registros:
        k = chave(r)
        if k is None:
            continue
        saida[k] = r
    return saida


def numero(v):
    """Número ou None — string numérica do Bing vira número; lixo vira None."""
    if v is None or isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return v
    if isinstance(v, str):
        s = v.strip()
        if not s or s.lower() == "none":
            return None
        try:
            return int(s)
        except ValueError:
            try:
                return float(s)
            except ValueError:
                return None
    return None


def provisorio_borda(r: dict, data: str, hoje_iso: str) -> bool:
    """A regra do painel (tools/generate-painel::_provisorio), byte a byte."""
    if data >= hoje_iso:
        return True
    nota = str(r.get("self_warming_note") or "")
    base = str(r.get("organic_requests_basis") or "")
    return "dia em curso" in nota or base.startswith("provisional")


def borda_valor(r: dict):
    """Mesma escolha de campo do painel e de tools/generate-cache-baseline: o
    count (`requests_sampled`) é a contagem; a faixa de IP entra quando a
    Cloudflare não verifica o agente; `requests_estimated` só nas linhas antigas."""
    total = numero(r.get("requests_sampled"))
    faixa = numero(r.get("requests_sampled_ip_range")) or 0
    if total is not None and total > 0:
        return total
    if faixa > 0:
        return faixa
    if total is not None:
        return 0
    est = numero(r.get("requests_estimated"))
    est_ip = numero(r.get("requests_estimated_ip_range")) or 0
    if est is not None and est > 0:
        return est
    if est_ip > 0:
        return est_ip
    if est is not None:
        return 0
    return None


def series_borda(raiz: str, datas: list, hoje_iso: str):
    """organic_requests e uniques por dia, e o último dia completo da borda."""
    registros, existe = le_jsonl(os.path.join(raiz, FONTES["edge_traffic"]))
    por_dia = ultima_por_chave(registros, lambda r: r.get("date"))
    organic, uniques, provisorios, completos = {}, {}, set(), []
    for d in datas:
        r = por_dia.get(d)
        if r is None:
            continue
        if provisorio_borda(r, d, hoje_iso):
            provisorios.add(d)
        else:
            completos.append(d)
        organic[d] = numero(r.get("organic_requests"))
        uniques[d] = numero(r.get("uniques"))
    return {"borda.organic_requests": organic, "borda.uniques": uniques}, provisorios, \
        (max(completos) if completos else None), existe


def carrega_edgetelemetry():
    tools_dir = os.path.join(RAIZ_PADRAO, "tools")
    if tools_dir not in sys.path:
        sys.path.insert(0, tools_dir)
    try:
        import edgetelemetry  # noqa: E402
    except ImportError as erro:
        raise InstrumentoQuebrado("tools/edgetelemetry indisponível (%s): a série da borda só se lê saneada" % erro)
    return edgetelemetry


def series_bots(raiz: str, datas: list):
    """bots.total (Σ de todos os agentes do dia), bots.valiosos (Σ dos 9) e uma
    série por agente valioso — tudo pela série saneada, nunca pelo JSONL cru."""
    edgetelemetry = carrega_edgetelemetry()
    por_chave, descartadas = edgetelemetry.serie_saneada(raiz)
    janela = set(datas)
    total: dict = {}
    valiosos: dict = {}
    por_agente = {a: {} for a in AGENTES_VALIOSOS}
    for (d, agente), r in por_chave.items():
        if d not in janela or not agente:
            continue
        valor = borda_valor(r)
        if valor is None:
            continue
        total[d] = total.get(d, 0) + valor
        if agente in AGENTES_VALIOSOS:
            valiosos[d] = valiosos.get(d, 0) + valor
            por_agente[agente][d] = valor
    series = {"bots.total": total, "bots.valiosos": valiosos}
    for a in AGENTES_VALIOSOS:
        series["bots." + a] = por_agente[a]
    return series, len(descartadas)


def series_bing(raiz: str, datas: list):
    registros, existe = le_jsonl(os.path.join(raiz, FONTES["bing"]))
    busca = ultima_por_chave([r for r in registros if r.get("tipo") == "busca_diaria"], lambda r: r.get("Date"))
    rastreio = ultima_por_chave([r for r in registros if r.get("tipo") == "rastreio_diario"], lambda r: r.get("Date"))
    series = {"bing.impressions": {}, "bing.clicks": {}, "bing.rastreio": {}, "bing.indexadas": {}}
    for d in datas:
        r = busca.get(d)
        if r is not None:
            series["bing.impressions"][d] = numero(r.get("Impressions"))
            series["bing.clicks"][d] = numero(r.get("Clicks"))
        r = rastreio.get(d)
        if r is not None:
            series["bing.rastreio"][d] = numero(r.get("CrawledPages"))
            series["bing.indexadas"][d] = numero(r.get("InIndex"))
    return series, existe


# ---------------------------------------------------------------------------
# modelo
# ---------------------------------------------------------------------------

def linha_x(t: int, data: dt.date) -> list:
    """[1, t, seg..dom como dummies] — segunda-feira é a base."""
    return [1.0, float(t)] + [1.0 if data.weekday() == k else 0.0 for k in range(1, 7)]


def arred(v, casas=1):
    if v is None:
        return None
    return round(float(v), casas)


def _expm1_seguro(x: float):
    if x > EXPOENTE_MAXIMO:
        return None
    return max(math.expm1(x), 0.0)


def ajusta(pontos: dict, provisorios: set, datas: list, teto=None) -> dict:
    """Ajusta uma série diária e projeta os horizontes. Nunca inventa: série
    curta ou esparsa volta com `motivo` e sem `previsao`."""
    inicio = datas[0]
    fim = datas[-1]
    d0 = dt.date.fromisoformat(inicio)
    usados = [(d, v) for d, v in sorted(pontos.items())
              if v is not None and inicio <= d <= fim and d not in provisorios]
    excluidos = sorted(d for d, v in pontos.items() if v is not None and d in provisorios)
    n = len(usados)
    zeros = sum(1 for _d, v in usados if v == 0)
    saida = {
        "n": n,
        "dias_janela": len(datas),
        "dias_provisorios_excluidos": excluidos,
        "primeiro_dia": usados[0][0] if usados else None,
        "ultimo_dia": usados[-1][0] if usados else None,
        "ultimo_valor": usados[-1][1] if usados else None,
        "media_ultimos_7": arred(sum(v for _d, v in usados[-7:]) / len(usados[-7:]), 1) if usados else None,
        "zeros": zeros,
        "taxa_semanal_pct": None, "ic80": None, "ic95": None, "r2": None,
        "sigma_log": None, "graus_de_liberdade": None,
        "previsao": None,
        "motivo": None, "detalhe": None,
    }
    if teto is not None:
        saida["teto_fisico"] = teto
    if n < MINIMO_DIAS:
        saida["motivo"] = "sem_serie_suficiente"
        saida["detalhe"] = ("%d dia(s) com dado na janela %s → %s (provisórios excluídos: %d); mínimo %d"
                            % (n, inicio, fim, len(excluidos), MINIMO_DIAS))
        return saida
    if zeros / n >= FRACAO_ZEROS_ESPARSA:
        saida["motivo"] = "serie_esparsa"
        saida["detalhe"] = "%d de %d dia(s) com valor zero (≥ %d %%): a série se relata, não se projeta" % (
            zeros, n, int(FRACAO_ZEROS_ESPARSA * 100))
        return saida

    X = np.array([linha_x((dt.date.fromisoformat(d) - d0).days, dt.date.fromisoformat(d)) for d, _v in usados])
    y = np.log1p(np.array([float(v) for _d, v in usados]))
    beta, _residuo, posto, _sv = np.linalg.lstsq(X, y, rcond=None)
    df = n - int(posto)
    if df < 1:
        saida["motivo"] = "sem_serie_suficiente"
        saida["detalhe"] = "n = %d e posto(X) = %d: sem grau de liberdade para o resíduo" % (n, int(posto))
        return saida
    ajustado = X @ beta
    residuo = y - ajustado
    ssr = float(residuo @ residuo)
    sst = float(((y - y.mean()) ** 2).sum())
    s2 = ssr / df
    xtx_inv = np.linalg.pinv(X.T @ X)
    b = float(beta[1])
    se_b = math.sqrt(max(s2 * float(xtx_inv[1, 1]), 0.0))
    t80 = float(stats.t.ppf(0.90, df))
    t95 = float(stats.t.ppf(0.975, df))

    def taxa(bb):
        return (math.exp(7.0 * bb) - 1.0) * 100.0

    saida["taxa_semanal_pct"] = arred(taxa(b), 2)
    saida["ic80"] = [arred(taxa(b - t80 * se_b), 2), arred(taxa(b + t80 * se_b), 2)]
    saida["ic95"] = [arred(taxa(b - t95 * se_b), 2), arred(taxa(b + t95 * se_b), 2)]
    saida["r2"] = arred(1.0 - ssr / sst, 4) if sst > 0 else None
    saida["sigma_log"] = arred(math.sqrt(s2), 4)
    saida["graus_de_liberdade"] = df

    ultimo = dt.date.fromisoformat(usados[-1][0])
    previsao = {}
    acumulado = 0.0
    for h in range(1, max(HORIZONTES) + 1):
        data = ultimo + dt.timedelta(days=h)
        x0 = np.array(linha_x((data - d0).days, data))
        yhat = float(x0 @ beta)
        ponto = _expm1_seguro(yhat)
        acumulado += ponto if ponto is not None else 0.0
        if h not in HORIZONTES:
            continue
        se_pred = math.sqrt(max(s2 * (1.0 + float(x0 @ xtx_inv @ x0)), 0.0))
        item = {
            "data": data.isoformat(),
            "ponto": arred(ponto, 1),
            "ic80": [arred(_expm1_seguro(yhat - t80 * se_pred), 1), arred(_expm1_seguro(yhat + t80 * se_pred), 1)],
            "ic95": [arred(_expm1_seguro(yhat - t95 * se_pred), 1), arred(_expm1_seguro(yhat + t95 * se_pred), 1)],
            "acumulado": arred(acumulado, 1),
        }
        if ponto is None or item["ic95"][1] is None:
            item["estouro"] = True
        if teto is not None and ponto is not None:
            item["acima_do_teto"] = ponto > teto
        previsao[str(h)] = item
    saida["previsao"] = previsao
    return saida


