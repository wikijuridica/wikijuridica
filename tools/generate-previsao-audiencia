def calcula(raiz: str, hoje: dt.date, dias: int, agora: str | None = None) -> dict:
    if not os.path.isdir(raiz):
        raise InstrumentoQuebrado("raiz inexistente: %s" % raiz)
    hoje_iso = hoje.isoformat()
    datas = [(hoje - dt.timedelta(days=i)).isoformat() for i in range(dias - 1, -1, -1)]
    ressalvas = [
        MODELO + ". Ponto = e^ŷ − 1 (mediana condicional, não média); ic80/ic95 são intervalos de PREVISÃO "
        "para o valor diário na data-alvo; `acumulado` soma os pontos diários até o horizonte, sem intervalo.",
        "Dia ausente no ledger é ausente, nunca zero. Série com menos de %d dias com dado na janela fica "
        "`sem_serie_suficiente`; com %d %% ou mais de zeros fica `serie_esparsa` — nos dois casos não há projeção."
        % (MINIMO_DIAS, int(FRACAO_ZEROS_ESPARSA * 100)),
        "Extrapolar 180 dias a partir de %d dias de ajuste é tendência, não destino: leia o intervalo, "
        "e leia `r2` (no espaço do log) antes do ponto." % dias,
    ]
    borda, prov_borda, ultimo_completo, borda_existe = series_borda(raiz, datas, hoje_iso)
    if ultimo_completo is None:
        ultimo_completo = (hoje - dt.timedelta(days=1)).isoformat()
        ressalvas.append("edge_traffic_daily sem dia completo na janela: último dia completo assumido como hoje − 1.")
    ressalvas.append(
        "borda.organic_requests = requests − self_warming_requests do ledger de aquecimento (edge_traffic_daily, "
        "última linha por date). Dia marcado provisório pelo produtor (basis `provisional_…` ou nota "
        "\"dia em curso\") fica fora do ajuste mesmo quando não é o último — a regra é a do painel.")
    bots, bots_descartadas = series_bots(raiz, datas)
    prov_bots = {d for d in datas if d > ultimo_completo}
    ressalvas.append(
        "bots.* = `requests_sampled` de edge_bot_agents_daily via tools/edgetelemetry.serie_saneada "
        "(%d linha(s) descartada(s)); bots.total soma TODOS os agentes do dia (inclui SEO, scanner e social), "
        "bots.valiosos soma só %s. Dia posterior ao último completo (%s) é provisório: o ledger é cumulativo."
        % (bots_descartadas, ", ".join(AGENTES_VALIOSOS), ultimo_completo))
    bing, bing_existe = series_bing(raiz, datas)
    ressalvas.append(
        "bing.impressions/clicks = busca_diaria; bing.rastreio = CrawledPages e bing.indexadas = InIndex de "
        "rastreio_diario (última coleta por Date vence). O Bing recomputa dias recentes: o último Date pode "
        "subir na coleta seguinte. InIndex é ESTOQUE com teto físico = páginas publicadas; a projeção acima do "
        "teto vem marcada `acima_do_teto`.")

    teto_indexadas = None
    caminho_pages = os.path.join(raiz, FONTES["pages"])
    if os.path.isfile(caminho_pages):
        try:
            teto_indexadas = sum(paginas_por_area(caminho_pages).values())
        except (OSError, ValueError):
            teto_indexadas = None

    series = {}
    for nome, pontos in borda.items():
        series[nome] = ajusta(pontos, prov_borda, datas)
    for nome, pontos in bots.items():
        series[nome] = ajusta(pontos, prov_bots, datas)
    for nome, pontos in bing.items():
        series[nome] = ajusta(pontos, prov_bots, datas, teto=teto_indexadas if nome == "bing.indexadas" else None)

    taxa_total = series[SERIE_FATOR_AREAS]["taxa_semanal_pct"]
    areas, areas_meta = ranking_areas(raiz, ultimo_completo, taxa_total, ressalvas)
    ressalvas.append(
        "Áreas: leituras dos %d agentes valiosos no ledger de ORIGEM (nginx) em %d dias completos, só "
        "route_class ∈ {%s} com status ∈ {%s}; a origem vê o que atravessou o cache da borda, então é piso, "
        "não total. valor_esperado = leituras × (1 + taxa semanal de %s); sem taxa, o fator é 1."
        % (len(AGENTES_VALIOSOS), JANELA_AREAS_DIAS, ", ".join(ROUTE_CLASSES_LEITURA),
           ", ".join(str(s) for s in STATUS_LEITURA), SERIE_FATOR_AREAS))
    if not borda_existe:
        ressalvas.append("edge_traffic_daily.jsonl ausente: borda.* sem série.")
    if not bing_existe:
        ressalvas.append("bing_webmaster_daily.jsonl ausente: bing.* sem série.")

    return {
        "schema_version": SCHEMA,
        "date": hoje_iso,
        "gerado_em": agora or dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "janela_dias": dias,
        "janela": {"inicio": datas[0], "fim": datas[-1]},
        "ultimo_dia_completo": ultimo_completo,
        "modelo": MODELO,
        "horizontes": list(HORIZONTES),
        "minimo_dias": MINIMO_DIAS,
        "series": series,
        "areas": areas,
        "areas_meta": areas_meta,
        "fontes": dict(FONTES),
        "ressalvas": ressalvas,
    }


