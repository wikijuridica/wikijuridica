def area_de(path) -> str:
    segs = [s for s in str(path or "").split("/") if s]
    if not segs:
        return "(raiz)"
    if segs[0] == "redesocial" and len(segs) >= 3 and segs[1] == "tema":
        return segs[2]
    return segs[0]


def paginas_por_area(caminho: str, tamanho_bloco: int | None = None) -> dict:
    """Páginas com status == published em content/pages.json, por primeiro
    segmento do path. Percorre a lista objeto a objeto (raw_decode sobre um
    buffer de `TAMANHO_BLOCO` caracteres) para não materializar os 83 MB do
    acervo em memória: medido em 2026-09-09, a leitura inteira custava 347 MB
    de RSS; por blocos, o pico fica no bloco mais o objeto em curso."""
    bloco = tamanho_bloco or TAMANHO_BLOCO
    contagem: dict = {}
    decodificador = json.JSONDecoder()
    with open(caminho, encoding="utf-8") as handle:
        buffer = handle.read(bloco)
        i = 0
        while i < len(buffer) and buffer[i] in " \t\r\n":
            i += 1
        if i >= len(buffer) or buffer[i] != "[":
            raise ValueError("%s: esperava uma lista JSON de páginas" % caminho)
        i += 1
        while True:
            # separadores; ao esvaziar o buffer, lê o bloco seguinte
            while True:
                while i < len(buffer) and buffer[i] in " \t\r\n,":
                    i += 1
                if i < len(buffer):
                    break
                proximo = handle.read(bloco)
                if not proximo:
                    raise ValueError("%s: lista sem fechamento" % caminho)
                buffer, i = buffer[i:] + proximo, 0
            if buffer[i] == "]":
                break
            # objeto: se o buffer acabou no meio dele, estende e tenta de novo
            while True:
                try:
                    pagina, j = decodificador.raw_decode(buffer, i)
                    break
                except json.JSONDecodeError:
                    proximo = handle.read(bloco)
                    if not proximo:
                        raise ValueError("%s: JSON truncado" % caminho)
                    buffer, i = buffer[i:] + proximo, 0
            i = j
            if not isinstance(pagina, dict) or pagina.get("status") != "published":
                continue
            area = area_de(pagina.get("path"))
            contagem[area] = contagem.get(area, 0) + 1
    return contagem


def leituras_por_area(raiz: str, inicio: dt.date, fim: dt.date, acervo: dict):
    """Leituras de bots valiosos no ledger de origem, por área e agente."""
    por_area: dict = {}
    fora: dict = {}
    dias_com_ledger, dias_sem_ledger = [], []
    linhas_lidas = descartadas = 0
    d = inicio
    while d <= fim:
        iso = d.isoformat()
        caminho = os.path.join(raiz, "data", "ops", "access", "nginx-%s.jsonl" % iso)
        if not os.path.isfile(caminho):
            dias_sem_ledger.append(iso)
            d += dt.timedelta(days=1)
            continue
        dias_com_ledger.append(iso)
        with open(caminho, encoding="utf-8") as handle:
            for bruto in handle:
                bruto = bruto.strip()
                if not bruto:
                    continue
                try:
                    r = json.loads(bruto)
                except json.JSONDecodeError:
                    continue
                linhas_lidas += 1
                if r.get("bot_simulation") or r.get("warming"):
                    descartadas += 1
                    continue
                agente = r.get("agent_key")
                if agente not in AGENTES_VALIOSOS:
                    continue
                if r.get("route_class") not in ROUTE_CLASSES_LEITURA or numero(r.get("status")) not in STATUS_LEITURA:
                    continue
                ts = str(r.get("ts") or "")[:10]
                if ts and ts != iso:
                    continue
                area = area_de(r.get("path"))
                if area in acervo:
                    e = por_area.setdefault(area, {})
                    e[agente] = e.get(agente, 0) + 1
                else:
                    fora[area] = fora.get(area, 0) + 1
        d += dt.timedelta(days=1)
    return por_area, fora, dias_com_ledger, dias_sem_ledger, linhas_lidas, descartadas


def ranking_areas(raiz: str, ultimo_dia_completo: str, taxa_total_pct, ressalvas: list) -> tuple:
    fim = dt.date.fromisoformat(ultimo_dia_completo)
    inicio = fim - dt.timedelta(days=JANELA_AREAS_DIAS - 1)
    caminho_pages = os.path.join(raiz, FONTES["pages"])
    meta = {
        "janela": {"inicio": inicio.isoformat(), "fim": fim.isoformat(), "dias": JANELA_AREAS_DIAS},
        "criterio": {
            "agentes": list(AGENTES_VALIOSOS), "route_class": list(ROUTE_CLASSES_LEITURA),
            "status": list(STATUS_LEITURA), "exclui": ["bot_simulation", "warming"],
            "area": "primeiro segmento do path; /redesocial/tema/<área>/ → área do tema",
            "paginas_publicadas": "content/pages.json, status == published, por primeiro segmento",
        },
        "fator_serie": SERIE_FATOR_AREAS,
        "fator_taxa_semanal_pct": taxa_total_pct,
        "fator": None if taxa_total_pct is None else round(1.0 + taxa_total_pct / 100.0, 4),
    }
    if not os.path.isfile(caminho_pages):
        meta["motivo"] = "content/pages.json ausente: sem áreas do acervo para ranquear"
        ressalvas.append("Ranking de áreas: " + meta["motivo"])
        return [], meta
    try:
        acervo = paginas_por_area(caminho_pages)
    except (OSError, ValueError) as erro:
        meta["motivo"] = "content/pages.json ilegível (%s)" % erro
        ressalvas.append("Ranking de áreas: " + meta["motivo"])
        return [], meta
    por_area, fora, com, sem, lidas, desc = leituras_por_area(raiz, inicio, fim, acervo)
    meta.update({
        "dias_com_ledger": com, "dias_sem_ledger": sem, "linhas_lidas": lidas,
        "linhas_descartadas_proprias": desc,
        "fora_do_acervo": dict(sorted(fora.items(), key=lambda kv: (-kv[1], kv[0]))[:20]),
        "fora_do_acervo_total": sum(fora.values()),
        "leituras_total": sum(sum(e.values()) for e in por_area.values()),
        "areas_do_acervo": len(acervo),
        "paginas_publicadas_total": sum(acervo.values()),
    })
    fator = meta["fator"]
    itens = []
    for area, paginas in acervo.items():
        por_agente = por_area.get(area, {})
        leituras = sum(por_agente.values())
        valor = leituras * (fator if fator is not None else 1.0)
        itens.append({
            "area": area,
            "paginas_publicadas": paginas,
            "leituras_14d": leituras,
            "por_agente": dict(sorted(por_agente.items(), key=lambda kv: (-kv[1], kv[0]))),
            "leituras_por_pagina": round(leituras / paginas, 4) if paginas else None,
            "valor_esperado": round(valor, 2),
        })
    itens.sort(key=lambda i: (-i["valor_esperado"], -i["leituras_14d"], i["area"]))
    for posicao, item in enumerate(itens, start=1):
        item["posicao"] = posicao
    if sem:
        ressalvas.append("Ranking de áreas: %d dia(s) da janela sem ledger de origem (%s) — as leituras são piso."
                         % (len(sem), ", ".join(sem)))
    return itens, meta


