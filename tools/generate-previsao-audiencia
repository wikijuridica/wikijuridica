def _sem_volateis(obj):
    if isinstance(obj, dict):
        return {k: _sem_volateis(v) for k, v in obj.items() if k not in VOLATEIS}
    if isinstance(obj, list):
        return [_sem_volateis(v) for v in obj]
    return obj


def grava_atomico(caminho: str, texto: str) -> None:
    os.makedirs(os.path.dirname(caminho) or ".", exist_ok=True)
    tmp = caminho + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(texto)
    os.replace(tmp, caminho)


def ultima_linha(caminho: str):
    if not os.path.isfile(caminho):
        return None
    ultima = None
    with open(caminho, encoding="utf-8") as handle:
        for bruto in handle:
            if bruto.strip():
                ultima = bruto
    if ultima is None:
        return None
    try:
        return json.loads(ultima)
    except json.JSONDecodeError:
        return None


def grava(raiz: str, objeto: dict) -> dict:
    jsonl = os.path.join(raiz, SAIDA_JSONL)
    caminho_json = os.path.join(raiz, SAIDA_JSON)
    anterior = ultima_linha(jsonl)
    jsonl_gravado = False
    if anterior is None or _sem_volateis(anterior) != _sem_volateis(objeto):
        os.makedirs(os.path.dirname(jsonl), exist_ok=True)
        with open(jsonl, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(objeto, ensure_ascii=False, sort_keys=False) + "\n")
        jsonl_gravado = True
    json_gravado = False
    antigo = None
    if os.path.isfile(caminho_json):
        try:
            with open(caminho_json, encoding="utf-8") as handle:
                antigo = json.load(handle)
        except (OSError, ValueError):
            antigo = None
    if antigo is None or _sem_volateis(antigo) != _sem_volateis(objeto):
        grava_atomico(caminho_json, json.dumps(objeto, ensure_ascii=False, indent=1) + "\n")
        json_gravado = True
    return {"jsonl": jsonl, "jsonl_gravado": jsonl_gravado, "json": caminho_json, "json_gravado": json_gravado}


def _fmt(v):
    if v is None:
        return "—"
    if isinstance(v, (int, float)) and not isinstance(v, bool) and abs(v) >= 1e7:
        return "%.2e" % v
    if isinstance(v, float):
        return ("%.1f" % v) if abs(v) < 1000 else ("%.0f" % v)
    return str(v)


def _ic(par):
    if not par:
        return "—"
    return "[%s; %s]" % (_fmt(par[0]), _fmt(par[1]))


def imprime_resumo(objeto: dict, saida=None) -> None:
    # `saida` resolvida na CHAMADA, não na definição: com sys.stdout como default
    # o redirecionamento de stdout (testes, journal em pipe) não a alcançaria.
    if saida is None:
        saida = sys.stdout
    p = lambda s="": print(s, file=saida)  # noqa: E731
    p("previsão de audiência — %s (janela %s → %s, %d dias; último dia completo %s)"
      % (objeto["date"], objeto["janela"]["inicio"], objeto["janela"]["fim"], objeto["janela_dias"],
         objeto["ultimo_dia_completo"]))
    p("%-24s %4s %-10s %11s %10s %-18s %-18s %-14s %-14s %-14s %s"
      % ("série", "n", "último dia", "último", "taxa/sem %", "ic80 taxa", "ic95 taxa", "30 d", "90 d", "180 d", "motivo / r2"))
    for nome, s in objeto["series"].items():
        prev = s.get("previsao") or {}
        cols = [_fmt((prev.get(str(h)) or {}).get("ponto")) for h in HORIZONTES]
        p("%-24s %4d %-10s %11s %10s %-18s %-18s %-14s %-14s %-14s %s"
          % (nome, s["n"], s.get("ultimo_dia") or "—", _fmt(s.get("ultimo_valor")), _fmt(s.get("taxa_semanal_pct")),
             _ic(s.get("ic80")), _ic(s.get("ic95")), cols[0], cols[1], cols[2],
             s["motivo"] + " — " + str(s.get("detalhe")) if s.get("motivo") else "r2=%s" % _fmt(s.get("r2"))))
    meta = objeto["areas_meta"]
    p()
    p("áreas por valor esperado — leituras de bots valiosos na origem, %s → %s, fator %s (%s: %s %%/semana)"
      % (meta["janela"]["inicio"], meta["janela"]["fim"], _fmt(meta.get("fator")), meta["fator_serie"],
         _fmt(meta.get("fator_taxa_semanal_pct"))))
    if meta.get("motivo"):
        p("  " + meta["motivo"])
    p("%3s %-20s %8s %10s %10s %12s  %s" % ("#", "área", "páginas", "leituras", "por pág.", "esperado", "por agente"))
    for item in objeto["areas"][:10]:
        p("%3d %-20s %8d %10d %10s %12s  %s"
          % (item["posicao"], item["area"], item["paginas_publicadas"], item["leituras_14d"],
             _fmt(item["leituras_por_pagina"]), _fmt(item["valor_esperado"]),
             ", ".join("%s=%d" % kv for kv in list(item["por_agente"].items())[:4])))
    if meta.get("dias_sem_ledger"):
        p("  dias sem ledger de origem: %s" % ", ".join(meta["dias_sem_ledger"]))


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("--dias", type=int, default=JANELA_PADRAO,
                        help="janela de ajuste em dias, terminando hoje (padrão %d)" % JANELA_PADRAO)
    modo = parser.add_mutually_exclusive_group()
    modo.add_argument("--dry-run", action="store_true", help="imprime e não grava (é o comportamento padrão)")
    modo.add_argument("--gravar", action="store_true",
                      help="acrescenta a linha em %s e reescreve %s" % (SAIDA_JSONL, SAIDA_JSON))
    parser.add_argument("--raiz", default=RAIZ_PADRAO, help="raiz do repositório")
    parser.add_argument("--hoje", default=None, help="data de referência AAAA-MM-DD (padrão: hoje em UTC)")
    parser.add_argument("--json", action="store_true", help="imprime o objeto completo em JSON além do resumo")
    args = parser.parse_args(argv)
    if args.dias < 1:
        parser.error("--dias precisa ser >= 1")
    try:
        hoje = dt.date.fromisoformat(args.hoje) if args.hoje else dt.datetime.now(dt.timezone.utc).date()
    except ValueError:
        parser.error("--hoje precisa ser AAAA-MM-DD")
    raiz = os.path.abspath(args.raiz)
    inicio = time.monotonic()
    try:
        objeto = calcula(raiz, hoje, args.dias)
    except InstrumentoQuebrado as erro:
        print("generate-previsao-audiencia: %s" % erro, file=sys.stderr)
        return 2
    imprime_resumo(objeto)
    if args.json:
        print(json.dumps(objeto, ensure_ascii=False, indent=1))
    if not args.gravar:
        print("(sem --gravar: nada foi escrito; %.2f s)" % (time.monotonic() - inicio))
        return 0
    try:
        resultado = grava(raiz, objeto)
    except OSError as erro:
        print("generate-previsao-audiencia: falha ao gravar: %s" % erro, file=sys.stderr)
        return 2
    print("gravado: %s (%s) · %s (%s) · %.2f s"
          % (resultado["jsonl"], "linha nova" if resultado["jsonl_gravado"] else "linha idêntica à última, não regravada",
             resultado["json"], "reescrito" if resultado["json_gravado"] else "inalterado",
             time.monotonic() - inicio))
    return 0


if __name__ == "__main__":
    sys.exit(main())
