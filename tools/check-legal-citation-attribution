def autoteste() -> int:
    falhas = 0
    for caso in CASOS_FALSO_POSITIVO:
        acusacoes = avalia_pagina(caso["pagina"])
        if acusacoes:
            falhas += 1
            print(f"FALSO POSITIVO em '{caso['nome']}': {acusacoes}")
        else:
            print(f"ok  (limpo)   {caso['nome']}")
    for caso in CASOS_VERDADEIRO_POSITIVO:
        regras = {a["regra"] for a in avalia_pagina(caso["pagina"])}
        if caso["regra"] not in regras:
            falhas += 1
            print(f"FALSO NEGATIVO em '{caso['nome']}': esperava {caso['regra']}, veio {regras}")
        else:
            print(f"ok  (acusado) {caso['nome']}")
    if falhas:
        print(f"\nAUTOTESTE REPROVADO: {falhas} caso(s)")
        return 1
    print("\nAUTOTESTE APROVADO")
    return 0


