def sem_acento(texto: str) -> str:
    normalizado = unicodedata.normalize("NFD", texto)
    return "".join(c for c in normalizado if unicodedata.category(c) != "Mn")


def normaliza(texto: str) -> str:
    """minusculas, sem acento, espacos colapsados — para casar apelido."""
    return re.sub(r"\s+", " ", sem_acento(texto).lower())


def so_digitos(numero: str) -> str:
    return numero.replace(".", "").lstrip("0") or "0"


def corpo_da_pagina(pagina: dict) -> str:
    """Concatena o texto VISIVEL. A chave 'text' nao existe: o corpo mora em
    body_sections[].title/body e faq[] — armadilha catalogada em
    docs/DADOS_CONFIAVEIS_E_ARMADILHAS.md."""
    partes = [
        pagina.get("title", ""),
        pagina.get("heading", ""),
        pagina.get("meta_description", ""),
        pagina.get("summary", ""),
    ]
    for secao in pagina.get("body_sections") or []:
        if isinstance(secao, dict):
            partes.append(secao.get("title", ""))
            partes.append(secao.get("body", ""))
    for item in pagina.get("faq") or []:
        if isinstance(item, dict):
            for valor in item.values():
                if isinstance(valor, str):
                    partes.append(valor)
    return "\n".join(p for p in partes if isinstance(p, str))


def cabecalho_da_pagina(pagina: dict) -> str:
    """Onde a pagina declara do que ela trata. Usado no teste de sustentacao."""
    partes = [
        pagina.get("title", ""),
        pagina.get("heading", ""),
        pagina.get("meta_description", ""),
        pagina.get("summary", ""),
    ]
    for secao in pagina.get("body_sections") or []:
        if isinstance(secao, dict):
            partes.append(secao.get("title", ""))
    return "\n".join(p for p in partes if isinstance(p, str))


def chaves_declaradas(pagina: dict) -> set[str]:
    """Todo numero de 3+ digitos e todo apelido presente na proveniencia.

    Chave a mais nunca cria acusacao: so cobre citacao. O erro seguro deste
    gate e deixar passar, entao a extracao aqui e deliberadamente generosa.
    """
    chaves: set[str] = set()
    for fonte in pagina.get("source_provenance") or []:
        if not isinstance(fonte, dict):
            continue
        url = fonte.get("source_url", "") or ""
        caminho = urlparse(url).path
        base = caminho.rstrip("/").split("/")[-1].lower()
        if base.startswith(BASENAME_CONSTITUCIONAL):
            chaves.add("CF")
        texto_livre = " ".join(
            str(fonte.get(campo, "") or "")
            for campo in ("source_id", "source_name", "anchor_claim", "license_note")
        )
        alvo = normaliza(texto_livre + " " + caminho.replace("/", " "))
        for numero in NUM_FONTE_RE.findall(alvo.replace(".", "")):
            chaves.add(so_digitos(numero))
        for numero in NUM_FONTE_RE.findall(alvo):
            chaves.add(so_digitos(numero))
        # numero com separador de milhar preservado ("10.406")
        for numero in re.findall(r"\d{1,3}(?:\.\d{3})+", texto_livre):
            chaves.add(so_digitos(numero))
        for apelido, canonicas in APELIDOS.items():
            if apelido in alvo:
                chaves |= canonicas
    return chaves


