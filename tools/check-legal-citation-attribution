def cobertura_jurisprudencial(pagina: dict) -> tuple[bool, bool, set[str]]:
    """A pagina declara alguma fonte do universo das sumulas / dos temas?

    Por que a cobertura e por UNIVERSO e nao por numero: a mesma logica que faz
    a URL compilada de uma lei cobrir todos os seus artigos faz o compendio de
    sumulas cobrir todas as sumulas. O acervo declara 81 vezes SumulasSTJ.pdf,
    110 vezes o Livro-Internet de sumulas do TST e 288 vezes o temas.csv de
    dados abertos do STJ — todos contem o enunciado citado. Exigir o numero
    exato acusaria essas paginas por um defeito que nao existe (medido: 1.371
    acusacoes de sumula e 1.904 de tema na versao que exigia o numero).

    O que resta acusavel — e e o caso do enunciado da DEC-032 — e a pagina que
    cita sumula/tema e nao declara NENHUMA fonte jurisprudencial: so lei e
    orgao administrativo. Ai o enunciado citado nao tem de onde ter vindo.
    """
    fonte_sumula = False
    fonte_tema = False
    numeros: set[str] = set()
    for fonte in pagina.get("source_provenance") or []:
        if not isinstance(fonte, dict):
            continue
        alvo = normaliza(
            " ".join(
                str(fonte.get(campo, "") or "")
                for campo in ("source_id", "source_name", "source_url", "anchor_claim")
            )
        )
        marcado = False
        if any(marca in alvo for marca in MARCA_SUMULA) or MARCA_SV_RE.search(alvo):
            fonte_sumula = True
            marcado = True
        if any(marca in alvo for marca in MARCA_TEMA):
            fonte_tema = True
            marcado = True
        if MARCA_TRIBUNAL_RE.search(alvo):
            # Fonte de tribunal cobre as duas classes: informativo, acordao,
            # noticia de julgamento e base de jurisprudencia sao de onde sai
            # enunciado sumulado e tese de tema. Distinguir "cobre o enunciado
            # N" de "e do mesmo tribunal" ja exige julgamento juridico.
            fonte_sumula = True
            fonte_tema = True
            marcado = True
        if marcado:
            numeros |= {so_digitos(n) for n in NUM_PONTUAL_RE.findall(alvo)}
    return fonte_sumula, fonte_tema, numeros


FIM_DE_FRASE_RE = re.compile(r"(?<![\d])\.(?=\s+[A-ZÀ-Ý]|\s*$)")


def frase_em_volta(texto: str, posicao: int) -> str:
    """Recorta a frase da citacao. O ponto do separador de milhar ("Tema 1.236")
    e o ponto de "art." NAO encerram frase — cortar neles produzia evidencia
    truncada em "ao julgar o Tema 1." e escondia o proprio achado."""
    inicio = 0
    for casamento in FIM_DE_FRASE_RE.finditer(texto[:posicao]):
        inicio = casamento.end()
    inicio = max(inicio, texto.rfind("\n", 0, posicao) + 1)
    seguinte = FIM_DE_FRASE_RE.search(texto, posicao)
    fim = seguinte.end() if seguinte else min(len(texto), posicao + 260)
    return texto[inicio:fim].strip()


def tem_contraste(frase: str) -> bool:
    plana = normaliza(frase)
    return any(marcador in plana for marcador in MARCADORES_CONTRASTE)


def faixas_citadas(texto: str) -> list[tuple[int, int]]:
    """Trechos entre aspas: texto oficial REPRODUZIDO, nao afirmado pela pagina.

    Medido: as paginas /jurisprudencia/stj-tema-* transcrevem a tese do
    tribunal, e a tese cita leis ("art. 6º, VII, b, da Lei 7.713/88"). Cobrar
    da pagina uma fonte do Planalto para cada lei citada DENTRO da tese do STJ
    e o mesmo erro do detector que, em 2026-07-11, acusou 46 paginas por
    citarem o erro de um terceiro. A pagina atribui aquilo ao STJ, e declara o
    STJ como fonte.
    """
    return [(c.start(1), c.end(1)) for c in ASPAS_RE.finditer(texto)]


def dentro_de_citacao(posicao: int, faixas: list[tuple[int, int]]) -> bool:
    return any(inicio <= posicao < fim for inicio, fim in faixas)


def diplomas_citados(texto: str) -> list[tuple[frozenset, int, str]]:
    """Devolve (chaves_aceitas, posicao, apelido_lido) para 'art. N <conector> X'.

    chaves_aceitas e um CONJUNTO porque apelido ambiguo aceita mais de um
    diploma ("CPC" = 13.105 ou 5.869). Basta UMA das chaves estar declarada
    para a citacao estar coberta — e a acusacao, quando ocorre, e uma so.

    Le somente a ordem direta. Ordem inversa e anafora ficam de fora por
    decisao documentada no docstring.
    """
    achados: list[tuple[frozenset, int, str]] = []
    for casamento in ART_RE.finditer(texto):
        janela = texto[casamento.end() : casamento.end() + 90]
        conector = CONECTOR_RE.match(janela)
        if not conector:
            continue
        resto = janela[conector.end() :]
        resto_plano = normaliza(resto)
        melhor: tuple[str, set[str]] | None = None
        for apelido, canonicas in APELIDOS.items():
            if resto_plano.startswith(apelido):
                if melhor is None or len(apelido) > len(melhor[0]):
                    melhor = (apelido, canonicas)
        if melhor is not None:
            achados.append((frozenset(melhor[1]), casamento.start(), melhor[0]))
            continue
        lei = LEI_NUM_RE.match(resto.strip())
        if lei:
            achados.append(
                (frozenset({so_digitos(lei.group(1))}), casamento.start(), lei.group(0).strip())
            )
    return achados


def sustentado(chaves: frozenset, apelido: str, cabecalho: str, frases_distintas: int) -> bool:
    """O diploma e pilar da pagina, ou mencao de passagem?

    Pilar = aparece no cabecalho editorial (title/heading/meta/summary/H2) OU
    e citado com artigo em 2+ FRASES DISTINTAS. Mencao unica de passagem nao
    acusa: e ali que moram contraste didatico e negacao.

    Por que frases DISTINTAS e nao ocorrencias: o acervo repete a mesma frase
    de rodape em summary e corpo ("Por ser tese em recurso repetitivo (art.
    1.036 do CPC), ela alcanca os processos..."). Contar ocorrencia cruas fazia
    um aparte processual repetido virar "pilar da pagina" — 22 acusacoes de CPC
    em paginas /jurisprudencia/ que tratam de outra coisa.
    """
    if frases_distintas >= 2:
        return True
    cabecalho_plano = normaliza(cabecalho)
    if apelido and normaliza(apelido) in cabecalho_plano:
        return True
    for nome, canonicas in APELIDOS.items():
        if (canonicas & chaves) and nome in cabecalho_plano:
            return True
    for chave in chaves:
        if len(chave) > 3 and chave.isdigit():
            if re.search(
                r"\b" + re.escape(chave[:-3]) + r"\.?" + re.escape(chave[-3:]) + r"\b",
                cabecalho_plano,
            ):
                return True
        elif chave.isdigit() and re.search(r"\b" + re.escape(chave) + r"\b", cabecalho_plano):
            return True
    return False


def avalia_pagina(pagina: dict) -> list[dict]:
    """Devolve a lista de acusacoes da pagina (vazia = limpa)."""
    fontes = pagina.get("source_provenance") or []
    if not fontes:
        return []  # fonte ausente e defeito MEDIO publicavel — nao e deste gate
    texto = corpo_da_pagina(pagina)
    cabecalho = cabecalho_da_pagina(pagina)
    declaradas = chaves_declaradas(pagina)
    acusacoes: list[dict] = []

    # ---- R1: diploma citado sem fonte que o cubra --------------------------
    citacoes = diplomas_citados(texto)
    faixas = faixas_citadas(texto)
    tem_fonte_tribunal = any(
        MARCA_TRIBUNAL_RE.search(
            normaliza(
                " ".join(
                    str(f.get(campo, "") or "")
                    for campo in ("source_id", "source_name", "source_url", "anchor_claim")
                )
            )
        )
        for f in fontes
        if isinstance(f, dict)
    )
    frases_por_chave: dict[frozenset, set[str]] = defaultdict(set)
    validas: list[tuple[frozenset, int, str, str]] = []
    for chaves, posicao, apelido in citacoes:
        if dentro_de_citacao(posicao, faixas):
            continue
        frase = frase_em_volta(texto, posicao)
        if tem_fonte_tribunal and ATRIBUICAO_A_TRIBUNAL_RE.search(normaliza(frase)):
            continue
        frases_por_chave[chaves].add(frase)
        validas.append((chaves, posicao, apelido, frase))
    ja_acusado: set[frozenset] = set()
    for chaves, posicao, apelido, frase in validas:
        if (chaves & declaradas) or chaves in ja_acusado:
            continue
        if tem_contraste(frase):
            continue
        if not sustentado(chaves, apelido, cabecalho, len(frases_por_chave[chaves])):
            continue
        ja_acusado.add(chaves)
        acusacoes.append(
            {
                "regra": "diploma_sem_fonte",
                "dispositivo": f"{apelido} ({'/'.join(sorted(chaves))})",
                "evidencia": frase[:260],
            }
        )

    # ---- R2: sumula / tema pontual sem fonte jurisprudencial que o cubra ---
    fonte_sumula, fonte_tema, numeros_pontuais = cobertura_jurisprudencial(pagina)
    if not fonte_sumula:
        for casamento in SUMULA_RE.finditer(texto):
            numero = so_digitos(casamento.group(2))
            if numero in numeros_pontuais:
                continue
            frase = frase_em_volta(texto, casamento.start())
            if tem_contraste(frase):
                continue
            rotulo = "Sumula Vinculante" if casamento.group(1) else "Sumula"
            acusacoes.append(
                {
                    "regra": "sumula_sem_fonte",
                    "dispositivo": f"{rotulo} {numero}",
                    "evidencia": frase[:260],
                }
            )
            break  # uma acusacao por pagina: a causa e a mesma
    if not fonte_tema:
        for casamento in TEMA_RE.finditer(texto):
            numero = so_digitos(casamento.group(1))
            if numero in numeros_pontuais:
                continue
            frase = frase_em_volta(texto, casamento.start())
            if tem_contraste(frase) or not CONTEXTO_JURISPRUDENCIAL_RE.search(normaliza(frase)):
                continue
            acusacoes.append(
                {
                    "regra": "tema_sem_fonte",
                    "dispositivo": f"Tema {numero}",
                    "evidencia": frase[:260],
                }
            )
            break

    # R3 (contradicao interna) foi MEDIDA e removida — ver o docstring.
    return acusacoes


def carrega_paginas() -> list[dict]:
    with PAGES_JSON.open(encoding="utf-8") as arquivo:
        dados = json.load(arquivo)
    return [
        p
        for p in dados
        if p.get("status") == "published" and p.get("index_policy") == "index"
    ]


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--medir", action="store_true", help="diagnostico; sempre exit 0")
    parser.add_argument("--amostra", type=int, default=0, help="quantas evidencias imprimir")
    parser.add_argument("--limite", type=int, default=40, help="quantas paginas listar")
    parser.add_argument("--autoteste", action="store_true", help="roda os casos de falso positivo")
    argumentos = parser.parse_args()

    if argumentos.autoteste:
        return autoteste()

    if not PAGES_JSON.exists():
        print(f"FALHA: {PAGES_JSON} nao existe")
        return 1

    paginas = carrega_paginas()
    sem_fonte = 0
    por_regra: Counter = Counter()
    acusadas: list[tuple[str, list[dict]]] = []
    for pagina in paginas:
        if not (pagina.get("source_provenance") or []):
            sem_fonte += 1
            continue
        acusacoes = avalia_pagina(pagina)
        if acusacoes:
            acusadas.append((pagina.get("path", "?"), acusacoes))
            for acusacao in acusacoes:
                por_regra[acusacao["regra"]] += 1

    print(f"paginas published+index analisadas: {len(paginas)}")
    print(f"paginas sem fonte declarada (fora do escopo deste gate): {sem_fonte}")
    print(f"paginas acusadas: {len(acusadas)}")
    for regra, total in sorted(por_regra.items()):
        print(f"  {regra}: {total} acusacoes")

    if argumentos.medir:
        detalhe: dict[str, Counter] = defaultdict(Counter)
        for _, acusacoes in acusadas:
            for acusacao in acusacoes:
                detalhe[acusacao["regra"]][acusacao["dispositivo"]] += 1
        for regra, contador in detalhe.items():
            print(f"\n--- {regra}: dispositivos mais frequentes")
            for dispositivo, total in contador.most_common(25):
                print(f"  {total:5d}  {dispositivo}")

    mostradas = 0
    for caminho, acusacoes in acusadas[: argumentos.limite]:
        print(f"\n{caminho}")
        for acusacao in acusacoes:
            print(f"  [{acusacao['regra']}] {acusacao['dispositivo']}")
            if mostradas < argumentos.amostra:
                print(f"      {acusacao['evidencia']}")
                mostradas += 1

    if argumentos.medir:
        return 0
    if acusadas:
        print(
            f"\nREPROVADO: {len(acusadas)} paginas citam dispositivo que a "
            "proveniencia declarada nao cobre."
        )
        return 1
    print("\nAPROVADO: toda citacao mecanicamente conferivel tem fonte que a cubra.")
    return 0


