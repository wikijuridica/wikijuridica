#!/usr/bin/env python3
"""check-og-image-existe — READ-ONLY.

Reprova quando uma página anuncia `og:image` (ou `twitter:image`) apontando para
uma URL do próprio portal que NÃO existe em `public/`.

POR QUE ESTE GATE NASCE JUNTO COM A TAG, e não depois. Este repositório já pagou
três vezes pelo mesmo defeito nesta superfície — anunciar para máquina uma porta
que responde 404:

  * `/consumidor/exemplo/index.md`, URL escrita à mão no llms.txt, publicada
    respondendo 404 até 2026-08-19;
  * `Link: rel="alternate"` na home apontando para `/index.md` quando aquela
    rota ainda era 404 (corrigido em internal/httpserver/markdown.go, ver o
    comentário de `temGemeaEmMarkdown`);
  * quatro URLs dentro de crase no `/auth.md`, que geraram 138 respostas 404 com
    `%60` em 7 dias.

`og:image` é a mesma armadilha com plateia maior: o LinkedIn, o WhatsApp e o
`facebookexternalhit` (298 req/dia neste portal) buscam a imagem no ato do
compartilhamento. Um 404 ali não degrada — some o cartão inteiro, e some no
momento em que alguém decidiu divulgar a página.

A ORDEM SEGURA DE MATERIALIZAÇÃO, que este gate torna verificável: o arquivo
`public/social/{área}.png` primeiro, o HTML que o anuncia depois. Enquanto o
HTML não anunciar nada, o gate passa (não há promessa a quebrar); no instante em
que anunciar, ele exige o arquivo.

O QUE ELE NÃO FAZ: não valida a imagem (dimensão, peso, formato) — isso é do
teste de internal/socialcard, que fixa 1200×630, ≥300 px e <600 KB contra os
limites publicados das plataformas. Aqui só se responde uma pergunta: o que a
página promete existe no disco?

URL EXTERNA É IGNORADA, de propósito: este gate não sai para a rede e não tem
como julgar host de terceiro. Ele cobre o que o portal controla — e o portal não
deveria anunciar imagem de terceiro em og:image de qualquer modo.

PROVA DE QUE REPROVA:

    mkdir -p /tmp/fx/public/x
    printf '<meta property="og:image" content="https://wikijuridica.com.br/social/nao-existe.png">' \\
      > /tmp/fx/public/x/index.html
    tools/check-og-image-existe --root /tmp/fx; echo $?
"""

from __future__ import annotations

import argparse
import os
import re
import sys

BYTES_DE_CABECA = 16384
TAG_IMAGEM = re.compile(
    rb"""<meta\s+(?:property|name)=["'](og:image|twitter:image)["']\s+content=["']([^"']+)["']""",
    re.IGNORECASE,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="reprova og:image/twitter:image que aponta para arquivo inexistente em public/"
    )
    parser.add_argument("--root", default=None)
    parser.add_argument("--base", default="https://wikijuridica.com.br")
    args = parser.parse_args()

    raiz = os.path.abspath(args.root or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    base = args.base.rstrip("/")
    raiz_public = os.path.join(raiz, "public")

    quebradas: dict[str, list[str]] = {}
    anunciadas: set[str] = set()
    externas: set[str] = set()
    htmls = 0
    paginas_com_tag = 0

    for pasta, _, arquivos in os.walk(raiz_public):
        for nome in arquivos:
            if not nome.endswith(".html"):
                continue
            caminho = os.path.join(pasta, nome)
            htmls += 1
            try:
                with open(caminho, "rb") as fh:
                    cabeca = fh.read(BYTES_DE_CABECA)
            except OSError:
                continue
            achou = False
            for casamento in TAG_IMAGEM.finditer(cabeca):
                url = casamento.group(2).decode("utf-8", "replace")
                achou = True
                if not url.startswith(base + "/"):
                    externas.add(url)
                    continue
                relativo = url[len(base) + 1:]
                anunciadas.add(relativo)
                if not os.path.isfile(os.path.join(raiz_public, relativo)):
                    quebradas.setdefault(relativo, []).append(os.path.relpath(caminho, raiz))
            if achou:
                paginas_com_tag += 1

    print(f"check-og-image-existe: html={htmls} com_tag={paginas_com_tag} "
          f"urls_distintas={len(anunciadas)} externas={len(externas)} quebradas={len(quebradas)}")
    if externas:
        for url in sorted(externas)[:5]:
            print(f"AVISO: imagem de host externo, fora do alcance deste gate: {url}")
    if not quebradas:
        print("OK: toda imagem social anunciada existe em public/.")
        return 0
    for relativo, paginas in sorted(quebradas.items()):
        print(f"FALHA: public/{relativo} nao existe e e anunciado por {len(paginas)} pagina(s), "
              f"ex.: {paginas[0]}", file=sys.stderr)
    print(f"check-og-image-existe: {len(quebradas)} imagem(ns) prometida(s) e ausente(s)", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
