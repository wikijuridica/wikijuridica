#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-languagetool-quality [flags]

Runs cmd/generate-languagetool-quality through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
cd "$ROOT"

full_corpus_release_mode=0
has_timings=0
has_cache_path=0
max_live_checks=""
expect_cache_path_value=0
expect_max_live_value=0
for arg in "$@"; do
	if [ "$expect_cache_path_value" -eq 1 ]; then
		case "$arg" in
		'' | --*)
			;;
		*)
			has_cache_path=1
			;;
		esac
		expect_cache_path_value=0
		continue
	fi
	if [ "$expect_max_live_value" -eq 1 ]; then
		max_live_checks="$arg"
		expect_max_live_value=0
		continue
	fi
	case "$arg" in
	--full-corpus | --require-scale-sidecar)
		full_corpus_release_mode=1
		;;
	--timings)
		has_timings=1
		;;
	--cache-path=*)
		cache_path="${arg#--cache-path=}"
		if [[ -n "$cache_path" ]]; then
			has_cache_path=1
		fi
		;;
	--cache-path)
		expect_cache_path_value=1
		;;
	--max-live-checks=*)
		max_live_checks="${arg#--max-live-checks=}"
		;;
	--max-live-checks)
		expect_max_live_value=1
		;;
	esac
done

has_positive_live_budget=0
case "$max_live_checks" in
'' | *[!0-9]*)
	has_positive_live_budget=0
	;;
*)
	if [ "$max_live_checks" -gt 0 ]; then
		has_positive_live_budget=1
	fi
	;;
esac

if [ "$full_corpus_release_mode" -eq 1 ]; then
	if [ "$has_timings" -eq 0 ] || [ "$has_cache_path" -eq 0 ] || [ "$has_positive_live_budget" -eq 0 ]; then
		echo "generate-languagetool-quality: full-corpus/scale-sidecar mode requires --timings, --cache-path and positive --max-live-checks; use tools/generate-languagetool-quality-release for P0 release" >&2
		exit 2
	fi
fi

export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:languagetool-quality:gocache:${GOCACHE:-$HOME/.cache/go-build}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-120000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=100}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/languagetool_quality_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-languagetool-quality}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/languagetool_quality_evidence.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-420}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-languagetool-quality --timings "$@"
