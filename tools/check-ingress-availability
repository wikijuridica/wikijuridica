#!/usr/bin/env python3
"""Reprova se o ingress do wiki ficou fora do ar na janela — na unit que REALMENTE serve.

POR QUE ESTE CHECK EXISTE (2026-08-13)
--------------------------------------
Em 2026-08-12 o nginx foi parado e reiniciado OITO vezes, 8 a 9 segundos cada,
duas delas encerradas a forca ("Stopping timed out. Terminating."). Ninguem
percebeu: o site respondia normalmente pela borda, que servia HIT de um cache de
7 dias. Quem apanhava era o crawler, que pede URL fria e recebia 502 do
cloudflared ("dial tcp 127.0.0.1:8088: connect: connection refused").

Indisponibilidade curta e invisivel para o visitante e cara para o rastreio: o
GoogleOther recebeu 1,18% de erro em 08/08 e colapsou de 2.198 para 6 requests
em dois dias, sem recuperar mesmo nos dias limpos.

A UNIT VEM DE `ops/ingress.env`, E ISSO E O PONTO
-------------------------------------------------
Um gate escrito com `journalctl -u nginx` fixo continuaria verde para sempre
depois que o wiki ganhar instancia dedicada (`wikijuridica-nginx`): ele estaria
vigiando um servico que nao serve mais o site. Falso-verde estrutural, e da pior
especie — o que aparece justamente quando a topologia muda, que e quando mais se
precisa de vigilancia.

Pelo mesmo motivo, unit inexistente ou inativa REPROVA. Journal vazio pode
significar "nada aconteceu" ou "estou olhando para o lugar errado", e as duas
sao indistinguiveis pelo silencio.

Uso:
    tools/check-ingress-availability                 # desde 00:00 de hoje
    tools/check-ingress-availability --desde '-6h'   # ultimas 6 horas
    tools/check-ingress-availability --janela-deploy # so a janela do ultimo deploy

READ-ONLY.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
INGRESS_ENV = RAIZ / "ops" / "ingress.env"
FINGERPRINT = RAIZ / "data" / "ops" / "deploy_layer_fingerprint.json"

# Eventos que significam "a origem parou de aceitar conexao". `Reloading` e
# `Reloaded` NAO entram: reload gracioso e exatamente o que queremos que aconteca.
EVENTOS_QUEDA = re.compile(r"(Stopping|Stopped|Failed with result|timed out\.\s*Terminating|Main process exited)")


def unit_ativa() -> str:
    if INGRESS_ENV.is_file():
        texto = INGRESS_ENV.read_text(encoding="utf-8")
        achado = re.search(r"^WIKI_NGINX_UNIT=(.+)$", texto, re.M)
        if achado:
            return achado.group(1).strip()
    return "nginx"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--desde", default="today", help="janela do journalctl (default: today)")
    ap.add_argument("--janela-deploy", action="store_true",
                    help="usa o recorded_at do ultimo deploy como inicio da janela")
    args = ap.parse_args()

    unit = unit_ativa()
    desde = args.desde
    if args.janela_deploy and FINGERPRINT.is_file():
        try:
            desde = json.loads(FINGERPRINT.read_text(encoding="utf-8")).get("recorded_at") or desde
        except json.JSONDecodeError:
            pass

    falhas: list[str] = []

    # A unit precisa EXISTIR e estar ativa. Sem isso, journal vazio nao distingue
    # "nada aconteceu" de "estou vigiando o servico errado".
    estado = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True, timeout=20)
    ativo = estado.stdout.strip()
    if ativo != "active":
        falhas.append(
            f"a unit '{unit}' declarada em ops/ingress.env esta '{ativo or 'ausente'}', nao 'active'. "
            "Um gate que aceita isso fica verde vigiando um servico que nao serve o site."
        )

    journal = subprocess.run(
        ["journalctl", "-u", unit, "--since", desde, "--no-pager", "-o", "short-iso"],
        capture_output=True, text=True, timeout=60,
    )
    if journal.returncode != 0:
        falhas.append(f"journalctl -u {unit} falhou: {journal.stderr.strip()[:160]}")

    quedas = [l for l in journal.stdout.splitlines() if EVENTOS_QUEDA.search(l)]
    if quedas:
        falhas.append(f"{len(quedas)} evento(s) de queda da unit '{unit}' desde {desde}:")

    print(f"  unit vigiada: {unit} (de ops/ingress.env) | estado: {ativo or '?'} | janela: desde {desde}")
    print(f"  linhas de journal na janela: {len(journal.stdout.splitlines())}")

    if falhas:
        print("check-ingress-availability: FAIL")
        for f in falhas:
            print(f"  - {f}")
        for linha in quedas[:12]:
            print(f"      {linha}")
        if len(quedas) > 12:
            print(f"      ... e mais {len(quedas) - 12}")
        print("  Cada janela dessas serve 502 ao crawler pelo cloudflared, que nao tem retry por requisicao.")
        return 1

    print("check-ingress-availability: pass")
    print(f"  nenhuma parada da unit '{unit}' na janela — o ingress nao piscou para o crawler")
    return 0


if __name__ == "__main__":
    sys.exit(main())
