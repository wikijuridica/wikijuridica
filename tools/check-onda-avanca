#!/usr/bin/env bash
# check-onda-avanca — a onda diária ACRESCENTOU página, ou só se mexeu?
#
# READ-ONLY sobre o acervo. Escreve UM arquivo próprio de estado
# (.agents/runtime/onda-avanca/) e uma linha de ledger em data/ops/, que é o
# registro da medição — nunca toca public/, content/ nem data/editorial/.
#
# POR QUE ELE EXISTE, com a data e o número. Em 2026-09-09 a onda terminou
# imprimindo "415 páginas geradas" e o published_manifest ficou EXATAMENTE onde
# estava — 10.141 unique_intent_id, imóvel desde 2026-09-04. Cinco dias de
# fábrica parada sem um único vermelho, porque nenhum gate comparava o acervo
# ANTES com o acervo DEPOIS. `paginas_geradas` conta o shard remontado, e o
# shard remontado inclui tudo o que já estava no ar: é um número que sobe
# quando nada acontece.
#
# A causa raiz daquele episódio (o teto do lote cobrado sobre publicadas +
# inéditas) está corrigida em internal/tetodelote e nos cinco geradores. Este
# gate existe para o caso de ela voltar por outro caminho — e a família já
# reincidiu três vezes (2026-08-20, 2026-08-26, 2026-09-09).
#
# O QUE ELE MEDE, e por que não é `paginas_geradas`:
#   --antes   grava o conjunto de unique_intent_id do published_manifest
#   --depois  recompta, e o VEREDITO é |depois \ antes|, isto é, quantos intents
#             passaram a existir. Conjunto, não contagem: página trocada por
#             outra manteria o total e seria invisível numa diferença de
#             cardinalidade.
#
# EXIT: 0 avançou; 1 não avançou (novas < --minimo); 2 erro de uso ou estado
# ausente. Aviso (sem falhar) quando novas < --alvo.
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

MANIFESTO="data/editorial/published_manifest.jsonl"
ESTADO_DIR=".agents/runtime/onda-avanca"
ESTADO="$ESTADO_DIR/antes.txt"
LEDGER="data/ops/onda_avanca.jsonl"

MODO=""
MINIMO=1
ALVO=0
ROTULO="onda-diaria"

while [ $# -gt 0 ]; do
	case "$1" in
	--antes)
		MODO="antes"
		shift
		;;
	--depois)
		MODO="depois"
		shift
		;;
	--minimo)
		MINIMO="$2"
		shift 2
		;;
	--alvo)
		ALVO="$2"
		shift 2
		;;
	--rotulo)
		ROTULO="$2"
		shift 2
		;;
	*)
		echo "check-onda-avanca: argumento desconhecido: $1" >&2
		echo "uso: check-onda-avanca --antes | --depois [--minimo N] [--alvo N] [--rotulo TEXTO]" >&2
		exit 2
		;;
	esac
done

if [ -z "$MODO" ]; then
	echo "check-onda-avanca: informe --antes ou --depois" >&2
	exit 2
fi

if [ ! -f "$MANIFESTO" ]; then
	echo "check-onda-avanca: FALHA — $MANIFESTO não existe; sem manifesto não há medição" >&2
	exit 2
fi

# unique_intent_id é a chave do acervo: `manifest_id` muda a cada release e
# `path` não distingue supersessão. Ver a memória "chaves que enganam a medição".
intents() {
	python3 - "$MANIFESTO" <<'PY'
import json, sys
vistos = set()
with open(sys.argv[1], encoding="utf-8") as fh:
    for linha in fh:
        linha = linha.strip()
        if not linha:
            continue
        try:
            registro = json.loads(linha)
        except json.JSONDecodeError:
            # Linha corrompida é DEFEITO, não ruído a ignorar em silêncio: o
            # manifesto é a única enumeração autoritativa do que está no ar.
            print("LINHA_INVALIDA", file=sys.stderr)
            raise
        intent = (registro.get("unique_intent_id") or "").strip()
        if intent:
            vistos.add(intent)
for intent in sorted(vistos):
    print(intent)
PY
}

if [ "$MODO" = "antes" ]; then
	mkdir -p "$ESTADO_DIR"
	intents >"$ESTADO.tmp"
	mv "$ESTADO.tmp" "$ESTADO"
	echo "check-onda-avanca: baseline gravado — $(wc -l <"$ESTADO") intents publicados ($ROTULO)"
	exit 0
fi

if [ ! -f "$ESTADO" ]; then
	echo "check-onda-avanca: FALHA — baseline ausente ($ESTADO). Rode --antes no início da onda." >&2
	exit 2
fi

DEPOIS="$ESTADO_DIR/depois.txt"
intents >"$DEPOIS"

NOVAS=$(comm -13 "$ESTADO" "$DEPOIS" | wc -l)
SUMIRAM=$(comm -23 "$ESTADO" "$DEPOIS" | wc -l)
TOTAL=$(wc -l <"$DEPOIS")
QUANDO=$(date -u +%Y-%m-%dT%H:%M:%SZ)

mkdir -p "$(dirname "$LEDGER")"
printf '{"quando":"%s","rotulo":"%s","total_publicado":%d,"novas_publicadas":%d,"sumiram":%d,"minimo":%d,"alvo":%d}\n' \
	"$QUANDO" "$ROTULO" "$TOTAL" "$NOVAS" "$SUMIRAM" "$MINIMO" "$ALVO" >>"$LEDGER"

echo "check-onda-avanca: $TOTAL publicados | novas: $NOVAS | sumiram: $SUMIRAM"

if [ "$SUMIRAM" -gt 0 ]; then
	# Página que sai do manifesto sem supersessão é 404 no índice do buscador.
	# Isso é coerência de artefato, e não se flexibiliza.
	echo "check-onda-avanca: FALHA — $SUMIRAM intent(s) saíram do manifesto:" >&2
	comm -23 "$ESTADO" "$DEPOIS" | head -20 >&2
	exit 1
fi

if [ "$NOVAS" -lt "$MINIMO" ]; then
	echo "check-onda-avanca: FALHA — a onda não acrescentou página (novas=$NOVAS, mínimo=$MINIMO)." >&2
	echo "  O acervo tem $TOTAL intents e continua com os mesmos. Coleta e geração podem ter" >&2
	echo "  rodado sem que nada novo chegasse ao ar — foi exatamente o quadro de 2026-09-04 a 09." >&2
	exit 1
fi

if [ "$ALVO" -gt 0 ] && [ "$NOVAS" -lt "$ALVO" ]; then
	echo "check-onda-avanca: aviso — novas=$NOVAS abaixo do alvo de $ALVO (não reprova)"
fi

echo "check-onda-avanca: pass — a onda avançou"
exit 0
