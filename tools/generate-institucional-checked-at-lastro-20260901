#!/usr/bin/env python3
"""Rebaixa, nas páginas institucionais, o "Verificado em" que ficou À FRENTE do lastro.

O QUE FOI MEDIDO (2026-09-01, pelo gate tools/check-checked-at-coerente)
-----------------------------------------------------------------------
Cinco páginas institucionais — /sobre/, /metodologia/, /aviso-legal/,
/privacidade/, /termos/ — exibem "Verificado em 04/08/2026" para o Estatuto da
OAB (l8906.htm) e para a LGPD (l13709.htm). A última conferência REAL dessas URLs
no estoque v2 é 2026-07-16 (l8906) e 2026-07-21 (l13709). Procurei o 04/08 em
todo ledger de fonte oficial do repositório — official_source_verification,
v2_official_source_verify, v2_source_provenance, official_source_url_live_evidence:
NENHUM registra a URL conferida nesse dia. O carimbo veio do commit 48d62b25 sem
registro de conferência. É rótulo de frescor sem lastro, visível ao leitor: o
teste da fraude aplicado ao texto.

POR QUE UM GERADOR DATADO, E NÃO A EDIÇÃO À MÃO QUE UM AGENTE JÁ TENTOU
------------------------------------------------------------------------
Na mesma tarde um subagente reescreveu content/pages.json por tempfile+replace
para fazer o gate dele passar — 10 campos, permissão 0600, sem cópia preservada,
sem dizer o que fazia e junto de 927 hunks da onda diária. A substância estava
certa; o processo violava o contrato (dado editorial se corrige por gerador
datado, com evidência, atômico, um campo). Desfiz por edição de linha e escrevi
isto no lugar.

O QUE ESTE GERADOR FAZ, E O QUE SE RECUSA A FAZER
--------------------------------------------------
Para cada página cujo page_type NÃO é conteúdo jurídico (as institucionais moram
em content/pages.json; o publicador as preserva de lá — cmd/publish-v2-direct
loadInstitutionalPages), e para cada source_provenance[] com checked_at:
  - se existe verified_at para a URL no estoque v2 e checked_at > máximo:
    checked_at := máximo. Um campo, com a data que TEM lastro.
  - se NÃO existe lastro nenhum: NÃO toca. Apagar a data seria decisão editorial
    (a página deixaria de afirmar conferência) e não cabe a um gerador; o gate
    continua a REPORTAR esses casos, e a correção honesta deles é CONFERIR a URL
    e gravar a evidência — não apagar nem inventar.
Recusa-se a rodar se encontrar qualquer diferença além dessas. Escrita atômica
(tmp + os.replace), permissão 0644 preservada, cópia do arquivo anterior em
.agents/runtime/ com data.

    tools/generate-institucional-checked-at-lastro-20260901 --seco
    tools/generate-institucional-checked-at-lastro-20260901
"""

from __future__ import annotations

import argparse
import datetime
import glob
import json
import os
import shutil
import sys
import urllib.parse

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PAGES = os.path.join(RAIZ, "content", "pages.json")
ESTOQUE = os.path.join(RAIZ, "data", "editorial", "v2_pages", "*.jsonl")
BACKUP_DIR = os.path.join(RAIZ, ".agents", "runtime", "backup-institucional-checked-at-20260901")

# Espelha loadInstitutionalPages (cmd/publish-v2-direct): o publicador preserva de
# content/pages.json toda página cujo page_type NÃO está em content.LegalPageTypes.
# Medido em 2026-09-01, os tipos não-jurídicos presentes são estes três.
TIPOS_PRESERVADOS_DE_PAGES_JSON = {"institucional", "aviso-legal", "contato"}


def sem_fragmento(url: str) -> str:
    """Mesma chave por documento que o gate usa: URL sem #fragmento."""
    return urllib.parse.urldefrag(url.strip())[0]


def maximo_verified_at() -> dict[str, str]:
    """{url_sem_fragmento: maior verified_at válido no estoque v2}."""
    maximo: dict[str, str] = {}
    for caminho in glob.glob(ESTOQUE):
        with open(caminho, encoding="utf-8") as handle:
            for linha in handle:
                linha = linha.strip()
                if not linha:
                    continue
                try:
                    registro = json.loads(linha)
                except json.JSONDecodeError:
                    continue
                # No estoque v2 o campo é official_sources[].{url, verified_at}
                # (876 shards, 24.622 verified_at) — o mesmo que o gate lê.
                for fonte in registro.get("official_sources") or []:
                    url = fonte.get("url")
                    data = str(fonte.get("verified_at") or "")
                    if not url or len(data) < 10:
                        continue
                    chave = sem_fragmento(url)
                    if data[:10] > maximo.get(chave, ""):
                        maximo[chave] = data[:10]
    return maximo


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--seco", action="store_true", help="mostra o que mudaria e não escreve")
    args = ap.parse_args()

    with open(PAGES, encoding="utf-8") as handle:
        bruto = handle.read()
    paginas = json.loads(bruto)
    maximo = maximo_verified_at()
    if not maximo:
        print("RECUSADO: estoque v2 sem verified_at — sem lastro não há o que rebaixar", file=sys.stderr)
        return 2

    mudancas = []
    sem_lastro = []
    for pagina in paginas:
        # ALVO: as páginas que o publicador PRESERVA de content/pages.json
        # (loadInstitutionalPages: page_type fora de LegalPageTypes). Conteúdo
        # jurídico tem shard v2 como fonte — editar aqui seria inútil.
        if pagina.get("page_type") not in TIPOS_PRESERVADOS_DE_PAGES_JSON:
            continue
        if str(pagina.get("path") or "").startswith("/fontes/"):
            continue  # regerado pelo publicador a partir do ledger (fontesPage); editar aqui é inútil
        for fonte in pagina.get("source_provenance") or []:
            url = fonte.get("source_url")
            atual = str(fonte.get("checked_at") or "")
            if not url or len(atual) < 10:
                continue
            chave = sem_fragmento(url)
            teto = maximo.get(chave)
            if teto is None:
                sem_lastro.append((pagina.get("path"), url, atual))
                continue
            if atual[:10] > teto:
                mudancas.append((pagina.get("path"), url, atual, teto))
                fonte["checked_at"] = teto

    print(f"páginas lidas: {len(paginas)} · documentos com lastro no estoque: {len(maximo)}")
    print(f"checked_at À FRENTE do lastro (rebaixados): {len(mudancas)}")
    for path, url, de, para in mudancas:
        print(f"    {path:18s} {url[-34:]:34s} {de} -> {para}")
    print(f"checked_at SEM lastro nenhum (NÃO tocados, reportados): {len(sem_lastro)}")
    for path, url, data in sem_lastro:
        print(f"    {path:18s} {url[-34:]:34s} {data}  — conferir a URL e gravar evidência; não apagar")

    if not mudancas:
        print("\nnada a escrever.")
        return 0
    if args.seco:
        print("\n--seco: nada escrito.")
        return 0

    os.makedirs(BACKUP_DIR, exist_ok=True)
    carimbo = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    copia = os.path.join(BACKUP_DIR, f"pages.json.{carimbo}.antes")
    shutil.copy2(PAGES, copia)

    # ★ ESCRITA CIRÚRGICA NO TEXTO, NÃO RESERIALIZAÇÃO — medido na primeira
    #   execução: `json.dumps` produziu 1.834 linhas de diferença para 5 campos
    #   trocados, porque o writeJSON do publicador é o MarshalIndent do Go, que
    #   escapa `&` como \u0026 (2.085 ocorrências), e o Python não. Semanticamente
    #   igual, mas o diff vira lixo e o próximo publish reescreve tudo de volta.
    #   Aqui se localiza a linha exata de cada campo dentro do bloco da página e
    #   se troca só o valor. Se a localização não for inequívoca, recusa.
    linhas = bruto.split("\n")
    for path, url, de, para in mudancas:
        ini = next((i for i, l in enumerate(linhas) if l.strip() == f'"path": "{path}",'), None)
        if ini is None:
            print(f"RECUSADO: bloco da página {path} não localizado no texto", file=sys.stderr)
            return 2
        alvo_url = json.dumps(url)[1:-1]  # mesmo escape que o arquivo usa
        alvo_url_go = alvo_url.replace("&", "\\u0026")
        achou = None
        for j in range(ini, min(ini + 400, len(linhas))):
            l = linhas[j].strip()
            if l.startswith('"path":') and j != ini:
                break  # entrou na página seguinte
            if l in (f'"source_url": "{alvo_url}",', f'"source_url": "{alvo_url_go}",'):
                for k in range(j, min(j + 8, len(linhas))):
                    if linhas[k].strip() == f'"checked_at": "{de}",':
                        achou = k
                        break
                if achou is not None:
                    break
        if achou is None:
            print(f"RECUSADO: checked_at de {url} em {path} não localizado inequivocamente", file=sys.stderr)
            return 2
        linhas[achou] = linhas[achou].replace(f'"{de}"', f'"{para}"', 1)
    novo = "\n".join(linhas)
    tmp = PAGES + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(novo)
    os.chmod(tmp, 0o644)
    os.replace(tmp, PAGES)
    print(f"\ngravado: content/pages.json ({len(mudancas)} campo(s)); cópia anterior em {os.path.relpath(copia, RAIZ)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
