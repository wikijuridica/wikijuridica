#!/usr/bin/env python3
"""Deriva o INSTANTE REAL de cada onda de publicacao, para o feed parar de inventar meia-noite.

O DEFEITO QUE ISTO CORRIGE (medido em 2026-09-01)
-------------------------------------------------
`public/feed.xml` tinha 1.000 entradas e apenas QUATRO valores distintos de
`<updated>`; 825 delas declaravam exatamente `2026-08-29T00:00:00Z`. Meia-noite
fabricada, repetida 825 vezes, em 524 KB — e este e o documento que o WebSub
empurra ao hub. O portal anunciava ativamente um frescor que nao tinha.

A ORIGEM DA MEIA-NOITE, e por que ela NAO se corrige no ledger
--------------------------------------------------------------
Quando uma execucao carimba mais de LOTE_MINIMO rotas, o gerador grava o DIA e nao
o instante — e isso esta CERTO: 7.963 rotas (onda de 26/08) nao mudam em segundos
distintos, e afirmar que mudaram seria a precisao inventada que o proprio
repositorio ja condenou por escrito e ja rebaixou uma vez (10.070 instantes
identicos viraram dia em a25db892). Nao se relitiga isso.

O que o Atom exige, porem, e RFC 3339 com hora. Entao a saida honesta nao e nem
inventar `T00:00:00Z` (fraude) nem excluir do feed tudo que so tem dia (o feed
cairia para 3 entradas, e um feed vazio nao incentiva ninguem a voltar — os dois
lados do erro que o dono nomeou).

A SAIDA E O INSTANTE DA ONDA, que e um fato real e gravado
-----------------------------------------------------------
A pagina individual nao mudou num segundo identificavel, mas A ONDA foi publicada
num momento real. Esse momento existe no git: e o instante do commit que
introduziu aquele `revised_on` no ledger. Conferido em 2026-09-01 contra a purga
de borda do mesmo deploy — commit 07:34:19Z, purga 07:39:23Z, cinco minutos de
diferenca. E dado, nao estimativa.

★ FONTE PROIBIDA, e por que: o mtime do HTML NAO serve. `gravaDatado` o escreve A
PARTIR da data editorial, inclusive para tras — medido em public/familia/index.html,
mtime 2026-08-26 00:00:00 exato com ctime real de 2026-09-01 16:05. Derivar
instante de um metadado forjado seria trocar uma meia-noite inventada por outra.

READ-ONLY sobre o ledger: le o historico do git e grava um artefato proprio.
"""

from __future__ import annotations

import argparse
import collections
import json
import pathlib
import subprocess
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
LEDGER_REL = "data/ops/page_content_revision.jsonl"
SAIDA = RAIZ / "data/ops/onda_instantes.jsonl"


def ledger_em(commit: str) -> dict[str, str]:
    """{path: revised_on} como estava num commit."""
    proc = subprocess.run(["git", "show", f"{commit}:{LEDGER_REL}"],
                          capture_output=True, text=True, cwd=str(RAIZ), timeout=180)
    if proc.returncode != 0:
        return {}
    fora: dict[str, str] = {}
    for linha in proc.stdout.splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            obj = json.loads(linha)
        except json.JSONDecodeError:
            continue
        caminho = obj.get("path")
        if caminho:
            fora[caminho] = str(obj.get("revised_on", ""))
    return fora


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--versoes", type=int, default=60,
                    help="quantas versoes do ledger percorrer (default 60)")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    log = subprocess.run(["git", "log", "--format=%H %cI", f"-{args.versoes}", "--", LEDGER_REL],
                         capture_output=True, text=True, cwd=str(RAIZ), timeout=180)
    if log.returncode != 0:
        print("generate-onda-instantes: git log falhou", file=sys.stderr)
        return 1

    commits: list[tuple[str, str]] = []
    for linha in log.stdout.splitlines():
        partes = linha.split()
        if len(partes) >= 2:
            commits.append((partes[0], partes[1]))
    commits.reverse()  # do mais antigo para o mais novo
    if len(commits) < 2:
        print("generate-onda-instantes: historico curto demais", file=sys.stderr)
        return 1

    # Para cada DIA de revisao, o instante do commit que o introduziu. Quando o
    # mesmo dia aparece em varios commits (onda em levas), fica o ULTIMO — que e
    # quando aquele dia terminou de ser publicado, e portanto quando o conteudo
    # daquele dia ficou de fato disponivel.
    instante_do_dia: dict[str, str] = {}
    quantas_do_dia: collections.Counter = collections.Counter()

    anterior = ledger_em(commits[0][0])
    for commit, quando in commits[1:]:
        atual = ledger_em(commit)
        if not atual:
            continue
        novos_por_dia: collections.Counter = collections.Counter()
        for caminho, data in atual.items():
            if anterior.get(caminho) == data:
                continue
            dia = data[:10]
            if len(dia) == 10:
                novos_por_dia[dia] += 1
        for dia, quantas in novos_por_dia.items():
            # ★ O INSTANTE TEM DE SER DO PROPRIO DIA, e este filtro nasceu de um
            #   defeito meu na primeira execucao: sem ele, `2026-08-26` recebeu o
            #   instante `2026-08-28T21:29:54` — o commit do ROLLBACK que devolveu
            #   8.245 rotas para 26/08 — e `2026-08-30` recebeu o instante da
            #   ressemeadura que eu mesmo rodei em 2026-09-01. Derivar "quando a
            #   onda foi publicada" do commit que REGRAVOU a data dois dias depois
            #   e trocar uma meia-noite inventada por um instante errado.
            #
            #   A regra: so vale o commit cujo DIA coincide com o dia da revisao.
            #   Onda commitada noutro dia fica SEM instante — e ficar sem e a
            #   resposta correta, porque o feed prefere nao anunciar a anunciar
            #   uma hora que ninguem pode lastrear.
            if quando[:10] != dia:
                continue
            # PRIMEIRO commit do dia vence, nao o ultimo: e quando aquele conteudo
            # ficou disponivel. Regravacoes posteriores do mesmo dia sao correcao
            # de ledger, nao republicacao.
            if dia not in instante_do_dia:
                instante_do_dia[dia] = quando
            quantas_do_dia[dia] += quantas
        anterior = atual

    linhas = []
    for dia in sorted(instante_do_dia):
        linhas.append({
            "schema_version": "onda_instantes_v1",
            "dia": dia,
            "instante": instante_do_dia[dia],
            "rotas_carimbadas": quantas_do_dia[dia],
            "fonte": "instante do commit que introduziu este revised_on em " + LEDGER_REL,
        })

    print(f"ondas com instante derivado: {len(linhas)}")
    for linha in linhas[-8:]:
        print(f"    {linha['dia']}  {linha['instante']}  {linha['rotas_carimbadas']} rota(s)")

    if args.dry_run:
        print("\n--dry-run: nada escrito.")
        return 0

    SAIDA.parent.mkdir(parents=True, exist_ok=True)
    tmp = SAIDA.with_suffix(".jsonl.tmp")
    with tmp.open("w", encoding="utf-8") as saida:
        for linha in linhas:
            saida.write(json.dumps(linha, ensure_ascii=False, sort_keys=True) + "\n")
    tmp.replace(SAIDA)
    print(f"\ngravado: {SAIDA.relative_to(RAIZ)} ({len(linhas)} linhas)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
