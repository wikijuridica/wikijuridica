#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:oss-useful-agent-adapters:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-180000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-45000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=1}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-oss_useful_agent_adapters_evidence_written_or_failed_with_missing_dependency}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/oss_useful_agent_adapters_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-oss-useful-agent-adapters}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/oss_useful_agent_adapters_evidence.jsonl}"
export WIKI_GO_CMD_ENV_WRAPPER="${WIKI_GO_CMD_ENV_WRAPPER:-$ROOT/tools/oss-install-matrix-env}"
cd "$ROOT"
exec run-heavy-throttled run-go-cmd-cached ./cmd/generate-oss-useful-agent-adapters --timings "$@"
