#!/usr/bin/env python3
"""Acrescenta ao portfolio a dica de fonte ESPECIFICA que a intencao exige.

★ O DEFEITO (medido em 2026-08-30)

Duas intencoes citavam o diploma inteiro onde a regra esta num inciso ou artigo
determinado, e os contratos de area cobravam a citacao precisa:

  seg-prestamista-venda-casada    tinha `cdc-lei-8078-1990-art-39` (o artigo)
                                  falta   `cdc-art-39-i-venda-casada` (o INCISO
                                  que proibe condicionar o fornecimento)
  tel-multa-fidelidade-quando-vale tinha `cdc-8078-1990` (o codigo inteiro)
                                  falta   `cdc-art-46` (clausula que o
                                  consumidor nao teve chance de conhecer nao o
                                  obriga — a base para contestar a multa)

Nao e formalidade: a pagina cita a fonte que a dica aponta. "CDC art. 39" manda
o leitor a uma lista de treze praticas abusivas; "CDC art. 39, I" o manda a
venda casada, que e o assunto dela. E o `cdc-8078-1990` manda ao codigo inteiro.

★ O QUE ESTA FERRAMENTA NAO FAZ

Nao remove a dica generica — as duas convivem, e a generica situa o diploma.
Nao inventa chave: cada uma e conferida contra
`data/editorial/v2_source_hint_catalog.json` antes de qualquer escrita, e a
ferramenta aborta inteira se uma faltar. E a escrita e PONTUAL: so as linhas das
intencoes nomeadas sao reserializadas, para nao gerar churn de bytes em milhares
de registros que outras frentes editam.

Uso:
    ./tools/generate-portfolio-hint-especifico-20260830 [--verificar]
"""
import json
import pathlib
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
CATALOGO = RAIZ / "data/editorial/v2_source_hint_catalog.json"

# intent_id -> (arquivo de portfolio, dicas a garantir)
EXIGIDAS = {
    "seg-prestamista-venda-casada": (
        "data/editorial/portfolio_v2/seguros.jsonl",
        ("cdc-art-39-i-venda-casada",),
    ),
    "tel-arrependimento-7-dias-telecom": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("cdc-art-49-direito-arrependimento", "decreto-7962-2013-ecommerce", "anatel-cancelamento", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-cancelamento-automatico-digital": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("anatel-cancelamento", "cdc-art-6", "cdc-art-51", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-cancelar-linha-de-falecido": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("cc-2002-art-6", "cc-art-1784", "cc-2002-art-1792", "cc-art-1997", "cdc-art-6", "cdc-art-42", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-cancelar-sem-multa-servico-ruim": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("res-anatel-717-2019-rqual", "anatel-rqual", "cdc-art-20", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-cancelar-um-servico-do-combo": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("anatel-oferta-contratacao", "cdc-art-30", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-fidelidade-renovada-sem-consentimento": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("acordao-anatel-389-2024", "cdc-art-46", "cdc-art-51", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-mudanca-endereco-sem-cobertura-multa": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("res-anatel-777-2025-rgst", "cdc-art-30", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-multa-fidelidade-quando-vale": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("anatel-oferta-contratacao", "cdc-art-46", "cdc-art-51", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-operadora-dificulta-cancelamento": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("anatel-cancelamento", "decreto-11034-2022-sac", "cdc-art-39", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-plano-antigo-descontinuado": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("acordao-anatel-389-2024", "cdc-art-46", "cdc-art-51", "lgt-art-3", "lgt-art-5",),
    ),
    "tel-suspensao-temporaria-linha": (
        "data/editorial/portfolio_v2/telecom_energia.jsonl",
        ("anatel-suspensao", "cdc-art-6", "cdc-art-51", "lgt-art-3", "lgt-art-5",),
    ),
}


def chaves_do_catalogo():
    dados = json.loads(CATALOGO.read_text(encoding="utf-8"))
    entradas = dados.get("source_hints", dados)
    if not isinstance(entradas, dict):
        raise SystemExit("catalogo de dicas nao e objeto")
    return set(entradas)


def main(argv):
    verificar = "--verificar" in argv
    catalogo = chaves_do_catalogo()

    por_arquivo = {}
    for intent, (rel, dicas) in EXIGIDAS.items():
        por_arquivo.setdefault(rel, {})[intent] = dicas

    pendentes = 0
    for rel, alvos in sorted(por_arquivo.items()):
        caminho = RAIZ / rel
        linhas = caminho.read_text(encoding="utf-8").splitlines()
        vistos = set()
        mudou = False
        for indice, linha in enumerate(linhas):
            if not linha.strip():
                continue
            registro = json.loads(linha)
            intent = registro.get("intent_id")
            if intent not in alvos:
                continue
            vistos.add(intent)
            atuais = list(registro.get("source_hints") or [])
            novas = [d for d in alvos[intent] if d not in atuais]
            if not novas:
                continue
            # A conferencia e sobre o que se ACRESCENTA, nao sobre o que ja
            # esta la. Medido em 2026-08-30, o portfolio usa 5.928 dicas
            # distintas e 2.304 delas nao sao chave do catalogo — muitas sao
            # rotulo de fonte ("Policia Federal", "meu.inss.gov.br"), nao
            # identificador resolvivel. Reprovar por causa delas travaria a
            # correcao de intencoes que nada tem a ver com o problema. O que
            # esta ferramenta NAO pode fazer e introduzir uma dica nova que nao
            # resolve: essa some do espelho em ops/relaunch-writing.sh e derruba
            # o lote no emit-clean, em silencio.
            fora = [d for d in novas if d not in catalogo]
            if fora:
                print(f"REPROVADO {intent}: dica nova fora do catalogo, nada "
                      f"foi escrito neste arquivo: {', '.join(fora)}")
                return 1
            pendentes += 1
            if verificar:
                print(f"PENDENTE {intent}: falta {', '.join(novas)}")
                continue
            registro["source_hints"] = atuais + novas
            linhas[indice] = json.dumps(registro, ensure_ascii=False,
                                        separators=(", ", ": "))
            mudou = True
            print(f"acrescentado a {intent}: {', '.join(novas)} "
                  f"(dicas {len(atuais)} -> {len(registro['source_hints'])})")
        ausentes = sorted(set(alvos) - vistos)
        if ausentes:
            print(f"REPROVADO: intencao ausente de {rel}: "
                  + ", ".join(ausentes))
            return 1
        if mudou:
            caminho.write_text("\n".join(linhas) + "\n", encoding="utf-8")
    if verificar:
        print(f"{pendentes} intencao(oes) sem a dica especifica")
        return 1 if pendentes else 0
    if not pendentes:
        print("inalterado: as duas intencoes ja citam a dica especifica")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
