#!/usr/bin/env bash
# recuperar-do-autosave — lista ou restaura o conteudo que o hook de snapshot
# guardou ANTES de uma escrita.
#
# O hook ~/.claude/hooks/snapshot-antes-de-escrever.py copia todo arquivo
# rastreado com mais de 200 linhas para .agents/runtime/autosave/ antes de
# qualquer escrita. Isto aqui e o lado da leitura.
#
#   ./tools/recuperar-do-autosave                       lista o que ha
#   ./tools/recuperar-do-autosave <caminho>             mostra as versoes daquele arquivo
#   ./tools/recuperar-do-autosave <caminho> --ultima    imprime a ultima versao no stdout
#
# NUNCA sobrescreve nada por conta propria: imprime, e quem decide e voce
# (`./tools/recuperar-do-autosave x --ultima > x`). Ferramenta de recuperacao
# que restaura sozinha e a proxima forma de perder trabalho.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$ROOT/.agents/runtime/autosave"
[ -d "$DIR" ] || {
	echo "sem autosave ainda: $DIR" >&2
	exit 1
}
if [ $# -eq 0 ]; then
	printf '%-70s %8s  %s\n' ARQUIVO LINHAS QUANDO
	for f in "$DIR"/*.antes; do
		[ -f "$f" ] || continue
		b="$(basename "$f")"
		orig="${b%%.2026*}"
		orig="${orig//__//}"
		quando="$(echo "$b" | grep -oE '2026[0-9]{4}T[0-9]{6}')"
		printf '%-70s %8s  %s\n' "$orig" "$(wc -l <"$f")" "$quando"
	done | sort -u
	exit 0
fi
ALVO="${1#./}"
CHAVE="${ALVO//\//__}"
shift || true
mapfile -t VERSOES < <(ls -1t "$DIR/$CHAVE".*.antes 2>/dev/null)
[ ${#VERSOES[@]} -gt 0 ] || {
	echo "nenhum snapshot de $ALVO" >&2
	exit 1
}
if [ "${1:-}" = "--ultima" ]; then
	cat "${VERSOES[0]}"
	exit 0
fi
echo "snapshots de $ALVO (mais recente primeiro):"
for v in "${VERSOES[@]}"; do printf '  %8s linhas  %s\n' "$(wc -l <"$v")" "$v"; done
echo
echo "para restaurar:  ./tools/recuperar-do-autosave $ALVO --ultima > $ALVO"
