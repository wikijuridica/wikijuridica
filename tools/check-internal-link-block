#!/usr/bin/env python3
"""check-internal-link-block — o bloco de links que vai AO AR, medido no disco.

POR QUE ELE EXISTE. Até 2026-08-29 nenhum gate media o bloco final de
"Conteúdos relacionados". Os quatro `meshGate*` de internal/checks auditam o
ARTEFATO (internal/internallinkmesh), que cobre 6.282 das 10.116 páginas com
bloco — e o que o bot recebe é a UNIÃO do artefato com a malha base, resolvida
no publicador. Foi por essa fresta que passaram, vivos no disco:

    13 grupos de bloco byte-idêntico (26 páginas), todos da MESMA área — que é
       exatamente o que internallinkmesh.DetectIdenticalBlocks reprova a partir
       de DUAS páginas, e que ele não vê porque essas rotas (diarios,
       jurisprudencia, noticias) estão fora do artefato;
    28 âncoras prometendo um título e o destino entregando outro.

DUAS RÉGUAS, E A DIFERENÇA IMPORTA.

  ABSOLUTAS — invariantes que o acervo cumpre HOJE com folga (medido: zero de
  cada). Autolink, destino inexistente, âncora vazia e destino repetido no mesmo
  bloco não são "pouco frequentes": são zero, e qualquer aparição é defeito novo.
  Aqui o gate reprova no primeiro caso.

  NO-WORSE — invariantes que o acervo AINDA NÃO cumpre. Um gate absoluto sobre
  elas nasceria vermelho e travaria a fábrica por um defeito que já estava lá,
  que é o oposto de proteger. Estas são comparadas com a baseline versionada em
  data/ops/link_graph_baseline.jsonl: piorar reprova, empatar passa, melhorar
  atualiza a régua (com --atualizar-baseline).

Read-only (contrato tools/check-*): não escreve nada sem --atualizar-baseline,
que é explícito e nomeado.

Saída 0 = dentro das duas réguas; 1 = fora; 2 = erro de uso.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import sys

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MEDIDOR = os.path.join(RAIZ, "tools", "measure-link-graph")
BASELINE = os.path.join(RAIZ, "data", "ops", "link_graph_baseline.jsonl")

# Teto de bytes do bloco final, RECALIBRADO junto com a subida do teto de links
# de 6 para 8 (content.MaxRelatedLinksPerPage).
#
# Medido a teto 6: média 840, p95 942, máximo 1.058 — ou seja ~141 B por link.
# A teto 8 o máximo esperado é 1.058 + 2×141 = 1.340, e o teto fica em 1.800,
# com folga de ~1/3 sobre isso.
#
# POR QUE A RECALIBRAÇÃO ENTRA NO MESMO COMMIT DA SUBIDA DO TETO: sem ela o gate
# reprovaria a melhora planejada, que é o pior tipo de gate — o que trava
# exatamente o trabalho que ele existe para proteger.
#
# NÃO CONFUNDIR com meshGateMaxBlockBytes (700), de
# internal/checks/internal_link_mesh_gate.go: aquele vale para o bloco do
# ARTEFATO, de até 3 links, e é outro escopo.
#
# ATENÇÃO ao ler este número contra o disco: `public/` só passa a ter 8 links na
# PRÓXIMA publicação. Até lá a medição continua acusando o máximo de 6 links
# (1.058 B), e é por isso que a baseline no-worse NÃO deve ser atualizada agora
# — ela gravaria a régua do acervo velho.
TETO_BLOCO_BYTES = 1800

# Teto do contrato de indexação. internal/htmlcontract.HTMLBudgetBytes = 50000.
TETO_PAGINA_BYTES = 50000

# O teto EDITORIAL de links por página vem do Go, lido do arquivo, nunca
# duplicado aqui. Duplicá-lo faria este gate medir contra 8 no dia em que o
# render passasse a 10 — e a projeção abaixo, que é a única defesa ANTES da
# publicação, passaria a mentir em silêncio.
TETO_LINKS_GO = os.path.join(RAIZ, "internal/content/relatedmerge.go")

# Markup por item do bloco, em bytes, SEM contar rota e âncora. Ajustado contra
# o disco: o resíduo `bloco_bytes - Σ(len(rota)+len(âncora))` sobe em degraus
# exatos de 24 B por link (156 com 1, 228 com 4, 252 com 5, 276 com 6 links),
# com 132 B de overhead fixo do bloco. Não é estimativa — é o coeficiente medido.
MARKUP_POR_ITEM_BYTES = 24


def teto_editorial_de_links() -> int:
    with open(TETO_LINKS_GO, encoding="utf-8") as fh:
        casou = re.search(r"MaxRelatedLinksPerPage\s*=\s*(\d+)", fh.read())
    if not casou:
        raise falha(f"não achei MaxRelatedLinksPerPage em {TETO_LINKS_GO} — "
                    f"a projeção de bytes ficaria sem régua")
    return int(casou.group(1))


def falha(msg: str) -> SystemExit:
    print(f"check-internal-link-block: {msg}", file=sys.stderr)
    return SystemExit(2)


def carrega_medidor():
    """Reusa tools/measure-link-graph em vez de reimplementar a varredura.

    Duas varreduras do mesmo disco com regras ligeiramente diferentes é como o
    número do gate deixa de bater com o número do relatório — e aí ninguém sabe
    qual dos dois mente.
    """
    spec = importlib.util.spec_from_loader(
        "measure_link_graph",
        importlib.machinery.SourceFileLoader("measure_link_graph", MEDIDOR),
    )
    modulo = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modulo)
    return modulo


def mede(modulo) -> dict:
    paginas, sem_bloco = modulo.varre_acervo()
    if not paginas:
        raise falha("nenhum index.html em public/ — nada publicado para medir")
    malha = {r: d["destinos"] for r, d in paginas.items() if d["destinos"]}
    titulos = modulo.carrega_titulos_do_manifesto()

    arestas = {(o, d) for o, ds in malha.items() for d in ds}
    entrada = {}
    for origem, destinos in malha.items():
        for destino in set(destinos):
            entrada[destino] = entrada.get(destino, 0) + 1

    absolutos = {"autolink": 0, "destino_inexistente": 0, "ancora_vazia": 0,
                 "destino_repetido_no_bloco": 0}
    exemplos: dict[str, list[str]] = {k: [] for k in absolutos}
    ancoras_divergentes = 0
    exemplos_ancora: list[str] = []
    for rota, dados in paginas.items():
        vistos = set()
        for destino, ancora in zip(dados["destinos"], dados["ancoras"]):
            def anota(chave: str, detalhe: str) -> None:
                absolutos[chave] += 1
                if len(exemplos[chave]) < 5:
                    exemplos[chave].append(detalhe)

            if destino == rota:
                anota("autolink", rota)
            if destino not in paginas:
                anota("destino_inexistente", f"{rota} -> {destino}")
            if not ancora:
                anota("ancora_vazia", f"{rota} -> {destino}")
            if destino in vistos:
                anota("destino_repetido_no_bloco", f"{rota} -> {destino}")
            vistos.add(destino)

            esperado = titulos.get(destino)
            if esperado and ancora != esperado:
                ancoras_divergentes += 1
                if len(exemplos_ancora) < 5:
                    exemplos_ancora.append(
                        f"{rota} -> {destino}: âncora {ancora!r} != manifesto {esperado!r}")

    # A IDENTIDADE DO BLOCO É MEDIDA SEM O CHROME INSTITUCIONAL, e isso não é
    # tolerância: desde 2026-09-05 o chrome carrega o espelho de caminho
    # /redesocial/tema/{área}/{slug}/, que difere em cada uma das 10.141 rotas.
    # Agrupar pelo hash do bloco INTEIRO devolveria zero grupo para sempre — não
    # por ausência de molde, mas porque cada bloco virou único por construção. O
    # mesmo defeito atingiu quatro detectores de uma vez; a correção deles está em
    # internal/render.BlocoDaMalhaSemChrome, e aqui em measure-link-graph.CHROME.
    por_hash: dict[str, list[str]] = {}
    for rota, dados in paginas.items():
        if dados["bloco_malha_sha256"]:
            por_hash.setdefault(dados["bloco_malha_sha256"], []).append(rota)
    grupos_identicos = {h: r for h, r in por_hash.items() if len(r) > 1}

    doorway_pares, doorway_paginas, doorway_ex = modulo.pares_doorway(malha)

    area = modulo.area_de
    sem_ponte = [r for r, ds in malha.items() if all(area(x) == area(r) for x in ds)]

    bloco_bytes = [d["bloco_bytes"] for d in paginas.values() if d["bloco_bytes"]]
    pagina_bytes = [d["pagina_bytes"] for d in paginas.values()]

    return {
        "paginas_com_bloco": len(malha),
        "arestas": len(arestas),
        "absolutos": absolutos,
        "exemplos_absolutos": exemplos,
        "grupos_byte_identicos": len(grupos_identicos),
        "paginas_em_grupo_identico": sum(len(v) for v in grupos_identicos.values()),
        "exemplo_grupo_identico": sorted(next(iter(grupos_identicos.values()), [])),
        "ancoras_divergentes": ancoras_divergentes,
        "exemplos_ancora": exemplos_ancora,
        "doorway_pares": doorway_pares,
        "doorway_paginas": doorway_paginas,
        "exemplo_doorway": doorway_ex[:3],
        "paginas_sem_ponte_cross_area": len(sem_ponte),
        # A LISTA EXISTIA E ERA DESCARTADA, e é por isso que este campo nasceu
        # em 2026-09-11: a comparação com a baseline passava `[]` como amostra
        # para esta linha e SÓ para esta linha, então o gate reprovava com
        # "PIOROU: 23 -> 160" sem nomear uma página sequer. Falha fechada que não
        # diz a causa transfere ao leitor o custo do diagnóstico — e quem lê
        # decide pelo rótulo. As outras três comparações já traziam exemplo.
        #
        # Ordenado e cortado em 5, como `exemplo_doorway`: amostra para orientar
        # a investigação, nunca a lista inteira num stderr de gate.
        "exemplo_sem_ponte": sorted(sem_ponte)[:5],
        "orfas": sum(1 for r in malha if entrada.get(r, 0) == 0),
        "bloco_bytes_max": max(bloco_bytes) if bloco_bytes else 0,
        "pagina_bytes_max": max(pagina_bytes) if pagina_bytes else 0,
        "paginas_acima_do_teto": sum(1 for b in pagina_bytes if b > TETO_PAGINA_BYTES),
        **projecao_no_teto_editorial(paginas),
    }


def projecao_no_teto_editorial(paginas: dict) -> dict:
    """Quanto o pior bloco pesaria se todas as páginas chegassem ao teto editorial.

    POR QUE PROJETAR, em vez de só medir o disco. O gate mede `public/`, que é o
    acervo JÁ publicado — e o disco só ganha o teto novo na PRÓXIMA publicação.
    Medido em 2026-08-29, com o teto já em 8 no código: 10.091 das 10.116 páginas
    servidas ainda tinham exatamente 6 links. Um gate que só olha o disco aprova
    hoje e reprova depois de publicar, que é tarde: o acervo já estaria no ar.

    O MODELO É LINEAR E FOI AJUSTADO CONTRA O DISCO, não estimado. Medindo o
    resíduo `bloco_bytes - Σ(len(rota) + len(âncora))` por número de links, ele
    cai exatamente em 132 B fixos + 24 B por item (156 com 1 link, 228 com 4,
    252 com 5, 276 com 6 — degraus de 24 B, sem dispersão). O pior item real do
    acervo pesa 152 B de rota + âncora, então cada link novo custa no máximo
    176 B.

    Projeção medida em 2026-08-29: bloco 1.456 B contra teto de 1.800, página
    43.304 B contra teto de 50.000. Subir de 6 para 8 cabe, com folga de 344 B
    no bloco e 6,7 KB na página.

    O 1.456 é maior que os 1.058+2x176=1.410 do bloco mais pesado porque a conta
    é POR PÁGINA: 21 páginas ainda estão com 5 links e 3 com 4, e essas têm mais
    de duas vagas para encher. A projeção usa as vagas de cada uma, não a média.
    """
    teto = teto_editorial_de_links()
    pior_item = 0
    for dados in paginas.values():
        for rota, ancora in zip(dados["destinos"], dados["ancoras"]):
            pior_item = max(pior_item, len(rota.encode("utf-8")) + len(ancora.encode("utf-8")))
    custo = MARKUP_POR_ITEM_BYTES + pior_item

    pior_bloco = 0
    pior_pagina = 0
    for dados in paginas.values():
        faltam = teto - len(dados["destinos"])
        if faltam <= 0:
            faltam = 0
        pior_bloco = max(pior_bloco, dados["bloco_bytes"] + faltam * custo)
        pior_pagina = max(pior_pagina, dados["pagina_bytes"] + faltam * custo)
    return {
        "teto_editorial_de_links": teto,
        "custo_do_pior_link_bytes": custo,
        "projecao_bloco_bytes_no_teto": pior_bloco,
        "projecao_pagina_bytes_no_teto": pior_pagina,
    }


def le_baseline() -> dict | None:
    if not os.path.isfile(BASELINE):
        return None
    with open(BASELINE, encoding="utf-8") as fh:
        for linha in fh:
            linha = linha.strip()
            if linha:
                return json.loads(linha)
    return None


def avalia(atual: dict, base: dict | None) -> list[str]:
    """As duas réguas, separadas da medição para que o teste as exercite sem
    tocar o disco nem a baseline versionada.

    Devolve a lista de problemas; vazia = aprovado.
    """
    problemas: list[str] = []

    # --- régua ABSOLUTA -------------------------------------------------
    for chave, quantos in atual["absolutos"].items():
        if quantos:
            amostra = "; ".join(atual["exemplos_absolutos"][chave])
            problemas.append(f"{chave}: {quantos} ocorrência(s) — {amostra}")

    if atual["orfas"]:
        problemas.append(f"páginas órfãs de malha: {atual['orfas']} (o piso de "
                         f"entradas do publicador deveria impedir isto)")

    if atual["bloco_bytes_max"] > TETO_BLOCO_BYTES:
        problemas.append(f"bloco de {atual['bloco_bytes_max']} B acima do teto "
                         f"{TETO_BLOCO_BYTES} B")

    projecao_bloco = atual.get("projecao_bloco_bytes_no_teto", 0)
    if projecao_bloco > TETO_BLOCO_BYTES:
        problemas.append(
            f"a teto editorial de {atual.get('teto_editorial_de_links')} links o pior "
            f"bloco chegaria a {projecao_bloco} B, acima de {TETO_BLOCO_BYTES} B — "
            f"o disco ainda não mostra isso porque o teto novo só vale na próxima "
            f"publicação, e depois dela seria tarde")

    projecao_pagina = atual.get("projecao_pagina_bytes_no_teto", 0)
    if projecao_pagina > TETO_PAGINA_BYTES:
        problemas.append(
            f"a teto editorial de {atual.get('teto_editorial_de_links')} links a pior "
            f"página chegaria a {projecao_pagina} B, acima do teto de "
            f"{TETO_PAGINA_BYTES} B do contrato de indexação")

    if atual["paginas_acima_do_teto"]:
        problemas.append(f"{atual['paginas_acima_do_teto']} página(s) acima do teto "
                         f"de {TETO_PAGINA_BYTES} B do contrato de indexação "
                         f"(maior: {atual['pagina_bytes_max']} B)")

    # --- régua NO-WORSE -------------------------------------------------
    if base is None:
        problemas.append("baseline ausente em data/ops/link_graph_baseline.jsonl — "
                         "rode tools/measure-link-graph --gravar-baseline")
    else:
        comparacoes = [
            ("grupos de bloco byte-idêntico", atual["grupos_byte_identicos"],
             base["blocos_byte_identicos"]["grupos"], atual["exemplo_grupo_identico"]),
            ("âncoras divergentes do manifesto", atual["ancoras_divergentes"],
             base["ancoras"]["divergentes_do_manifesto"], atual["exemplos_ancora"]),
            ("pares de doorway (Jaccard > 0,50, mesma área)", atual["doorway_pares"],
             base["doorway"]["pares_mesma_area_acima_do_limiar"], atual["exemplo_doorway"]),
            ("páginas sem ponte cross-área", atual["paginas_sem_ponte_cross_area"],
             base["cross_area"]["paginas_sem_nenhuma_ponte"], atual["exemplo_sem_ponte"]),
        ]
        for rotulo, agora, antes, amostra in comparacoes:
            if agora > antes:
                detalhe = f" — exemplo: {amostra}" if amostra else ""
                problemas.append(f"{rotulo} PIOROU: {antes} -> {agora}{detalhe}")

    return problemas


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--atualizar-baseline", action="store_true",
                    help="grava a medição atual como nova régua no-worse; só faz "
                         "sentido quando a medição MELHOROU e a melhora foi "
                         "verificada")
    args = ap.parse_args()

    modulo = carrega_medidor()
    atual = mede(modulo)
    problemas = avalia(atual, le_baseline())


    print(f"check-internal-link-block: paginas={atual['paginas_com_bloco']} "
          f"arestas={atual['arestas']} identicos={atual['grupos_byte_identicos']} "
          f"ancoras_divergentes={atual['ancoras_divergentes']} "
          f"doorway={atual['doorway_pares']} sem_ponte={atual['paginas_sem_ponte_cross_area']} "
          f"bloco_max={atual['bloco_bytes_max']}B pagina_max={atual['pagina_bytes_max']}B "
          f"projecao_teto{atual['teto_editorial_de_links']}="
          f"{atual['projecao_bloco_bytes_no_teto']}B/"
          f"{atual['projecao_pagina_bytes_no_teto']}B")

    if args.atualizar_baseline and not problemas:
        os.makedirs(os.path.dirname(BASELINE), exist_ok=True)
        medicao = json.loads(json.dumps(
            modulo_medicao_completa(modulo), ensure_ascii=False))
        with open(BASELINE, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(medicao, ensure_ascii=False, sort_keys=True) + "\n")
        print(f"baseline atualizada em {os.path.relpath(BASELINE, RAIZ)}",
              file=sys.stderr)

    if problemas:
        for p in problemas:
            print(f"check-internal-link-block: {p}", file=sys.stderr)
        return 1
    return 0


def modulo_medicao_completa(modulo) -> dict:
    """Delega ao medidor para que a baseline tenha exatamente o mesmo schema que
    tools/measure-link-graph --gravar-baseline produz.

    `--amostras` NAO E OPCIONAL AQUI. Sem ele a baseline sai sem a chave
    `amostras`, e a primeira atualizacao apagaria em silencio os exemplos que
    NOMEIAM as paginas em falta — os pares de bloco byte-identico, as ancoras
    divergentes, os pares de doorway. Uma regua que so tem numeros diz que
    piorou; uma que tem exemplos diz ONDE. Descoberto ao executar este caminho
    pela primeira vez, que ate entao nunca tinha rodado.
    """
    import subprocess
    saida = subprocess.run([sys.executable, MEDIDOR, "--amostras", "3"],
                           cwd=RAIZ, capture_output=True, timeout=300, check=True)
    return json.loads(saida.stdout.decode("utf-8"))


if __name__ == "__main__":
    sys.exit(main())
