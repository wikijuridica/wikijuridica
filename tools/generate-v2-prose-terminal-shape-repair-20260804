# Conectores atonos que NAO podem fechar frase nova (espelho da lista terminal
# de internal/ptbrtext.publicTextTerminalConnector, minusculas).
TERMINAL_CONNECTORS = {
    "a", "as", "ao", "aos", "até", "à", "às", "com", "contra", "da", "das",
    "de", "do", "dos", "e", "em", "na", "nas", "no", "nos", "ou", "para",
    "pela", "pelas", "pelo", "pelos", "por", "sem", "sob", "sobre", "que",
    "quando",
}


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def terminal_word(sentence: str) -> str:
    tokens = re.findall(r"[0-9A-Za-zÀ-ÖØ-öø-ÿ]+", sentence)
    return tokens[-1].lower() if tokens else ""


def preflight() -> None:
    problems: list[str] = []
    for intent, (_shard, _digest, _field, before, after) in sorted(REPAIRS.items()):
        if before == after:
            problems.append(f"{intent}: texto novo identico ao atual")
        if terminal_word(after) in TERMINAL_CONNECTORS:
            problems.append(
                f"{intent}: texto novo ainda termina em conector atono ({terminal_word(after)!r})"
            )
    if problems:
        for problem in problems:
            print(f"PREFLIGHT FALHOU: {problem}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(REPAIRS)} frase(s), nenhuma termina em conector atono")


def word_count(record: dict) -> int:
    """Reproduz `bodyWordCount` de internal/v2ingest/validate.go:984.

    Abertura + HEADING E TEXTO de cada secao + Q e A de cada item de FAQ,
    tokenizando sobre o texto com acentos removidos (`normalizedWords`, :997).
    Formula mais simples produz `declared_word_count_incoherent` e a pagina
    some do estoque (tolerancia de 10% — precedente de 2026-08-04 no gerador
    OAB).
    """
    total = _words(record.get("opening"))
    for section in record.get("sections") or []:
        total += _words(section.get("heading"))
        total += _words(section.get("text"))
    for item in record.get("faq") or []:
        total += _words(item.get("q"))
        total += _words(item.get("a"))
    return total


def _words(value: str | None) -> int:
    if not value:
        return 0
    folded = unicodedata.normalize("NFKD", value)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    return len([token for token in re.split(r"[^0-9A-Za-z]+", folded) if token])


def field_haystack(record: dict, field: str) -> str:
    if field == "sections":
        return json.dumps(record.get("sections"), ensure_ascii=False)
    return record.get(field) or ""


def apply_excerpt(record: dict, field: str, before: str, after: str) -> None:
    if field == "sections":
        for section in record["sections"]:
            if before in section["text"]:
                section["text"] = section["text"].replace(before, after)
        return
    record[field] = record[field].replace(before, after)


def count_hits(record: dict, field: str, excerpt: str) -> int:
    if field == "sections":
        return sum(1 for section in record["sections"] if excerpt in section["text"])
    return 1 if excerpt in (record.get(field) or "") else 0


def apply_repair(intent: str, shard: str, digest: str, field: str, before: str, after: str) -> int:
    path = ROOT / shard
    lines = path.read_bytes().decode("utf-8").split("\n")
    trailing_newline = lines and lines[-1] == ""
    if trailing_newline:
        lines = lines[:-1]

    output: list[str] = []
    changed = 0
    already = 0
    for number, raw in enumerate(lines, 1):
        if not raw.strip():
            raise SystemExit(f"{shard}: linha em branco {number}")
        record = json.loads(raw)
        if record.get("intent_id") != intent:
            output.append(raw)
            continue

        if after in field_haystack(record, field):
            # Ja aplicado. Ainda assim confere o word_count declarado
            # (idempotencia que repara o proprio estrago anterior, mesmo
            # racional do gerador OAB 20260805).
            expected = word_count(record)
            if record.get("word_count") != expected:
                record["word_count"] = expected
                output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
                changed += 1
                print(f"  word_count corrigido: {record.get('intent_id')} -> {expected}")
                continue
            already += 1
            output.append(raw)
            continue

        current = hashlib.sha256(raw.strip().encode("utf-8")).hexdigest()
        if current != digest:
            raise SystemExit(
                f"CAS FALHOU em {shard}:{number} ({intent}): linha atual nao e a esperada.\n"
                f"  esperado: {digest}\n  atual:    {current}\n"
                "Outra frente tocou este registro. Reler o conteudo vivo antes de reaplicar."
            )

        hits = count_hits(record, field, before)
        if hits != 1:
            raise SystemExit(
                f"{shard}:{number} ({intent}): trecho esperado aparece {hits}x no campo {field} "
                "(deveria ser 1). Abortado sem escrever."
            )
        apply_excerpt(record, field, before, after)
        if field == "meta_description":
            meta_length = len(record.get("meta_description") or "")
            if not 70 <= meta_length <= 160:
                raise SystemExit(
                    f"{shard}:{number} ({intent}): meta_description reescrita com {meta_length} "
                    "caracteres, fora do contrato SEO 70-160. Abortado sem escrever."
                )
        record["word_count"] = word_count(record)
        output.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
        changed += 1

    if changed == 0 and already == 0:
        raise SystemExit(f"{shard}: intent {intent} nao encontrado")

    if changed:
        payload = "\n".join(output)
        if trailing_newline:
            payload += "\n"
        atomic_write(path, payload.encode("utf-8"))

    print(f"{shard} ({intent}): reescritos={changed} ja_aplicados={already}")
    return changed


def main() -> int:
    preflight()
    total = 0
    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for intent, (shard, digest, field, before, after) in sorted(REPAIRS.items()):
                    total += apply_repair(intent, shard, digest, field, before, after)
    except StockEpochBusy as error:
        print(
            f"generate-v2-prose-terminal-shape-repair-20260804: estoque ocupado: {error}",
            file=sys.stderr,
        )
        return 75
    if total:
        print("OK. Reingerir o estoque e regenerar a cadeia (passos 12-13) para refletir a correcao.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
