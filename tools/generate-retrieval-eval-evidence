#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export WIKI_REPO_AWARENESS_TIMEOUT="${WIKI_REPO_AWARENESS_TIMEOUT:-30s}"
export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_RETRIEVAL_EVAL_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/retrieval-eval-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-retrieval-eval-venv"
if [[ -n "${WIKI_RETRIEVAL_EVAL_VENV:-}" ]]; then
	VENV="$WIKI_RETRIEVAL_EVAL_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"

emit_python_artifact_claim() {
	local path="$1"
	local input="$2"
	local expected="$3"
	printf 'generate-retrieval-eval-evidence: artifact_claim path=%s producer=tools/generate-retrieval-eval-evidence input_fingerprint=sha256:%s output_fingerprint_expected=%s lock_scope=artifact:%s budget_ms=300000 stop_condition=retrieval_eval_python_environment_ready\n' \
		"$path" "$input" "$expected" "$path" >&2
}

if [[ ! -x "$PY" ]]; then
	emit_python_artifact_claim "$VENV" "$(printf '%s' "$VENV" | sha256sum | awk '{print $1}')" "created_or_reused:$VENV"
	python3 -m venv "$VENV"
fi
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-retrieval-eval.txt" | awk '{print $1}')"
MARKER="$VENV/.requirements-retrieval-eval-$REQ_HASH.ok"
if [[ ! -f "$MARKER" ]]; then
	emit_python_artifact_claim "$MARKER" "$REQ_HASH" "sha256:$REQ_HASH"
	# PIP_USER=0 e obrigatorio: ~/.config/pip/pip.conf desta maquina declara
	# `user = true` como padrao, e dentro de um venv o pip recusa com
	# "Can not perform a '--user' install. User site-packages are not
	# visible in this virtualenv." Instalar no user-site NUNCA e o que um
	# venv pinado quer — a variavel afirma a intencao, nao contorna a
	# configuracao do dono. Medido em 2026-09-10: os 15 wrappers que criam
	# venv falhavam por isso, e 3 venvs estavam sem provisionar em silencio.
	PIP_USER=0 "$PY" -m pip install --disable-pip-version-check -r "$ROOT/tools/requirements-retrieval-eval.txt" >/dev/null
	rm -f "$VENV"/.requirements-retrieval-eval-*.ok
	touch "$MARKER"
fi
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:retrieval-eval-evidence:gocache:$GOCACHE}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-300000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-150000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=80}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-retrieval_eval_evidence_written_or_validation_failed_no_publication}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/retrieval_eval_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-retrieval-eval-evidence}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/retrieval_eval_evidence.jsonl}"
WIKI_RETRIEVAL_EVAL_PYTHON="$PY" exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-retrieval-eval-evidence --timings "$@"
