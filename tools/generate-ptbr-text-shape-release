#!/usr/bin/env bash
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
PATH="$ROOT/tools:$PATH"
export PATH
set -euo pipefail

for arg in "$@"; do
	case "$arg" in
	-h | --help)
		cat <<'EOF'
usage: generate-ptbr-text-shape-release [flags]

Runs cmd/generate-ptbr-text-shape-release through the cached P0 runner.
EOF
		exit 0
		;;
	esac
done

export GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
ARTIFACT_LOCK_FILE="${WIKI_PTBR_TEXT_SHAPE_RELEASE_ARTIFACT_LOCK:-/tmp/opt-wiki-ptbr-text-shape-release-artifact.lock}"
ARTIFACT_LOCK_WAIT_SECONDS="${WIKI_PTBR_TEXT_SHAPE_RELEASE_ARTIFACT_LOCK_WAIT_SECONDS:-300}"
cd "$ROOT"

case "$ARTIFACT_LOCK_WAIT_SECONDS" in
'' | *[!0-9]*)
	echo "generate-ptbr-text-shape-release: WIKI_PTBR_TEXT_SHAPE_RELEASE_ARTIFACT_LOCK_WAIT_SECONDS must be numeric seconds" >&2
	exit 2
	;;
esac
if [[ "$ARTIFACT_LOCK_WAIT_SECONDS" -le 0 ]]; then
	echo "generate-ptbr-text-shape-release: WIKI_PTBR_TEXT_SHAPE_RELEASE_ARTIFACT_LOCK_WAIT_SECONDS must be a positive integer seconds" >&2
	exit 2
fi
if ! command -v flock >/dev/null 2>&1; then
	echo "generate-ptbr-text-shape-release: flock command is required for evidence artifact lock" >&2
	exit 75
fi
export WIKI_HEAVY_LOCK_SCOPE="${WIKI_HEAVY_LOCK_SCOPE:-generate:ptbr-text-shape-release:gocache:${GOCACHE:-$HOME/.cache/go-build}}"
export WIKI_HEAVY_BUDGET_MS="${WIKI_HEAVY_BUDGET_MS:-60000}"
export WIKI_HEAVY_EXPECTED_DURATION_MS="${WIKI_HEAVY_EXPECTED_DURATION_MS:-30000}"
export WIKI_HEAVY_THROUGHPUT_EXPECTED="${WIKI_HEAVY_THROUGHPUT_EXPECTED:-records_per_second=20}"
export WIKI_HEAVY_STOP_CONDITION="${WIKI_HEAVY_STOP_CONDITION:-completed_or_failed_with_timings_and_artifact_status}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PATH="${WIKI_HEAVY_ARTIFACT_CLAIM_PATH:-data/ops/ptbr_text_shape_release_evidence.jsonl}"
export WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER="${WIKI_HEAVY_ARTIFACT_CLAIM_PRODUCER:-tools/generate-ptbr-text-shape-release}"
export WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED="${WIKI_HEAVY_ARTIFACT_OUTPUT_FINGERPRINT_EXPECTED:-updated_or_stable:data/ops/ptbr_text_shape_release_evidence.jsonl}"
export WIKI_HEAVY_TIMEOUT_SECONDS="${WIKI_HEAVY_TIMEOUT_SECONDS:-420}"
. "$ROOT/tools/p0-factory-chain-lock.sh"
p0_factory_chain_lock_acquire "$(basename "$0")" "$@"
exec 9>"$ARTIFACT_LOCK_FILE"
if ! flock -w "$ARTIFACT_LOCK_WAIT_SECONDS" 9; then
	echo "generate-ptbr-text-shape-release: artifact lock blocked after ${ARTIFACT_LOCK_WAIT_SECONDS}s: $ARTIFACT_LOCK_FILE" >&2
	exit 75
fi
exec "$ROOT/tools/run-heavy-throttled" "$ROOT/tools/run-go-cmd-cached" ./cmd/generate-ptbr-text-shape-release --timings "$@"
