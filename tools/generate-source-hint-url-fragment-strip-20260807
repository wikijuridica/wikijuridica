#!/usr/bin/env python3
"""generate-source-hint-url-fragment-strip-20260807 — âncora de artigo não identifica documento.

O DEFEITO. 20 entradas de `data/editorial/v2_source_hint_catalog.json` apontam
para URL do Planalto com fragmento de artigo:

    https://www.planalto.gov.br/ccivil_03/leis/2002/l10406.htm#art1240a

`canonical_official_source` (ops/relaunch-writing.sh:248) exige `not
parsed.fragment`, e está certa: fragmento é navegação dentro da página, não
identidade do documento — o servidor nem o recebe. Enquanto essas 20 entradas
existirem, os lotes que dependem delas são excluídos da fila de escrita.

POR QUE REMOVER NÃO PERDE NADA, e foi conferido antes de escrever:
  - o `name` do hint já nomeia o dispositivo ("Código Civil (Lei nº 10.406/2002),
    art. 1.240-A") e o `anchor_claim` também;
  - as 20 URLs-base já aparecem em OUTROS hints do mesmo catálogo, sem
    fragmento — inclusive `cpc-2015-art-319`, que segue a convenção correta.
    Ou seja: sem fragmento é a regra do catálogo, e estas 20 é que destoavam.

O QUE ESTE GERADOR NÃO FAZ: não troca o documento, não inventa URL, não mexe em
entrada que tenha outro defeito. Só remove o fragmento.

Fica de fora, de propósito, `decreto-35851-1954`, cuja URL é
`https://normas.leg.br/?urn=...` — documento em QUERY sobre o path raiz, defeito
diferente, que tem ferramenta própria: `tools/generate-catalog-url-repair`.

CONTRATO DE ESCRITA: lease de época, lock exclusivo, escrita atômica com fsync,
idempotente. NÃO commita.

Uso:
    tools/generate-source-hint-url-fragment-strip-20260807 --dry-run
    tools/generate-source-hint-url-fragment-strip-20260807
"""
from __future__ import annotations

import argparse
import collections
import fcntl
import glob
import json
import os
import re
import sys
import tempfile
from urllib.parse import urlsplit, urlunsplit
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.fspath(ROOT) not in sys.path:
    sys.path.insert(0, os.fspath(ROOT))

from tools.v2_stock_epoch import StockEpochBusy, canonical_stock_write_lease

LOCK = ROOT / "data/editorial/.source-hint-url-fragment-strip-20260807.lock"
CATALOGO = ROOT / "data/editorial/v2_source_hint_catalog.json"
PORTFOLIO = ROOT / "data/editorial/portfolio_v2"

SLUG_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        os.fchmod(fd, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def atomic_write(path: Path, payload: bytes) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)



def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    with open(CATALOGO, encoding="utf-8") as handle:
        catalogo = json.load(handle)
    hints = catalogo["source_hints"]

    alvos = {}
    for chave, valor in hints.items():
        url = valor.get("url") or ""
        partes = urlsplit(url)
        if not partes.fragment:
            continue
        alvos[chave] = urlunsplit(partes._replace(fragment=""))

    if not alvos:
        print("nenhuma URL com fragmento: nada a fazer.")
        return 0

    # Preflight: a URL sem fragmento tem que continuar sendo do mesmo host e
    # path. Remover fragmento nunca deveria mudar isso; se mudar, algo está
    # errado e é melhor abortar do que gravar outra fonte.
    problemas = []
    for chave, nova in sorted(alvos.items()):
        antiga = urlsplit(hints[chave]["url"])
        depois = urlsplit(nova)
        if (antiga.scheme, antiga.netloc, antiga.path, antiga.query) != (
                depois.scheme, depois.netloc, depois.path, depois.query):
            problemas.append(f"{chave}: remover o fragmento mudou o documento")
        if depois.fragment:
            problemas.append(f"{chave}: fragmento sobrou em {nova!r}")
    if problemas:
        for problema in problemas:
            print(f"PREFLIGHT FALHOU: {problema}", file=sys.stderr)
        raise SystemExit(1)
    print(f"preflight ok: {len(alvos)} URLs perdem só o fragmento, "
          f"mesmo host e mesmo path")

    try:
        with canonical_stock_write_lease(ROOT):
            with exclusive_lock(LOCK):
                for chave, nova in sorted(alvos.items()):
                    print(f"  {chave}\n      {hints[chave]['url']}\n   -> {nova}")
                    hints[chave]["url"] = nova
                if not args.dry_run:
                    payload = json.dumps(catalogo, ensure_ascii=False, indent=1,
                                         sort_keys=True) + "\n"
                    atomic_write(CATALOGO, payload.encode("utf-8"))
    except StockEpochBusy as erro:
        print(f"estoque canônico ocupado por outra frente: {erro}", file=sys.stderr)
        return 75

    print(f"\n{len(alvos)} URL(s) sem fragmento." +
          ("  --dry-run: nada escrito." if args.dry_run else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
