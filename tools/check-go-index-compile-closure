# This helper is part of the authenticated Python wrapper rather than a
# mutable worktree executable.  It uses the Go parser/printer (not textual
# matching) to prove the deliberately narrow case in which compiling only the
# changed package cannot hide a source-compatibility break in a dependant.
# Anything it cannot prove returns direct_only=false and keeps the existing
# reverse-dependency closure.
API_SURFACE_HELPER = r'''package main

import (
	"encoding/json"
	"fmt"
	"go/ast"
	"go/format"
	"go/parser"
	"go/token"
	"go/types"
	"os"
	"path/filepath"
	"reflect"
	"sort"
	"strconv"
	"strings"
)

type pair struct {
	Path          string   `json:"path"`
	Before        string   `json:"before"`
	After         string   `json:"after"`
	BeforePackage []string `json:"before_package"`
	AfterPackage  []string `json:"after_package"`
}

type manifest struct {
	Pairs []pair `json:"pairs"`
}

type result struct {
	DirectOnly bool   `json:"direct_only"`
	Reason     string `json:"reason"`
}

type fingerprint struct {
	Package    string
	Imports    []string
	Directives []string
	Public     []string
	Private    []string
	PrivateNames []string
	Generated  bool
	TestFile   bool
}

func render(fset *token.FileSet, node ast.Node) (string, error) {
	var output strings.Builder
	if err := format.Node(&output, fset, node); err != nil {
		return "", err
	}
	return output.String(), nil
}

func stripComments(node ast.Node) {
	ast.Inspect(node, func(current ast.Node) bool {
		switch value := current.(type) {
		case *ast.GenDecl:
			value.Doc = nil
		case *ast.FuncDecl:
			value.Doc = nil
		case *ast.TypeSpec:
			value.Doc = nil
			value.Comment = nil
		case *ast.ValueSpec:
			value.Doc = nil
			value.Comment = nil
		case *ast.Field:
			value.Doc = nil
			value.Comment = nil
		}
		return true
	})
}

func exportedGenDecl(declaration *ast.GenDecl) bool {
	for _, raw := range declaration.Specs {
		switch spec := raw.(type) {
		case *ast.TypeSpec:
			if ast.IsExported(spec.Name.Name) {
				return true
			}
		case *ast.ValueSpec:
			for _, name := range spec.Names {
				if ast.IsExported(name.Name) {
					return true
				}
			}
		}
	}
	return false
}

func fileFingerprint(path string) (fingerprint, error) {
	fset := token.NewFileSet()
	parsed, err := parser.ParseFile(
		fset, path, nil, parser.ParseComments|parser.SkipObjectResolution)
	if err != nil {
		return fingerprint{}, err
	}
	value := fingerprint{
		Package: parsed.Name.Name,
		Generated: ast.IsGenerated(parsed),
		TestFile: strings.HasSuffix(filepath.Base(path), "_test.go"),
	}
	cgo := false
	for _, spec := range parsed.Imports {
		copy := *spec
		copy.Doc = nil
		copy.Comment = nil
		encoded, err := render(fset, &copy)
		if err != nil {
			return fingerprint{}, err
		}
		value.Imports = append(value.Imports, encoded)
		pathValue, err := strconv.Unquote(spec.Path.Value)
		if err != nil {
			return fingerprint{}, fmt.Errorf("invalid import literal: %w", err)
		}
		cgo = cgo || pathValue == "C"
	}
	sort.Strings(value.Imports)
	for _, group := range parsed.Comments {
		for _, comment := range group.List {
			text := strings.TrimSpace(comment.Text)
			if cgo || strings.HasPrefix(text, "//go:") ||
				strings.HasPrefix(text, "// +build") ||
				strings.Contains(text, "#cgo") {
				value.Directives = append(value.Directives, text)
			}
		}
	}
	for _, raw := range parsed.Decls {
		switch declaration := raw.(type) {
		case *ast.FuncDecl:
			copy := *declaration
			copy.Body = nil
			stripComments(&copy)
			encoded, err := render(fset, &copy)
			if err != nil {
				return fingerprint{}, err
			}
			receiver := ""
			if declaration.Recv != nil && len(declaration.Recv.List) == 1 {
				receiver = receiverBase(declaration.Recv.List[0].Type)
			}
			if (ast.IsExported(declaration.Name.Name) && !value.TestFile &&
				(receiver == "" || ast.IsExported(receiver))) {
				value.Public = append(value.Public, encoded)
			} else {
				value.Private = append(value.Private, encoded)
				value.PrivateNames = append(value.PrivateNames, declaration.Name.Name)
			}
		case *ast.GenDecl:
			if declaration.Tok == token.IMPORT {
				continue
			}
			copy := *declaration
			stripComments(&copy)
			encoded, err := render(fset, &copy)
			if err != nil {
				return fingerprint{}, err
			}
			// Keep a grouped declaration whole.  Splitting its specs would hide
			// iota/inherited type or value changes affecting an exported name.
			if exportedGenDecl(declaration) && !value.TestFile {
				value.Public = append(value.Public, encoded)
			} else {
				value.Private = append(value.Private, encoded)
				for _, rawSpec := range declaration.Specs {
					switch spec := rawSpec.(type) {
					case *ast.TypeSpec:
						if spec.Name.Name != "_" {
							value.PrivateNames = append(value.PrivateNames, spec.Name.Name)
						}
					case *ast.ValueSpec:
						for _, name := range spec.Names {
							if name.Name != "_" {
								value.PrivateNames = append(value.PrivateNames, name.Name)
							}
						}
					}
				}
			}
		default:
			return fingerprint{}, fmt.Errorf("unsupported declaration %T", raw)
		}
	}
	sort.Strings(value.Public)
	sort.Strings(value.Private)
	sort.Strings(value.PrivateNames)
	return value, nil
}

func addedNames(before, after []string) []string {
	counts := make(map[string]int, len(before))
	for _, item := range before {
		counts[item]++
	}
	var result []string
	for _, item := range after {
		if counts[item] > 0 {
			counts[item]--
			continue
		}
		result = append(result, item)
	}
	return result
}

func shadowsPredeclared(names []string) bool {
	for _, name := range names {
		if types.Universe.Lookup(name) != nil {
			return true
		}
	}
	return false
}

func onlyBuildDirectives(directives []string) bool {
	for _, directive := range directives {
		if !strings.HasPrefix(directive, "//go:build") &&
			!strings.HasPrefix(directive, "// +build") {
			return false
		}
	}
	return true
}

type packageModel struct {
	Package     string
	Signatures  map[string][]string
	Dependencies map[string]map[string]bool
	Names       map[string]map[string]bool
	TypeNames   map[string][]string
	TypeMethods map[string]map[string]bool
	Public      map[string]bool
}

func newPackageModel() packageModel {
	return packageModel{
		Signatures: make(map[string][]string),
		Dependencies: make(map[string]map[string]bool),
		Names: make(map[string]map[string]bool),
		TypeNames: make(map[string][]string),
		TypeMethods: make(map[string]map[string]bool),
		Public: make(map[string]bool),
	}
}

func receiverBase(expression ast.Expr) string {
	switch value := expression.(type) {
	case *ast.Ident:
		return value.Name
	case *ast.ParenExpr:
		return receiverBase(value.X)
	case *ast.StarExpr:
		return receiverBase(value.X)
	case *ast.IndexExpr:
		return receiverBase(value.X)
	case *ast.IndexListExpr:
		return receiverBase(value.X)
	default:
		return ""
	}
}

func identifiers(node ast.Node) []string {
	set := make(map[string]bool)
	ast.Inspect(node, func(current ast.Node) bool {
		if identifier, ok := current.(*ast.Ident); ok && identifier.Name != "_" {
			set[identifier.Name] = true
		}
		return true
	})
	result := make([]string, 0, len(set))
	for name := range set {
		result = append(result, name)
	}
	sort.Strings(result)
	return result
}

func addName(model *packageModel, name, key string) {
	if name == "" || name == "_" {
		return
	}
	if model.Names[name] == nil {
		model.Names[name] = make(map[string]bool)
	}
	model.Names[name][key] = true
}

func addDeclaration(
	model *packageModel, key, signature string, dependencies []string,
	names, typeNames []string, receiver string, public bool,
) {
	model.Signatures[key] = append(model.Signatures[key], signature)
	if model.Dependencies[key] == nil {
		model.Dependencies[key] = make(map[string]bool)
	}
	for _, dependency := range dependencies {
		model.Dependencies[key][dependency] = true
	}
	for _, name := range names {
		addName(model, name, key)
	}
	model.TypeNames[key] = append(model.TypeNames[key], typeNames...)
	if receiver != "" {
		if model.TypeMethods[receiver] == nil {
			model.TypeMethods[receiver] = make(map[string]bool)
		}
		model.TypeMethods[receiver][key] = true
	}
	model.Public[key] = model.Public[key] || public
}

func buildPackageModel(paths []string) (packageModel, error) {
	model := newPackageModel()
	seen := make(map[string]bool)
	for _, path := range paths {
		if path == "" || seen[path] {
			return packageModel{}, fmt.Errorf("invalid/duplicate package file")
		}
		seen[path] = true
		fset := token.NewFileSet()
		parsed, err := parser.ParseFile(
			fset, path, nil, parser.ParseComments|parser.SkipObjectResolution)
		if err != nil {
			return packageModel{}, err
		}
		if model.Package == "" {
			model.Package = parsed.Name.Name
		} else if model.Package != parsed.Name.Name {
			return packageModel{}, fmt.Errorf("mixed package names")
		}
		testFile := strings.HasSuffix(filepath.Base(path), "_test.go")
		for _, raw := range parsed.Decls {
			switch declaration := raw.(type) {
			case *ast.FuncDecl:
				copy := *declaration
				copy.Body = nil
				stripComments(&copy)
				signature, err := render(fset, &copy)
				if err != nil {
					return packageModel{}, err
				}
				receiver := ""
				if declaration.Recv != nil && len(declaration.Recv.List) == 1 {
					receiver = receiverBase(declaration.Recv.List[0].Type)
				}
				key := "func:" + declaration.Name.Name
				names := []string{declaration.Name.Name}
				if receiver != "" {
					key = "method:" + receiver + ":" + declaration.Name.Name
					names = nil
				}
				addDeclaration(
					&model, key, signature, identifiers(&copy), names, nil,
					receiver, ast.IsExported(declaration.Name.Name) &&
						!testFile && (receiver == "" || ast.IsExported(receiver)))
			case *ast.GenDecl:
				if declaration.Tok == token.IMPORT {
					continue
				}
				copy := *declaration
				stripComments(&copy)
				signature, err := render(fset, &copy)
				if err != nil {
					return packageModel{}, err
				}
				var names, typeNames []string
				for _, rawSpec := range declaration.Specs {
					switch spec := rawSpec.(type) {
					case *ast.TypeSpec:
						names = append(names, spec.Name.Name)
						typeNames = append(typeNames, spec.Name.Name)
					case *ast.ValueSpec:
						for _, name := range spec.Names {
							names = append(names, name.Name)
						}
					}
				}
				sort.Strings(names)
				keyNames := names
				if len(keyNames) == 0 {
					keyNames = []string{signature}
				}
				key := "gen:" + declaration.Tok.String() + ":" +
					strings.Join(keyNames, ",")
				addDeclaration(
					&model, key, signature, identifiers(&copy), names,
					typeNames, "", exportedGenDecl(declaration) && !testFile)
			default:
				return packageModel{}, fmt.Errorf(
					"unsupported declaration %T", raw)
			}
		}
	}
	for key := range model.Signatures {
		sort.Strings(model.Signatures[key])
		sort.Strings(model.TypeNames[key])
	}
	return model, nil
}

func publicReach(model packageModel) map[string]bool {
	reached := make(map[string]bool)
	queue := make([]string, 0, len(model.Public))
	for key, public := range model.Public {
		if public {
			reached[key] = true
			queue = append(queue, key)
		}
	}
	for len(queue) > 0 {
		key := queue[0]
		queue = queue[1:]
		for name := range model.Dependencies[key] {
			for dependency := range model.Names[name] {
				if !reached[dependency] {
					reached[dependency] = true
					queue = append(queue, dependency)
				}
			}
		}
		for _, typeName := range model.TypeNames[key] {
			for method := range model.TypeMethods[typeName] {
				if !reached[method] {
					reached[method] = true
					queue = append(queue, method)
				}
			}
		}
	}
	return reached
}

func packageDeltaTouchesPublic(beforePaths, afterPaths []string) (bool, error) {
	before, err := buildPackageModel(beforePaths)
	if err != nil {
		return true, err
	}
	after, err := buildPackageModel(afterPaths)
	if err != nil {
		return true, err
	}
	if before.Package != "" && after.Package != "" &&
		before.Package != after.Package {
		return true, nil
	}
	beforeReach := publicReach(before)
	afterReach := publicReach(after)
	keys := make(map[string]bool)
	for key := range before.Signatures {
		keys[key] = true
	}
	for key := range after.Signatures {
		keys[key] = true
	}
	for key := range keys {
		if !reflect.DeepEqual(before.Signatures[key], after.Signatures[key]) &&
			(beforeReach[key] || afterReach[key] ||
				before.Public[key] || after.Public[key]) {
			return true, nil
		}
	}
	return false, nil
}

func packagePaths(paths []string, fallback string) []string {
	if len(paths) != 0 {
		return paths
	}
	if fallback == "" {
		return nil
	}
	return []string{fallback}
}

func classify(input manifest) result {
	if len(input.Pairs) == 0 {
		return result{Reason: "no_changed_go_files"}
	}
	for _, item := range input.Pairs {
		if item.Path == "" || (item.Before == "" && item.After == "") {
			return result{Reason: "invalid_changed_go_file"}
		}
		if item.Before == "" {
			after, err := fileFingerprint(item.After)
			if err != nil {
				return result{Reason: "candidate_parse_error: " + err.Error()}
			}
			// Test packages, including external foo_test packages, cannot alter
			// the production export surface. The direct go-list -test route still
			// compiles their exact candidate variant and catches type errors.
			if after.TestFile {
				continue
			}
			if after.Generated || len(after.Public) != 0 ||
				!onlyBuildDirectives(after.Directives) ||
				shadowsPredeclared(after.PrivateNames) {
				return result{Reason: "added_file_surface_not_proven_private"}
			}
			touches, err := packageDeltaTouchesPublic(
				packagePaths(item.BeforePackage, item.Before),
				packagePaths(item.AfterPackage, item.After))
			if err != nil || touches {
				return result{Reason: "private_delta_reaches_exported_surface"}
			}
			continue
		}
		if item.After == "" {
			before, err := fileFingerprint(item.Before)
			if err != nil {
				return result{Reason: "baseline_parse_error: " + err.Error()}
			}
			if before.TestFile {
				continue
			}
			if before.Generated || len(before.Public) != 0 ||
				!onlyBuildDirectives(before.Directives) ||
				shadowsPredeclared(before.PrivateNames) {
				return result{Reason: "deleted_file_surface_not_proven_private"}
			}
			touches, err := packageDeltaTouchesPublic(
				packagePaths(item.BeforePackage, item.Before),
				packagePaths(item.AfterPackage, item.After))
			if err != nil || touches {
				return result{Reason: "private_delta_reaches_exported_surface"}
			}
			continue
		}
		before, err := fileFingerprint(item.Before)
		if err != nil {
			return result{Reason: "baseline_parse_error: " + err.Error()}
		}
		after, err := fileFingerprint(item.After)
		if err != nil {
			return result{Reason: "candidate_parse_error: " + err.Error()}
		}
		if before.Generated || after.Generated {
			return result{Reason: "generated_file_changed"}
		}
		if before.Package != after.Package {
			return result{Reason: "package_changed"}
		}
		if before.TestFile != after.TestFile {
			return result{Reason: "test_file_identity_changed"}
		}
		if before.TestFile {
			continue
		}
		if !reflect.DeepEqual(before.Imports, after.Imports) {
			return result{Reason: "imports_changed"}
		}
		if !reflect.DeepEqual(before.Directives, after.Directives) {
			return result{Reason: "build_compiler_or_cgo_directive_changed"}
		}
		if !reflect.DeepEqual(before.Public, after.Public) {
			return result{Reason: "exported_surface_changed"}
		}
		// Existing private declarations must retain their full signature and
		// expression.  This closes aliases, inferred vars/consts, constraints,
		// embedding and promoted-method paths.  New private declarations and
		// function-body-only edits are the only extra safe cases.
		if shadowsPredeclared(addedNames(before.PrivateNames, after.PrivateNames)) {
			return result{Reason: "private_addition_shadows_predeclared"}
		}
		if shadowsPredeclared(addedNames(after.PrivateNames, before.PrivateNames)) {
			return result{Reason: "private_removal_unshadows_predeclared"}
		}
		if !reflect.DeepEqual(before.Private, after.Private) {
			if (!onlyBuildDirectives(before.Directives) ||
					!onlyBuildDirectives(after.Directives)) {
				return result{Reason: "private_delta_with_compiler_or_cgo_directive"}
			}
			touches, err := packageDeltaTouchesPublic(
				packagePaths(item.BeforePackage, item.Before),
				packagePaths(item.AfterPackage, item.After))
			if err != nil || touches {
				return result{Reason: "private_delta_reaches_exported_surface"}
			}
		}
	}
	return result{DirectOnly: true, Reason: "body_or_proven_private_delta_only"}
}

func main() {
	if len(os.Args) != 2 {
		fmt.Fprintln(os.Stderr, "usage: api-surface-helper MANIFEST")
		os.Exit(2)
	}
	payload, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	var input manifest
	if err := json.Unmarshal(payload, &input); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	encoder := json.NewEncoder(os.Stdout)
	encoder.SetEscapeHTML(false)
	if err := encoder.Encode(classify(input)); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
