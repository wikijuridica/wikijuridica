#!/usr/bin/env bash
# tools/check-oracle-liveness — READ-ONLY, ~1s.
#
# Preflight dos oráculos externos consumidos pelo bloco 12-31 do
# tools/bootstrap-chain (generate-public-prose-candidate ..
# generate-semantic-cluster-index): LanguageTool local (porta 8082) e os
# venvs Python pinados dos oráculos PT-BR (confusables, wordfreq, ftfy,
# lexicalrichness, rapidfuzz, simplemma, morphsyntax/spacy-stanza-torch).
#
# Sem este preflight, um LanguageTool morto só aparece no passo 17 —
# desperdiçando os passos 12-16 (prosa/inventário) — e um venv sem marker de
# deps completas dispara reinstalação pesada (torch/spacy, budget de 900s)
# no meio da cadeia em vez de falhar rápido antes dela começar.
#
# Uso: tools/check-oracle-liveness
# Exit 0 = tudo vivo, silencioso. Exit 1 = 1+ problema, com mensagem
# acionável por item em stderr.
set -uo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
problems=0

# 1. LanguageTool :8082 -------------------------------------------------
LT_ENDPOINT="${WIKI_LANGUAGETOOL_ENDPOINT:-http://127.0.0.1:8082/v2/check}"

# IDENTIDADE DA SONDA (CLAUDE.md secao 11). Ate 2026-09-10 esta chamada saia como
# `curl/8.x`. O destino e um SERVICO LOCAL nosso, nao o portal — por isso vai o
# User-Agent da sonda interna e NAO vai o `X-Warming-Request`: aquele cabecalho
# existe para tirar a requisicao da metrica de audiencia do portal, e aqui nao ha
# metrica de audiencia a proteger. Identificar continua valendo: e o que separa,
# no log do servico, a nossa sonda de um cliente qualquer da maquina.
UA_SONDA="wikijuridica-superficie-probe/1.0"
lt_http_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -A "$UA_SONDA" \
	--data-urlencode 'text=Este é um teste de verificação de disponibilidade.' \
	--data-urlencode 'language=pt-BR' \
	"$LT_ENDPOINT" 2>/dev/null || true)"
if [[ "$lt_http_code" != "200" ]]; then
	echo "check-oracle-liveness: LanguageTool morto ($LT_ENDPOINT, http=${lt_http_code:-sem resposta}) — religue com: nohup ./tools/run-languagetool-local &" >&2
	problems=$((problems + 1))
fi

# 2. venvs pinados dos oráculos PT-BR ------------------------------------
# Mesmo esquema de VENV/REQ_HASH/MARKER dos wrappers tools/generate-ptbr-*
# (confirmado lendo cada um): venv em $VENV, hash sha256 do requirements.txt,
# marker $VENV/.requirements-<nome>-<hash>.ok escrito só após pip install ok.
# Desde o BUG-098 cada um tem DOIS defaults — legado em /tmp e persistente em
# .cache/ —, e este preflight resolve na mesma ordem que eles.
check_simple_venv() {
	local name="$1" env_var="$2" legacy_dir="$3" persistent_dir="$4" req_file="$5" marker_prefix="$6" bootstrap="$7"
	# Mesma ordem de resolucao dos wrappers depois do BUG-098: override
	# explicito, senao o venv legado em /tmp enquanto ele existir, senao o
	# default persistente em .cache/ (que e onde os wrappers materializam
	# agora). Resolver diferente daqui faria o preflight sondar um caminho que
	# o gate nao usa — falso verde/vermelho, nao preflight.
	local venv
	if [[ -n "${!env_var:-}" ]]; then
		venv="${!env_var}"
	elif [[ -x "$legacy_dir/bin/python" ]]; then
		venv="$legacy_dir"
	else
		venv="$persistent_dir"
	fi
	if [[ ! -x "$venv/bin/python" ]]; then
		echo "check-oracle-liveness: venv $name ausente ($venv, tambem checado $legacy_dir) — bootstrap: $bootstrap" >&2
		problems=$((problems + 1))
		return
	fi
	local req_hash
	req_hash="$(sha256sum "$ROOT/tools/$req_file" | awk '{print $1}')"
	if [[ ! -f "$venv/.requirements-$marker_prefix-$req_hash.ok" ]]; then
		echo "check-oracle-liveness: venv $name sem marker de deps completas ($venv, hash $req_hash) — bootstrap: $bootstrap" >&2
		problems=$((problems + 1))
	fi
}

check_simple_venv confusables WIKI_CONFUSABLES_VENV "${TMPDIR:-/tmp}/opt-wiki-confusables-venv" "$ROOT/.cache/confusables-venv" requirements-confusables.txt confusables ./tools/generate-ptbr-confusables-evidence
check_simple_venv wordfreq WIKI_WORDFREQ_VENV "${TMPDIR:-/tmp}/opt-wiki-wordfreq-venv" "$ROOT/.cache/wordfreq-venv" requirements-wordfreq.txt wordfreq ./tools/generate-ptbr-wordfreq-quality
check_simple_venv ftfy WIKI_FTFY_VENV "${TMPDIR:-/tmp}/opt-wiki-ftfy-venv" "$ROOT/.cache/ftfy-venv" requirements-ftfy.txt ftfy ./tools/generate-ptbr-ftfy-unicode-oracle
check_simple_venv lexicalrichness WIKI_LEXICAL_RICHNESS_VENV "${TMPDIR:-/tmp}/opt-wiki-lexicalrichness-venv" "$ROOT/.cache/lexicalrichness-venv" requirements-lexicalrichness.txt lexicalrichness ./tools/generate-ptbr-lexical-diversity
check_simple_venv rapidfuzz WIKI_RAPIDFUZZ_VENV "${TMPDIR:-/tmp}/opt-wiki-rapidfuzz-venv" "$ROOT/.cache/rapidfuzz-venv" requirements-rapidfuzz.txt rapidfuzz ./tools/generate-ptbr-pair-rescoring

# simplemma: STAMP separado ($VENV/.requirements.sha256 com o hash em texto,
# não embutido no nome do arquivo — tools/generate-simplemma-ptbr-lemma-audit).
simplemma_venv="$ROOT/.cache/simplemma-ptbr-venv"
if [[ ! -x "$simplemma_venv/bin/python" ]]; then
	echo "check-oracle-liveness: venv simplemma ausente ($simplemma_venv) — bootstrap: ./tools/generate-simplemma-ptbr-lemma-audit" >&2
	problems=$((problems + 1))
else
	simplemma_req_hash="$(sha256sum "$ROOT/tools/requirements-simplemma-ptbr.txt" | awk '{print $1}')"
	simplemma_stamp="$simplemma_venv/.requirements.sha256"
	if [[ ! -f "$simplemma_stamp" || "$(cat "$simplemma_stamp" 2>/dev/null)" != "$simplemma_req_hash" ]]; then
		echo "check-oracle-liveness: venv simplemma sem marker de deps completas ($simplemma_venv) — bootstrap: ./tools/generate-simplemma-ptbr-lemma-audit" >&2
		problems=$((problems + 1))
	fi
fi

# morphsyntax (spacy/stanza/torch): dois defaults, legacy /tmp vence se
# presente, senão .cache/ persistente — mesma ordem de
# tools/generate-ptbr-morphsyntax-evidence e tools/check-ptbr-morphsyntax-evidence.
morph_req_hash="$(sha256sum "$ROOT/tools/requirements-ptbr-morphsyntax-oracle.txt" | awk '{print $1}')"
morph_legacy="${TMPDIR:-/tmp}/opt-wiki-ptbr-morphsyntax-venv"
morph_persistent="$ROOT/.cache/ptbr-morphsyntax-venv"
if [[ -n "${WIKI_PTBR_MORPHSYNTAX_VENV:-}" ]]; then
	morph_venv="$WIKI_PTBR_MORPHSYNTAX_VENV"
elif [[ -x "$morph_legacy/bin/python" ]]; then
	morph_venv="$morph_legacy"
else
	morph_venv="$morph_persistent"
fi
if [[ -n "${WIKI_PTBR_MORPHSYNTAX_PYTHON:-}" ]]; then
	: # interpretador explícito — confiar, como os wrappers reais confiam
elif [[ ! -x "$morph_venv/bin/python" ]]; then
	echo "check-oracle-liveness: venv morphsyntax ausente ($morph_venv, também checado $morph_persistent) — bootstrap: ./tools/generate-ptbr-morphsyntax-evidence --release-lote 1" >&2
	problems=$((problems + 1))
elif [[ ! -f "$morph_venv/.requirements-ptbr-morphsyntax-$morph_req_hash.ok" ]]; then
	echo "check-oracle-liveness: venv morphsyntax sem marker de deps completas ($morph_venv, hash $morph_req_hash) — reinstalação de spacy/stanza/torch é lenta (budget 900s) — bootstrap: ./tools/generate-ptbr-morphsyntax-evidence --release-lote 1" >&2
	problems=$((problems + 1))
fi

if [[ "$problems" -gt 0 ]]; then
	exit 1
fi
exit 0
