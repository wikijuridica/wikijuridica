#!/usr/bin/env python3
"""generate-v2-hint-gap-classification-20260805 — classifica o que ainda falta
no catalogo de source_hints, por classe de resolubilidade.

POR QUE. Depois da extensao do catalogo, o que sobra nao e um resto homogeneo
"a pesquisar": sao classes com destinos diferentes. Tratar tudo igual foi o
que produziu a passada de 2026-08-04, que inventou fonte para hint que nao
tem fonte unica (leis-estaduais-itcmd -> cf-1988-art-155-i).

CLASSES (o discriminador e sempre o mesmo: existe UMA URL oficial com caminho
documental que um anchor_claim verdadeiro consiga identificar?)
  ato_federal_derivavel  — lei/decreto/LC/EC com numero e ano: formula
                           (tools/generate-planalto-source-hints).
  curadoria_ato_setorial — ato especifico de agencia ou tribunal (RN da ANS,
                           tema do STF, resolucao da ANPD/ANEEL/CONTRAN,
                           IN da RFB): tem URL unica, exige pesquisa.
  multifonte_federativa  — denota MUITAS fontes (27 leis estaduais de ITCMD,
                           detrans estaduais, posturas municipais). Nao existe
                           URL unica: inventar uma e fraude de proveniencia.
  orgao_generico         — orgao, portal ou canal, nao norma (mec, anatel,
                           TNU). Homepage e listagem nao servem como fonte.
  nao_oficial            — doutrina, praxe judiciaria, jurisprudencia generica
                           sem processo identificado: nao e fonte oficial.

Read-only sobre o portfolio; escreve so em data/ops.
"""
import collections
import json
import pathlib
import re

ROOT = pathlib.Path("/opt/wiki")
SAIDA = ROOT / "data/ops/v2_hint_gap_classification_20260805.jsonl"

catalog = json.loads((ROOT / "data/editorial/v2_source_hint_catalog.json")
                     .read_text(encoding="utf-8"))["source_hints"]
keys = set(catalog)

ATO_FEDERAL = re.compile(
    r"\b(lei|lc|lei complementar|decreto|decreto-lei|ec|emenda constitucional)\b"
    r"[^\d]{0,12}[\d.]+\s*/?\s*\d{4}|"
    r"^(lei|lc|decreto|decreto-lei|ec)-[\d]+-\d{4}", re.I)
CODIGO_ART = re.compile(
    r"\b(CC|CF|CTN|CTB|CDC|CPC|CPP|CP|CLT|LPI)\b.*art|"
    r"^(cc|cf|ctn|ctb|cdc|cpc|cpp|cp|clt)-.*art", re.I)
SETORIAL = re.compile(
    r"\b(RN|resolu[cç][aã]o|res\.?|IN|instru[cç][aã]o normativa|circular|"
    r"portaria|provimento|tema|s[uú]mula|ADI|ADPF|RE|REsp|enunciado)\b|"
    r"^(rn|res|in|circular|portaria|prov|stf|stj|tst|tnu|ans|aneel|anpd|"
    r"anatel|anvisa|susep|contran|cfm|cnj)-", re.I)
MULTIFONTE = re.compile(
    r"estadua(l|is)|municipa(l|is)|detrans|posturas|tribunais|"
    r"delegacias|juntas comerciais|cart[oó]rios|prefeitura", re.I)
NAO_OFICIAL = re.compile(
    r"^(doutrina|praxe|jurisprudencia|entendimento|precedentes?)-|"
    r"\b(doutrina|praxe judiciaria)\b", re.I)


def classificar(hint):
    if NAO_OFICIAL.search(hint):
        return "nao_oficial", "doutrina, praxe ou jurisprudencia sem ato identificado"
    if MULTIFONTE.search(hint):
        return "multifonte_federativa", "denota varias fontes; nao existe URL oficial unica"
    if CODIGO_ART.search(hint) or ATO_FEDERAL.search(hint):
        return "ato_federal_derivavel", "ato federal com numero e ano; resolvivel por formula"
    if SETORIAL.search(hint):
        return "curadoria_ato_setorial", "ato setorial especifico; exige pesquisa da URL oficial"
    return "orgao_generico", "orgao, portal ou canal; homepage nao serve como fonte"


ocorrencias = collections.Counter()
intents = collections.defaultdict(set)
for path in sorted((ROOT / "data/editorial/portfolio_v2").glob("*.jsonl")):
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        record = json.loads(line)
        for hint in record.get("source_hints") or []:
            if hint not in keys:
                ocorrencias[hint] += 1
                intents[hint].add(record.get("intent_id"))

resumo = collections.Counter()
linhas = []
for hint, total in ocorrencias.most_common():
    classe, motivo = classificar(hint)
    resumo[classe] += total
    linhas.append(json.dumps({
        "hint": hint, "ocorrencias": total, "intents": len(intents[hint]),
        "classe": classe, "motivo": motivo,
    }, ensure_ascii=False))
SAIDA.write_text("\n".join(linhas) + "\n", encoding="utf-8")
print("catalogo:", len(keys), "chaves")
print("lacuna:", len(ocorrencias), "hints distintos /", sum(ocorrencias.values()), "ocorrencias")
for classe, total in resumo.most_common():
    distintos = sum(1 for h in ocorrencias if classificar(h)[0] == classe)
    print("  %-24s %5d ocorrencias  %5d distintos" % (classe, total, distintos))
print("saida:", SAIDA)
