#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# BUG-098: o default do venv passa a ser persistente dentro do repo. O /tmp e
# limpo no boot e ja levou embora venv de gate (htmltest e o venv de qualidade
# Python "so existiam em /tmp — sumiram"); .cache/ sobrevive e esta no
# .gitignore. O default legado em /tmp continua valendo enquanto o venv de uma
# sessao anterior estiver la, para nao reinstalar de graca.
# WIKI_LEXICAL_RICHNESS_VENV vence os dois.
VENV_PERSISTENT_DEFAULT="$ROOT/.cache/lexicalrichness-venv"
VENV_LEGACY_DEFAULT="${TMPDIR:-/tmp}/opt-wiki-lexicalrichness-venv"
if [[ -n "${WIKI_LEXICAL_RICHNESS_VENV:-}" ]]; then
	VENV="$WIKI_LEXICAL_RICHNESS_VENV"
elif [[ -x "$VENV_LEGACY_DEFAULT/bin/python" ]]; then
	VENV="$VENV_LEGACY_DEFAULT"
else
	VENV="$VENV_PERSISTENT_DEFAULT"
fi
PY="$VENV/bin/python"
REQ_HASH="$(sha256sum "$ROOT/tools/requirements-lexicalrichness.txt" | awk '{print $1}')"
MARKER="$VENV/.requirements-lexicalrichness-$REQ_HASH.ok"
# Ambiente ausente/stale e' falha de INFRA, nao defeito de conteudo: sai com 75
# (mesma convencao de tools/run-check para cache/lock indisponivel) para que
# venv varrido do /tmp nunca seja lido como reprovacao de diversidade lexical do
# corpus. 75 continua nao-zero: o check nao passa, so deixa de mentir a causa.
if [[ ! -x "$PY" ]]; then
	echo "check-ptbr-lexical-diversity: lexicalrichness environment missing at $VENV; run './tools/generate-ptbr-lexical-diversity' to materialize the pinned oracle (infra, not a corpus failure)" >&2
	exit 75
fi
if [[ ! -f "$MARKER" ]]; then
	echo "check-ptbr-lexical-diversity: requirements-lexicalrichness environment stale at $VENV; run './tools/generate-ptbr-lexical-diversity' to refresh the pinned oracle (infra, not a corpus failure)" >&2
	exit 75
fi
WIKI_LEXICAL_RICHNESS_PYTHON="$PY" exec "$ROOT/tools/run-check" ptbr-lexical-diversity --timings "$@"
