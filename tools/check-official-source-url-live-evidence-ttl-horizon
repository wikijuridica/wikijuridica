#!/usr/bin/env python3
"""Quando vence a próxima evidência de vida de fonte oficial — e quem discorda de quem.

SOMENTE LEITURA. Não escreve em data/, não faz rede, não muda estado nenhum.

    ./tools/check-official-source-url-live-evidence-ttl-horizon
    ./tools/check-official-source-url-live-evidence-ttl-horizon --hoje 2026-10-04
    ./tools/check-official-source-url-live-evidence-ttl-horizon --json

O QUE ELE RESPONDE, E POR QUE A PERGUNTA É TRAIÇOEIRA
=====================================================
`checked_at` só é medição quando o registro tem status `..._attempted_blocked`
ou `..._failed_blocked`. Nos demais ele é CARIMBO do run_date do lote — e um
detector ingênuo, que subtraia `checked_at` de hoje sobre o arquivo derivado,
responde "zero vencidos" todo dia mesmo quando a medição real já venceu. O
racional completo está no cabeçalho de tools/officialsourcettlhorizon.py.

A camada de VERDADE é `official_source_url_live_metadata_attempts.jsonl`; o
`official_source_url_live_evidence.jsonl` é derivado dela. Por isso a segunda
seção compara as duas: campo de medição que só existe no derivado é produtor
gravando no arquivo errado.

CÓDIGOS DE SAÍDA
================
    0  levantamento feito (o padrão: relatar não é reprovar)
    1  --falhar-se-divergir e há divergência, ou --falhar-se-vencer-em N e há
       vencimento dentro de N dias
    2  erro de uso ou arquivo ausente/ilegível
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import officialsourcettlhorizon as horizonte_ttl  # noqa: E402


def raiz_do_repo() -> str:
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def imprime_camada(rotulo: str, caminho: str, censo: dict, hoje: datetime.date) -> None:
    print(f"{rotulo}  ({caminho})")
    print(f"  registros ............... {censo['total']}")
    print(f"  com MEDIÇÃO real ........ {censo['medidos']}  (checked_at é sonda; relógio de TTL correndo)")
    print(f"  com CARIMBO de run_date . {censo['carimbos']}  (checked_at = data do lote; sem medição, já bloqueados)")
    if censo["desconhecidos"]:
        print(f"  status não reconhecido .. {censo['desconhecidos']}  (ATENÇÃO: status novo que este censo não classifica)")
    print(f"  vencidos em {hoje.isoformat()} .... {censo['vencidos_hoje']}")
    if censo["primeiro_vencimento"]:
        print(f"  PRIMEIRO VENCIMENTO ..... {censo['primeiro_vencimento']} "
              f"({censo['registros_no_primeiro_vencimento']} registros, "
              f"em {censo['dias_ate_o_primeiro']} dias)")
    else:
        print("  PRIMEIRO VENCIMENTO ..... nenhum registro tem medição com prazo correndo")
    print(f"  vencem até {censo['vencem_ate']} .. {censo['vencem_na_janela']} "
          f"(janela de {censo['janela_dias']} dias)")
    if censo["agenda"]:
        print("  agenda de vencimento:")
        for linha in censo["agenda"]:
            print(f"     {linha['primeiro_dia_vencido']}  {linha['registros']:>6} registro(s)")
    print()


def main() -> int:
    analisador = argparse.ArgumentParser(
        description="Horizonte de vencimento de TTL da evidência de vida das fontes oficiais (somente leitura).")
    analisador.add_argument("--hoje", default="",
                            help="data de referência YYYY-MM-DD (padrão: hoje em UTC, o mesmo relógio do Go)")
    analisador.add_argument("--janela-dias", type=int, default=30,
                            help="tamanho da janela do 'vencem em breve' (padrão: 30)")
    analisador.add_argument("--json", action="store_true", help="saída em JSON, para consumo por outra ferramenta")
    analisador.add_argument("--falhar-se-divergir", action="store_true",
                            help="exit 1 se o derivado carregar medição que a fonte não tem")
    analisador.add_argument("--falhar-se-vencer-em", type=int, default=0,
                            help="exit 1 se algum registro vencer dentro de N dias (0 = não reprovar)")
    analisador.add_argument("--raiz", default="", help="raiz do repositório (padrão: a deste script)")
    argumentos = analisador.parse_args()

    raiz = argumentos.raiz or raiz_do_repo()
    if argumentos.hoje:
        try:
            hoje = datetime.date.fromisoformat(argumentos.hoje)
        except ValueError:
            print(f"--hoje {argumentos.hoje!r} não é uma data YYYY-MM-DD", file=sys.stderr)
            return 2
    else:
        hoje = horizonte_ttl.hoje_utc()

    caminho_fonte = horizonte_ttl.caminho_no_repo(raiz, horizonte_ttl.CAMINHO_ATTEMPTS)
    caminho_derivado = horizonte_ttl.caminho_no_repo(raiz, horizonte_ttl.CAMINHO_DERIVADO)
    for caminho in (caminho_fonte, caminho_derivado):
        if not os.path.exists(caminho):
            print(f"{caminho} não existe", file=sys.stderr)
            return 2

    try:
        censo_fonte = horizonte_ttl.horizonte(horizonte_ttl.le_jsonl(caminho_fonte), hoje, argumentos.janela_dias)
        censo_derivado = horizonte_ttl.horizonte(horizonte_ttl.le_jsonl(caminho_derivado), hoje, argumentos.janela_dias)
        indice_fonte = horizonte_ttl.indexa_por_hash(horizonte_ttl.le_jsonl(caminho_fonte))
        indice_derivado = horizonte_ttl.indexa_por_hash(horizonte_ttl.le_jsonl(caminho_derivado))
    except (OSError, ValueError) as erro:
        print(f"falha ao ler as camadas: {erro}", file=sys.stderr)
        return 2
    conflito = horizonte_ttl.divergencias(indice_fonte, indice_derivado)

    relatorio = {
        "hoje": hoje.isoformat(),
        "fonte_de_verdade": {"camada": horizonte_ttl.CAMINHO_ATTEMPTS, **censo_fonte},
        "derivado": {"camada": horizonte_ttl.CAMINHO_DERIVADO, **censo_derivado},
        "divergencia_fonte_vs_derivado": conflito,
    }

    if argumentos.json:
        print(json.dumps(relatorio, ensure_ascii=False, indent=2, sort_keys=False))
    else:
        print(f"horizonte de TTL da evidência de fonte oficial — referência {hoje.isoformat()} (UTC)\n")
        imprime_camada("FONTE DE VERDADE", horizonte_ttl.CAMINHO_ATTEMPTS, censo_fonte, hoje)
        imprime_camada("DERIVADO", horizonte_ttl.CAMINHO_DERIVADO, censo_derivado, hoje)
        print("divergência fonte x derivado")
        print(f"  registros comparados .... {conflito['comparados']}")
        print(f"  divergentes ............. {conflito['divergentes']}")
        print(f"  derivados sem fonte ..... {conflito['derivados_sem_fonte']}")
        for exemplo in conflito["exemplos"]:
            print(f"     {exemplo['motivo']}: {exemplo['official_source_url']}")
            print(f"        fonte   : {exemplo['fonte']}")
            print(f"        derivado: {exemplo['derivado']}")

    codigo = 0
    if argumentos.falhar_se_divergir and conflito["divergentes"] > 0:
        print(f"\nREPROVADO: {conflito['divergentes']} registro(s) do arquivo derivado carregam medição que a "
              f"fonte de verdade não tem. Algum produtor está gravando em "
              f"{horizonte_ttl.CAMINHO_DERIVADO} em vez de {horizonte_ttl.CAMINHO_ATTEMPTS}.", file=sys.stderr)
        codigo = 1
    if argumentos.falhar_se_vencer_em > 0:
        limite = hoje + datetime.timedelta(days=argumentos.falhar_se_vencer_em)
        proximos = sum(linha["registros"] for linha in censo_fonte["agenda"]
                       if datetime.date.fromisoformat(linha["primeiro_dia_vencido"]) <= limite)
        if proximos > 0:
            print(f"\nREPROVADO: {proximos} registro(s) da fonte de verdade vencem até {limite.isoformat()}. "
                  f"Renove com: ./tools/generate-source-live-evidence-recheck", file=sys.stderr)
            codigo = 1
    return codigo


if __name__ == "__main__":
    sys.exit(main())
