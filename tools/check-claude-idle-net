#!/bin/bash
# check-claude-idle-net — um Claude Code parado mantém conexão aberta com a API?
#
# A pergunta nasceu de uma medição que reprovou o desenho anterior: com um
# subagente ATIVO, a sessão desta investigação queimava 6 jiffies/s — abaixo do
# limiar de 8 que o reaper usava para dizer "está viva". Ou seja, o CPU sozinho
# classificaria trabalho real como parada, porque subagente do Claude Code não
# aparece como processo na árvore: roda dentro do próprio TUI.
#
# Se um Claude ESPERANDO resposta da API mantém sockets ESTABLISHED e um parado
# no prompt não mantém (ou mantém bem menos), a contagem de conexões seria o sinal
# que alcança justamente o estado que os outros não veem.
#
# RESULTADO: REFUTADO, e pelo inverso do esperado.
#   Claude OCIOSO (sessão nova):        73 conexões  (76, 74, 73, 73, 72, 71)
#   Claude TRABALHANDO com subagente:    7 conexões
# O ocioso mantém DEZ VEZES MAIS que o trabalhando — o número absoluto não
# discrimina nada. Uma sessão recém-aberta abre dezenas de conexões no startup
# (plugins, marketplace) que vão se fechando; uma sessão antiga trabalha sobre
# poucas conexões keep-alive. A contagem mede idade da sessão, não atividade.
# O script fica como registro da medição que fechou essa porta.
#
# Sessão própria com prefixo `netprobe-`, removida ao sair.

set -uo pipefail
JANELA="${1:-60}"
S="netprobe-$$"

limpar() { tmux kill-session -t "=$S" 2>/dev/null; }
trap limpar EXIT INT TERM

descendants() {
	ps -eo pid,ppid --no-headers 2>/dev/null | awk -v r="$1" '
    {p[$1]=$2} END{ n=1; q[1]=r; seen[r]=1
      for(i=1;i<=n;i++){ for(k in p){ if(p[k]==q[i] && !(k in seen)){ seen[k]=1; q[++n]=k } } }
      for(i=2;i<=n;i++) print q[i] }'
}
conexoes() {
	local root="$1" p total=0
	for p in "$root" $(descendants "$root"); do
		total=$((total + $(ss -tnp 2>/dev/null | grep -c "pid=$p," || true)))
	done
	echo "$total"
}

tmux new-session -d -s "$S" -x 120 -y 40 \
	'cd /opt/wiki && claude --permission-mode bypassPermissions' 2>/dev/null || {
	echo "não foi possível criar a sessão"
	exit 2
}

PP=""
for _ in $(seq 1 20); do
	command sleep 1
	PP=$(tmux list-panes -t "=$S" -F '#{pane_pid}' 2>/dev/null | head -1)
	[ -n "$PP" ] && pgrep -P "$PP" >/dev/null 2>&1 && break
done
[ -n "$PP" ] || {
	echo "pane não subiu"
	exit 2
}

echo "aguardando o startup assentar..."
command sleep 45
echo "medindo ${JANELA}s de Claude OCIOSO (sessão $S, pane $PP)"
soma=0
n=0
for _ in $(seq 1 $((JANELA / 10))); do
	command sleep 10
	c=$(conexoes "$PP")
	soma=$((soma + c))
	n=$((n + 1))
	printf '  conexões estabelecidas: %s\n' "$c"
done
echo
echo "  média com o TUI ocioso: $((soma / (n > 0 ? n : 1))) conexão(ões)"
echo
echo "  referência medida nesta investigação: uma sessão COM subagente ativo"
echo "  mantinha 7 conexões e apenas 6 jiffies/s de CPU."
exit 0
