#!/usr/bin/env python3
"""Exige que o nginx entregue o que o Go entrega — em toda rota testada.

POR QUE ISTO EXISTE
===================
Em 2026-08-27 eu pus uma allowlist de extensões no nginx para impedir que lixo
depositado em `public/` virasse URL pública (um `robots.txt.bak` antigo e restos
de compressão estavam sendo servidos com 200 e cache de sete dias). A allowlist
foi derivada do INVENTÁRIO de `public/`, e essa foi a falha de método: o canal
Markdown não é arquivo em `public/`, é rota dinâmica do Go. `md` ficou de fora,
e `/api.md`, `/auth.md` e toda gêmea `/x/index.md` passaram a devolver 404 no
nginx enquanto respondiam 200 no Go.

O canal Markdown é 100% do tráfego de bot de IA deste portal. O buraco valia o
acervo inteiro para eles, e durou até outro gate tropeçar nele por acaso.

O erro não foi esquecer uma extensão: foi ter uma lista que PODE esquecer. Uma
allowlist correta hoje volta a ficar errada no dia em que uma rota nova nasça
com extensão nova, e nada avisaria.

O QUE ESTE GATE FAZ
===================
Não confere a lista contra outra lista — isso só moveria o problema. Ele compara
COMPORTAMENTO: para cada rota, o que o Go responde (127.0.0.1:8089) e o que o
nginx responde (127.0.0.1:8088). O nginx é proxy reverso do Go para tudo que não
é estático, então divergência de status é, por definição, algo que a camada da
frente está comendo.

Uma rota que o Go serve com 200 e o nginx devolve 404 é sempre defeito — não
existe motivo legítimo para o proxy esconder conteúdo que a origem entrega.
"""
import subprocess
import sys

GO = "http://127.0.0.1:8089"
NGINX = "http://127.0.0.1:8088"
UA = "wikijuridica-superficie-probe/1.0"

# Rotas escolhidas para cobrir CADA FORMA de caminho que o portal serve, não
# para cobrir muitas URLs: uma por classe é o que detecta uma classe inteira
# sumindo. A gêmea `.md` está aqui porque foi a que faltou.
ROTAS = [
    ("/", "raiz"),
    ("/glossario/intimacao/", "pagina de acervo"),
    ("/glossario/intimacao/index.md", "gemea markdown do acervo"),
    ("/familia/", "hub de area"),
    ("/familia/llms.txt", "llms.txt de area"),
    ("/api.md", "documentacao da api em markdown"),
    ("/auth.md", "documentacao de auth em markdown"),
    ("/llms.txt", "llms.txt da raiz"),
    ("/robots.txt", "robots"),
    ("/sitemap.xml", "indice de sitemap"),
    ("/feed.xml", "feed"),
    ("/openapi.json", "descritor openapi"),
    ("/.well-known/agent-card.json", "cartao de agente"),
    ("/.well-known/ai-catalog.json", "catalogo de ia"),
    ("/favicon.ico", "favicon"),
]


def status(base, caminho, aceita=None):
    cmd = ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "15",
           "-A", UA, "-H", "X-Warming-Request: true"]
    if aceita:
        cmd += ["-H", f"Accept: {aceita}"]
    cmd.append(base + caminho)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=25).stdout.strip()
    except subprocess.TimeoutExpired:
        return "timeout"


def main() -> int:
    divergencias = []
    print("rota                                       Go   nginx")
    for caminho, descricao in ROTAS:
        g, n = status(GO, caminho), status(NGINX, caminho)
        marca = ""
        # 200 no Go e não-200 no nginx é sempre defeito: o proxy está comendo
        # conteúdo que a origem entrega. O inverso (nginx serve, Go não) é
        # normal — o acervo sai estático do disco e nunca chega ao Go.
        if g == "200" and n != "200":
            marca = "  <-- o nginx esconde o que o Go serve"
            divergencias.append((caminho, descricao, g, n))
        print(f"  {caminho:<40} {g:<4} {n}{marca}")

    # A negociação por Accept usa URL SEM extensão, então ela nunca exercita a
    # allowlist — foi justamente por só testar este caminho que a regressão de
    # 27/08 passou. Fica aqui como cobertura do canal, não como substituta.
    print("\nnegociacao por Accept: text/markdown (URL sem extensao)")
    for caminho in ("/glossario/intimacao/", "/familia/"):
        g = status(GO, caminho, "text/markdown")
        n = status(NGINX, caminho, "text/markdown")
        marca = ""
        if g == "200" and n != "200":
            marca = "  <-- divergente"
            divergencias.append((caminho + " (Accept: text/markdown)", "negociacao", g, n))
        print(f"  {caminho:<40} {g:<4} {n}{marca}")

    if divergencias:
        print(f"\ncheck-paridade-go-nginx: REPROVA — {len(divergencias)} rota(s) que o Go "
              f"serve e o nginx nao entrega:", file=sys.stderr)
        for caminho, descricao, g, n in divergencias:
            print(f"  {caminho} ({descricao}): Go={g} nginx={n}", file=sys.stderr)
        return 1

    print(f"\ncheck-paridade-go-nginx: pass — {len(ROTAS) + 2} rotas, nenhuma divergencia")
    return 0


if __name__ == "__main__":
    sys.exit(main())
